<https://repository.product-passport.ec.europa.eu/core/vocabs/observed-characteristic> a owl:Ontology,
    skos:ConceptScheme;
  owl:versionIRI <https://repository.product-passport.ec.europa.eu/core/vocabs/observed-characteristic/1.0.0>;
  skos:notation "observed-characteristic";
  skos:prefLabel "Observed Characteristic Vocabulary"@en;
  dct:title "Observed Characteristic Vocabulary"@en;
  skos:definition "Vocabulary of concepts for characteristics that can be observed or measured, used to describe recorded values in digital product passports."@en;
