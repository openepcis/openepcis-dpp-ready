@prefix dppunit: <https://repository.product-passport.ec.europa.eu/core/vocabs/measurement-unit#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix concept-status: <http://publications.europa.eu/resource/authority/concept-status/> .

<https://repository.product-passport.ec.europa.eu/core/vocabs/measurement-unit>
    a owl:Ontology ,
      skos:ConceptScheme ;
    owl:versionIRI <https://repository.product-passport.ec.europa.eu/core/vocabs/measurement-unit/1.0.0> ;
    skos:notation "measurement-unit" ;
    skos:prefLabel "Measurement Unit Vocabulary"@en ;
    dct:title "Measurement Unit Vocabulary"@en ;
    skos:definition "Vocabulary of measurement unit concepts used to express recorded values in digital product passports."@en ;
    dct:created "2026-10-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dct:creator "European Commission" ;
    dct:license <https://interoperable-europe.ec.europa.eu/collection/eupl/eupl-text-eupl-12> ;
    skos:hasTopConcept
        dppunit:kilogram ,
        dppunit:gram ,
        dppunit:ampereHour ,
        dppunit:milliampereHour ,
        dppunit:percent ,
        dppunit:volt ,
        dppunit:degreeCelsius ,
        dppunit:watt ,
        dppunit:ohm ,
        dppunit:reciprocalHour,
        dppunit:hour .
		
