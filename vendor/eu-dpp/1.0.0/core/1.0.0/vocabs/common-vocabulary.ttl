<https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>
  a owl:Ontology, skos:ConceptScheme;
  owl:versionIRI <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary/1.0.0>;
  skos:notation "common-vocabulary";
  skos:prefLabel "Common Supporting Vocabulary"@en;
  dct:title "Common Supporting Vocabulary"@en;
  skos:definition "Vocabulary of common supporting concepts used by digital product passport data models."@en;
  dct:created "2026-10-30"^^xsd:date;
  owl:versionInfo "1.0.0";
  dct:creator "European Commission";
  dct:license <https://interoperable-europe.ec.europa.eu/collection/eupl/eupl-text-eupl-12> ;
  skos:hasTopConcept dppcom:observedCharacteristic, dppcom:binRangeUnit, dppcom:binValueUnit, dppcom:bin, dppcom:lowerBound, dppcom:upperBound, dppcom:binValue, dppcom:valueRange, dppcom:unit, dppcom:value, dppcom:recordedTime .

dppcom:observedCharacteristic a skos:Concept;
  skos:notation "observedCharacteristic";
  skos:prefLabel "Observed characteristic"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "The characteristic, property, or condition described."@en .

dppcom:binRangeUnit a skos:Concept;
  skos:notation "binRangeUnit";
  skos:prefLabel "Bin range unit"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "The unit of measurement used for the values defining the histogram bin intervals on the X-axis."@en .

dppcom:binValueUnit a skos:Concept;
  skos:notation "binValueUnit";
  skos:prefLabel "Bin value unit"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "The unit of measurement of the quantity represented by the histogram bin values on the Y-axis."@en .

dppcom:bin a skos:Concept;
  skos:notation "bin";
  skos:prefLabel "Bin"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "A bucket within a histogram representing either a value interval or a category and its associated quantity."@en .

dppcom:lowerBound a skos:Concept;
  skos:notation "lowerBound";
  skos:prefLabel "Lower bound"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "The lower limit of a numerical interval represented by a histogram bin or applicable range."@en .

dppcom:upperBound a skos:Concept;
  skos:notation "upperBound";
  skos:prefLabel "Upper bound"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "The upper limit of a numerical interval represented by a histogram bin or applicable range."@en .

dppcom:binValue a skos:Concept;
  skos:notation "binValue";
  skos:prefLabel "Bin value"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "The value associated with a histogram bin, represented on the histogram's Y-axis."@en .

dppcom:valueRange a skos:Concept;
  skos:notation "valueRange";
  skos:prefLabel "Value range"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "Range of values (contains lowerbound and upperbound)"@en .

dppcom:value a skos:Concept;
  skos:notation "value";
  skos:prefLabel "Value"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "Value associated with a measurement."@en .

dppcom:unit a skos:Concept;
  skos:notation "unit";
  skos:prefLabel "Unit"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "Unit in which a value or range is expressed."@en .

dppcom:recordedTime a skos:Concept;
  skos:notation "recordedTime";
  skos:prefLabel "Recorded time"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary>;
  skos:definition "Time when the value was recorded (timestamp)."@en .
