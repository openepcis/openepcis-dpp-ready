<https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code> a
    owl:Ontology, skos:ConceptScheme;
  owl:versionIRI <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code/1.0.0>;
  skos:notation "core-error-code";
  skos:prefLabel "Core Error Code Vocabulary"@en;
  dct:title "Core Error Code Vocabulary"@en;
  skos:definition "Vocabulary of error codes that describe errors in validation derived from the use of core attributes."@en;
  dct:created "2026-10-30"^^xsd:date;
  owl:versionInfo "1.0.0";
  skos:hasTopConcept dpperr:SEM-MSG-001, dpperr:SEM-MSG-002, dpperr:SEM-MSG-003,
    dpperr:SEM-MSG-005, dpperr:SEM-MSG-006, dpperr:SEM-MSG-009;
  dct:creator "European Commission";
  dct:license <https://interoperable-europe.ec.europa.eu/collection/eupl/eupl-text-eupl-12> .

dpperr:SEM-MSG-001 a skos:Concept;
  skos:notation "SEM-MSG-001";
  skos:prefLabel "SEM-MSG-001"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "digitalProductPassportId must be a String and must occur at least 1 time and must not occur more than 1 time."@en .

dpperr:SEM-MSG-002 a skos:Concept;
  skos:notation "SEM-MSG-002";
  skos:prefLabel "SEM-MSG-002"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "uniqueProductIdentifier must be a String and must occur at least 1 time and must not occur more than 1 time."@en .

dpperr:SEM-MSG-003 a skos:Concept;
  skos:notation "SEM-MSG-003";
  skos:prefLabel "SEM-MSG-003"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "granularity must be a code of granularity-level (only item for batteries) and must occur at least 1 time and must not occur more than 1 time."@en .

dpperr:SEM-MSG-005 a skos:Concept;
  skos:notation "SEM-MSG-005";
  skos:prefLabel "SEM-MSG-005"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "dppStatus must be a List of codes: instance-status and must occur at least 1 time and must not occur more than 1 time."@en .

dpperr:SEM-MSG-006 a skos:Concept;
  skos:notation "SEM-MSG-006";
  skos:prefLabel "SEM-MSG-006"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "lastUpdate must be a dateTime and must occur at least 1 time and must not occur more than 1 time."@en .

dpperr:SEM-MSG-009 a skos:Concept;
  skos:notation "SEM-MSG-009";
  skos:prefLabel "SEM-MSG-009"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  euvoc:status concept-status:CURRENT;
  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "contentSpecificationIds must be a list of content specification IRIs and must include exactly one IRI for each applicable content specification (core, product group and, if applicable, subgroup)."@en .
