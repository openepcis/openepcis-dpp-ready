  skos:definition "renewableContentShare must be a Decimal and Unit (percent). It is a mandatory field. It must occur only 1 time."@en .

baterr:SEM-BAT-MSG-091 a skos:Concept;
  skos:notation "SEM-BAT-MSG-091";
  skos:prefLabel "SEM-BAT-MSG-091"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
