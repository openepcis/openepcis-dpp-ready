  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "criticalRawMaterials must be a List of codes: critical-raw-material. It is a mandatory field and it could occur more than one time."@en .

baterr:SEM-BAT-MSG-090 a skos:Concept;
  skos:notation "SEM-BAT-MSG-090";
  skos:prefLabel "SEM-BAT-MSG-090"@en;
