  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "manufacturerIdentification is a mandatory field. It must occur only 1 time. At least one manufacturerName, manufacturerTradeName or manufacturerTrademark must exist."@en .

