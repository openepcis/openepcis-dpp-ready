  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "environmentalConditionHistogram must contain observedCharacteristic, binValueUnit, binRangeUnit and bin. It is a mandatory element inside environmentalConditionHistogramSet and it could occur more than 1 time."@en .

