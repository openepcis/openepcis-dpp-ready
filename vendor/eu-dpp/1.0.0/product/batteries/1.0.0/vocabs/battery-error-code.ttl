  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "manufacturingDate must be a date with format Year and month and it is a mandatory field. It must occur only 1 time."@en .

baterr:SEM-BAT-MSG-021 a skos:Concept;
  skos:notation "SEM-BAT-MSG-021";
  skos:prefLabel "SEM-BAT-MSG-021"@en;
