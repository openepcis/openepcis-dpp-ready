  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "batteryChemistry must be a List of codes: battery-chemistry. It is a mandatory field and it could occur more than one time."@en .

