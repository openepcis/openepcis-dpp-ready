  skos:definition "manufacturingRegion must be a String. It must not occur more than 1 time."@en .

baterr:SEM-BAT-MSG-019 a skos:Concept;
  skos:notation "SEM-BAT-MSG-019";
  skos:prefLabel "SEM-BAT-MSG-019"@en;
