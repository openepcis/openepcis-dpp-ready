  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "manufacturingCity must be a String. It must not occur more than 1 time."@en .

baterr:SEM-BAT-MSG-018 a skos:Concept;
