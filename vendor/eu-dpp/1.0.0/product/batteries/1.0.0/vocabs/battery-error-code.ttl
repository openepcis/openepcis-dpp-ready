  skos:definition "batteryCategory must be a List of codes: battery-category and it is a mandatory field. It must occur only 1 time."@en .

baterr:SEM-BAT-MSG-010 a skos:Concept;
  skos:notation "SEM-BAT-MSG-010";
  skos:prefLabel "SEM-BAT-MSG-010"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
