  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "productNumber must be an Identifier. It must occur only 1 time."@en .

baterr:SEM-BAT-MSG-015 a skos:Concept;
  skos:notation "SEM-BAT-MSG-015";
  skos:prefLabel "SEM-BAT-MSG-015"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
