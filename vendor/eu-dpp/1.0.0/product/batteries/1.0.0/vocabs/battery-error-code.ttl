  skos:definition "extinguishingAgent must be a multilingual String. It is a mandatory field and it could occur more than one time."@en .

baterr:SEM-BAT-MSG-026 a skos:Concept;
  skos:notation "SEM-BAT-MSG-026";
  skos:prefLabel "SEM-BAT-MSG-026"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
