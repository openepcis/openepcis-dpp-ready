  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "batteryWeight must be a Decimal and Unit (kilogram or gram), and it is a mandatory field. It must occur only 1 time."@en .

baterr:SEM-BAT-MSG-022 a skos:Concept;
  skos:notation "SEM-BAT-MSG-022";
  skos:prefLabel "SEM-BAT-MSG-022"@en;
