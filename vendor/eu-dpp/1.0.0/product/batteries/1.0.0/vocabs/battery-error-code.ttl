  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "batteryIdentification is a mandatory field. It must occur only 1 time. At least one of modelIdentifier and batchNumber, or serialNumber, or productNumber, or otherIdentificationElement must exist."@en .

baterr:SEM-BAT-MSG-011 a skos:Concept;
  skos:notation "SEM-BAT-MSG-011";
  skos:prefLabel "SEM-BAT-MSG-011"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
