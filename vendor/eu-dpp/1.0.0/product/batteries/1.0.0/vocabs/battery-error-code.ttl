  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "manufacturingCountry must be a string containing a three-letter code and it is a mandatory field. It must occur only 1 time."@en .

baterr:SEM-BAT-MSG-020 a skos:Concept;
  skos:notation "SEM-BAT-MSG-020";
  skos:prefLabel "SEM-BAT-MSG-020"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
