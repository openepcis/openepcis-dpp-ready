  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "batteryCapacity must be a Decimal and Unit (ampere hour or milliampere hour) and it is a mandatory field. It must occur only 1 time."@en .

baterr:SEM-BAT-MSG-023 a skos:Concept;
  skos:notation "SEM-BAT-MSG-023";
  skos:prefLabel "SEM-BAT-MSG-023"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
