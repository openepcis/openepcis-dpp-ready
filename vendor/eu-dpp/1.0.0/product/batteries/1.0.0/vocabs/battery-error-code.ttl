  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "hazardousSubstances must be a String. It is a mandatory field and it could occur more than one time."@en .

baterr:SEM-BAT-MSG-025 a skos:Concept;
  skos:notation "SEM-BAT-MSG-025";
  skos:prefLabel "SEM-BAT-MSG-025"@en;
