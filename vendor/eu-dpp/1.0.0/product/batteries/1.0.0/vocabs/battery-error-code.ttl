  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "manufacturingPlace is a mandatory field. It must occur only 1 time. At least one manufacturingCity or manufacturingRegion must exist."@en .

