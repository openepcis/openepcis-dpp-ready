  skos:definition "modelIdentifier must be an Identifier. It is a mandatory field if batchNumber exists. It must occur only 1 time."@en .

baterr:SEM-BAT-MSG-012 a skos:Concept;
  skos:notation "SEM-BAT-MSG-012";
  skos:prefLabel "SEM-BAT-MSG-012"@en;
