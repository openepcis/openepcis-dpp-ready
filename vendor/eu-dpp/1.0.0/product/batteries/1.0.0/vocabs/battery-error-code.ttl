  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-error-code>;
  skos:definition "batchNumber must be an Identifier. It is a mandatory field if modelIdentifier exists. It must occur only 1 time."@en .

