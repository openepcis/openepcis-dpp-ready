<https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-chemical-symbol>
  a skos:ConceptScheme, owl:Ontology;
  skos:notation "battery-chemical-symbol";
  skos:prefLabel "Battery Chemical Symbol Vocabulary"@en;
  dct:title "Battery Chemical Symbol Vocabulary"@en;
  skos:definition "Vocabulary of chemical symbol concepts used in the context of batteries. Regulation (EU) 2023/1542."@en;
  dct:source <http://data.europa.eu/eli/reg/2023/1542/2026-08-13>;
  dct:created "2026-10-30"^^xsd:date;
  owl:versionInfo "1.0.0";
  owl:versionIRI <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-chemical-symbol/1.0.0> ;
  skos:hasTopConcept batsym:cadmiumSymbol, batsym:leadSymbol, batsym:noneSymbol;
  dct:creator "European Commission";
  dct:license <https://interoperable-europe.ec.europa.eu/collection/eupl/eupl-text-eupl-12> .

