<https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary>
  a owl:Ontology, skos:ConceptScheme;
  owl:versionIRI <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary/1.0.0>;
  skos:notation "battery-vocabulary";
  skos:prefLabel "Battery Digital Product Passport Vocabulary"@en;
  dct:title "Battery Digital Product Passport Vocabulary"@en;
  skos:definition "Vocabulary of concepts used to support the battery digital product passport data model. Regulation (EU) 2023/1542."@en;
  dct:source <http://data.europa.eu/eli/reg/2023/1542/2026-08-13>;
  dct:created "2026-10-30"^^xsd:date;
  owl:versionInfo "1.0.0";
  dct:license <https://interoperable-europe.ec.europa.eu/collection/eupl/eupl-text-eupl-12>;
  dct:creator "European Commission", "GROW-DIGITAL-PRODUCT-PASSPORT@ec.europa.eu";
  skos:hasTopConcept bat:registrantIdentity, bat:manufacturerIdentification, bat:manufacturerPostalAddress,
    bat:manufacturerContactDetails, bat:batteryCategory, bat:batteryIdentification, bat:manufacturingPlace,
    bat:manufacturingDate, bat:batteryWeight, bat:batteryCapacity, bat:batteryChemistry,
    bat:hazardousSubstances, bat:extinguishingAgent, bat:criticalRawMaterials, bat:renewableContentShare,
    bat:minimalVoltage, bat:nominalVoltage, bat:maximumVoltage, bat:originalPowerCapability,
    bat:powerLimit, bat:expectedLifetimeCycles, bat:cycleLifeReferenceTest, bat:capacityExhaustionThreshold,
    bat:notInUseTemperatureRange, bat:commercialWarrantyPeriod, bat:initialRoundTripEnergyEfficiency,
    bat:roundTripEfficiencyAtHalfCycleLife, bat:internalCellResistance, bat:internalPackResistance,
    bat:cycleLifeChargeCRate, bat:cycleLifeDischargeCRate, bat:separateCollectionSymbol,
    bat:chemicalSymbol, bat:euDeclarationOfConformity, bat:wasteBatteryPreventionManagementInfo,
    bat:detailedComposition, bat:sparePartReplacementDetails, bat:dismantlingInformation,
    bat:safetyMeasures, bat:complianceTestReportResults, bat:ratedCapacity, bat:capacityFade,
    bat:powerCapability, bat:powerFade, bat:internalResistance, bat:internalResistanceIncrease,
    bat:roundTripEnergyEfficiency, bat:roundTripEnergyEfficiencyFade, bat:expectedLifetimeCyclesRest,
    bat:expectedLifetimeYears, bat:stateOfCertifiedEnergy, bat:remainingCapacity, bat:remainingPowerCapability,
    bat:remainingRoundTripEfficiency, bat:selfDischargingRateSet, bat:ohmicResistance,
    bat:batteryStatus, bat:numberOfChargingCycles .

