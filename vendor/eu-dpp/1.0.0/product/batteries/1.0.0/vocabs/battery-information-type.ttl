  skos:prefLabel "Battery Information Type Vocabulary"@en;
  dct:title "Battery Information Type Vocabulary"@en;
  skos:definition "Vocabulary of types of information access concepts used by the battery digital product passport. Annex XIII of Regulation (EU) 2023/1542."@en;
  dct:created "2026-10-30"^^xsd:date;
