        },
        "informationOnSourcesOfSpareParts": {
          "$ref": "#/$defs/RelatedResource",
          "x-AccessRights": "{\r\n\"read\": [ \"repairer\", \"remanufacturer\", \"repurposer\", \"purchaser\", \"third_party_acting_on_behalf_of_purchaser\", \"authorities\", \"commission\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
