    "batteryMaterialsAndComposition": {
      "type": "object",
      "properties": {
        "batteryChemistry": {
          "$ref": "#/$defs/batteryChemistryType",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "criticalRawMaterials": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 100,
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "hazardousSubstancesAndTheirImpact": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hazardousSubstancesType"
          },
          "minItems": 1,
          "maxItems": 1000,
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "materialsUsedInCathodeAnodeAndElectrolyte": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 100,
          "x-AccessRights": "{\r\n\"read\": [ \"repairer\", \"remanufacturer\", \"repurposer\", \"recycler\", \"battery_treatment_operators\", \"purchaser\", \"third_party_acting_on_behalf_of_purchaser\", \"authorities\", \"commission\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        }
      },
      "required": [
        "batteryChemistry",
        "criticalRawMaterials",
        "hazardousSubstancesAndTheirImpact",
        "materialsUsedInCathodeAnodeAndElectrolyte"
      ]
