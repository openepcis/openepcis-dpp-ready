{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dppHeader": {
      "$ref": "#/$defs/dppHeader"
    },
    "batteryPassportData": {
      "$ref": "#/$defs/batteryPassportMaster"
    }
  },
  "required": [
    "dppHeader",
    "batteryPassportData"
  ],
  "$defs": {
    "batteryPassportMaster": {
      "type": "object",
      "properties": {
        "batteryCarbonFootprint": {
          "$ref": "#/$defs/batteryCarbonFootprint"
        },
        "batteryMaterialsAndComposition": {
          "$ref": "#/$defs/batteryMaterialsAndComposition"
        },
        "circularityAndResourceEfficiency": {
          "$ref": "#/$defs/circularityAndResourceEfficiency"
        },
        "identifiersAndProductData": {
          "$ref": "#/$defs/identifiersAndProductData"
        },
        "performanceAndDurability": {
          "$ref": "#/$defs/performanceAndDurability"
        },
        "supplyChainDueDiligence": {
          "$ref": "#/$defs/supplyChainDueDiligence"
        },
        "symbolsLabelsAndDocumentationOfConformity": {
          "$ref": "#/$defs/symbolsLabelsAndDocumentationOfConformity"
        }
      },
      "required": [
        "batteryCarbonFootprint",
        "batteryMaterialsAndComposition",
        "circularityAndResourceEfficiency",
        "identifiersAndProductData",
        "performanceAndDurability",
        "supplyChainDueDiligence",
        "symbolsLabelsAndDocumentationOfConformity"
      ]
    },
    "dppHeader": {
      "type": "object",
      "properties": {
        "granularity": {
          "$ref": "#/$defs/dppGranularityType",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "economicOperatorId": {
          "type": "string",
          "format": "uri",
          "x-AccessRights": "{\r\n\"read\": [ \"notified_bodies\", \"authorities\", \"commission\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "contentSpecificationIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "facilityId": {
          "type": "string",
          "format": "uri",
          "x-AccessRights": "{\r\n\"read\": [ \"notified_bodies\", \"authorities\", \"commission\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\", \"third_parties_authorized_by_economic_operator\" ]\r\n}"
        },
        "dppStatus": {
          "$ref": "#/$defs/dppStatusType",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "dppSchemaVersion": {
          "type": "string",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "uniqueProductIdentifier": {
          "type": "string",
          "format": "uri",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "digitalProductPassportId": {
          "type": "string",
          "format": "uri",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\", \"third_parties_authorized_by_economic_operator\" ]\r\n}"
        }
      },
      "required": [
        "granularity",
        "economicOperatorId",
        "lastUpdated",
        "dppStatus",
        "dppSchemaVersion",
        "uniqueProductIdentifier",
        "digitalProductPassportId"
      ]
    },
    "batteryCarbonFootprint": {
      "type": "object",
      "properties": {
        "contributionOfRawMaterialAcquisitionAndPreProcessingLifecycleStage": {
          "$ref": "#/$defs/kgCO2EquivalentPerKilowattHourDecimal",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "batteryCarbonFootprintPerFunctionalUnit": {
          "$ref": "#/$defs/kgCO2EquivalentPerKilowattHourDecimal",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "contributionOfMainProductProductionLifecycleStage": {
          "$ref": "#/$defs/kgCO2EquivalentPerKilowattHourDecimal",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "contributionOfDistributionLifecycleStage": {
          "$ref": "#/$defs/kgCO2EquivalentPerKilowattHourDecimal",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "contributionOfEndOfLifeAndRecyclingLifecycleStage": {
          "$ref": "#/$defs/kgCO2EquivalentPerKilowattHourDecimal",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "carbonFootprintPerformanceClass": {
          "type": "string",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "webLinkToPublicCarbonFootprintStudy": {
          "pattern": "^https?://[^\\s/$.?#].[^\\s]*$",
          "type": "string",
          "format": "uri",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "absoluteBatteryCarbonFootprint": {
          "$ref": "#/$defs/kgCO2EquivalentInteger",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        }
      },
      "required": [
        "contributionOfRawMaterialAcquisitionAndPreProcessingLifecycleStage",
        "batteryCarbonFootprintPerFunctionalUnit",
        "contributionOfMainProductProductionLifecycleStage",
        "contributionOfDistributionLifecycleStage",
        "contributionOfEndOfLifeAndRecyclingLifecycleStage",
        "carbonFootprintPerformanceClass",
        "webLinkToPublicCarbonFootprintStudy"
      ]
