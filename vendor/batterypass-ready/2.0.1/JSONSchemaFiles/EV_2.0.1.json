          "$ref": "#/$defs/RelatedResource",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        },
        "informationOnBatteryCollectionPreparationForSecondLifeAndOnTreatmentAtEndOfLife": {
          "$ref": "#/$defs/RelatedResource",
          "x-AccessRights": "{\r\n\"read\": [ \"public\" ],\r\n\"write\": [ \"economic_operator\" ]\r\n}"
        }
