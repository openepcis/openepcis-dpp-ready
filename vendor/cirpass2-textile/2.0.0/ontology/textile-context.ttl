    skos:inScheme txtctx:ContextFactorScheme ;
    skos:prefLabel "Care-instruction compliance"@en ;
    txtcon:modellingNote "Following care instructions may support maintenance of product condition, but no deterministic lifetime inference is asserted."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 6.3.2, printed page 85, lines 2144-2157; JRC Preparatory Study, Section 13.7.2.8, printed page 404, lines 10440-10458; JRC Preparatory Study, Section 9.2.2.1, printed pages 122-123, lines 3234-3262."@en ;
    txtcon:sourceType txtcon:directExtraction ;
