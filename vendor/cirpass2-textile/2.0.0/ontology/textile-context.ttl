    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3322-3325; JRC Preparatory Study, Section 9.2.2.1, printed page 123, lines 3260-3262."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtctx:storageSunlightExposure a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Storage sunlight exposure"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Exposure to sunlight while a textile product is stored."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:broader txtctx:storageContextFactor ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:prefLabel "Storage sunlight exposure"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3322-3325; JRC Preparatory Study, Section 9.2.2.1, printed page 123, lines 3257-3262."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtctx:sunlightExposure a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Sunlight exposure"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Exposure of a textile product to direct or indirect sunlight during drying, storage or use."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:broader txtctx:environmentalContextFactor ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:prefLabel "Sunlight exposure"@en ;
    txtcon:modellingNote "Sunlight exposure may influence colour fastness and appearance depending on dyes, material and exposure conditions."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.1, printed page 123, lines 3257-3262; JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3315-3316; JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3322-3325."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtdur:ColourFastness .

txtctx:temperatureExposure a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Temperature exposure"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Exposure of a textile product to a stated temperature condition during use, care, drying, ironing or storage."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:broader txtctx:environmentalContextFactor ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:prefLabel "Temperature exposure"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3309-3318."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:uvExposure a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Ultraviolet exposure"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Exposure of a textile product to ultraviolet radiation; the source and exposure conditions should be stated where known."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:broader txtctx:environmentalContextFactor ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:prefLabel "Ultraviolet exposure"@en ;
    txtcon:sourceLocator "JRC Section 10.2.3, printed page 180, lines 5038-5043."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:washingFrequency a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Washing frequency"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "How often a textile product is washed during a stated reference period."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:broader txtctx:careContextFactor ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:prefLabel "Washing frequency"@en ;
    txtcon:modellingNote "Washing frequency may influence physical durability and dimensional stability, but the effect depends on material, programme and care conditions."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.7.2, printed page 395, lines 10241-10248; JRC Preparatory Study, Section 6.3.1, printed page 84, lines 2105-2111."@en ;
    txtcon:sourceType txtcon:directExtraction ;
    txtcon:typicalInfluenceOn txtdur:DimensionalStability ;
    txtctx:typicallyQualifiesProcess txtprc:WashingProcess .

txtctx:storageContextFactor a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Storage context factor"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Context factor related to storage practice or storage conditions."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:narrower txtctx:activeOrInactiveStorage,
        txtctx:foldingOrHangingCondition,
        txtctx:storageHumidity,
        txtctx:storageSunlightExposure ;
    skos:prefLabel "Storage context factor"@en ;
    skos:topConceptOf txtctx:ContextFactorScheme ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:userBehaviourFactor a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "User behaviour factor"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Context factor related to user choices affecting care, repair, storage, replacement or product use."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:narrower txtctx:careBehaviour,
        txtctx:careInstructionCompliance,
        txtctx:repairBehaviour,
        txtctx:replacementBehaviour ;
    skos:prefLabel "User behaviour factor"@en ;
    skos:topConceptOf txtctx:ContextFactorScheme ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:useContextFactor a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Use context factor"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Context factor related to how a textile product is used or worn."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:narrower txtctx:abrasionExposure,
        txtctx:durationOfUse,
        txtctx:frequencyOfUse,
        txtctx:intensityOfUse,
        txtctx:mechanicalStress ;
    skos:prefLabel "Use context factor"@en ;
    skos:topConceptOf txtctx:ContextFactorScheme ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:environmentalContextFactor a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Environmental exposure context factor"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Context factor related to sunlight, ultraviolet radiation, humidity, moisture, temperature or external chemicals."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:narrower txtctx:externalChemicalExposure,
        txtctx:humidityExposure,
        txtctx:moistureExposure,
        txtctx:sunlightExposure,
        txtctx:temperatureExposure,
        txtctx:uvExposure ;
    skos:prefLabel "Environmental exposure context factor"@en ;
    skos:topConceptOf txtctx:ContextFactorScheme ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:TextileContextObservation a owl:Class ;
    rdfs:label "Textile context observation"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A concrete observation, declaration or setting of a contextual condition applying to a textile product or a textile process execution."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:careContextFactor a skos:Concept,
        txtctx:TextileContextFactorConcept ;
    rdfs:label "Care context factor"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Context factor related to laundering, cleaning, drying, ironing, bleaching or other care practices."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:inScheme txtctx:ContextFactorScheme ;
    skos:narrower txtctx:bleachingPractice,
        txtctx:cleaningFrequency,
        txtctx:detergentUsePractice,
        txtctx:dryingPractice,
        txtctx:ironingPractice,
        txtctx:laundrySortingPractice,
        txtctx:washingFrequency ;
    skos:prefLabel "Care context factor"@en ;
    skos:topConceptOf txtctx:ContextFactorScheme ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:TextileContextFactorConcept a owl:Class ;
    rdfs:label "Textile context factor concept"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A SKOS concept identifying the type of contextual condition observed or declared for a textile product or process execution."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:ContextFactorScheme a skos:ConceptScheme ;
    rdfs:label "Textile context factor scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary of textile use, care, exposure, storage and user-behaviour context factor types."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    skos:hasTopConcept txtctx:careContextFactor,
        txtctx:environmentalContextFactor,
        txtctx:storageContextFactor,
        txtctx:useContextFactor,
        txtctx:userBehaviourFactor ;
    skos:prefLabel "Textile context factor scheme"@en ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

<https://w3id.org/eudpp/textile-context> a owl:Ontology ;
    rdfs:label "EU DPP Textile Context Ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Context Ontology. Version 2.0.0 candidate."@en ;
    dcterms:created "2026-03-06"^^xsd:date ;
    dcterms:creator "Elio Hbeich"@en,
        "BOUGACHA Racem"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Ontology module for representing concrete observations, declarations and settings about textile use, care, environmental exposure, storage and user behaviour. Context factor types are represented as SKOS concepts; processes and process parameters remain in TEXTILE_PROCESS."@en ;
    dcterms:issued "2026-03-06"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-27"^^xsd:date ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    dcterms:title "EU DPP Textile Context Ontology"@en ;
    vann:preferredNamespacePrefix "txtctx" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-context#" ;
    rdfs:comment "A context observation is not a textile process, process parameter, assessment result or derived indicator. Washing temperature and similar operational settings remain represented through TEXTILE_PROCESS."@en ;
    owl:imports <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-dpp-mireot>,
        <https://w3id.org/eudpp/textile-durability>,
        <https://w3id.org/eudpp/textile-process> ;
    owl:priorVersion <https://w3id.org/eudpp/textile-context/1.1.2> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-context/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" ;
    txtcon:sourceLocator "JRC 3rd milestone, Sections 6.3 (pages 84-87, lines 2105-2244), 9.2.2.2 (pages 125-126, lines 3296-3327), and 13.7.2 (pages 395-410, lines 10227-10646)."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

[] a owl:AllDisjointClasses ;
    owl:members ( txtctx:TextileContextObservation txtctx:TextileContextFactorConcept txtprc:TextileProcessExecution ) .

_:na28fd3c649554e6cb5a900ff416e8bbdb6 rdf:first txtprc:TextileProcessExecution ;
    rdf:rest () .

_:na28fd3c649554e6cb5a900ff416e8bbdb7 rdf:first dpp:Product ;
    rdf:rest _:na28fd3c649554e6cb5a900ff416e8bbdb6 .

_:na28fd3c649554e6cb5a900ff416e8bbdb1 a owl:Class ;
    owl:unionOf _:na28fd3c649554e6cb5a900ff416e8bbdb7 .

