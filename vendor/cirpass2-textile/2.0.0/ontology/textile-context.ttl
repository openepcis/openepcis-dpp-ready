txtctx:hasCategoricalValue a owl:ObjectProperty ;
    rdfs:label "has categorical value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile context observation to a controlled categorical value represented as a SKOS concept."@en ;
    rdfs:domain txtctx:TextileContextObservation ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    rdfs:range skos:Concept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:hasContextFactorType a owl:ObjectProperty ;
    rdfs:label "has context factor type"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Identifies the controlled context factor concept observed or declared by a textile context observation."@en ;
    rdfs:domain txtctx:TextileContextObservation ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    rdfs:range txtctx:TextileContextFactorConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:hasQuantitativeValue a owl:ObjectProperty ;
    rdfs:label "has quantitative value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile context observation to its quantitative value."@en ;
    rdfs:domain txtctx:TextileContextObservation ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:hasReferencePeriod a owl:ObjectProperty ;
    rdfs:label "has reference period"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile context observation to the structured time interval for which it is valid or observed."@en ;
    rdfs:domain txtctx:TextileContextObservation ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    rdfs:range txtcon:ReferencePeriod ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:hasTextualValue a owl:DatatypeProperty ;
    rdfs:label "has textual value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile context observation to a textual value used when no controlled concept or quantitative representation is available."@en ;
    rdfs:domain txtctx:TextileContextObservation ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    rdfs:range xsd:string ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtctx:typicallyQualifiesProcess a owl:AnnotationProperty ;
    rdfs:label "typically qualifies process"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Weak annotation relation indicating that a context factor typically qualifies the interpretation, applicability or expected effect of a textile process type."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtctx:abrasionExposure a skos:Concept,
