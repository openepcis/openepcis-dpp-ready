    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Performance threshold defining a minimum recycled-content value for a stated product, fibre or source context. Candidate values proposed in the JRC design option remain assessment data rather than universal OWL axioms."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf txtass:PerformanceThreshold ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 11.1.3, printed page 194, lines 5496-5503; JRC Preparatory Study, Section 11.1.3.1, printed page 194, lines 5504-5519."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:TextileWaste a owl:Class ;
    rdfs:label "Textile waste"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile product that the holder discards, intends to discard or is required to discard."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
