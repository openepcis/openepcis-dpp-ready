    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Assessment result describing whether recovered textile material meets stated quality requirements for a target use."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf txtass:AssessmentResult ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclabilityAssessmentMethod a owl:Class ;
    rdfs:label "Recyclability assessment method"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
