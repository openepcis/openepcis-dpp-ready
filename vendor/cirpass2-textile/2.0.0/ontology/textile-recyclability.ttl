    rdfs:comment "Assessment method used to verify a recycled-content declaration where no direct laboratory determination of recycled versus virgin fibre origin is available at scale."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf txtass:AssessmentMethod ;
    txtcon:sourceLocator "JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974."@en ;
