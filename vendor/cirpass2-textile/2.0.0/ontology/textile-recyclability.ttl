    rdfs:comment "Relates a recycled-content declaration to the absolute mass of recycled material included in the product."@en ;
    rdfs:domain txtrec:RecycledContentDeclaration ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:sourceLocator "JRC DPP Study, Section 7.4, printed page 54, data point “Amount of recycled material”."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtrec:hasRecyclingLoop a owl:ObjectProperty ;
