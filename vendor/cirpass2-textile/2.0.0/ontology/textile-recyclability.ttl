    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclabilityBarrier a owl:Class ;
    rdfs:label "Recyclability barrier"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Product, material, substance, information or system condition that hinders collection, sorting, preparation, recycling or the use and quality of recovered material for a specified route."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf txtass:AssessmentElement ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:RecyclabilityScoringRule a owl:Class ;
    rdfs:label "Recyclability scoring rule"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Rule belonging to a recyclability scoring method and assigning a quantitative point value to a stated criterion under stated route or threshold conditions."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    txtcon:sourceLocator "domain evidence from JRC Section 11.1.2.1, Table 76, pages 190-191."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecycledContentSourceConcept a owl:Class ;
    rdfs:label "Recycled content source concept"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled concept identifying the lifecycle source category of recycled content, including post-industrial, pre-consumer and post-consumer material. The declaration or method must state the definition framework used because ISO and ESPR terminology are not fully aligned."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "JRC DPP Study, Section 7.3, printed page 50, data point “Origin of the recycled content”."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:SortingCriterionConcept a owl:Class ;
    rdfs:label "Sorting criterion concept"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "SKOS concept used to classify a criterion applied during sorting for recycling."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "JRC Section 9.2.5.1, pages 136-137."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:CollectionScheme a skos:ConceptScheme ;
    rdfs:label "Collection scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled vocabulary of collection schemes for textile waste."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:dropOffCollectionScheme,
        txtrec:pickUpCollectionScheme,
        txtrec:takeBackCollectionScheme ;
    skos:prefLabel "Collection scheme"@en ;
    txtcon:sourceLocator "JRC Section 9.2.5.1, printed page 135, lines 3705-3712."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:RecyclabilityLabelScheme a skos:ConceptScheme ;
    rdfs:label "Recyclability label scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary for recyclability label scheme."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:conditionalRecyclabilityLabel,
        txtrec:highRecyclabilityLabel,
        txtrec:limitedRecyclabilityLabel ;
    skos:prefLabel "Recyclability label scheme"@en ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecycledContentDeclaration a owl:Class ;
    rdfs:label "Recycled content declaration"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Declaration reporting the mass fraction of recycled material in a textile product or material. Recycled content is related to, but distinct from, recyclability."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    txtcon:sourceLocator "JRC DPP Study, Section 7.3, printed page 50, data point “Recycled content”."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:RecycledContentSourceScheme a skos:ConceptScheme ;
    rdfs:label "Recycled content source scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary for recycled content source scheme."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:postConsumerRecycledContent,
        txtrec:postIndustrialRecycledContent,
        txtrec:preConsumerRecycledContent ;
    skos:prefLabel "Recycled content source scheme"@en ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:SortingTechniqueScheme a skos:ConceptScheme ;
    rdfs:label "Sorting technique scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled vocabulary of manual, automated and hybrid textile sorting techniques."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:automatedSortingTechnique,
        txtrec:hybridSortingTechnique,
        txtrec:manualSortingTechnique ;
    skos:prefLabel "Sorting technique scheme"@en ;
    txtcon:sourceLocator "JRC Section 9.2.5.1, printed pages 135-136, lines 3713-3752."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:RecyclabilityOutcomeConcept a owl:Class ;
    rdfs:label "Recyclability outcome concept"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled concept expressing the outcome of a recyclability criterion."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:TextileRecyclingEvent a owl:Class ;
    rdfs:label "Textile recycling event"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Concrete textile recycling occurrence represented both as a product event and as a textile process execution."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf dpp:ProductEvent,
        txtprc:TextileProcessExecution ;
    txtcon:sourceLocator "EU DPP EVENT module: dpp:ProductEvent."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:TextileWasteSourceConcept a owl:Class ;
    rdfs:label "Textile waste source concept"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled concept classifying textile waste according to the lifecycle stage at which it became waste."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:modellingNote "This vocabulary classifies a concrete waste resource and is distinct from RecycledContentSourceConcept, which classifies the declared origin of material already incorporated as recycled content."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed page 15, lines 188-212; JRC Preparatory Study, Section 9.2.4, printed page 130, lines 3487-3509."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:PreTreatmentTechniqueScheme a skos:ConceptScheme ;
    rdfs:label "Pre-treatment technique scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled vocabulary of techniques used to prepare textile waste for recycling."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:disassemblyPreTreatment,
        txtrec:manualSeparationPreTreatment,
        txtrec:mechanicalSeparationPreTreatment,
        txtrec:shreddingPreTreatment ;
    skos:prefLabel "Pre-treatment technique scheme"@en ;
    txtcon:sourceLocator "JRC Section 9.2.5.1, printed pages 136-137, lines 3753-3760; Table 50, printed pages 137-138, caption at line 3774."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:SortingCriterionScheme a skos:ConceptScheme ;
    rdfs:label "Sorting criterion scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled vocabulary of criteria used to sort textile waste for recycling routes."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:colourSortingCriterion,
        txtrec:fibreCompositionSortingCriterion,
        txtrec:productConstructionSortingCriterion,
        txtrec:productTypeSortingCriterion ;
    skos:prefLabel "Sorting criterion scheme"@en ;
    txtcon:sourceLocator "JRC Section 9.2.5.1, printed pages 135-136, lines 3713-3752."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:productDesignCriterion a skos:Concept,
        txtrec:RecyclabilityCriterionConcept ;
    rdfs:label "Product-design criterion"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Criterion concerning product composition, components, finishes or construction."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:inScheme txtrec:RecyclabilityCriterionScheme ;
    skos:narrower txtrec:disruptiveElementAbsenceCriterion,
        txtrec:innerOuterCompositionSimilarityCriterion,
        txtrec:materialChoiceCriterion,
        txtrec:materialSeparabilityCriterion,
        txtrec:monoMaterialCriterion,
        txtrec:sequinAbsenceCriterion,
        txtrec:substanceRestrictionCriterion ;
    skos:prefLabel "Product-design criterion"@en ;
    skos:topConceptOf txtrec:RecyclabilityCriterionScheme ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:routeSpecificCriterion a skos:Concept,
        txtrec:RecyclabilityCriterionConcept ;
    rdfs:label "Route-specific criterion"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Criterion whose outcome depends on the selected recycling technology or route."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:inScheme txtrec:RecyclabilityCriterionScheme ;
    skos:narrower txtrec:coatingAbsenceCriterion,
        txtrec:dyeAbsenceCriterion,
        txtrec:elastaneProportionCriterion,
        txtrec:fibreCompositionEligibilityCriterion,
        txtrec:fibreFeedstockUseCriterion,
        txtrec:mechanicalRecyclingCompatibilityCriterion,
        txtrec:printingAbsenceCriterion ;
    skos:prefLabel "Route-specific criterion"@en ;
    skos:topConceptOf txtrec:RecyclabilityCriterionScheme ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:TextileWasteSourceScheme a skos:ConceptScheme ;
    rdfs:label "Textile waste source scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled vocabulary of post-industrial, pre-consumer and post-consumer textile waste source categories."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:postConsumerTextileWaste,
        txtrec:postIndustrialTextileWaste,
        txtrec:preConsumerTextileWaste ;
    skos:prefLabel "Textile waste source scheme"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed page 15, lines 188-212; JRC Preparatory Study, Section 9.2.4, printed page 130, lines 3487-3509."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclabilityAssessmentResult a owl:Class ;
    rdfs:label "Recyclability assessment result"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Result produced by a recyclability assessment, reporting route-specific criterion outcomes, barriers, recyclable fraction, score or label when applicable."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf txtass:AssessmentResult ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclingRoute a owl:Class ;
    rdfs:label "Recycling route"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Specified sequence or configuration of collection, sorting, preparation and recycling stages used as the context for a recyclability assessment or actual recycling operation."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclabilityOutcomeScheme a skos:ConceptScheme ;
    rdfs:label "Recyclability outcome scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary for recyclability outcome scheme."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:criterionNotApplicable,
        txtrec:criterionNotAssessed,
        txtrec:criterionNotSatisfied,
        txtrec:criterionPartlySatisfied,
        txtrec:criterionSatisfied,
        txtrec:criterionUncertain ;
    skos:prefLabel "Recyclability outcome scheme"@en ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclabilityBarrierTypeConcept a owl:Class ;
    rdfs:label "Recyclability barrier type concept"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled concept classifying a recyclability barrier."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclabilityCriterionConcept a owl:Class ;
    rdfs:label "Recyclability criterion concept"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled concept identifying a criterion used in a recyclability assessment."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclabilityCriterionScheme a skos:ConceptScheme ;
    rdfs:label "Recyclability criterion scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary for recyclability criterion scheme."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:informationCriterion,
        txtrec:productDesignCriterion,
        txtrec:routeSpecificCriterion,
        txtrec:systemConditionCriterion ;
    skos:prefLabel "Recyclability criterion scheme"@en ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:RecyclabilityBarrierTypeScheme a skos:ConceptScheme ;
    rdfs:label "Recyclability barrier type scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary for recyclability barrier type scheme."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    skos:hasTopConcept txtrec:chemicalFinishBarrier,
        txtrec:coatingBarrier,
        txtrec:collectionOrSortingSystemBarrier,
        txtrec:darkColourSortingBarrier,
        txtrec:differentInnerOuterFibreBarrier,
        txtrec:dyeBarrier,
        txtrec:highElastaneContentBarrier,
        txtrec:insufficientCompositionInformationBarrier,
        txtrec:minorFibreDetectionBarrier,
        txtrec:mixedFibreCompositionBarrier,
        txtrec:multiLayerConstructionBarrier,
        txtrec:nonTextileComponentBarrier,
        txtrec:printingBarrier,
        txtrec:sequinBarrier,
        txtrec:substanceOfConcernBarrier,
        txtrec:unavailableDataCarrierBarrier ;
    skos:prefLabel "Recyclability barrier type scheme"@en ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

<https://w3id.org/eudpp/textile-recyclability> a owl:Ontology ;
    rdfs:label "EU DPP Textile Recyclability Ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Recyclability Ontology. Version 2.0.0 candidate."@en ;
    dcterms:created "2026-07-09"^^xsd:date ;
    dcterms:creator "BOUGACHA Racem"@en,
        "Elio Hbeich"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Ontology module for route-specific textile recyclability, assessment criteria and results, barriers, scores and labels, actual recycling events, recovered materials, textile waste categories, recycling yield and recycled-content declarations."@en ;
    dcterms:issued "2026-07-09"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-27"^^xsd:date ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    dcterms:title "EU DPP Textile Recyclability Ontology"@en ;
    vann:preferredNamespacePrefix "txtrec" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-recyclability#" ;
    rdfs:comment "Recyclability is represented as route-specific potential assessed under stated collection, sorting, preparation and recycling conditions. It must not be inferred from a universal boolean."@en,
        "Recycled content is represented separately from recyclability: a product can contain recycled material without being recyclable through a given route, and a recyclable product may contain no recycled material."@en,
        "Scores and labels are method-specific and do not constitute adopted regulatory classifications unless a future delegated act or standard defines them."@en ;
    owl:imports <https://w3id.org/eudpp/textile-assessment>,
        <https://w3id.org/eudpp/textile-associated-materials>,
        <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-core>,
        <https://w3id.org/eudpp/textile-dpp-mireot>,
        <https://w3id.org/eudpp/textile-event-mireot>,
        <https://w3id.org/eudpp/textile-indicator>,
        <https://w3id.org/eudpp/textile-process>,
        <https://w3id.org/eudpp/textile-soc> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-recyclability/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:projectDecision .

[] a owl:AllDisjointClasses ;
    owl:members ( txtrec:Recyclability txtrec:RecycledContent ) .

[] a owl:AllDisjointClasses ;
    owl:members ( txtrec:RecyclabilityAssessment txtrec:RecycledContentAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( txtrec:RecyclabilityAssessmentResult txtrec:RecycledContentAssessmentResult ) .
