            owl:unionOf ( txtrec:RecyclingRoute txtrec:RecyclabilityAssessmentResult txtrec:TextileRecyclingEvent ) ] ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclingLoopConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtrec:hasRecyclingYieldResult a owl:ObjectProperty ;
