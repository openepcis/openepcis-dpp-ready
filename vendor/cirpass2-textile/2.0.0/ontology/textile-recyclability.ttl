@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix txt: <https://w3id.org/eudpp/textile-core#> .
@prefix txtam: <https://w3id.org/eudpp/textile-associated-materials#> .
@prefix txtass: <https://w3id.org/eudpp/textile-assessment#> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix txtind: <https://w3id.org/eudpp/textile-indicator#> .
@prefix txtprc: <https://w3id.org/eudpp/textile-process#> .
@prefix txtrec: <https://w3id.org/eudpp/textile-recyclability#> .
@prefix txtsoc: <https://w3id.org/eudpp/textile-soc#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

txtrec:ChainOfCustodyVerificationMethod a owl:Class ;
    rdfs:label "Chain-of-custody verification method"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Third-party verification method relying on chain-of-custody tracking of recycled material."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf txtrec:RecycledContentVerificationMethod ;
    txtcon:sourceLocator "JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:ChemicalRecyclingRoute a owl:Class ;
    rdfs:label "Chemical recycling route"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Recycling route whose principal recycling stage chemically transforms textile inputs to recover polymeric, cellulosic or other material feedstock."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue txtprc:ChemicalRecyclingProcess ;
            owl:onProperty txtrec:usesRecyclingProcessType ],
        txtrec:RecyclingRoute ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:ManufacturerDeclarationVerificationMethod a owl:Class ;
    rdfs:label "Manufacturer-declaration verification method"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Verification method based on a declaration made by the manufacturer."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf txtrec:RecycledContentVerificationMethod ;
    txtcon:sourceLocator "JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:MechanicalRecyclingRoute a owl:Class ;
    rdfs:label "Mechanical recycling route"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Recycling route whose principal recycling stage mechanically transforms textile inputs into reusable fibres or materials."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue txtprc:MechanicalRecyclingProcess ;
            owl:onProperty txtrec:usesRecyclingProcessType ],
        txtrec:RecyclingRoute ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:RecycledTextileFibre a owl:Class ;
    rdfs:label "Recycled textile fibre"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Recovered textile material represented as a textile fibre suitable, subject to quality and process requirements, for use in textile products."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf txt:TextileFibre,
        txtrec:RecoveredTextileMaterial ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrec:TextileChemicalRecyclingEvent a owl:Class ;
    rdfs:label "Textile chemical recycling event"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Textile recycling event executing the chemical recycling process type."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue txtprc:ChemicalRecyclingProcess ;
            owl:onProperty txtprc:executesProcessType ],
        txtrec:TextileRecyclingEvent ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:TextileMechanicalRecyclingEvent a owl:Class ;
    rdfs:label "Textile mechanical recycling event"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Textile recycling event executing the mechanical recycling process type."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue txtprc:MechanicalRecyclingProcess ;
            owl:onProperty txtprc:executesProcessType ],
        txtrec:TextileRecyclingEvent ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:appliesSortingCriterion a owl:ObjectProperty ;
    rdfs:label "applies sorting criterion"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a sorting-for-recycling process to a criterion applied during sorting."@en ;
    rdfs:domain txtrec:SortingForRecyclingProcess ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:SortingCriterionConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtrec:assessesRecyclabilityOf a owl:ObjectProperty ;
    rdfs:label "assesses recyclability of"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability assessment execution specifically to the product whose recyclability it assesses."@en ;
    rdfs:domain txtrec:RecyclabilityAssessment ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range dpp:Product ;
    rdfs:subPropertyOf txtass:assessesProduct ;
    owl:inverseOf txtrec:hasRecyclabilityAssessment ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:assessesRecyclingRoute a owl:ObjectProperty ;
    rdfs:label "assesses recycling route"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability assessment to a recycling route evaluated by that assessment."@en ;
    rdfs:domain txtrec:RecyclabilityAssessment ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclingRoute ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:awardsScoreValue a owl:ObjectProperty ;
    rdfs:label "awards score value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability scoring rule to the dimensionless quantitative score value awarded when the rule is satisfied."@en ;
    rdfs:domain txtrec:RecyclabilityScoringRule ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:sourceLocator "JRC Section 11.1.2.1, Table 76, pages 190-191."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:barrierAppliesToRoute a owl:ObjectProperty ;
    rdfs:label "barrier applies to route"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability barrier to the recycling route it hinders."@en ;
    rdfs:domain txtrec:RecyclabilityBarrier ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclingRoute ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:evaluatesCriterion a owl:ObjectProperty ;
    rdfs:label "evaluates criterion"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a criterion result to the controlled criterion it evaluates."@en ;
    rdfs:domain txtrec:RecyclabilityCriterionResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclabilityCriterionConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:followsRecyclingRoute a owl:ObjectProperty ;
    rdfs:label "follows recycling route"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates an actual textile recycling event to the route it follows."@en ;
    rdfs:domain txtrec:TextileRecyclingEvent ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclingRoute ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasBarrierType a owl:ObjectProperty ;
    rdfs:label "has barrier type"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Classifies a recyclability barrier using a controlled barrier concept."@en ;
    rdfs:domain txtrec:RecyclabilityBarrier ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclabilityBarrierTypeConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasCriterionOutcome a owl:ObjectProperty ;
    rdfs:label "has criterion outcome"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a criterion result to its controlled assessment outcome."@en ;
    rdfs:domain txtrec:RecyclabilityCriterionResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclabilityOutcomeConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasCriterionResult a owl:ObjectProperty ;
    rdfs:label "has criterion result"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates an aggregate recyclability result to an outcome for one evaluated criterion."@en ;
    rdfs:domain txtrec:RecyclabilityAssessmentResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclabilityCriterionResult ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasMaximumScoreValue a owl:ObjectProperty ;
    rdfs:label "has maximum score value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability scoring method to the maximum dimensionless score value defined by that method."@en ;
    rdfs:domain txtrec:RecyclabilityScoringMethod ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:sourceLocator "candidate JRC DO2 scale in Section 11.1.2.1, pages 190-191."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasMinimumScoreValue a owl:ObjectProperty ;
    rdfs:label "has minimum score value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability scoring method to the minimum dimensionless score value defined by that method."@en ;
    rdfs:domain txtrec:RecyclabilityScoringMethod ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:sourceLocator "candidate JRC DO2 scale in Section 11.1.2.1, pages 190-191."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasRecoveredMaterial a owl:ObjectProperty ;
    rdfs:label "has recovered material"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates an actual textile recycling event to material recovered as an output."@en ;
    rdfs:domain txtrec:TextileRecyclingEvent ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecoveredTextileMaterial ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasRecoveredMaterialQualityResult a owl:ObjectProperty ;
    rdfs:label "has recovered material quality result"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates an assessment or recycling result to a quality result for the recovered material."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( txtrec:RecyclabilityAssessmentResult txtrec:TextileRecyclingEvent ) ] ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecoveredMaterialQualityResult ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasRecyclabilityAspect a owl:ObjectProperty ;
    rdfs:label "has recyclability aspect"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a product to its recyclability product aspect."@en ;
    rdfs:domain dpp:Product ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:Recyclability ;
    rdfs:subPropertyOf dpp:hasProperty ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtrec:hasRecyclabilityBarrier a owl:ObjectProperty ;
    rdfs:label "has recyclability barrier"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a route-specific assessment result to a barrier identified during the assessment."@en ;
    rdfs:domain txtrec:RecyclabilityAssessmentResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclabilityBarrier ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtrec:hasRecyclabilityLabel a owl:ObjectProperty ;
    rdfs:label "has recyclability label"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability score to a controlled method-specific label."@en ;
    rdfs:domain txtrec:RecyclabilityScore ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclabilityLabelConcept ;
    rdfs:subPropertyOf txtind:hasCategoricalValue ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2193-2205; JRC DPP Study, Section 7.3, printed page 49, data point “Recyclability score”."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtrec:hasRecyclabilityScore a owl:ObjectProperty ;
    rdfs:label "has recyclability score"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability assessment result to its method-specific score indicator."@en ;
    rdfs:domain txtrec:RecyclabilityAssessmentResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecyclabilityScore ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2193-2205; JRC DPP Study, Section 7.3, printed page 49, data point “Recyclability score”."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtrec:hasRecyclabilityTechnologyLevel a owl:ObjectProperty ;
    rdfs:label "has recyclability technology level"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Classifies a recyclability assessment result using the shared product-technology-level vocabulary defined in Textile Connector."@en ;
    rdfs:domain txtrec:RecyclabilityAssessmentResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtcon:ProductTechnologyLevelConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtrec:hasRecyclableMassFractionValue a owl:ObjectProperty ;
    rdfs:label "has recyclable mass fraction value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recyclability assessment result to the mass fraction judged recyclable for the stated route and conditions."@en ;
    rdfs:domain txtrec:RecyclabilityAssessmentResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasRecycledContentAspect a owl:ObjectProperty ;
    rdfs:label "has recycled content aspect"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile product to the recycled-content product aspect used to organise declarations and assessments."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecycledContent ;
    txtcon:sourceLocator "domain evidence from JRC Section 9.2.5.4, page 143."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasRecycledContentAssessment a owl:ObjectProperty ;
    rdfs:label "has recycled content assessment"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile product to a recycled-content assessment execution."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecycledContentAssessment ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasRecycledContentDeclaration a owl:ObjectProperty ;
    rdfs:label "has recycled content declaration"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a product to a recycled-content declaration."@en ;
    rdfs:domain dpp:Product ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecycledContentDeclaration ;
    txtcon:sourceLocator "JRC DPP Study, Section 7.3, printed page 50, data point “Recycled content”."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtrec:hasRecycledContentMassFractionValue a owl:ObjectProperty ;
    rdfs:label "has recycled content mass fraction value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recycled-content declaration to a quantitative mass fraction expressed using the shared textile value pattern."@en ;
    rdfs:domain txtrec:RecycledContentDeclaration ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:sourceLocator "JRC Study on DPP content for textile apparel products under ESPR, page 51, lines 2218-2233; JRC 3rd Milestone working document, page 194"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrec:hasRecycledContentSource a owl:ObjectProperty ;
    rdfs:label "has recycled content source"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a recycled-content declaration to a controlled post-industrial, pre-consumer or post-consumer source category defined by the stated methodology."@en ;
    rdfs:domain txtrec:RecycledContentDeclaration ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtrec:RecycledContentSourceConcept ;
    txtcon:sourceLocator "JRC DPP Study, Section 7.3, printed page 50, data point “Origin of the recycled content”."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtrec:hasRecycledContentTechnologyLevel a owl:ObjectProperty ;
    rdfs:label "has recycled content technology level"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Classifies a recycled-content assessment result using the shared product-technology-level vocabulary defined in Textile Connector."@en ;
    rdfs:domain txtrec:RecycledContentAssessmentResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
    rdfs:range txtcon:ProductTechnologyLevelConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtrec:hasRecycledMaterialMassValue a owl:ObjectProperty ;
