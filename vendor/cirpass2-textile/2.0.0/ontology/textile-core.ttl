    skos:topConceptOf txtcs:FibreTypeScheme ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtcs:naturalOriginFibre a skos:Concept,
        txt:FibreTypeConcept ;
    rdfs:label "Natural origin fibre"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A textile fibre category of natural origin."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:inScheme txtcs:FibreTypeScheme ;
    skos:narrower txtcs:animalOriginFibre,
        txtcs:vegetableOriginFibre ;
    skos:notation "FIBRE_NATURAL_ORIGIN" ;
    skos:prefLabel "Natural origin fibre"@en ;
    skos:topConceptOf txtcs:FibreTypeScheme ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txt:FibreCompositionComponent a owl:Class ;
    rdfs:label "Fibre composition component"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A structured component of a textile product fibre composition, specifying a fibre type and its quantitative share in the product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty txt:hasFibreType ;
            owl:someValuesFrom txt:FibreTypeConcept ],
        [ a owl:Restriction ;
            owl:onProperty txt:hasFibreMassFraction ;
            owl:someValuesFrom txtcon:QuantitativeValue ],
        dpp:MaterialOfComposition ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:StudyScopeStatusConcept a owl:Class ;
    rdfs:label "Study scope status concept"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "SKOS concept used to indicate whether a textile product type is included in, excluded from, or otherwise qualified with respect to a study or regulatory modelling scope."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtcs:StudyScopeStatusScheme a skos:ConceptScheme ;
    rdfs:label "Study scope status scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled vocabulary for representing the status of a textile product type with respect to the JRC preparatory study scope."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:hasTopConcept txtcs:excludedFromJRCPreparatoryStudyScope,
        txtcs:includedInJRCPreparatoryStudyScope ;
    skos:prefLabel "Study scope status scheme"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtcs:animalOriginFibre a skos:Concept,
        txt:FibreTypeConcept ;
    rdfs:label "Animal origin fibre"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A natural-origin textile fibre category that includes wool, silk and hair."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:broader txtcs:naturalOriginFibre ;
    skos:inScheme txtcs:FibreTypeScheme ;
    skos:narrower txtcs:hair,
        txtcs:silk,
        txtcs:wool ;
    skos:notation "FIBRE_ANIMAL_ORIGIN" ;
    skos:prefLabel "Animal origin fibre"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtcs:vegetableOriginFibre a skos:Concept,
        txt:FibreTypeConcept ;
    rdfs:label "Vegetable origin fibre"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A natural-origin textile fibre category that includes cotton, flax and jute."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:broader txtcs:naturalOriginFibre ;
    skos:inScheme txtcs:FibreTypeScheme ;
    skos:narrower txtcs:cotton,
        txtcs:flax,
        txtcs:jute ;
    skos:notation "FIBRE_VEGETABLE_ORIGIN" ;
    skos:prefLabel "Vegetable origin fibre"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txt:TextileApparel a owl:Class ;
    rdfs:label "Textile apparel"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile products that aim to cover the body with everything except footwear, including clothing and clothing accessories worn to clothe, adorn, shield, provide comfort, or express identity and belonging."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileProduct ;
    txtcon:modellingNote "TextileApparel is a final textile product category for apparel and apparel accessories. The supplied EU DPP Core snapshot does not declare a separate FinalProduct class, so final-product status remains a local textile distinction under dpp:Product. It is narrower than TextileProduct and should not be confused with the whole textile product domain."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed page 14, lines 167-170; JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txt:defaultStudyScopeStatus txtcs:includedInJRCPreparatoryStudyScope .

txtcs:textileApparelAccessory a skos:Concept,
        txt:TextileApparelProductTypeConcept ;
    rdfs:label "Textile apparel accessory"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled product-type concept corresponding to the textile apparel accessories category in JRC Table 7, including hats, scarves and ties, belts, gloves and mittens."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:inScheme txtcs:TextileApparelProductTypeScheme ;
    skos:narrower txtcs:belt,
        txtcs:gloveOrMitten,
        txtcs:hat,
        txtcs:scarfOrTie ;
    skos:notation "APPAREL_ACCESSORY" ;
    skos:prefLabel "Textile apparel accessory"@en ;
    skos:topConceptOf txtcs:TextileApparelProductTypeScheme ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed page 24, lines 443-456; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtcs:manMadeCellulosicFibre a skos:Concept,
        txt:FibreTypeConcept ;
    rdfs:label "Man-made cellulosic fibre"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A man-made cellulosic fibre category that includes viscose, cupro, lyocell, acetate and triacetate."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:broader txtcs:chemicalFibre ;
    skos:inScheme txtcs:FibreTypeScheme ;
    skos:narrower txtcs:acetate,
        txtcs:cupro,
        txtcs:lyocell,
        txtcs:triacetate,
        txtcs:viscose ;
    skos:notation "FIBRE_MAN_MADE_CELLULOSIC" ;
    skos:prefLabel "Man-made cellulosic fibre"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtcs:syntheticPolymerFibre a skos:Concept,
        txt:FibreTypeConcept ;
    rdfs:label "Synthetic polymer fibre"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A synthetic polymer fibre category that includes polyester, polyamide, acrylic, polypropylene and elastane."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:broader txtcs:chemicalFibre ;
    skos:inScheme txtcs:FibreTypeScheme ;
    skos:narrower txtcs:acrylic,
        txtcs:elastane,
        txtcs:polyamide,
        txtcs:polyester,
        txtcs:polypropylene ;
    skos:notation "FIBRE_SYNTHETIC_POLYMER" ;
    skos:prefLabel "Synthetic polymer fibre"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtcs:excludedFromJRCPreparatoryStudyScope a skos:Concept,
        txt:StudyScopeStatusConcept ;
    rdfs:label "Excluded from JRC preparatory study scope"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Study scope status indicating that the textile product type is excluded from the JRC preparatory study scope without implying that it is not a textile product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:inScheme txtcs:StudyScopeStatusScheme ;
    skos:prefLabel "Excluded from JRC preparatory study scope"@en ;
    skos:topConceptOf txtcs:StudyScopeStatusScheme ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:TextileProduct a owl:Class ;
    rdfs:label "Textile product"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Any raw, semi-worked, worked, semi-manufactured, manufactured, semi-made-up or made-up product which is exclusively composed of textile fibres, as well as a product containing at least 80% textile fibres by weight."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf dpp:Product ;
    txtcon:modellingNote "TextileProduct is the broad textile product class. It includes final products and products serving an intermediate or component role when they are represented as product-like traceability resources. Identification constraints should be specified by SHACL according to product granularity rather than imposed uniformly on every TextileProduct."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed page 14, lines 161-166."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txt:TextileApparelProductTypeConcept a owl:Class ;
    rdfs:label "Textile apparel product type concept"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "SKOS concept used as a controlled value for classifying textile apparel product types."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtcs:FibreTypeScheme a skos:ConceptScheme ;
    rdfs:label "Textile fibre type scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled vocabulary of textile fibre types used to describe textile fibre composition."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:hasTopConcept txtcs:chemicalFibre,
        txtcs:naturalOriginFibre ;
    skos:prefLabel "Textile fibre type scheme"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:FibreTypeConcept a owl:Class ;
    rdfs:label "Fibre type concept"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "SKOS concept used as a controlled value for textile fibre type in a fibre composition."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf skos:Concept,
        dpp:MaterialType ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtcs:TextileApparelProductTypeScheme a skos:ConceptScheme ;
    rdfs:label "Textile apparel product type scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled vocabulary representing the textile apparel categories of JRC Table 7. The JRC categories are aligned with the PEFCR Apparel and Footwear work but this scheme does not claim identity with the complete PEFCR segmentation."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    skos:hasTopConcept txtcs:dressSkirtOrJumpsuit,
        txtcs:jacketOrCoat,
        txtcs:leggingStockingTightOrSock,
        txtcs:pantsOrShorts,
        txtcs:shirtOrBlouse,
        txtcs:sweaterOrMidLayer,
        txtcs:swimwear,
        txtcs:tShirt,
        txtcs:textileApparelAccessory,
        txtcs:underwear,
        txtcs:workwear ;
    skos:prefLabel "Textile apparel product type scheme"@en ;
    txtcon:modellingNote "A single textile product-type scheme is retained to avoid duplicating JRC and PEFCR classifications. External PEFCR identifiers may be mapped when a stable authoritative classification is selected."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

<https://w3id.org/eudpp/textile-core> a owl:Ontology ;
    rdfs:label "EU DPP Textile Core Ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Core Ontology. Version 2.0.0 candidate."@en ;
    dcterms:created "2026-03-06"^^xsd:date ;
    dcterms:creator "Elio Hbeich"@en,
        "BOUGACHA Racem"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Ontology module for representing core textile product data relevant to EU Digital Product Passports, including textile product classes, textile apparel scope concepts, fibre composition structures, and controlled SKOS vocabularies for textile apparel product types and fibre types aligned with the JRC preparatory study on textiles."@en ;
    dcterms:issued "2026-03-06"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-02"^^xsd:date ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    dcterms:title "EU DPP Textile Core Ontology"@en ;
    vann:preferredNamespacePrefix "txt" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-core#" ;
    rdfs:comment "Fibre, yarn and fabric are modelled as textile products. When one product is intended to be incorporated into another, dpp:isComponentOf expresses the component role; the ontology does not create a separate intermediate-product class."@en,
        "Named fibre types and textile apparel product categories are represented as SKOS concepts because they are controlled classification values rather than product subclasses."@en,
        "Product types such as medical-device, PPE or toy textile apparel remain textile apparel by product nature but are annotated as excluded from the JRC preparatory study scope where appropriate."@en,
        "These notations are stable local identifiers intended to support data exchange, mapping and validation."@en ;
    owl:imports <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-dpp-mireot>,
        <https://w3id.org/eudpp/textile-mat-mireot> ;
    owl:priorVersion <https://w3id.org/eudpp/textile-core/1.1.2> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-core/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" .

