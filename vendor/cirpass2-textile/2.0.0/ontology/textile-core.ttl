@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix txt: <https://w3id.org/eudpp/textile-core#> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix txtcs: <https://w3id.org/eudpp/textile-codelists#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

txt:ElectronicTextile a owl:Class ;
    rdfs:label "Electronic textile"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile-based system that exhibits an intended and exploitable response to changes in its surroundings or to an external signal or input."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileProduct ;
    skos:altLabel "E-textile"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-477."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txt:defaultStudyScopeStatus txtcs:excludedFromJRCPreparatoryStudyScope ;
    txt:jrcExclusionReason "Excluded because electronic textiles are very different from textile apparel in terms of function and physical characteristics."@en .

txt:Fabric a owl:Class ;
    rdfs:label "Fabric"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile product made from yarns, fibres or filaments and intended to be incorporated into another textile product or used in further manufacturing."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileProduct ;
    txtcon:modellingNote "Fabric is modelled as a textile product. When a fabric is incorporated into another product, the instance-level relation dpp:isComponentOf expresses that role; no separate intermediate-product class is required."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 486-492; JRC Preparatory Study, Section 3.3.1, printed page 27, lines 536-546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:MedicalDeviceTextileApparel a owl:Class ;
    rdfs:label "Medical device textile apparel"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile apparel identified as a medical device or as an accessory for a medical device in accordance with Regulation (EU) 2017/745."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileApparel ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-481."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txt:defaultStudyScopeStatus txtcs:excludedFromJRCPreparatoryStudyScope ;
    txt:jrcExclusionReason "Excluded because textile apparel identified as a medical device or as an accessory for a medical device is outside the selected scope."@en .

txt:PPETextileApparel a owl:Class ;
    rdfs:label "PPE textile apparel"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile apparel identified as personal protective equipment in accordance with Regulation (EU) 2016/425."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileApparel ;
    skos:altLabel "Personal protective equipment textile apparel"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-479."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txt:defaultStudyScopeStatus txtcs:excludedFromJRCPreparatoryStudyScope ;
    txt:jrcExclusionReason "Excluded because textile apparel identified as personal protective equipment is outside the selected scope."@en .

txt:ReusableTextileAbsorbentHygieneProduct a owl:Class ;
    rdfs:label "Reusable textile absorbent hygiene product"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Reusable textile absorbent hygiene product considered a technical textile and excluded from scope."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileProduct ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 495-506; JRC Preparatory Study, relevant section, printed page 19, lines 275-279; JRC Preparatory Study, relevant section, Table 3, printed page 19; caption line 275."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txt:defaultStudyScopeStatus txtcs:excludedFromJRCPreparatoryStudyScope ;
    txt:jrcExclusionReason "Excluded because reusable textile absorbent hygiene products perform a different function from textile apparel and are considered technical textiles."@en .

txt:SmartTextile a owl:Class ;
    rdfs:label "Smart textile"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile able to sense and react to environmental conditions or external stimuli through incorporated sensors or responsive components."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileProduct ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-474."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txt:defaultStudyScopeStatus txtcs:excludedFromJRCPreparatoryStudyScope ;
    txt:jrcExclusionReason "Excluded because smart textiles are very different from textile apparel in terms of function and physical characteristics."@en .

txt:TextileCleaningProduct a owl:Class ;
    rdfs:label "Textile cleaning product"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile cleaning product considered a technical textile and excluded from scope because its function differs from apparel."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileProduct ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 495-505; JRC Preparatory Study, relevant section, printed page 19, lines 275-279; JRC Preparatory Study, relevant section, Table 3, printed page 19; caption line 275."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txt:defaultStudyScopeStatus txtcs:excludedFromJRCPreparatoryStudyScope ;
    txt:jrcExclusionReason "Excluded because textile cleaning products perform a different function from textile apparel and are considered technical textiles."@en .

txt:TextileFibre a owl:Class ;
    rdfs:label "Textile fibre"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Unit of matter characterised by flexibility, fineness and a high ratio of length to maximum transverse dimension, suitable for textile applications."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileProduct ;
    txtcon:modellingNote "TextileFibre is modelled as a textile product when it is represented as an identifiable fibre batch or traceability object. Its incorporation into yarn, fabric or another product is represented with dpp:isComponentOf."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed page 14, lines 154-160."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txt:ToyTextileApparel a owl:Class ;
    rdfs:label "Toy textile apparel"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile apparel identified as a toy in accordance with Directive 2009/48/EC."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileApparel ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-482."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txt:defaultStudyScopeStatus txtcs:excludedFromJRCPreparatoryStudyScope ;
    txt:jrcExclusionReason "Excluded because textile apparel identified as a toy is outside the selected scope."@en .

txt:Yarn a owl:Class ;
    rdfs:label "Yarn"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile product consisting of fibres assembled into a continuous strand and intended to be incorporated into fabric or another textile product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:subClassOf txt:TextileProduct ;
    txtcon:modellingNote "Yarn is modelled as a textile product. Its role as an input or component of a fabric or another product is represented with dpp:isComponentOf."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 486-492; JRC Preparatory Study, Section 3.3.1, printed page 27, lines 536-546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:defaultStudyScopeStatus a owl:AnnotationProperty ;
    rdfs:label "default study scope status"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Annotation property used on product-type classes to document their default status with respect to a study or regulatory modelling scope."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    txtcon:modellingNote "This is an annotation-level modelling aid for product types. Instance-level scope status, if needed, should be represented with a data validation pattern or a dedicated object property in a context module."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:hasFibreComponent a owl:ObjectProperty ;
    rdfs:label "has fibre component"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile product to a textile fibre type concept that is part of its composition."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:range txt:FibreTypeConcept ;
    txtcon:modellingNote "Non-quantitative relation indicating that a textile product contains a given textile fibre type. This property is useful when the presence of a fibre type is known but its quantitative share is not represented."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:hasFibreCompositionComponent a owl:ObjectProperty ;
    rdfs:label "has fibre composition component"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile product to a structured fibre composition component."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:range txt:FibreCompositionComponent ;
    txtcon:modellingNote "No subproperty alignment with dpp:hasMaterialType is asserted because hasFibreCompositionComponent links a textile product to a structured composition entry, whereas dpp:hasMaterialType links a material-of-composition entry to a classification value. Their subject and object roles differ."@en,
        "Preferred relation for representing the declared fibre composition of a textile product, including the fibre type and its quantitative share."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:hasNonTextileMaterialMassFraction a owl:ObjectProperty ;
    rdfs:label "has non-textile material mass fraction"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile product to the mass fraction represented by non-textile materials."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:modellingNote "Values use a 0-1 mass-fraction scale and the dimensionless SI unit units:one. Cardinality, range and sum rules will be defined in SHACL."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:hasStudyScopeStatus a owl:ObjectProperty ;
    rdfs:label "has study scope status"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile product instance to a controlled study scope status concept."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:range txt:StudyScopeStatusConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:hasTextileApparelProductType a owl:ObjectProperty ;
    rdfs:label "has textile apparel product type"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile apparel product to a controlled textile apparel product type concept."@en ;
    rdfs:domain txt:TextileApparel ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:range txt:TextileApparelProductTypeConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:hasTextileFibreMassFraction a owl:ObjectProperty ;
    rdfs:label "has textile fibre mass fraction"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a product to the total mass fraction represented by textile fibres."@en ;
    rdfs:domain dpp:Product ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:range txtcon:QuantitativeValue ;
    txtcon:modellingNote "Values use a 0-1 mass-fraction scale and the dimensionless SI unit units:one. Cardinality, range and sum rules will be defined in SHACL."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:jrcExclusionReason a owl:AnnotationProperty ;
    rdfs:label "JRC exclusion reason"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Annotation specifying the reason why a textile product class or category is excluded from the JRC preparatory study scope."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:range xsd:string ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txt:jrcScopeCondition a owl:AnnotationProperty ;
    rdfs:label "JRC scope condition"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Annotation specifying a textual condition governing inclusion of a textile product class or category in the JRC preparatory study scope."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
    rdfs:range xsd:string ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

