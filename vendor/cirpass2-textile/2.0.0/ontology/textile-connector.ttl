<https://w3id.org/eudpp/textile-connector> a owl:Ontology ;
    rdfs:label "EU DPP Textile Connector Ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Connector Ontology. Version 2.0.0 candidate."@en ;
    dcterms:created "2026-03-06"^^xsd:date ;
    dcterms:creator "Elio Hbeich"@en,
        "BOUGACHA Racem"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Shared foundation and connector module for the EU DPP textile ontology network. It defines the common quantitative-value and reference-period patterns, the shared product-technology-level vocabulary, controlled provenance vocabularies, editorial annotations and weak cross-module annotation relations. Domain-specific operational relations remain in their domain modules."@en ;
    dcterms:issued "2026-03-06"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-02"^^xsd:date ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    dcterms:title "EU DPP Textile Connector Ontology"@en ;
    vann:preferredNamespacePrefix "txtcon" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-connector#" ;
    rdfs:comment "Operational instance-level relations belong in the relevant domain module and are validated through SHACL."@en,
        "Relation polarity is not represented as a direct annotation on a source class because one class may have several outgoing weak relations with different directions. Edge-level polarity and evidence remain in the canonical relation register until a statement-level representation is adopted."@en,
        "The BC/BAT/BNAT product-technology axis is shared here because it is used by more than one textile aspect module. Aspect-specific configurations remain in their own module and map to the shared level rather than duplicating it."@en,
        "The common ReferencePeriod pattern is infrastructure only; domain modules retain their own hasReferencePeriod relations."@en,
        "The connector is intentionally dependency-light: it imports the BIPM SI Reference Point but no textile domain module. SKOS terms are referenced directly through their standard W3C IRIs."@en,
        "The quantitative-value pattern links numerical values to BIPM SI measurement-unit and quantity-kind resources without recreating SI terms."@en,
        "The typical relation properties are annotation properties for contextual class-level or concept-level statements. They do not assert deterministic causal axioms."@en,
        "Working extraction identifiers are maintained in the crosswalk documentation rather than stabilised as ontology annotations."@en ;
    owl:imports <https://w3id.org/eudpp/textile-si-mireot> ;
    owl:priorVersion <https://w3id.org/eudpp/textile-connector/1.1.2> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-connector/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:ontologyModule .

