@prefix ex: <https://example.org/textile-repair/> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix txtrep: <https://w3id.org/eudpp/textile-repairability#> .
@prefix units: <https://si-digital-framework.org/SI/units/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:repairCostCondition txtrep:hasRepairCostToNewProductPriceRatio ex:repairCostRatio .
ex:repairCostRatio a txtcon:QuantitativeValue ; txtcon:numericValue '-0.1'^^xsd:decimal ; txtcon:hasMeasurementUnit units:one .
