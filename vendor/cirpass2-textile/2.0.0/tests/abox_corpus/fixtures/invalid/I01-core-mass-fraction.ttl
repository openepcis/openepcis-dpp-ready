@prefix ex: <https://example.org/eu-dpp-textile/> .
@prefix txt: <https://w3id.org/eudpp/textile-core#> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix units: <https://si-digital-framework.org/SI/units/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:composition-cotton a txt:FibreCompositionComponent ; txt:hasFibreMassFraction ex:value-cotton-fraction .
ex:value-cotton-fraction a txtcon:QuantitativeValue ; txtcon:numericValue '1.20'^^xsd:decimal ; txtcon:hasMeasurementUnit units:one .
