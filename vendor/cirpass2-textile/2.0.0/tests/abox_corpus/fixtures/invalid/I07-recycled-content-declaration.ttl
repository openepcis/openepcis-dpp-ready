@prefix ex: <https://example.org/textile-recyclability/> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix txtrec: <https://w3id.org/eudpp/textile-recyclability#> .
@prefix units: <https://si-digital-framework.org/SI/units/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:recycledContentDeclaration a txtrec:RecycledContentDeclaration ; txtrec:hasRecycledContentSource txtrec:postConsumerRecycledContent ; txtrec:hasRecycledContentMassFractionValue ex:recycledContentValue ; txtrec:hasRecycledMaterialMassValue ex:recycledMaterialMass .
ex:recycledContentValue a txtcon:QuantitativeValue ; txtcon:numericValue '0.30'^^xsd:decimal ; txtcon:hasMeasurementUnit units:one .
ex:recycledMaterialMass a txtcon:QuantitativeValue ; txtcon:numericValue '0.075'^^xsd:decimal ; txtcon:hasMeasurementUnit units:kilogram .
