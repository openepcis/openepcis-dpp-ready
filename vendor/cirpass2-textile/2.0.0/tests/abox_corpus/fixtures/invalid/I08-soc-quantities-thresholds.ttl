@prefix si: <https://si-digital-framework.org/SI#> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix txtsoc: <https://w3id.org/eudpp/textile-soc#> .
@prefix units: <https://si-digital-framework.org/SI/units/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/textile-soc/trackingThreshold> a txtsoc:TextileTrackingThreshold ;
    txtsoc:hasThresholdQuantitativeValue <https://example.org/textile-soc/reportedRange> .

<https://example.org/textile-soc/reportedRange> a txtsoc:RangeThresholdValue ;
    txtcon:hasMeasurementUnit units:one ;
    txtsoc:lowerBound 0.9 ;
    txtsoc:upperBound 0.1 .

units:one a si:MeasurementUnit .
