@prefix ex: <https://example.org/textile-repair/> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix txtrep: <https://w3id.org/eudpp/textile-repairability#> .
@prefix units: <https://si-digital-framework.org/SI/units/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:repairService txtrep:hasRepairResponseTimeValue ex:repairResponseTime .
ex:repairResponseTime a txtcon:QuantitativeValue ; txtcon:numericValue '7'^^xsd:decimal ; txtcon:hasMeasurementUnit units:day .
ex:repairCostCondition txtrep:hasRepairCostToNewProductPriceRatio ex:repairCostRatio .
ex:repairCostRatio a txtcon:QuantitativeValue ; txtcon:numericValue '0.22'^^xsd:decimal ; txtcon:hasMeasurementUnit units:one .
