@prefix batmet: <https://w3id.org/eudpp/battery-metals#> .
@prefix batchem: <https://w3id.org/eudpp/battery-chemistries#> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################
# Ontology
#################################################
# Controlled vocabulary of the four metals whose recycled content
# Regulation (EU) 2023/1542, Art. 8(1) requires a battery to declare:
# cobalt, lead, lithium and nickel.
#
# Deliberately limited to the four metals Art. 8(1) names. Other elements
# present in a battery are not added: no source requires their recycled
# content today.

<https://w3id.org/eudpp/battery-metals>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/eudpp/battery-metals/0.1.0> ;
    rdfs:seeAlso <https://w3id.org/eudpp/battery-materials> ,
                 <https://w3id.org/eudpp/battery-chemistries> ;
    rdfs:label "EU DPP Battery Metals Vocabulary"@en ;
    dcterms:title "EU DPP Battery Metals Vocabulary"@en ;
    dcterms:description "The four metals whose recycled content Regulation (EU) 2023/1542, Art. 8(1) requires a battery to declare: cobalt, lead, lithium and nickel. Declared as individuals of the cross-sectoral class dpp:MaterialType and used as the value set of eudpp:hasMaterialType on a eudpp:MaterialOfComposition, so that a recycled-content figure can be attributed to a named metal. Corresponds to BatteryPass-Ready Data Attribute Long List v1.3, attributes 48 to 54."@en ;
    rdfs:comment "Developed against the CIRPASS-2 CORE ontology of October 2026 (P_DPP v2.1.0, MAT v1.1.0). The four concepts carry eudpp:materialTypeScheme, added to MAT by ontologies-core#25. MAT v1.1.0 also adds eudpp:materialRecycledContentType (pre-consumer, post-consumer, unknown); the battery profile keeps one total share per metal, as BatteryPass-Ready long list v2.0 and the Commission guidance of 15 August 2026 ask."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:license "This ontology is licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0). In case of dispute over CC BY 4.0 applicability, or in case considering the ontology as a software or part of it, this ontology is to be considered licensed under the Apache License, Version 2.0."@en ;
    dcterms:bibliographicCitation "EU DPP Battery Metals Vocabulary. Draft version 0.1.0."@en ;
    dcterms:creator "Nader Jelassi"@en , "Marc-Andree Wolf"@en ;
    dcterms:contributor "Arnab Sinha"@en ;
    dcterms:created "2026-09-03"^^xsd:date ;
    dcterms:issued "2026-09-03"^^xsd:date ;
    dcterms:modified "2026-11-03"^^xsd:date ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1) and Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attributes 48 to 54"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    owl:versionInfo "Version 0.1.0 DRAFT"@en ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/battery-metals#" ;
    vann:preferredNamespacePrefix "batmet" .

#################################################
# Concept Scheme
#################################################

batmet:BatteryMetalScheme
    a skos:ConceptScheme ;
    rdfs:label "Battery metals subject to recycled content declaration, Art. 8(1)"@en ;
    skos:prefLabel "Battery metals subject to recycled content declaration, Art. 8(1)"@en ;
    skos:scopeNote "Art. 8(1) does not treat the four metals alike. For cobalt, lithium and nickel it asks for the share present in ACTIVE MATERIALS and recovered from battery manufacturing waste or post-consumer waste; for lead it asks for the share present in THE BATTERY and recovered from waste. The distinction is recorded on each concept and is not expressible in the CORE today."@en ;
    skos:hasTopConcept batmet:Cobalt ,
                       batmet:Lead ,
                       batmet:Lithium ,
                       batmet:Nickel ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1)"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals> .

#################################################
# Metals - individuals of dpp:MaterialType
#################################################

batmet:Cobalt
    a dpp:MaterialType , skos:Concept ;
    skos:inScheme batmet:BatteryMetalScheme ;
    skos:topConceptOf batmet:BatteryMetalScheme ;
    skos:notation "Co" ;
    dpp:materialTypeScheme "https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"^^xsd:anyURI ;
    rdfs:label "Cobalt"@en ;
    skos:prefLabel "Cobalt"@en ;
    skos:altLabel "Co"@en ;
    skos:scopeNote "Recycled share is measured on the cobalt present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 49 and 52."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 49 and 52"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals> .

batmet:Lead
    a dpp:MaterialType , skos:Concept ;
    skos:inScheme batmet:BatteryMetalScheme ;
    skos:topConceptOf batmet:BatteryMetalScheme ;
    skos:notation "Pb" ;
    dpp:materialTypeScheme "https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"^^xsd:anyURI ;
    rdfs:label "Lead"@en ;
    skos:prefLabel "Lead"@en ;
    skos:altLabel "Pb"@en ;
    skos:scopeNote "Lead is the exception in Art. 8(1): the recycled share is measured on the lead present in THE BATTERY, not in active materials, and recovered from waste without the manufacturing / post-consumer split. Long list attribute 54, which has no pre- and post-consumer counterpart."@en ;
    skos:editorialNote "Not to be confused with batchem:Pb, the lead-acid CELL CHEMISTRY of battery-chemistries. This concept is the METAL whose recycled content is declared. Different namespaces, different meanings."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attribute 54"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals> .

batmet:Lithium
    a dpp:MaterialType , skos:Concept ;
    skos:inScheme batmet:BatteryMetalScheme ;
    skos:topConceptOf batmet:BatteryMetalScheme ;
    skos:notation "Li" ;
    dpp:materialTypeScheme "https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"^^xsd:anyURI ;
    rdfs:label "Lithium"@en ;
    skos:prefLabel "Lithium"@en ;
    skos:altLabel "Li"@en ;
    skos:scopeNote "Recycled share is measured on the lithium present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 50 and 53."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 50 and 53"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals> .

batmet:Nickel
    a dpp:MaterialType , skos:Concept ;
    skos:inScheme batmet:BatteryMetalScheme ;
    skos:topConceptOf batmet:BatteryMetalScheme ;
    skos:notation "Ni" ;
    dpp:materialTypeScheme "https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"^^xsd:anyURI ;
    rdfs:label "Nickel"@en ;
    skos:prefLabel "Nickel"@en ;
    skos:altLabel "Ni"@en ;
    skos:scopeNote "Recycled share is measured on the nickel present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 48 and 51."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 48 and 51"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals> .
