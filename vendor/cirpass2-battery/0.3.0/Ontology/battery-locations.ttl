@prefix batloc: <https://w3id.org/eudpp/battery-locations#> .
@prefix batmat: <https://w3id.org/eudpp/battery-materials#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################
# Ontology
#################################################
# Controlled vocabulary of the internal battery locations named by
# Regulation (EU) 2023/1542, Annex XIII 2(a): cathode, anode and
# electrolyte. Value set of batmat:hasBatteryLocation, which had none
# until now: batmat:BatteryLocation was declared but empty.
#
# No term is declared in this namespace beyond the individuals
# themselves: the locations are individuals of batmat:BatteryLocation.
#
# Deliberately limited to the three locations the Regulation names.
# Other physical parts of a battery - separator, casing, current
# collectors - are not named in Annex XIII 2(a) and are not added here;
# they can be, when a source requires them.

<https://w3id.org/eudpp/battery-locations>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/eudpp/battery-locations/0.1.0> ;
    rdfs:seeAlso <https://w3id.org/eudpp/battery-materials> ;
    rdfs:label "EU DPP Battery Locations Vocabulary"@en ;
    dcterms:title "EU DPP Battery Locations Vocabulary"@en ;
    dcterms:description "The three internal battery locations named by Regulation (EU) 2023/1542, Annex XIII 2(a) for the detailed composition of a battery: cathode, anode and electrolyte. Declared as individuals of batmat:BatteryLocation and used as the value set of batmat:hasBatteryLocation. Corresponds to BatteryPass-Ready Data Attribute Long List v1.3, attribute 41, and to the Spherity Battery Pass class BatteryLocationEntity, which declares no values."@en ;
    rdfs:comment "Developed against the CIRPASS-2 CORE ontology of October 2026 (P_DPP v2.1.0, MAT v1.1.0). MAT keeps a flat model with no part level (ontologies-core#24, closed), so these locations stay in this vocabulary."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:license "This ontology is licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0). In case of dispute over CC BY 4.0 applicability, or in case considering the ontology as a software or part of it, this ontology is to be considered licensed under the Apache License, Version 2.0."@en ;
    dcterms:bibliographicCitation "EU DPP Battery Locations Vocabulary. Draft version 0.1.0."@en ;
    dcterms:creator "Nader Jelassi"@en , "Marc-Andree Wolf"@en ;
    dcterms:contributor "Arnab Sinha"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:issued "2026-08-25"^^xsd:date ;
    dcterms:modified "2026-11-03"^^xsd:date ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41; Spherity Battery Pass ontology v0.1, BatteryLocationEntity"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    owl:versionInfo "Version 0.1.0 DRAFT"@en ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/battery-locations#" ;
    vann:preferredNamespacePrefix "batloc" .

#################################################
# Concept Scheme
#################################################

batloc:BatteryLocationScheme
    a skos:ConceptScheme ;
    rdfs:label "Battery locations per Annex XIII 2(a)"@en ;
    skos:prefLabel "Battery locations per Annex XIII 2(a)"@en ;
    skos:scopeNote "The three locations named by Regulation (EU) 2023/1542, Annex XIII 2(a). The Regulation names them without defining them, so no definition is asserted here. Access to the detailed composition is restricted to notified bodies, market surveillance authorities and the Commission; per the tier-free convention of this ontology, that restriction is expressed in the SHACL layer, not here."@en ;
    skos:hasTopConcept batloc:Cathode ,
                       batloc:Anode ,
                       batloc:Electrolyte ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-locations> .

#################################################
# Locations - individuals of batmat:BatteryLocation
#################################################
# skos:notation carries the term as written in Annex XIII 2(a).
#
#     :chem-1  a batmat:BatteryChemistry ;
#              batmat:hasBatteryLocation batloc:Cathode .

batloc:Cathode
    a batmat:BatteryLocation , skos:Concept ;
    skos:inScheme batloc:BatteryLocationScheme ;
    skos:topConceptOf batloc:BatteryLocationScheme ;
    skos:notation "cathode" ;
    rdfs:label "Cathode"@en ;
    skos:prefLabel "Cathode"@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-locations> .

batloc:Anode
    a batmat:BatteryLocation , skos:Concept ;
    skos:inScheme batloc:BatteryLocationScheme ;
    skos:topConceptOf batloc:BatteryLocationScheme ;
    skos:notation "anode" ;
    rdfs:label "Anode"@en ;
    skos:prefLabel "Anode"@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-locations> .

batloc:Electrolyte
    a batmat:BatteryLocation , skos:Concept ;
    skos:inScheme batloc:BatteryLocationScheme ;
    skos:topConceptOf batloc:BatteryLocationScheme ;
    skos:notation "electrolyte" ;
    rdfs:label "Electrolyte"@en ;
    skos:prefLabel "Electrolyte"@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-locations> .
