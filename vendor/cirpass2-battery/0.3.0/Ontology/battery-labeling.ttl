@prefix batlab: <https://w3id.org/eudpp/battery-labeling#> .
@prefix batext: <https://w3id.org/eudpp/battery-extinguisher-classes#> .
@prefix bat: <https://w3id.org/eudpp/battery#> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################
# Ontology
#################################################
# 1 class, 2 object properties, 4 datatype properties.
#
# v0.2.0 (issue #8): cadmiumLeadSymbol split into cadmiumSymbol and
# leadSymbol, which carry distinct legal triggers; extinguishingAgent
# retyped as an object property onto the battery-extinguisher-classes
# vocabulary; labelingSubject removed as a duplicate of the typed
# properties.
#
# NOTE: a cross-sectoral Labelling class is under discussion at CORE
# level (ontologies-core#55); if adopted, BatteryLabel will be
# re-attached as a specialisation of it.

<https://w3id.org/eudpp/battery-labeling>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/eudpp/battery-labeling/0.2.1> ;
    rdfs:seeAlso <https://w3id.org/eudpp/battery-extinguisher-classes> ;
    rdfs:label "EU DPP Battery Labeling Ontology"@en ;
    dcterms:title "EU DPP Battery Labeling Ontology"@en ;
    dcterms:description "Module for the labels and symbols required on batteries in EU Digital Product Passports: separate collection symbol, the cadmium symbol and the lead symbol, extinguishing agent information and label symbol. Covers the battery-specific fields of the 'Symbols, labels and documentation of conformity' category of the BatteryPass-Ready Data Attribute Long List required by Regulation (EU) 2023/1542, and the Spherity Battery Pass Labeling entities."@en ;
    rdfs:comment "Developed against the CIRPASS-2 CORE ontology of October 2026 (P_DPP v2.1.0, MAT v1.1.0). External references are pinned to these versions."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:license "This ontology is licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0). In case of dispute over CC BY 4.0 applicability, or in case considering the ontology as a software or part of it, this ontology is to be considered licensed under the Apache License, Version 2.0."@en ;
    dcterms:bibliographicCitation "EU DPP Battery Labeling Ontology. Draft version 0.2.1."@en ;
    dcterms:creator "Nader Jelassi"@en , "Marc-Andree Wolf"@en ;
    dcterms:contributor "Arnab Sinha"@en ;
    dcterms:created "2026-07-07"^^xsd:date ;
    dcterms:issued "2026-07-07"^^xsd:date ;
    dcterms:modified "2026-11-03"^^xsd:date ;
    dcterms:references "Regulation (EU) 2023/1542; BatteryPass-Ready Data Attribute Long List v1.3, attributes 21, 22, 24; Spherity Battery Pass ontology v0.1 (Labeling)"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    owl:versionInfo "Version 0.2.1 DRAFT"@en ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/battery-labeling#" ;
    vann:preferredNamespacePrefix "batlab" .

#################################################
# Classes
#################################################

batlab:BatteryLabel
    a owl:Class ;
    rdfs:label "Battery Label"@en ;
    rdfs:comment "A label or symbol required on the battery or in its passport under Regulation (EU) 2023/1542 (e.g. separate collection symbol, cadmium symbol, lead symbol, carbon footprint label). Provisional battery-specific class: it is declared here only because the CORE has no cross-sectoral Labelling class yet. When that class lands (CIRPASS-2/ontologies-core#55), BatteryLabel is to be re-anchored as a specialisation of it rather than kept as a root class."@en ;
    rdfs:seeAlso <https://github.com/CIRPASS-2/ontologies-core/issues/55> ;
    dcterms:references "Regulation (EU) 2023/1542"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

#################################################
# Object Properties
#################################################

batlab:hasBatteryLabel
    a owl:ObjectProperty ;
    rdfs:domain bat:Battery ;
    rdfs:range batlab:BatteryLabel ;
    rdfs:label "has battery label"@en ;
    rdfs:comment "Links a battery to a label or symbol required by the Batteries Regulation."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, labels"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

batlab:extinguishingAgent
    a owl:ObjectProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range skos:Concept ;
    rdfs:label "extinguishing agent"@en ;
    rdfs:comment "Specification of the usable extinguishing agent, as one of the extinguisher classes of the battery-extinguisher-classes vocabulary. Retyped from a free-text datatype property in v0.2.0: the value set is now controlled."@en ;
    rdfs:seeAlso batext:ExtinguisherClassScheme ;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 24 (Regulation (EU) 2023/1542, Annex VI Part A (9)); Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

#################################################
# Datatype Properties
#################################################

batlab:separateCollectionSymbol
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:anyURI ;
    rdfs:label "separate collection symbol"@en ;
    rdfs:comment "Symbol indicating the necessity of separate collection of the battery (crossed-out wheeled bin), as a link to the symbol resource. Required on all batteries; the symbol itself is set out in Annex VI Part B."@en ;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 21 (Regulation (EU) 2023/1542, Annex XIII (1s), Art. 13(4), Annex VI Part B)"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

batlab:cadmiumSymbol
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:anyURI ;
    rdfs:label "symbol for cadmium"@en ;
    rdfs:comment "Representation of the chemical symbol 'Cd' for cadmium, as a link to the symbol resource. Its legal trigger is its own: the symbol is required for batteries containing more than 0,002 % cadmium by weight, independently of the lead symbol."@en ;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 22 (Regulation (EU) 2023/1542, Annex XIII (1s), Art. 13(5))"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

batlab:leadSymbol
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:anyURI ;
    rdfs:label "symbol for lead"@en ;
    rdfs:comment "Representation of the chemical symbol 'Pb' for lead, as a link to the symbol resource. Its legal trigger is its own: the symbol is required for batteries containing more than 0,004 % lead by weight, independently of the cadmium symbol."@en ;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 22 (Regulation (EU) 2023/1542, Annex XIII (1s), Art. 13(5))"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

batlab:labelingSymbol
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:anyURI ;
    rdfs:label "labeling symbol"@en ;
    rdfs:comment "Link to the image of the label symbol displayed on the battery."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, labelingSymbol"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .
