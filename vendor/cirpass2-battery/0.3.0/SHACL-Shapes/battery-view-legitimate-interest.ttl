        [ sh:property [ sh:path ( batperf:hasBatteryStateRecord batperf:energyThroughput ) ; sh:minCount 1 ] ]
    ) .

# 89. Capacity throughput
batv:LegitimateInterest89Shape
    a sh:NodeShape ;
    sh:targetClass bat:Battery ;
    batacc:accessTier batacc:LegitimateInterest ;
    sh:message "Capacity throughput — long list v1.3 attribute 89, required for LMT batteries." ;
    sh:or (
        [ sh:not [ sh:property [ sh:path dpp:hasProductGroup ;
