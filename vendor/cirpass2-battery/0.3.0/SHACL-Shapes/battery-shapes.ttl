#################################################
# 4. Declared, never required
#################################################
# The 7 attributes v1.3 marks voluntary or not applicable in all
# four columns: typed here, never required.
#
# Two attributes v1.3 marks mandatory join them (ontologies-battery#14):
#   22. the cadmium and lead symbols are due only above 0.002 % cadmium
#       and 0.004 % lead by weight (Art. 13(5)), which the passport
#       does not state;
#   36. the due diligence report is due only from 18 August 2027
#       (Regulation (EU) 2025/1561), and only from economic operators
#       above the net turnover threshold set for due diligence.
#
# The discharge C-rate, data point 40 of the Commission guidance v3.2 and
# optional there, is typed here too: v1.3 has no attribute for it.

batsh:BatteryVoluntaryShape
    a sh:NodeShape ;
    sh:targetClass bat:Battery ;
    rdfs:label "Voluntary attributes"@en ;
    rdfs:comment "Typed but never required: voluntary in long list v1.3, due under conditions a validator cannot check (22, 36), or optional in the Commission guidance v3.2 (discharge C-rate)."@en ;

    # 22. Symbols for cadmium and lead
    #     due only above 0.002 % cadmium or 0.004 % lead by weight: declared, not required
    sh:property [
        sh:path ( batlab:hasBatteryLabel batlab:cadmiumSymbol ) ;
        sh:datatype xsd:anyURI ;
        sh:message "Symbols for cadmium and lead — long list v1.3 attribute 22, Battery Regulation." ;
    ] ;

    sh:property [
        sh:path ( batlab:hasBatteryLabel batlab:leadSymbol ) ;
        sh:datatype xsd:anyURI ;
        sh:message "Symbols for cadmium and lead — long list v1.3 attribute 22, Battery Regulation." ;
    ] ;

    # 36. Information of due diligence report
    #     due from 18 August 2027 (Regulation (EU) 2025/1561): declared, not required
    sh:property [
        sh:path bat:dueDiligenceReport ;
        sh:datatype xsd:anyURI ;
        sh:message "Information of due diligence report — long list v1.3 attribute 36, Battery Regulation." ;
    ] ;

    # 37. Third party assurances of recognised schemes
    sh:property [
        sh:path bat:dueDiligenceAudit ;
        sh:datatype xsd:anyURI ;
        sh:message "Third party assurances of recognised schemes — long list v1.3 attribute 37, Battery Regulation." ;
    ] ;

    # 62. Certified usable battery energy
    sh:property [
        sh:path ( batperf:hasBatteryPerformance batperf:certifiedUsableBatteryEnergy ) ;
        sh:datatype xsd:decimal ;
        sh:message "Certified usable battery energy — long list v1.3 attribute 62, Battery Regulation." ;
    ] ;

    # 63. Remaining usable battery energy
    sh:property [
        sh:path ( batperf:hasBatteryStateRecord batperf:remainingUsableBatteryEnergy ) ;
        sh:datatype xsd:decimal ;
        sh:message "Remaining usable battery energy — long list v1.3 attribute 63, Battery Regulation." ;
    ] ;

    # 73. Ratio between nominal battery power and battery energy
    sh:property [
        sh:path ( batperf:hasBatteryPerformance batperf:powerToEnergyRatio ) ;
        sh:datatype xsd:decimal ;
        sh:message "Ratio between nominal battery power and battery energy — long list v1.3 attribute 73, Battery Regulation." ;
    ] ;

    # 78. Initial self-discharge rate
    sh:property [
        sh:path ( batperf:hasBatteryPerformance batperf:initialSelfDischargeRate ) ;
        sh:datatype xsd:decimal ;
        sh:message "Initial self-discharge rate — long list v1.3 attribute 78, Battery Regulation." ;
    ] ;

    # 79. Current self-discharge rate
    sh:property [
        sh:path ( batperf:hasBatteryStateRecord batperf:currentSelfDischargeRate ) ;
        sh:datatype xsd:decimal ;
        sh:message "Current self-discharge rate — long list v1.3 attribute 79, Battery Regulation." ;
    ] ;

    # 99. Number of overcharge events
    sh:property [
        sh:path ( batperf:hasBatteryStateRecord batperf:numberOfOverchargeEvents ) ;
        sh:datatype xsd:integer ;
        sh:message "Number of overcharge events — long list v1.3 attribute 99, Battery Regulation." ;
    ] ;

    # Discharge C-rate of relevant cycle-life test — Commission guidance v3.2, data point 40
    sh:property [
        sh:path ( batperf:hasBatteryPerformance batperf:dischargeCRateOfCycleLifeTest ) ;
        sh:datatype xsd:decimal ;
        sh:message "Discharge C-rate of relevant cycle-life test — Commission guidance v3.2, data point 40." ;
    ]  .

#################################################
# 5. Deliberately not constrained
#################################################
# 14 of the 100 v1.3 attributes have no path here. Each line says why.
#
#    16. Date of putting the battery into service
#        no CORE date property; event vs property still open (battery#26 line of the Broader table)
#    23. Carbon footprint label
#        carbon footprint label; core#36 closed without a term, the URL goes through hasExternalDocumentation -> Source (LCA)
#    25. Meaning of labels and symbols
#        meaning of labels and symbols; long list v2.0 subsumes it in data point 43 of the Commission guidance (Art. 74(1)), not a separate data point (ontologies-core#37)
#    28. Battery carbon footprint per Functional Unit
#        carbon footprint: battery-cf-shapes.ttl, deferred to the LCA module (core#41)
#    29. Contribution of raw material acquisition and pre-processing 
#        carbon footprint: battery-cf-shapes.ttl
#    30. Contribution of main product production lifecycle stage
#        carbon footprint: battery-cf-shapes.ttl
#    31. Contribution of distribution lifecycle stage
#        carbon footprint: battery-cf-shapes.ttl
#    32. Contribution of end of life and recycling lifecycle stage
#        carbon footprint: battery-cf-shapes.ttl
#    33. Carbon footprint performance class
#        performance class: core#41 makes it an LCA concept, not yet implemented
#    34. Web link to public carbon footprint study
#        public study link: hasExternalDocumentation -> Source (LCA), core#36
#    35. Absolute battery carbon footprint
#        absolute carbon footprint: battery-cf-shapes.ttl
#    38. Supply chain indices
#        supply chain indices: no term, in the CORE or in the battery modules
#    46. Information on sources of spare parts
#        spare-part sources are actor data in ACTOR, not a battery term
#   100. Information on accidents
#        no object property links bat:Battery to batperf:AccidentEvent; same gap as the putting-into-service event
