    eudpp:actorName "Example Light Mobility Cells GmbH" ;
    eudpp:hasUniqueOperatorIdentifier ex:economic-operator-id-1 .

ex:economic-operator-id-1 a eudpp:ActorIdentifier ;
    eudpp:identifierValue "LEI:969500EXAMPLE0000002" .

