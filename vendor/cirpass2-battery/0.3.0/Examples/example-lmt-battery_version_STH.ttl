<https://example.org/doc/lmt/carbon-footprint-study.pdf> a eudpp:Source .

<https://example.org/doc/lmt/carbon-footprint-verification.pdf> a eudpp:ReviewReport .

ex:background-database-1 a eudpp:BackgroundDatabase ;
    rdfs:label "Example EF-compliant background database" .

ex:battery-1 a bat:Battery ;
    eudpp:containsSubstanceOfConcern ex:soc-1 ;
    eudpp:description "Removable lithium-ion LFP down-tube battery for a pedal-assist bicycle." ;
    eudpp:hasDPP ex:dpp-1 ;
    eudpp:hasEUDeclarationOfConformity ex:eu-doc-1 ;
    eudpp:hasEconomicOperator ex:economic-operator-1 ;
    eudpp:hasLCAStudy ex:lca-study-1 ;
    eudpp:hasManufacturer ex:manufacturer ;
    eudpp:hasMaterial ex:chemistry-1,
        ex:material-cobalt,
        ex:material-lead,
        ex:material-lithium,
        ex:material-nickel ;
    eudpp:hasProductGroup batcat:LMTBattery ;
    eudpp:hasProperty ex:mass-1,
        ex:safety-instruction-1 ;
    eudpp:hasUniqueProductIdentifier ex:pid-1 ;
    eudpp:isEnergyRelated true ;
    eudpp:manufacturingDate "2027-05"^^xsd:gYearMonth ;
    eudpp:productName "Example e-bike battery 0.63 kWh" ;
    eudpp:usesFacility ex:plant-1 ;
    bat:dismantlingInformation "https://example.org/doc/lmt/dismantling.pdf"^^xsd:anyURI ;
    bat:dueDiligenceAudit "https://example.org/doc/lmt/due-diligence-audit-2026.pdf"^^xsd:anyURI ;
    bat:dueDiligenceReport "https://example.org/doc/lmt/due-diligence-2026.pdf"^^xsd:anyURI ;
    bat:hasBatteryStatus batstat:Original ;
