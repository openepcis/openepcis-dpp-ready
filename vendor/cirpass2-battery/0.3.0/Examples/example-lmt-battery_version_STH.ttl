    bat:warrantyPeriod "P2Y"^^xsd:duration ;
    batlab:hasBatteryLabel ex:label-1 ;
    batmat:hasBatteryChemistry ex:chemistry-1 ;
    batperf:hasBatteryDurability ex:design-life-1 ;
    batperf:hasBatteryPerformance ex:nameplate-1 ;
    batperf:hasBatteryStateRecord ex:state-2028-04-15,
        ex:state-2029-04-10 ;
    batperf:hasTemperatureExposure ex:idle-temperature-range-1 .

ex:carbon-footprint-1 a eudpp:CarbonFootprint ;
    eudpp:hasMeasurementUnit siunit:kilogram ;
    eudpp:numericalValue 41.8 ;
    eudpp:quantifiesIndicator eudpp:ind_EF_climateChange .

ex:cf-review-1 a eudpp:Review ;
    eudpp:hasLCAVerifier ex:notified-body-1 ;
    eudpp:hasTypeOfReview eudpp:accreditedThirdPartyReview ;
    eudpp:referenceToCompleteReviewReport <https://example.org/doc/lmt/carbon-footprint-verification.pdf> ;
    eudpp:reviewDate "2026-11-30"^^xsd:date .

ex:design-life-1 a batperf:BatteryDurability ;
    batperf:capacityThresholdForExhaustion 70.0 ;
    batperf:expectedLifetimeCalendarYears 5.0 ;
    batperf:expectedLifetimeCycles 800 .

ex:dpp-1 a eudpp:DPP ;
    eudpp:appliesToProduct ex:battery-1 ;
    eudpp:dppSchemaVersion "prEN18223:v1.0" ;
    eudpp:dppStatus "Active" ;
    eudpp:granularity "item" ;
    eudpp:hasDigitalProductPassportId ex:dppid-1 ;
    eudpp:hasIssuer ex:manufacturer ;
    eudpp:lastUpdate "2029-04-12T10:05:00Z"^^xsd:dateTimeStamp ;
    eudpp:validFrom "2027-02-18T00:00:00Z"^^xsd:dateTimeStamp .

ex:dppid-1 a eudpp:DPPIdentifier ;
    eudpp:identifierValue "urn:uuid:0b2b1f28-3c71-4a1e-9a2b-7c5d1e4f80aa" .

ex:economic-operator-1 a eudpp:Actor ;
