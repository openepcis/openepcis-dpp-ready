{
  "@context": {
    "sh": "http://www.w3.org/ns/shacl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dppk": "https://dpp-keystone.org/spec/v3/terms#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "@vocab": "http://www.w3.org/ns/shacl#",
    "node": {
      "@type": "@id"
    },
    "path": {
      "@type": "@id"
    },
    "targetClass": {
      "@type": "@id"
    },
    "class": {
      "@type": "@id"
    },
    "datatype": {
      "@type": "@id"
    }
  },
  "@id": "https://dpp-keystone.org/spec/validation/v3/shacl/core/EPDMetadata",
  "@type": "ShapesGraph",
  "@graph": [
    {
      "@id": "https://dpp-keystone.org/spec/validation/v3/shacl/shapes#dppk_ProductShape",
      "@type": "NodeShape",
      "targetClass": "https://dpp-keystone.org/spec/v3/terms#Product",
      "property": [
        {
          "path": "https://dpp-keystone.org/spec/v3/terms#epd",
          "message": "Auto-generated rule for dppk:epd",
          "or": {
            "@list": [
              {
                "node": {
                  "@id": "https://dpp-keystone.org/spec/validation/v3/shacl/shapes#dppk_EPDBlockShape"
                },
                "nodeKind": {
                  "@id": "sh:BlankNodeOrIRI"
                }
              },
              {
                "datatype": "dppk:EPDBlock"
              }
            ]
          }
        }
      ]
    }
  ]
}