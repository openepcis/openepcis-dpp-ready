      "message": {
        "type": "SEM-BAT-MSG-068"
      }
    },
    "internalResistanceIncrease": {
      "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/unitValue",
      "message": {
        "type": "SEM-BAT-MSG-069"
      }
    },
    "expectedLifetimeCyclesRest": {
      "type": "integer",
      "minimum": 1,
      "message": {
        "type": "SEM-BAT-MSG-072"
