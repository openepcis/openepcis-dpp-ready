      "message": {
        "type": "SEM-BAT-MSG-064"
      }
    },
    "capacityFade": {
      "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/unitValue",
      "message": {
        "type": "SEM-BAT-MSG-065"
      }
    },
    "powerCapability": {
      "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/unitValue",
      "message": {
        "type": "SEM-BAT-MSG-066"
      }
    },
    "powerFade": {
      "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/unitValue",
      "message": {
        "type": "SEM-BAT-MSG-067"
      }
    },
