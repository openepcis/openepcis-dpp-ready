      }
    },
    "remainingPowerCapability": {
      "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/unitValue",
      "message": {
        "type": "SEM-BAT-MSG-076"
      }
    },
    "remainingRoundTripEfficiency": {
      "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/unitValue",
      "message": {
        "type": "SEM-BAT-MSG-077"
      }
    },
    "selfDischargingRateSet": {
      "type": "object",
      "properties": {
