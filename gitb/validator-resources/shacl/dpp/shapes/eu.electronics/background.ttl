    rdfs:range oec:EnergyEfficiencyClass;
    rdfs:domain oec:EnergyEfficiency;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#energyEfficiencyClass>.
oec:testedConditions a owl:DatatypeProperty;
    rdfs:comment "Description of conditions under which performance was tested."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Tested Conditions"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:PerformanceInfo.
oec:hasRepairabilityInfo a owl:ObjectProperty;
    rdfs:seeAlso gs1:serviceInfo;
    rdfs:comment "Repair and maintenance information for the product."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repairability Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:closeMatch gs1:serviceInfo;
    rdfs:range oec:RepairabilityInfo.
oec:repairabilityScore a owl:DatatypeProperty;
    rdfs:comment "Repairability index score (typically 0-10 scale, e.g., French Indice de Réparabilité)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repairability Score"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:RepairabilityInfo.
oec:repairabilityClass a owl:DatatypeProperty;
    rdfs:comment "Repairability class (A to E, where A is most repairable)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repairability Class"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:RepairabilityInfo.
oec:hasSparePartsAvailability a owl:ObjectProperty;
    rdfs:comment "Duration for which spare parts will be available. Use gs1:QuantitativeValue with unitCode 'ANN' for years."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Spare Parts Availability"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:RepairabilityInfo.
oec:hasRepairInstructions a owl:ObjectProperty;
    rdfs:seeAlso gs1:serviceInfo;
    rdfs:comment "URL or reference to repair instructions and manuals."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Instructions"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch gs1:instructions, gs1:serviceInfo, <https://w3id.org/eudpp#webLink>;
    rdfs:range oec:DocumentReference;
    rdfs:domain oec:RepairabilityInfo.
oec:professionalRepairNetwork a owl:DatatypeProperty;
    rdfs:seeAlso <http://data.europa.eu/m8g/contactPage>, <https://dpp-keystone.org/spec/v2/terms#repairServices>, <https://dpp-keystone.org/spec/v2/terms#repairService>;
    rdfs:comment "URL to find authorized repair service providers."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Professional Repair Network"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:RepairabilityInfo.
oec:diyRepairPossible a owl:DatatypeProperty;
    rdfs:comment "Whether the product can be repaired by consumers (do-it-yourself repair)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "DIY Repair Possible"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:boolean;
    rdfs:domain oec:RepairabilityInfo.
oec:hasSoftwareUpdatesAvailability a owl:ObjectProperty;
    rdfs:comment "Duration for which software/firmware updates will be provided. Use unitCode 'ANN' (UN/CEFACT Rec 20)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Software Updates Availability"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:RepairabilityInfo.
oec:hasAccessRights a owl:ObjectProperty;
    rdfs:comment "Access control configuration for this data element."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Access Rights"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range oec:AccessRights.
oec:hasAccessLevel a owl:ObjectProperty;
    rdfs:seeAlso schema:conditionsOfAccess;
    rdfs:comment "The access level for this data (Public, AuthorizedOnly, Restricted)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Access Level"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range oec:AccessLevel;
    rdfs:domain oec:AccessRights.
oec:hasAuthorizedParties a owl:ObjectProperty;
    rdfs:comment "List of parties authorized to access restricted data."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Authorized Parties"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:Organization;
    rdfs:domain oec:AccessRights.
oec:hasDataRetentionPeriod a owl:ObjectProperty;
    rdfs:comment "How long the data must be retained per regulatory requirements. Use unitCode 'ANN' (UN/CEFACT Rec 20)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Data Retention Period"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:AccessRights.
oec:hasProductCategory a owl:ObjectProperty;
    rdfs:comment "ESPR product category classification."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Product Category"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:category, gs1:additionalProductClassificationCode, <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#batteryCategory>;
    rdfs:range oec:ProductCategory.
oec:passportIdentifier a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#DPPIdentifier>;
    rdfs:comment "Globally unique identifier (URI) for this DPP instance (EN 18223 'digitalProductPassportId'; JSON key digitalProductPassportId)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.1 (CEN/CENELEC JTC 24)";
    rdfs:label "Passport Identifier"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:identifier, <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#batteryPassportIdentifier>;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DigitalProductPassport.
oec:passportVersion a owl:DatatypeProperty;
    rdfs:seeAlso schema:version;
    rdfs:comment "Version of this Digital Product Passport."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Passport Version"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:closeMatch schema:version;
    rdfs:range xsd:string.
oec:passportIssueDate a owl:DatatypeProperty;
    rdfs:seeAlso schema:dateIssued, <https://w3id.org/eudpp#validFrom>;
    rdfs:comment "Date when this Digital Product Passport was issued."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Passport Issue Date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:date.
oec:passportStatus a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#dppStatus>;
    rdfs:comment "Lifecycle status of this DPP (EN 18223 'dppStatus'): a lowercase string token (see oec:PassportStatus)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.1 (CEN/CENELEC JTC 24)";
    rdfs:label "Passport Status"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 18223 'dppStatus'. Base values active/inactive/archived/invalid; EPCIS4DPP adds draft/withdrawn/suspended."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:DigitalProductPassport;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#dppStatus>.
oec:passportExpiryDate a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#validUntil>;
    rdfs:comment "Date when this Digital Product Passport expires or requires renewal."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Passport Expiry Date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR requires DPP data to remain available for a period defined in delegated acts."@en;
    rdfs:range xsd:date.
oec:hasPassportIssuer a owl:ObjectProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#hasIssuer>;
    rdfs:comment "Economic operator responsible for issuing and maintaining this Digital Product Passport."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Passport Issuer"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Article 9 requires clear identification of the responsible economic operator."@en;
    skos:closeMatch schema:issuedBy;
    rdfs:range oec:OperatorInformation.
oec:hasBackupCopyHost a owl:ObjectProperty;
    rdfs:seeAlso oec:hasPassportIssuer, <https://w3id.org/eudpp#hasBackUpCopyHost>;
    rdfs:comment "Digital product passport service provider that holds the backup copy of this passport, ensuring availability if the primary host fails or the responsible economic operator ceases to exist."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Backup Copy Host"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Art. 10(4) requires a backup copy of the passport to be available through a DPP service provider. Neither GS1, SEMICeu nor schema.org carries a backup-custodian role; schema:issuedBy names the issuer, not the fallback host."@en;
    rdfs:range oec:OperatorInformation;
    skos:exactMatch <https://w3id.org/eudpp#hasBackUpCopyHost>.
oec:isEnergyRelated a owl:DatatypeProperty;
    rdfs:seeAlso oec:energyEfficiencyClass, <https://w3id.org/eudpp#isEnergyRelated>;
    rdfs:comment "Whether the product is an energy-related product in the sense of the ESPR, i.e. a product with an impact on energy consumption during use."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Is Energy-Related Product"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR scope flag: energy-related products inherit the Ecodesign 2009/125/EC acquis and delegated acts may attach additional energy-performance requirements to them. No GS1, SEMICeu, or schema.org equivalent boolean exists."@en;
    rdfs:range xsd:boolean;
    rdfs:domain gs1:Product;
    skos:exactMatch <https://w3id.org/eudpp#isEnergyRelated>.
oec:previousPassportVersion a owl:DatatypeProperty;
    rdfs:seeAlso <http://www.w3.org/ns/adms#prev>, <https://w3id.org/eudpp#linkToPreviousDPP>;
    rdfs:comment "Reference to the previous version of this passport, supporting version history per EN 18221."@en;
    dcterms:source "EN 18221:2026 (CEN/CENELEC JTC 24)";
    rdfs:label "Previous Passport Version"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Supports the EN 18221 requirement that previous versions remain available."@en;
    skos:broadMatch schema:predecessorOf;
    rdfs:range xsd:anyURI;
    skos:exactMatch <http://www.w3.org/ns/adms#prev>, <https://w3id.org/eudpp#linkToPreviousDPP>.
oec:dppSchemaVersion a owl:DatatypeProperty;
    rdfs:comment "The schema or standard version the DPP instance conforms to (EN 18223 'dppSchemaVersion'). Distinct from the content version oec:passportVersion."@en;
    dcterms:source "EN 18223:2026, 4.1.2.1 (CEN/CENELEC JTC 24)";
    rdfs:label "DPP Schema Version"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:closeMatch schema:schemaVersion;
    rdfs:range xsd:string;
    rdfs:domain oec:DigitalProductPassport;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#dppSchemaVersion>.
oec:facilityId a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#FacilityIdentifier>, <https://w3id.org/eudpp#hasUniqueFacilityIdentifier>;
    rdfs:comment "Identifier of a facility involved in the product's life cycle (EN 18223 'facilityId', formatted per EN 18219). In EPCIS4DPP a GLN. See oec:FacilityInformation for the richer facility record."@en;
    dcterms:source "EN 18223:2026, 4.1.2.1; EN 18219:2026 (CEN/CENELEC JTC 24)";
    rdfs:label "Facility Identifier"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Economic-operator / facility pattern per ESPR 2024/1781 Article 77. Anchored to SEMICeu CPOV / GS1 where applicable."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#manufacturingFacility>;
    rdfs:range xsd:string;
    rdfs:domain oec:DigitalProductPassport;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#facilityId>.
oec:contentSpecificationId a owl:DatatypeProperty;
    rdfs:comment "Reference to a horizontal or product-type content specification for the DPP (EN 18223 'contentSpecificationIds'). In EPCIS4DPP mirrors the declared GS1-Extensions namespaces."@en;
    dcterms:source "EN 18223:2026, 4.1.2.1 (CEN/CENELEC JTC 24)";
    rdfs:label "Content Specification Identifier"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#contentSpecificationIds>;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DigitalProductPassport.
oec:DataElement a rdfs:Class;
    rdfs:comment "Abstract base for a DPP data point (EN 18223 4.1.2.3). Not used directly; see its subclasses."@en;
    dcterms:source "EN 18223:2026, 4.1.2.3 (CEN/CENELEC JTC 24)";
    rdfs:label "Data Element"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>.
oec:DataElementCollection a rdfs:Class;
    rdfs:seeAlso schema:Collection;
    rdfs:comment "A container of one or more DataElements (EN 18223 4.1.2.4)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.4 (CEN/CENELEC JTC 24)";
    rdfs:label "Data Element Collection"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf oec:DataElement;
    skos:broadMatch schema:Dataset.
oec:SingleValuedDataElement a rdfs:Class;
    rdfs:seeAlso gs1:QuantitativeValue, schema:QuantitativeValue;
    rdfs:comment "A single data point with one value (EN 18223 4.1.2.5)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.5 (CEN/CENELEC JTC 24)";
    rdfs:label "Single-Valued Data Element"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf oec:DataElement;
    skos:broadMatch gs1:QuantitativeValue.
oec:MultiValuedDataElement a rdfs:Class;
    rdfs:comment "An ordered list of DataElements of the same type (EN 18223 4.1.2.6)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.6 (CEN/CENELEC JTC 24)";
    rdfs:label "Multi-Valued Data Element"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf oec:DataElement.
oec:MultiLanguageDataElement a rdfs:Class;
    rdfs:comment "A language-dependent data point carrying one or more language-tagged values (EN 18223 4.1.2.8)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.8 (CEN/CENELEC JTC 24)";
    rdfs:label "Multi-Language Data Element"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf oec:DataElement.
oec:MultiLanguageValue a rdfs:Class;
    rdfs:comment "A language-tagged value: a string plus its language (EN 18223 4.1.2.8.2)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.8.2 (CEN/CENELEC JTC 24)";
    rdfs:label "Multi-Language Value"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:broadMatch schema:StructuredValue.
oec:elementId a owl:DatatypeProperty;
    rdfs:seeAlso schema:identifier;
    rdfs:comment "Identifier of a DataElement, unique within its container (EN 18223 4.1.2.3)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.3 (CEN/CENELEC JTC 24)";
    rdfs:label "Element Id"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:identifier;
    rdfs:range xsd:string;
    rdfs:domain oec:DataElement.
oec:dictionaryReference a owl:DatatypeProperty;
    rdfs:comment "Reference to the data-point definition in a data dictionary (EN 18223 4.1.2.3). In EPCIS4DPP a ref.openepcis.io term IRI; ref.openepcis.io is the EN 18223 4.3 data-dictionary repository."@en;
    dcterms:source "EN 18223:2026, 4.1.2.3, 4.3 (CEN/CENELEC JTC 24)";
    rdfs:label "Dictionary Reference"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DataElement;
    skos:exactMatch <https://w3id.org/eudpp#dictionaryReference>.
oec:valueDataType a owl:DatatypeProperty;
    rdfs:comment "XSD data type of the value (EN 18223 4.1.2.9), for example \"xsd:integer\"."@en;
    dcterms:source "EN 18223:2026, 4.1.2.9 (CEN/CENELEC JTC 24)";
    rdfs:label "Value Data Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:string.
oec:value a rdf:Property;
    rdfs:seeAlso schema:value, schema:codeValue, gs1:certificationValue, <http://data.europa.eu/m8g/hasValue>, <http://data.europa.eu/m8g/value>, gs1:value, <http://data.europa.eu/m8g/expressionOfExpectedValue>, gs1:originalCodeValue, schema:maxValue;
    rdfs:comment "The value of a SingleValuedDataElement or MultiLanguageValue (EN 18223 4.1.2.5, 4.1.2.8.2). Any JSON data type."@en;
    dcterms:source "EN 18223:2026, 4.1.2.5 (CEN/CENELEC JTC 24)";
    rdfs:label "Value"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:textValue, <https://gs1-epcis-reg.org/rail/voc/data#nominalValue>, gs1:authenticitySecurityFeatureValue, schema:valueReference, <https://gs1-epcis-reg.org/rail/voc/data#topValue>, gs1:colourCodeValue, <https://gs1-epcis-reg.org/rail/voc/data#rightValue>, <https://gs1-epcis-reg.org/rail/voc/data#leftValueString>, gs1:additionalProductClassificationValue, <https://gs1-epcis-reg.org/rail/voc/data#rightValueString>;
    skos:exactMatch <https://vocabulary.uncefact.org/untp/value>.
oec:hasDataElement a owl:ObjectProperty;
    rdfs:seeAlso schema:itemListElement;
    rdfs:comment "Member DataElement of a DigitalProductPassport, DataElementCollection, or MultiValuedDataElement (EN 18223 4.1.2.4, 4.1.2.6)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.4 (CEN/CENELEC JTC 24)";
    rdfs:label "Data Element"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range oec:DataElement.
oec:hasMultiLanguageValue a owl:ObjectProperty;
    rdfs:comment "A language-tagged value of a MultiLanguageDataElement (EN 18223 4.1.2.8)."@en;
    dcterms:source "EN 18223:2026, 4.1.2.8 (CEN/CENELEC JTC 24)";
    rdfs:label "Multi-Language Value"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range oec:MultiLanguageValue;
    rdfs:domain oec:MultiLanguageDataElement.
oec:language a owl:DatatypeProperty;
    rdfs:seeAlso schema:inLanguage;
    rdfs:comment "Language tag of a value (EN 18223 4.1.2.8.2): ISO 639 language plus EN ISO 3166-1 country, for example \"en-GB\"."@en;
    dcterms:source "EN 18223:2026, 4.1.2.8.2 (CEN/CENELEC JTC 24)";
    rdfs:label "Language"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:inLanguage, schema:subtitleLanguage, schema:availableLanguage;
    skos:closeMatch gs1:fileLanguageCode;
    rdfs:range xsd:string.
oec:activityClassification a owl:DatatypeProperty;
    rdfs:seeAlso <https://unstats.un.org/unsd/classifications/Econ/isic>, gs1:OrganizationClassificationDetails, gs1:organizationClassificationType;
    rdfs:comment "Industry/economic activity classification code (UN ISIC, EU NACE, US NAICS)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Activity Classification"@en;
    skos:note "Use standard classification codes: ISIC Rev.4, NACE Rev.2, or NAICS.\nNo domain restriction - can be used on OperatorInformation, FacilityInformation, or any entity.\nSupports UNTP Digital Facility Record (DFR) activity classification requirements.\n\nGS1 published this structure in July 2026 and now models it in two parts:\ngs1:organizationClassification links a gs1:Organization to a\ngs1:OrganizationClassificationDetails, which carries gs1:organizationClassificationID (the code)\nalongside gs1:organizationClassificationType (the scheme the code belongs to). This property\ncarries only the code and conveys the scheme by convention, so the anchor is skos:closeMatch\nrather than exactMatch. New models should prefer the GS1 structure; see\ndocs/VOCABULARY_LAYERING.md on redoing a term that upstream has since covered."@en;
    skos:closeMatch gs1:organizationClassificationID;
    skos:narrowMatch schema:naics, schema:isicV4;
    rdfs:range xsd:string.
oec:did a owl:DatatypeProperty;
    rdfs:seeAlso <https://www.w3.org/TR/did-core/>, <https://untp.unece.org/docs/specification/DigitalIdentityAnchor/>;
    rdfs:comment "DID (Decentralized Identifier) linking this entity to verifiable identity infrastructure."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Decentralized Identifier"@en;
    skos:note "Used to link traditional IDs (GLN, VAT, EOID) to DIDs per UNTP Digital Identity Anchor pattern.\nNo domain restriction - can be used on OperatorInformation, FacilityInformation, or any entity.\nDID format: did:method:specific-identifier (e.g., did:web:example.com)."@en;
    skos:broadMatch schema:identifier;
    rdfs:range xsd:anyURI.
oec:identityCredentialUrl a owl:DatatypeProperty;
    rdfs:seeAlso gs1:referencedFileURL, <https://untp.unece.org/docs/specification/DigitalIdentityAnchor/>, <https://www.w3.org/TR/vc-data-model-2.0/>, <https://dpp-keystone.org/spec/v2/terms#verifiableCredential>;
    rdfs:comment "URL to a verifiable credential proving identity (Digital Identity Anchor or similar)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Identity Credential URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Links to a VC issued by authoritative registry (chamber of commerce, tax authority)\nproving DID-to-traditional-ID binding. Supports UNTP Digital Identity Anchor requirements.\nNo domain restriction - can be used on OperatorInformation, FacilityInformation, or any entity."@en;
    rdfs:range xsd:anyURI.
oec:IndividualTradeItemPiece a rdfs:Class;
    rdfs:seeAlso <https://www.gs1.org/standards/barcodes/application-identifiers/8026>;
    rdfs:comment "A single physical piece of a multi-piece trade item, identified via GS1 AI 8026 (ITIP). Used when a single GTIN is composed of multiple individually-shipped pieces (e.g., a 2-piece suit, a furniture set)."@en;
    dcterms:source "https://ref.gs1.org/ai/8026";
    rdfs:label "Individual Trade Item Piece"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Reference pattern aligned with GS1 ITIP (AI 8026). The ITIP AI 8026 encodes GTIN + total piece count + piece number in one identifier."@en;
    skos:broadMatch schema:IndividualProduct.
oec:hasTradeItemPieces a owl:ObjectProperty;
    rdfs:seeAlso <https://www.gs1.org/standards/barcodes/application-identifiers/8026>, schema:hasPart;
    rdfs:comment "Links a multi-piece trade item to the individual pieces it is delivered as, each identified via GS1 AI 8026 (ITIP)."@en;
    dcterms:source "https://ref.gs1.org/ai/8026";
    rdfs:label "Trade Item Pieces"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "The GS1 Web Vocabulary publishes no property for the ITIP piece set: AI 8026 is an identification key in the GS1 General Specifications (section 3.9.17), and gs1:Product carries no piece-level part-whole property. This is the forward direction of oec:tradeItemPieceOf and the container the piece-level oec:tradeItemPiece* properties hang off."@en;
    skos:broadMatch schema:hasPart;
    rdfs:range oec:IndividualTradeItemPiece;
    rdfs:domain gs1:Product.
oec:tradeItemPieceCount a owl:DatatypeProperty;
    rdfs:seeAlso <https://www.gs1.org/standards/barcodes/application-identifiers/8026>;
    rdfs:comment "Total number of physical pieces that together constitute the complete trade item identified by the parent GTIN."@en;
    dcterms:source "https://ref.gs1.org/ai/8026";
    rdfs:label "Trade Item Piece Count"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Maps to the piece count component of GS1 AI 8026. For example, a 2-piece suit has tradeItemPieceCount = 2."@en;
    rdfs:range xsd:positiveInteger;
    rdfs:domain gs1:Product.
oec:tradeItemPieceNumber a owl:DatatypeProperty;
    rdfs:comment "The sequential number of this piece within the multi-piece trade item (1-based). For a 2-piece suit, the jacket might be piece 1 and trousers piece 2."@en;
    dcterms:source "https://ref.gs1.org/ai/8026";
    rdfs:label "Trade Item Piece Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Maps to the piece-number component of GS1 AI 8026. MUST be less than or equal to oec:tradeItemPieceCount on the parent product."@en;
    rdfs:range xsd:positiveInteger;
    rdfs:domain oec:IndividualTradeItemPiece.
oec:tradeItemPieceOf a owl:ObjectProperty;
    rdfs:comment "Links an individual piece to the multi-piece trade item (identified by its GTIN) it belongs to."@en;
    dcterms:source "https://ref.gs1.org/ai/8026";
    rdfs:label "Trade Item Piece Of"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Inverse relationship: a gs1:Product with oec:tradeItemPieceCount > 1 has multiple oec:IndividualTradeItemPiece members linked back via this property."@en;
    rdfs:range gs1:Product;
    rdfs:domain oec:IndividualTradeItemPiece.
oec:tradeItemPieceDescription a owl:DatatypeProperty;
    rdfs:seeAlso gs1:productDescription, gs1:offerDescription, gs1:additionalProductDescription;
    rdfs:comment "Human-readable description of what this specific piece is (e.g., 'Jacket', 'Trousers', 'Left shoe', 'Instruction booklet')."@en;
    dcterms:source "https://ref.gs1.org/ai/8026";
    rdfs:label "Trade Item Piece Description"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:description, gs1:productDescription, gs1:styleDescription;
    rdfs:range xsd:string;
    rdfs:domain oec:IndividualTradeItemPiece.
oec:CustomsCommodityCodeType a owl:Class;
    rdfs:seeAlso schema:CategoryCode, gs1:TypeCode, <https://w3id.org/eudpp#ClassificationCode>;
    rdfs:comment "The classification system that a customs commodity code belongs to."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Customs Commodity Code Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    owl:oneOf _:n3-3589.
_:n3-3589 rdf:first oec:HS6;
    rdf:rest _:n3-3590.
oec:HS6 a oec:CustomsCommodityCodeType;
    rdfs:label "HS 6-digit (World Customs Organization Harmonized System)"@en.
_:n3-3590 rdf:first oec:HS8;
    rdf:rest _:n3-3591.
oec:HS8 a oec:CustomsCommodityCodeType;
    rdfs:label "HS 8-digit subheading"@en.
_:n3-3591 rdf:first oec:CN8;
    rdf:rest _:n3-3592.
oec:CN8 a oec:CustomsCommodityCodeType;
    rdfs:label "EU Combined Nomenclature 8-digit"@en.
_:n3-3592 rdf:first oec:HTSUS10;
    rdf:rest _:n3-3593.
oec:HTSUS10 a oec:CustomsCommodityCodeType;
    rdfs:label "US Harmonized Tariff Schedule 10-digit"@en.
_:n3-3593 rdf:first oec:CN10;
    rdf:rest rdf:nil.
oec:CN10 a oec:CustomsCommodityCodeType;
    rdfs:label "EU Combined Nomenclature 10-digit (TARIC)"@en.
oec:customsCommodityCode a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#commodityCode>;
    rdfs:comment "A commodity code assigned to a trade item for customs classification. The coding system (HS / CN / HTSUS) is indicated by oec:hasCustomsCommodityCodeType on the same trade item. GS1 has no native property for this; tariffs and regulatory obligations across EU Combined Nomenclature, US HTSUS, and WCO HS all need it."@en;
    dcterms:source <https://www.wcoomd.org/en/topics/nomenclature.aspx>;
    rdfs:label "Customs Commodity Code"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:string;
    rdfs:domain gs1:Product.
oec:hasCustomsCommodityCodeType a owl:ObjectProperty;
    rdfs:comment "The classification system (HS, CN, HTSUS, etc.) used for oec:customsCommodityCode on the same trade item."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Customs Commodity Code Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range oec:CustomsCommodityCodeType;
    rdfs:domain gs1:Product.
oec:isRegulationCompliant a owl:DatatypeProperty;
    rdfs:comment "Asserts that a trade item complies with a specific regulatory act. Used inside a gs1:regulatoryInformation block alongside gs1:regulatoryAct. Replaces the non-existent gs1:isRegulationCompliant referenced in earlier drafts."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Is Regulation Compliant"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "This is a oec: extension because no GS1 Web Vocabulary term currently carries a boolean compliance assertion."@en;
    rdfs:range xsd:boolean.
oec:RegulationTypeCode-ESPR a gs1:RegulationTypeCode;
    rdfs:seeAlso gs1:RegulationTypeCode-EFFICIENCY_OF_LAMPS_LUMINARIES;
    rdfs:comment "Regulation (EU) 2024/1781 establishing a framework for the setting\nof ecodesign requirements for sustainable products (ESPR), replacing the\nEcodesign Directive 2009/125/EC. Use as the gs1:regulationType of a\ngs1:RegulatoryInformation entry declaring compliance with ESPR or one of\nits delegated acts. Cross-cuts every regulation module, hence owned by\ncommon/core."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Ecodesign for Sustainable Products Regulation (ESPR)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Core-owned member of the gs1:RegulationTypeCode code list: the upstream list has no ecodesign/ESPR entry. Candidate for upstream GS1 code-list submission."@en;
    skos:prefLabel "ESPR".
oec:regulatoryActStatus a owl:DatatypeProperty;
    rdfs:seeAlso gs1:regulatoryAct;
    rdfs:comment "Status of a trade item with respect to a specific regulatory act (e.g. ACTIVE, EXEMPT, PENDING). Used inside a gs1:regulatoryInformation block alongside gs1:regulatoryAct."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Regulatory Act Status"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "oec: extension: GS1 Web Vocabulary names a regulatory act (gs1:regulatoryAct) but carries no status of an item against that act. Replaces the non-existent gs1:regulatoryActStatus referenced in earlier drafts."@en;
    rdfs:range xsd:string;
    skos:relatedMatch gs1:regulatoryAct.
oec:regulatoryPermitIdentification a owl:DatatypeProperty;
    rdfs:seeAlso gs1:regulatoryReferenceNumber, gs1:regulatoryIdentifier;
    rdfs:comment "Identifier of a permit, authorisation, or type-examination certificate issued by a regulatory body for the trade item. Used inside a gs1:regulatoryInformation block."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Regulatory Permit Identification"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "oec: extension: GS1 gs1:regulatoryIdentifier links to identifier groupings within a regulatory information system and gs1:regulatoryReferenceNumber is a reference number, neither of which is a literal permit identifier. Replaces the non-existent gs1:regulatoryPermitIdentification referenced in earlier drafts."@en;
    skos:closeMatch gs1:regulatoryReferenceNumber;
    rdfs:range xsd:string.
oec:ExtendedProducerResponsibility a owl:Class;
    rdfs:comment "A registration of a producer's compliance with an Extended Producer\nResponsibility (EPR) scheme for a specific waste stream and jurisdiction.\nEPR schemes apply across PPWR (packaging), WEEE (electronics), Battery\nRegulation, ELV (vehicles), Textile-DA (proposed), and others; every\nregulation covered by this ontology. No upstream vocabulary defines this\nclass; UNTP v0.7.0 has no EPR-specific term, and CIRPASS-2 D3.2 confirms it\nas a gap."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Extended Producer Responsibility"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en.
oec:eprRegistrationNumber a owl:DatatypeProperty;
    rdfs:seeAlso gs1:registryEntry;
    rdfs:comment "Producer registration number issued by an EPR compliance scheme operator (e.g. Stiftung EAR for German WEEE, EcoEmballages for French packaging)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPR Registration Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch gs1:regulatoryReferenceNumber;
    rdfs:range xsd:string;
    rdfs:domain oec:ExtendedProducerResponsibility.
oec:hasEprScheme a owl:ObjectProperty;
    rdfs:comment "The Producer Responsibility Organisation (PRO) or competent authority that operates the EPR scheme. Modelled as a gs1:Organization or untp:Party."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPR Scheme Operator"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:Organization;
    rdfs:domain oec:ExtendedProducerResponsibility.
oec:hasEprJurisdiction a owl:ObjectProperty;
    rdfs:seeAlso schema:jurisdiction;
    rdfs:comment "The country / member state where this EPR registration applies. EPR schemes are organised per Member State; producers selling into multiple MS register in each."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPR Jurisdiction"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:jurisdiction;
    rdfs:range gs1:Country;
    rdfs:domain oec:ExtendedProducerResponsibility.
oec:eprComplianceUrl a owl:DatatypeProperty;
    rdfs:comment "URL of the EPR scheme operator's public verification endpoint or compliance certificate for this producer."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPR Compliance URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch gs1:certificationAgencyURL;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:ExtendedProducerResponsibility.
oec:eprWasteStream a owl:DatatypeProperty;
    rdfs:comment "The waste stream the EPR registration covers: packaging, weee, batteries, vehicles, textiles, etc. Free-text token; controlled vocabulary may be added when EU publishes one."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPR Waste Stream"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:ExtendedProducerResponsibility.
oec:hasExtendedProducerResponsibility a owl:ObjectProperty;
    rdfs:comment "Links a product or operator to one or more EPR registrations covering it."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Extended Producer Responsibility"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range oec:ExtendedProducerResponsibility.
oec:bioBasedFraction a owl:DatatypeProperty;
    rdfs:comment "Mass fraction (0-1) of the product or material derived from renewable biological feedstock (rather than fossil-derived). Use unitCode 'P1' (UN/CEFACT Rec 20) when expressed via gs1:QuantitativeValue."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Bio-based Fraction"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Distinct from biodegradability (a separate test result) and compostability (a separate certification category)."@en;
    skos:broadMatch <https://vocabulary.uncefact.org/untp/massFraction>;
    rdfs:range xsd:decimal.
oec:Biodegradability a owl:Class;
    rdfs:comment "An observed biodegradability result for a substance or material, typically per ISO 14593 / OECD 301B/D/F / OECD 310 test methods. Represents a measurement, not a regulatory category."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Biodegradability"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf schema:Observation;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en.
oec:hasBiodegradability a owl:ObjectProperty;
    rdfs:seeAlso gs1:consumerRecyclingInstructions, schema:hasMeasurement;
    rdfs:comment "Links a product, material, or substance to its observed biodegradability result."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Biodegradability"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Entry property for the oec:Biodegradability observation: without it the class and its oec:biodegradationPercentage / oec:hasBiodegradabilityTestMethod members are unreachable from the product. GS1 has no biodegradability property (gs1:consumerRecyclingInstructions is free text about recycling), SEMICeu has none, and schema.org offers only the generic schema:hasMeasurement."@en;
    skos:broadMatch schema:hasMeasurement;
    rdfs:range oec:Biodegradability;
    rdfs:domain gs1:Product.
oec:hasCompostability a owl:ObjectProperty;
    rdfs:seeAlso schema:hasCertification, gs1:PackagingMarkedLabelAccreditationCode;
    rdfs:comment "Links a product or material to its compostability classification and certification."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Compostability"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Entry property for the oec:Compostability category: without it the class and its oec:hasCompostabilityType / oec:compostabilityStandard members are unreachable from the product. CIRPASS-2 D3.2 confirmed compostability as a gap in published vocabulary; GS1 carries only the packaging label accreditation codes, not the classification itself."@en;
    skos:broadMatch schema:hasCertification;
    rdfs:range oec:Compostability;
    rdfs:domain gs1:Product.
oec:Compostability a owl:Class;
    rdfs:comment "Compostability category and certification standard for a product or material. Distinct from biodegradability: compostability is a regulatory-recognised classification, not a continuous measurement."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Compostability"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:Certification.
oec:biodegradationPercentage a owl:DatatypeProperty;
    rdfs:comment "Percentage of substance biodegraded under the test method conditions. Use unitCode 'P1' (UN/CEFACT Rec 20) when expressed via gs1:QuantitativeValue."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Biodegradation Percentage"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:Biodegradability.
oec:BiodegradabilityTestMethod a owl:Class;
    rdfs:seeAlso <http://data.europa.eu/m8g/Criterion>;
    rdfs:comment "The standardised laboratory method used to assess biodegradability."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Biodegradability Test Method"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    owl:oneOf _:n3-3594.
_:n3-3594 rdf:first oec:ISO14593;
    rdf:rest _:n3-3595.
oec:ISO14593 a oec:BiodegradabilityTestMethod;
    rdfs:label "ISO 14593 (CO2 evolution test)"@en.
_:n3-3595 rdf:first oec:OECD301B;
    rdf:rest _:n3-3596.
oec:OECD301B a oec:BiodegradabilityTestMethod;
    rdfs:label "OECD 301B (CO2 evolution test)"@en.
_:n3-3596 rdf:first oec:OECD301D;
    rdf:rest _:n3-3597.
oec:OECD301D a oec:BiodegradabilityTestMethod;
    rdfs:label "OECD 301D (closed bottle test)"@en.
_:n3-3597 rdf:first oec:OECD301F;
    rdf:rest _:n3-3598.
oec:OECD301F a oec:BiodegradabilityTestMethod;
    rdfs:label "OECD 301F (manometric respirometry)"@en.
_:n3-3598 rdf:first oec:OECD310;
    rdf:rest rdf:nil.
oec:OECD310 a oec:BiodegradabilityTestMethod;
    rdfs:label "OECD 310 (sealed vessel CO2 evolution)"@en.
oec:hasBiodegradabilityTestMethod a owl:ObjectProperty;
    rdfs:comment "The test method used to determine the biodegradability percentage."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Biodegradability Test Method"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:measurementMethod;
    rdfs:range oec:BiodegradabilityTestMethod;
    rdfs:domain oec:Biodegradability.
oec:CompostabilityType a owl:Class;
    rdfs:comment "Classification of how a product can be composted."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Compostability Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    owl:oneOf _:n3-3599.
_:n3-3599 rdf:first oec:IndustrialCompostable;
    rdf:rest _:n3-3600.
oec:IndustrialCompostable a oec:CompostabilityType;
    rdfs:comment "Compostable in industrial composting facilities (typically per EN 13432)."@en;
    rdfs:label "Industrially Compostable"@en.
_:n3-3600 rdf:first oec:HomeCompostable;
    rdf:rest _:n3-3601.
oec:HomeCompostable a oec:CompostabilityType;
    rdfs:comment "Compostable in domestic composting conditions (typically per OK-Compost-Home / NF T 51-800)."@en;
    rdfs:label "Home Compostable"@en.
_:n3-3601 rdf:first oec:NotCompostable;
    rdf:rest rdf:nil.
oec:NotCompostable a oec:CompostabilityType;
    rdfs:label "Not Compostable"@en.
oec:hasCompostabilityType a owl:ObjectProperty;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Compostability Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range oec:CompostabilityType;
    rdfs:domain oec:Compostability.
oec:compostabilityStandard a owl:DatatypeProperty;
    rdfs:comment "URI of the standard the compostability claim is certified against (e.g. EN 13432, OK-Compost-Home, ASTM D6400)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Compostability Standard"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:Compostability.
oec:DepositReturnScheme a owl:Class;
    rdfs:comment "A deposit-return scheme that the product participates in (PPWR Article 50, beverage container DRS in DE/AT/NL/SE/etc., and any future EU-harmonised DRS). Subclass of gs1:ReturnablePackageDepositDetails: instances carry the deposit amount and region via gs1:returnablePackageDepositAmount / gs1:returnablePackageDepositRegion and add the operator and redemption-channel data points GS1 does not model."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Deposit-Return Scheme"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf gs1:ReturnablePackageDepositDetails;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward as a subclass of gs1:ReturnablePackageDepositDetails."@en.
oec:hasDepositAmount a owl:ObjectProperty;
    rdfs:seeAlso schema:amount;
    rdfs:comment "Refundable deposit applied at point of sale. Modelled as gs1:QuantitativeValue with unitCode = ISO 4217 currency code (e.g. 'EUR'). Prefer the upstream gs1:returnablePackageDepositAmount (range gs1:PriceSpecification) where the GS1 packaging model is in use; this property remains for QuantitativeValue-based expressions."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Deposit Amount"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists. closeMatch (not exactMatch) to gs1:returnablePackageDepositAmount: same meaning, different value structure (QuantitativeValue vs PriceSpecification)."@en;
    skos:closeMatch gs1:returnablePackageDepositAmount;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:DepositReturnScheme.
oec:hasDepositSchemeOperator a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#economicOperator>;
    rdfs:comment "The Producer Responsibility Organisation that operates the DRS (e.g. Pfand-System Deutschland for DE)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Deposit Scheme Operator"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Economic-operator / facility pattern per ESPR 2024/1781 Article 77. Anchored to SEMICeu CPOV / GS1 where applicable."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#economicOperator>;
    skos:closeMatch schema:serviceOperator;
    rdfs:range gs1:Organization;
    rdfs:domain oec:DepositReturnScheme.
oec:depositRedemptionChannelUrl a owl:DatatypeProperty;
    rdfs:seeAlso schema:availableChannel;
    rdfs:comment "URL of the public directory of redemption channels (where consumers can return the container for refund)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Deposit Redemption Channel URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DepositReturnScheme.
oec:hasDepositReturnScheme a owl:ObjectProperty;
    rdfs:seeAlso <https://vocabulary.uncefact.org/untp/referenceScheme>, <https://vocabulary.uncefact.org/untp/idScheme>;
    rdfs:comment "Links a product (typically gs1:PackagingDetails) to the DRS it participates in. Where the GS1 packaging model is in use, prefer the upstream gs1:hasReturnablePackageDeposit (gs1:PackagingDetails → gs1:ReturnablePackageDepositDetails); since oec:DepositReturnScheme subclasses the GS1 target class, the same node works for both."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Deposit-Return Scheme"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:closeMatch gs1:hasReturnablePackageDeposit;
    rdfs:range oec:DepositReturnScheme.
oec:CarbonFootprintDeclaration a owl:Class;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>;
    rdfs:comment "An observation of a product's lifecycle carbon footprint, broken down by lifecycle stage. Used for EU Battery Annex II §8, ESPR carbon-footprint declarations, PEF reporting, and PPWR optional disclosures."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint Declaration"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf schema:Observation;
    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    skos:broadMatch <https://w3id.org/eudpp#CarbonFootprint>, <https://w3id.org/eudpp#EnvironmentalFootprint>;
    skos:narrowMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>.
oec:hasCarbonFootprintRawMaterial a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#absoluteCarbonFootprint>;
    rdfs:comment "Lifecycle stage emissions from raw-material acquisition and pre-processing. gs1:QuantitativeValue with unitCode 'KGM' (kg CO2e) and oec:declaredFunctionalUnit set on the parent CarbonFootprintDeclaration."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint: Raw Material Acquisition"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#absoluteCarbonFootprint>, <https://dpp-keystone.org/spec/v2/terms#carbonFootprintAbsolute>, <https://dpp-keystone.org/spec/v2/terms#environmentalFootprint>;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:CarbonFootprintDeclaration.
oec:hasCarbonFootprintDistribution a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>;
    rdfs:comment "Lifecycle stage emissions from distribution and logistics. gs1:QuantitativeValue with unitCode 'KGM'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint: Distribution"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <https://dpp-keystone.org/spec/v2/terms#carbonFootprintAbsolute>, <https://dpp-keystone.org/spec/v2/terms#environmentalFootprint>, <https://dpp-keystone.org/spec/v2/terms#carbonFootprint>;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:CarbonFootprintDeclaration.
oec:hasCarbonFootprintUse a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>;
    rdfs:comment "Lifecycle stage emissions from product use. gs1:QuantitativeValue with unitCode 'KGM'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint: Use Phase"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:CarbonFootprintDeclaration.
oec:hasCarbonFootprintEndOfLife a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>, oec:carbonFootprintTotal, <https://dpp-keystone.org/spec/v2/terms#carbonFootprintAbsolute>, <https://dpp-keystone.org/spec/v2/terms#environmentalFootprint>, <https://dpp-keystone.org/spec/v2/terms#carbonFootprint>;
    rdfs:comment "Lifecycle stage emissions from end-of-life and recycling. gs1:QuantitativeValue with unitCode 'KGM'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint: End of Life"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>, <https://dpp-keystone.org/spec/v2/terms#carbonFootprintAbsolute>, <https://dpp-keystone.org/spec/v2/terms#environmentalFootprint>, <https://dpp-keystone.org/spec/v2/terms#carbonFootprint>;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:CarbonFootprintDeclaration.
oec:carbonFootprintMethodology a owl:DatatypeProperty;
    rdfs:comment "URI of the methodology used (e.g. EN 45552, ISO 14067, PEF, GHG Protocol)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint Methodology"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:CarbonFootprintDeclaration.
oec:hasCarbonFootprintDeclaration a owl:ObjectProperty;
    rdfs:comment "Links a product to its carbon footprint declaration."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint Declaration"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#environmentalFootprint>;
    rdfs:range oec:CarbonFootprintDeclaration.
oec:RecyclabilityAssessment a owl:Class;
    rdfs:comment "An assessment of a product's recyclability. Different regulations express the same concept differently: PPWR uses letter grades A/B/C, the JRC textile methodology uses a 0-10 score, electronics WEEE uses a 0-1 rate. All three are optional; pick whichever your regulation requires."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Recyclability Assessment"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf schema:Observation;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch <http://data.europa.eu/m8g/Criterion>, <https://vocabulary.uncefact.org/untp/ConformityAssessment>.
oec:recyclabilityRate a owl:DatatypeProperty;
    rdfs:comment "Decimal fraction (0-1) of the product that can be recycled."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Recyclability Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:RecyclabilityAssessment.
oec:recyclabilityMethodology a owl:DatatypeProperty;
    rdfs:comment "URI of the recyclability methodology used (e.g. PEF, EN 15343, JRC textile preparatory study, PPWR Annex II)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Recyclability Methodology"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:RecyclabilityAssessment.
oec:recoverableRate a owl:DatatypeProperty;
    rdfs:seeAlso oec:recyclabilityRate, <https://w3id.org/eudpp#RecoverableRate>;
    rdfs:comment "Decimal fraction (0-1) of the product recoverable at end of life through any recovery operation (material recycling, energy recovery, backfilling)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Recoverable Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Annex I ecodesign parameter: recoverability is broader than recyclability (oec:recyclabilityRate covers material recycling only; recovery adds energy recovery and backfilling per Waste Framework Directive Art. 3(15)). No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:RecyclabilityAssessment.
oec:recyclingCollectionRate a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#RecyclingCollectionRate>;
    rdfs:comment "Decimal fraction (0-1) of products of this type actually collected for recycling, as reported for the applicable collection scheme."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Recycling Collection Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Annex I ecodesign parameter distinct from technical recyclability: a technically recyclable product may still have a low real-world collection rate. Cross-regulation (PPWR collection targets, Battery Regulation Art. 59, WEEE). No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:RecyclabilityAssessment.
oec:productToPackagingRatio a owl:DatatypeProperty;
    rdfs:seeAlso gs1:netWeight, <https://w3id.org/eudpp#ProductToPackagingRatio>;
    rdfs:comment "Ratio of product weight to total packaging weight, indicating packaging efficiency."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Product-to-Packaging Ratio"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Annex I ecodesign parameter; PPWR Annex IV minimisation assessments need the same figure. GS1 carries product and packaging weights separately (gs1:netWeight, gs1:packaging) but publishes no ratio term."@en;
    rdfs:range xsd:decimal;
    rdfs:domain gs1:Product.
oec:wasteGenerationAmount a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#WasteGenerationAmount>, <https://w3id.org/eudpp#HazardousWasteAmount>;
    rdfs:comment "Quantity of waste generated over the product life cycle per declared unit, expressed in kilograms."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Waste Generation Amount"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Annex I ecodesign parameter (waste generation, including hazardous fractions). Life-cycle scoped like oec:carbonFootprintTotal, not an EN 15804 coded indicator, so carried as its own property rather than an oec:ImpactIndicatorType entry."@en;
    rdfs:range xsd:decimal;
    rdfs:domain gs1:Product.
oec:packagingWasteAmount a owl:DatatypeProperty;
    rdfs:seeAlso oec:productToPackagingRatio, <https://w3id.org/eudpp#PackagingWasteAmount>;
    rdfs:comment "Quantity of packaging waste generated per declared unit, expressed in kilograms."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Packaging Waste Amount"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Annex I ecodesign parameter; PPWR reporting needs the same figure per packaging unit. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain gs1:Product.
oec:waterConsumption a owl:DatatypeProperty;
    rdfs:seeAlso oec:WDP, <https://w3id.org/eudpp#WaterConsumption>;
    rdfs:comment "Net fresh water consumed over the product life cycle per declared unit, expressed in cubic metres."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Water Consumption"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Annex I ecodesign parameter (water use). The EN 15804 indicator oec:WDP covers water-deprivation-weighted impact; this property carries the plain consumed volume the passport declares. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain gs1:Product.
oec:WDP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#wdp>;
    rdfs:label "Water (user) deprivation potential"@en;
    skos:notation "WDP".
oec:landUse a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#LandUse>;
    rdfs:comment "Land area occupied or transformed over the product life cycle per declared unit, expressed in square metres."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Land Use"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Annex I ecodesign parameter; EUDR geolocation (eudr:) covers plot provenance while this carries the quantitative footprint. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain gs1:Product.
oec:materialFootprint a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#MaterialFootprint>, <https://w3id.org/eudpp#ResourceConsumption>;
    rdfs:comment "Total raw material input mobilised over the product life cycle per declared unit, expressed in kilograms."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Material Footprint"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Annex I ecodesign parameter (resource use). Distinct from oec:hasMaterialComposition, which lists what is IN the product; the footprint counts what was consumed to make it. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain gs1:Product.
oec:EnergyEfficiency a owl:Class;
    rdfs:seeAlso schema:EUEnergyEfficiencyEnumeration;
    rdfs:comment "A product's energy efficiency declaration: A-G class, EPREL registration, consumption modes."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Energy Efficiency"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:EnergyConsumptionDetails;
    skos:narrowMatch schema:EUEnergyEfficiencyEnumeration.
oec:EnergyEfficiencyClass a owl:Class;
    rdfs:seeAlso schema:EnergyConsumptionDetails, schema:Class;
    rdfs:comment "A-G classification per EU Energy Labelling Regulation 2017/1369 and downstream delegated acts."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Energy Efficiency Class"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch schema:EUEnergyEfficiencyEnumeration, schema:EnergyEfficiencyEnumeration;
    owl:oneOf _:n3-3602.
_:n3-3602 rdf:first oec:EnergyClassA;
    rdf:rest _:n3-3603.
oec:EnergyClassA a oec:EnergyEfficiencyClass;
    rdfs:label "Class A"@en;
    skos:notation "A".
_:n3-3603 rdf:first oec:EnergyClassB;
    rdf:rest _:n3-3604.
oec:EnergyClassB a oec:EnergyEfficiencyClass;
    rdfs:label "Class B"@en;
    skos:notation "B".
_:n3-3604 rdf:first oec:EnergyClassC;
    rdf:rest _:n3-3605.
oec:EnergyClassC a oec:EnergyEfficiencyClass;
    rdfs:label "Class C"@en;
    skos:notation "C".
_:n3-3605 rdf:first oec:EnergyClassD;
    rdf:rest _:n3-3606.
oec:EnergyClassD a oec:EnergyEfficiencyClass;
    rdfs:label "Class D"@en;
    skos:notation "D".
_:n3-3606 rdf:first oec:EnergyClassE;
    rdf:rest _:n3-3607.
oec:EnergyClassE a oec:EnergyEfficiencyClass;
    rdfs:label "Class E"@en;
    skos:notation "E".
_:n3-3607 rdf:first oec:EnergyClassF;
    rdf:rest _:n3-3608.
oec:EnergyClassF a oec:EnergyEfficiencyClass;
    rdfs:label "Class F"@en;
    skos:notation "F".
_:n3-3608 rdf:first oec:EnergyClassG;
    rdf:rest rdf:nil.
oec:EnergyClassG a oec:EnergyEfficiencyClass;
    rdfs:label "Class G"@en;
    skos:notation "G".
oec:hasAnnualEnergyConsumption a owl:ObjectProperty;
    rdfs:comment "Annual energy consumption. gs1:QuantitativeValue with unitCode 'KWH'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Annual Energy Consumption"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:EnergyEfficiency.
oec:hasPowerConsumptionOn a owl:ObjectProperty;
    rdfs:comment "Power consumed in active operating mode. gs1:QuantitativeValue with unitCode 'WTT'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Power Consumption: On Mode"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:EnergyEfficiency.
oec:hasPowerConsumptionStandby a owl:ObjectProperty;
    rdfs:comment "Power consumed in standby. gs1:QuantitativeValue with unitCode 'WTT'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Power Consumption: Standby Mode"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:EnergyEfficiency.
oec:hasPowerConsumptionOff a owl:ObjectProperty;
    rdfs:comment "Power consumed in off mode. gs1:QuantitativeValue with unitCode 'WTT'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Power Consumption: Off Mode"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#power>, <https://dpp-keystone.org/spec/v2/terms#ratedPower>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:EnergyEfficiency.
oec:eprelRegistrationNumber a owl:DatatypeProperty;
    rdfs:comment "EU EPREL (European Product Registry for Energy Labelling) registration number."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPREL Registration Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch gs1:regulatoryReferenceNumber, schema:serialNumber;
    rdfs:range xsd:string;
    rdfs:domain oec:EnergyEfficiency.
oec:eprelProductUrl a owl:DatatypeProperty;
    rdfs:comment "URL of the product's EPREL public page."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPREL Product URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EnergyEfficiency.
oec:hasEnergyEfficiency a owl:ObjectProperty;
    rdfs:seeAlso schema:energyEfficiencyScaleMax, schema:energyEfficiencyScaleMin, schema:hasEnergyConsumptionDetails, <urn:samm:io.BatteryPass.Performance:1.2.1#roundTripEfficiencyFade>, <urn:samm:io.BatteryPass.Performance:1.2.1#roundTripEfficiencyAt50PercentCycleLife>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Energy Efficiency"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:narrowMatch <urn:samm:io.BatteryPass.Performance:1.2.1#remainingRoundTripEnergyEfficiency>, <urn:samm:io.BatteryPass.Performance:1.2.1#roundTripEfficiencyFade>, <urn:samm:io.BatteryPass.Performance:1.2.1#roundTripEfficiencyAt50PercentCycleLife>, <https://dpp-keystone.org/spec/v2/terms#roundTripEfficiencyAt50Cycles>, <urn:samm:io.BatteryPass.Performance:1.2.1#stateOfCertifiedEnergy>, <https://dpp-keystone.org/spec/v2/terms#roundTripEfficiencyInitial>;
    rdfs:range oec:EnergyEfficiency.
oec:EndOfLifeProgram a owl:Class;
    rdfs:comment "A take-back / collection / dismantling program operating across PPWR, WEEE, Battery, Textile take-back, and ELV. Distinct from EPR registration: EPR is the producer's compliance registration; this is the consumer-facing program with collection points, refunds, and dismantling guides."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "End-of-Life Program"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en.
oec:takeBackUrl a owl:DatatypeProperty;
    rdfs:seeAlso schema:merchantReturnLink;
    rdfs:comment "URL of the consumer-facing take-back program landing page."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Take-Back URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:closeMatch schema:merchantReturnLink;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EndOfLifeProgram.
oec:takeBackIncentive a owl:DatatypeProperty;
    rdfs:comment "Free-text description of any consumer incentive (refund, credit, replacement)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Take-Back Incentive"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range rdf:langString;
    rdfs:domain oec:EndOfLifeProgram.
oec:collectionPointDirectoryUrl a owl:DatatypeProperty;
    rdfs:seeAlso gs1:referencedFileURL;
    rdfs:comment "URL of a directory of physical collection points."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Collection Point Directory URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch gs1:referencedFileURL, schema:url;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EndOfLifeProgram.
oec:dismantlingGuideUrl a owl:DatatypeProperty;
    rdfs:comment "URL of the public dismantling / repair guide for end-of-life processors."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Dismantling Guide URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EndOfLifeProgram.
oec:hasEndOfLifeProgram a owl:ObjectProperty;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "End-of-Life Program"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range oec:EndOfLifeProgram.
oec:HazardSignalWord a owl:Class;
    rdfs:comment "CLP Regulation signal word: Danger or Warning."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Signal Word"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    owl:oneOf _:n3-3609.
_:n3-3609 rdf:first oec:HazardDanger;
    rdf:rest _:n3-3610.
oec:HazardDanger a oec:HazardSignalWord;
    rdfs:label "Danger"@en;
    skos:notation "Danger".
_:n3-3610 rdf:first oec:HazardWarning;
    rdf:rest rdf:nil.
oec:HazardWarning a oec:HazardSignalWord;
    rdfs:label "Warning"@en;
    skos:notation "Warning".
oec:hasHazardSignalWord a owl:ObjectProperty;
    rdfs:comment "CLP Regulation 1272/2008 signal word: Danger or Warning."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Signal Word"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range oec:HazardSignalWord;
    rdfs:domain oec:HazardousSubstance.
oec:hazardPictogramCode a owl:DatatypeProperty;
    rdfs:comment "CLP/GHS pictogram code (GHS01..GHS09). Set-valued: a substance can carry multiple pictograms."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Pictogram Code"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:hazardStatement a owl:DatatypeProperty;
    rdfs:comment "CLP H-statement code (e.g. H315, H319). Set-valued: a substance can carry multiple H-statements."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Statement (H-statement)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:precautionaryStatement a owl:DatatypeProperty;
    rdfs:comment "CLP P-statement code (e.g. P101, P280). Set-valued."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Precautionary Statement (P-statement)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:repairInformationPortalUrl a owl:DatatypeProperty;
    rdfs:comment "URL of the manufacturer's public repair information portal as required by EU Right-to-Repair Directive 2024/1799 Article 4: covers spare-parts catalogue, dismantling guides, software updates available to independent repairers."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2024/1799>;
    rdfs:label "Repair Information Portal URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:RepairabilityInfo.
oec:RepairProvider a owl:Class;
    rdfs:comment "An authorised repair provider for a product. Supports the European online platform for repair (Article 7 of Directive 2024/1799) and manufacturer-published repair networks."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Provider"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:AutoRepair, schema:MotorcycleRepair.
oec:hasRepairProvider a owl:ObjectProperty;
    rdfs:comment "Links a product to one or more authorised repair providers."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Provider"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:provider;
    rdfs:range oec:RepairProvider.
oec:repairProviderName a owl:DatatypeProperty;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Provider Name"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:provider;
    rdfs:range xsd:string;
    rdfs:domain oec:RepairProvider.
oec:repairProviderUrl a owl:DatatypeProperty;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Provider URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:RepairProvider.
oec:hasDueDiligenceRegulationContext a owl:ObjectProperty;
    rdfs:comment "The specific regulation against which a due diligence statement is asserted: Battery Annex X (Reg. 2023/1542), EUDR Article 9 (Reg. 2023/1115), CSDDD (Dir. 2024/1760), Forced Labour Regulation (2024/3015), OECD Conflict Minerals, etc. Same oec:DueDiligenceReport shape; different regulatory anchor."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Due Diligence Regulation Context"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <http://data.europa.eu/m8g/isDerivedFrom>;
    skos:closeMatch <https://vocabulary.uncefact.org/untp/regulation>, <https://vocabulary.uncefact.org/untp/referenceRegulation>;
    rdfs:range gs1:RegulatoryInformation;
    rdfs:domain oec:DueDiligenceReport.
oec:supplyChainTransparencyUrl a owl:DatatypeProperty;
    rdfs:comment "URL of a public supply-chain map / transparency endpoint (CSDDD Article 16, ESPR Article 7)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Supply-Chain Transparency URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DueDiligenceReport.
oec:forcedLabourFreeAssertion a owl:DatatypeProperty;
    rdfs:comment "Boolean assertion that the product is free of forced labour per EU Regulation 2024/3015. Substantiate with dueDiligenceReport URL + thirdPartyAssurance evidence."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/3015>;
    rdfs:label "Forced-Labour-Free Assertion"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:boolean;
    rdfs:domain oec:DueDiligenceReport.
oec:isStrategicRawMaterial a owl:DatatypeProperty;
    rdfs:comment "Boolean flag: material is on the EU Strategic Raw Materials list per CRMA Annex I (2024/1252). Strategic ⊂ Critical: every strategic raw material is also a critical raw material, but not vice versa."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1252>;
    rdfs:label "Is Strategic Raw Material"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <https://w3id.org/eudpp#isCriticalRawMaterial>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#isCriticalRawMaterial>, <https://dpp-keystone.org/spec/v2/terms#criticalRawMaterials>;
    rdfs:range xsd:boolean;
    rdfs:domain oec:MaterialComposition;
    skos:broader oec:isCriticalRawMaterial.
oec:crmListVersion a owl:DatatypeProperty;
    rdfs:comment "Version reference of the EU Critical Raw Materials list against which the isCriticalRawMaterial / isStrategicRawMaterial flags were determined (e.g. CRMA-2024 Annex II / Annex I). The list is updated periodically by the Commission."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "CRM List Version"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#dppSchemaVersion>, <https://vocabulary.uncefact.org/untp/version>, <https://dpp-keystone.org/spec/v2/terms#versionNumber>;
    rdfs:range xsd:string;
    rdfs:domain oec:MaterialComposition.
oec:remanufacturingDate a owl:DatatypeProperty;
    rdfs:seeAlso <https://gs1-epcis-reg.org/rail/voc/data#itemReconditioningDate>;
    rdfs:comment "Date on which a product was remanufactured or refurbished and re-released as fit for purpose. Cross-sector: applies to any DPP-covered product that re-enters service after refurbishment (rail rolling stock, batteries, electronics, textiles)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Remanufacturing / refurbishment date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "No upstream equivalent: GS1 Web Vocabulary covers production dates but not refurbishment; schema.org has schema:productionDate / schema:purchaseDate but no remanufacture/reconditioning date; SEMICeu does not cover product lifecycle dates."@en;
    skos:narrowMatch <https://gs1-epcis-reg.org/rail/voc/data#itemReconditioningDate>;
    rdfs:range xsd:dateTime;
    rdfs:domain schema:Product.
oec:EnvironmentalProductDeclaration a owl:Class;
    rdfs:seeAlso oec:EmissionsPerformance, oec:CarbonFootprintDeclaration, <https://dpp-keystone.org/spec/v2/terms#EPDBlock>, <https://w3id.org/eudpp#EPDStudy>, <https://w3id.org/eudpp#EPDDocument>;
    rdfs:comment "A type III environmental declaration per EN 15804:2012+A2:2019 / ISO 14025,\nreporting life-cycle environmental impact indicators broken down by lifecycle module."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Environmental Product Declaration"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf schema:Certification;
    skos:note "Required extension: EN 15804 EPDs carry a full impact-indicator set with modular\nlifecycle breakdown not covered by GS1 Web Vocabulary, schema.org, or SEMICeu. Aligned with\nDPP Keystone dppk:EPDBlock (peer DPP profile). For a single aggregate carbon figure use\noec:carbonFootprintTotal; for a 5-stage carbon breakdown use oec:CarbonFootprintDeclaration."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>;
    skos:exactMatch <https://w3id.org/eudpp#EPDDocument>.
oec:ImpactIndicatorResult a owl:Class;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#ImpactValues>, <https://w3id.org/eudpp#LCAResult>;
    rdfs:comment "One environmental impact indicator (e.g. Global Warming Potential) reported within\nan EPD: its indicator type, declared unit, aggregate value, and optional per-lifecycle-module values."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Impact Indicator Result"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 impact-indicator result. Anchored to DPP Keystone dppk:ImpactValues (peer DPP profile)."@en;
    skos:broadMatch <https://w3id.org/eudpp#ImpactCategoryIndicator>, <https://w3id.org/eudpp#LcaResult>;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#ImpactValues>.
oec:LifecycleStageResult a owl:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#LCIAModuleValue>;
    rdfs:comment "The value of an impact indicator for a single EN 15804 lifecycle module (e.g. A1, B6, C3, D)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Lifecycle Stage Result"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 modular lifecycle value. Pairs an oec:LifecycleStage code with a decimal value in the indicator's declared unit."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>, <https://w3id.org/eudpp#LcaResult>.
oec:ImpactIndicatorType a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#EN15804ImpactIndicator>, <https://w3id.org/eudpp#LCIAImpactIndicator>;
    rdfs:comment "Controlled list of EN 15804:2012+A2:2019 environmental impact indicators."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Impact Indicator Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804+A2 core impact category set."@en;
    skos:broadMatch <https://w3id.org/eudpp#ImpactType>, <https://w3id.org/eudpp#ImpactCategory>.
oec:GWPTotal a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#gwp>;
    rdfs:label "Global Warming Potential, total"@en;
    skos:notation "GWP-total".
oec:GWPFossil a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#gwpF>;
    rdfs:label "Global Warming Potential, fossil"@en;
    skos:notation "GWP-fossil".
oec:GWPBiogenic a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#gwpB>;
    rdfs:label "Global Warming Potential, biogenic"@en;
    skos:notation "GWP-biogenic".
oec:GWPLuluc a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#gwpLuluc>;
    rdfs:label "Global Warming Potential, land use and land-use change"@en;
    skos:notation "GWP-luluc".
oec:ODP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#odp>;
    rdfs:label "Depletion potential of the stratospheric ozone layer"@en;
    skos:notation "ODP".
oec:AP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#ap>;
    rdfs:label "Acidification potential"@en;
    skos:notation "AP".
oec:EPFreshwater a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#epF>;
    rdfs:label "Eutrophication potential, freshwater"@en;
    skos:notation "EP-freshwater".
oec:EPMarine a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#epM>;
    rdfs:label "Eutrophication potential, marine"@en;
    skos:notation "EP-marine".
oec:EPTerrestrial a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#epT>;
    rdfs:label "Eutrophication potential, terrestrial"@en;
    skos:notation "EP-terrestrial".
oec:POCP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#pocp>;
    rdfs:label "Formation potential of tropospheric ozone"@en;
    skos:notation "POCP".
oec:ADPElements a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#adpe>;
    rdfs:label "Abiotic depletion potential, minerals and metals"@en;
    skos:notation "ADP-minerals&metals".
oec:ADPFossil a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#adpf>;
    rdfs:label "Abiotic depletion potential, fossil resources"@en;
    skos:notation "ADP-fossil".
oec:LifecycleStage a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#LifeCycleModule>;
    rdfs:comment "Controlled list of EN 15804 lifecycle modules (product, construction, use, end-of-life, and benefits beyond the system boundary)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Lifecycle Stage"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 modular lifecycle stages."@en.
oec:StageA1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a1>;
    rdfs:label "A1 Raw material supply"@en;
    skos:notation "A1".
oec:StageA2 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a2>;
    rdfs:label "A2 Transport to manufacturer"@en;
    skos:notation "A2".
oec:StageA3 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a3>;
    rdfs:label "A3 Manufacturing"@en;
    skos:notation "A3".
oec:StageA4 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a4>;
    rdfs:label "A4 Transport to site"@en;
    skos:notation "A4".
oec:StageA5 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a5>;
    rdfs:label "A5 Installation"@en;
    skos:notation "A5".
oec:StageB1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b1>;
    rdfs:label "B1 Use"@en;
    skos:notation "B1".
oec:StageB2 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b2>;
    rdfs:label "B2 Maintenance"@en;
    skos:notation "B2".
oec:StageB3 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b3>;
    rdfs:label "B3 Repair"@en;
    skos:notation "B3".
oec:StageB4 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b4>;
    rdfs:label "B4 Replacement"@en;
    skos:notation "B4".
oec:StageB5 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b5>;
    rdfs:label "B5 Refurbishment"@en;
    skos:notation "B5".
oec:StageB6 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b6>;
    rdfs:label "B6 Operational energy use"@en;
    skos:notation "B6".
oec:StageB7 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b7>;
    rdfs:label "B7 Operational water use"@en;
    skos:notation "B7".
oec:StageC1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#c1>;
    rdfs:label "C1 Deconstruction / demolition"@en;
    skos:notation "C1".
oec:StageC2 a oec:LifecycleStage;
    rdfs:label "C2 Transport to waste processing"@en;
    skos:notation "C2".
oec:StageC3 a oec:LifecycleStage;
    rdfs:label "C3 Waste processing"@en;
    skos:notation "C3".
oec:StageC4 a oec:LifecycleStage;
    rdfs:label "C4 Disposal"@en;
    skos:notation "C4".
oec:StageD a oec:LifecycleStage;
    rdfs:label "D Benefits and loads beyond the system boundary"@en;
    skos:notation "D".
oec:hasEnvironmentalProductDeclaration a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#epd>;
    rdfs:comment "Links a product to its EN 15804 environmental product declaration."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Environmental Product Declaration"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 EPD link. Anchored to DPP Keystone dppk:epd (peer DPP profile)."@en;
    rdfs:range oec:EnvironmentalProductDeclaration;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#epd>.
oec:epdRegistrationNumber a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#registrationNumber>;
    rdfs:comment "Registration / declaration number assigned by the EPD programme operator."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPD Registration Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    skos:broadMatch gs1:regulatoryReferenceNumber;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:productCategoryRules a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#PCR>, <https://w3id.org/eudpp#PEFCR>, <https://w3id.org/eudpp#referenceToPCR>, <https://w3id.org/eudpp#referenceToPEFCR>;
    rdfs:comment "URI of the Product Category Rules (PCR) or Product Environmental Footprint Category Rules (PEFCR) document under which the environmental declaration was produced."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Product Category Rules"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ISO 14025 / EN 15804 EPD metadata: results are only comparable within one PCR/PEFCR, so the passport must say which one applies. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:narrowMatch <https://w3id.org/eudpp#referenceToPEFCR>;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdProgramOperator a owl:DatatypeProperty;
    rdfs:comment "Name of the EPD programme operator (e.g. EPD International, IBU, EcoPlatform)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPD Programme Operator"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#operatorInformation>;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdStandard a owl:DatatypeProperty;
    rdfs:comment "Reference standard and product category rules version used (e.g. EN 15804+A2)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPD Reference Standard"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdValidUntil a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#expiryDate>;
    rdfs:comment "Date until which the EPD is valid."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPD Valid Until"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    skos:broadMatch schema:validThrough;
    rdfs:range xsd:date;
    rdfs:domain oec:EnvironmentalProductDeclaration;
    skos:exactMatch schema:validUntil.
oec:hasImpactIndicator a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#indicator>;
    rdfs:comment "An environmental impact indicator result reported within the EPD."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Impact Indicator"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 impact indicator. Anchored to DPP Keystone dppk:indicator (peer DPP profile)."@en;
    rdfs:range oec:ImpactIndicatorResult;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:hasIndicatorType a owl:ObjectProperty;
    rdfs:comment "The EN 15804 impact category this result reports (e.g. oec:GWPTotal)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Indicator Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804+A2 impact category selector."@en;
    rdfs:range oec:ImpactIndicatorType;
    rdfs:domain oec:ImpactIndicatorResult.
oec:indicatorUnit a owl:DatatypeProperty;
    rdfs:comment "Declared unit for this indicator (e.g. kg CO2 eq, kg CFC11 eq, mol H+ eq, m3 world eq deprived)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Indicator Unit"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 declared characterisation unit for the indicator."@en;
    skos:closeMatch gs1:unitCode;
    rdfs:range xsd:string;
    rdfs:domain oec:ImpactIndicatorResult.
oec:indicatorTotalValue a owl:DatatypeProperty;
    rdfs:seeAlso schema:value, gs1:value;
    rdfs:comment "Aggregate value of the indicator across the declared lifecycle modules, in the declared unit."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Indicator Total Value"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 aggregate indicator value. Use oec:hasLifecycleStageResult for the modular breakdown."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:ImpactIndicatorResult.
oec:hasLifecycleStageResult a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>;
    rdfs:comment "A single EN 15804 module value contributing to this indicator."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Lifecycle Stage Result"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 modular lifecycle breakdown."@en;
    rdfs:range oec:LifecycleStageResult;
    rdfs:domain oec:ImpactIndicatorResult.
oec:hasLifecycleStage a owl:ObjectProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#hasLifeCycleStage>;
    rdfs:comment "The EN 15804 lifecycle module this value applies to (e.g. oec:StageA1)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Lifecycle Stage"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 module selector."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#lifecycleStage>;
    rdfs:range oec:LifecycleStage;
    rdfs:domain oec:LifecycleStageResult.
oec:stageValue a owl:DatatypeProperty;
    rdfs:seeAlso schema:value, gs1:value, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingPowerCapabilityValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#numberOfFullCyclesValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingCapacityValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#capacityThroughputValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#internalResistanceIncreaseValue>;
    rdfs:comment "Indicator value for this lifecycle module, in the indicator's declared unit."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Stage Value"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 modular value. DPP Keystone expresses these as flat dppk:a1..dppk:d properties; here normalised as oec:LifecycleStage + oec:stageValue pairs."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>, <http://data.europa.eu/m8g/value>, <urn:samm:io.BatteryPass.Performance:1.2.1#evolutionOfSelfDischargeValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#energyThroughputValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingEnergyValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#capacityFadeValue>;
    rdfs:range xsd:decimal;
    rdfs:domain oec:LifecycleStageResult.
<https://ref.openepcis.io/extensions/eu/electronics/> a owl:Ontology;
    dcterms:title "OpenEPCIS Electronics Vocabulary"@en;
    dcterms:description "Electronics-specific vocabulary extending GS1 Web Vocabulary for Digital Product Passports.\n\nOpenEPCIS DPP-Ready: The Universal DPP Platform - harmonizing GS1, UNTP, and CIRPASS-2 standards.\n\nThis vocabulary provides comprehensive coverage for electronic and electrical equipment under:\n- EU ESPR 2024/1781 framework (computers, servers, smartphones, tablets)\n- French Repairability Index (Indice de Réparabilité) - 5 criteria, 100-point scoring\n- EU Right to Repair 2025 - A-E repairability grades\n- WEEE Directive 2012/19/EU - 6 equipment categories\n- RoHS Directive 2011/65/EU - Restricted hazardous substances\n- EU Energy Labeling 2019/2021 - A-G efficiency classes, EPREL registry\n- CIRPASS-2 electronics pilots - Multi-component DPP tracking\n\nStandards Alignment:\n- GS1 Web Vocabulary (native foundation)\n- UN Transparency Protocol (UNTP) alignment via SKOS mapping (skos:exactMatch / skos:closeMatch)\n- IEC 62474 material declarations\n- IEC 82474-1:2025 material efficiency\n- ISO/IEC 12207 software lifecycle\n- ISO/IEC 14764 software maintenance\n\nGS1 Properties to Use (not redefined here):\n- gs1:gtin - Global Trade Item Number\n- gs1:productName - Product name\n- gs1:brand - Brand information\n- gs1:productionDate - Manufacturing date\n- gs1:countryOfOrigin - Country of manufacture\n- gs1:manufacturer - Manufacturer organization\n- gs1:warranty / gs1:WarrantyPromise - Warranty information\n- gs1:certification / gs1:CertificationDetails - Certifications\n- gs1:regulatoryInformation - Regulatory compliance (RoHS, CE, etc.)\n- gs1:netWeight / gs1:grossWeight - Product weight\n\nEPCIS 2.0 Extension Declaration:\nGS1-Extensions: euelec=https://ref.openepcis.io/extensions/eu/electronics/\n\nExtension Governance:\nThis vocabulary extends GS1 Web Vocabulary only where no equivalent term exists.\nEach extension term includes dcterms:source, skos:note, and rdfs:seeAlso where applicable.\nAll ratio/fraction properties use 0-1 decimal scale (e.g., 0.45 = 45%)."@en;
    dcterms:creator "OpenEPCIS";
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0>;
    dcterms:created "2025-02-02"^^xsd:date;
    dcterms:modified "2026-06-19"^^xsd:date;
    owl:versionInfo "0.9.9";
    owl:versionIRI <https://ref.openepcis.io/extensions/eu/electronics/0.9.9>;
    <http://purl.org/vocab/vann/preferredNamespacePrefix> "euelec";
    <http://purl.org/vocab/vann/preferredNamespaceUri> "https://ref.openepcis.io/extensions/eu/electronics/";
    rdfs:seeAlso <https://ref.gs1.org/voc/>, gs1:CertificationDetails, <https://ref.gs1.org/standards/epcis/>, <https://eur-lex.europa.eu/eli/reg/2024/1781>, <https://ref.gs1.org/standards/>, <https://untp.unece.org/docs/specification/>, <https://www.ecologie.gouv.fr/indice-reparabilite>.
<https://ref.openepcis.io/extensions/eu/electronics/RepairabilityIndex> a owl:Class;
    rdfs:seeAlso oec:RepairabilityInfo;
    rdfs:comment "French Repairability Index (Indice de Réparabilité) assessment using the official\n5-criteria, 100-point scoring methodology. The score is displayed to consumers as 0-10 scale ;\n    dcterms:source <https://www.ecologie.gouv.fr/indice-reparabilite> ;\n    skos:note \"Repairability concept per the French Repairability Index (Indice de Réparabilité) and the EU Right to Repair. No GS1, SEMICeu, or schema.org equivalent.\"@en .\n\nFive Criteria (20 points each):\n1. Documentation - Availability of repair documentation\n2. Disassembly - Ease of disassembly and tools required\n3. Spare Parts Availability - Duration and access to spare parts\n4. Spare Parts Pricing - Ratio of part prices to product price\n5. Product Specific - Category-specific criteria (e.g., software support for smartphones)\n\nTotal score (0-100) is converted to display score (0-10) for consumer labeling."@en;
    dcterms:source <https://www.ecologie.gouv.fr/indice-reparabilite>;
    rdfs:label "Repairability Index"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: The French Repairability Index uses a specific 5-criteria methodology\nthat is not available in GS1 Web Vocabulary. Links to oec:RepairabilityInfo for base patterns."@en;
    skos:broadMatch <https://w3id.org/eudpp#Durability>.
<https://ref.openepcis.io/extensions/eu/electronics/RepairCriterion> a owl:Class;
    rdfs:seeAlso <http://data.europa.eu/m8g/Criterion>, <http://data.europa.eu/m8g/Constraint>, <https://vocabulary.uncefact.org/untp/Criterion>, schema:Rating;
    rdfs:comment "An individual criterion score within the French Repairability Index."@en;
    dcterms:source <https://www.ecologie.gouv.fr/indice-reparabilite>;
    rdfs:label "Repair Criterion"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    rdfs:subClassOf <http://data.europa.eu/m8g/Criterion>;
    skos:note "A RepairCriterion is a specific kind of cccev:Criterion (EU SEMICeu CCCEV): the five Repairability-Index criteria (Documentation, Disassembly, SparePartsAvailability, SparePartsPricing, ProductSpecific) each scored against an InformationConcept within the broader Repairability Requirement. Modelled as rdfs:subClassOf rather than owl:equivalentClass because cccev:Criterion is broader and covers any conformity-evaluation criterion. CCCEV is the EU foundation that JTC 24 / CIRPASS-2 lean on for conformity / scoring."@en;
    skos:broadMatch <http://data.europa.eu/m8g/Criterion>.
<https://ref.openepcis.io/extensions/eu/electronics/SoftwareSupport> a owl:Class;
    rdfs:seeAlso <https://www.iso.org/standard/43447.html>, <https://dpp-keystone.org/spec/v2/terms#softwareUpdatePolicy>;
    rdfs:comment "Operating system and firmware support information including update periods,\nsecurity patch availability, and end-of-support dates. Critical for electronics lifecycle\nand repairability assessments per ESPR delegated acts.\n\nDesigned following ISO/IEC 12207 (software lifecycle) and ISO/IEC 14764 (software maintenance)\npatterns as a potential contribution to UNTP v1.0+."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Software Support"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Software lifecycle tracking per ISO/IEC 12207. Designed as potential UNTP extension.\nUNTP v0.6 does not yet include software support properties, making this a candidate for\ncontribution to UNTP v1.0+. Aligns approximately with DPP Keystone dppk:softwareUpdatePolicy."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#softwareUpdatePolicy>.
<https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency> a owl:Class;
    rdfs:seeAlso oec:PerformanceInfo, oec:EnergyEfficiency, schema:EUEnergyEfficiencyEnumeration;
    rdfs:comment "EU Energy Label data including efficiency class (A-G), power consumption metrics,\nand EPREL registry information per EU Energy Labeling Regulation 2019/2021."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "Energy Efficiency"@en;
    rdfs:subClassOf oec:EnergyEfficiency;
    skos:note "Required extension: GS1 provides performance information patterns but lacks specific\nEU Energy Label properties (A-G classes, EPREL registration) required for electronics."@en;
    skos:broadMatch schema:EnergyConsumptionDetails, schema:EnergyEfficiencyEnumeration.
<https://ref.openepcis.io/extensions/eu/electronics/ComponentBOM> a owl:Class;
    rdfs:comment "Bill of Materials for multi-component electronics supporting CIRPASS-2 nested DPP\nrequirements. Links individual components to their own Digital Product Passports."@en;
    dcterms:source <https://cirpassproject.eu/>;
    rdfs:label "Component Bill of Materials"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: CIRPASS-2 electronics pilots require multi-component tracking\nwhere each component (battery, display, etc.) may have its own DPP. Aligned with UNTP\nlinkedProduct pattern."@en.
<https://ref.openepcis.io/extensions/eu/electronics/WEEECompliance> a owl:Class;
    rdfs:seeAlso oec:CircularityPerformance, gs1:RegulatoryInformation, gs1:regulatoryInformation;
    rdfs:comment "Waste Electrical and Electronic Equipment (WEEE) Directive compliance information\nincluding equipment category, registration number, and collection scheme."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "WEEE Compliance"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    rdfs:subClassOf oec:ExtendedProducerResponsibility;
    skos:note "Required extension: WEEE has 6 specific equipment categories not in GS1 vocabulary.\nUse gs1:regulatoryInformation for general compliance, this class for WEEE-specific data."@en;
    skos:broadMatch gs1:RegulatoryInformation.
<https://ref.openepcis.io/extensions/eu/electronics/RoHSCompliance> a owl:Class;
    rdfs:seeAlso oec:SubstanceOfConcern, schema:Certification, gs1:regulatoryInformation;
    rdfs:comment "Restriction of Hazardous Substances (RoHS) Directive compliance information\nincluding compliance status and applicable exemptions."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2011/65/oj>;
    rdfs:label "RoHS Compliance"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: RoHS has specific exemption categories not in GS1 vocabulary.\nUse gs1:regulatoryInformation for general compliance, this class for RoHS-specific data."@en;
    skos:broadMatch schema:Certification, gs1:RegulatoryInformation.
<https://ref.openepcis.io/extensions/eu/electronics/ElectronicDevice> a owl:Class;
    rdfs:seeAlso gs1:Product, schema:Product, <https://dpp-keystone.org/spec/v2/terms#Component>;
    rdfs:comment "A finished item of electrical and electronic equipment (EEE) as defined in\nWEEE Directive 2012/19/EU Article 3(1)(a): equipment which is dependent on electric currents or\nelectromagnetic fields in order to work. This is the product an electronics Digital Product Passport\ndescribes, as distinct from euelec:ElectronicComponent, which is a part inside it."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Electronic Device"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    rdfs:subClassOf gs1:Product;
    skos:note "Required extension: gs1:Product and schema:Product cover any trade item. Neither\nscopes the EEE definition that decides whether the WEEE and RoHS obligations and the ESPR\nelectronics delegated acts apply at all, and the module needs that scope as a distinct SHACL target\nclass so device-level and component-level shapes do not both fire on every gs1:Product."@en;
    skos:broadMatch gs1:Product, schema:Product;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#ElectronicDevice>.
<https://ref.openepcis.io/extensions/eu/electronics/ElectronicComponent> a owl:Class;
    rdfs:seeAlso gs1:Product, <https://dpp-keystone.org/spec/v2/terms#Component>, <https://ref.openepcis.io/extensions/eu/electronics/ComponentType>;
    rdfs:comment "A part inside an item of electrical and electronic equipment that is listed in the\ncomponent bill of materials: battery, display, mainboard, power supply, and so on. A component may\ncarry its own nested Digital Product Passport (CIRPASS-2 multi-component pattern)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Electronic Component"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    rdfs:subClassOf gs1:Product;
    skos:note "Required extension: the ESPR electronics delegated acts and the CIRPASS-2 electronics\npilots require the parts of a device to be addressable separately from the device itself (spare-part\navailability, replaceability, nested component passports). GS1, SEMICeu and schema.org have a single\nundifferentiated product/trade-item class, so the device/component distinction has no upstream term\nto reuse."@en;
    skos:broadMatch gs1:Product, schema:Product;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#Component>.
<https://ref.openepcis.io/extensions/eu/electronics/ComponentType> a owl:Class;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#Component>;
    rdfs:comment "Types of replaceable components in electronic devices."@en;
    dcterms:source <https://cirpassproject.eu/>;
    rdfs:label "Component Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    owl:oneOf _:n3-3650.
