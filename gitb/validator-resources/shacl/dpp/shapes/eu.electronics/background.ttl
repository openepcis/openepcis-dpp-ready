    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#postConsumerRecycledMaterialComposition>, <https://dpp-keystone.org/spec/v2/terms#preConsumerRecycledMaterialComposition>, gs1:textileMaterialContent, <https://dpp-keystone.org/spec/v2/terms#fibreComposition>, <https://dpp-keystone.org/spec/v2/terms#packagingMaterialCompositionQuantity>, gs1:textileMaterialDescription, gs1:packagingMaterial, gs1:packagingMaterialType, <https://dpp-keystone.org/spec/v2/terms#packagingMaterialType>, <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledMaterial>, gs1:upperMaterialType;
