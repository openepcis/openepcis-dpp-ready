    rdfs:comment "Date until which security updates will be provided."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Security Update End Date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Candidate for UNTP contribution: softwareSecurityEndDate."@en;
    skos:broadMatch schema:endDate;
    rdfs:range xsd:date;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/SoftwareSupport>.
<https://ref.openepcis.io/extensions/eu/electronics/featureUpdateEndDate> a owl:DatatypeProperty;
    rdfs:comment "Date until which feature/OS updates will be provided."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Feature Update End Date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Software / firmware support-lifecycle concept per ISO/IEC 12207. Candidate for upstream UNTP contribution; no GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:date;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/SoftwareSupport>.
<https://ref.openepcis.io/extensions/eu/electronics/hasSecuritySupportYears> a owl:ObjectProperty;
    rdfs:comment "Number of years of security update support. Use gs1:QuantitativeValue with unitCode 'ANN'."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Security Support Years"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Candidate for UNTP contribution: softwareSupportPeriod."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/SoftwareSupport>.
<https://ref.openepcis.io/extensions/eu/electronics/hasFeatureSupportYears> a owl:ObjectProperty;
    rdfs:comment "Number of years of feature update support. Use gs1:QuantitativeValue with unitCode 'ANN'."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Feature Support Years"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Software / firmware support-lifecycle concept per ISO/IEC 12207. Candidate for upstream UNTP contribution; no GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/SoftwareSupport>.
<https://ref.openepcis.io/extensions/eu/electronics/updateChannel> a owl:DatatypeProperty;
    rdfs:comment "URL or method for obtaining software updates (OTA, website, etc.)."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Update Channel"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Software / firmware support-lifecycle concept per ISO/IEC 12207. Candidate for upstream UNTP contribution; no GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch schema:availableChannel, <http://data.europa.eu/m8g/hasChannel>;
    rdfs:range xsd:anyURI;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/SoftwareSupport>.
<https://ref.openepcis.io/extensions/eu/electronics/latestUpdateDate> a owl:DatatypeProperty;
    rdfs:comment "Date of the most recent software/firmware update."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Latest Update Date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Software / firmware support-lifecycle concept per ISO/IEC 12207. Candidate for upstream UNTP contribution; no GS1, SEMICeu, or schema.org equivalent."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.Performance:1.2.1#lastUpdate>;
    rdfs:range xsd:date;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/SoftwareSupport>.
<https://ref.openepcis.io/extensions/eu/electronics/hasEnergyEfficiency> a owl:ObjectProperty;
    rdfs:seeAlso schema:energyEfficiencyScaleMax, schema:hasEnergyEfficiencyCategory, oec:hasEnergyEfficiency, schema:hasEnergyConsumptionDetails;
    rdfs:comment "EU Energy Label information."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "Energy Efficiency"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/hasEnergyEfficiencyClass> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasEnergyEfficiencyClass, schema:hasEnergyEfficiencyCategory, schema:hasEnergyConsumptionDetails;
    rdfs:comment "EU Energy Label class (A-G)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "Energy Efficiency Class"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch schema:hasEnergyEfficiencyCategory;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiencyClass>;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>;
    skos:exactMatch oec:hasEnergyEfficiencyClass.
<https://ref.openepcis.io/extensions/eu/electronics/hasAnnualEnergyConsumption> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasAnnualEnergyConsumption;
    rdfs:comment "Annual energy consumption in kWh. Use gs1:QuantitativeValue with unitCode 'KWH'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "Annual Energy Consumption"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>;
    skos:exactMatch oec:hasAnnualEnergyConsumption.
<https://ref.openepcis.io/extensions/eu/electronics/hasPowerConsumptionOn> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasPowerConsumptionOn;
    rdfs:comment "Power consumption when device is on/active. Use gs1:QuantitativeValue with unitCode 'WTT'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "Power Consumption On"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>;
    skos:exactMatch oec:hasPowerConsumptionOn.
<https://ref.openepcis.io/extensions/eu/electronics/hasPowerConsumptionStandby> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasPowerConsumptionStandby;
    rdfs:comment "Power consumption in standby mode. Use gs1:QuantitativeValue with unitCode 'WTT'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "Power Consumption Standby"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>;
    skos:exactMatch oec:hasPowerConsumptionStandby.
<https://ref.openepcis.io/extensions/eu/electronics/hasPowerConsumptionOff> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasPowerConsumptionOff;
    rdfs:comment "Power consumption when switched off but plugged in. Use gs1:QuantitativeValue with unitCode 'WTT'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "Power Consumption Off"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>;
    skos:exactMatch oec:hasPowerConsumptionOff.
<https://ref.openepcis.io/extensions/eu/electronics/eprelRegistrationNumber> a owl:DatatypeProperty;
    rdfs:seeAlso oec:eprelRegistrationNumber;
    rdfs:comment "European Product Registry for Energy Labelling (EPREL) registration number."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "EPREL Registration Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch gs1:regulatoryReferenceNumber, gs1:regulatoryVerificationNumber;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>;
    skos:exactMatch oec:eprelRegistrationNumber.
<https://ref.openepcis.io/extensions/eu/electronics/energyLabelUrl> a owl:DatatypeProperty;
    rdfs:comment "URL to the EU Energy Label image."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "Energy Label URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>.
<https://ref.openepcis.io/extensions/eu/electronics/eprelProductUrl> a owl:DatatypeProperty;
    rdfs:seeAlso oec:eprelProductUrl;
    rdfs:comment "URL to the product page in the EPREL database."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2019/2021>;
    rdfs:label "EPREL Product URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Energy-performance concept per EU Energy Labelling / Ecodesign (EU) 2019/2021. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/EnergyEfficiency>;
    skos:exactMatch oec:eprelProductUrl.
<https://ref.openepcis.io/extensions/eu/electronics/hasBillOfMaterials> a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#batteryMaterials>;
    rdfs:comment "Component bill of materials for the device."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Bill of Materials"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:narrowMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#batteryMaterials>;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/ComponentBOM>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/hasComponents> a owl:ObjectProperty;
    rdfs:comment "List of components in the bill of materials."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Components"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:Product;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/ComponentBOM>.
<https://ref.openepcis.io/extensions/eu/electronics/hasComponentType> a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#batteryCategory>;
    rdfs:comment "Type of component (Battery, Display, etc.)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Component Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/ComponentType>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/componentPartNumber> a owl:DatatypeProperty;
    rdfs:comment "Manufacturer's part number for the component."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Component Part Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#partNumber>;
    rdfs:range xsd:string;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/isReplaceable> a owl:DatatypeProperty;
    rdfs:comment "Whether the component can be replaced."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Is Replaceable"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:boolean;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/hasReplacementDifficulty> a owl:ObjectProperty;
    rdfs:comment "Level of difficulty to replace this component."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Replacement Difficulty"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/ReplacementDifficulty>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/hasComponentPassport> a owl:ObjectProperty;
    rdfs:comment "Link to the component's own Digital Product Passport (nested DPP).\nEnables CIRPASS-2 multi-component tracking."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Component Passport"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Aligned with UNTP linkedProduct pattern for nested DPPs."@en;
    skos:broadMatch gs1:dpp;
    rdfs:range xsd:anyURI;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/hasSparePartAvailabilityYears> a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#sparePartsAvailable>;
    rdfs:comment "Duration for which this component is available as a spare part. Use unitCode 'ANN' (UN/CEFACT Rec 20)."@en;
    dcterms:source <https://www.ecologie.gouv.fr/indice-reparabilite>;
    rdfs:label "Spare Part Availability Years"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Repairability concept per the French Repairability Index (Indice de Réparabilité) and the EU Right to Repair. Aligns approximately with the DPP Keystone field dppk:sparePartsAvailable. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#sparePartsAvailable>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/hasSparePartPrice> a owl:ObjectProperty;
    rdfs:seeAlso schema:priceSpecification, gs1:priceSpecification;
    rdfs:comment "Price of the component as a spare part."@en;
    dcterms:source <https://www.ecologie.gouv.fr/indice-reparabilite>;
    rdfs:label "Spare Part Price"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Repairability concept per the French Repairability Index (Indice de Réparabilité) and the EU Right to Repair. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch schema:price;
    rdfs:range gs1:PriceSpecification;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/hasWeeeCompliance> a owl:ObjectProperty;
    rdfs:comment "WEEE Directive compliance information."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "WEEE Compliance"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste / separate-collection concept per the WEEE Directive 2012/19/EU. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/WEEECompliance>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/weeeRegistrationNumber> a owl:DatatypeProperty;
    rdfs:comment "Producer registration number in the WEEE register."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "WEEE Registration Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste / separate-collection concept per the WEEE Directive 2012/19/EU. Specialises the cross-cutting oec:eprRegistrationNumber for the WEEE register."@en;
    skos:broadMatch gs1:registryEntry, gs1:regulatoryReferenceNumber, schema:companyRegistration, oec:eprRegistrationNumber;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/WEEECompliance>;
    rdfs:subPropertyOf oec:eprRegistrationNumber.
<https://ref.openepcis.io/extensions/eu/electronics/weeeRegistrationCountry> a owl:DatatypeProperty;
    rdfs:comment "Country of WEEE registration (ISO 3166-1 alpha-2)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "WEEE Registration Country"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste / separate-collection concept per the WEEE Directive 2012/19/EU. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch oec:hasEprJurisdiction, <https://vocabulary.uncefact.org/untp/addressCountry>;
    skos:closeMatch schema:addressCountry;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/WEEECompliance>.
<https://ref.openepcis.io/extensions/eu/electronics/collectionSchemeUrl> a owl:DatatypeProperty;
    rdfs:comment "URL to information about the WEEE collection/take-back scheme."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Collection Scheme URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste / separate-collection concept per the WEEE Directive 2012/19/EU. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/WEEECompliance>.
<https://ref.openepcis.io/extensions/eu/electronics/recyclabilityRate> a owl:DatatypeProperty;
    rdfs:seeAlso oec:recyclableContent, oec:recyclabilityRate;
    rdfs:comment "Fraction of device that can be recycled (0-1 scale)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Recyclability Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/WEEECompliance>;
    skos:exactMatch oec:recyclabilityRate.
<https://ref.openepcis.io/extensions/eu/electronics/recoverabilityRate> a owl:DatatypeProperty;
    rdfs:comment "Fraction of device that can be recovered (recycling + energy recovery, 0-1 scale)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Recoverability Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/WEEECompliance>.
<https://ref.openepcis.io/extensions/eu/electronics/hasRohsCompliance> a owl:ObjectProperty;
    rdfs:comment "RoHS Directive compliance information."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2011/65/oj>;
    rdfs:label "RoHS Compliance"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Restricted-substance concept per the RoHS Directive 2011/65/EU. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch gs1:certification, schema:hasCertification, gs1:certificationInfo;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/RoHSCompliance>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/rohsCompliant> a owl:DatatypeProperty;
    rdfs:comment "Whether the device complies with RoHS Directive."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2011/65/oj>;
    rdfs:label "RoHS Compliant"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Restricted-substance concept per the RoHS Directive 2011/65/EU. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:boolean;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/RoHSCompliance>.
<https://ref.openepcis.io/extensions/eu/electronics/rohsExemptions> a owl:DatatypeProperty;
    rdfs:comment "List of applicable RoHS exemption codes (e.g., '7(a)', '7(c)-I')."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2011/65/oj>;
    rdfs:label "RoHS Exemptions"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Restricted-substance concept per the RoHS Directive 2011/65/EU. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/RoHSCompliance>.
<https://ref.openepcis.io/extensions/eu/electronics/rohsDeclarationUrl> a owl:DatatypeProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.Labels:1.2.0#resultOfTestReport>, gs1:referencedFileURL;
    rdfs:comment "URL to the RoHS compliance declaration document."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2011/65/oj>;
    rdfs:label "RoHS Declaration URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Restricted-substance concept per the RoHS Directive 2011/65/EU. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch gs1:referencedFileURL, <urn:samm:io.BatteryPass.Circularity:1.2.0#documentURL>, <https://dpp-keystone.org/spec/v2/terms#certificationUrl>;
    rdfs:range xsd:anyURI;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/RoHSCompliance>.
<https://ref.openepcis.io/extensions/eu/electronics/hasDisplaySpecification> a owl:ObjectProperty;
    rdfs:comment "Display-specific technical specifications."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Display Specification"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/DisplaySpecification>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/hasScreenDiagonal> a owl:ObjectProperty;
    rdfs:seeAlso gs1:value;
    rdfs:comment "Visible screen diagonal. Use gs1:QuantitativeValue with unitCode 'CMT' or 'INH'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Screen Diagonal"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/DisplaySpecification>.
<https://ref.openepcis.io/extensions/eu/electronics/screenResolutionWidth> a owl:DatatypeProperty;
    rdfs:comment "Horizontal resolution in pixels."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Screen Resolution Width"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:integer;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/DisplaySpecification>.
<https://ref.openepcis.io/extensions/eu/electronics/screenResolutionHeight> a owl:DatatypeProperty;
    rdfs:seeAlso schema:height, <https://vocabulary.uncefact.org/untp/height>, <https://dpp-keystone.org/spec/v2/terms#height>;
    rdfs:comment "Vertical resolution in pixels."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Screen Resolution Height"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:integer;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/DisplaySpecification>.
<https://ref.openepcis.io/extensions/eu/electronics/displayTechnology> a owl:DatatypeProperty;
    rdfs:comment "Display technology type (LCD, OLED, AMOLED, MicroLED, etc.)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Display Technology"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/DisplaySpecification>.
<https://ref.openepcis.io/extensions/eu/electronics/hasRefreshRate> a owl:ObjectProperty;
    rdfs:seeAlso gs1:value;
    rdfs:comment "Display refresh rate. Use gs1:QuantitativeValue with unitCode 'HTZ'."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Refresh Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/DisplaySpecification>.
<https://ref.openepcis.io/extensions/eu/electronics/hasPeakBrightness> a owl:ObjectProperty;
    rdfs:comment "Peak brightness in candelas per square meter (nits). Use gs1:QuantitativeValue. Use unitCode 'CDM2' (UN/CEFACT Rec 20)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Peak Brightness"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/DisplaySpecification>.
<https://ref.openepcis.io/extensions/eu/electronics/hasSoftwareUpdateEvent> a owl:ObjectProperty;
    rdfs:seeAlso <https://www.iso.org/standard/63712.html>;
    rdfs:comment "EPCIS extension data for software/firmware update events.\nUse with bizStep 'inspecting' for software lifecycle tracking."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Software Update Event"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Candidate for UNTP contribution: softwareUpdateEvent pattern."@en.
<https://ref.openepcis.io/extensions/eu/electronics/previousVersion> a owl:DatatypeProperty;
    rdfs:comment "Software/firmware version before update."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Previous Version"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch <https://vocabulary.uncefact.org/untp/version>;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/newVersion> a owl:DatatypeProperty;
    rdfs:seeAlso schema:version, schema:softwareVersion;
    rdfs:comment "Software/firmware version after update."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "New Version"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/updateType> a owl:DatatypeProperty;
    rdfs:comment "Type of update (security, feature, firmware, driver, etc.)."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Update Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Software / firmware support-lifecycle concept per ISO/IEC 12207. Candidate for upstream UNTP contribution; no GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/updateSource> a owl:DatatypeProperty;
    rdfs:comment "Source of the update (OTA, manual, service center, etc.)."@en;
    dcterms:source <https://www.iso.org/standard/63712.html>;
    rdfs:label "Update Source"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Software / firmware support-lifecycle concept per ISO/IEC 12207. Candidate for upstream UNTP contribution; no GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch schema:source;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/hasMaterialDeclaration> a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#isCriticalRawMaterial>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#batteryMaterials>, <https://std.iec.ch/iec62474>;
    rdfs:comment "Material declaration per IEC 62474 (Declarable Substance List).\nLinks to oec:SubstanceOfConcern for REACH/RoHS substances."@en;
    dcterms:source <https://std.iec.ch/iec62474>;
    rdfs:label "Material Declaration"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch gs1:packagingMaterialType;
    skos:narrowMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#isCriticalRawMaterial>;
    rdfs:range oec:SubstanceOfConcern;
    rdfs:domain gs1:Product.
<https://ref.openepcis.io/extensions/eu/electronics/iec62474DslVersion> a owl:DatatypeProperty;
    rdfs:comment "Version of the IEC 62474 Declarable Substance List used."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "IEC 62474 DSL Version"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch schema:schemaVersion;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/materialDeclarationDate> a owl:DatatypeProperty;
    rdfs:comment "Date of the material declaration."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Material Declaration Date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Electronics Digital Product Passport attribute under the ESPR 2024/1781 electronics delegated acts. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:date.
<https://ref.openepcis.io/extensions/eu/electronics/SelectiveTreatmentItem> a owl:Class;
    rdfs:seeAlso oec:HazardousSubstance, gs1:ReferencedFileTypeCode-HAZARDOUS_SUBSTANCES_DATA;
    rdfs:comment "A material, substance or component identified in a WEEE item that has to be removed\nand handled separately before the item enters bulk treatment, per the selective-treatment list of\nWEEE Directive 2012/19/EU Annex VII (batteries, capacitors, mercury-containing components, ...)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Selective Treatment Item"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: oec:HazardousSubstance models a CLP/REACH substance declaration\nagainst a product, identified by CAS/EC number. A selective-treatment finding is an operational\nobservation made on one waste item about a whole component (for example \"lithium-ion battery\"), which\nneither that pattern nor any GS1, SEMICeu or schema.org class expresses."@en;
    skos:closeMatch oec:HazardousSubstance.
<https://ref.openepcis.io/extensions/eu/electronics/RecoveredMaterial> a owl:Class;
    rdfs:seeAlso oec:MaterialComposition, gs1:PackagingMaterialDetails;
    rdfs:comment "A single material stream recovered from a WEEE item, or estimated as recoverable\nfrom it: the material and its mass. Used both for the pre-treatment estimate and for the measured\noutput of a treatment operation."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Recovered Material"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: oec:MaterialComposition describes what a product is made of as\nmass fractions of the product. A recovered stream is the opposite direction of the same accounting:\nan absolute mass actually taken out of one waste item at a treatment facility, which the WEEE\nAnnex V recovery accounting needs and no upstream class carries."@en;
    skos:closeMatch oec:MaterialComposition.
<https://ref.openepcis.io/extensions/eu/electronics/MaterialRecoveryResult> a owl:Class;
    rdfs:seeAlso oec:RecyclabilityAssessment, <https://ref.openepcis.io/extensions/eu/electronics/WEEECompliance>;
    rdfs:comment "The aggregate outcome of a WEEE treatment operation on one item: total input mass,\ntotal recovered mass, and the recovery, recycling and energy-recovery rates that WEEE Directive\n2012/19/EU Annex V expresses as minimum targets per equipment category."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Material Recovery Result"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: oec:RecyclabilityAssessment rates a product's design potential\nbefore it is ever used. This class records what a treatment operator actually achieved on one item,\nwhich is the figure the WEEE Annex V targets are measured against. No GS1, SEMICeu or schema.org\nclass covers treatment output accounting."@en;
    skos:broadMatch <https://w3id.org/eudpp#LcaResult>;
    skos:closeMatch oec:RecyclabilityAssessment.
<https://ref.openepcis.io/extensions/eu/electronics/BatteryDisposition> a owl:Class;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/BatteryComponent>, <https://ref.openepcis.io/extensions/eu/battery/>;
    rdfs:comment "How the battery removed from a WEEE item was handled: its mass, whether it was\ntreated separately as WEEE Directive 2012/19/EU Annex VII requires, the treatment route, and the\nfacility that carried it out."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Battery Disposition"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: the eu/battery module describes a battery as a product under\nRegulation (EU) 2023/1542; this class records what a WEEE treatment operator did with the battery\npulled out of a device, which is an electronics end-of-life observation. No GS1, SEMICeu or\nschema.org class covers it."@en.
<https://ref.openepcis.io/extensions/eu/electronics/HazardousWasteRecord> a owl:Class;
    rdfs:seeAlso gs1:CertificationDetails, <https://eur-lex.europa.eu/eli/dir/2008/98/oj>;
    rdfs:comment "Hazardous waste arising from the treatment of a WEEE item, with the consignment\ndescription and the reference of the treatment certificate issued for it."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Hazardous Waste Record"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: gs1:CertificationDetails models a product certification held by\nan organisation, not a per-consignment waste-treatment record. Waste-shipment records are governed by\nthe Waste Framework Directive 2008/98/EC alongside WEEE, and neither GS1, SEMICeu nor schema.org has\na class for them."@en;
    skos:closeMatch gs1:CertificationDetails.
<https://ref.openepcis.io/extensions/eu/electronics/AvoidedEmissionsEstimate> a owl:Class;
    rdfs:seeAlso oec:CarbonFootprintDeclaration, oec:StageC3;
    rdfs:comment "An estimate of the greenhouse-gas emissions avoided by recovering materials from a\nWEEE item instead of producing them primarily, with the calculation basis used."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Avoided Emissions Estimate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Required extension: oec:CarbonFootprintDeclaration accounts for emissions caused\nalong a product's lifecycle. Avoided emissions are a counterfactual credited to a recycling\noperation, not a lifecycle stage of the product, so they cannot be filed under that pattern; no GS1,\nSEMICeu or schema.org class carries them either."@en;
    skos:closeMatch oec:CarbonFootprintDeclaration.
<https://ref.openepcis.io/extensions/eu/electronics/collectionMethod> a owl:DatatypeProperty;
    rdfs:seeAlso oec:separateCollectionInfo, gs1:LocationRoleType-COLLECTION_CENTER;
    rdfs:comment "How the waste item entered separate collection (retailer take-back, municipal collection point, producer scheme pick-up, ...)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Collection Method"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the separate-collection duties of WEEE Directive 2012/19/EU\nArticles 5 and 14. oec:separateCollectionInfo and oec:collectionPointDirectoryUrl publish where a\nconsumer should hand the product in; this records which route one item actually took. No GS1, SEMICeu\nor schema.org term expresses it."@en;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/deviceCondition> a owl:DatatypeProperty;
    rdfs:seeAlso schema:itemCondition;
    rdfs:comment "Condition of the device as assessed when it was taken in for collection or sorting."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Device Condition"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the preparing-for-re-use and treatment duties of WEEE Directive\n2012/19/EU Article 8. schema:itemCondition is the nearest upstream term but ranges over the four\nretail OfferItemCondition codes, which cannot carry an intake assessment of a waste item."@en;
    skos:closeMatch schema:itemCondition;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/dataWiped> a owl:DatatypeProperty;
    rdfs:seeAlso schema:itemCondition, <https://eur-lex.europa.eu/eli/reg/2016/679>;
    rdfs:comment "Whether user data held on the device was securely erased before it was passed on for re-use or treatment."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Data Wiped"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Data sanitisation is a precondition for preparing WEEE for re-use (WEEE Directive\n2012/19/EU Article 8 and EN 50614) and for lawful processing of personal data under the GDPR. It is\nan operational assertion about one item; no GS1, SEMICeu or schema.org term covers it."@en;
    rdfs:range xsd:boolean.
<https://ref.openepcis.io/extensions/eu/electronics/sortingDecision> a owl:DatatypeProperty;
    rdfs:seeAlso oec:CircularityPerformance, schema:itemCondition;
    rdfs:comment "Outcome of the sorting or inspection step: which treatment route the item was directed to, and why."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Sorting Decision"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the treatment duties of WEEE Directive 2012/19/EU Article 8,\nwhich put preparing for re-use ahead of recycling. The decision is an observation recorded at a\nsorting facility; no GS1, SEMICeu or schema.org term expresses it."@en;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/hasHazardousMaterialsIdentified> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasHazardousSubstances;
    rdfs:comment "Materials or components found in the item that require selective treatment before bulk processing."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Hazardous Materials Identified"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the selective-treatment list of WEEE Directive 2012/19/EU\nAnnex VII. oec:hasHazardousSubstances declares substances present in a product design; this reports what\na treatment operator actually found in one waste item."@en;
    skos:closeMatch oec:hasHazardousSubstances;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/SelectiveTreatmentItem>.
<https://ref.openepcis.io/extensions/eu/electronics/handlingNote> a owl:DatatypeProperty;
    rdfs:seeAlso gs1:consumerHandlingStorageInfo;
    rdfs:comment "Instruction for handling a selectively treated material or component safely (for example removal before shredding)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Handling Note"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the selective-treatment requirements of WEEE Directive\n2012/19/EU Annex VII. gs1:consumerHandlingStorageInfo is the nearest upstream term but addresses\nconsumers handling a trade item, not a treatment operator handling a hazardous component."@en;
    skos:broadMatch gs1:consumerHandlingStorageInfo;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/SelectiveTreatmentItem>.
<https://ref.openepcis.io/extensions/eu/electronics/hasEstimatedRecoverableMaterials> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasMaterialComposition, <https://ref.openepcis.io/extensions/eu/electronics/hasMaterialRecoveryResults>;
    rdfs:comment "Material streams expected to be recoverable from the item, estimated before treatment."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Estimated Recoverable Materials"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept supporting the recovery accounting of WEEE Directive 2012/19/EU\nAnnex V. The estimate steers the treatment route and is compared afterwards with the measured result;\nno GS1, SEMICeu or schema.org term expresses it."@en;
    skos:closeMatch oec:hasMaterialComposition;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/RecoveredMaterial>.
<https://ref.openepcis.io/extensions/eu/electronics/hasMaterialRecoveryResults> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasRecyclabilityAssessment;
    rdfs:comment "Measured outcome of the treatment operation on this item."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Material Recovery Results"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the recovery targets of WEEE Directive 2012/19/EU Annex V.\noec:hasRecyclabilityAssessment rates design potential; this reports achieved treatment output. No GS1,\nSEMICeu or schema.org term covers it."@en;
    skos:closeMatch oec:hasRecyclabilityAssessment;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/MaterialRecoveryResult>.
<https://ref.openepcis.io/extensions/eu/electronics/materialMassGrams> a owl:DatatypeProperty;
    rdfs:seeAlso oec:massFraction, schema:weight;
    rdfs:comment "Mass of this material stream in grams, either estimated as recoverable or measured after treatment."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Material Mass (grams)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept supporting the recovery accounting of WEEE Directive 2012/19/EU\nAnnex V. oec:massFraction carries a 0-1 fraction of a product, schema:weight and gs1:netWeight the\nweight of a trade item; none of them is the absolute mass of one recovered stream. Value in grams,\nfollowing the unit-in-name convention of oec:carbonFootprintTotal (kg CO2e)."@en;
    skos:broadMatch schema:weight;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/RecoveredMaterial>.
<https://ref.openepcis.io/extensions/eu/electronics/recyclingProcess> a owl:DatatypeProperty;
    rdfs:seeAlso gs1:packagingRecyclingProcessType;
    rdfs:comment "The treatment or recycling process applied to the item."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Recycling Process"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the treatment requirements of WEEE Directive 2012/19/EU Article 8\nand Annex VIII. gs1:packagingRecyclingProcessType is the nearest upstream term and is confined to\npackaging recycling process codes."@en;
    skos:closeMatch gs1:packagingRecyclingProcessType;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/hasRecyclingFacility> a owl:ObjectProperty;
    rdfs:seeAlso gs1:Organization, oec:FacilityInformation;
    rdfs:comment "The authorised treatment operator that carried out the recycling step."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Recycling Facility"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the permitting and treatment duties of WEEE Directive 2012/19/EU\nArticle 8. The organisation itself is a gs1:Organization and the site a gs1:Place; what has no\nupstream term is the role of authorised WEEE treatment operator in a specific event."@en;
    skos:broadMatch oec:hasFacilityInformation;
    rdfs:range gs1:Organization.
<https://ref.openepcis.io/extensions/eu/electronics/totalInputMassGrams> a owl:DatatypeProperty;
    rdfs:seeAlso gs1:netWeight;
    rdfs:comment "Mass in grams of the item that entered the treatment operation."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Total Input Mass (grams)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept forming the denominator of the WEEE Directive 2012/19/EU Annex V\nrecovery rates. gs1:netWeight is the weight of a trade item as sold, not the mass weighed in at a\ntreatment facility. Value in grams."@en;
    skos:broadMatch schema:weight;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/MaterialRecoveryResult>.
<https://ref.openepcis.io/extensions/eu/electronics/totalRecoveredMassGrams> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/totalInputMassGrams>;
    rdfs:comment "Mass in grams recovered from the item across all output streams."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Total Recovered Mass (grams)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept forming the numerator of the WEEE Directive 2012/19/EU Annex V\nrecovery rates. No GS1, SEMICeu or schema.org term expresses recovered output mass. Value in\ngrams."@en;
    skos:broadMatch schema:weight;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/MaterialRecoveryResult>.
<https://ref.openepcis.io/extensions/eu/electronics/recoveryRate> a owl:DatatypeProperty;
    rdfs:seeAlso oec:recyclabilityRate, <https://ref.openepcis.io/extensions/eu/electronics/recoverabilityRate>;
    rdfs:comment "Achieved recovery rate for the item: recovered mass divided by input mass (0-1 scale)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Recovery Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the minimum recovery targets of WEEE Directive 2012/19/EU\nAnnex V. Distinct from euelec:recoverabilityRate and oec:recyclabilityRate, which state a product's\ndesign potential before use; this is what one treatment operation achieved. No GS1, SEMICeu or\nschema.org term expresses it."@en;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/MaterialRecoveryResult>.
<https://ref.openepcis.io/extensions/eu/electronics/recyclingRate> a owl:DatatypeProperty;
    rdfs:seeAlso oec:recyclabilityRate, <https://ref.openepcis.io/extensions/eu/electronics/recyclabilityRate>;
    rdfs:comment "Achieved rate of preparing for re-use and recycling for the item (0-1 scale), excluding energy recovery."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Recycling Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the minimum \"prepared for re-use and recycled\" targets of WEEE\nDirective 2012/19/EU Annex V, which are set separately from the overall recovery target. Distinct\nfrom euelec:recyclabilityRate, which is the design-potential figure. No GS1, SEMICeu or schema.org\nterm expresses it."@en;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/MaterialRecoveryResult>.
<https://ref.openepcis.io/extensions/eu/electronics/energyRecoveryRate> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/recoveryRate>, gs1:PackagingRecyclingProcessTypeCode-ENERGY_RECOVERABLE;
    rdfs:comment "Fraction of the item's mass sent to energy recovery rather than material recycling (0-1 scale)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Energy Recovery Rate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per WEEE Directive 2012/19/EU Annex V, where energy recovery counts\ntowards the recovery target but not towards the recycling target, so the two shares have to be\nreported apart. gs1:PackagingRecyclingProcessTypeCode-ENERGY_RECOVERABLE marks packaging as suitable\nfor energy recovery and carries no achieved share."@en;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/MaterialRecoveryResult>.
<https://ref.openepcis.io/extensions/eu/electronics/hasBatteryDisposition> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/BatteryComponent>, <https://ref.openepcis.io/extensions/eu/battery/>;
    rdfs:comment "How the battery removed from the item was handled."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Battery Disposition"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per WEEE Directive 2012/19/EU Annex VII, which requires batteries to\nbe removed from separately collected WEEE. The battery product data itself lives in the eu/battery\nmodule; this records the end-of-life handling observed on the device event."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/BatteryDisposition>.
<https://ref.openepcis.io/extensions/eu/electronics/batteryMassGrams> a owl:DatatypeProperty;
    rdfs:seeAlso gs1:netWeight;
    rdfs:comment "Mass in grams of the battery removed from the item."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Battery Mass (grams)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per WEEE Directive 2012/19/EU Annex VII: the removed battery mass is\nbooked against the battery stream rather than the WEEE recovery figures. gs1:netWeight is the weight\nof a trade item as sold. Value in grams."@en;
    skos:broadMatch schema:weight, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#batteryMaterialMass>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/BatteryDisposition>.
<https://ref.openepcis.io/extensions/eu/electronics/separatelyTreated> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/hasBatteryDisposition>;
    rdfs:comment "Whether the removed battery was routed to separate battery treatment as required, rather than into the bulk WEEE stream."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Separately Treated"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Compliance assertion for the selective-treatment requirement of WEEE Directive\n2012/19/EU Annex VII. No GS1, SEMICeu or schema.org term expresses it."@en;
    rdfs:range xsd:boolean;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/BatteryDisposition>.
<https://ref.openepcis.io/extensions/eu/electronics/hasTreatmentFacility> a owl:ObjectProperty;
    rdfs:seeAlso oec:FacilityInformation, gs1:Place;
    rdfs:comment "The site where the removed battery was treated, referenced by its GLN."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Treatment Facility"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the permitting requirements of WEEE Directive 2012/19/EU\nArticle 8. The site is a gs1:Place and its master data is resolver-served; the extension term states\nthat this particular place acted as the downstream battery treatment site for this event."@en;
    skos:broadMatch oec:hasFacilityInformation;
    rdfs:range gs1:Place;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/BatteryDisposition>.
<https://ref.openepcis.io/extensions/eu/electronics/treatmentMethod> a owl:DatatypeProperty;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>, gs1:packagingRecyclingProcessType;
    rdfs:comment "The treatment route applied to the removed battery (for example hydrometallurgical or pyrometallurgical recycling)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Treatment Method"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per WEEE Directive 2012/19/EU Annex VII read with the recycling\nefficiency requirements of Regulation (EU) 2023/1542 Annex XII for battery treatment. No GS1, SEMICeu\nor schema.org term expresses a treatment route."@en;
    skos:closeMatch gs1:packagingRecyclingProcessType;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/BatteryDisposition>.
<https://ref.openepcis.io/extensions/eu/electronics/hazardousWasteGenerated> a owl:DatatypeProperty;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/dir/2008/98/oj>, <https://ref.openepcis.io/extensions/eu/electronics/hasHazardousWasteRecord>;
    rdfs:comment "Whether the operation produced hazardous waste."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Hazardous Waste Generated"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Operational assertion tied to the treatment duties of WEEE Directive 2012/19/EU\nArticle 8 and the classification rules of the Waste Framework Directive 2008/98/EC. No GS1, SEMICeu\nor schema.org term expresses it. Use euelec:hasHazardousWasteRecord when the consignment itself is\ndescribed."@en;
    rdfs:range xsd:boolean.
<https://ref.openepcis.io/extensions/eu/electronics/hasHazardousWasteRecord> a owl:ObjectProperty;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/dir/2008/98/oj>, <https://ref.openepcis.io/extensions/eu/electronics/hazardousWasteGenerated>;
    rdfs:comment "The hazardous waste consignment arising from this operation."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Hazardous Waste Record"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the treatment duties of WEEE Directive 2012/19/EU Article 8 read\nwith the Waste Framework Directive 2008/98/EC. No GS1, SEMICeu or schema.org term covers a waste\nconsignment record."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/HazardousWasteRecord>.
<https://ref.openepcis.io/extensions/eu/electronics/wasteDescription> a owl:DatatypeProperty;
    rdfs:seeAlso schema:description;
    rdfs:comment "Description of the hazardous waste consignment and where it was sent."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Waste Description"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the treatment duties of WEEE Directive 2012/19/EU Article 8.\nschema:description is the generic web fallback for any textual description; this term is the narrower\nwaste-consignment description that a treatment record has to carry."@en;
    skos:broadMatch schema:description;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/HazardousWasteRecord>.
<https://ref.openepcis.io/extensions/eu/electronics/treatmentCertificate> a owl:DatatypeProperty;
    rdfs:seeAlso gs1:CertificationDetails, gs1:certificationIdentification;
    rdfs:comment "Reference of the certificate issued for the treatment or disposal of the hazardous waste consignment."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Treatment Certificate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "E-waste concept per the treatment duties of WEEE Directive 2012/19/EU Article 8 read\nwith the Waste Framework Directive 2008/98/EC. gs1:certificationIdentification identifies a product\nor organisation certification, not a per-consignment waste treatment certificate."@en;
    skos:broadMatch schema:hasCertification;
    skos:closeMatch gs1:certificationIdentification;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/HazardousWasteRecord>.
<https://ref.openepcis.io/extensions/eu/electronics/hasAvoidedEmissions> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasEmissionsPerformance;
    rdfs:comment "Estimate of the greenhouse-gas emissions avoided by recovering materials from this item."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Avoided Emissions"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Circularity-benefit concept supporting the ESPR 2024/1781 Article 7 recycled-content\nand circularity parameters. oec:hasEmissionsPerformance accounts for emissions caused by the product;\navoided emissions are credited to the recovery operation, so they are reported apart. No GS1, SEMICeu\nor schema.org term expresses them."@en;
    skos:closeMatch oec:hasEmissionsPerformance;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/AvoidedEmissionsEstimate>.
<https://ref.openepcis.io/extensions/eu/electronics/avoidedEmissionsKgCO2e> a owl:DatatypeProperty;
    rdfs:seeAlso oec:carbonFootprintTotal, oec:StageC3;
    rdfs:comment "Estimated avoided emissions in kilograms of CO2 equivalent."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Avoided Emissions (kg CO2e)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Circularity-benefit figure supporting the ESPR 2024/1781 Article 7 circularity\nparameters. oec:carbonFootprintTotal is the emissions the product caused; this is the counterfactual\ncredited to recovering its materials. Value in kg CO2 equivalent, following the unit-in-name\nconvention of oec:carbonFootprintTotal."@en;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/AvoidedEmissionsEstimate>.
<https://ref.openepcis.io/extensions/eu/electronics/calculationMethod> a owl:DatatypeProperty;
    rdfs:seeAlso oec:carbonFootprintMethodology;
    rdfs:comment "Basis on which the avoided-emissions figure was calculated."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Calculation Method"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Methodology statement for the avoided-emissions estimate. oec:carbonFootprintMethodology\nis the nearest term and takes a URI of a published footprint methodology; an avoided-emissions\ncalculation basis is usually stated as text and is not one of those methodologies."@en;
    skos:broadMatch schema:measurementMethod;
    skos:closeMatch oec:carbonFootprintMethodology;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/electronics/AvoidedEmissionsEstimate>.
<https://ref.openepcis.io/extensions/eu/electronics/repairType> a owl:DatatypeProperty;
    rdfs:seeAlso oec:RepairabilityInfo, <https://ref.openepcis.io/extensions/eu/electronics/ComponentType>;
    rdfs:comment "The kind of repair performed (battery replacement, display replacement, board-level repair, ...)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Repair-history concept per the repairability parameters of ESPR 2024/1781 Annex I and\nDirective (EU) 2024/1799 on the promotion of repair. oec:RepairabilityInfo describes how repairable a\nproduct is; this records what was actually repaired. No GS1, SEMICeu or schema.org term expresses\nit."@en;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/repairDescription> a owl:DatatypeProperty;
    rdfs:seeAlso oec:hasRepairInstructions, schema:description;
    rdfs:comment "Description of the repair performed and the fault it addressed."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Description"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Repair-history concept per ESPR 2024/1781 Annex I and Directive (EU) 2024/1799.\nschema:description is the generic web fallback for any textual description; this term is the narrower\nrepair-record description."@en;
    skos:broadMatch schema:description;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/repairTechnician> a owl:DatatypeProperty;
    rdfs:seeAlso oec:RepairProvider, oec:repairProviderName;
    rdfs:comment "The technician or service organisation that performed the repair, as recorded on the repair event."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Technician"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Repair-history concept per ESPR 2024/1781 Annex I and Directive (EU) 2024/1799.\noec:RepairProvider with oec:repairProviderName lists the repair network a manufacturer publishes for\na product; this names who actually carried out one repair. Where the repairer is an identified party,\nprefer the EPCIS readPoint / source GLN, whose master data is resolver-served."@en;
    skos:closeMatch oec:repairProviderName;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/removalReason> a owl:DatatypeProperty;
    rdfs:seeAlso oec:RepairabilityInfo, <https://ref.openepcis.io/extensions/eu/electronics/hasReplacementDifficulty>;
    rdfs:comment "Why the component was removed from the device."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Removal Reason"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Repair-history concept per ESPR 2024/1781 Annex I and Directive (EU) 2024/1799. The\nreason a part failed feeds the durability and repairability parameters; no GS1, SEMICeu or\nschema.org term expresses it."@en;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/hasReplacedComponentPassport> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/hasComponentPassport>, gs1:dpp;
    rdfs:comment "The component taken out of the device, referenced by the identifier its own Digital Product Passport is keyed on."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Replaced Component Passport"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Nested-passport concept per the ESPR 2024/1781 Article 9 data-carrier requirements\nand the CIRPASS-2 multi-component pattern. gs1:dpp links a product to its passport; the repair event\nadditionally has to say which of the two component passports is the one removed and which the one\ninstalled, a direction gs1:dpp does not carry."@en;
    skos:broadMatch gs1:dpp;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/ElectronicComponent>.
<https://ref.openepcis.io/extensions/eu/electronics/hasInstalledComponentPassport> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/hasComponentPassport>, gs1:dpp;
    rdfs:comment "The component fitted into the device, referenced by the identifier its own Digital Product Passport is keyed on."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Installed Component Passport"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Nested-passport concept per the ESPR 2024/1781 Article 9 data-carrier requirements\nand the CIRPASS-2 multi-component pattern. Counterpart of euelec:hasReplacedComponentPassport; gs1:dpp\ncarries no removed/installed direction."@en;
    skos:broadMatch gs1:dpp;
    rdfs:range <https://ref.openepcis.io/extensions/eu/electronics/ElectronicComponent>.
<https://ref.openepcis.io/extensions/eu/electronics/warrantyStatus> a owl:DatatypeProperty;
    rdfs:seeAlso gs1:WarrantyPromise, gs1:manufacturersWarranty;
    rdfs:comment "Whether the device was under warranty at the time of the event."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Warranty Status"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Repair-record concept per ESPR 2024/1781 Annex I and Directive (EU) 2024/1799.\ngs1:manufacturersWarranty with gs1:WarrantyPromise carries the warranty terms of the product model,\nwhich are master data; no GS1, SEMICeu or schema.org term states whether the warranty was in force\nfor one item when an event happened."@en;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/electronics/hasRepairCost> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/hasSparePartPrice>, schema:priceSpecification, gs1:priceSpecification;
    rdfs:comment "Amount charged to the owner for this repair. Zero where the repair was covered by a warranty."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Cost"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "Repair-record concept per Directive (EU) 2024/1799, which makes repair cost central\nto the repair-or-replace decision. The amount itself is a gs1:PriceSpecification; euelec:hasSparePartPrice\nis the list price of a part, whereas this is what one repair actually cost."@en;
    skos:broadMatch schema:priceSpecification;
    rdfs:range gs1:PriceSpecification.
<https://ref.openepcis.io/extensions/eu/electronics/nextDisposition> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/electronics/sortingDecision>, <https://ref.gs1.org/standards/cbv/>;
    rdfs:comment "The intended onward route for the removed component after this event."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2012/19/oj>;
    rdfs:label "Next Disposition"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/electronics/>;
    skos:note "The EPCIS/CBV disposition field states the business condition of the object as of the\nevent; the WEEE treatment chain also needs the intended next route (re-use, refurbishment, WEEE\ncategory recycling) which the CBV disposition vocabulary does not model. No GS1, SEMICeu or\nschema.org term expresses it."@en;
    rdfs:range xsd:string.
