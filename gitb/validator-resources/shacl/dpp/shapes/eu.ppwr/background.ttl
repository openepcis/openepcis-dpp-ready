    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EnergyEfficiency.
oec:hasEnergyEfficiency a owl:ObjectProperty;
    rdfs:seeAlso schema:energyEfficiencyScaleMax, schema:energyEfficiencyScaleMin, schema:hasEnergyConsumptionDetails, <urn:samm:io.BatteryPass.Performance:1.2.1#roundTripEfficiencyFade>, <urn:samm:io.BatteryPass.Performance:1.2.1#roundTripEfficiencyAt50PercentCycleLife>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Energy Efficiency"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:narrowMatch <urn:samm:io.BatteryPass.Performance:1.2.1#remainingRoundTripEnergyEfficiency>, <urn:samm:io.BatteryPass.Performance:1.2.1#roundTripEfficiencyFade>, <urn:samm:io.BatteryPass.Performance:1.2.1#roundTripEfficiencyAt50PercentCycleLife>, <https://dpp-keystone.org/spec/v2/terms#roundTripEfficiencyAt50Cycles>, <urn:samm:io.BatteryPass.Performance:1.2.1#stateOfCertifiedEnergy>, <https://dpp-keystone.org/spec/v2/terms#roundTripEfficiencyInitial>;
    rdfs:range oec:EnergyEfficiency.
oec:EndOfLifeProgram a owl:Class;
    rdfs:comment "A take-back / collection / dismantling program operating across PPWR, WEEE, Battery, Textile take-back, and ELV. Distinct from EPR registration: EPR is the producer's compliance registration; this is the consumer-facing program with collection points, refunds, and dismantling guides."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "End-of-Life Program"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en.
oec:takeBackUrl a owl:DatatypeProperty;
    rdfs:seeAlso schema:merchantReturnLink;
    rdfs:comment "URL of the consumer-facing take-back program landing page."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Take-Back URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:closeMatch schema:merchantReturnLink;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EndOfLifeProgram.
oec:takeBackIncentive a owl:DatatypeProperty;
    rdfs:comment "Free-text description of any consumer incentive (refund, credit, replacement)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Take-Back Incentive"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range rdf:langString;
    rdfs:domain oec:EndOfLifeProgram.
oec:collectionPointDirectoryUrl a owl:DatatypeProperty;
    rdfs:seeAlso gs1:referencedFileURL;
    rdfs:comment "URL of a directory of physical collection points."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Collection Point Directory URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch gs1:referencedFileURL, schema:url;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EndOfLifeProgram.
oec:dismantlingGuideUrl a owl:DatatypeProperty;
    rdfs:comment "URL of the public dismantling / repair guide for end-of-life processors."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Dismantling Guide URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EndOfLifeProgram.
oec:hasEndOfLifeProgram a owl:ObjectProperty;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "End-of-Life Program"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range oec:EndOfLifeProgram.
oec:HazardSignalWord a owl:Class;
    rdfs:comment "CLP Regulation signal word: Danger or Warning."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Signal Word"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    owl:oneOf _:n3-4346.
_:n3-4346 rdf:first oec:HazardDanger;
    rdf:rest _:n3-4347.
oec:HazardDanger a oec:HazardSignalWord;
    rdfs:label "Danger"@en;
    skos:notation "Danger".
_:n3-4347 rdf:first oec:HazardWarning;
    rdf:rest rdf:nil.
oec:HazardWarning a oec:HazardSignalWord;
    rdfs:label "Warning"@en;
    skos:notation "Warning".
oec:hasHazardSignalWord a owl:ObjectProperty;
    rdfs:comment "CLP Regulation 1272/2008 signal word: Danger or Warning."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Signal Word"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range oec:HazardSignalWord;
    rdfs:domain oec:HazardousSubstance.
oec:hazardPictogramCode a owl:DatatypeProperty;
    rdfs:comment "CLP/GHS pictogram code (GHS01..GHS09). Set-valued: a substance can carry multiple pictograms."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Pictogram Code"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:hazardStatement a owl:DatatypeProperty;
    rdfs:comment "CLP H-statement code (e.g. H315, H319). Set-valued: a substance can carry multiple H-statements."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Statement (H-statement)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:precautionaryStatement a owl:DatatypeProperty;
    rdfs:comment "CLP P-statement code (e.g. P101, P280). Set-valued."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Precautionary Statement (P-statement)"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:repairInformationPortalUrl a owl:DatatypeProperty;
    rdfs:comment "URL of the manufacturer's public repair information portal as required by EU Right-to-Repair Directive 2024/1799 Article 4: covers spare-parts catalogue, dismantling guides, software updates available to independent repairers."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2024/1799>;
    rdfs:label "Repair Information Portal URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:RepairabilityInfo.
oec:RepairProvider a owl:Class;
    rdfs:comment "An authorised repair provider for a product. Supports the European online platform for repair (Article 7 of Directive 2024/1799) and manufacturer-published repair networks."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Provider"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:AutoRepair, schema:MotorcycleRepair.
oec:hasRepairProvider a owl:ObjectProperty;
    rdfs:comment "Links a product to one or more authorised repair providers."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Provider"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:provider;
    rdfs:range oec:RepairProvider.
oec:repairProviderName a owl:DatatypeProperty;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Provider Name"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:provider;
    rdfs:range xsd:string;
    rdfs:domain oec:RepairProvider.
oec:repairProviderUrl a owl:DatatypeProperty;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repair Provider URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:RepairProvider.
oec:hasDueDiligenceRegulationContext a owl:ObjectProperty;
    rdfs:comment "The specific regulation against which a due diligence statement is asserted: Battery Annex X (Reg. 2023/1542), EUDR Article 9 (Reg. 2023/1115), CSDDD (Dir. 2024/1760), Forced Labour Regulation (2024/3015), OECD Conflict Minerals, etc. Same oec:DueDiligenceReport shape; different regulatory anchor."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Due Diligence Regulation Context"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <http://data.europa.eu/m8g/isDerivedFrom>;
    skos:closeMatch <https://vocabulary.uncefact.org/untp/regulation>, <https://vocabulary.uncefact.org/untp/referenceRegulation>;
    rdfs:range gs1:RegulatoryInformation;
    rdfs:domain oec:DueDiligenceReport.
oec:supplyChainTransparencyUrl a owl:DatatypeProperty;
    rdfs:comment "URL of a public supply-chain map / transparency endpoint (CSDDD Article 16, ESPR Article 7)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Supply-Chain Transparency URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DueDiligenceReport.
oec:forcedLabourFreeAssertion a owl:DatatypeProperty;
    rdfs:comment "Boolean assertion that the product is free of forced labour per EU Regulation 2024/3015. Substantiate with dueDiligenceReport URL + thirdPartyAssurance evidence."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/3015>;
    rdfs:label "Forced-Labour-Free Assertion"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:boolean;
    rdfs:domain oec:DueDiligenceReport.
oec:isStrategicRawMaterial a owl:DatatypeProperty;
    rdfs:comment "Boolean flag: material is on the EU Strategic Raw Materials list per CRMA Annex I (2024/1252). Strategic ⊂ Critical: every strategic raw material is also a critical raw material, but not vice versa."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1252>;
    rdfs:label "Is Strategic Raw Material"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <https://w3id.org/eudpp#isCriticalRawMaterial>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#isCriticalRawMaterial>, <https://dpp-keystone.org/spec/v2/terms#criticalRawMaterials>;
    rdfs:range xsd:boolean;
    rdfs:domain oec:MaterialComposition;
    skos:broader oec:isCriticalRawMaterial.
oec:crmListVersion a owl:DatatypeProperty;
    rdfs:comment "Version reference of the EU Critical Raw Materials list against which the isCriticalRawMaterial / isStrategicRawMaterial flags were determined (e.g. CRMA-2024 Annex II / Annex I). The list is updated periodically by the Commission."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "CRM List Version"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#dppSchemaVersion>, <https://vocabulary.uncefact.org/untp/version>, <https://dpp-keystone.org/spec/v2/terms#versionNumber>;
    rdfs:range xsd:string;
    rdfs:domain oec:MaterialComposition.
oec:remanufacturingDate a owl:DatatypeProperty;
    rdfs:seeAlso <https://gs1-epcis-reg.org/rail/voc/data#itemReconditioningDate>;
    rdfs:comment "Date on which a product was remanufactured or refurbished and re-released as fit for purpose. Cross-sector: applies to any DPP-covered product that re-enters service after refurbishment (rail rolling stock, batteries, electronics, textiles)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Remanufacturing / refurbishment date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "No upstream equivalent: GS1 Web Vocabulary covers production dates but not refurbishment; schema.org has schema:productionDate / schema:purchaseDate but no remanufacture/reconditioning date; SEMICeu does not cover product lifecycle dates."@en;
    skos:narrowMatch <https://gs1-epcis-reg.org/rail/voc/data#itemReconditioningDate>;
    rdfs:range xsd:dateTime;
    rdfs:domain schema:Product.
oec:EnvironmentalProductDeclaration a owl:Class;
    rdfs:seeAlso oec:EmissionsPerformance, oec:CarbonFootprintDeclaration, <https://dpp-keystone.org/spec/v2/terms#EPDBlock>, <https://w3id.org/eudpp#EPDStudy>, <https://w3id.org/eudpp#EPDDocument>;
    rdfs:comment "A type III environmental declaration per EN 15804:2012+A2:2019 / ISO 14025,\nreporting life-cycle environmental impact indicators broken down by lifecycle module."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Environmental Product Declaration"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf schema:Certification;
    skos:note "Required extension: EN 15804 EPDs carry a full impact-indicator set with modular\nlifecycle breakdown not covered by GS1 Web Vocabulary, schema.org, or SEMICeu. Aligned with\nDPP Keystone dppk:EPDBlock (peer DPP profile). For a single aggregate carbon figure use\noec:carbonFootprintTotal; for a 5-stage carbon breakdown use oec:CarbonFootprintDeclaration."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>;
    skos:exactMatch <https://w3id.org/eudpp#EPDDocument>.
oec:ImpactIndicatorResult a owl:Class;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#ImpactValues>, <https://w3id.org/eudpp#LCAResult>;
    rdfs:comment "One environmental impact indicator (e.g. Global Warming Potential) reported within\nan EPD: its indicator type, declared unit, aggregate value, and optional per-lifecycle-module values."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Impact Indicator Result"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 impact-indicator result. Anchored to DPP Keystone dppk:ImpactValues (peer DPP profile)."@en;
    skos:broadMatch <https://w3id.org/eudpp#ImpactCategoryIndicator>, <https://w3id.org/eudpp#LcaResult>;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#ImpactValues>.
oec:LifecycleStageResult a owl:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#LCIAModuleValue>;
    rdfs:comment "The value of an impact indicator for a single EN 15804 lifecycle module (e.g. A1, B6, C3, D)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Lifecycle Stage Result"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 modular lifecycle value. Pairs an oec:LifecycleStage code with a decimal value in the indicator's declared unit."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>, <https://w3id.org/eudpp#LcaResult>.
oec:ImpactIndicatorType a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#EN15804ImpactIndicator>, <https://w3id.org/eudpp#LCIAImpactIndicator>;
    rdfs:comment "Controlled list of EN 15804:2012+A2:2019 environmental impact indicators."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Impact Indicator Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804+A2 core impact category set."@en;
    skos:broadMatch <https://w3id.org/eudpp#ImpactType>, <https://w3id.org/eudpp#ImpactCategory>.
oec:GWPTotal a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#gwp>;
    rdfs:label "Global Warming Potential, total"@en;
    skos:notation "GWP-total".
oec:GWPFossil a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#gwpF>;
    rdfs:label "Global Warming Potential, fossil"@en;
    skos:notation "GWP-fossil".
oec:GWPBiogenic a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#gwpB>;
    rdfs:label "Global Warming Potential, biogenic"@en;
    skos:notation "GWP-biogenic".
oec:GWPLuluc a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#gwpLuluc>;
    rdfs:label "Global Warming Potential, land use and land-use change"@en;
    skos:notation "GWP-luluc".
oec:ODP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#odp>;
    rdfs:label "Depletion potential of the stratospheric ozone layer"@en;
    skos:notation "ODP".
oec:AP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#ap>;
    rdfs:label "Acidification potential"@en;
    skos:notation "AP".
oec:EPFreshwater a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#epF>;
    rdfs:label "Eutrophication potential, freshwater"@en;
    skos:notation "EP-freshwater".
oec:EPMarine a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#epM>;
    rdfs:label "Eutrophication potential, marine"@en;
    skos:notation "EP-marine".
oec:EPTerrestrial a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#epT>;
    rdfs:label "Eutrophication potential, terrestrial"@en;
    skos:notation "EP-terrestrial".
oec:POCP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#pocp>;
    rdfs:label "Formation potential of tropospheric ozone"@en;
    skos:notation "POCP".
oec:ADPElements a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#adpe>;
    rdfs:label "Abiotic depletion potential, minerals and metals"@en;
    skos:notation "ADP-minerals&metals".
oec:ADPFossil a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#adpf>;
    rdfs:label "Abiotic depletion potential, fossil resources"@en;
    skos:notation "ADP-fossil".
oec:LifecycleStage a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#LifeCycleModule>;
    rdfs:comment "Controlled list of EN 15804 lifecycle modules (product, construction, use, end-of-life, and benefits beyond the system boundary)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Lifecycle Stage"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 modular lifecycle stages."@en.
oec:StageA1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a1>;
    rdfs:label "A1 Raw material supply"@en;
    skos:notation "A1".
oec:StageA2 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a2>;
    rdfs:label "A2 Transport to manufacturer"@en;
    skos:notation "A2".
oec:StageA3 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a3>;
    rdfs:label "A3 Manufacturing"@en;
    skos:notation "A3".
oec:StageA4 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a4>;
    rdfs:label "A4 Transport to site"@en;
    skos:notation "A4".
oec:StageA5 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#a5>;
    rdfs:label "A5 Installation"@en;
    skos:notation "A5".
oec:StageB1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b1>;
    rdfs:label "B1 Use"@en;
    skos:notation "B1".
oec:StageB2 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b2>;
    rdfs:label "B2 Maintenance"@en;
    skos:notation "B2".
oec:StageB3 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b3>;
    rdfs:label "B3 Repair"@en;
    skos:notation "B3".
oec:StageB4 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b4>;
    rdfs:label "B4 Replacement"@en;
    skos:notation "B4".
oec:StageB5 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b5>;
    rdfs:label "B5 Refurbishment"@en;
    skos:notation "B5".
oec:StageB6 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b6>;
    rdfs:label "B6 Operational energy use"@en;
    skos:notation "B6".
oec:StageB7 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#b7>;
    rdfs:label "B7 Operational water use"@en;
    skos:notation "B7".
oec:StageC1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#c1>;
    rdfs:label "C1 Deconstruction / demolition"@en;
    skos:notation "C1".
oec:StageC2 a oec:LifecycleStage;
    rdfs:label "C2 Transport to waste processing"@en;
    skos:notation "C2".
oec:StageC3 a oec:LifecycleStage;
    rdfs:label "C3 Waste processing"@en;
    skos:notation "C3".
oec:StageC4 a oec:LifecycleStage;
    rdfs:label "C4 Disposal"@en;
    skos:notation "C4".
oec:StageD a oec:LifecycleStage;
    rdfs:label "D Benefits and loads beyond the system boundary"@en;
    skos:notation "D".
oec:hasEnvironmentalProductDeclaration a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#epd>;
    rdfs:comment "Links a product to its EN 15804 environmental product declaration."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Environmental Product Declaration"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 EPD link. Anchored to DPP Keystone dppk:epd (peer DPP profile)."@en;
    rdfs:range oec:EnvironmentalProductDeclaration;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#epd>.
oec:epdRegistrationNumber a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#registrationNumber>;
    rdfs:comment "Registration / declaration number assigned by the EPD programme operator."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPD Registration Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    skos:broadMatch gs1:regulatoryReferenceNumber;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:productCategoryRules a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#PCR>, <https://w3id.org/eudpp#PEFCR>, <https://w3id.org/eudpp#referenceToPCR>, <https://w3id.org/eudpp#referenceToPEFCR>;
    rdfs:comment "URI of the Product Category Rules (PCR) or Product Environmental Footprint Category Rules (PEFCR) document under which the environmental declaration was produced."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Product Category Rules"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ISO 14025 / EN 15804 EPD metadata: results are only comparable within one PCR/PEFCR, so the passport must say which one applies. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:narrowMatch <https://w3id.org/eudpp#referenceToPEFCR>;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdProgramOperator a owl:DatatypeProperty;
    rdfs:comment "Name of the EPD programme operator (e.g. EPD International, IBU, EcoPlatform)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPD Programme Operator"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#operatorInformation>;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdStandard a owl:DatatypeProperty;
    rdfs:comment "Reference standard and product category rules version used (e.g. EN 15804+A2)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPD Reference Standard"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdValidUntil a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#expiryDate>;
    rdfs:comment "Date until which the EPD is valid."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "EPD Valid Until"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    skos:broadMatch schema:validThrough;
    rdfs:range xsd:date;
    rdfs:domain oec:EnvironmentalProductDeclaration;
    skos:exactMatch schema:validUntil.
oec:hasImpactIndicator a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#indicator>;
    rdfs:comment "An environmental impact indicator result reported within the EPD."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Impact Indicator"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 impact indicator. Anchored to DPP Keystone dppk:indicator (peer DPP profile)."@en;
    rdfs:range oec:ImpactIndicatorResult;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:hasIndicatorType a owl:ObjectProperty;
    rdfs:comment "The EN 15804 impact category this result reports (e.g. oec:GWPTotal)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Indicator Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804+A2 impact category selector."@en;
    rdfs:range oec:ImpactIndicatorType;
    rdfs:domain oec:ImpactIndicatorResult.
oec:indicatorUnit a owl:DatatypeProperty;
    rdfs:comment "Declared unit for this indicator (e.g. kg CO2 eq, kg CFC11 eq, mol H+ eq, m3 world eq deprived)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Indicator Unit"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 declared characterisation unit for the indicator."@en;
    skos:closeMatch gs1:unitCode;
    rdfs:range xsd:string;
    rdfs:domain oec:ImpactIndicatorResult.
oec:indicatorTotalValue a owl:DatatypeProperty;
    rdfs:seeAlso schema:value, gs1:value;
    rdfs:comment "Aggregate value of the indicator across the declared lifecycle modules, in the declared unit."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Indicator Total Value"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 aggregate indicator value. Use oec:hasLifecycleStageResult for the modular breakdown."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:ImpactIndicatorResult.
oec:hasLifecycleStageResult a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>;
    rdfs:comment "A single EN 15804 module value contributing to this indicator."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Lifecycle Stage Result"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 modular lifecycle breakdown."@en;
    rdfs:range oec:LifecycleStageResult;
    rdfs:domain oec:ImpactIndicatorResult.
oec:hasLifecycleStage a owl:ObjectProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#hasLifeCycleStage>;
    rdfs:comment "The EN 15804 lifecycle module this value applies to (e.g. oec:StageA1)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Lifecycle Stage"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 module selector."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#lifecycleStage>;
    rdfs:range oec:LifecycleStage;
    rdfs:domain oec:LifecycleStageResult.
oec:stageValue a owl:DatatypeProperty;
    rdfs:seeAlso schema:value, gs1:value, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingPowerCapabilityValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#numberOfFullCyclesValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingCapacityValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#capacityThroughputValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#internalResistanceIncreaseValue>;
    rdfs:comment "Indicator value for this lifecycle module, in the indicator's declared unit."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Stage Value"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 15804 modular value. DPP Keystone expresses these as flat dppk:a1..dppk:d properties; here normalised as oec:LifecycleStage + oec:stageValue pairs."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>, <http://data.europa.eu/m8g/value>, <urn:samm:io.BatteryPass.Performance:1.2.1#evolutionOfSelfDischargeValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#energyThroughputValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingEnergyValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#capacityFadeValue>;
    rdfs:range xsd:decimal;
    rdfs:domain oec:LifecycleStageResult.
<https://ref.openepcis.io/extensions/eu/ppwr/> a owl:Ontology;
    dcterms:title "OpenEPCIS PPWR Vocabulary"@en;
    dcterms:description "Vocabulary for the EU Packaging and Packaging Waste Regulation\n(Regulation 2025/40, in force since 2025-02-11; general application from\n2026-08-12; harmonised labelling per Article 12 from 2028-08-12;\nrecyclability grading (Article 6, Annex II) mandatory from 2030-01-01 with\nGrade C minimum; Grades A/B only from 2038-01-01).\n\nThis module is intentionally thin: nearly every PPWR data point reuses the\nGS1 Web Vocabulary packaging model (gs1:PackagingDetails,\ngs1:PackagingMaterialDetails, gs1:ReturnablePackageDepositDetails) plus the\ncross-cutting `oec:` and `untp:` vocabulary already lifted to common/core.\nPackaging-specific concepts only live here:\n\n  - `euppwr:Packaging` (subClassOf gs1:PackagingDetails)\n  - `euppwr:hasPackagingTier` (Sales / Grouped / Transport; Article 3)\n  - `euppwr:hasRecyclabilityGrade` (A / B / C; Article 6, Annex II)\n  - `euppwr:harmonisedSymbol` (URI of an Article 12 harmonised label entry)\n  - `euppwr:designForRecyclingMethodology` (D4R methodology citation)\n  - `euppwr:hasReuseInformation` / `euppwr:ReuseInformation` with\n    `euppwr:hasReuseSystemScope` (local / national / Union-wide),\n    `euppwr:reuseSystemName`, `euppwr:collectionPointsUrl`,\n    `euppwr:averageRotationsEstimate` and the event-capable\n    `euppwr:rotationCount` (Article 12(2) reuse QR data)\n  - `euppwr:depositRefundIssued` / `euppwr:containerCondition`\n    (deposit-return EPCIS observation properties)\n  - `euppwr:RegulationTypeCode-PACKAGING_AND_PACKAGING_WASTE_REGULATION`\n    (module-owned gs1:RegulationTypeCode member; the upstream code list has\n    no packaging-waste entry)\n\nMaterial composition, recycling process and deposit amounts use the GS1\npackaging terms directly (gs1:packagingMaterial, gs1:packagingMaterialType,\ngs1:packagingRecyclingProcessType, gs1:hasReturnablePackageDeposit).\nRecyclability scoring/rate, recycled content, reuse, compostability,\nbio-based content, hazardous substances, EPR, production site and the\ndeclaration of conformity all use existing `oec:` / `untp:` / `gs1:`\nterms. Alignment reference: GS1 in Europe White Paper \"Packaging and\nPackaging Waste Regulation and GS1 standards\"."@en;
    dcterms:creator "OpenEPCIS";
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0>;
    dcterms:created "2026-05-01"^^xsd:date;
    dcterms:modified "2026-08-04"^^xsd:date;
    owl:versionInfo "0.9.9";
    owl:versionIRI <https://ref.openepcis.io/extensions/eu/ppwr/0.9.9>;
    <http://purl.org/vocab/vann/preferredNamespacePrefix> "euppwr";
    <http://purl.org/vocab/vann/preferredNamespaceUri> "https://ref.openepcis.io/extensions/eu/ppwr/";
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>.
<https://ref.openepcis.io/extensions/eu/ppwr/Packaging> a owl:Class;
    rdfs:seeAlso gs1:PackagingMaterialDetails, gs1:ReturnablePackageDepositDetails, <https://dpp-keystone.org/spec/v2/terms#Packaging>, gs1:packaging;
    rdfs:comment "A packaging item subject to EU Regulation 2025/40 (PPWR). Carrier\nfor the regulation's labelling and DPP data points. Reached from a trade\nitem via gs1:packaging (gs1:Product → gs1:PackagingDetails); when packaging\nis itself placed on the market as a trade item (e.g. an empty e-commerce\ncarton), type the node as both gs1:Product and euppwr:Packaging. Use\npackagingTier for the sales/grouped/transport position; use\nrecyclabilityGrade, gs1:packagingMaterial, gs1:packagingRecyclingProcessType,\ngs1:hasReturnablePackageDeposit, oec:recycledContent, oec:Compostability,\noec:bioBasedFraction, etc. for the substantive declarations. Identified via\ngs1:gtin; reusable/returnable packaging assets use GRAI (AI 8003)."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "PPWR Packaging"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    rdfs:subClassOf gs1:PackagingDetails;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. Subclass of gs1:PackagingDetails: the GS1 Web Vocabulary packaging model carries the material, recycling-process and deposit data points; this subclass adds only the PPWR-specific regulatory expressions (tier, grade, harmonised symbol). Aligns approximately with the DPP Keystone packaging card dppk:Packaging (material-composition oriented) vs this item-level class."@en;
    skos:broadMatch gs1:PackagingDetails;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#Packaging>.
<https://ref.openepcis.io/extensions/eu/ppwr/PackagingTier> a owl:Class;
    rdfs:comment "Position of the packaging in the consumption hierarchy per PPWR\nArticle 3: sales (consumer-facing primary), grouped (secondary, multi-unit),\nor transport (tertiary, logistics)."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Packaging Tier"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    owl:oneOf _:n3-4348.
_:n3-4348 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/Sales>;
    rdf:rest _:n3-4349.
<https://ref.openepcis.io/extensions/eu/ppwr/Sales> a <https://ref.openepcis.io/extensions/eu/ppwr/PackagingTier>;
    rdfs:comment "Primary packaging: consumer-facing point-of-sale unit (PPWR Art. 3(1)(b))."@en;
    rdfs:label "Sales Packaging"@en;
    skos:notation "sales".
_:n3-4349 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/Grouped>;
    rdf:rest _:n3-4350.
<https://ref.openepcis.io/extensions/eu/ppwr/Grouped> a <https://ref.openepcis.io/extensions/eu/ppwr/PackagingTier>;
    rdfs:comment "Secondary packaging: groups multiple sales units, may be removed without affecting product (PPWR Art. 3(1)(c))."@en;
    rdfs:label "Grouped Packaging"@en;
    skos:notation "grouped".
_:n3-4350 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/Transport>;
    rdf:rest rdf:nil.
<https://ref.openepcis.io/extensions/eu/ppwr/Transport> a <https://ref.openepcis.io/extensions/eu/ppwr/PackagingTier>;
    rdfs:comment "Tertiary packaging: facilitates handling/transport of grouped or sales packaging (PPWR Art. 3(1)(d))."@en;
    rdfs:label "Transport Packaging"@en;
    skos:notation "transport".
<https://ref.openepcis.io/extensions/eu/ppwr/hasPackagingTier> a owl:ObjectProperty;
    rdfs:comment "Indicates whether the packaging is sales (primary), grouped (secondary), or transport (tertiary) per PPWR Article 3."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Packaging Tier"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/ppwr/PackagingTier>;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/ppwr/Packaging>.
<https://ref.openepcis.io/extensions/eu/ppwr/RecyclabilityGrade> a owl:Class;
    rdfs:seeAlso oec:CircularityPerformance;
    rdfs:comment "Recyclability performance grade per PPWR Article 6 and Annex II:\ndesign-for-recycling assessment per unit in weight — Grade A (≥ 95 %),\nGrade B (≥ 80 %), Grade C (≥ 70 %); below 70 % the packaging is considered\ntechnically non-recyclable. Grade C is the minimum to be placed on the EU\nmarket from 2030; from 2038 only Grades A and B may be placed. The detailed\nAnnex II methodology is operator-side; the grade is the regulatory\noutput."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "PPWR Recyclability Grade"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "Packaging recyclability / circularity concept per the EU Packaging and Packaging Waste Regulation (EU) 2025/40."@en;
    owl:oneOf _:n3-4351.
_:n3-4351 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/GradeA>;
    rdf:rest _:n3-4352.
<https://ref.openepcis.io/extensions/eu/ppwr/GradeA> a <https://ref.openepcis.io/extensions/eu/ppwr/RecyclabilityGrade>;
    rdfs:comment "Highest recyclability performance per PPWR Annex II: ≥ 95 % of unit weight recyclable."@en;
    rdfs:label "Grade A"@en;
    skos:notation "A".
_:n3-4352 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/GradeB>;
    rdf:rest _:n3-4353.
<https://ref.openepcis.io/extensions/eu/ppwr/GradeB> a <https://ref.openepcis.io/extensions/eu/ppwr/RecyclabilityGrade>;
    rdfs:comment "Recyclability per PPWR Annex II: ≥ 80 % of unit weight recyclable. Minimum grade from 2038."@en;
    rdfs:label "Grade B"@en;
    skos:notation "B".
_:n3-4353 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/GradeC>;
    rdf:rest rdf:nil.
<https://ref.openepcis.io/extensions/eu/ppwr/GradeC> a <https://ref.openepcis.io/extensions/eu/ppwr/RecyclabilityGrade>;
    rdfs:comment "Lowest acceptable recyclability per PPWR Annex II: ≥ 70 % of unit weight recyclable. Minimum grade from 2030; cannot be placed on the market from 2038."@en;
    rdfs:label "Grade C"@en;
    skos:notation "C".
<https://ref.openepcis.io/extensions/eu/ppwr/hasRecyclabilityGrade> a owl:ObjectProperty;
    rdfs:seeAlso oec:CircularityPerformance;
    rdfs:comment "PPWR Article 6 letter grade (A/B/C). Companion to oec:recyclabilityScore (numeric, JRC-style) and oec:recyclabilityRate (decimal fraction); use the grade for regulatory expression and a score/rate for the underlying methodology output."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "PPWR Recyclability Grade"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "Packaging recyclability / circularity concept per the EU Packaging and Packaging Waste Regulation (EU) 2025/40."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/ppwr/RecyclabilityGrade>;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/ppwr/Packaging>.
<https://ref.openepcis.io/extensions/eu/ppwr/harmonisedSymbol> a owl:DatatypeProperty;
    rdfs:comment "URI / code reference of a harmonised PPWR Article 12 label\nthat appears on the packaging: material-composition pictograms,\nseparate-collection indicators, deposit-return labels, etc. The Commission\nestablishes the harmonised labels by implementing acts (due 2026-08-12,\napplying from 2028-08-12); this property points to the catalogue entry.\nUntil the implementing acts publish the label registry, use a documented\nplaceholder URI."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Harmonised Symbol"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:narrowMatch <https://dpp-keystone.org/spec/v2/terms#separateCollectionSymbol>;
    rdfs:range xsd:anyURI;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/ppwr/Packaging>.
<https://ref.openepcis.io/extensions/eu/ppwr/RegulationTypeCode-PACKAGING_AND_PACKAGING_WASTE_REGULATION> a gs1:RegulationTypeCode;
    rdfs:seeAlso gs1:RegulationTypeCode-PACKAGING_SAFETY_DIRECTIVE, gs1:RegulationTypeCode-PLASTIC_DIRECTIVE;
    rdfs:comment "Regulation (EU) 2025/40 on packaging and packaging waste (PPWR),\nreplacing Directive 94/62/EC. Use as the gs1:regulationType of a\ngs1:RegulatoryInformation entry declaring PPWR compliance."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Packaging and Packaging Waste Regulation"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "Module-owned member of the gs1:RegulationTypeCode code list: the upstream list has no packaging-waste entry (gs1:RegulationTypeCode-PACKAGING_SAFETY_DIRECTIVE covers child-resistant packaging safety, not packaging waste). Candidate for upstream GS1 code-list submission."@en;
    skos:prefLabel "PACKAGING_AND_PACKAGING_WASTE_REGULATION".
<https://ref.openepcis.io/extensions/eu/ppwr/designForRecyclingMethodology> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/ppwr/hasRecyclabilityGrade>;
    rdfs:comment "Name and version of the design-for-recycling (D4R) assessment\nmethodology substantiating a recyclabilityGrade, e.g. \"RecyClass v2.6\",\n\"CEFLEX D4ACE\", \"APR Design Guide\". Cited in the recyclability-grade\ndeclaration observation until the Commission's Annex II delegated acts\nprescribe the harmonised methodology."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Design-for-Recycling Methodology"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute (Article 4 / Annex II supporting evidence). No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:string.
<https://ref.openepcis.io/extensions/eu/ppwr/ReuseInformation> a owl:Class;
    rdfs:seeAlso oec:DepositReturnScheme, oec:EndOfLifeProgram, gs1:packagingRecyclingProcessType;
    rdfs:comment "Reuse data card of a reusable packaging item per PPWR Article 12(2):\nfrom 2029-02-12 reusable packaging must bear a reuse label plus a QR code or\nother standardised, open, digital data carrier making available further\ninformation on reusability, including the availability of a local, national\nor Union-wide re-use system, information on collection points, and the\ncalculation of trips and rotations or, if that calculation is not feasible,\nan average estimation. Reusability itself is defined by the nine Article 11(1)\ncriteria and demonstrated in the Annex VII technical information (Article\n11(3)). Open-loop systems without a system operator per Annex VI are exempt\nfrom the label and QR duty (Article 12(3))."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Reuse Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. gs1:packagingRecyclingProcessType REUSABLE carries the reusability claim and oec:EndOfLifeProgram / oec:DepositReturnScheme carry waste take-back and deposit programmes; the Article 12(2) re-use-system data set (system scope, collection points, trips/rotations) has no GS1, SEMICeu, schema.org or oec carrier."@en.
<https://ref.openepcis.io/extensions/eu/ppwr/hasReuseInformation> a owl:ObjectProperty;
    rdfs:seeAlso gs1:hasReturnablePackageDeposit;
    rdfs:comment "Links a reusable packaging item to its PPWR Article 12(2) reuse data card (re-use system, collection points, trips/rotations)."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Reuse Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range <https://ref.openepcis.io/extensions/eu/ppwr/ReuseInformation>;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/ppwr/Packaging>.
<https://ref.openepcis.io/extensions/eu/ppwr/ReuseSystemScope> a owl:Class;
    rdfs:comment "Geographic availability of the re-use system a reusable packaging\nitem participates in, per PPWR Article 12(2): \"the availability of a local,\nnational or Union-wide system for re-use\"."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Reuse System Scope"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    owl:oneOf _:n3-4354.
_:n3-4354 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/LocalSystem>;
    rdf:rest _:n3-4355.
<https://ref.openepcis.io/extensions/eu/ppwr/LocalSystem> a <https://ref.openepcis.io/extensions/eu/ppwr/ReuseSystemScope>;
    rdfs:comment "Re-use system available locally, e.g. a city or venue pool system (PPWR Art. 12(2))."@en;
    rdfs:label "Local Re-use System"@en;
    skos:notation "local".
_:n3-4355 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/NationalSystem>;
    rdf:rest _:n3-4356.
<https://ref.openepcis.io/extensions/eu/ppwr/NationalSystem> a <https://ref.openepcis.io/extensions/eu/ppwr/ReuseSystemScope>;
    rdfs:comment "Re-use system available throughout one Member State (PPWR Art. 12(2))."@en;
    rdfs:label "National Re-use System"@en;
    skos:notation "national".
_:n3-4356 rdf:first <https://ref.openepcis.io/extensions/eu/ppwr/UnionWideSystem>;
    rdf:rest rdf:nil.
<https://ref.openepcis.io/extensions/eu/ppwr/UnionWideSystem> a <https://ref.openepcis.io/extensions/eu/ppwr/ReuseSystemScope>;
    rdfs:comment "Re-use system available across the Union (PPWR Art. 12(2))."@en;
    rdfs:label "Union-wide Re-use System"@en;
    skos:notation "union-wide".
<https://ref.openepcis.io/extensions/eu/ppwr/hasReuseSystemScope> a owl:ObjectProperty;
    rdfs:comment "Whether the re-use system the packaging participates in is available locally, nationally or Union-wide (PPWR Art. 12(2))."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Reuse System Scope"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch <https://vocabulary.uncefact.org/untp/geographicScope>;
    rdfs:range <https://ref.openepcis.io/extensions/eu/ppwr/ReuseSystemScope>;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/ppwr/ReuseInformation>.
<https://ref.openepcis.io/extensions/eu/ppwr/reuseSystemName> a owl:DatatypeProperty;
    rdfs:seeAlso schema:provider;
    rdfs:comment "Name of the re-use system or system operator (PPWR Annex VI) the\nreusable packaging participates in. Open-loop systems without a system\noperator per Annex VI are exempt from the Article 12(2) label and QR duty\n(Article 12(3))."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Reuse System Name"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:string;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/ppwr/ReuseInformation>.
<https://ref.openepcis.io/extensions/eu/ppwr/collectionPointsUrl> a owl:DatatypeProperty;
    rdfs:comment "URL of the directory or map of collection points where the reusable packaging can be returned into the re-use system (PPWR Art. 12(2))."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Collection Points URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "Re-use collection points per PPWR Art. 12(2). oec:collectionPointDirectoryUrl carries the same idea but is domained to oec:EndOfLifeProgram (waste take-back); a re-use system is not an end-of-life programme, hence this term with an explicit anchor."@en;
    skos:closeMatch oec:collectionPointDirectoryUrl;
    rdfs:range xsd:anyURI;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/ppwr/ReuseInformation>.
<https://ref.openepcis.io/extensions/eu/ppwr/rotationCount> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/ppwr/averageRotationsEstimate>;
    rdfs:comment "Number of trips/rotations a tracked reusable packaging item has\naccomplished. PPWR Article 12(2): the reuse QR code (or other standardised,\nopen, digital data carrier) facilitates the tracking of the packaging and\nthe calculation of trips and rotations. Deliberately domain-less: usable in\nthe euppwr:ReuseInformation card and as an EPCIS event-level observation\nproperty (peer of euppwr:containerCondition) captured at return or refill."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Rotation Count"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:integer.
<https://ref.openepcis.io/extensions/eu/ppwr/averageRotationsEstimate> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.io/extensions/eu/ppwr/rotationCount>;
    rdfs:comment "Average estimation of the trips/rotations the reusable packaging\naccomplishes — the PPWR Article 12(2) fallback where per-item calculation is\nnot feasible. The Commission's Article 11(2) delegated act (due 2027-02-12)\nwill establish a minimum number of rotations for the most frequently reused\npackaging formats."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Average Rotations Estimate"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.io/extensions/eu/ppwr/ReuseInformation>.
<https://ref.openepcis.io/extensions/eu/ppwr/depositRefundIssued> a owl:DatatypeProperty;
    rdfs:seeAlso gs1:returnablePackageDepositAmount;
    rdfs:comment "Monetary amount refunded when a deposit-bearing packaging item is\nreturned (PPWR Article 50 deposit-return systems). EPCIS event-level\nobservation property, typically a sensorReport entry of a decommissioning\nevent captured by a reverse-vending machine; the currency travels in the\nreport's uom. The static deposit amount of the packaging model is\nresolver-served master data via gs1:hasReturnablePackageDeposit /\ngs1:returnablePackageDepositAmount."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Deposit Refund Issued"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. Event-bound refund amount; gs1:returnablePackageDepositAmount carries the model-level deposit, not the transaction."@en;
    rdfs:range xsd:decimal.
<https://ref.openepcis.io/extensions/eu/ppwr/containerCondition> a owl:DatatypeProperty;
    rdfs:comment "Observed physical condition of a returned packaging item at\nredemption or take-back, e.g. \"intact\", \"crushed\", \"contaminated\". Drives\nrouting between reuse (washing/refill) and recycling streams in\ndeposit-return and reuse systems (PPWR Articles 27, 50)."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32025R0040>;
    rdfs:label "Container Condition"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/eu/ppwr/>;
    skos:note "EU Packaging and Packaging Waste Regulation (EU) 2025/40 attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch schema:itemCondition;
    rdfs:range xsd:string.
