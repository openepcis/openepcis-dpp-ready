    skos:narrowMatch <https://w3id.org/eudpp#lastUpdate>;
    rdfs:range xsd:dateTime;
    skos:exactMatch <urn:samm:io.BatteryPass.Performance:1.2.1#lastUpdate>, <https://dpp-keystone.org/spec/v2/terms#lastUpdate>.
oec:dataQualityAssessment a owl:DatatypeProperty;
    rdfs:comment "Assessment of data quality and completeness (A-E rating)."@en;
