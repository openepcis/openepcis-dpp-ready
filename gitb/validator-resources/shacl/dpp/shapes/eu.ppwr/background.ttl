# GENERATED — background knowledge for validation type "eu.ppwr".
# Class hierarchy and code-list individuals: sh:class and the subclass
# resolution behind sh:targetClass are evaluated over the data graph, and
# the validator merges this shape graph into the input before validating.
# Sources: extensions/common/core/ontology/dpp-core.ttl, extensions/eu/ppwr/ontology/ppwr.ttl
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix gs1: <https://ref.gs1.org/voc/>.
@prefix schema: <https://schema.org/>.
@prefix oec: <https://ref.openepcis.io/extensions/common/core/>.
@prefix dpp-sh: <https://ref.openepcis.io/extensions/common/core/shapes/>.

<https://ref.openepcis.io/extensions/common/core/> a owl:Ontology;
    dcterms:title "OpenEPCIS DPP Core Vocabulary"@en;
    dcterms:description "Core vocabulary for Digital Product Passports aligned with the EU Ecodesign\nfor Sustainable Products Regulation (ESPR) EU 2024/1781 and GS1 DPP Standards.\n\nOpenEPCIS DPP-Ready: The Universal DPP Platform - harmonizing GS1, UNTP, and CIRPASS2 standards.\n\nThis vocabulary provides shared patterns reusable across domain-specific regulations\n(Battery, EUDR, Textile, Electronics, etc.) and supports the ESPR framework including:\n- Economic operator identification (EOID per ESPR Article 77)\n- Facility information (manufacturing location data)\n- Performance and durability information\n- Repairability and maintenance data\n- Substances of concern (SCIP database alignment)\n- Circularity information (end-of-life, recycling)\n- Due diligence reporting (supply chain transparency)\n- Document references (reports, certificates, guides)\n- Access rights (public vs authorized data per ESPR Article 9)\n- Emissions performance (carbon footprint with UNTP alignment)\n- Traceability performance (supply chain verification metrics)\n\nGS1 Web Vocabulary patterns to use:\n- For certifications: gs1:certification with gs1:CertificationDetails\n- For warranty: gs1:manufacturersWarranty with gs1:WarrantyPromise (product-scoped; gs1:warranty is Offer-scoped)\n- For regulatory compliance: gs1:regulatoryInformation with gs1:RegulatoryInformation\n- For documents: gs1:referencedFile with gs1:ReferencedFileDetails\n- For recycling text: gs1:consumerRecyclingInstructions\n\nUNTP Alignment:\nProperty naming, patterns, and value conventions are aligned with UN Transparency Protocol (UNTP)\nto enable native interoperability. Cross-vocabulary mappings are declared via graded SKOS relations\n(skos:exactMatch for 1:1, skos:closeMatch for approximate, skos:broadMatch where this term is narrower).\nAll ratio/fraction properties use 0-1 decimal scale (e.g., 0.45 = 45%).\n\nEPCIS 2.0 Extension Declaration:\nGS1-Extensions: oec=https://ref.openepcis.io/extensions/common/core/\n\nExtension Governance:\nThis vocabulary extends GS1 Web Vocabulary only where no equivalent term exists.\nEach extension term includes:\n- dcterms:source linking to the regulatory requirement\n- skos:note explaining why the extension is needed\n- rdfs:seeAlso linking to related GS1/schema.org/UNTP terms where applicable\n- a graded SKOS mapping relation (skos:exactMatch / skos:closeMatch / skos:broadMatch) where a cross-vocabulary match exists\n\nDomain-specific vocabularies import this core and add regulation-specific extensions."@en;
    dcterms:creator "OpenEPCIS";
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0>;
    dcterms:created "2024-01-15"^^xsd:date;
    dcterms:modified "2026-06-19"^^xsd:date;
    owl:versionInfo "0.9.9";
    owl:versionIRI <https://ref.openepcis.io/extensions/common/core/0.9.9>;
    <http://purl.org/vocab/vann/preferredNamespacePrefix> "oec";
    <http://purl.org/vocab/vann/preferredNamespaceUri> "https://ref.openepcis.io/extensions/common/core/";
    rdfs:seeAlso <https://ref.gs1.org/voc/>, gs1:CertificationDetails, gs1:WarrantyPromise, <https://ref.gs1.org/standards/epcis/>, <https://eur-lex.europa.eu/eli/reg/2024/1781>, <https://ref.gs1.org/standards/>, <https://gs1.eu/wp-content/uploads/2025/02/GDSN-Implementation-Guideline-for-exchanging-Carbon-Footprint-Data-3.pdf>, <https://untp.unece.org/docs/specification/>;
    rdfs:comment "Aligned with UN Transparency Protocol patterns"@en;
    dcterms:source <https://untp.unece.org/docs/specification/>.
oec:OperatorInformation a rdfs:Class;
    rdfs:seeAlso gs1:Organization, schema:Organization, <http://www.w3.org/ns/legal#LegalEntity>, <https://w3id.org/eudpp#Actor>, <https://w3id.org/eudpp#LegalPerson>, <https://w3id.org/eudpp#ManufacturerRecord>, <https://dpp-keystone.org/spec/v2/terms#EconomicOperatorRole>;
    rdfs:comment "Economic operator information as required by various EU regulations.\nCaptures manufacturer, importer, distributor, and other operator roles.\nUse gs1:globalLocationNumber for operator identification (inherited from gs1:Organization).\nUse GS1 Digital Link format: https://id.gs1.org/417/{GLN}"@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32019R1020>;
    rdfs:label "Operator Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf gs1:Organization;
    skos:note "Extension of gs1:Organization to capture ESPR-specific operator role requirements.\nUse gs1:globalLocationNumber for operator GLN, gs1:organizationName for name.\nGS1 Web Vocabulary provides gs1:Organization but lacks the specific operator role enumeration\nrequired by EU Market Surveillance Regulation 2019/1020 and ESPR Article 77.\n\nRelated to (but NOT owl:equivalentClass with) legal:LegalEntity in the EU SEMICeu Core\nBusiness Vocabulary. The two extensions overlap but neither contains the other:\nlegal:LegalEntity is broader on the non-operator side (charities, non-profits, government\nbodies that are legal entities but not ESPR operators) and stricter on the registration\nside (some jurisdictions treat sole-proprietor operators as natural persons, not legal\nentities). Use legal:LegalEntity for EU-portal interoperability when the operator is\nknown to be a legally-registered business; the rdfs:seeAlso anchor is intentional and\nthe strongest formal claim that holds in general."@en;
    skos:broadMatch gs1:Organization, schema:Organization, <https://w3id.org/eudpp#Actor>, <https://vocabulary.uncefact.org/untp/Party>;
    skos:closeMatch gs1:OrganizationID_Details;
    skos:narrowMatch <https://w3id.org/eudpp#ManufacturerRecord>.
oec:DueDiligenceReport a rdfs:Class;
    rdfs:seeAlso <http://data.europa.eu/m8g/Evidence>, <http://data.europa.eu/m8g/Requirement>, <https://w3id.org/eudpp#ComplianceDeclaration>;
    rdfs:comment "Supply chain due diligence information supporting transparency requirements.\nReusable across Battery Regulation Art. 39, EUDR, and other due diligence frameworks."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Due Diligence Report"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf <http://data.europa.eu/m8g/Evidence>;
    skos:note "Required extension: GS1 Web Vocabulary does not provide a class for supply chain\ndue diligence reporting. This is mandated by EU Battery Regulation Art. 39 and EUDR.\n\nAnchored as rdfs:subClassOf cccev:Evidence (EU SEMICeu Core Criterion and Evidence\nVocabulary, http://data.europa.eu/m8g/Evidence), every due-diligence report is evidence\nsupporting a regulatory cccev:Requirement, but cccev:Evidence is much broader (test\nreports, certificates, attestations, audit logs) so the relationship is subClassOf, not\nowl:equivalentClass. CCCEV is the EU upstream of the UNTP conformity model."@en;
    skos:broadMatch <http://data.europa.eu/m8g/Evidence>, schema:Report.
oec:CircularityPerformance a rdfs:Class;
    rdfs:seeAlso gs1:consumerRecyclingInstructions, <https://w3id.org/eudpp#CircularEconomyIndicator>;
    rdfs:comment "Information supporting circular economy requirements including\nend-of-life handling, recycling, waste prevention, and circularity metrics.\nAligned with UNTP CircularityPerformance pattern."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Circularity Performance"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Required extension: GS1 provides gs1:consumerRecyclingInstructions for text-based\nrecycling guidance but lacks structured circularity data (recyclability rates, end-of-life URLs,\nwaste prevention info) required by ESPR. Use gs1:consumerRecyclingInstructions for simple text.\nAligned with UNTP CircularityPerformance for interoperability."@en;
    skos:narrowMatch <https://w3id.org/eudpp#RecyclingRate>.
oec:HazardousSubstance a rdfs:Class;
    rdfs:seeAlso gs1:hasAllergen, <https://w3id.org/eudpp#Substance>;
    rdfs:comment "A hazardous substance declaration per EU CLP Regulation 1272/2008.\nReusable across product categories."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazardous Substance"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Required extension: GS1 Web Vocabulary provides allergen tracking (gs1:hasAllergen)\nfor food products but lacks hazardous substance classes for industrial products per EU CLP\nRegulation 1272/2008. This class supports REACH, SCIP, and ESPR requirements."@en;
    skos:broadMatch <https://w3id.org/eudpp#Substance>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#HazardousSubstanceEntity>, schema:ChemicalSubstance, schema:Substance, <https://w3id.org/eudpp#SubstanceOfConcern>.
oec:DocumentReference a rdfs:Class;
    rdfs:seeAlso gs1:ReferencedFileDetails, <http://xmlns.com/foaf/0.1/Document>, <https://w3id.org/eudpp#DigitalInstruction>;
    rdfs:comment "Reference to an external document such as reports, certificates,\nmanuals, or guides. Supports multiple languages and formats.\nSee also gs1:ReferencedFileDetails for GS1 Web Vocabulary equivalent."@en;
    rdfs:label "Document Reference"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "PREFER gs1:ReferencedFileDetails where possible. This class provides equivalent\nfunctionality with additional ESPR-specific document types. Use gs1:referencedFile\nproperty with gs1:ReferencedFileDetails for standard documents (manuals, certificates).\nUse oec:DocumentReference only when ESPR-specific document types are required."@en;
    skos:broadMatch <http://xmlns.com/foaf/0.1/Document>, schema:APIReference, schema:NoteDigitalDocument;
    skos:closeMatch gs1:ReferencedFileDetails.
oec:RecycledContent a rdfs:Class;
    rdfs:seeAlso <https://gs1.eu/wp-content/uploads/2025/02/GDSN-Implementation-Guideline-for-exchanging-Carbon-Footprint-Data-3.pdf>, <https://w3id.org/eudpp#RecycledMaterialsUse>, <urn:samm:io.BatteryPass.Circularity:1.2.0#RecycledContentEntity>, gs1:PackagingDetails;
    rdfs:comment "Declaration of recycled material content with pre-consumer\nand post-consumer splits."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Recycled Content"@en;
    skos:note "Required extension: GS1 Web Vocabulary does not provide structured recycled content\nproperties. ESPR and Battery Regulation require pre-consumer/post-consumer breakdown which is\nnot available in GS1 vocabulary. Aligned with GDSN sustainability attributes."@en.
oec:MaterialComposition a rdfs:Class;
    rdfs:seeAlso gs1:TextileMaterialDetails, gs1:PackagingMaterialDetails, <https://w3id.org/eudpp#MaterialOfComposition>;
    rdfs:comment "Material composition information including source country,\npercentage, and critical raw material classification."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Material Composition"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Required extension: GS1 provides gs1:TextileMaterialDetails and\ngs1:PackagingMaterialDetails for specific domains but lacks a generic material composition\nclass with CAS/EC number support and critical raw material flags required by ESPR."@en;
    skos:narrowMatch gs1:TextileMaterialDetails, gs1:PackagingMaterialDetails.
oec:FacilityInformation a rdfs:Class;
    rdfs:seeAlso gs1:Place, schema:Place, <https://vocabulary.uncefact.org/untp/Facility>, <http://www.w3.org/ns/locn#Location>, <http://www.w3.org/ns/locn#Address>, <http://www.w3.org/ns/locn#Geometry>, <https://w3id.org/eudpp#Facility>, <http://data.europa.eu/m8g/InformationConcept>;
    rdfs:comment "Manufacturing or processing facility information per ESPR.\nCaptures facility identification, location, and certification data.\nUse gs1:globalLocationNumber for facility identification, schema:name for facility name, gs1:address for location (all inherited from gs1:Place).\nUse GS1 Digital Link format: https://id.gs1.org/414/{GLN}"@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Facility Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:subClassOf gs1:Place;
    skos:note "Extension of gs1:Place to capture ESPR-specific facility requirements.\nUse gs1:globalLocationNumber for facility GLN identification, schema:name for facility name, gs1:address for location.\nGS1 provides gs1:Place but lacks facility certification and type properties required by ESPR.\nAligned with UNTP Facility for Digital Facility Record (DFR) interoperability.\nAnchored to locn:Location (EU SEMICeu Core Location Vocabulary, http://www.w3.org/ns/locn#)\nfor EU-portal interoperability: locn:Address and locn:Geometry are the canonical\nsub-structures for the address and geographic-coordinate parts."@en;
    skos:broadMatch gs1:Organization, gs1:Place, schema:Place.
oec:SubstanceOfConcern a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#SubstanceOfConcern>, <https://echa.europa.eu/scip-database>;
    rdfs:comment "Substances of concern declaration aligned with SCIP database\nand ESPR requirements. Extends HazardousSubstance for detailed tracking."@en;
    dcterms:source <https://echa.europa.eu/scip>;
    rdfs:label "Substance of Concern"@en;
    rdfs:subClassOf oec:HazardousSubstance;
    skos:note "Required extension: SCIP database integration requires specific fields (SCIP ID,\nEC Number, safe use instructions) not available in GS1 Web Vocabulary. Supports REACH Article 33\nand Waste Framework Directive requirements."@en;
    skos:broadMatch <https://w3id.org/eudpp#Substance>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#HazardousSubstanceEntity>, schema:ChemicalSubstance, schema:Substance.
oec:PerformanceInfo a rdfs:Class;
    rdfs:seeAlso gs1:manufacturersWarranty, <https://w3id.org/eudpp#Durability>, <https://w3id.org/eudpp#Reliability>, <https://vocabulary.uncefact.org/untp/PerformanceMetric>;
    rdfs:comment "Product performance and durability information per ESPR Article 7.\nCaptures expected lifespan, usage cycles, and performance metrics."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Performance Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Required extension: GS1 provides gs1:manufacturersWarranty for warranty information but lacks\nstructured performance and durability data (expected lifespan, usage cycles, performance class)\nrequired by ESPR Article 7. Use in conjunction with gs1:manufacturersWarranty where applicable."@en.
oec:RepairabilityInfo a rdfs:Class;
    rdfs:seeAlso gs1:manufacturersWarranty, <https://w3id.org/eudpp#Durability>, <https://w3id.org/eudpp#Reliability>, gs1:referencedFile;
    rdfs:comment "Repair and maintenance information per ESPR Article 7.\nCaptures repair scores, spare part availability, and repair instructions."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Repairability Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Required extension: ESPR Article 7 mandates repairability scores (French Indice de\nRéparabilité style), spare parts availability periods, and DIY repair information not available\nin GS1 Web Vocabulary. Use gs1:referencedFile for repair manuals."@en.
oec:AccessRights a rdfs:Class;
    rdfs:comment "Access control for DPP data per ESPR Article 9.\nDefines which data is publicly accessible vs. restricted to authorized parties."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Access Rights"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Required extension: ESPR Article 9 defines three access levels (Public, Authorized,\nRestricted) for DPP data. GS1 Web Vocabulary does not provide access control semantics.\nThis supports the ESPR requirement for tiered data access."@en.
oec:EmissionsPerformance a rdfs:Class;
    rdfs:seeAlso <https://gs1.eu/wp-content/uploads/2025/02/GDSN-Implementation-Guideline-for-exchanging-Carbon-Footprint-Data-3.pdf>, <https://w3id.org/eudpp#CarbonFootprint>, <https://w3id.org/eudpp#EnvironmentalFootprint>;
    rdfs:comment "Container for greenhouse gas emissions data including carbon footprint,\nlifecycle phases, and verification status. Aligned with UNTP EmissionsPerformance."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Emissions Performance"@en;
    skos:note "Required extension: Structured emissions performance data for ESPR requirements.\nAligned with UNTP EmissionsPerformance for interoperability. Extends the GDSN CFP pattern\nwith operational scope and verification metrics."@en;
    skos:narrowMatch <https://w3id.org/eudpp#CarbonFootprint>.
oec:TraceabilityPerformance a rdfs:Class;
    rdfs:seeAlso <https://vocabulary.uncefact.org/untp/PerformanceMetric>;
    rdfs:comment "Supply chain verification and traceability metrics indicating the proportion\nof materials that are verifiably traced through the supply chain."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Traceability Performance"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Required extension: ESPR and due diligence regulations require traceability metrics.\nAligned with UNTP TraceabilityPerformance for supply chain transparency reporting."@en;
    skos:broadMatch <https://w3id.org/eudpp#QuantitativeProperty>.
oec:OperatorRole a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#EconomicOperatorRole>, schema:OrganizationRole;
    rdfs:comment "Role of an economic operator in the supply chain."@en;
    rdfs:label "Operator Role"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    owl:oneOf _:n3-4273.
_:n3-4273 rdf:first oec:Manufacturer;
    rdf:rest _:n3-4274.
oec:Manufacturer a oec:OperatorRole;
    rdfs:comment "Entity that produces the product, including own-brand labellers per EU Market Surveillance Regulation 2019/1020."@en;
    rdfs:label "Manufacturer"@en.
_:n3-4274 rdf:first oec:Importer;
    rdf:rest _:n3-4275.
oec:Importer a oec:OperatorRole;
    rdfs:comment "Entity established in the EU that places a product from a third country on the Union market."@en;
    rdfs:label "Importer"@en.
_:n3-4275 rdf:first oec:Distributor;
    rdf:rest _:n3-4276.
oec:Distributor a oec:OperatorRole;
    rdfs:comment "Entity in the supply chain that makes a product available on the market, other than manufacturer or importer."@en;
    rdfs:label "Distributor"@en.
_:n3-4276 rdf:first oec:Processor;
    rdf:rest _:n3-4277.
oec:Processor a oec:OperatorRole;
    rdfs:comment "Entity that processes raw materials or components into finished or intermediate products."@en;
    rdfs:label "Processor"@en.
_:n3-4277 rdf:first oec:Trader;
    rdf:rest rdf:nil.
oec:Trader a oec:OperatorRole;
    rdfs:comment "Entity that buys and sells products without significant modification or processing."@en;
    rdfs:label "Trader"@en.
oec:AuthorisedRepresentative a oec:OperatorRole;
    rdfs:seeAlso <https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment>, <https://w3id.org/eudpp#hasAuthorisedRepresentative>;
    rdfs:comment "Entity authorised by manufacturer to act on their behalf for specific tasks (per ESPR Article 16)."@en;
    rdfs:label "Authorised Representative"@en.
oec:FulfilmentServiceProvider a oec:OperatorRole;
    rdfs:comment "Entity providing fulfilment services including warehousing and order processing (per ESPR Article 17)."@en;
    rdfs:label "Fulfilment Service Provider"@en.
oec:AccessLevel a rdfs:Class;
    rdfs:comment "Access levels for DPP data per ESPR Article 9."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Access Level"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    owl:oneOf _:n3-4278.
_:n3-4278 rdf:first oec:Public;
    rdf:rest _:n3-4279.
oec:Public a oec:AccessLevel;
    rdfs:comment "Data accessible to all users (consumers, market surveillance, customs). Per ESPR Article 9(1)."@en;
    rdfs:label "Public"@en.
_:n3-4279 rdf:first oec:AuthorizedOnly;
    rdf:rest _:n3-4280.
oec:AuthorizedOnly a oec:AccessLevel;
    rdfs:comment "Data accessible only to market surveillance authorities and customs. Per ESPR Article 9(2)."@en;
    rdfs:label "Authorized Only"@en.
_:n3-4280 rdf:first oec:Restricted;
    rdf:rest rdf:nil.
oec:Restricted a oec:AccessLevel;
    rdfs:comment "Data accessible only to specific authorized economic operators. Per ESPR Article 9(3)."@en;
    rdfs:label "Restricted"@en.
oec:defaultAccessLevel a owl:AnnotationProperty;
    rdfs:comment "Default ESPR Article 9 access tier for values of the annotated property in\nDPP / master-data documents (Public, AuthorizedOnly, Restricted). Deployments may tighten a\nfield's tier at runtime but never loosen it below this default. Properties without this\nannotation default to AuthorizedOnly (fail-closed toward the public)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "default access level"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Field-level counterpart of oec:hasAccessLevel: while oec:hasAccessLevel classifies a\ndocument instance via its AccessRights object, oec:defaultAccessLevel classifies the property\ndefinition itself. Generators carry it into JSON Schemas as x-access-level and into the\nvocabulary browser JSON as accessLevel."@en;
    rdfs:range oec:AccessLevel.
oec:accessLevelMandatedBy a owl:AnnotationProperty;
    rdfs:comment "Legal act that fixes the access tier of the annotated property. Presence of\nthis annotation makes the oec:defaultAccessLevel non-overridable at runtime (locked in both\ndirections)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "access level mandated by"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:range rdfs:Resource.
oec:accessLevelRationale a owl:AnnotationProperty;
    rdfs:comment "One-sentence justification for the annotated property's\noec:defaultAccessLevel — why this tier, in terms a reviewer or auditor can check\nagainst the underlying regulation. REQUIRED wherever oec:defaultAccessLevel is\nset (enforced by check-access-levels). Rendered on ref.openepcis.io term pages\nand in the DDM field-access matrix."@en;
    rdfs:label "access level rationale"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:range xsd:string.
oec:accessLevelSource a owl:AnnotationProperty;
    rdfs:comment "Legal act or article that GROUNDS the tier decision (citation).\nUnlike oec:accessLevelMandatedBy it does NOT lock the tier — it documents where\nthe default came from. Use an ELI/CELEX IRI, as specific as available."@en;
    rdfs:label "access level source"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:range rdfs:Resource.
oec:accessLevelInherited a owl:AnnotationProperty;
    rdfs:comment "Marks a structural value-carrier sub-property (value, unit,\ndocument URL, ...) that has NO tier of its own: at runtime its visibility is\ngoverned entirely by the embedding parent property's tier. Declaring it keeps\nthe vocabulary 100% explicitly classified (the completeness guard accepts\naccessLevelInherited in lieu of defaultAccessLevel) without inventing a fake\ntier, and keeps such terms out of the enforcement alias map."@en;
    rdfs:label "access level inherited"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    rdfs:range xsd:boolean.
oec:PassportStatus a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#dppStatus>;
    rdfs:comment "Lifecycle status of a Digital Product Passport (EN 18223 dppStatus). Values are the lowercase string tokens given by skos:notation."@en;
    dcterms:source "EN 18223:2026, 4.1.2.1 (CEN/CENELEC JTC 24)";
    rdfs:label "Passport Status"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Base values active/inactive/archived/invalid per EN 18223 Table 1; draft/withdrawn/suspended are EPCIS4DPP profile extensions permitted by 'further values by relevant legal acts'."@en;
    skos:broadMatch schema:StatusEnumeration;
    owl:oneOf _:n3-4281.
_:n3-4281 rdf:first oec:Active;
    rdf:rest _:n3-4282.
oec:Active a oec:PassportStatus;
    rdfs:seeAlso <https://ref.gs1.org/cbv/Disp-active>;
    rdfs:comment "Passport is published and represents the current state of the product."@en;
    rdfs:label "Active"@en;
    skos:notation "active".
_:n3-4282 rdf:first oec:Inactive;
    rdf:rest _:n3-4283.
oec:Inactive a oec:PassportStatus;
    rdfs:comment "Passport is not currently in force (EN 18223 base value)."@en;
    rdfs:label "Inactive"@en;
    skos:notation "inactive".
_:n3-4283 rdf:first oec:Archived;
    rdf:rest _:n3-4284.
oec:Archived a oec:PassportStatus;
    rdfs:comment "Passport is archived after product end-of-life. Data persisted per EN 18221."@en;
    rdfs:label "Archived"@en;
    skos:notation "archived".
_:n3-4284 rdf:first oec:Invalid;
    rdf:rest _:n3-4285.
oec:Invalid a oec:PassportStatus;
    rdfs:comment "Passport is no longer valid (EN 18223 base value, e.g. revoked)."@en;
    rdfs:label "Invalid"@en;
    skos:notation "invalid".
_:n3-4285 rdf:first oec:Draft;
    rdf:rest _:n3-4286.
oec:Draft a oec:PassportStatus;
    rdfs:comment "EPCIS4DPP extension: passport is being prepared and not yet publicly available."@en;
    rdfs:label "Draft"@en;
    skos:notation "draft".
_:n3-4286 rdf:first oec:Withdrawn;
    rdf:rest _:n3-4287.
oec:Withdrawn a oec:PassportStatus;
    rdfs:seeAlso <https://ref.gs1.org/cbv/Disp-recalled>;
    rdfs:comment "EPCIS4DPP extension: passport withdrawn (e.g. product recall); a specific kind of invalid."@en;
    rdfs:label "Withdrawn"@en;
    skos:notation "withdrawn".
_:n3-4287 rdf:first oec:Suspended;
    rdf:rest rdf:nil.
oec:Suspended a oec:PassportStatus;
    rdfs:comment "EPCIS4DPP extension: temporarily not in force (e.g. pending investigation); a specific kind of inactive."@en;
    rdfs:label "Suspended"@en;
    skos:notation "suspended".
oec:BizStep-notifying a <https://ref.gs1.org/cbv/BizStep>;
    rdfs:seeAlso <https://ref.gs1.org/cbv/BizStep-inspecting>;
    rdfs:comment "Submitting a regulatory notification, declaration or statement about the product to a competent authority — an EUDR due-diligence or exemption declaration, a Battery Regulation notification, an ESPR conformity notification."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1115>;
    rdfs:label "Notifying"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "CBV 2.0 publishes no business step for reporting to an authority; its 41 values cover physical and commercial handling only, and cbv:BizStep-other would drop the distinction. Carried by at least two regulation modules (EUDR declarations, Battery Regulation notifications), so it belongs in the DPP core rather than one module."@en;
    skos:notation "notifying".
oec:BizStep-recovery a <https://ref.gs1.org/cbv/BizStep>;
    rdfs:seeAlso <https://ref.gs1.org/cbv/BizStep-destroying>;
    rdfs:comment "Recovering material or energy from a product at end of life, e.g. reprocessing collected packaging into secondary raw material."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2025/40>;
    rdfs:label "Recovery"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "CBV 2.0 has no recovery or recycling business step: cbv:BizStep-destroying and cbv:BizStep-disassembling describe different operations and would misstate the process. Cross-regulation (PPWR material recovery, Battery Regulation recycling, WEEE treatment), so DPP core rather than a module."@en;
    skos:notation "recovery".
oec:BizStep-maintaining a <https://ref.gs1.org/cbv/BizStep>;
    rdfs:seeAlso <https://ref.gs1.org/cbv/BizStep-inspecting>, <https://w3id.org/eudpp#MaintenanceEvent>;
    rdfs:comment "Actions (one or more) taken to keep a product in a condition where it can fulfil its intended purpose (ESPR Art. 2(19))."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Maintaining"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "CBV 2.0 (verified against the live vocabulary 2026-08-06) has no maintenance business step: cbv:BizStep-inspecting is examination without intervention, cbv:BizStep-repairing presupposes a defect, while ESPR maintenance is preventive. ESPR is horizontal, so DPP core rather than a module. CIRPASS-2's EUDPP EVENT module wraps the same Art. 2(19) definition in an event class (cirpass2:MaintenanceEvent); modelled here as CBV vocabulary because the definition describes an activity, not an event."@en;
    skos:notation "maintaining".
oec:BizStep-refurbishing a <https://ref.gs1.org/cbv/BizStep>;
    rdfs:seeAlso <https://ref.gs1.org/cbv/BizStep-repairing>, <https://w3id.org/eudpp#RefurbishmentEvent>;
    rdfs:comment "Actions carried out to prepare, clean, test, service and, where necessary, repair a product or a discarded product in order to restore its performance or functionality within the intended use and range of performance originally conceived at the design stage (ESPR Art. 2(18))."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Refurbishing"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "CBV 2.0 (verified 2026-08-06) has no refurbishing business step: cbv:BizStep-repairing covers returning a defective product to service, while refurbishment restores performance of a possibly non-defective or discarded product within its original design envelope. Cross-regulation (ESPR horizontal, Battery Regulation Art. 2(26)), so DPP core. CIRPASS-2 wraps the same Art. 2(18) definition in cirpass2:RefurbishmentEvent."@en;
    skos:notation "refurbishing".
oec:BizStep-remanufacturing a <https://ref.gs1.org/cbv/BizStep>;
    rdfs:seeAlso <https://ref.gs1.org/cbv/BizStep-commissioning>, <https://w3id.org/eudpp#RemanufacturingEvent>;
    rdfs:comment "Actions through which a new product is produced from objects that are waste, products or components and through which at least one change is made that substantially affects the safety, performance, purpose or type of the product (ESPR Art. 2(16))."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Remanufacturing"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "CBV 2.0 (verified 2026-08-06) has no remanufacturing business step. Belongs on an EPCIS TransformationEvent, not an ObjectEvent: per the ESPR definition remanufacturing produces a NEW product from waste/components, so the output carries a new identity (input/output EPC lists), which an event-class taxonomy like cirpass2:RemanufacturingEvent (subclass of ProductEvent) cannot express. ESPR horizontal, so DPP core."@en;
    skos:notation "remanufacturing".
oec:BizStep-upgrading a <https://ref.gs1.org/cbv/BizStep>;
    rdfs:seeAlso <https://ref.gs1.org/cbv/BizStep-repairing>, <https://w3id.org/eudpp#UpgradingEvent>;
    rdfs:comment "Actions carried out to enhance the functionality, performance, capacity, safety or aesthetics of a product (ESPR Art. 2(17))."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Upgrading"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "CBV 2.0 (verified 2026-08-06) has no upgrading business step: cbv:BizStep-repairing restores intended function, while upgrading enhances beyond the original state. ESPR horizontal, so DPP core. CIRPASS-2 wraps the same Art. 2(17) definition in cirpass2:UpgradingEvent."@en;
    skos:notation "upgrading".
oec:Disp-subject_to_regulation a <https://ref.gs1.org/cbv/Disp>;
    rdfs:seeAlso <https://ref.gs1.org/cbv/Disp-conformant>;
    rdfs:comment "The item is within the scope of a product regulation and carries the corresponding obligations (e.g. an EUDR-relevant commodity). Set as a persistentDisposition so it travels with the item across events."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1115>;
    rdfs:label "Subject to regulation"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "CBV 2.0's 33 dispositions describe physical/commercial state (active, in_transit, recalled, …); none expresses regulatory scope. Carried by the EUDR declaration events and applicable to any regulation module, so DPP core rather than a module."@en;
    skos:notation "subject_to_regulation".
oec:Disp-available_on_market a <https://ref.gs1.org/cbv/Disp>;
    rdfs:seeAlso <https://ref.gs1.org/cbv/Disp-active>, <https://w3id.org/eudpp#MakingAvailableOnMarketEvent>, <https://w3id.org/eudpp#PlacingOnMarketEvent>;
    rdfs:comment "The product is supplied for distribution, consumption or use on the Union market in the course of a commercial activity (ESPR Art. 2(39)). Set as a persistentDisposition so the market status travels with the item across events; the event that first sets it records the placing on the market (Art. 2(40))."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Available on the market"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "CBV 2.0 (verified 2026-08-06) has no market-status disposition. Making available / placing on the market are legal acts, not observable operations: modelled as a persistent state rather than a business step, because 'is on the Union market' persists across subsequent events while the act itself coincides with an ordinary shipping or selling event. CIRPASS-2 wraps the same definitions in cirpass2:MakingAvailableOnMarketEvent / cirpass2:PlacingOnMarketEvent."@en;
    skos:notation "available_on_market".
oec:DPPGranularity a rdfs:Class;
    rdfs:comment "Reporting granularity of a Digital Product Passport: which level of the product hierarchy a given attribute set describes."@en;
    dcterms:source <https://thebatterypass.eu/battery-pass-ready/publications/>;
    rdfs:label "DPP Granularity"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Introduced by BatteryPass-Ready Data Attribute Longlist v1.3 (March 2026) to align EU Battery Passport reporting with CEN/CENELEC JTC-24 drafts. Some attributes (e.g. recycled-content shares, carbon-footprint label) are reported at batch level, others at model or item level."@en;
    owl:oneOf _:n3-4288.
_:n3-4288 rdf:first oec:ModelLevel;
    rdf:rest _:n3-4289.
oec:ModelLevel a oec:DPPGranularity;
    rdfs:comment "Attribute reported once per battery model (e.g. nominal voltage, expected cycle life). Model master data has a single source of truth: the same model built at different manufacturing sites is NOT a distinct granularity level. Site is a source/location dimension carried by EPCIS events (readPoint / bizLocation); facts that vary per production run are reported at BatchLevel."@en;
    rdfs:label "Battery model"@en.
_:n3-4289 rdf:first oec:BatchLevel;
    rdf:rest _:n3-4290.
oec:BatchLevel a oec:DPPGranularity;
    rdfs:comment "Attribute reported per batch: model, calendar year, manufacturing site (e.g. carbon footprint, recycled-content shares)."@en;
    rdfs:label "Battery model per calendar year and per manufacturing site (batch)"@en.
_:n3-4290 rdf:first oec:ItemLevel;
    rdf:rest rdf:nil.
oec:ItemLevel a oec:DPPGranularity;
    rdfs:comment "Attribute reported per individual serial-numbered battery (e.g. serial number, state of health, cycle count)."@en;
    rdfs:label "Individual battery item"@en.
oec:hasReportingGranularity a owl:ObjectProperty;
    rdfs:comment "BatteryPass per-attribute reporting granularity (model / model-per-site / batch / item). Distinct from the passport-level EN 18223 'granularity' (oec:granularityLevel)."@en;
    dcterms:source <https://thebatterypass.eu/battery-pass-ready/publications/>;
    rdfs:label "Reporting Granularity"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "BatteryPass-Ready v1.3 longlist attribute #3. Renamed from oec:granularity to free the 'granularity' key for the EN 18223 passport-level attribute (oec:granularityLevel)."@en;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#granularity>;
    rdfs:range oec:DPPGranularity;
    rdfs:domain gs1:Product.
oec:lastUpdated a owl:DatatypeProperty;
    rdfs:comment "Date and time of the latest update to the DPP instance (EN 18223 lastUpdated), UTC, ISO 8601."@en;
    dcterms:source "EN 18223:2026, 4.1.2.1 (CEN/CENELEC JTC 24)";
    rdfs:label "Last Updated"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Consolidates the former oec:lastUpdate (BatteryPass-Ready v1.3 #4) and oec:passportLastModified into the EN 18223 'lastUpdated' attribute."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.Performance:1.2.1#lastUpdate>;
    rdfs:range xsd:dateTime;
    rdfs:domain oec:DigitalProductPassport;
    skos:exactMatch <https://w3id.org/eudpp#lastUpdate>.
oec:DigitalProductPassport a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#DPP>;
    rdfs:comment "The DPP envelope: identification and lifecycle metadata plus the product data elements, per the EN 18223 information model."@en;
    dcterms:source "EN 18223:2026, 4.1.2.1 (CEN/CENELEC JTC 24)";
    rdfs:label "Digital Product Passport"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "EN 18223 DigitalProductPassport. Attributes: digitalProductPassportId (oec:passportIdentifier), uniqueProductIdentifier, granularity (oec:granularityLevel), dppSchemaVersion, dppStatus (oec:passportStatus), lastUpdated, economicOperatorId, facilityId, contentSpecificationIds, plus product data elements."@en;
    skos:broadMatch schema:DigitalDocument;
    skos:exactMatch <https://w3id.org/eudpp#DPP>.
oec:ProductCategory a rdfs:Class;
    rdfs:seeAlso gs1:Product, schema:Product, gs1:FoodBeverageTobaccoProduct, <https://dpp-keystone.org/spec/v2/terms#BatteryProduct>;
    rdfs:comment "ESPR priority product categories per Annex I and delegated acts."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Product Category"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:broadMatch schema:CategoryCode;
    owl:oneOf _:n3-4291.
_:n3-4291 rdf:first oec:Batteries;
    rdf:rest _:n3-4292.
oec:Batteries a oec:ProductCategory;
    rdfs:comment "Batteries and accumulators per EU Battery Regulation 2023/1542."@en;
    rdfs:label "Batteries"@en.
_:n3-4292 rdf:first oec:Textiles;
    rdf:rest _:n3-4293.
oec:Textiles a oec:ProductCategory;
    rdfs:comment "Textile products including apparel, footwear, and home textiles."@en;
    rdfs:label "Textiles"@en.
_:n3-4293 rdf:first oec:Electronics;
    rdf:rest _:n3-4294.
oec:Electronics a oec:ProductCategory;
    rdfs:comment "Electronic and electrical equipment including ICT and consumer electronics."@en;
    rdfs:label "Electronics"@en.
_:n3-4294 rdf:first oec:Furniture;
    rdf:rest _:n3-4295.
oec:Furniture a oec:ProductCategory;
    rdfs:comment "Furniture products including domestic and office furniture."@en;
    rdfs:label "Furniture"@en.
_:n3-4295 rdf:first oec:Tyres;
    rdf:rest _:n3-4296.
oec:Tyres a oec:ProductCategory;
    rdfs:comment "Tyres for motor vehicles and their trailers."@en;
    rdfs:label "Tyres"@en.
_:n3-4296 rdf:first oec:ConstructionProducts;
    rdf:rest _:n3-4297.
oec:ConstructionProducts a oec:ProductCategory;
    rdfs:comment "Construction products per Construction Products Regulation."@en;
    rdfs:label "Construction Products"@en.
_:n3-4297 rdf:first oec:Chemicals;
    rdf:rest _:n3-4298.
oec:Chemicals a oec:ProductCategory;
    rdfs:comment "Chemical substances and mixtures."@en;
    rdfs:label "Chemicals"@en.
_:n3-4298 rdf:first oec:Detergents;
    rdf:rest _:n3-4299.
oec:Detergents a oec:ProductCategory;
    rdfs:seeAlso gs1:RegulationTypeCode-DETERGENTS_SAFETY_REGULATION;
    rdfs:comment "Detergents and surfactants per the EU Detergents Regulation (EU) 2026/405, an ESPR priority product category."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32026R0405>;
    rdfs:label "Detergents"@en.
_:n3-4299 rdf:first oec:Packaging;
    rdf:rest _:n3-4300.
oec:Packaging a oec:ProductCategory;
    rdfs:comment "Packaging and packaging waste products."@en;
    rdfs:label "Packaging"@en.
_:n3-4300 rdf:first oec:FoodContact;
    rdf:rest _:n3-4301.
oec:FoodContact a oec:ProductCategory;
    rdfs:comment "Materials and articles intended for food contact."@en;
    rdfs:label "Food Contact Materials"@en.
_:n3-4301 rdf:first oec:IronSteel;
    rdf:rest _:n3-4302.
oec:IronSteel a oec:ProductCategory;
    rdfs:comment "Iron and steel intermediate products."@en;
    rdfs:label "Iron and Steel"@en.
_:n3-4302 rdf:first oec:Aluminium;
    rdf:rest rdf:nil.
oec:Aluminium a oec:ProductCategory;
    rdfs:comment "Aluminium intermediate products."@en;
    rdfs:label "Aluminium"@en.
oec:HazardClass a rdfs:Class;
    rdfs:comment "Hazard classification categories per EU CLP Regulation."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Class"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    owl:oneOf _:n3-4303.
_:n3-4303 rdf:first oec:AcuteToxicity;
    rdf:rest _:n3-4304.
oec:AcuteToxicity a oec:HazardClass;
    rdfs:comment "Substances causing harmful effects after single or short-term exposure via oral, dermal, or inhalation routes."@en;
    rdfs:label "Acute Toxicity"@en.
_:n3-4304 rdf:first oec:SkinCorrosionOrIrritation;
    rdf:rest _:n3-4305.
oec:SkinCorrosionOrIrritation a oec:HazardClass;
    rdfs:comment "Substances causing irreversible damage (corrosion) or reversible damage (irritation) to skin tissue."@en;
    rdfs:label "Skin Corrosion or Irritation"@en.
_:n3-4305 rdf:first oec:EyeDamageOrIrritation;
    rdf:rest _:n3-4306.
oec:EyeDamageOrIrritation a oec:HazardClass;
    rdfs:comment "Substances causing serious eye damage or reversible eye irritation upon contact."@en;
    rdfs:label "Eye Damage or Irritation"@en.
_:n3-4306 rdf:first oec:RespiratoryOrSkinSensitization;
    rdf:rest _:n3-4307.
oec:RespiratoryOrSkinSensitization a oec:HazardClass;
    rdfs:comment "Substances causing hypersensitivity of airways (asthma) or allergic skin reactions after exposure."@en;
    rdfs:label "Respiratory or Skin Sensitization"@en.
_:n3-4307 rdf:first oec:GermCellMutagenicity;
    rdf:rest _:n3-4308.
oec:GermCellMutagenicity a oec:HazardClass;
    rdfs:comment "Substances that may cause heritable genetic mutations in human germ cells."@en;
    rdfs:label "Germ Cell Mutagenicity"@en.
_:n3-4308 rdf:first oec:Carcinogenicity;
    rdf:rest _:n3-4309.
oec:Carcinogenicity a oec:HazardClass;
    rdfs:comment "Substances known or suspected to cause cancer in humans."@en;
    rdfs:label "Carcinogenicity"@en.
_:n3-4309 rdf:first oec:ReproductiveToxicity;
    rdf:rest _:n3-4310.
oec:ReproductiveToxicity a oec:HazardClass;
    rdfs:comment "Substances adversely affecting sexual function, fertility, or development of offspring."@en;
    rdfs:label "Reproductive Toxicity"@en.
_:n3-4310 rdf:first oec:SpecificTargetOrganToxicity;
    rdf:rest _:n3-4311.
oec:SpecificTargetOrganToxicity a oec:HazardClass;
    rdfs:comment "Substances causing non-lethal damage to specific organs after single or repeated exposure."@en;
    rdfs:label "Specific Target Organ Toxicity"@en.
_:n3-4311 rdf:first oec:AspirationHazard;
    rdf:rest _:n3-4312.
oec:AspirationHazard a oec:HazardClass;
    rdfs:comment "Liquid or solid substances causing chemical pneumonia or pulmonary injury if aspirated into airways."@en;
    rdfs:label "Aspiration Hazard"@en.
_:n3-4312 rdf:first oec:HazardousToAquaticEnvironment;
    rdf:rest rdf:nil.
oec:HazardousToAquaticEnvironment a oec:HazardClass;
    rdfs:comment "Substances posing acute or chronic toxicity risks to aquatic organisms and ecosystems."@en;
    rdfs:label "Hazardous to Aquatic Environment"@en.
oec:DocumentType a rdfs:Class;
    rdfs:seeAlso gs1:ReferencedFileTypeCode, schema:SpreadsheetDigitalDocument;
    rdfs:comment "Types of supporting documents for DPP.\nSee also gs1:ReferencedFileTypeCode for GS1 standard document types (PRODUCT_MANUAL, SAFETY_DATA_SHEET, CERTIFICATE, etc.)."@en;
    rdfs:label "Document Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:closeMatch gs1:ReferencedFileTypeCode;
    owl:oneOf _:n3-4313.
_:n3-4313 rdf:first oec:DueDiligenceDocument;
    rdf:rest _:n3-4314.
oec:DueDiligenceDocument a oec:DocumentType;
    rdfs:comment "Documentation of supply chain due diligence processes and risk assessments."@en;
    rdfs:label "Due Diligence Document"@en.
_:n3-4314 rdf:first oec:Certificate;
    rdf:rest _:n3-4315.
oec:Certificate a oec:DocumentType;
    rdfs:seeAlso <https://w3id.org/eudpp#ConformityCertificate>;
    rdfs:comment "Official certificate from accredited body (ISO, environmental, quality certifications)."@en;
    rdfs:label "Certificate"@en.
_:n3-4315 rdf:first oec:TestReport;
    rdf:rest _:n3-4316.
oec:TestReport a oec:DocumentType;
    rdfs:comment "Technical test results from accredited laboratory or testing facility."@en;
    rdfs:label "Test Report"@en.
_:n3-4316 rdf:first oec:Manual;
    rdf:rest _:n3-4317.
oec:Manual a oec:DocumentType;
    rdfs:comment "User manual, installation guide, or maintenance documentation."@en;
    rdfs:label "Manual"@en.
_:n3-4317 rdf:first oec:DeclarationOfConformity;
    rdf:rest _:n3-4318.
oec:DeclarationOfConformity a oec:DocumentType;
    rdfs:seeAlso <https://w3id.org/eudpp#EUDeclarationOfConformity>;
    rdfs:comment "EU Declaration of Conformity stating compliance with applicable EU legislation."@en;
    rdfs:label "Declaration of Conformity"@en.
_:n3-4318 rdf:first oec:SafetyDataSheet;
    rdf:rest _:n3-4319.
oec:SafetyDataSheet a oec:DocumentType;
    rdfs:comment "Safety Data Sheet (SDS) per REACH Regulation providing hazard information."@en;
    rdfs:label "Safety Data Sheet"@en.
_:n3-4319 rdf:first oec:EnvironmentalReport;
    rdf:rest _:n3-4320.
oec:EnvironmentalReport a oec:DocumentType;
    rdfs:comment "Environmental impact assessment, carbon footprint study, or LCA report."@en;
    rdfs:label "Environmental Report"@en.
_:n3-4320 rdf:first oec:ThirdPartyVerification;
    rdf:rest rdf:nil.
oec:ThirdPartyVerification a oec:DocumentType;
    rdfs:seeAlso <https://w3id.org/eudpp#Review>, <https://w3id.org/eudpp#ReviewReport>;
    rdfs:comment "Independent verification report from accredited third-party auditor."@en;
    rdfs:label "Third Party Verification"@en.
oec:UnionHarmonisationLegislation a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#UnionHarmonisationLegislation>, oec:RegulationTypeCode;
    rdfs:comment "EU legal act harmonising the conditions for the marketing of products, against which conformity is declared (e.g. the ESPR itself, a delegated act, the Battery Regulation)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dec/2008/768(1)>;
    rdfs:label "Union Harmonisation Legislation"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "New Legislative Framework concept (Decision 768/2008/EC); every EU declaration of conformity cites the harmonisation legislation it answers. CCCEV's cccev:ReferenceFramework is the SEMICeu generalisation covering any legislation or standard a requirement derives from; this class is the harmonisation-legislation specialisation."@en;
    skos:broadMatch <http://data.europa.eu/m8g/ReferenceFramework>, schema:Legislation;
    skos:exactMatch <https://w3id.org/eudpp#UnionHarmonisationLegislation>.
oec:assignedELI a owl:DatatypeProperty;
    rdfs:seeAlso <http://data.europa.eu/eli/ontology#LegalResource>, <https://w3id.org/eudpp#assignedELI>;
    rdfs:comment "European Legislation Identifier (ELI) of the legal act, as an HTTP URI on eur-lex (e.g. https://eur-lex.europa.eu/eli/reg/2024/1781/oj)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/ontology>;
    rdfs:label "Assigned ELI"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "The ELI ontology models legal resources as eli:LegalResource nodes; this property carries the identifier as a plain URI reference, which is the shape passports exchange. Property-to-class, so referenced by rdfs:seeAlso rather than a graded mapping."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:UnionHarmonisationLegislation;
    skos:exactMatch <https://w3id.org/eudpp#assignedELI>.
oec:HarmonisedStandard a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#HarmonisedStandard>, <https://w3id.org/eudpp#usedForPresumptionOfConformity>;
    rdfs:comment "European standard adopted on the basis of a Commission standardisation request whose application confers presumption of conformity (Regulation (EU) 1025/2012 Art. 2(1)(c))."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2012/1025>;
    rdfs:label "Harmonised Standard"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Chapter IX: applying a cited harmonised standard gives presumption of conformity with the covered requirements. Distinct from oec:Certificate (an attestation about one product) and from the legislation itself."@en;
    skos:broadMatch <http://data.europa.eu/m8g/ReferenceFramework>;
    skos:exactMatch <https://w3id.org/eudpp#HarmonisedStandard>.
oec:CommonSpecification a rdfs:Class;
    rdfs:seeAlso oec:HarmonisedStandard, <https://w3id.org/eudpp#CommonSpecification>;
    rdfs:comment "Technical specification adopted by Commission implementing act as a fallback route to presumption of conformity where no adequate harmonised standard exists (ESPR Art. 41)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Common Specification"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Art. 41 fallback instrument; same presumption-of-conformity role as a harmonised standard but adopted by the Commission instead of a standardisation body."@en;
    skos:broadMatch <http://data.europa.eu/m8g/ReferenceFramework>, <https://w3id.org/eudpp#TechnicalSpecification>.
oec:ConformityAssessmentModule a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#ConformityAssessmentModule>, <https://w3id.org/eudpp#allowsConformityAssessmentModule>;
    rdfs:comment "Conformity assessment procedure module per Decision 768/2008/EC Annex II, cited by the applicable Union harmonisation legislation (ESPR Art. 4/43 delegated acts choose the module)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/dec/2008/768(1)>;
    rdfs:label "Conformity Assessment Module"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "New Legislative Framework module taxonomy (A through H1). Modelled like oec:ImpactIndicatorType: a class whose individuals form the controlled list. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <https://w3id.org/eudpp#ConformityAssessmentModule>.
oec:ModuleA a oec:ConformityAssessmentModule;
    rdfs:label "Module A — Internal production control"@en;
    skos:notation "A".
oec:ModuleA1 a oec:ConformityAssessmentModule;
    rdfs:label "Module A1 — Internal production control plus supervised product testing"@en;
    skos:notation "A1".
oec:ModuleA2 a oec:ConformityAssessmentModule;
    rdfs:label "Module A2 — Internal production control plus supervised product checks at random intervals"@en;
    skos:notation "A2".
oec:ModuleB a oec:ConformityAssessmentModule;
    rdfs:label "Module B — EU-type examination"@en;
    skos:notation "B".
oec:ModuleC a oec:ConformityAssessmentModule;
    rdfs:label "Module C — Conformity to type based on internal production control"@en;
    skos:notation "C".
oec:ModuleC1 a oec:ConformityAssessmentModule;
    rdfs:label "Module C1 — Conformity to type based on internal production control plus supervised product testing"@en;
    skos:notation "C1".
oec:ModuleC2 a oec:ConformityAssessmentModule;
    rdfs:label "Module C2 — Conformity to type based on internal production control plus supervised product checks at random intervals"@en;
    skos:notation "C2".
oec:ModuleD a oec:ConformityAssessmentModule;
    rdfs:label "Module D — Conformity to type based on quality assurance of the production process"@en;
    skos:notation "D".
oec:ModuleD1 a oec:ConformityAssessmentModule;
    rdfs:label "Module D1 — Quality assurance of the production process"@en;
    skos:notation "D1".
oec:ModuleE a oec:ConformityAssessmentModule;
    rdfs:label "Module E — Conformity to type based on product quality assurance"@en;
    skos:notation "E".
oec:ModuleE1 a oec:ConformityAssessmentModule;
    rdfs:label "Module E1 — Quality assurance of final product inspection and testing"@en;
    skos:notation "E1".
oec:ModuleF a oec:ConformityAssessmentModule;
    rdfs:label "Module F — Conformity to type based on product verification"@en;
    skos:notation "F".
oec:ModuleF1 a oec:ConformityAssessmentModule;
    rdfs:label "Module F1 — Conformity based on product verification"@en;
    skos:notation "F1".
oec:ModuleG a oec:ConformityAssessmentModule;
    rdfs:label "Module G — Conformity based on unit verification"@en;
    skos:notation "G".
oec:ModuleH a oec:ConformityAssessmentModule;
    rdfs:label "Module H — Conformity based on full quality assurance"@en;
    skos:notation "H".
oec:ModuleH1 a oec:ConformityAssessmentModule;
    rdfs:label "Module H1 — Conformity based on full quality assurance plus design examination"@en;
    skos:notation "H1".
oec:OperationalScope a rdfs:Class;
    rdfs:comment "Lifecycle boundary for emissions or environmental impact calculations."@en;
    dcterms:source <https://untp.unece.org/docs/specification/>;
    rdfs:label "Operational Scope"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>;
    owl:oneOf _:n3-4321.
_:n3-4321 rdf:first oec:CradleToGate;
    rdf:rest _:n3-4322.
oec:CradleToGate a oec:OperationalScope;
    rdfs:comment "Emissions from raw material extraction through manufacturing, excluding use phase and end-of-life."@en;
    rdfs:label "Cradle to Gate"@en.
_:n3-4322 rdf:first oec:CradleToGrave;
    rdf:rest rdf:nil.
oec:CradleToGrave a oec:OperationalScope;
    rdfs:comment "Full lifecycle emissions including raw materials, manufacturing, use phase, and end-of-life."@en;
    rdfs:label "Cradle to Grave"@en.
oec:GranularityLevel a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#ProductIdentifierGranularity>;
    rdfs:comment "Passport-level granularity per EN 18223 'granularity': model, batch, or item. Values are the lowercase string tokens given by skos:notation. In EPCIS4DPP the level is derived from the GS1 Digital Link Application Identifiers."@en;
    dcterms:source "EN 18223:2026, 4.1.2.2 (CEN/CENELEC JTC 24)";
    rdfs:label "Granularity Level"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    owl:oneOf _:n3-4323.
_:n3-4323 rdf:first oec:Model;
    rdf:rest _:n3-4324.
oec:Model a oec:GranularityLevel;
    rdfs:comment "DPP data applies to all products of this model or class. GS1 Digital Link 01/{gtin}."@en;
    rdfs:label "Model"@en;
    skos:notation "model".
_:n3-4324 rdf:first oec:Batch;
    rdf:rest _:n3-4325.
oec:Batch a oec:GranularityLevel;
    rdfs:comment "DPP data applies to a specific production batch. GS1 Digital Link 01/{gtin}/10/{lot}."@en;
    rdfs:label "Batch"@en;
    skos:notation "batch".
_:n3-4325 rdf:first oec:Item;
    rdf:rest rdf:nil.
oec:Item a oec:GranularityLevel;
    rdfs:comment "DPP data applies to an individual serialized item. GS1 Digital Link 01/{gtin}/21/{serial}."@en;
    rdfs:label "Item"@en;
    skos:notation "item".
oec:hasOperatorInformation a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#operatorInformation>, <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#manufacturerInformation>;
    rdfs:comment "Economic operator responsible for the product."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Operator Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Economic-operator / facility pattern per ESPR 2024/1781 Article 77. Anchored to SEMICeu CPOV / GS1 where applicable."@en;
    skos:narrowMatch gs1:manufacturer;
    rdfs:range oec:OperatorInformation.
oec:hasOperatorRole a owl:ObjectProperty;
    rdfs:seeAlso <http://data.europa.eu/m8g/role>;
    rdfs:comment "Role of the economic operator (manufacturer, importer, etc.)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Operator Role"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Economic-operator / facility pattern per ESPR 2024/1781 Article 77. Anchored to SEMICeu CPOV / GS1 where applicable."@en;
    skos:broadMatch <http://data.europa.eu/m8g/role>;
    skos:closeMatch gs1:organizationRole;
    rdfs:range oec:OperatorRole;
    rdfs:domain oec:OperatorInformation.
oec:registrationNumber a owl:DatatypeProperty;
    rdfs:comment "Official registration or license number."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Registration Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch gs1:registryEntry, gs1:regulatoryReferenceNumber;
    skos:narrowMatch schema:companyRegistration;
    rdfs:range xsd:string;
    rdfs:domain oec:OperatorInformation.
oec:hasDueDiligenceReport a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.SupplyChainDueDiligence:1.2.0#supplyChainDueDiligenceReport>;
    rdfs:comment "Reference to due diligence documentation."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Due Diligence Report"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.Labels:1.2.0#resultOfTestReport>;
    rdfs:range oec:DueDiligenceReport;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#dueDiligenceReport>.
oec:reportUrl a owl:DatatypeProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.SupplyChainDueDiligence:1.2.0#supplyChainDueDiligenceReport>, gs1:referencedFileURL;
    rdfs:comment "URL to the due diligence report."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Report URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DueDiligenceReport.
oec:thirdPartyAssurancesUrl a owl:DatatypeProperty;
    rdfs:comment "URL to third party verification or assurances."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Third Party Assurances URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DueDiligenceReport.
oec:reportDate a owl:DatatypeProperty;
    rdfs:comment "Date of the due diligence report."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Report Date"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:date;
    rdfs:domain oec:DueDiligenceReport.
oec:hasVerificationBody a owl:ObjectProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#hasNotifiedBody>;
    rdfs:comment "Organization that performed third-party verification."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Verification Body"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range gs1:Organization;
    rdfs:domain oec:DueDiligenceReport.
oec:hasHazardousSubstances a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstanceIdentifier>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstanceClass>, <https://dpp-keystone.org/spec/v2/terms#substancesOfConcern>;
    rdfs:comment "Hazardous substances present in the product."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazardous Substances"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstances>;
    skos:narrowMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstanceIdentifier>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstanceClass>;
    rdfs:range oec:HazardousSubstance.
oec:hasHazardClass a owl:ObjectProperty;
    rdfs:comment "CLP Regulation hazard classification."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Class"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range oec:HazardClass;
    rdfs:domain oec:HazardousSubstance;
    skos:exactMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstanceClass>.
oec:casNumber a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#componentCasNumber>, <https://w3id.org/eudpp#numberCAS>;
    rdfs:comment "Chemical Abstracts Service registry number."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "CAS Number"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#componentCasNumber>;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance;
    skos:exactMatch <https://w3id.org/eudpp#numberCAS>.
oec:hasMaterialOrigin a owl:ObjectProperty;
    rdfs:seeAlso gs1:countryOfOrigin, <https://w3id.org/eudpp#MaterialOrigin>, <https://w3id.org/eudpp#hasMaterialOrigin>;
    rdfs:comment "Country of origin of an individual material or component within the product composition, as a gs1:Country value."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Material Origin"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Required extension: gs1:countryOfOrigin and schema:countryOfOrigin are product-scoped (rdfs:domain gs1:Product); ESPR Article 7 supply-chain transparency needs origin per material/component entry."@en;
    skos:broadMatch schema:countryOfOrigin;
    rdfs:range gs1:Country;
    rdfs:domain oec:MaterialComposition.
oec:concentration a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#Concentration>, <https://w3id.org/eudpp#hasConcentration>;
    rdfs:comment "Concentration of the hazardous substance as percentage."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Concentration"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:HazardousSubstance;
    skos:exactMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstanceConcentration>.
oec:socThreshold a owl:DatatypeProperty;
    rdfs:seeAlso oec:concentration, <https://w3id.org/eudpp#Threshold>, <https://w3id.org/eudpp#ThresholdOfSubstanceOfConcern>, <https://w3id.org/eudpp#hasThreshold>;
    rdfs:comment "Concentration threshold (percentage by weight) above which the presence of the substance of concern must be declared in the passport, per the applicable delegated act."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Substance of Concern Threshold"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "ESPR Art. 7(5) lets delegated acts set thresholds for substance-of-concern tracking; the declared concentration (oec:concentration) only becomes interpretable against that threshold. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:HazardousSubstance.
oec:iupacName a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#nameIUPAC>;
    rdfs:comment "Systematic IUPAC nomenclature name of the substance."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "IUPAC Name"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "REACH Art. 119(1) treats the IUPAC name as part of the public substance identity; CAS/EC numbers (oec:casNumber, oec:ecNumber) identify but do not name. schema:iupacName exists but is domained on schema:MolecularEntity (Bioschemas), not on product-embedded substances, so a closeMatch is asserted rather than direct reuse."@en;
    skos:broadMatch <https://w3id.org/eudpp#otherName>;
    skos:closeMatch schema:iupacName;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:substanceTradeName a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#tradeName>;
    rdfs:comment "Commercial or trade name under which the substance is marketed, where it differs from the systematic name."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Substance Trade Name"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance identity element carried by SCIP dossiers and the CIRPASS-2 SOC module; distinct from the product-level brand name (gs1:brandName identifies the trade item, not an ingredient substance)."@en;
    skos:broadMatch <https://w3id.org/eudpp#otherName>;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:hazardImpact a owl:DatatypeProperty;
    rdfs:comment "Description of the hazard impact."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    rdfs:label "Hazard Impact"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range rdf:langString;
    rdfs:domain oec:HazardousSubstance.
oec:hasDocuments a owl:ObjectProperty;
    rdfs:seeAlso gs1:referencedFile;
    rdfs:comment "Supporting documents for the product. DPP-specific counterpart to gs1:referencedFile: the oec:DocumentReference range adds document typing and ESPR access-rights semantics that gs1:ReferencedFileDetails does not carry."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Documents"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:closeMatch gs1:referencedFile;
    rdfs:range oec:DocumentReference.
oec:hasDocumentType a owl:ObjectProperty;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Document Type"@en;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/core/>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#europeanAssessmentDocument>;
    rdfs:range oec:DocumentType;
    rdfs:domain oec:DocumentReference;
    skos:exactMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#documentType>.
oec:documentUrl a owl:DatatypeProperty;
