<https://ref.openepcis.org/extensions/eu/battery/hasSubstanceLocation> a owl:ObjectProperty;
    rdfs:seeAlso oec:substanceLocation, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#batteryMaterialLocation>, <http://www.w3.org/ns/locn#location>, schema:location;
