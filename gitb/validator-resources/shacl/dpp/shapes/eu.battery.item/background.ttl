    rdfs:label "Power Capability at 80% SoC"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#power>, <https://dpp-keystone.org/spec/v2/terms#ratedPower>, <urn:samm:io.BatteryPass.Performance:1.2.1#originalPowerCapability>, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingPowerCapability>, <urn:samm:io.BatteryPass.Performance:1.2.1#powerCapabilityAt>;
