<https://ref.openepcis.org/extensions/eu/battery/exhaustionThreshold> a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#exhaustionCapacityThreshold>;
    rdfs:comment "SOCE percentage threshold for battery exhaustion."@en;
