oec:hasCarbonFootprint a owl:ObjectProperty;
    rdfs:seeAlso <https://gs1.eu/wp-content/uploads/2025/02/GDSN-Implementation-Guideline-for-exchanging-Carbon-Footprint-Data-3.pdf>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#absoluteCarbonFootprint>;
    rdfs:comment "Carbon footprint measurement for the product."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint"@en;
    skos:note "Required extension: GS1 GDSN provides carbon footprint attributes but they are not\nyet part of GS1 Web Vocabulary. This property aligns with the GDSN CFP Implementation Guideline.\nUse gs1:QuantitativeValue for the measurement value with appropriate unitCode."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>;
    rdfs:range gs1:QuantitativeValue.
oec:carbonFootprintTotal a owl:DatatypeProperty;
    rdfs:seeAlso <https://gs1.eu/wp-content/uploads/2025/02/GDSN-Implementation-Guideline-for-exchanging-Carbon-Footprint-Data-3.pdf>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>, oec:hasCarbonFootprintProduction;
    rdfs:comment "Total lifecycle carbon footprint in kg CO2e. Aligned with UNTP carbonFootprint."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Carbon Footprint Total"@en;
