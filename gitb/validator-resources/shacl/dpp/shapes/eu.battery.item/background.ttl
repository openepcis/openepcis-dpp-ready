    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue.
<https://ref.openepcis.org/extensions/eu/battery/hasCertifiedUsableEnergy> a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#certifiedUsableEnergy>;
    rdfs:comment "The certified usable energy capacity of the battery."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Certified Usable Energy"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    rdfs:range gs1:QuantitativeValue;
    skos:exactMatch <urn:samm:io.BatteryPass.Performance:1.2.1#ratedEnergy>, <https://dpp-keystone.org/spec/v2/terms#certifiedUsableEnergy>.
<https://ref.openepcis.org/extensions/eu/battery/hasRemainingUsableEnergy> a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#remainingUsableEnergy>;
    rdfs:comment "The current remaining usable energy capacity."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Remaining Usable Energy"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.Performance:1.2.1#remainingEnergy>;
    rdfs:range gs1:QuantitativeValue;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#remainingUsableEnergy>.
<https://ref.openepcis.org/extensions/eu/battery/soceMeasurementId> a owl:DatatypeProperty;
    rdfs:comment "Unique identifier for the SOCE measurement."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
