<https://ref.openepcis.org/extensions/eu/battery/batteryPassportIdentifier> a owl:DatatypeProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#productIdentifier>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-01>;
    rdfs:comment "Unique identifier for the battery passport. Note: In this implementation, the primary identifier is the GS1 Digital Link (@id)."@en;
