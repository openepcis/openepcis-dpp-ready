    rdfs:range xsd:boolean.
oec:economicOperatorId a owl:DatatypeProperty;
    rdfs:seeAlso gs1:additionalOrganizationID, <https://w3id.org/eudpp#hasUniqueOperatorIdentifier>;
    rdfs:comment "Unique EOID from the EU economic operator registry per ESPR Article 77.\nThis replaces individual national registrations with a single EU-wide identifier."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    rdfs:label "Economic Operator ID"@en;
