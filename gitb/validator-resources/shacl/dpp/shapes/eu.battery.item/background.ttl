    skos:closeMatch <urn:samm:io.BatteryPass.Performance:1.2.1#expectedLifetime>, <https://dpp-keystone.org/spec/v2/terms#expectedLifetimeYears>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain gs1:Product.
<https://ref.openepcis.org/extensions/eu/battery/expectedNumberOfCycles> a owl:DatatypeProperty;
