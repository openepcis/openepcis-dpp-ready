    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Lead Post-Consumer Recycled Share"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "Post-consumer breakdown of the Art. 8 recycled-lead share, following the same recycled-content calculation methodology as eubat:lithiumPostConsumerShare / eubat:cobaltPostConsumerShare / eubat:nickelPostConsumerShare. The Battery Regulation mandates only the aggregate share for lead, and BatteryPass-Ready v1.3 consolidated its two v1.2 lead attributes into the single RecycledLeadShare, so this split is a voluntary declaration retained for parity with the other three metals. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v2/terms#recycledContentPercentage>, <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledContent>, <https://dpp-keystone.org/spec/v2/terms#postConsumerRecycledContentPercentage>;
    skos:closeMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#postConsumerShare>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/RecycledContent>;
    skos:broader <https://ref.openepcis.org/extensions/eu/battery/leadRecycledShare>.
