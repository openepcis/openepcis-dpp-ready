<https://ref.openepcis.org/extensions/eu/battery/expectedRemainingCycles> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-59>;
    rdfs:comment "Estimated remaining charge-discharge cycles."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
