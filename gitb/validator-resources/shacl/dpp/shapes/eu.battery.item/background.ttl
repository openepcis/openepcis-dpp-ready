    rdfs:label "Manufacturing Place"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch gs1:manufacturingPlant;
    rdfs:range oec:FacilityInformation;
    rdfs:domain gs1:Product;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#manufacturingPlace>, <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#manufacturingPlace>.
<https://ref.openepcis.org/extensions/eu/battery/hasCellType> a owl:ObjectProperty;
