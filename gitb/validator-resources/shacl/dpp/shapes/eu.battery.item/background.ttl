    rdfs:domain oec:SubstanceOfConcern.
oec:substanceLocation a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#componentLocationInProduct>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstanceLocation>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#batteryMaterialLocation>, <http://www.w3.org/ns/locn#location>, <https://w3id.org/eudpp#substanceLocation>;
    rdfs:comment "Location or component where the substance is present in the product."@en;
