<https://ref.openepcis.org/extensions/eu/battery/hasOperatorInformation> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasOperatorInformation, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-02>;
    rdfs:comment "Non-identifier metadata of the economic operator responsible for the battery (Art. 38): name, postal address, contact point. The operator's identifier is carried separately by eubat:operatorIdentifier so the two can be exposed at different access levels (v1.3 separates them: identifier is restricted to authorities, information remains public)."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Economic Operator Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "BatteryPass-Ready v1.3 longlist attribute #12 (was combined #3 in v1.2). Specialises the cross-cutting oec:hasOperatorInformation."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#operatorInformation>;
    rdfs:range oec:OperatorInformation;
    rdfs:domain gs1:Product;
    rdfs:subPropertyOf oec:hasOperatorInformation.
<https://ref.openepcis.org/extensions/eu/battery/operatorIdentifier> a owl:DatatypeProperty;
    rdfs:seeAlso oec:OperatorInformation, <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#manufacturerInformation>, gs1:globalLocationNumber, <http://www.w3.org/ns/adms#Identifier>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-02>;
    rdfs:comment "Unique identifier of the economic operator (recommended: GS1 GLN, ESPR EOID per Article 77). Sits on the oec:OperatorInformation referenced by eubat:hasOperatorInformation."@en;
    dcterms:source <https://thebatterypass.eu/battery-pass-ready/publications/>;
    rdfs:label "Economic Operator Identifier"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "BatteryPass-Ready v1.3 longlist attribute #9. Recommended access level: AuthorizedOnly. Domain moved from gs1:Product to oec:OperatorInformation in 0.9.5: the identifier identifies the operator, not the product. Conceptually an adms:Identifier whose notation is the GLN / EOID and whose schemaAgency identifies the issuer."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#operatorInformation>, schema:identifier, <http://www.w3.org/ns/adms#identifier>, <https://dpp-keystone.org/spec/v2/terms#economicOperator>;
    skos:narrowMatch gs1:globalLocationNumber;
    rdfs:range xsd:string;
    rdfs:domain oec:OperatorInformation;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#economicOperatorId>;
    rdfs:subPropertyOf skos:notation.
<https://ref.openepcis.org/extensions/eu/battery/manufacturerIdentifier> a owl:DatatypeProperty;
    rdfs:seeAlso gs1:manufacturer, gs1:globalLocationNumber, <http://www.w3.org/ns/adms#Identifier>;
    rdfs:comment "Unique identifier of the battery manufacturer (recommended: GS1 GLN). Sits on the oec:OperatorInformation that plays the Manufacturer role; distinct OperatorInformation instances may identify different operators (manufacturer vs. importer vs. distributor)."@en;
    dcterms:source <https://thebatterypass.eu/battery-pass-ready/publications/>;
    rdfs:label "Manufacturer Identifier"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "BatteryPass-Ready v1.3 longlist attribute #10. Recommended access level: AuthorizedOnly. Granularity: model per manufacturing site. Domain moved from gs1:Product to oec:OperatorInformation in 0.9.5: the identifier identifies the manufacturer organisation, not the product."@en;
    skos:broadMatch schema:identifier, <http://www.w3.org/ns/adms#identifier>;
    rdfs:range xsd:string;
    rdfs:domain oec:OperatorInformation;
    skos:exactMatch <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#manufacturerInformation>;
    rdfs:subPropertyOf skos:notation.
<https://ref.openepcis.org/extensions/eu/battery/hasOperatorRole> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasOperatorRole, <http://data.europa.eu/m8g/role>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-02>;
    rdfs:comment "Role of the economic operator (manufacturer, importer, distributor, etc.)."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Operator Role"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. Specialises the cross-cutting oec:hasOperatorRole; identical domain and range."@en;
    skos:broadMatch gs1:organizationRole;
    skos:closeMatch <http://data.europa.eu/m8g/role>, schema:provider;
    rdfs:range oec:OperatorRole;
    rdfs:domain oec:OperatorInformation;
    skos:exactMatch oec:hasOperatorRole;
    rdfs:subPropertyOf oec:hasOperatorRole.
<https://ref.openepcis.org/extensions/eu/battery/hasSparePartSources> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-47>;
    rdfs:comment "Sources for spare parts for the battery."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Spare Part Sources"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#sparePartSources>;
    rdfs:range gs1:Organization;
    rdfs:domain gs1:Product.
<https://ref.openepcis.org/extensions/eu/battery/spareParts> a owl:DatatypeProperty;
    rdfs:seeAlso schema:mpn, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-46>;
    rdfs:comment "Part numbers of the battery's components, listed as the spare-part component identifiers available from this supplier."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Spare Parts"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute: the part numbers for components reserved for persons with a legitimate interest. No GS1 or schema.org equivalent (schema:mpn / schema:sku identify the product itself, not its components)."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#sparePartSources>;
    rdfs:range rdf:langString;
    rdfs:domain gs1:Organization.
<https://ref.openepcis.org/extensions/eu/battery/hasSupplierContact> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-47>, <http://data.europa.eu/m8g/ContactPoint>, <http://data.europa.eu/m8g/contactPoint>, <urn:samm:io.BatteryPass.Circularity:1.2.0#emailAddressOfSupplier>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Supplier Contact"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "gs1:ContactPoint is range-equivalent to cv:ContactPoint (EU SEMICeu CPOV). Either is acceptable; cv:ContactPoint is the EU-portal canonical for recall coordinators / customer service / regulatory liaison."@en;
    skos:broadMatch <http://data.europa.eu/m8g/contactPage>, <http://data.europa.eu/m8g/contactPoint>, schema:contactPoint, gs1:contactPoint;
    skos:narrowMatch gs1:afterHoursContact;
    rdfs:range gs1:ContactPoint;
    rdfs:domain gs1:Organization.
<https://ref.openepcis.org/extensions/eu/battery/hasLabels> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-40>;
    rdfs:comment "Labels and markings on the battery per Annex VI."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Labels"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.Labels:1.2.0#labels>;
    rdfs:range <https://ref.openepcis.org/extensions/eu/battery/Label>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.org/extensions/eu/battery/labelSymbol> a owl:DatatypeProperty;
    rdfs:seeAlso schema:url;
