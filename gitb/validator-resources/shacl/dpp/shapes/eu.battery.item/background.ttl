    rdfs:label "Substances of Concern"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    skos:narrowMatch <https://dpp-keystone.org/spec/v2/terms#textileSubstancesOfConcern>;
    rdfs:range oec:SubstanceOfConcern;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#substancesOfConcern>, <https://w3id.org/eudpp#containsSubstanceOfConcern>.
oec:ecNumber a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#componentEcNumber>, <https://w3id.org/eudpp#numberEC>;
    rdfs:comment "European Community number for the substance (EINECS/ELINCS)."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
