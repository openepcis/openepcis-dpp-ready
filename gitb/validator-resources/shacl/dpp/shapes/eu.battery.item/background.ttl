    rdfs:label "Substance Location"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    skos:broadMatch <http://www.w3.org/ns/locn#location>, gs1:locationDescription;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#componentLocationInProduct>;
    skos:narrowMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstanceLocation>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#batteryMaterialLocation>;
    rdfs:range xsd:string;
    rdfs:domain oec:SubstanceOfConcern;
    skos:exactMatch <https://w3id.org/eudpp#substanceLocation>.
oec:safeUseInstructions a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#safeUseInstructions>, gs1:consumerSafetyInformation;
    rdfs:comment "Instructions for safe use of the product containing the substance of concern."@en;
