<https://ref.openepcis.org/extensions/eu/battery/hasBatteryMass> a owl:ObjectProperty;
    rdfs:seeAlso gs1:netWeight, <https://dpp-keystone.org/spec/v2/terms#batteryMass>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-10>;
    rdfs:comment "Net mass of the battery. Use unitCode 'KGM' (kilogram) per UN/CEFACT Rec 20. Sub-property of gs1:netWeight to keep GS1-first."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Battery Mass"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "BatteryPass-Ready v1.3 (current canonical SAMM submodel: urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#batteryMass). EU Battery Regulation Annex VI Part A weight declaration."@en;
    skos:broadMatch gs1:netWeight;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain gs1:Product;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#batteryMass>, <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#batteryMass>;
    rdfs:subPropertyOf gs1:netWeight.
<https://ref.openepcis.org/extensions/eu/battery/hasDismantlingAndRemovalInformation> a owl:ObjectProperty;
    rdfs:seeAlso oec:hasDismantlingInstructions, <https://dpp-keystone.org/spec/v2/terms#dismantlingInformation>;
    rdfs:comment "Reference to the dismantling and removal instructions document required by EU Battery Regulation Annex VIII §B."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Dismantling and Removal Information"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "BatteryPass-Ready v1.3 (current canonical SAMM submodel: urn:samm:io.BatteryPass.Circularity:1.2.0#dismantlingAndRemovalInformation). EU Battery Regulation Annex VIII §B safety information."@en;
    skos:broadMatch gs1:consumerSafetyInformation, gs1:regulatoryInformation;
    skos:closeMatch <https://dpp-keystone.org/spec/v2/terms#dismantlingInformation>, <urn:samm:io.BatteryPass.Circularity:1.2.0#dismantlingAndRemovalInformation>;
    rdfs:range oec:DocumentReference;
    rdfs:domain gs1:Product.
<https://ref.openepcis.org/extensions/eu/battery/safetyMeasures> a owl:DatatypeProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.Circularity:1.2.0#endOfLifeInformation>, <https://dpp-keystone.org/spec/v2/terms#safetyMeasures>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-49>;
    rdfs:comment "End-of-life handling safety guidance: short text or URL fragment."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    rdfs:label "Safety Measures"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    skos:note "BatteryPass-Ready v1.3 (current canonical SAMM submodel: urn:samm:io.BatteryPass.Circularity:1.2.0#safetyMeasures). Pair with eubat:hasDismantlingAndRemovalInformation for full Annex VIII coverage."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#endOfLifeInformation>, gs1:consumerSafetyInformation, gs1:safetyInfo;
    skos:narrowMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#safetyInstructions>;
    rdfs:range xsd:string;
    rdfs:domain gs1:Product;
    skos:exactMatch <https://dpp-keystone.org/spec/v2/terms#safetyMeasures>.
