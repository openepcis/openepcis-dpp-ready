    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.Performance:1.2.1#numberOfFullCycles>;
    skos:closeMatch <urn:samm:io.BatteryPass.Performance:1.2.1#expectedNumberOfCycles>;
    rdfs:range xsd:integer.
<https://ref.openepcis.org/extensions/eu/battery/expectedRemainingLifetimeMonths> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-60>;
