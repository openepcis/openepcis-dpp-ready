oec:hasSubstancesOfConcern a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#hazardousSubstances>, <https://dpp-keystone.org/spec/v2/terms#substancesOfConcern>, gs1:ingredientOfConcern;
