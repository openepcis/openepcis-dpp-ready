<https://ref.openepcis.org/extensions/eu/battery/hasCurrentSelfDischargingRate> a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v2/terms#selfDischargeCurrent>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-65>;
