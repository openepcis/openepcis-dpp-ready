txtrep:PriorityRepairElementTypeConcept a owl:Class ;
    rdfs:label "Priority repair element type concept"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "SKOS concept identifying a priority repair element type such as fabric, zipper, button or embellishment."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:RepairServiceConfigurationScheme a skos:ConceptScheme ;
    rdfs:label "Repair service configuration scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled scheme for the JRC Table 48 BC, BAT and BNAT descriptions of repair-service and guidance configurations."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    skos:hasTopConcept txtrep:repairServiceBAT,
        txtrep:repairServiceBC,
        txtrep:repairServiceBNAT ;
    skos:prefLabel "Repair service configuration scheme"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:UserAcceptanceStatusScheme a skos:ConceptScheme ;
    rdfs:label "User acceptance status scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled scheme for recording whether a repaired product is accepted by the user in the stated assessment context."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    skos:hasTopConcept txtrep:userAcceptanceAccepted,
        txtrep:userAcceptanceNotAccepted,
        txtrep:userAcceptanceUnknown ;
    skos:prefLabel "User acceptance status scheme"@en ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:PriorityRepairElementTypeScheme a skos:ConceptScheme ;
    rdfs:label "Priority repair element type scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled scheme for the non-exhaustive priority-element types identified in the JRC repairability analysis."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    skos:hasTopConcept txtrep:buttonRepairElement,
        txtrep:embellishmentRepairElement,
        txtrep:fabricRepairElement,
        txtrep:zipperRepairElement ;
    skos:prefLabel "Priority repair element type scheme"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:RepairActionTypeScheme a skos:ConceptScheme ;
    rdfs:label "Repair action type scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled scheme for common repair-action methods explicitly cited in the JRC textile repairability discussion."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    skos:hasTopConcept txtrep:buttonReplacementAction,
        txtrep:mendingAction,
        txtrep:patchingAction,
        txtrep:zipperReplacementAction ;
    skos:prefLabel "Repair action type scheme"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:RepairActorTypeScheme a skos:ConceptScheme ;
    rdfs:label "Repair actor type scheme"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Controlled scheme for actor types participating in textile repair."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    skos:hasTopConcept txtrep:companyRepairActor,
        txtrep:consumerRepairActor,
        txtrep:independentProfessionalRepairer,
        txtrep:repairCafeActor ;
    skos:prefLabel "Repair actor type scheme"@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3436-3443."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:RepairService a owl:Class ;
    rdfs:label "Repair service"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Service that performs, organises or supports textile repair interventions, including company-provided, independent professional and community-supported repair."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3474-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrep:RepairabilityAssessment a owl:Class ;
    rdfs:label "Repairability assessment"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Assessment execution that gathers contextual evidence about repairability-related product aspects, services, guidance, design features, priority elements, costs, spare-part availability and user acceptance. It does not itself constitute the result."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf txtass:AssessmentExecution ;
    owl:disjointWith txtass:DurabilityAssessment ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

<https://w3id.org/eudpp/textile-repairability> a owl:Ontology ;
    rdfs:label "EU DPP Textile Repairability Ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Repairability Ontology. Version 2.0.0 candidate."@en ;
    dcterms:created "2026-07-01"^^xsd:date ;
    dcterms:creator "Elio Hbeich"@en,
        "BOUGACHA Racem"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Ontology module for textile repairability-related product aspects, services, guidance, design features, contextual conditions, priority elements, assessments, repair-related process specialisations and their links to EU DPP product-event semantics. The module does not define a universal objective repairability score."@en ;
    dcterms:issued "2026-07-01"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-27"^^xsd:date ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    dcterms:title "EU DPP Textile Repairability Ontology"@en ;
    vann:preferredNamespacePrefix "txtrep" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-repairability#" ;
    rdfs:comment "The JRC concludes that textile-apparel repairability cannot currently be represented by a simple objective framework. This ontology therefore represents evidence and enabling conditions without inferring that a product is objectively repairable."@en,
        "The module reuses the semantic product-event classes defined in the EU DPP EVENT module. Textile-specific life-extension event classes bridge those event semantics with concrete textile process executions; EPCIS technical carriers remain defined by the EVENT module."@en ;
    owl:imports <https://w3id.org/eudpp/textile-actor-mireot>,
        <https://w3id.org/eudpp/textile-assessment>,
        <https://w3id.org/eudpp/textile-associated-materials>,
        <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-context>,
        <https://w3id.org/eudpp/textile-core>,
        <https://w3id.org/eudpp/textile-dpp-mireot>,
        <https://w3id.org/eudpp/textile-durability>,
        <https://w3id.org/eudpp/textile-event-mireot>,
        <https://w3id.org/eudpp/textile-process> ;
    owl:priorVersion <https://w3id.org/eudpp/textile-repairability/1.1.2> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-repairability/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" .

