@prefix txtctx: <https://w3id.org/eudpp/textile-context#> .
@prefix txtdur: <https://w3id.org/eudpp/textile-durability#> .
@prefix txtprc: <https://w3id.org/eudpp/textile-process#> .
@prefix txtrep: <https://w3id.org/eudpp/textile-repairability#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

txtrep:EaseOfDisassembly a owl:Class ;
    rdfs:label "Ease of disassembly"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Disassembly feature concerning the ease with which a product or relevant element can be taken apart without damage or excessive effort."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf txtrep:DisassemblyFeature ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrep:ModularityFeature a owl:Class ;
    rdfs:label "Modularity feature"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Design feature by which relevant product elements are modular, detachable or interchangeable in support of repair or upgrade."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf txtrep:RepairabilityDesignFeature ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrep:RefurbishmentPossibility a owl:Class ;
    rdfs:label "Possibility of refurbishment"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Ability of a product or discarded product to be prepared, cleaned, tested, serviced and, where necessary, repaired so that performance or functionality is restored within the originally intended use and performance range."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf txtrep:LifeExtensionInterventionAspect ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11374-11400; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrep:RemanufacturingPossibility a owl:Class ;
    rdfs:label "Possibility of remanufacturing"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Possibility of producing a new product from waste objects, products or components through actions involving at least one change that may affect the product performance, purpose or type."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf txtrep:LifeExtensionInterventionAspect ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed pages 16-17, lines 222-225; JRC Preparatory Study, Section 13.10.1.13, printed pages 480-481, lines 11645-11673; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrep:Repairability a owl:Class ;
    rdfs:label "Repairability"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Ability of a defective product or waste object to return, through one or more actions, to a condition in which it fulfils its intended use. For textile apparel, user acceptance of restored functionality and potentially changed aesthetics is contextually relevant."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf txtrep:LifeExtensionInterventionAspect ;
    txtcon:modellingNote "Repair may extend product use, but the outcome depends on failure type, service availability, cost, user acceptance and the effectiveness of the intervention; no deterministic inference is asserted."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicallyContributesTo txtdur:Durability .

txtrep:StandardisationFeature a owl:Class ;
    rdfs:label "Standardisation feature"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Design feature by which components or interfaces are standardised in a way that may support replacement, repair or upgrade."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf txtrep:RepairabilityDesignFeature ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrep:TextileRefurbishmentEvent a owl:Class ;
    rdfs:label "Textile refurbishment event"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-event-mireot> ;
    rdfs:comment "A concrete textile refurbishment occurrence that is both a textile process execution and an instance of the EU DPP RefurbishmentEvent semantics."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue txtrep:RefurbishmentProcess ;
            owl:onProperty txtprc:executesProcessType ],
        dpp:RefurbishmentEvent,
        txtrep:LifeExtensionProductEvent ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11374-11400; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:TextileRemanufacturingEvent a owl:Class ;
    rdfs:label "Textile remanufacturing event"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-event-mireot> ;
    rdfs:comment "A concrete textile remanufacturing occurrence that is both a textile process execution and an instance of the EU DPP RemanufacturingEvent semantics."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue txtrep:RemanufacturingProcess ;
            owl:onProperty txtprc:executesProcessType ],
        dpp:RemanufacturingEvent,
        txtrep:LifeExtensionProductEvent ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed pages 16-17, lines 222-225; JRC Preparatory Study, Section 13.10.1.13, printed pages 480-481, lines 11645-11673; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:TextileRepairEvent a owl:Class ;
    rdfs:label "Textile repair event"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-event-mireot> ;
    rdfs:comment "A concrete textile repair occurrence that is both a textile process execution and an instance of the EU DPP RepairEvent semantics."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue txtprc:RepairProcess ;
            owl:onProperty txtprc:executesProcessType ],
        dpp:RepairEvent,
        txtrep:LifeExtensionProductEvent ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:TextileUpgradingEvent a owl:Class ;
    rdfs:label "Textile upgrading event"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-event-mireot> ;
    rdfs:comment "A concrete textile upgrading occurrence that is both a textile process execution and an instance of the EU DPP UpgradingEvent semantics."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue txtrep:UpgradeProcess ;
            owl:onProperty txtprc:executesProcessType ],
        dpp:UpgradingEvent,
        txtrep:LifeExtensionProductEvent ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:Upgradability a owl:Class ;
    rdfs:label "Upgradability"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Ability of a product to be accessible for actions that enhance functionality, performance, capacity, safety or aesthetics."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:subClassOf txtrep:LifeExtensionInterventionAspect ;
    txtcon:sourceLocator "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.1.2, printed pages 101-102, lines 2722-2728; JRC Preparatory Study, Section 13.10.1.4, printed page 472, lines 11264-11272; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtrep:addressesFailureMode a owl:ObjectProperty ;
    rdfs:label "addresses failure mode"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a concrete repair-related process execution or priority element to a textile failure mode that it addresses."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( txtprc:TextileProcessExecution txtrep:PriorityRepairElement ) ] ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:range txtdur:FailureMode ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:canBeDisassembledWithoutDamage a owl:DatatypeProperty ;
    rdfs:label "can be disassembled without damage"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Indicates whether the assessed product or relevant element was found capable of disassembly without damage in the stated assessment context."@en ;
    rdfs:domain txtrep:RepairabilityAssessmentResult ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
    rdfs:range xsd:boolean ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtrep:considersProcessType a owl:ObjectProperty ;
