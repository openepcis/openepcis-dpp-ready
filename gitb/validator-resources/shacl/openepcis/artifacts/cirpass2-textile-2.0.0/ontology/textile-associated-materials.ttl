txtam:hasComponentMaterial a owl:ObjectProperty ;
    rdfs:label "has component material"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-mat-mireot> ;
    rdfs:comment "Relates a non-textile component to a material occurrence from which the component is made."@en ;
    rdfs:domain txtam:NonTextileComponent ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    rdfs:range dpp:MaterialOfComposition ;
    txtcon:sourceLocator "EU DPP MAT module v1.0.2, dpp:MaterialOfComposition; JRC Annex 13.8.3, Table 168, page 459, from line 10991 (details/accessories with material type)"@en ;
    txtcon:sourceType txtcon:externalReuse .

txtam:hasNonTextileComponent a owl:ObjectProperty ;
    rdfs:label "has non-textile component"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile product to a non-textile component physically integrated into it."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    rdfs:range txtam:NonTextileComponent ;
    txtcon:modellingNote "The property is owned by Textile Associated Materials so that Textile Core remains independent of this extension module."@en ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtam:hasNonTextileComponentType a owl:ObjectProperty ;
    rdfs:label "has non-textile component type"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a non-textile component to a controlled concept describing its component type."@en ;
    rdfs:domain txtam:NonTextileComponent ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    rdfs:range txtam:NonTextileComponentTypeConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtam:hasPackagingMaterial a owl:ObjectProperty ;
    rdfs:label "has packaging material"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile product to a packaging-material occurrence used for its packaging, transport, storage or delivery."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    rdfs:range txtam:PackagingMaterial ;
    txtcon:modellingNote "The property is owned by Textile Associated Materials so that Textile Core remains independent of this extension module."@en ;
    txtcon:sourceLocator "JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtam:hasPackagingMaterialType a owl:ObjectProperty ;
    rdfs:label "has packaging material type"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a packaging material occurrence to a controlled concept describing the material type."@en ;
    rdfs:domain txtam:PackagingMaterial ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    rdfs:range txtam:PackagingMaterialTypeConcept ;
    txtcon:sourceLocator "JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtam:hasTextileChemicalFunction a owl:ObjectProperty ;
    rdfs:label "has textile chemical function"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile chemical substance to a controlled concept describing its function in textile manufacturing, treatment, finishing or functionalisation."@en ;
    rdfs:domain txtam:TextileChemicalSubstance ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    rdfs:range txtam:TextileChemicalFunctionConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtam:hasTextileChemicalUseCategory a owl:ObjectProperty ;
    rdfs:label "has textile chemical use category"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile chemical substance to a controlled category describing whether it is used as a process chemical, a performance chemical or occurs unintentionally."@en ;
    rdfs:domain txtam:TextileChemicalSubstance ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    rdfs:range txtam:TextileChemicalUseCategoryConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtam:TextileProductPart a owl:Class ;
    rdfs:label "Textile product part"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    skos:definition "A structural part of a textile product, including non-textile components and material reporting groups, without universally classifying the part as a product or material occurrence."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtamcs:acidDye a skos:Concept,
        txtam:TextileChemicalFunctionConcept ;
    rdfs:label "Acid dye"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Dye function corresponding to acid dyes used for compatible fibre types such as wool, silk or polyamide."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    skos:altLabel "Acid dyes"@en ;
    skos:broader txtamcs:dye ;
    skos:inScheme txtamcs:TextileChemicalFunctionScheme ;
    skos:notation "CHEM_ROLE_ACID_DYE" ;
    skos:prefLabel "Acid dye"@en ;
    txtcon:sourceLocator "JRC Section 12.3, printed page 227, lines 6506-6516; Annex 13.3.4, Table 121, printed page 355, caption at line 9581."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtamcs:acidOrAlkali a skos:Concept,
        txtam:TextileChemicalFunctionConcept ;
    rdfs:label "Acid or alkali"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Chemical function involving pH adjustment or chemical treatment during textile preparation, dyeing or finishing."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    skos:altLabel "Acids and alkalis"@en ;
    skos:inScheme txtamcs:TextileChemicalFunctionScheme ;
    skos:notation "CHEM_ROLE_ACID_OR_ALKALI" ;
    skos:prefLabel "Acid or alkali"@en ;
    skos:topConceptOf txtamcs:TextileChemicalFunctionScheme ;
    txtcon:sourceLocator "JRC Section 12.3, printed pages 226-228, lines 6440-6449, 6466-6470 and 6536-6537."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

