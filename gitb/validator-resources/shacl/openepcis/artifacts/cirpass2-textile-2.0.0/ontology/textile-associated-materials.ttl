txtam:PackagingMaterial a owl:Class ;
    rdfs:label "Packaging material"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A material occurrence used for the packaging, transport, storage or delivery of a textile product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
    rdfs:subClassOf dpp:MaterialOfComposition ;
    txtcon:modellingNote "PackagingMaterial is aligned as a subclass of dpp:MaterialOfComposition. Instances of a SKOS-based classification class can also instantiate an OWL material-classification class; the SKOS representation does not prevent such alignment. Packaging-specific class and type-property alignment remains a separate modelling decision requiring its own semantic assessment. No packaging alignment is introduced here."@en ;
    txtcon:sourceLocator "JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtam:TextileChemicalSubstance a owl:Class ;
