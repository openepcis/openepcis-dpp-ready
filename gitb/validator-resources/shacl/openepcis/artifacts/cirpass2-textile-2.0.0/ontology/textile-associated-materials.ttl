<https://w3id.org/eudpp/textile-associated-materials> a owl:Ontology ;
    rdfs:label "EU DPP Textile Associated Materials Ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Associated Materials Ontology. Version 2.0.0 candidate."@en ;
    dcterms:created "2026-03-06"^^xsd:date ;
    dcterms:creator "BOUGACHA Racem"@en,
        "Elio Hbeich"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Ontology module for non-textile components, packaging materials, textile chemical substances and controlled chemical classifications associated with textile products. Fibre composition remains in Textile Core, while regulatory qualification and occurrence of substances of concern belong to the Textile SoC module."@en ;
    dcterms:issued "2026-03-06"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-02"^^xsd:date ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    dcterms:title "EU DPP Textile Associated Materials Ontology"@en ;
    vann:preferredNamespacePrefix "txtam" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-associated-materials#" ;
    rdfs:comment "Chemical use category and chemical function are modelled as separate SKOS classification axes. This avoids treating a chemical function such as dye, biocide or softener as equivalent to whether the substance is intended to remain in the final article."@en,
        "The module reuses dpp:Substance for substance identity and the MAT MaterialOfComposition pattern where material occurrences are needed. It does not classify a substance as a substance of concern."@en ;
    owl:imports <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-core>,
        <https://w3id.org/eudpp/textile-mat-mireot>,
        <https://w3id.org/eudpp/textile-soc-mireot> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-associated-materials/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" ;
    txtcon:sourceLocator "JRC Textile Preparatory Study, Section 3.3.1, pages 27-29, lines 536-547; Section 3.3.2, pages 29-30, lines 575-593; Section 12.3, page 226, lines 6424-6455; Annex 13.8.3, Table 168, page 459, from line 10991."@en ;
    txtcon:sourceType txtcon:ontologyModule .
