    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:relevantToTextileProcess a owl:ObjectProperty ;
    rdfs:label "relevant to textile process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile substance occurrence to a textile process type that introduced, used, transformed or is affected by the substance."@en ;
    rdfs:domain txtsoc:TextileSubstanceOfConcernPresenceContext ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range <https://w3id.org/eudpp/textile-process#TextileProcess> ;
    txtcon:sourceLocator "JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:substanceIdentifier a owl:DatatypeProperty ;
    rdfs:label "substance identifier"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Functional interoperability property used for cross-checking against SVHC, CLP, POPs or other external references."@en ;
    rdfs:domain dpp:Substance ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range xsd:string ;
    skos:definition "Identifier used to match a substance against regulatory lists."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#substanceIdentifier> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#substanceIdentifier; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:thresholdNote a owl:DatatypeProperty ;
    rdfs:label "threshold note"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:domain dpp:ThresholdOfSubstanceOfConcern ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range xsd:string ;
    skos:definition "Additional explanatory note associated with a regulatory threshold."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#thresholdNote> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#thresholdNote; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:AlertConcentrationThreshold a owl:Class ;
    rdfs:label "Alert concentration threshold"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This class represents circularity-driven threshold values such as c_alert for SoC type (d)."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf dpp:ThresholdOfSubstanceOfConcern ;
    skos:definition "A threshold value above which a substance should trigger alert-based handling, such as disposal instead of recycling."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#AlertConcentrationThreshold> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#AlertConcentrationThreshold; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:MaximumThresholdValue a owl:Class ;
    rdfs:label "MaximumThresholdValue"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty txtcon:hasMeasurementUnit ;
            owl:someValuesFrom si:MeasurementUnit ],
        [ a owl:Restriction ;
            owl:onProperty txtsoc:maximumValue ;
            owl:someValuesFrom xsd:decimal ],
        txtcon:QuantitativeValue ;
    owl:disjointWith dpp:ConcentrationOfSubstanceOfConcern ;
    skos:definition "A Textile threshold expression represented by an upper bound on a decimal mass ratio."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:SVHCCandidateList a owl:Class ;
    rdfs:label "SVHC Candidate List"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "External regulatory reference used to determine SoC type (a) qualification. This reference may be documented with identifiers, source, version, and date information."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf txtsoc:ExternalRegulatoryReference ;
    skos:definition "List of substances identified under REACH Article 59."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#SVHCCandidateList> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#SVHCCandidateList; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:Situation a owl:Class ;
    rdfs:label "Situation"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Generic superclass introduced for modelling contextual situations. It is not tied to a specific regulatory domain."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "A contextualised state of affairs or configuration in which entities stand in a meaningful relation under specific conditions."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#Situation> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#Situation; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileConcentrationInformation a owl:Class ;
    rdfs:label "Textile concentration information"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Concentration information for a substance present in a textile product, expressed at product, component, material-group or spare-part level as an exact value, maximum value or range."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dpp:hasMeasurementUnit ;
            owl:someValuesFrom si:MeasurementUnit ],
        [ owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty dpp:numericalValue ;
                        owl:someValuesFrom xsd:decimal ] [ owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty dpp:minimumNumericalValue ;
                                    owl:someValuesFrom xsd:decimal ] [ a owl:Restriction ;
                                    owl:onProperty dpp:maximumNumericalValue ;
                                    owl:someValuesFrom xsd:decimal ] ) ] ) ],
        dpp:ConcentrationOfSubstanceOfConcern ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 7(5)(c)"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileMaterialGroup a owl:Class ;
    rdfs:label "Textile material group"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A fibre-, yarn- or fabric-based material grouping within a textile product that serves as a location or mass-reference unit for substance reporting."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf txtsoc:MaterialGroup ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TrackingThreshold a owl:Class ;
    rdfs:label "Tracking threshold"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This class represents thresholds used to determine whether a substance of concern must be tracked or reported in the DPP context."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf dpp:ThresholdOfSubstanceOfConcern ;
    skos:definition "A threshold value above which a substance of concern must be tracked or reported."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#TrackingThreshold> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#TrackingThreshold; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:adhesiveOrBondingLayerLocation a skos:Concept,
        txtsoc:TextileSoCLocationTypeConcept ;
    rdfs:label "Adhesive or bonding layer location"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "The substance is located in an adhesive, laminate, bonding film or other joining layer."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:inScheme txtsoc:TextileSoCLocationTypeScheme ;
    skos:notation "LOC_ADHESIVE_BONDING" ;
    skos:prefLabel "Adhesive or bonding layer location"@en ;
    skos:topConceptOf txtsoc:TextileSoCLocationTypeScheme ;
