    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:MaterialGroup a owl:Class ;
    rdfs:label "material group"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This class remains product-sector neutral. Sector-specific material group subclasses, such as textile material groups or hard component material groups, should be defined in product-specific modules."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf txtam:TextileProductPart ;
    skos:definition "A material or material grouping within a product, used as a structural unit for reporting or calculating substance concentration."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#MaterialGroup> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#MaterialGroup; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:ProductGroupSpecificSoCList a owl:Class ;
    rdfs:label "Product-group specific SoC list"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "External regulatory specification used to determine SoC type (d) qualification. This reference may be documented with identifiers, source, version, date, and product-category applicability information."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf txtsoc:ExternalRegulatoryReference ;
    skos:definition "List of substances hindering reuse or recycling for a given product group."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#ProductGroupSpecificSoCList> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#ProductGroupSpecificSoCList; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:RangeThresholdValue a owl:Class ;
    rdfs:label "RangeThresholdValue"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty txtsoc:lowerBound ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty txtcon:hasMeasurementUnit ;
            owl:someValuesFrom si:MeasurementUnit ],
        [ a owl:Restriction ;
            owl:onProperty txtsoc:upperBound ;
            owl:someValuesFrom xsd:decimal ],
        txtcon:QuantitativeValue ;
    owl:disjointWith dpp:ConcentrationOfSubstanceOfConcern ;
    skos:definition "A Textile threshold expression represented by lower and upper decimal mass-ratio bounds."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:TextileProductGroupSoCReference a owl:Class ;
    rdfs:label "Textile product-group SoC reference"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A versioned reference identifying the textile-product-group source that qualifies a substance under the product-group-specific type (d) criterion."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf txtsoc:ProductGroupSpecificSoCList ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 2(27)(d)."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileSoCHandlingInformation a owl:Class ;
    rdfs:label "Textile SoC handling information"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Textile-specific instruction information concerning safe use and lifecycle handling in the presence of a substance of concern, including disassembly, preparation for reuse, reuse, recycling and environmentally sound end-of-life management; repair guidance may be added as a textile/JRC extension."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf dpp:SubstanceManagementInstruction ;
    txtcon:sourceLocator "JRC Section 12.1, printed pages 219-220, lines 6205-6220."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileTypeDQualification a owl:Class ;
    rdfs:label "Textile type (d) qualification"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A product-group-specific type (d) qualification indicating that a substance hinders the reuse or recycling of a textile product or textile material stream."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue dpp:CriterionD ;
            owl:onProperty dpp:hasSoCCriterion ],
        dpp:SoCQualificationAssertion ;
    txtcon:sourceLocator "JRC Section 12.1, printed page 219, lines 6169-6170; Section 12.3.6, printed pages 238-239, lines 6634-6639; Section 12.3.11, printed page 246, lines 6815-6822."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:ConcentrationReferenceBasis a owl:Class ;
    rdfs:label "concentration reference basis"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "ConcentrationReferenceBasis represents the denominator or reference scope used for concentration calculation, such as the final product mass, an article mass, a product part mass, or a material group mass. It is distinct from the reporting level and from the concrete product part to which the information may refer."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "Reference basis against which a substance concentration is calculated or reported."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#ConcentrationReferenceBasis> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#ConcentrationReferenceBasis; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:InstructionType a owl:Class ;
    rdfs:label "Instruction type"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This class represents the kind of instruction expressed in the DPP information element."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "Declared type of instruction according to the relevant lifecycle-related activity addressed by the information element."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#InstructionType> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#InstructionType; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:ReportingLevel a owl:Class ;
    rdfs:label "reporting level"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Reporting level indicates the declared granularity of an information item, such as product level, component level, material level, or spare-part level. It does not by itself identify the concrete product part concerned, nor does it define the mass reference basis used for concentration calculation."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "Declared level of granularity at which a substance-related information item is reported."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#ReportingLevel> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#ReportingLevel; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasRegulatoryBasis a owl:ObjectProperty ;
    rdfs:label "has regulatory basis"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Generic property linking a qualification to its supporting external legal or classificatory basis."@en ;
    rdfs:domain dpp:SoCQualificationAssertion ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:ExternalRegulatoryReference ;
    skos:definition "Links a regulatory qualification to the external regulatory reference on which it is based."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#hasRegulatoryBasis> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasRegulatoryBasis; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasThresholdQuantitativeValue a owl:ObjectProperty ;
    rdfs:label "has threshold quantitative value"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This property links a regulatory threshold to an exact, maximum, or range quantitative value."@en ;
    rdfs:domain dpp:ThresholdOfSubstanceOfConcern ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtcon:QuantitativeValue ;
    skos:definition "Links a regulatory threshold to its quantitative expression."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#hasThresholdQuantitativeValue> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasThresholdQuantitativeValue; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:LocationInformation a owl:Class ;
    rdfs:label "Location information"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Information object attached to a SubstancePresenceContext in order to describe the reported location of the substance within the product. This class does not imply a formal spatial model."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "Contextual qualitative information describing where a substance is located within a product."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#LocationInformation> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#LocationInformation; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileSubstanceOfConcernPresenceContext a owl:Class ;
    rdfs:label "Textile substance of concern presence context"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A substance-of-concern presence context specialised for a textile product, textile material group or non-textile component."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dpp:concernsSubstance ;
            owl:someValuesFrom dpp:SubstanceOfConcern ],
        [ a owl:Restriction ;
            owl:onProperty dpp:hasApplicableQualification ;
            owl:someValuesFrom dpp:SoCQualificationAssertion ],
        [ a owl:Restriction ;
            owl:onProperty dpp:isSubstancePresenceOf ;
            owl:someValuesFrom dpp:Product ],
        dpp:SubstancePresence ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 2(27) and Article 7(5); CORE SOC 2.2.0 SubstancePresence."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:ThresholdEvaluation a owl:Class ;
    rdfs:label "Threshold evaluation"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This class represents the evaluative layer between measurement and regulatory consequence. It does not replace ConcentrationInformation or RegulatoryThreshold; it records the result of applying a threshold rule to a concentration value in a given substance presence context."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty txtsoc:hasThresholdEvaluationResult ;
            owl:someValuesFrom txtsoc:ThresholdEvaluationResult ],
        [ a owl:Restriction ;
            owl:onProperty txtsoc:evaluatesAgainstThreshold ;
            owl:someValuesFrom dpp:ThresholdOfSubstanceOfConcern ],
        [ a owl:Restriction ;
            owl:onProperty txtsoc:evaluatesConcentrationInformation ;
            owl:someValuesFrom dpp:ConcentrationOfSubstanceOfConcern ],
        txtsoc:Situation ;
    skos:definition "A contextual regulatory evaluation in which a reported concentration is compared with an applicable regulatory threshold."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#ThresholdEvaluation> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#ThresholdEvaluation; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:ThresholdEvaluationResult a owl:Class ;
    rdfs:label "Threshold evaluation result"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This class is used as a controlled vocabulary for the outcome of threshold evaluation."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "Controlled result value produced by a threshold evaluation."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#ThresholdEvaluationResult> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#ThresholdEvaluationResult; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:ExternalRegulatoryReference a owl:Class ;
    rdfs:label "External regulatory reference"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This class represents external documentary or classificatory references used to justify or determine a regulatory qualification."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "An external regulatory list, classification, or specification used as the basis for a regulatory qualification."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#ExternalRegulatoryReference> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#ExternalRegulatoryReference; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileSoCLocationTypeConcept a owl:Class ;
    rdfs:label "Textile SoC location type concept"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled concept describing a textile-specific kind of product location used to qualify a substance location statement."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileSoCLocationTypeScheme a skos:ConceptScheme ;
    rdfs:label "Textile SoC location type scheme"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary of textile-specific location types used in substance location information."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:hasTopConcept txtsoc:adhesiveOrBondingLayerLocation,
        txtsoc:coatingOrFinishLocation,
        txtsoc:fibreCompositionLocation,
        txtsoc:nonTextileComponentLocation,
        txtsoc:printedOrDyedRegionLocation,
        txtsoc:unknownTextileProductLocation,
        txtsoc:wholeProductLocation ;
    skos:prefLabel "Textile SoC location type scheme"@en ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

<https://w3id.org/eudpp/textile-soc> a owl:Ontology ;
    rdfs:label "Textile substances of concern ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Ontology - Textile Substances of Concern Module. Version 2.0.0 candidate."@en ;
    dcterms:created "2026-07-09"^^xsd:date ;
    dcterms:creator "BOUGACHA Racem"@en,
        "Elio Hbeich"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Textile-sector specialisation of the EU DPP Substances of Concern ontology. It specialises substance presence, product location, concentration reporting, product-group qualification, thresholds and lifecycle handling for textile products."@en ;
    dcterms:issued "2026-07-09"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-27"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    dcterms:title "EU DPP Textile Ontology - Textile Substances of Concern Module"@en ;
    vann:preferredNamespacePrefix "txtsoc" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-soc#" ;
    rdfs:comment "This module does not classify every textile chemical as a substance of concern. It specialises the generic SoC presence-context model for textile products and attaches textile-specific information to the occurrence, not globally to the chemical identity."@en ;
    owl:imports <https://w3id.org/eudpp/textile-associated-materials>,
        <https://w3id.org/eudpp/textile-con-mireot>,
        <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-core>,
        <https://w3id.org/eudpp/textile-process>,
        <https://w3id.org/eudpp/textile-soc-mireot> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-soc/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" .

[] a owl:AllDisjointClasses ;
    owl:members ( txtsoc:TextileSubstanceOfConcernPresenceContext txtsoc:TextileConcentrationInformation txtsoc:TextileProductGroupSoCReference txtsoc:TextileSoCHandlingInformation ) .
