    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#refersToProductPartForConcentration; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

