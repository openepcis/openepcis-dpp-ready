    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#refersToProductPartForLocation; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:refersToProductPartForThreshold a owl:ObjectProperty ;
    rdfs:label "refersToProductPartForThreshold"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:domain dpp:ThresholdOfSubstanceOfConcern ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtam:TextileProductPart ;
