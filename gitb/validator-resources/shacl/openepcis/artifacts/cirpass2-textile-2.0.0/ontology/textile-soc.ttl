@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix si: <https://si-digital-framework.org/SI#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix txtam: <https://w3id.org/eudpp/textile-associated-materials#> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix txtsoc: <https://w3id.org/eudpp/textile-soc#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

txtsoc:AboveThreshold a owl:NamedIndividual,
        txtsoc:ThresholdEvaluationResult ;
    rdfs:label "AboveThreshold"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "An evaluation result in which the complete concentration interval lies above the threshold interval."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:AtThreshold a owl:NamedIndividual,
        txtsoc:ThresholdEvaluationResult ;
    rdfs:label "AtThreshold"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "An evaluation result in which exact concentration and exact threshold values are equal."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:BelowThreshold a owl:NamedIndividual,
        txtsoc:ThresholdEvaluationResult ;
    rdfs:label "below threshold"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "Evaluation result indicating that the reported concentration is below the applicable threshold."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#BelowThreshold> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#BelowThreshold; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:ExactThresholdValue a owl:Class ;
    rdfs:label "ExactThresholdValue"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty txtcon:hasMeasurementUnit ;
            owl:someValuesFrom si:MeasurementUnit ],
        [ a owl:Restriction ;
            owl:onProperty txtcon:numericValue ;
            owl:someValuesFrom xsd:decimal ],
        txtcon:QuantitativeValue ;
    owl:disjointWith dpp:ConcentrationOfSubstanceOfConcern ;
    skos:definition "A Textile threshold expression represented by one exact decimal mass-ratio value."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:IndeterminateThresholdResult a owl:NamedIndividual,
        txtsoc:ThresholdEvaluationResult ;
    rdfs:label "IndeterminateThresholdResult"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "An evaluation result in which the recorded intervals overlap without establishing an exact equality or a strictly lower or higher relation."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:MaterialGroupMassBasis a owl:NamedIndividual,
        txtsoc:ConcentrationReferenceBasis ;
    rdfs:label "material group mass basis"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "A concentration reference basis using the mass of the identified material reporting group as denominator."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:MaterialLevel a owl:NamedIndividual,
        txtsoc:ReportingLevel ;
    rdfs:label "Material level"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:definition "Reporting level corresponding to a material or material group within a product structure."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#MaterialLevel> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#MaterialLevel; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:NonExemptionThreshold a owl:Class ;
    rdfs:label "Non-exemption threshold"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This class represents thresholds used to determine when exemptions are not allowed, such as the 0.1% w/w threshold for certain substances."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty txtsoc:hasThresholdQuantitativeValue ;
            owl:someValuesFrom txtcon:QuantitativeValue ],
        dpp:ThresholdOfSubstanceOfConcern ;
    owl:disjointWith dpp:ConcentrationOfSubstanceOfConcern ;
    skos:definition "A threshold value above which an information element may not be exempted."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#NonExemptionThreshold> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#NonExemptionThreshold; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:NonTextileComponentMaterialGroup a owl:Class ;
    rdfs:label "Non-textile component material group"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A material grouping associated with one or more non-textile components, used as a location or concentration reference unit without treating the component itself as a material group."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf txtsoc:MaterialGroup ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:RecyclingInstructionType a owl:NamedIndividual,
        txtsoc:InstructionType ;
    rdfs:label "recycling"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Instruction related to the recycling of the product in relation to the substance."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#RecyclingInstructionType> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#RecyclingInstructionType; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:SafeUseInstructionType a owl:NamedIndividual,
        txtsoc:InstructionType ;
    rdfs:label "safe-use"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Instruction related to the safe use of the product in relation to the substance."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#SafeUseInstructionType> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#SafeUseInstructionType; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileFibreCompositionMaterialGroup a owl:Class ;
    rdfs:label "Textile fibre-composition material group"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Bridge class for a fibre-composition component that is used as the material-group scope of a textile substance-of-concern presence context."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf <https://w3id.org/eudpp/textile-core#FibreCompositionComponent>,
        txtsoc:TextileMaterialGroup ;
    txtcon:modellingNote "This local bridge avoids globally reclassifying every Textile Core fibre-composition component as a SoC material group."@en ;
    txtcon:sourceLocator "JRC Section 12.3.12, printed page 246, lines 6847-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileRecyclingAlertThreshold a owl:Class ;
    rdfs:label "Textile recycling alert threshold"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A textile-sector alert concentration used to inform sorting, recycling or environmentally sound end-of-life handling when the substance may hinder circular treatment."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty txtsoc:hasThresholdQuantitativeValue ;
            owl:someValuesFrom txtcon:QuantitativeValue ],
        txtsoc:AlertConcentrationThreshold ;
    owl:disjointWith dpp:ConcentrationOfSubstanceOfConcern ;
    txtcon:sourceLocator "JRC Section 9.2.5.2, printed page 142, lines 3910-3927; Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileTrackingThreshold a owl:Class ;
    rdfs:label "Textile tracking threshold"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A tracking or disclosure threshold applicable to a substance occurrence in a textile product or textile product group."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty txtsoc:hasThresholdQuantitativeValue ;
            owl:someValuesFrom txtcon:QuantitativeValue ],
        txtsoc:TrackingThreshold ;
    owl:disjointWith dpp:ConcentrationOfSubstanceOfConcern ;
    txtcon:sourceLocator "JRC Section 12.1, printed page 220, lines 6213-6220; Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:analyticalMethod a owl:DatatypeProperty ;
    rdfs:label "analytical method"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:domain dpp:ConcentrationOfSubstanceOfConcern ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range xsd:string ;
    skos:definition "Textual description of the analytical method used to determine or verify the concentration."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#analyticalMethod> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#analyticalMethod; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:appliesToProduct a owl:ObjectProperty ;
    rdfs:label "qualification applies to product"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:domain dpp:SoCQualificationAssertion ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range dpp:Product ;
    skos:definition "Identifies the product to which a qualification assertion applies in this Textile reporting profile."@en ;
    txtcon:modellingNote "Qualification applicability in the Textile SoC profile. This differs from dpp:appliesToProduct, whose domain is DigitalProductPassport. Always use the txtsoc prefix for qualification scope."@en ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtsoc:evaluationNote a owl:DatatypeProperty ;
    rdfs:label "evaluation note"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:domain txtsoc:ThresholdEvaluation ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range xsd:string ;
    skos:definition "Additional explanatory note associated with a threshold evaluation."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#evaluationNote> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#evaluationNote; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasApplicableRegulatoryThreshold a owl:ObjectProperty ;
    rdfs:label "has applicable regulatory threshold"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This property indicates which regulatory thresholds are relevant for interpreting a reported concentration. It does not by itself express whether the threshold is met, exceeded, or violated."@en ;
    rdfs:domain dpp:ConcentrationOfSubstanceOfConcern ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range dpp:ThresholdOfSubstanceOfConcern ;
    skos:definition "Links a concentration information object to a regulatory threshold that is applicable for its interpretation."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#hasApplicableRegulatoryThreshold> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasApplicableRegulatoryThreshold; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasConcentrationReferenceBasis a owl:ObjectProperty ;
    rdfs:label "has concentration reference basis"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This property clarifies the denominator or reference scope of the reported concentration. It is important because the regulatory interpretation of a concentration may differ depending on whether it is calculated against the final product, an article, a product part, or a material group."@en ;
    rdfs:domain dpp:ConcentrationOfSubstanceOfConcern ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:ConcentrationReferenceBasis ;
    skos:definition "Links a concentration information object to the reference basis used for calculating or reporting the concentration."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#hasConcentrationReferenceBasis> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasConcentrationReferenceBasis; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasConcentrationReportingLevel a owl:ObjectProperty ;
    rdfs:label "has concentration reporting level"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This property expresses whether the concentration is reported at product, component, material, or spare-part level."@en ;
    rdfs:domain dpp:ConcentrationOfSubstanceOfConcern ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:ReportingLevel ;
    skos:definition "Indicates the reporting granularity at which the concentration is described."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#hasConcentrationReportingLevel> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasConcentrationReportingLevel; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasInstructionType a owl:ObjectProperty ;
    rdfs:label "has instruction type"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This property expresses whether the instruction concerns safe use, repair, reuse, disassembly, or recycling."@en ;
    rdfs:domain dpp:SubstanceManagementInstruction ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:InstructionType ;
    skos:definition "Indicates the declared type of instruction represented by an instruction information object."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#hasInstructionType> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasInstructionType; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasLocationInformation a owl:ObjectProperty ;
    rdfs:label "has location information"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "This property attaches contextual location information to a substance presence context."@en ;
    rdfs:domain dpp:SubstancePresence ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:LocationInformation ;
    skos:definition "Links a substance presence context to a location information object."@en ;
    prov:wasDerivedFrom <https://w3id.org/eudpp/soc#hasLocationInformation> ;
    txtcon:modellingNote "Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted."@en ;
    txtcon:sourceLocator "Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasLocationInformation; local adaptation: docs/decisions/TXT-DEC-010.md"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasPresenceChemicalFunction a owl:ObjectProperty ;
    rdfs:label "has presence chemical function"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile substance occurrence to the chemical function performed in that textile context."@en ;
    rdfs:domain txtsoc:TextileSubstanceOfConcernPresenceContext ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtam:TextileChemicalFunctionConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:hasPresenceUseCategory a owl:ObjectProperty ;
    rdfs:label "has presence use category"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Classifies the textile chemical occurrence by whether it is associated with process use, intended performance use or unintended presence. The classification is attached to the occurrence rather than globally to the substance identity."@en ;
    rdfs:domain txtsoc:TextileSubstanceOfConcernPresenceContext ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtam:TextileChemicalUseCategoryConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:hasTextileHandlingInformation a owl:ObjectProperty ;
    rdfs:label "has textile handling information"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile substance-of-concern presence context to textile-specific safe-use or lifecycle-handling information."@en ;
    rdfs:domain txtsoc:TextileSubstanceOfConcernPresenceContext ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:TextileSoCHandlingInformation ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 7(5)(d)-(e)."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:hasTextileLocationType a owl:ObjectProperty ;
    rdfs:label "has textile location type"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a location information object to a controlled textile-specific location type."@en ;
    rdfs:domain txtsoc:LocationInformation ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:TextileSoCLocationTypeConcept ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 7(5)(b)."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:hasTextileProductGroupReference a owl:ObjectProperty ;
    rdfs:label "has textile product-group reference"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile type (d) qualification to the versioned textile product-group reference supporting that qualification."@en ;
    rdfs:domain txtsoc:TextileTypeDQualification ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:TextileProductGroupSoCReference ;
    rdfs:subPropertyOf txtsoc:hasRegulatoryBasis ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 2(27)(d)."@en ;
