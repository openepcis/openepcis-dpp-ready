txtsoc:refersToProductPartForConcentration a owl:ObjectProperty ;
    rdfs:label "refers to product part for concentration"@en ;
    dcterms:source <https://w3id.org/eudpp/soc>,
        <https://w3id.org/eudpp/textile-ontology> ;
