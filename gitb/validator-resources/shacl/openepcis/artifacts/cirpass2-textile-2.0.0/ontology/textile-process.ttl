    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:YarnSoftness,
        txtstr:YarnStrength,
        txtstr:YarnUniformity .

txtprc:SpinningSpeed a owl:Class ;
    rdfs:label "Spinning speed"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Spinning parameter describing the speed of spinning."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:SpinningParameter ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Higher spinning speeds can cause breakages and may negatively influence yarn strength depending on process conditions."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:YarnStrength .

