    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Care parameter describing ironing temperature."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:CareParameter ;
    txtcon:modellingNote "Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:KnittingPatternSpecification a owl:Class ;
    rdfs:label "Knitting pattern specification"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A process target specification stating the knitting structure or pattern to be produced."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FabricConstructionParameter ;
    txtcon:modellingNote "Knitting pattern is kept as a process-side construction parameter. Its relation to fabric elasticity and drape depends on the knitting structure and yarn choice."@en,
        "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:FabricDrape,
        txtstr:FabricElasticity .

txtprc:KnittingProcess a owl:Class ;
    rdfs:label "Knitting process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Fabric manufacturing process in which yarns are interlooped using needles to form fabric on knitting machines."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FabricManufacturingProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Knitting is generally used for relatively more elastic fabrics, depending on yarns, knitting pattern and product application."@en ;
