txtprc:DyeingProcess a owl:Class ;
    rdfs:label "Dyeing process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Wet processing process used to impart colour to textile fibres, yarns, fabrics or finished products."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:WetProcessingProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Dyeing gives colour-related characteristics, while colour fastness depends on dye type, fibre type, process conditions and finishing."@en ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtdur:ColourFastness ;
    txtprc:typicallyUsesChemicalFunction txtamcs:dye ;
    txtprc:typicallyUsesChemicalUseCategory txtamcs:performanceChemical .

txtprc:DyeingTemperature a owl:Class ;
    rdfs:label "Dyeing temperature"@en ;
