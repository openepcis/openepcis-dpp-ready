    rdfs:comment "Dyeing parameter describing the temperature used during a dyeing process."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:DyeingParameter ;
    txtcon:evidenceStatus txtcon:explicitEvidence,
