txtprc:FinishingParameter a owl:Class ;
    rdfs:label "Finishing parameter"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process parameter relevant to textile finishing, including chemical and mechanical finishing."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessControlParameter,
        txtprc:ProcessParameter ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:FinishingProcess a owl:Class ;
    rdfs:label "Finishing process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile process applied to modify appearance, handle, function or physical properties of textile materials or products."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:TextileManufacturingProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:SpinningMethodConcept a owl:Class ;
    rdfs:label "Spinning method concept"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "SKOS concept used as a controlled value for a spinning method."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessMethodConcept ;
    txtcon:sourceLocator "Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:CareParameter a owl:Class ;
    rdfs:label "Care parameter"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process parameter relevant to textile care, including washing, drying, ironing, bleaching, cleaning or storage conditions."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessControlParameter,
        txtprc:ProcessParameter ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:DyeingParameter a owl:Class ;
    rdfs:label "Dyeing parameter"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process parameter relevant to textile dyeing."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FinishingParameter,
        txtprc:ProcessControlParameter ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:FabricConstructionParameter a owl:Class ;
    rdfs:label "Fabric construction parameter"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process-side parameter describing how a fabric construction is specified or controlled during manufacturing. The resulting observable construction characteristics are represented in TEXTILE_STRUCTURE."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FabricManufacturingParameter,
        txtprc:ProcessTargetSpecification ;
    txtcon:evidenceStatus txtcon:reconstructedEvidence ;
    txtcon:modellingNote "This superclass separates fabric-construction process parameters from broader fabric manufacturing parameters and clarifies their relation to fabric-level structural characteristics."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:ProcessMethodConcept a owl:Class ;
    rdfs:label "Process method concept"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "SKOS concept used as a controlled value for a textile process method or technique."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:FabricManufacturingMethodScheme a skos:ConceptScheme ;
    rdfs:label "Fabric manufacturing method scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary of fabric manufacturing methods."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    skos:hasTopConcept txtprc:knittingMethod,
        txtprc:nonwovenMethod,
        txtprc:weavingMethod ;
    skos:prefLabel "Fabric manufacturing method scheme"@en ;
    txtcon:sourceLocator "Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:ProcessParameterSetting a owl:Class ;
    rdfs:label "Process parameter setting"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A concrete value or selected category assigned to a process parameter for a specific process execution."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-009.md"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:SpinningMethodScheme a skos:ConceptScheme ;
    rdfs:label "Spinning method scheme"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary of spinning methods relevant to yarn manufacturing."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    skos:hasTopConcept txtprc:airJetSpinning,
        txtprc:ringSpinning,
        txtprc:rotorOpenEndSpinning ;
    skos:prefLabel "Spinning method scheme"@en ;
    txtcon:sourceLocator "Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:TextileManufacturingProcess a owl:Class ;
    rdfs:label "Textile manufacturing process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile process involved in the manufacturing or transformation of textile fibres, yarns, fabrics, assemblies or finished textile products."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:TextileProcess ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:UseAndCareProcess a owl:Class ;
    rdfs:label "Use and care process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process occurring during the use or care phase of a textile product, including wearing, washing, drying, cleaning, ironing and storage-related care."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:TextileProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:ProcessControlParameter a owl:Class ;
    rdfs:label "Process control parameter"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A process parameter that controls, configures or monitors the execution conditions of a textile process."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessParameter ;
    txtcon:sourceLocator "motivated by JRC Table 181 and care-process parameters."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:SpinningParameter a owl:Class ;
    rdfs:label "Spinning parameter"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process parameter relevant to spinning or yarn manufacturing."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessControlParameter,
        txtprc:ProcessParameter ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:ProcessParameter a owl:Class ;
    rdfs:label "Process parameter"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A semantic type for a configurable process condition, method choice, control variable or target specification relevant to a textile process."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    txtcon:sourceLocator "domain motivation from JRC Annex 13.10.2, pages 492-493, Table 181, lines 11889-11901. JRC Annex 13.10.2, pages 493-495, Table 182, lines 11902-11920. JRC Section 9.2.2.2, pages 125-126, lines 3296-3327; Annex 13.7.2, pages 394-395, lines 10227-10248."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:TextileProcess a owl:Class ;
    rdfs:label "Textile process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A type of process involved in manufacturing, transforming, using, caring for, repairing, reusing, recycling or treating a textile product, including a product used as a component of another product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    txtcon:modellingNote "The JRC describes process families across lifecycle stages; the ontology introduces a common superclass."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:TextileProcessExecution a owl:Class ;
    rdfs:label "Textile process execution"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A concrete occurrence of a textile process applied to one or more products, including products serving an intermediate or component role, materials or components."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-008.md"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

<https://w3id.org/eudpp/textile-process> a owl:Ontology ;
    rdfs:label "EU DPP Textile Process Ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Process Ontology. Version 2.0.0 candidate."@en ;
    dcterms:created "2026-03-06"^^xsd:date ;
    dcterms:creator "Elio Hbeich"@en,
        "BOUGACHA Racem"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Ontology module for textile process types, concrete process executions, process parameters, target specifications and parameter settings across manufacturing, care, repair and end-of-life stages."@en ;
    dcterms:issued "2026-03-06"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-27"^^xsd:date ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ;
    dcterms:title "EU DPP Textile Process Ontology"@en ;
    vann:preferredNamespacePrefix "txtprc" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-process#" ;
    rdfs:comment "The module separates process types from concrete executions, parameter types from concrete settings, and process controls from target product specifications. Product characteristics and assessment results remain in their dedicated modules."@en ;
    owl:imports <https://w3id.org/eudpp/textile-associated-materials>,
        <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-core>,
        <https://w3id.org/eudpp/textile-dpp-mireot>,
        <https://w3id.org/eudpp/textile-durability>,
        <https://w3id.org/eudpp/textile-event-mireot>,
        <https://w3id.org/eudpp/textile-structure> ;
    owl:priorVersion <https://w3id.org/eudpp/textile-process/1.1.2> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-process/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" ;
    txtcon:sourceLocator "JRC Section 3.3.1, pages 27-29, Table 8, lines 536-547. JRC Section 9.2.1.1, pages 110-111, lines 2889-2910, Figure 22. JRC Annex 13.10.2, pages 492-493, Table 181, lines 11889-11901. JRC Annex 13.10.2, pages 493-495, Table 182, lines 11902-11920. JRC Section 9.2.2.2, pages 125-126, lines 3296-3327; Annex 13.7.2, pages 394-395, lines 10227-10248. JRC Section 9.2.3.2-9.2.3.3, pages 129-130, lines 3466-3483; Annex 13.10.1.5, pages 473-474, lines 11273-11326. JRC Section 3.3.1, page 29, Table 8, line 547; Annex 13.10.1, pages 481-482, lines 11685-11730."@en ;
    txtcon:sourceType txtcon:ontologyModule .

[] a owl:AllDisjointClasses ;
    owl:members ( txtprc:TextileProcess txtprc:TextileProcessExecution txtprc:ProcessParameter txtprc:ProcessParameterSetting txtprc:ProcessMethodConcept ) .

_:nae11d99541a9436d875e2bc4600d58dcb46 rdf:first txtprc:TextileProcess ;
    rdf:rest ( txtprc:TextileProcessExecution ) .

_:nae11d99541a9436d875e2bc4600d58dcb13 a owl:Class ;
    owl:unionOf _:nae11d99541a9436d875e2bc4600d58dcb46 .
