txtprc:usesChemicalFunction a owl:ObjectProperty ;
    rdfs:label "uses chemical function"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile process type or execution to the technical function of a chemical used in that process."@en ;
    rdfs:domain _:nae11d99541a9436d875e2bc4600d58dcb13 ;
