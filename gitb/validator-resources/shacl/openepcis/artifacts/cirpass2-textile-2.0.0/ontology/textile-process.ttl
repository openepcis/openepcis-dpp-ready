txtprc:RepairProcess a owl:Class ;
    rdfs:label "Repair process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Repair can extend the usable lifetime of a textile product, but this module does not import TEXTILE_INDICATOR. Links from repair to product lifetime indicators should be handled in TEXTILE_INDICATOR or in a cross-module relation layer."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:MaintenanceAndRepairProcess ;
