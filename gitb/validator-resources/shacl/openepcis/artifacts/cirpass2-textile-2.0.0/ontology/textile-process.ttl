txtprc:CareMethodConcept a owl:Class ;
    rdfs:label "Care method concept"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "SKOS concept used as a controlled value for a textile care method."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessMethodConcept ;
    txtcon:sourceLocator "Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:CellulosicChemicalRecyclingProcess a owl:Class ;
    rdfs:label "Cellulosic chemical recycling process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Chemical recycling process for cellulosic textile feedstock, producing cellulosic pulp or another recovered cellulosic feedstock."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ChemicalRecyclingProcess ;
    txtcon:sourceLocator "JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:ChemicalFinishingProcess a owl:Class ;
    rdfs:label "Chemical finishing process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Finishing process using chemical substances or treatments to confer or modify functional properties of textile materials or products."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FinishingProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence,
        txtcon:stronglyImpliedEvidence ;
    txtcon:modellingNote "Chemical finishing can provide functional properties such as water repellency, flame retardancy, antimicrobial effects or UV protection. The exact relation should be asserted through the chemical role represented in TEXTILE_ASSOCIATED_MATERIALS and through specific durability parameters when known."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:CleaningProcess a owl:Class ;
    rdfs:label "Cleaning process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Care process involving domestic laundering, professional cleaning, dry cleaning or wet cleaning of a textile product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:UseAndCareProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:CoatingAdditiveUse a owl:Class ;
    rdfs:label "Coating additive use"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "The additive substance or chemical role should be represented in TEXTILE_ASSOCIATED_MATERIALS. This parameter only records the process-use aspect."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:CoatingParameter ;
    txtcon:evidenceStatus txtcon:reconstructedEvidence,
        txtcon:supportingEvidence ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:CoatingProcess a owl:Class ;
    rdfs:label "Coating process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Finishing process applying a coating layer or functional surface treatment to a textile material or product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FinishingProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence,
        txtcon:stronglyImpliedEvidence ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:CuttingParameter a owl:Class ;
    rdfs:label "Cutting parameter"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Confectioning parameter relevant to cutting operations."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ConfectioningParameter ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:CuttingProcess a owl:Class ;
    rdfs:label "Cutting process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Confectioning process in which textile materials are cut into components or pattern pieces."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ConfectioningProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence,
        txtcon:stronglyImpliedEvidence ;
    txtcon:modellingNote "Precision of cuts is modelled as influenced by the cutting process and relevant to final appearance and physical durability."@en ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:CutPrecision .

txtprc:DefectControl a owl:Class ;
    rdfs:label "Defect control"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process parameter or quality-control practice aimed at preventing or detecting defects during textile processing."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessParameter ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Defect control is modelled as supporting improved product performance by preventing imperfections in yarn and fabric."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:YarnUniformity ;
    txtcon:typicallyReducesLikelihoodOf txtdur:FabricBreakdown .

txtprc:DigitalTextileCareInstruction a owl:Class ;
    rdfs:label "Digital textile care instruction"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Textile care instruction supplied in a digital form, for example through a Digital Product Passport or a linked digital resource."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf dpp:DigitalInstruction,
        txtprc:TextileCareInstruction ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 6.3.2, printed page 85, lines 2153-2173."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:DigitalTextileEndOfLifeInstruction a owl:Class ;
    rdfs:label "Digital textile end-of-life instruction"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ;
    rdfs:comment "Textile end-of-life instruction supplied in digital form, for example through a Digital Product Passport or a linked digital resource."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf dpp:DigitalInstruction,
        txtprc:TextileEndOfLifeInstruction ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.3.8, printed page 359, lines 9662-9688; JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2183-2192; JRC DPP Study, Section 7.3, printed page 49, end-of-life treatment information data point."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:DryingProcess a owl:Class ;
    rdfs:label "Drying process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Care process involving drying of a textile product, including tumble drying or line drying."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:UseAndCareProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Drying conditions may influence dimensional stability and wrinkling, depending on temperature and drying method."@en ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtdur:DimensionalStability,
        txtdur:Wrinkling .

txtprc:DryingTemperature a owl:Class ;
    rdfs:label "Drying temperature"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Care parameter describing drying temperature used during care."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:CareParameter ;
    txtcon:modellingNote "Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:DyeConcentration a owl:Class ;
    rdfs:label "Dye concentration"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Dyeing parameter describing the concentration of dye or colourant used in a dyeing process."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
