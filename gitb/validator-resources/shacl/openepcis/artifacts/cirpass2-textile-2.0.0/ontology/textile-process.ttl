txtprc:hasSpinningMethod a owl:ObjectProperty ;
    rdfs:label "has spinning method"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a spinning process type or concrete execution to a controlled spinning-method concept."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( txtprc:SpinningProcess txtprc:TextileProcessExecution ) ] ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:SpinningMethodConcept ;
    rdfs:subPropertyOf txtprc:hasProcessMethod ;
    txtcon:sourceLocator "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:hasTextualValue a owl:DatatypeProperty ;
    rdfs:label "has textual value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a process parameter setting to a free-text value when no controlled concept is available."@en ;
    rdfs:domain txtprc:ProcessParameterSetting ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range xsd:string ;
    txtcon:sourceLocator "Textile Process value pattern, version 1.1.0."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:parameterOfProcess a owl:ObjectProperty ;
    rdfs:label "parameter of process"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a process parameter or target specification to the textile process type that it configures or specifies."@en ;
    rdfs:domain txtprc:ProcessParameter ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:TextileProcess ;
    owl:inverseOf txtprc:hasProcessParameter ;
    txtcon:sourceLocator "Inverse of the corrected hasProcessParameter pattern"@en ;
    txtcon:sourceType txtcon:projectDecision .

txtprc:producesOutput a owl:ObjectProperty ;
    rdfs:label "produces output"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile process type or execution to a textile product produced as an output, including a product that may subsequently be used as a component of another product."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( txtprc:TextileProcess txtprc:TextileProcessExecution ) ] ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txt:TextileProduct ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:representsProcessExecution a owl:ObjectProperty ;
    rdfs:label "represents process execution"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Links a product event to the textile process execution it records or represents."@en ;
    rdfs:domain dpp:ProductEvent ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:TextileProcessExecution ;
    owl:inverseOf txtprc:isRepresentedByProductEvent ;
    txtcon:modellingNote "This bridge does not assert that a process execution is itself an event. It links the execution to an event resource that records or represents it."@en ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtprc:settingForProcessParameter a owl:ObjectProperty ;
    rdfs:label "setting for process parameter"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a concrete process parameter setting to the parameter type or target specification that it instantiates."@en ;
    rdfs:domain txtprc:ProcessParameterSetting ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:ProcessParameter ;
    txtcon:sourceLocator "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

