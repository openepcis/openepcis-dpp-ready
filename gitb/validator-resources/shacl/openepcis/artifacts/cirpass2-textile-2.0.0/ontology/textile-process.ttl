    txtcon:modellingNote "Expected SI quantity kind: quantities:TIME. Units such as units:second or units:minute may be used."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.6.1, printed pages 144-145, lines 4001-4031; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:FibrePreparationProcess a owl:Class ;
    rdfs:label "Fibre preparation process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
