txtprc:usesChemicalUseCategory a owl:ObjectProperty ;
    rdfs:label "uses chemical use category"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile process type or execution to the use category of a chemical used in that process, such as process chemical or performance chemical."@en ;
    rdfs:domain _:nae11d99541a9436d875e2bc4600d58dcb13 ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtam:TextileChemicalUseCategoryConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtprc:usesInput a owl:ObjectProperty ;
    rdfs:label "uses input"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile process type or execution to a textile product, including a product serving an intermediate or component role, or to a material of composition, chemical substance, non-textile component or packaging material used as an input."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( txtprc:TextileProcess txtprc:TextileProcessExecution ) ] ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range [ a owl:Class ;
