    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:HumidityControl a owl:Class ;
    rdfs:label "Humidity control"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process parameter describing control of humidity during textile manufacturing, processing or care."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessParameter ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Proper humidity control can prevent static electricity, material processing issues, equipment damage and fabric shrinkage."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:YarnStrength,
        txtstr:YarnUniformity .

txtprc:IncinerationProcess a owl:Class ;
    rdfs:label "Incineration process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "End-of-life process involving combustion of textile products or textile waste."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:EndOfLifeProcess ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:InputYarnCountSpecification a owl:Class ;
    rdfs:label "Input yarn count specification"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A process target or input specification stating the yarn count or yarn linear-density class selected for fabric manufacturing."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FabricConstructionParameter ;
    txtcon:modellingNote "The JRC identifies yarn count as one of the weaving parameters affecting fabric characteristics. The exact target characteristic depends on fabric construction, yarn type and end use; therefore only weak influence annotations are used."@en,
        "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en,
        "Yarn count is identified by the JRC as a fabric manufacturing parameter affecting fabric characteristics. A broad weak influence target is used here because the specific effect depends on yarn type, fabric construction and end use."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:FabricCharacteristic .

