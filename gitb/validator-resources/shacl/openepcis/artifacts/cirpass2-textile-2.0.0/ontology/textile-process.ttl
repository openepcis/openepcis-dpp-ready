    rdfs:range txtam:TextileChemicalFunctionConcept ;
    txtcon:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtprc:usesChemicalSubstance a owl:ObjectProperty ;
    rdfs:label "uses chemical substance"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile process type or execution to a specific textile chemical substance used in the process. This does not imply that the substance remains in the final product or is a substance of concern."@en ;
    rdfs:domain _:nae11d99541a9436d875e2bc4600d58dcb13 ;
