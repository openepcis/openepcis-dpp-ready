txtprc:TargetFabricDensity a owl:Class ;
    rdfs:label "Target fabric density"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A process target specification stating the intended thread or loop density of the resulting fabric."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FabricConstructionParameter ;
    txtcon:modellingNote "Fabric density is related to thread count or loop density. Its effects on breathability, handle and appearance are mediated by fabric type and construction."@en,
        "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en,
        "This class is not declared equivalent to txtstr:ThreadCount. FabricDensity is process-side and may cover thread density, loop density or related construction-density settings; ThreadCount is the structure-side fabric characteristic currently represented in TEXTILE_STRUCTURE."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:FabricAppearance,
        txtstr:FabricBreathability,
        txtstr:FabricHandle .

txtprc:TargetFabricMassPerUnitArea a owl:Class ;
    rdfs:label "Target fabric mass per unit area"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A process target specification stating the intended mass of fabric per unit surface area."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FabricConstructionParameter ;
    txtcon:modellingNote "Expected SI quantity kind: quantities:SUDE (surface density)."@en,
        "Fabric weight is represented here as a process-side target or parameter. The influence annotations point to structure-side fabric characteristics rather than merging both concepts."@en,
        "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en,
        "This class is not declared equivalent to txtstr:FabricMassPerUnitArea, because this module represents the process-side parameter or target setting, whereas TEXTILE_STRUCTURE represents the resulting fabric characteristic."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:FabricBreathability,
        txtstr:FabricDrape,
        txtstr:FabricInsulation .

txtprc:TemperatureControl a owl:Class ;
    rdfs:label "Temperature control"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Process parameter describing control of temperature during textile manufacturing, processing or care."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:ProcessParameter ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius."@en,
        "Temperature control is modelled as a process parameter influencing yarn processing quality and mechanical-related characteristics."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:YarnStrength,
        txtstr:YarnUniformity .

txtprc:ThermoMechanicalRecyclingProcess a owl:Class ;
    rdfs:label "Thermo-mechanical recycling process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Recycling process in which thermoplastic textile polymers are remelted or otherwise thermally and mechanically reprocessed into granulate or fibre material."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:RecyclingProcess ;
    txtcon:sourceLocator "JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:TwistLevel a owl:Class ;
    rdfs:label "Twist level"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Spinning parameter describing the degree or level of twist inserted into a yarn."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:SpinningParameter ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Twist level may enhance yarn tenacity and pilling resistance, diminish yarn softness and elasticity, and increase spirality. Yarn strength increases with twist to a peak and may then decrease."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtdur:PillingResistance,
        txtstr:YarnElasticity,
        txtstr:YarnSoftness,
        txtstr:YarnStrength .

txtprc:TwistNumber a owl:Class ;
    rdfs:label "Twist number"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Spinning parameter describing the number of twists inserted into a yarn."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:SpinningParameter ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "The number of twists is treated as a process parameter closely related to twist level. Its effects are context-dependent and mediated by fibre characteristics."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:YarnSoftness,
        txtstr:YarnStrength .

txtprc:UseWearProcess a owl:Class ;
    rdfs:label "Use or wear process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Use-phase process corresponding to wearing, using or exposing a textile product during its intended use."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:UseAndCareProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence,
        txtcon:reconstructedEvidence ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:WashingProcess a owl:Class ;
    rdfs:label "Washing process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Care process involving laundering or washing of a textile product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:UseAndCareProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Washing conditions may influence colour fastness and dimensional stability during use and care."@en ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtdur:ColourFastness,
        txtdur:DimensionalStability .

txtprc:WashingTemperature a owl:Class ;
    rdfs:label "Washing temperature"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Care parameter describing the temperature used in a washing process."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:CareParameter ;
    txtcon:modellingNote "Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtprc:WeavePatternSpecification a owl:Class ;
    rdfs:label "Weave pattern specification"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "A process target specification stating the weave pattern to be produced."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FabricConstructionParameter ;
    txtcon:modellingNote "The JRC identifies weave pattern as one of the weaving parameters affecting fabric characteristics. The relation is represented as weak influence annotations rather than as deterministic OWL axioms."@en,
        "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en,
        "Weave pattern is a fabric construction parameter that may affect visual appearance, permeability, drape and handle. The relation is represented as weak influence because the direction depends on the specific weave and yarns."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:FabricAppearance,
        txtstr:FabricBreathability,
        txtstr:FabricDrape,
        txtstr:FabricHandle .

txtprc:WeavingProcess a owl:Class ;
    rdfs:label "Weaving process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Fabric manufacturing process in which two sets of yarns are interlaced at right angles on a loom."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:FabricManufacturingProcess ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Weaving is generally used for relatively more rigid and stronger fabrics, depending on yarns, weave pattern and product application."@en ;
    txtcon:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtdur:FabricStrength,
        txtstr:FabricRigidity .

txtprc:YarnConditioning a owl:Class ;
    rdfs:label "Yarn conditioning"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Spinning or post-spinning parameter corresponding to yarn conditioning, such as steaming, that may enhance flexibility, strength or evenness."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:subClassOf txtprc:SpinningParameter ;
    skos:altLabel "Conditioning"@en,
        "Steaming"@en ;
    txtcon:evidenceStatus txtcon:explicitEvidence ;
    txtcon:modellingNote "Proper yarn conditioning can enhance flexibility, strength and evenness."@en ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
    txtcon:sourceType txtcon:adaptedDefinition ;
    txtcon:typicalInfluenceOn txtstr:YarnElasticity,
        txtstr:YarnStrength,
        txtstr:YarnUniformity .

txtprc:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile process type or concrete process execution to a textile product to which it applies, including a product used as a component of another product."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( txtprc:TextileProcess txtprc:TextileProcessExecution ) ] ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txt:TextileProduct ;
    txtcon:sourceLocator "Textile Process participation pattern; domain motivation from JRC Section 3.3.1, Table 8"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:concernsProduct a owl:ObjectProperty ;
    rdfs:label "concerns product"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a concrete textile process execution to the textile product that it concerns, including a product used as a component of another product."@en ;
    rdfs:domain txtprc:TextileProcessExecution ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txt:TextileProduct ;
    owl:inverseOf txtprc:hasProcessExecution ;
    txtcon:sourceLocator "clearer replacement for the ambiguous local name concerns."@en ;
    txtcon:sourceType txtcon:projectDecision .

txtprc:executesProcessType a owl:ObjectProperty ;
    rdfs:label "executes process type"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a concrete textile process execution to the textile process type that it instantiates."@en ;
    rdfs:domain txtprc:TextileProcessExecution ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:TextileProcess ;
    txtcon:sourceLocator "docs/decisions/TXT-DEC-007.md"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:hasCareInstruction a owl:ObjectProperty ;
    rdfs:label "has care instruction"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
    rdfs:comment "Relates a textile product to product-specific care instructions."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:TextileCareInstruction ;
    rdfs:subPropertyOf dpp:hasProperty ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 6.3.2, printed page 85, lines 2144-2173; JRC Preparatory Study, Section 13.7.2.8, printed page 404, lines 10440-10458."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtprc:hasCategoricalValue a owl:ObjectProperty ;
    rdfs:label "has categorical value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a process parameter setting to a controlled SKOS concept used as its categorical value."@en ;
    rdfs:domain txtprc:ProcessParameterSetting ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range skos:Concept ;
    txtcon:sourceLocator "Textile Process value pattern: controlled categorical values are represented as SKOS concepts rather than free text"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:hasEndOfLifeInstruction a owl:ObjectProperty ;
    rdfs:label "has end-of-life instruction"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ;
    rdfs:comment "Relates a textile product to product-specific instructions for its end-of-life handling."@en ;
    rdfs:domain txt:TextileProduct ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:TextileEndOfLifeInstruction ;
    rdfs:subPropertyOf dpp:hasProperty ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.3.8, printed page 359, lines 9662-9688; JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2183-2192; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546; JRC DPP Study, Section 7.3, printed page 49, end-of-life treatment information data point."@en ;
    txtcon:sourceType txtcon:adaptedRelation .

txtprc:hasFabricManufacturingMethod a owl:ObjectProperty ;
    rdfs:label "has fabric manufacturing method"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a fabric manufacturing process type or concrete execution to a controlled fabric-manufacturing-method concept."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( txtprc:FabricManufacturingProcess txtprc:TextileProcessExecution ) ] ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:FabricManufacturingMethodConcept ;
    rdfs:subPropertyOf txtprc:hasProcessMethod ;
    txtcon:sourceLocator "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:hasProcessParameterSetting a owl:ObjectProperty ;
    rdfs:label "has process parameter setting"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a concrete process execution to a concrete parameter setting used in that execution."@en ;
    rdfs:domain txtprc:TextileProcessExecution ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtprc:ProcessParameterSetting ;
    txtcon:sourceLocator "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtprc:hasQuantitativeValue a owl:ObjectProperty ;
    rdfs:label "has quantitative value"@en ;
    dcterms:source <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a concrete process parameter setting to a quantitative value containing a number, a measurement unit and, when useful, a quantity kind."@en ;
    rdfs:domain txtprc:ProcessParameterSetting ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
    rdfs:range txtcon:QuantitativeValue ;
