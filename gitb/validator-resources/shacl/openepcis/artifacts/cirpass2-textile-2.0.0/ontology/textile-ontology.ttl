@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/eudpp/textile-ontology> a owl:Ontology ;
    rdfs:label "CIRPASS Textile Ontology"@en ;
    dcterms:creator "BOUGACHA Racem"@en,
        "Elio Hbeich"@en,
        "Ivo Ladenius"@en,
        "Andreas Schneider"@en,
        "Jan Merckx"@en,
        "Piero de Sabbata"@en ;
    dcterms:description "Modular ontology network for textile product information in Digital Product Passports, covering product structure, processes, durability, assessment, indicators, context, repairability, recyclability, associated materials and substances of concern."@en ;
    dcterms:issued "2026-07-16"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-27"^^xsd:date ;
    dcterms:title "CIRPASS Textile Ontology"@en ;
    owl:imports <https://w3id.org/eudpp/textile-assessment>,
        <https://w3id.org/eudpp/textile-associated-materials>,
        <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-context>,
        <https://w3id.org/eudpp/textile-core>,
        <https://w3id.org/eudpp/textile-durability>,
        <https://w3id.org/eudpp/textile-indicator>,
        <https://w3id.org/eudpp/textile-process>,
        <https://w3id.org/eudpp/textile-recyclability>,
        <https://w3id.org/eudpp/textile-repairability>,
        <https://w3id.org/eudpp/textile-soc>,
        <https://w3id.org/eudpp/textile-structure> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-ontology/2.0.0> ;
    owl:versionInfo "Version 2.0.0 candidate" .
