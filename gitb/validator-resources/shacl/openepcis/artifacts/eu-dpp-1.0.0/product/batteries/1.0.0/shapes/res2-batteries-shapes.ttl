@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dpp-vocabs: <https://repository.product-passport.ec.europa.eu/core/vocabs/core-vocabulary#> .
@prefix bat-vocabs: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#> .
@prefix core-shapes: <https://repository.product-passport.ec.europa.eu/core/shapes/> .
@prefix bat-shapes: <https://repository.product-passport.ec.europa.eu/product/batteries/shapes/> .

bat-shapes:battery-restricted2-shape
    a sh:NodeShape ;
    sh:targetClass dpp-vocabs:DigitalProductPassport ;

    sh:property [
        sh:path dpp-vocabs:contentSpecificationIds ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:qualifiedValueShape [
            sh:datatype xsd:string ;
            sh:pattern "^https://repository\\.product-passport\\.ec\\.europa\\.eu/product/batteries/\\d+\\.\\d+\\.\\d+$"
        ] ;
        sh:message "SEM-MSG-009"
    ] ;

    sh:property [
        sh:path bat-vocabs:complianceTestReportResults ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node core-shapes:resource-shapes ;
        sh:message "SEM-BAT-MSG-063"
    ] .