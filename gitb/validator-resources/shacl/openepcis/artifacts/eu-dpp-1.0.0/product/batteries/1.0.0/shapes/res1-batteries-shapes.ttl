@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dpp: <https://repository.product-passport.ec.europa.eu/core/vocabs/core-vocabulary#> .
@prefix bat: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#> .
@prefix dpp-shapes: <https://repository.product-passport.ec.europa.eu/core/shapes/> .
@prefix bat-shapes: <https://repository.product-passport.ec.europa.eu/product/batteries/shapes/> .

bat-shapes:battery-restricted1-shape
    a sh:NodeShape ;
    sh:targetClass dpp:DigitalProductPassport ;

    sh:property [
        sh:path dpp:contentSpecificationIds ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:qualifiedValueShape [
            sh:datatype xsd:string ;
            sh:pattern "^https://repository\\.product-passport\\.ec\\.europa\\.eu/product/batteries/\\d+\\.\\d+\\.\\d+$"
        ] ;
        sh:message "SEM-MSG-009"
    ] ;

    sh:property [
        sh:path bat:detailedComposition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString;
        sh:message "SEM-BAT-MSG-059"
    ] ;

    sh:property [
        sh:path bat:sparePartReplacementDetails ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node dpp-shapes:resource-shapes ;
        sh:message "SEM-BAT-MSG-060"
    ] ;

    sh:property [
        sh:path bat:dismantlingInformation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node dpp-shapes:resource-shapes ;
        sh:message "SEM-BAT-MSG-061"
    ] ;

    sh:property [
        sh:path bat:safetyMeasures ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node dpp-shapes:resource-shapes ;
        sh:message "SEM-BAT-MSG-062"
    ] ;

   sh:property [
           sh:path bat:detailedComposition ;
           sh:message "SEM-COM-MSG-012";

           sh:sparql [
               a sh:SPARQLConstraint ;
               sh:select """
                   PREFIX bat: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#>
                   PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

                   SELECT $this (?value AS ?path)
                   WHERE {
                       $this bat:detailedComposition ?value .
                       BIND(lang(?value) AS ?langTag)
                       FILTER(!regex(?langTag, "^[A-Za-z]{2}-[A-Za-z]{2}$"))
                   }
               """ ;
           ] ;
   ] .