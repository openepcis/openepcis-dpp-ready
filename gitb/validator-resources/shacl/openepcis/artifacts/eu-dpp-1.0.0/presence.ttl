@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Added by OpenEPCIS DPP-Ready, not part of the EU DPP Registry semantic data artifacts 1.0.0 release.
<https://ref.openepcis.org/extensions/common/interop/targets/eu-dpp/1.0.0/shapes#Presence>
  a sh:NodeShape ;
  sh:targetNode <https://repository.product-passport.ec.europa.eu/core/vocabs/core-vocabulary#DigitalProductPassport> ;
  sh:property [
    sh:path [ sh:inversePath rdf:type ] ;
    sh:minCount 1 ;
    sh:message "The document contains no DigitalProductPassport: it is not a EU DPP Registry semantic data artifacts 1.0.0 document." ;
  ] .
