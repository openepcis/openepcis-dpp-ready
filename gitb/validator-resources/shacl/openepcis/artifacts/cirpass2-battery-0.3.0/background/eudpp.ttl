eudpp:CriterionA a owl:NamedIndividual, skos:Concept;
    rdfs:comment "The substance meets the relevant REACH Article 57 criteria and has been identified under Article 59(1)."@en;
    dcterms:references "ESPR Article 2(27)(a); REACH Articles 57 and 59(1)."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>, <http://data.europa.eu/eli/reg/2006/1907/oj>;
    skos:definition "The substance meets the relevant REACH Article 57 criteria and has been identified under Article 59(1)."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    skos:inScheme eudpp:SoCCriterionScheme;
    skos:notation "a";
    skos:prefLabel "Criterion (a)"@en;
    skos:topConceptOf eudpp:SoCCriterionScheme;
    eudpp:sourceStatus "Legal qualification criterion represented as a SKOS concept corresponding to ESPR Article 2(27)(a)."@en.
eudpp:SoCCriterionScheme a owl:NamedIndividual, skos:ConceptScheme;
    rdfs:comment "Legal qualification criteria corresponding to points (a)-(d) of ESPR Article 2(27). A substance may satisfy more than one criterion."@en;
    rdfs:label "SoC criterion scheme"@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    eudpp:sourceStatus "Controlled vocabulary representing the four legal qualification branches of ESPR Article 2(27)."@en.
eudpp:CriterionB a owl:NamedIndividual, skos:Concept;
    rdfs:comment "The substance has a harmonised CLP Annex VI Part 3 classification in one of the hazard classes or categories listed by ESPR Article 2(27)(b)."@en;
    dcterms:references "ESPR Article 2(27)(b); CLP Annex VI Part 3."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>, <http://data.europa.eu/eli/reg/2008/1272/oj>;
    skos:definition "The substance has a harmonised CLP Annex VI Part 3 classification in one of the hazard classes or categories listed by ESPR Article 2(27)(b)."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    skos:inScheme eudpp:SoCCriterionScheme;
    skos:notation "b";
    skos:prefLabel "Criterion (b)"@en;
    skos:topConceptOf eudpp:SoCCriterionScheme;
    eudpp:sourceStatus "Legal qualification criterion represented as a SKOS concept corresponding to ESPR Article 2(27)(b)."@en.
eudpp:CriterionC a owl:NamedIndividual, skos:Concept;
    rdfs:comment "The substance is regulated under Regulation (EU) 2019/1021 on persistent organic pollutants."@en;
    dcterms:references "ESPR Article 2(27)(c); Regulation (EU) 2019/1021."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>, <http://data.europa.eu/eli/reg/2019/1021/oj>;
    skos:definition "The substance is regulated under Regulation (EU) 2019/1021 on persistent organic pollutants."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    skos:inScheme eudpp:SoCCriterionScheme;
    skos:notation "c";
    skos:prefLabel "Criterion (c)"@en;
    skos:topConceptOf eudpp:SoCCriterionScheme;
    eudpp:sourceStatus "Legal qualification criterion represented as a SKOS concept corresponding to ESPR Article 2(27)(c)."@en.
eudpp:CriterionD a owl:NamedIndividual, skos:Concept;
    rdfs:comment "The substance negatively affects reuse and recycling of materials in the product in which it is present."@en;
    dcterms:references "ESPR Article 2(27)(d)."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    skos:definition "The substance negatively affects reuse and recycling of materials in the product in which it is present."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    skos:inScheme eudpp:SoCCriterionScheme;
    skos:notation "d";
    skos:prefLabel "Criterion (d)"@en;
    skos:scopeNote "Criterion (d) is product-context dependent. The context is represented by linking the relevant dpp:SubstancePresence to the qualification assertion through dpp:hasApplicableQualification."@en;
    skos:topConceptOf eudpp:SoCCriterionScheme;
    eudpp:sourceStatus "Legal qualification criterion represented as a SKOS concept corresponding to ESPR Article 2(27)(d); product context is represented through SubstancePresence."@en.
eudpp:massFractionUnit a owl:NamedIndividual, <https://si-digital-framework.org/SI#MeasurementUnit>;
    rdfs:comment "Project-managed measurement-unit convention for dimensionless mass fraction expressed as a decimal ratio of masses. Use dpp:numericalValue \"0.001\"^^xsd:decimal for 0.1 % by mass. This avoids encoding \"w/w\" in the unit symbol and may be replaced by an official SI Digital Framework PID if one becomes available."@en;
    rdfs:label "mass fraction unit"@en;
    dcterms:references "SI style convention: percent denotes the number 0.01; mass fraction values should be represented as decimal ratios in data."@en;
    dcterms:source <https://physics.nist.gov/cuu/Units/checklist.html>, <https://si-digital-framework.org/>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    eudpp:sourceStatus "Implementation measurement-unit convention; not a named SI Digital Framework unit PID."@en.
eudpp:accordingTo a owl:ObjectProperty;
    rdfs:comment "Property defining specifies conformity assess procedure/cerfication scheme underlying the cerfificate."@en;
    rdfs:label "according to"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4\nDecision No 768/2008/EC Art 4"@en, "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43\t\nESPR Art 43"@en;
    rdfs:domain eudpp:ConformityCertificate;
    rdfs:range eudpp:ConformityAssessmentModule.
eudpp:allowsConformityAssessmentModule a owl:ObjectProperty;
    rdfs:comment "A property that specifies the conformity assment procedure applicable to the type of product"@en;
    rdfs:label "allows Conformity Assessment Module"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4\nDecision No 768/2008/EC Art 4"@en, "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43\nESPR Art 43"@en;
    rdfs:domain eudpp:UnionHarmonisationLegislation;
    rdfs:range eudpp:ConformityAssessmentModule.
eudpp:conformityDeclaredTo a owl:ObjectProperty;
    rdfs:comment "A property which specifies which Union Harmonisation Legislation conformity is declared to."@en;
    rdfs:label "conformity declared to"@en;
    dcterms:source "ESPR Annex V"@en;
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:UnionHarmonisationLegislation.
eudpp:hasUnionHarmonisationLegislation a owl:ObjectProperty;
    rdfs:comment "A property providing the Union Harmonisation Legislation refered to in the EU Declaration of Conformity."@en;
    rdfs:label "has Union Harmonisation Legislation"@en;
    dcterms:source "ESPR Annex V, (5)"@en;
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:UnionHarmonisationLegislation.
eudpp:usedForPresumptionOfConformity a owl:ObjectProperty;
    rdfs:comment "This property specifies which harmonised standards (or parts thereof) was used to assess conformity with the Union harmonistation legislation."@en;
    rdfs:label "used for presumtion of conformity"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I\t\nDecision No 768/2008/EC Annex I Art R8"@en, "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_41\nESPR Art 41"@en;
    rdfs:domain eudpp:ProductRequirement;
    rdfs:range eudpp:UnionHarmonisationLegislation.
eudpp:ProductRequirement a owl:Class;
    rdfs:comment "Product requirements means a requirement to be fullfilled by a product when placed on the market."@en;
    rdfs:label "Product Requirement"@en.
eudpp:assignedELI a owl:DatatypeProperty;
    rdfs:comment "Standardised identification that makes it easier to identify and describe legislation across Europe."@en;
    rdfs:label "assigned ELI"@en;
    dcterms:source "https://eur-lex.europa.eu/eli-register/what_is_eli.html"@en;
    rdfs:domain eudpp:UnionHarmonisationLegislation;
    rdfs:range xsd:anyURI.
eudpp:certificateNumber a owl:DatatypeProperty;
    rdfs:comment "Number of the certificate";
    rdfs:label "certificate number";
    dcterms:source "certificate number"@en;
    rdfs:domain eudpp:ConformityCertificate;
    rdfs:range xsd:string.
eudpp:certificateRevisionNumber a owl:DatatypeProperty;
    rdfs:comment "Number of the revision of a certificate";
    rdfs:label "certificate revision number"@en;
    rdfs:domain eudpp:ConformityCertificate;
    rdfs:range xsd:string.
eudpp:CommonSpecification a owl:Class;
    rdfs:comment "Common specification means ecodesign requirements, essential requirements for digital product passports or test, measurement or calculation methods established by implementing acts adopted by the Commission for products covered by delegated acts pursuant to ESPR Article 4."@en;
    rdfs:label "Common Specification"@en;
    dcterms:source "ESPR Art 42, https://eur-lex.europa.eu/eli/reg/2024/1781/oj#art_42"@en;
    rdfs:subClassOf eudpp:TechnicalSpecification.
eudpp:TechnicalSpecification a owl:Class;
    rdfs:comment "Technical specification means a document that prescribes technical requirements to be fulfilled by a product, process, service or system and which lays down one or more of the following: Common Specification or Other Technical Specification."@en;
    rdfs:label "Technical Specification"@en;
    dcterms:source "Regulation (EU) No 1025/2012 Art 2 (4)\nhttps://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2"@en;
    rdfs:subClassOf eudpp:ProductRequirement.
eudpp:HarmonisedStandard a owl:Class;
    rdfs:comment "Harmonised Standard means a European standard adopted on the basis of a request made by the Commission for the application of Union harmonisation legislation."@en;
    rdfs:label "Harmonised Standard"@en;
    dcterms:source "Regulation (EU) No 1025/2012 Art 2 (1c), https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2"@en;
    rdfs:subClassOf eudpp:ProductRequirement.
eudpp:OtherTechnicalSpecification a owl:Class;
    rdfs:comment "Other technical specifications in relation to which conformity is declared."@en;
    rdfs:label "Other Technical Specification"@en;
    dcterms:source "ESPR Annex V, (6)"@en;
    rdfs:subClassOf eudpp:TechnicalSpecification.
eudpp:moduleA a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module A\n\nInternal production control"@en;
    rdfs:label "module A"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleA1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module A1.\n\nInternal production control plus supervised product testing"@en;
    rdfs:label "module A1"@en;
    dcterms:source "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en, "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\t\nDecision No 768/2008/EC Annex II"@en.
eudpp:moduleA2 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module A2\n\nInternal production control plus supervised product checks at random intervals"@en;
    rdfs:label "module A2"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleB a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
