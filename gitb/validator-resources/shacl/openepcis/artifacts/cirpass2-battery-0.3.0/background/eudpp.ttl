eudpp:hasSoCCriterion a owl:ObjectProperty;
    rdfs:comment "Links a qualification assertion to one or more non-exclusive criteria (a)-(d)."@en;
    rdfs:label "has SoC criterion"@en;
    dcterms:references "ESPR Article 2(27)."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
