_:n3-116 rdf:first eudpp:group_withCaveats;
    rdf:rest rdf:nil.
eudpp:group_withCaveats a owl:NamedIndividual, eudpp:EN15804IndicatorGroup;
    rdfs:comment "Additional 6 characterised impact indicators of EN 15804+A2 that must be reported with the standard caveat statement (Table 4)."@en;
    rdfs:label "impact with caveats"@en;
    eudpp:sourceVocabulary "LCA ontology extension".
eudpp:EN15804InventoryIndicator a owl:Class;
    rdfs:comment "An EN 15804+A2 inventory-level indicator (resource use, waste disposed, or output flow for valorisation / exported energy). Not characterised; value is an aggregated inventory quantity. Results computed for this indicator are eudpp:InventoryIndicatorResult instances."@en;
    rdfs:label "EN 15804 Inventory Indicator"@en;
    rdfs:subClassOf eudpp:EN15804Indicator;
    eudpp:sourceVocabulary "ILCD+EPD extension"@en.
eudpp:EnergyConsumptionResult a owl:Class;
    rdfs:comment "An LCA inventory indicator result quantifying the consumption of primary energy resources — renewable and non-renewable — in a product system. \nCommonly associated with the EN 15804+A2 primary energy indicators (e.g. PERE, PERM, PERT, PENRE, PENRM, PENRT), though no formal quantifiesIndicator restriction is imposed, as energy consumption may span multiple indicators depending on the study scope."@en;
    rdfs:label "Energy Consumption Result"@en;
    rdfs:subClassOf eudpp:InventoryIndicatorResult;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:EnvironmentalFootprintScore a owl:Class;
    rdfs:comment "An aggregated single-score indicator computed as the normalised and weighted sum of a set of impact-category results. \nHolds one named individual eudpp:ind_EF_singleScore representing the EU Environmental Footprint single score (PEF score). The applied normalisation factors and weighting set are not modelled here as properties; they are determined by the active EF / PEF methodology version, which is resolvable via the study's eudpp:hasComplianceDeclaration link to a eudpp:ComplianceSystem source. \nResults computed for an EnvironmentalFootprintScore individual are eudpp:LCIAResult instances."@en;
    rdfs:label "Environmental Footprint Score"@en;
    rdfs:subClassOf eudpp:LCAIndicator;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:EnvironmentalFootprintScoreResult a owl:Class;
    rdfs:comment "A normalized and weighted aggregate LCA result expressing the overall environmental performance of a product system as a single dimensionless score, computed by applying the Product Environmental Footprint (PEF) method (Recommendation (EU) 2021/2279). \nAggregates the characterised results of all 16 EF 3.1 impact categories through normalization and weighting factors.\nInstances of this class quantify the EF single score indicator (ind_EF_singleScore, an EnvironmentalFootprintScore individual) via quantifiesIndicator."@en;
    rdfs:label "Environmental Footprint Score Result"@en;
    rdfs:subClassOf eudpp:LCAResult, _:n3-117;
    eudpp:sourceVocabulary "LCA ontology: third sibling subclass of eudpp:LCAResult alongside eudpp:LCIAResult and eudpp:InventoryIndicatorResult, introduced to represent the aggregated EF single score result."@en.
_:n3-117 a owl:Restriction;
    owl:onProperty eudpp:quantifiesIndicator;
    owl:onClass eudpp:EnvironmentalFootprintScore;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger.
