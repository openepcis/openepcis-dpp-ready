eudpp:SoCIdentifier a owl:Class;
    rdfs:comment "A type of identifier to identify substances of concern."@en;
    rdfs:label "Substance of concern identifier"@en;
    rdfs:subClassOf eudpp:SubstanceIdentifier, eudpp:Identifier, _:n3-68.
eudpp:FacilityIdentifierScheme a owl:Class;
    rdfs:comment "A kind of identifier scheme. The scheme or standard used to identify Facilities."@en;
