    rdfs:comment "Maximum length of the identifier"@en;
    rdfs:label "identifier maximum length"@en;
    rdfs:domain eudpp:IdentifierScheme;
    rdfs:range xsd:integer.
eudpp:identifierMinLength a owl:DatatypeProperty;
    rdfs:comment "Minimum length of the identifier"@en;
    rdfs:label "identifier minimum length"@en;
    rdfs:domain eudpp:IdentifierScheme;
