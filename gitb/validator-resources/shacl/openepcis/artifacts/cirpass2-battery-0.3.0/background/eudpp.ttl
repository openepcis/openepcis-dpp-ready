    eudpp:sourceVocabulary "ILCD base".
eudpp:WaterConsumptionResult a owl:Class;
    rdfs:comment "An LCA inventory indicator result quantifying the net consumption of fresh water resources in a product system. \nThis class is typically associated with the EN 15804+A2 inventory indicator “Use of net fresh water” (FW), though no formal quantifiesIndicator restriction is imposed to allow for future indicator additions or revised indicator frameworks."@en;
    rdfs:label "Water Consumption Result"@en;
    rdfs:subClassOf eudpp:InventoryIndicatorResult;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:ind_ADPE a owl:NamedIndividual, eudpp:EN15804ImpactIndicator;
    rdfs:comment "Abiotic depletion potential for non-fossil resources (minerals and metals), in kg Sb-equivalent. Core EN 15804+A2 impact indicator."@en;
    rdfs:label "ADPE - Abiotic Depletion Potential (elements, minerals and metals)"@en;
    skos:altLabel "ADPE"@en;
    eudpp:sourceVocabulary "ILCD+EPD extension";
    eudpp:unitAsString "kg Sb-eq"@en;
    <https://w3id.org/eudpp/LCA#relatesToLCAIndicator> eudpp:ind_EF_resourceUseMineralsMetals;
