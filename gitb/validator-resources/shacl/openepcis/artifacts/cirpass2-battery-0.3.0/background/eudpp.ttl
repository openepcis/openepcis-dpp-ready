skos:Concept a owl:Class.
eudpp:qualifiesSubstance a owl:ObjectProperty;
    rdfs:comment "Links a qualification assertion to the substance of concern that it positively qualifies."@en;
    rdfs:label "qualifies substance"@en;
    dcterms:references "ESPR Article 2(27)."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    rdfs:domain eudpp:SoCQualificationAssertion;
    rdfs:range eudpp:SubstanceOfConcern;
    owl:inverseOf eudpp:hasQualificationAssertion;
