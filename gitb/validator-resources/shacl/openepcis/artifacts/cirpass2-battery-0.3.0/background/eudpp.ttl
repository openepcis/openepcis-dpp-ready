eudpp:ind_EF_singleScore a owl:NamedIndividual, eudpp:EnvironmentalFootprintScore;
    rdfs:comment "EU Environmental Footprint single score (also referred to as PEF score), computed as a normalised and weighted aggregate of the 16 EF impact-category results. Expressed in dimensionless points (Pt). The applied normalisation factors and weighting set are determined by the methodology version (e.g. EF 3.1 per JRC EUR 31414 EN), which is resolvable from the study via eudpp:hasComplianceDeclaration on its referenced eudpp:ComplianceSystem source."@en;
    rdfs:label "Environmental Footprint single score"@en;
    skos:altLabel "EF single score"@en, "Environmental footprint"@en, "PEF score"@en;
    eudpp:sourceVocabulary "LCA ontology extension";
    eudpp:unitAsString "dimensionless (Pt)"@en.
