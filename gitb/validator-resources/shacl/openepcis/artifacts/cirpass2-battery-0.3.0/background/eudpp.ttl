    eudpp:unitAsString "MJ per energy carrier"@en;
    eudpp:belongsToEn15804Group eudpp:group_exportedEnergy.
eudpp:ind_EF_ecotoxicityFreshwater a owl:NamedIndividual, eudpp:LCIAImpactIndicator;
