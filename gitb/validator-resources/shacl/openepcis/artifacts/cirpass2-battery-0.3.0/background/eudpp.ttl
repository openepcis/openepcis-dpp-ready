eudpp:CarbonFootprint a owl:Class;
    rdfs:comment "An LCIAResult that \"means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category of climate change\". (ESPR Art 2 25))\n \nIt quantifies the global warming potential of a product over a 100-year time horizon.\nInstances of this class quantify either the EN 15804+A2 individual \"GWP-total - Global Warming Potential (total)\" (ind_GWPtotal, an EN15804ImpactIndicator) or the EF 3.1 \"Climate Change EF\" indicator (ind_EF_climateChange, an LCIAImpactIndicator), depending on the reporting framework of the EPD or LCA study."@en;
    rdfs:label "Carbon Footprint"@en;
    rdfs:subClassOf eudpp:LCIAResult, _:n3-101;
    eudpp:sourceVocabulary "ESPR Art 2 (25) https://eur-lex.europa.eu/eli/reg/2024/1781/oj"@en, "LCAnet: relates to the element CarbonFootprint (https://w3id.org/lcanet/ia#CarbonFootprint) of the IA module."@en.
_:n3-101 a owl:Class;
    owl:unionOf _:n3-102.
_:n3-102 rdf:first _:n3-103;
    rdf:rest _:n3-104.
_:n3-103 a owl:Restriction;
    owl:onProperty eudpp:quantifiesIndicator;
    owl:hasValue eudpp:ind_EF_climateChange.
eudpp:ind_EF_climateChange a owl:NamedIndividual, eudpp:LCIAImpactIndicator;
    rdfs:comment "Radiative forcing as global warming potential, GWP100, expressed in kg CO2-equivalent. Aggregate of climate-change effects from fossil, biogenic and land-use-and-land-use-change sources. EF 3.1 / PEF impact category. Colloquially known as the carbon footprint of the product. JRC characterisation factors per EUR 31414 EN (2023)."@en;
    rdfs:label "Climate change EF"@en;
    skos:altLabel "Climate change"@en, "Carbon footprint"@en;
    eudpp:sourceVocabulary "LCA ontology extension";
    eudpp:unitAsString "kg CO2-eq"@en;
    <https://w3id.org/eudpp/LCA#assessesImpactCategory> eudpp:climateChange.
_:n3-104 rdf:first _:n3-105;
    rdf:rest rdf:nil.
_:n3-105 a owl:Restriction;
    owl:onProperty eudpp:quantifiesIndicator;
    owl:hasValue eudpp:ind_GWPtotal.
eudpp:ind_GWPtotal a owl:NamedIndividual, eudpp:EN15804ImpactIndicator;
    rdfs:comment "Global Warming Potential including all GHG emissions and removals, expressed in kg CO2-equivalent. Core EN 15804+A2 impact indicator. Colloquially known as the carbon footprint of the product."@en;
    rdfs:label "GWP-total - Global Warming Potential (total)"@en;
    skos:altLabel "Carbon footprint"@en, "GWP-total"@en;
    eudpp:sourceVocabulary "ILCD+EPD extension";
    eudpp:unitAsString "kg CO2-eq"@en;
    <https://w3id.org/eudpp/LCA#relatesToLCAIndicator> eudpp:ind_EF_climateChange;
    eudpp:belongsToEn15804Group eudpp:group_coreImpact.
