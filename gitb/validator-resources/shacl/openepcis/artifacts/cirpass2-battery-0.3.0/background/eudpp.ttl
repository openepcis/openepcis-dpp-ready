eudpp:MaterialFootprint a owl:Class;
    rdfs:comment "An InventoryIndicatorResult that \"refers to the total amount of raw materials extracted to meet final consumption demands\" (ESPR Art. 2(26)).\n\nModelled as an inventory-level result rather than a characterised LCIA result, as it aggregates raw material extraction flows without applying characterisation factors.\nNo single EN 15804+A2 inventory indicator individual is pinned via quantifiesIndicator; the link is left to individual instances, as material footprint spans multiple EN 15804+A2 resource use inventory indicators (PERE, PENRE, SM, RSF, NRSF, etc.)."@en;
    rdfs:label "Material Footprint"@en;
    rdfs:subClassOf eudpp:InventoryIndicatorResult;
    eudpp:sourceVocabulary "ESPR Art 2 (26) https://eur-lex.europa.eu/eli/reg/2024/1781/oj"@en, "LCAnet: relates to the element MaterialFootprint (https://w3id.org/lcanet/ia#MaterialFootprint) of the IA module."@en.
eudpp:RecycledMaterialsUseResult a owl:Class;
    rdfs:comment "An LCA inventory indicator result quantifying the use of secondary (recycled) material inputs in a product system. \nCommonly associated with the EN 15804+A2 inventory indicator “Use of secondary material” (SM), though no formal quantifiesIndicator restriction is imposed."@en;
    rdfs:label "Recycled Materials Use Result"@en;
    rdfs:subClassOf eudpp:InventoryIndicatorResult;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:SustainableRenewableMaterialsUseResult a owl:Class;
    rdfs:comment "An LCA inventory indicator result quantifying the use of renewable secondary material and fuel inputs in a product system. \nCommonly associated with the EN 15804+A2 inventory indicators “Use of renewable secondary fuels” (RSF) or “Use of non-renewable secondary fuels” (NRSF), though no formal quantifiesIndicator restriction is imposed, as the scope of renewable material inputs may evolve."@en;
    rdfs:label "Sustainable Renewable Materials Use Result"@en;
    rdfs:subClassOf eudpp:InventoryIndicatorResult;
    eudpp:sourceVocabulary "LCA ontology"@en.
_:n3-171 a owl:Class;
    owl:oneOf _:n3-172.
_:n3-172 rdf:first eudpp:accreditedThirdPartyReview;
    rdf:rest _:n3-173.
eudpp:accreditedThirdPartyReview a owl:NamedIndividual, eudpp:TypeOfReview;
    rdfs:comment "Reviewer independent of the organisations involved and accredited by an independent accreditation body. Highest level acceptable for EN 15804+A2 compliance."@en;
    rdfs:label "Accredited third party review"@en;
    eudpp:sourceVocabulary "ILCD base".
_:n3-173 rdf:first eudpp:dependentInternalReview;
    rdf:rest _:n3-174.
eudpp:dependentInternalReview a owl:NamedIndividual, eudpp:TypeOfReview;
    rdfs:comment "Reviewer involved in data collection or modelling, or representing the process/product system. Not acceptable for EN 15804+A2 compliance."@en;
    rdfs:label "Dependent internal review"@en;
    eudpp:sourceVocabulary "ILCD base".
_:n3-174 rdf:first eudpp:independentExternalReview;
    rdf:rest _:n3-175.
eudpp:independentExternalReview a owl:NamedIndividual, eudpp:TypeOfReview;
    rdfs:comment "Reviewer independent of the organisations involved. Acceptable for EN 15804+A2 compliance."@en;
    rdfs:label "Independent external review"@en;
    eudpp:sourceVocabulary "ILCD base".
_:n3-175 rdf:first eudpp:independentInternalReview;
    rdf:rest _:n3-176.
eudpp:independentInternalReview a owl:NamedIndividual, eudpp:TypeOfReview;
    rdfs:comment "Reviewer not involved in the work but belonging to the same organisation or legally linked organisation. Acceptable only for generic data per InData."@en;
    rdfs:label "Independent internal review"@en;
    eudpp:sourceVocabulary "ILCD base".
_:n3-176 rdf:first eudpp:independentReviewPanel;
    rdf:rest _:n3-177.
eudpp:independentReviewPanel a owl:NamedIndividual, eudpp:TypeOfReview;
    rdfs:comment "Panel of at least three independent internal or external reviewers, chaired by an independent external reviewer."@en;
    rdfs:label "Independent review panel"@en;
    eudpp:sourceVocabulary "ILCD base".
