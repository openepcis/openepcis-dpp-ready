eudpp:hasGranularity a owl:ObjectProperty;
    rdfs:comment "Defines the granularity of an identifier, if exists."@en;
    rdfs:label "has granularity"@en;
    rdfs:domain eudpp:Identifier;
    rdfs:range eudpp:IdentifierGranularity.
eudpp:Identifier a owl:Class;
    rdfs:comment "Identifier. A general class to hold different kinds of identifiers described and used for EU DPP CO. Each sub-class of this class describes a different kind of identifier. Intentionally modelled as sub-classes. \nIdentifiers have value, and a scheme/standard they are based on.\n\nCardinatlity restrictions added to each subclass to enforce inheritance of the data propertyy identifierValue."@en;
    rdfs:label "Identifier".
eudpp:IdentifierGranularity a owl:Class;
    rdfs:comment "The granularity of the identifier. For example, for Products this could be model, batch, item."@en;
    rdfs:label "Identifier granularity"@en.
eudpp:hasScheme a owl:ObjectProperty;
    rdfs:comment "The scheme/standard the Identifier follows";
    rdfs:label "has scheme"@en;
    rdfs:domain eudpp:Identifier;
    rdfs:range eudpp:IdentifierScheme.
eudpp:IdentifierScheme a owl:Class;
    rdfs:comment "The scheme or standard used for Identifier."@en;
    rdfs:label "Identifier scheme"@en.
eudpp:identifierExampleValue a owl:DatatypeProperty;
    rdfs:comment "Example value of the identifier"@en;
    rdfs:label "identifier example value"@en;
    rdfs:domain eudpp:IdentifierScheme;
    rdfs:range xsd:string.
eudpp:identifierExpiresOn a owl:DatatypeProperty;
    rdfs:comment "Identifier expiration date"@en;
    rdfs:label "identifier expires on"@en;
    rdfs:domain eudpp:Identifier;
    rdfs:range xsd:date.
eudpp:identifierIssuedOn a owl:DatatypeProperty;
    rdfs:comment "Date of issuing the identifier"@en;
    rdfs:label "identifier issued on"@en;
    rdfs:domain eudpp:Identifier;
    rdfs:range xsd:date.
eudpp:identifierJurisdiction a owl:DatatypeProperty;
    rdfs:comment "An optional property used to qualify the issuing country or territory required to disambiguate national registration numbers. \n\nFormat: ISO 3166-1 alpha-2, i.e., two-letter country code, such as FR for France, DE for Germany, EE for Estonia, etc."@en;
    rdfs:label "identifier juristiction"@en;
    rdfs:domain eudpp:Identifier;
    rdfs:range _:n3-50.
_:n3-50 a rdfs:Datatype;
    owl:onDatatype xsd:string;
