    rdfs:label "Actor identifier scheme"@en;
    rdfs:subClassOf eudpp:IdentifierScheme;
    owl:disjointWith eudpp:FacilityIdentifierScheme, eudpp:MaterialIdentifierScheme, eudpp:ProductIdentifierScheme, eudpp:SubstanceIdentifierScheme.
_:n3-56 a owl:Restriction;
