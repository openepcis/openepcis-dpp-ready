    owl:onDataRange xsd:string.
eudpp:CAS a owl:NamedIndividual, eudpp:MaterialIdentifierScheme;
    rdfs:comment "CAS Number (Chemical Abstracts Service)"@en, "Governance note: CAS is currently a MaterialIdentifierScheme. IDENT/MAT governance must determine whether a substance-identifier use requires reassignment, a shared scheme model, or another compatible pattern."@en;
    rdfs:label "CAS"@en;
    rdfs:seeAlso "https://www.cas.org/support/documentation/chemical-substances/faqs";
    skos:altLabel "Chemical Abstracts Service Registry Number"@en;
    eudpp:identifierExampleValue "7732-18-5";
    eudpp:identifierMaxLength 12;
    eudpp:identifierMinLength 7.
eudpp:EC a owl:NamedIndividual, eudpp:SubstanceIdentifierScheme;
    rdfs:comment "EC number is a unique identification number assigned to a chemical substance in the European Union. It is used to identify substances in regulatory databases, safety data sheets (SDSs), and chemical legislation."@en, "The EC number is a seven-digit identifier typically written in the format XXX-XXX-X and used to identify chemical substances in European regulatory inventories.\n\nExample:\nSubstance: Ethanol\nEC number: 200-578-6"@en;
    rdfs:label "EC"@en;
    eudpp:identifierExampleValue "200-578-6";
    eudpp:identifierMaxLength 9;
    eudpp:identifierPattern "^[2-5]\\d{2}-\\d{3}-\\d$".
eudpp:ECHA a owl:NamedIndividual, eudpp:SubstanceIdentifierScheme;
    rdfs:comment "ECHA substance identification scheme refers to the approach used by the European Chemicals Agency (ECHA) to identify and distinguish chemical substances for regulatory purposes under EU chemicals legislation, particularly REACH."@en;
    rdfs:label "ECHA"@en.
eudpp:EORI a owl:NamedIndividual;
    rdfs:comment "Economic Operators Registration and Identification (EU).\nThis is the EU’s official identifier for companies involved in import/export.\nMandatory for any company trading with the EU.\n\nUsed in customs declarations\nUnique per company\n\nFormat: country code + number (e.g., DE123456789)\n\nThis is the most widely used identifier for economic operators in EU trade."@en;
    rdfs:label "EORI"@en, "https://taxation-customs.ec.europa.eu/customs/customs-procedures-import-and-export/customs-operations/economic-operators-registration-and-identification-number-eori_en";
    skos:altLabel "Economic Operators Registration and Identification (EU"@en;
    eudpp:identifierExampleValue "DE123456789012345";
    eudpp:identifierMaxLength 17;
    eudpp:identifierMinLength 8.
eudpp:GLN a owl:NamedIndividual, eudpp:ActorIdentifierScheme;
    rdfs:comment "A globally unique identifier defined by GS1 used to identify legal entities, functional entities, and physical locations within business and supply chain processes.\n\nTypically identifies: legal entities, functional entities (departments), physical locations (warehouses, sites)."@en;
    rdfs:label "GLN"@en;
    rdfs:seeAlso "https://www.gs1.org/standards/id-keys/gln";
    skos:altLabel "Global Location Number"@en;
    eudpp:identifierExampleValue "9501101530003";
    eudpp:identifierMaxLength 13;
    eudpp:identifierMinLength 13;
    eudpp:identifierSchemeIssuer "GS1".
eudpp:GTIN a owl:NamedIndividual, eudpp:ProductIdentifierScheme;
    rdfs:comment "A globally unique identifier for trade items, defined by GS1, used to identify products at various packaging levels."@en;
    rdfs:label "GTIN"@en;
    skos:definition "A globally unique identifier for trade items, defined by GS1, used to identify products at various packaging levels."@en;
    rdfs:seeAlso "https://www.gs1.org/standards/id-keys/gtin";
    skos:altLabel "Global Trade Item Number"@en;
    eudpp:identifierExampleValue "14006381333938";
    eudpp:identifierMaxLength 14;
    eudpp:identifierMinLength 8;
    eudpp:identifierSchemeIssuer "GS1".
eudpp:LEI a owl:NamedIndividual, eudpp:ActorIdentifierScheme;
    rdfs:comment "A Legal Entity Identifier (LEI) is a globally unique 20-character alphanumeric code that identifies legally distinct entities participating in financial transactions, as defined by ISO 17442.\n\nA 20‑character code used globally for financial and regulatory reporting.\nRequired for companies involved in financial transactions.\nUsed by regulators, banks, customs, and some trade systems."@en;
    rdfs:label "LEI"@en;
    rdfs:seeAlso "https://www.iso.org/standard/78829.html";
    eudpp:identifierExampleValue "529900T8BM49AURSDO55";
    eudpp:identifierMaxLength 20;
    eudpp:identifierMinLength 20;
    eudpp:identifierSchemeIssuer "ISO".
eudpp:SKU a owl:NamedIndividual, eudpp:ProductIdentifierScheme;
    rdfs:comment "A Stock Keeping Unit (SKU) is an internal identifier assigned by an organization to uniquely identify and track a product, item, or variant within its own inventory and management systems."@en;
    rdfs:label "SKU"@en;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Stock_keeping_unit";
    skos:altLabel "Stock Keeping Unit"@en;
    eudpp:identifierExampleValue "ABC-RED-XL";
    eudpp:identifierMaxLength 50;
    eudpp:identifierMinLength 1.
eudpp:hasMaterialOrigin a owl:ObjectProperty;
    rdfs:comment "Assigns material origin to material used for product"@en;
    rdfs:label "has material origin"@en;
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range eudpp:MaterialOrigin.
eudpp:MaterialOrigin a owl:Class;
    rdfs:comment "Origin of the material used in product [ESPR Annex I]"@en;
    rdfs:label "Origin of material"@en;
    dcterms:references "[ESPR Annex I]"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    owl:equivalentClass _:n3-75.
eudpp:hasMaterialType a owl:ObjectProperty;
    rdfs:comment "Links material to its type in some classification system used by the sector."@en;
    rdfs:label "has material type"@en;
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range eudpp:MaterialType.
eudpp:MaterialType a owl:Class;
    rdfs:comment "Placeholder class for material type classification applicable in a sector or mandated by a delegated act (DA).\n\nPotential types could be, on the example of textile sector: cotton, nylon, ..."@en;
    rdfs:label "Material type"@en.
eudpp:isCriticalRawMaterial a owl:DatatypeProperty;
    rdfs:comment "Product parameters: use or content of recycled materials and recovery of materials, including critical raw materials; [ESPR Annex I h)]"@en;
    rdfs:label "critical raw material"@en;
    dcterms:references "[ESPR Annex I h)]"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range xsd:boolean.
eudpp:materialComponent a owl:DatatypeProperty;
    rdfs:comment "The specific part of the Product this material belongs to. Description. \nFor example, in case of a textile product: [Main, Lining, Filling]."@en;
    rdfs:label "part of product material is in"@en;
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range xsd:string.
eudpp:materialComponentLabel a owl:DatatypeProperty;
    rdfs:comment "Optional human-readable label identifying the role or part of the product associated with the material component (e.g. outer layer, lining, filling, casing).\n\nNote: not defined by ESPR, requested by sectors (textile)"@en;
    rdfs:label "material component label"@en;
    rdfs:domain eudpp:MaterialOfComposition.
eudpp:materialIsRecyclable a owl:DatatypeProperty;
    rdfs:comment "Product parameters: design for recycling, ease and quality of recycling as expressed through use of easily recyclable materials [ESPR Art 5 (1n), Annex I d)]"@en;
    rdfs:label "recyclable material"@en;
    dcterms:references "ESPR Art 5 (1n), Annex I d)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range xsd:boolean.
eudpp:materialIsSustainableRenewable a owl:DatatypeProperty;
    rdfs:comment "Product parameters: use or content of sustainable renewable materials; [ESPR Annex I i)]"@en;
    rdfs:label "sustainale or renewable material"@en;
    dcterms:references "ESPR Annex I i)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range xsd:boolean.
eudpp:materialPercentage a owl:DatatypeProperty;
    rdfs:comment "Material percentage in a Product, e.g., mass fraction (percentage by weight)."@en;
    rdfs:label "material percentage"@en;
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range xsd:decimal.
eudpp:materialRecycledContent a owl:DatatypeProperty;
    rdfs:comment "Percentage of recycled content"@en;
    rdfs:label "recycled content amount in material"@en;
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range xsd:decimal.
eudpp:materialRecycledContentType a owl:DatatypeProperty;
    rdfs:comment "Specifies the origin of recycled content: pre-consumer (manufacturing waste) or post-consumer (end-of-life waste), as required by regulatory differentiation."@en;
    rdfs:label "material recycled content type"@en;
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range _:n3-71.
_:n3-71 a rdfs:Datatype;
    owl:oneOf _:n3-72.
_:n3-72 a rdf:List;
    rdf:first "post-consumer";
    rdf:rest _:n3-73.
_:n3-73 a rdf:List;
    rdf:first "pre-consumer";
    rdf:rest _:n3-74.
_:n3-74 a rdf:List;
    rdf:first "unknown";
    rdf:rest rdf:nil.
eudpp:materialTypeScheme a owl:DatatypeProperty;
    rdfs:comment "Reference system (e.g. ISO 11224, EU Textile Regulation 1007/2011 Annex I)"@en;
    rdfs:label "material type scheme"@en;
    rdfs:domain eudpp:MaterialType;
    rdfs:range xsd:anyURI.
eudpp:materialTypeValue a owl:DatatypeProperty;
    rdfs:comment "Code or label in the chosen nomenclature (specified by #materialTypeScheme)."@en;
    rdfs:label "material type value"@en;
    rdfs:domain eudpp:MaterialType;
    rdfs:range xsd:string.
_:n3-75 a owl:Class;
    owl:oneOf _:n3-76.
_:n3-76 rdf:first eudpp:raw;
    rdf:rest _:n3-77.
eudpp:raw a owl:NamedIndividual, eudpp:MaterialOrigin;
