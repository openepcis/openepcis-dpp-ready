eudpp:identifierSchemeIssuer a owl:DatatypeProperty;
    rdfs:comment "Issuer of the identifier scheme"@en;
    rdfs:label "identifier scheme issuer"@en;
    rdfs:domain eudpp:IdentifierScheme;
    rdfs:range xsd:string.
eudpp:identifierSchemeVersion a owl:DatatypeProperty;
    rdfs:comment "Reference standard version the instance schema refers to"@en;
    rdfs:label "identifier scheme version"@en;
    rdfs:domain eudpp:IdentifierScheme;
    rdfs:range xsd:string.
eudpp:identifierValue a owl:DatatypeProperty;
    rdfs:comment "The (unique) value of the identifier."@en;
    rdfs:label "identifier value"@en;
    rdfs:domain eudpp:Identifier;
    rdfs:range xsd:string.
