eudpp:ind_EPfreshwater a owl:NamedIndividual, eudpp:EN15804ImpactIndicator;
    rdfs:comment "Fraction of nutrients reaching freshwater end compartment, in kg P-equivalent. Core EN 15804+A2 impact indicator. ERRATUM: the published text of EN 15804:2012+A2:2019 states the unit as 'kg PO4-eq' for this indicator, but the characterisation factors used by the EF 3.1 implementation operate on phosphorus (P), so the correct unit when reporting results against EF 3.1 characterisation factors is 'kg P-eq'. This ontology adopts the corrected unit. See JRC / EPD programme clarifications for details."@en;
    rdfs:label "EP-freshwater - Eutrophication (freshwater)"@en;
    skos:altLabel "EP-freshwater"@en;
    eudpp:sourceVocabulary "ILCD+EPD extension";
    eudpp:unitAsString "kg P-eq"@en;
    <https://w3id.org/eudpp/LCA#relatesToLCAIndicator> eudpp:ind_EF_eutrophicationFreshwater;
    eudpp:belongsToEn15804Group eudpp:group_coreImpact.
