skos:closeMatch a owl:AnnotationProperty.
skos:exactMatch a owl:AnnotationProperty.
eudpp:appliesToProduct a owl:ObjectProperty;
    rdfs:comment "The property links DPP and the Product."@en;
    rdfs:label "applies to product"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range eudpp:Product;
    owl:inverseOf eudpp:hasDPP.
eudpp:hasDPP a owl:ObjectProperty;
    rdfs:comment "A Product has a DPP. The property links a Product with a DPP."@en;
    rdfs:label "has DPP"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:DPP.
eudpp:hasMeasurementUnit a owl:ObjectProperty;
    rdfs:comment "Linking quantitative property to the unit of measurement."@en;
    rdfs:label "has measurement unit"@en;
    rdfs:domain eudpp:QuantitativeProperty;
    rdfs:range <https://si-digital-framework.org/SI#MeasurementUnit>.
<https://si-digital-framework.org/SI#MeasurementUnit> a owl:Class;
    rdfs:comment "Measurement unit defining the magnitude of the quantity in respect to the value.\nsi:MeasurementUnit class is reused"@en;
    rdfs:label "Unit of measurement"@en.
eudpp:hasNextDPP a owl:ObjectProperty;
    rdfs:comment "Link to successor DPP"@en;
    rdfs:label "has next DPP"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range eudpp:DPP;
    owl:inverseOf eudpp:hasPreviousDPP.
eudpp:hasPreviousDPP a owl:ObjectProperty;
    rdfs:comment "Link to predecessor DPP"@en;
    rdfs:label "has previous DPP"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range eudpp:DPP.
eudpp:hasProductGroup a owl:ObjectProperty;
    rdfs:comment "Product group\nmeans a set of products that serve similar purposes and are similar in terms of use, or have similar\nfunctional properties, and are similar in terms of consumer perception (ESPR Art 2 (4)). The product\ngroup or groups covered are given by delegated acts. (ESPR Art 8 (a))\n\nThis will be probably a classification code from some product classification scheme ."@en;
    rdfs:label "has product group"@en;
    dcterms:references "ESPR Art 2 (4)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:ClassificationCode.
eudpp:ClassificationCode a owl:Class;
    rdfs:comment "A classification code from some product classification scheme ."@en;
    rdfs:label "ClassificationCode"@en.
eudpp:hasProperty a owl:ObjectProperty;
    rdfs:comment "Product has a property that could be a document or some measurable properties (measurands).\n\nLinking the product to the property."@en;
    rdfs:label "has property"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:Property.
eudpp:Property a owl:Class;
    rdfs:comment "A property of the product."@en;
    rdfs:label "Property"@en.
eudpp:isComponentOf a owl:ObjectProperty, owl:TransitiveProperty;
    rdfs:comment "A product is a component of another product.\n\n‘component’ means a product intended to be incorporated into another product; [ESPR Art 2(2)]"@en;
    rdfs:label "is component of"@en;
    dcterms:references "ESPR Art 2(2)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:Product.
eudpp:isSparePartOf a owl:ObjectProperty;
    rdfs:comment "A product is a spare part of another product."@en;
    rdfs:label "is spare part of"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:Product.
eudpp:codeSet a owl:DatatypeProperty;
    rdfs:comment "The product classification code set.\n\nSee also Produc hasProductGroup ClassificationCode documentation."@en;
    rdfs:label "classification code set"@en;
    rdfs:domain eudpp:ClassificationCode;
    rdfs:range xsd:anyURI.
eudpp:codeValue a owl:DatatypeProperty;
    rdfs:comment "Classification code value from the Classification code set."@en;
    rdfs:label "classification code value"@en;
    rdfs:domain eudpp:ClassificationCode;
    rdfs:range xsd:string.
eudpp:commodityCode a owl:DatatypeProperty;
    rdfs:comment "Relevant commodity codes, such as a TARIC code as defined in Council Regulation (EEC) No 2658/87.[ESPR Annex III (d)]"@en;
    rdfs:label "commodity code"@en;
    dcterms:references "ESPR Annex III (d)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:Product;
    rdfs:range xsd:string.
eudpp:contentType a owl:DatatypeProperty;
    rdfs:comment "Content type of a document. Can be only “application” or “pdf”."@en;
    rdfs:label "content type"@en;
    rdfs:domain eudpp:DocumentFormattedProperty;
    rdfs:range _:n3-79.
_:n3-79 a rdfs:Datatype;
    owl:oneOf _:n3-80.
_:n3-80 a rdf:List;
    rdf:first "application";
    rdf:rest _:n3-81.
_:n3-81 a rdf:List;
    rdf:first "pdf";
    rdf:rest rdf:nil.
eudpp:countryOfOrigin a owl:DatatypeProperty;
    rdfs:comment "Represents customs/regulatory country of origin, which may be distinct from facility location. \n\nNote: not specified by ESPR, requested by sectors (reasoning: country of origin must not be inferred automatically from facility country).\n\nRecommended ISO 3166-1 country codes."@en;
    rdfs:label "country of origin"@en;
    rdfs:domain eudpp:Product;
    rdfs:range xsd:string.
eudpp:description a owl:DatatypeProperty;
    rdfs:comment "Product description"@en;
    rdfs:label "description"@en;
    rdfs:domain eudpp:Product;
    rdfs:range xsd:string.
eudpp:dictionaryReference a owl:DatatypeProperty;
    rdfs:comment "The reference to the unique identifier of the data point specification defined in the repository/data dictionary.\n\nIt is formatted as a URI/URL ."@en;
    rdfs:label "dictionary reference"@en;
    rdfs:domain eudpp:Property;
    rdfs:range xsd:string.
eudpp:dppBackupUrl a owl:DatatypeProperty;
    rdfs:comment "Fallback URL providing direct access to Digital Product Passport data in case the primary provider becomes unavailable."@en;
    rdfs:label "DPP backup URL"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range xsd:anyURI.
eudpp:dppSchemaVersion a owl:DatatypeProperty;
    rdfs:comment "The reference standard the DPP instance schema refers to."@en;
    rdfs:label "DPP schema version"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range xsd:string.
eudpp:dppStatus a owl:DatatypeProperty;
    rdfs:comment "The status of the DPP instance as digital resource."@en;
    rdfs:label "DPP status"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range _:n3-82.
_:n3-82 a rdfs:Datatype;
    owl:oneOf _:n3-83.
_:n3-83 a rdf:List;
    rdf:first "Active";
    rdf:rest _:n3-84.
_:n3-84 a rdf:List;
    rdf:first "Archived";
    rdf:rest _:n3-85.
_:n3-85 a rdf:List;
    rdf:first "Inactive";
    rdf:rest _:n3-86.
_:n3-86 a rdf:List;
    rdf:first "Invalid";
    rdf:rest rdf:nil.
eudpp:dppUrl a owl:DatatypeProperty;
    rdfs:comment "Provides the HTTP/URI endpoint to access the live DPP."@en;
    rdfs:label "DPP URL"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range xsd:anyURI.
eudpp:granularity a owl:DatatypeProperty;
    rdfs:comment "ESPR Art 9 (2) d  declares that the digital product passport is to be established at model, batch or item level, and the definition of such levels (is determined by delegated acts (DA));\n\nThe product passport should be defined at the level of item, batch or product model, depending on specific needs and complexity of the value chain, the size, nature or impacts of the products considered. (Standardisation Request 5423 7)"@en;
    rdfs:label "granularity"@en;
    dcterms:references "ESPR Art 9 (2) d"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:DPP;
    rdfs:range _:n3-87.
_:n3-87 a rdfs:Datatype;
    owl:oneOf _:n3-88.
_:n3-88 a rdf:List;
    rdf:first "batch";
    rdf:rest _:n3-89.
_:n3-89 a rdf:List;
    rdf:first "item";
    rdf:rest _:n3-90.
_:n3-90 a rdf:List;
    rdf:first "model";
    rdf:rest rdf:nil.
eudpp:isEnergyRelated a owl:DatatypeProperty;
    rdfs:comment "Energy related product\nmeans any product that has an impact on energy consumption during use. (ESPR Art 2 (4)).\n\nThe boolean data type property indicates is a Product energy related or not?"@en;
    rdfs:label "is energy related Product"@en;
    dcterms:references "ESPR Art 2 (4)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:Product;
    rdfs:range xsd:boolean.
eudpp:isReplaceable a owl:DatatypeProperty;
    rdfs:comment "Indicates whether the product (e.g. a component of another product) can be replaced."@en;
    rdfs:label "is replacable"@en;
    rdfs:domain eudpp:Product;
    rdfs:range xsd:boolean.
eudpp:lastUpdate a owl:DatatypeProperty;
    rdfs:comment "The date and time of the latest update to the DPP instance."@en;
    rdfs:label "last update"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range xsd:dateTimeStamp.
eudpp:linkToPreviousDPP a owl:DatatypeProperty;
    rdfs:comment "Where a new digital product passport is created for a product that already has a digital product passport, the new digital product passport shall be linked to the original digital product passport or passports. (ESPR Art 11 (d))"@en;
    rdfs:label "link to previous DPP"@en;
    dcterms:references "https://eur-lex.europa.eu/eli/reg/2024/1781/oj", "ESPR Art 11 (d)"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range xsd:anyURI.
eudpp:manufacturingDate a owl:DatatypeProperty;
    rdfs:comment "Date of manufacture of the product. \n\nThe range of the data property is intentionally left open to be specified in accordance of sectorial needs."@en;
    rdfs:label "manufacturing date"@en;
    rdfs:domain eudpp:Product.
eudpp:numericalValue a owl:DatatypeProperty;
    rdfs:comment "The numerical value of the quantity, i.e., quantitative property of the product."@en;
    rdfs:label "numerical value"@en;
    rdfs:domain eudpp:QuantitativeProperty;
    rdfs:range xsd:decimal.
eudpp:productImage a owl:DatatypeProperty;
    rdfs:comment "An image of the product."@en;
    rdfs:label "product image"@en;
    rdfs:domain eudpp:Product;
    rdfs:range xsd:anyURI.
eudpp:productName a owl:DatatypeProperty;
    rdfs:comment "Product name"@en;
    rdfs:label "product name"@en;
    rdfs:domain eudpp:Product;
    rdfs:range xsd:string.
eudpp:productTradeMark a owl:DatatypeProperty;
    rdfs:comment "Trade marks identify goods or services as produced or marketed by a particular undertaking.\n\nTrade mark required by ESPR Art 27(6), Art 29(3), Art 36 (1a).\n\nWhen placing a product on the market, importers should indicate on the product their name, registered trade name or registered trade mark as well as the postal address at which and electronic means of communication through which they can be contacted. ESPR Preamble (64)."@en;
    rdfs:label "product trade mark"@en;
    dcterms:references "EUIPO guidelines 3.2.3.1 Trade Mark Guidelines"@en;
    dcterms:source "https://guidelines.euipo.europa.eu/1803468/1787175/trade-mark-guidelines/3-2-3-1-trade-names";
    rdfs:domain eudpp:Product;
    rdfs:range xsd:string.
eudpp:tolerance a owl:DatatypeProperty;
    rdfs:comment "Engineering tolerance is the permissible variation in measurements deriving from the base measurement.\nTolerances can apply to many different units."@en;
    rdfs:label "tolerance"@en;
    rdfs:domain eudpp:QuantitativeProperty;
    rdfs:range xsd:double.
eudpp:validFrom a owl:DatatypeProperty;
    rdfs:comment "The date and timestamp that the DPP is valid from."@en;
    rdfs:label "valid from"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range xsd:dateTimeStamp.
eudpp:validUntil a owl:DatatypeProperty;
    rdfs:comment "The date and timestamp that the DPP is valid until."@en;
    rdfs:label "valid until"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range xsd:dateTimeStamp.
eudpp:value a owl:DatatypeProperty;
    rdfs:comment "Contains the data of the value encapsulated in the Document.\n\nValue is xsd:string that is formatted as a URL,  where to fetch the file."@en;
    rdfs:label "value related to the document"@en;
    rdfs:domain eudpp:DocumentFormattedProperty;
    rdfs:range xsd:string.
eudpp:webLink a owl:DatatypeProperty;
    rdfs:comment "Web link to an instruction document or video etc."@en;
    rdfs:label "weblink"@en;
    rdfs:domain eudpp:DigitalInstruction;
    rdfs:range xsd:anyURI.
eudpp:CircularEconomyIndicator a owl:Class;
    rdfs:comment "Circular Economy indicators are measures for relevant monitoring the transition to a circular economy and to measure the effects of new policy and trends.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Circular Economy Indicator"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty;
    rdfs:seeAlso <https://environment.ec.europa.eu/strategy/circular-economy-action-plan_en>.
eudpp:Durability a owl:Class;
    rdfs:comment "Durability\nmeans the ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair. (ESPR Art 2 (22))\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Durability"@en;
    dcterms:references "ESPR Art 2 (22)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QualityIndicator.
eudpp:QualityIndicator a owl:Class;
    rdfs:comment "Product characteristics like durability and reliability.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Quality indicator"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:EmissionToAir a owl:Class;
    rdfs:comment "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Emission to air"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalEmission.
eudpp:EnvironmentalEmission a owl:Class;
    rdfs:comment "Emission is the act or amount of sending out gas, heat, light, etc. It can also refer to harmful substances that are released into the environment, especially carbon dioxide.\n\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Environmental emission"@en;
    rdfs:subClassOf eudpp:EnvironmentalPollution;
    rdfs:seeAlso <https://dictionary.cambridge.org/dictionary/english/emission>.
eudpp:EmissionToSoil a owl:Class;
    rdfs:comment "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Emission to soil"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalEmission.
eudpp:EmissionToWater a owl:Class;
    rdfs:comment "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Emission to water"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalEmission.
eudpp:EnvironmentalPollution a owl:Class;
    rdfs:comment "Environmental pollution is the addition of any substance or form of energy to the environment at a rate faster than it can be dispersed or safely stored.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Environmental pollution"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty;
    rdfs:seeAlso <https://www.britannica.com/science/pollution-environment>.
eudpp:HazardousWasteAmount a owl:Class;
    rdfs:comment "Hazardous waste amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Hazardous waste amount"@en;
    rdfs:subClassOf eudpp:WasteGenerationAmount.
eudpp:WasteGenerationAmount a owl:Class;
    rdfs:comment "Waste generation amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Waste generation amount"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:Height a owl:Class;
    rdfs:comment "Height of the product"@en;
    rdfs:label "Height"@en;
    rdfs:subClassOf eudpp:ProductDimension.
eudpp:ProductDimension a owl:Class;
    rdfs:comment "Dimension class covers measurements of length, width, height, volume, and weight of the product required by\nESPR Annex I in its product parameters"@en;
    rdfs:label "Product dimension"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:Length a owl:Class;
    rdfs:comment "Length of the product"@en;
    rdfs:label "Length"@en;
    rdfs:subClassOf eudpp:ProductDimension.
eudpp:MicroplasticRelease a owl:Class;
    rdfs:comment "Product parameters as listed in the ESPR Annex I :\n\n(p) microplastic and nano plastic release as expressed through the release during relevant\nproduct life cycle stages, including manufacturing, transport, use and end of life stages;\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Microplastic release"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:PlasticsRelease.
eudpp:PlasticsRelease a owl:Class;
    rdfs:comment "Product parameters as listed in the ESPR Annex I :\n\n(p) microplastic and nano plastic release as expressed through the release during relevant\nproduct life cycle stages, including manufacturing, transport, use and end of life stages;\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Plastic release"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalPollution.
eudpp:NanoplasticRelease a owl:Class;
    rdfs:comment "Product parameters as listed in the ESPR Annex I :\n\n(p) microplastic and nano plastic release as expressed through the release during relevant\nproduct life cycle stages, including manufacturing, transport, use and end of life stages;\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Nanoplastic release"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:PlasticsRelease.
eudpp:PackagingWasteAmount a owl:Class;
    rdfs:comment "Packaging waste amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Packaging waste amount"@en;
    rdfs:subClassOf eudpp:WasteGenerationAmount.
eudpp:PlasticsWasteAmount a owl:Class;
    rdfs:comment "Hazardous waste amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Plastics waste amount"@en;
    rdfs:subClassOf eudpp:WasteGenerationAmount.
eudpp:ProductToPackagingRatio a owl:Class;
    rdfs:comment "ESPR Annex I, the list of product parameters includes the parameter called the  product to packaging ratio.\n\nHowever, it is not specified in ESPR  whether that ratio is defined on the basis of weight or on the basis of volume.\n\n**This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.**"@en;
    rdfs:label "Product to packaging ratio"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:RecoverableRate a owl:Class;
    rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Recoverable rate"@en;
    rdfs:subClassOf eudpp:CircularEconomyIndicator.
eudpp:RecyclingCollectionRate a owl:Class;
    rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Recycling collection rate"@en;
    rdfs:subClassOf eudpp:CircularEconomyIndicator.
eudpp:RecyclingRate a owl:Class;
    rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Recycling rate"@en;
    rdfs:subClassOf eudpp:CircularEconomyIndicator.
eudpp:Reliability a owl:Class;
    rdfs:comment "Reliability\nmeans the probability that a product functions as required under given conditions for a given\nduration without an occurrence which results in a primary or secondary function of the product no\nlonger being performed. (ESPR Art 2 (16))\n\nReliability is usually expressed in terms of mean time between failures (MTBF), which is the average length of time that a device will operate without failure.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Reliability"@en;
    dcterms:references "ESPR Art 2 (16)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QualityIndicator.
eudpp:ThresholdOfSubstanceOfConcern a owl:Class;
    rdfs:comment "Relevant threshold of Substance of Concern.\n\nBy default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]"@en;
    rdfs:label "Threshold of substance of concern"@en;
    dcterms:references "ESPR FAQ 10.115, p59"@en;
    dcterms:source "https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details";
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:Volume a owl:Class;
    rdfs:comment "Volume of the product"@en;
    rdfs:label "Volume"@en;
    rdfs:subClassOf eudpp:ProductDimension.
eudpp:Weight a owl:Class;
    rdfs:comment "Weight of the product"@en;
    rdfs:label "Weight"@en;
    rdfs:subClassOf eudpp:ProductDimension.
eudpp:Width a owl:Class;
    rdfs:comment "Width of the product"@en;
    rdfs:label "Width"@en;
    rdfs:subClassOf eudpp:ProductDimension.
_:n3-91 rdfs:comment "The EU DPP core ontology".
<http://purl.org/vocab/vann#preferredNamespacePrefix> a owl:AnnotationProperty.
skos:inScheme a owl:AnnotationProperty.
skos:notation a owl:AnnotationProperty.
skos:prefLabel a owl:AnnotationProperty.
skos:scopeNote a owl:AnnotationProperty.
skos:topConceptOf a owl:AnnotationProperty.
eudpp:sourceStatus a owl:AnnotationProperty;
    rdfs:comment "Annotation property used to state the epistemic or normative status of the source for an ontology resource, for example direct legal definition, explicit legal information element, ESPR-grounded modelling abstraction, or JRC draft proposal. It is intentionally distinct from dcterms:provenance, which is reserved for ownership and custody history."@en;
    rdfs:label "source status"@en;
    dcterms:references "Introduced to avoid using dcterms:provenance for epistemic source-status annotations."@en;
    dcterms:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/provenance/>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>.
eudpp:concernsSubstance a owl:ObjectProperty;
    rdfs:comment "Links a reported SubstancePresence to the SubstanceOfConcern involved. dpp:Substance remains the superclass used for generic substance identity and naming properties, but the SOC reporting relation itself is intentionally restricted to dpp:SubstanceOfConcern."@en;
    rdfs:label "Concerns substance"@en;
    dcterms:references "ESPR Article 7(5)(a)"@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    rdfs:domain eudpp:SubstancePresence;
    rdfs:range eudpp:SubstanceOfConcern;
    eudpp:sourceStatus "ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation."@en.
eudpp:hasApplicableQualification a owl:ObjectProperty;
    rdfs:comment "Links a SubstancePresence to an applicable qualification assertion; criterion (d) context is presence-scoped."@en;
    rdfs:label "has applicable qualification"@en;
    dcterms:references "ESPR Articles 2(27) and 7(5)."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    rdfs:domain eudpp:SubstancePresence;
    rdfs:range eudpp:SoCQualificationAssertion;
    eudpp:sourceStatus "ESPR-grounded contextual relation connecting a SubstancePresence to the qualification assertion applicable in that product-specific presence context."@en.
eudpp:SoCQualificationAssertion a owl:Class;
    rdfs:comment "A documented, explicit assertion that a substance satisfies one or more non-exclusive qualification criteria in ESPR Article 2(27). For criterion (d), the applicable product context is represented by a dpp:SubstancePresence linked through dpp:hasApplicableQualification. This modelling construct records asserted qualification evidence; it does not infer legal status."@en;
    rdfs:label "SoC qualification assertion"@en;
    dcterms:references "ESPR Article 2(27)."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>, <http://data.europa.eu/eli/reg/2006/1907/oj>, <http://data.europa.eu/eli/reg/2008/1272/oj>, <http://data.europa.eu/eli/reg/2019/1021/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    eudpp:sourceStatus "ESPR-grounded modelling construct for recording an explicit Article 2(27) qualification; the assertion is not itself a legal term and the ontology does not infer legal status."@en.
eudpp:hasDisassemblyInstruction a owl:ObjectProperty;
    rdfs:comment "Links a substance presence to information relevant for disassembly."@en;
    rdfs:label "Has disassembly instruction"@en;
    dcterms:references "ESPR Article 7(5)(e)."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    rdfs:domain eudpp:SubstancePresence;
    rdfs:range eudpp:SubstanceManagementInstruction;
    eudpp:sourceStatus "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en.
eudpp:hasEndOfLifeManagementInstruction a owl:ObjectProperty;
    rdfs:comment "Links a substance presence to information relevant for environmentally sound management of the product at end-of-life."@en;
    rdfs:label "Has end-of-life management instruction"@en;
    dcterms:references "ESPR Article 7(5)(e)."@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    rdfs:domain eudpp:SubstancePresence;
    rdfs:range eudpp:SubstanceManagementInstruction;
    eudpp:sourceStatus "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en.
eudpp:hasPreparationForReuseInstruction a owl:ObjectProperty;
    rdfs:comment "Links a substance presence to information relevant for preparation for reuse."@en;
