eudpp:ConcentrationRange a owl:Class;
    rdfs:comment "A concentration reported as an interval with a minimum and a maximum numerical value. The measurement unit is provided through dpp:hasMeasurementUnit."@en;
    rdfs:label "Concentration range"@en;
    dcterms:references "ESPR Article 7(5)(c)"@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
