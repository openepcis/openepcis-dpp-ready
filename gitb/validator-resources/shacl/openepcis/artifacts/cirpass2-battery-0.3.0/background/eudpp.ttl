schema:address a owl:ObjectProperty;
    rdfs:comment "Links an Actor or Facility to its postal address, represented as a schema:PostalAddress"@en;
    rdfs:label "has address"@en;
    rdfs:isDefinedBy schema:address.
schema:geo a owl:ObjectProperty;
    rdfs:comment "Links facility to its coordinates, represented as schema:geo."@en;
    rdfs:label "has coordinates"@en;
    rdfs:isDefinedBy schema:geo.
eudpp:hasActor a owl:ObjectProperty;
    rdfs:comment "Links actor role assignment to actor"@en;
    rdfs:label "has actor"@en;
    rdfs:domain eudpp:ActorRoleAssignment;
    rdfs:range eudpp:Actor.
eudpp:ActorRoleAssignment a owl:Class;
    rdfs:comment "Assigns a role to the actor in a particular context (DPP, Product, Event)."@en;
    rdfs:label "Actor role assignment"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/ACTOR>;
    rdfs:subClassOf _:n3-3.
eudpp:Actor a owl:Class;
    rdfs:comment "Actor means a legal or natural person (e.g. John Doe, TNO). One actor can take on multiple roles; [CIRPASS-2 User Stories 3.1]"@en;
    rdfs:label "Actor"@en;
    dcterms:references "CIRPASS-2 User Stories 3.1"@en;
    dcterms:source "https://zenodo.org/records/17979585";
    rdfs:isDefinedBy <https://w3id.org/eudpp/ACTOR>;
    rdfs:subClassOf _:n3-2.
eudpp:hasRepresentativeMandate a owl:ObjectProperty;
    rdfs:comment "Relates a manufacturer to the mandate (assignment) that authorises an actor to act on the manufacturer's behalf."@en;
    rdfs:label "has representative mandate"@en;
    rdfs:domain eudpp:Actor;
    rdfs:range eudpp:AuthorisedRepresentativeRoleAssignment;
    owl:inverseOf eudpp:representsManufacturer.
eudpp:representsManufacturer a owl:ObjectProperty;
    rdfs:comment "Used when the role is authorisedRepresentativeRole to indicate the manufacturer being represented."@en;
    rdfs:label "represents manufacturer"@en;
    rdfs:domain eudpp:AuthorisedRepresentativeRoleAssignment;
    rdfs:range eudpp:Actor.
eudpp:AuthorisedRepresentativeRoleAssignment a owl:Class;
    rdfs:comment "A specific assignment representing the written mandate between a manufacturer and an authorised representative; [ESPR Art 2 (43)]"@en;
    rdfs:label "Authorised representative role assignment"@en;
    dcterms:references "ESPR Art 2 (43)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:isDefinedBy <https://w3id.org/eudpp/ACTOR>;
    rdfs:subClassOf eudpp:ActorRoleAssignment, _:n3-4.
eudpp:hasRole a owl:ObjectProperty;
    rdfs:comment "Links an actor role assignment to a role."@en;
    rdfs:label "has role"@en;
    rdfs:domain eudpp:ActorRoleAssignment;
    rdfs:range eudpp:Role;
    owl:inverseOf eudpp:isRoleOf.
eudpp:isRoleOf a owl:ObjectProperty;
    rdfs:comment "Relates role to an actor role assignment."@en;
    rdfs:label "is role of"@en;
    rdfs:domain eudpp:Role;
    rdfs:range eudpp:ActorRoleAssignment.
eudpp:Role a owl:Class;
    rdfs:comment "Role means a set of tasks typically performed by one actor. (e.g. Responsible Economic Operator, Independent operator); [CIRPASS-2 User Stories 3.1]"@en;
    rdfs:label "Role"@en;
    dcterms:references "CIRPASS-2 User Stories 3.1"@en;
    dcterms:source "https://zenodo.org/records/17979585".
eudpp:isEstablishedIn a owl:ObjectProperty;
    rdfs:comment "Relates a legal person to the location where it is established."@en;
    rdfs:label "is established in"@en;
    rdfs:domain eudpp:LegalPerson;
    rdfs:range dcterms:Location.
eudpp:LegalPerson a owl:Class;
    rdfs:comment "A body of persons or an entity (as a corporation) considered as having many of the rights and responsibilities of a natural person and especially the capacity to sue and be sued."@en;
    rdfs:label "Legal Person"@en;
    dcterms:source "https://www.merriam-webster.com/legal/legal%20person";
    rdfs:subClassOf eudpp:Actor;
    owl:disjointWith eudpp:NaturalPerson.
dcterms:Location a owl:Class;
    rdfs:label "Location"@en;
    rdfs:isDefinedBy <http://purl.org/dc/terms>.
eudpp:isResidingIn a owl:ObjectProperty;
    rdfs:comment "Relates a natural person to the location where they reside."@en;
    rdfs:label "is residing in"@en;
    rdfs:domain eudpp:NaturalPerson;
    rdfs:range dcterms:Location.
eudpp:NaturalPerson a owl:Class;
    rdfs:comment "A human being as distinguished from a person (as a corporation) created by operation of law"@en;
    rdfs:label "Natural Person"@en;
    dcterms:source "https://www.merriam-webster.com/legal/natural%20person";
    rdfs:subClassOf eudpp:Actor.
eudpp:isUsedByActor a owl:ObjectProperty;
    rdfs:comment "Relates a facility to an actor."@en;
    rdfs:label "is used by actor"@en;
    rdfs:domain eudpp:Facility;
    rdfs:range eudpp:Actor;
    owl:inverseOf eudpp:usesFacility.
eudpp:usesFacility a owl:ObjectProperty;
    rdfs:comment "Relates an actor to facility."@en;
    rdfs:label "uses facility"@en;
    rdfs:domain eudpp:Actor;
    rdfs:range eudpp:Facility.
eudpp:Facility a owl:Class;
    rdfs:comment "A Facility may be a place where specific activities occur. A production/manufacturing facility means a factory. The term may refer to any place that makes things, or plants that generate electricity."@en, "Business facilities are structures that provide services to a business. This can include space for employees, technology, equipment and inventory. Facilities can be used for business administration, operations or to provide services to customers."@en;
    rdfs:label "Facility"@en;
    dcterms:source "https://marketbusinessnews.com/financial-glossary/facility/";
    rdfs:isDefinedBy <https://w3id.org/eudpp/ACTOR>;
    rdfs:subClassOf _:n3-5, _:n3-6.
schema:email a owl:DatatypeProperty;
    rdfs:comment "Links an Actor to its email address."@en;
    rdfs:label "has email"@en;
    rdfs:isDefinedBy schema:email;
    rdfs:range xsd:string.
schema:latitude a owl:DatatypeProperty;
    rdfs:comment "Links facility to its coordinates. Part of schema:geo."@en;
    rdfs:label "latitude"@en;
    rdfs:isDefinedBy schema:latitude;
    rdfs:range xsd:decimal.
schema:longitude a owl:DatatypeProperty;
    rdfs:comment "Links facility to its coordinates. Part of schema:geo."@en;
    rdfs:label "longitude"@en;
    rdfs:isDefinedBy schema:longitude;
    rdfs:range xsd:decimal.
schema:telephone a owl:DatatypeProperty;
    rdfs:comment "Links an Actor to its phone."@en;
    rdfs:label "has phone"@en;
    rdfs:isDefinedBy schema:telephone;
    rdfs:range xsd:string.
schema:url a owl:DatatypeProperty;
    rdfs:comment "The official website or webpage of the actor."^^xsd:anyURI;
    rdfs:label "URL"@en;
    rdfs:isDefinedBy schema:url;
    rdfs:range xsd:anyURI.
eudpp:actorName a owl:DatatypeProperty;
    rdfs:comment "Name of an actor."@en;
    rdfs:label "actor name"@en;
    rdfs:domain eudpp:Actor;
    rdfs:range xsd:string.
eudpp:assignmentValidFrom a owl:DatatypeProperty;
    rdfs:comment "The date and time from which the actor role assignment is valid."@en;
    rdfs:label "assignment valid from"@en;
    rdfs:domain eudpp:ActorRoleAssignment;
    rdfs:range xsd:dateTime.
eudpp:assignmentValidTo a owl:DatatypeProperty;
    rdfs:comment "The date and time until which the actor role assignment is valid."@en;
    rdfs:label "assignment valid to"@en;
    rdfs:domain eudpp:ActorRoleAssignment;
    rdfs:range xsd:dateTime.
eudpp:registeredTradeName a owl:DatatypeProperty;
    rdfs:comment "Trade name under which a legal person or business operates and is registered."@en;
    rdfs:label "registered trade name"@en;
    rdfs:domain eudpp:Actor;
    rdfs:range xsd:string.
<https://w3id.org/eudpp/facilityName> a owl:DatatypeProperty;
    rdfs:comment "Optional human-readable name of the facility."@en;
    rdfs:label "facility name"@en;
    rdfs:domain eudpp:Facility;
    rdfs:range xsd:string.
schema:GeoCoordinates a owl:Class;
    rdfs:isDefinedBy schema:GeoCoordinates;
    rdfs:subClassOf _:n3-0, _:n3-1.
_:n3-0 a owl:Restriction;
    owl:onProperty schema:latitude;
    owl:someValuesFrom xsd:decimal.
_:n3-1 a owl:Restriction;
    owl:onProperty schema:longitude;
    owl:someValuesFrom xsd:decimal.
schema:PostalAddress a owl:Class;
    rdfs:isDefinedBy schema:PostalAddress.
_:n3-2 a owl:Restriction;
    owl:onProperty schema:address;
    owl:allValuesFrom schema:PostalAddress.
_:n3-3 a owl:Restriction;
    owl:onProperty eudpp:hasRole;
    owl:allValuesFrom eudpp:Role.
_:n3-4 a owl:Restriction;
    owl:onProperty eudpp:hasRole;
    owl:hasValue eudpp:authorisedRepresentative.
eudpp:authorisedRepresentative a eudpp:EconomicOperatorRole, owl:NamedIndividual;
    rdfs:comment "Authorised representative means any natural or legal person established in the Union that has received a written mandate from the manufacturer to act on the manufacturer’s behalf in relation to specified tasks with regard to the manufacturer’s obligations under this Regulation; [ESPR Art 2 (43)]"@en;
    rdfs:label "Authorised Representative"@en;
    dcterms:references "ESPR Art 2 (43)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:AuthorityRole a owl:Class;
    rdfs:comment "Parent class for roles of authorities, such as market surveillance authority, customs authority, etc."@en;
    rdfs:label "Authority role"@en;
    rdfs:subClassOf eudpp:Role.
eudpp:CircularEconomyRole a owl:Class;
    rdfs:comment "Parent class for roles related to circular economy, such as remanufacturer, refurbisher, etc."@en;
    rdfs:label "Circular economy role"@en;
    rdfs:subClassOf eudpp:Role.
eudpp:ConformityAssessmentRole a owl:Class;
    rdfs:comment "Conformity assessment means the process demonstrating whether the ecodesign requirements set out in the relevant delegated acts adopted pursuant to Article 4 have been fulfilled; [ESPR Art 2 (51)]"@en;
    rdfs:label "Conformity assessment role"@en;
    dcterms:references "ESPR Art 2 (51)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:Role.
eudpp:EconomicOperatorRole a owl:Class;
    rdfs:comment "Economic operator means the manufacturer, the authorised representative, the importer, the distributor, the dealer and the fulfilment service provider; [ESPR Art 2 (46)]"@en;
    rdfs:label "Economic operator role"@en;
    dcterms:references "ESPR Art 2 (46)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:Role.
eudpp:EndUserRole a owl:Class;
    rdfs:comment "Parent class for roles of end users, such as consumer, etc."@en;
    rdfs:label "End user role"@en;
    rdfs:subClassOf eudpp:Role.
_:n3-5 a owl:Restriction;
    owl:onProperty schema:address;
    owl:allValuesFrom schema:PostalAddress.
_:n3-6 a owl:Restriction;
    owl:onProperty schema:geo;
    owl:allValuesFrom schema:GeoCoordinates.
<http://publications.europa.eu/resource/authority/corporate-body/COM> a owl:NamedIndividual;
    owl:sameAs eudpp:EuropeanCommission.
eudpp:EuropeanCommission a eudpp:LegalPerson, owl:NamedIndividual;
    rdfs:comment "The European Commission, abbreviated as EC, is the executive branch of the European Union."@en;
    rdfs:label "European Commission"@en;
    dcterms:source "https://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:European_Commission_(EC)".
<http://publications.europa.eu/resource/authority/country/EUR> a owl:NamedIndividual;
    rdfs:comment "European Union is used here as a jurisdictional or geographic entity for legal and regulatory contexts."@en;
    rdfs:label "European Union"@en.
eudpp:conformityAssessmentBody a eudpp:ConformityAssessmentRole, owl:NamedIndividual;
    rdfs:comment "Conformity assessment body means a body that performs conformity assessment activities including calibration, testing, certification and inspection; [ESPR Art 2 (52)]"@en;
    rdfs:label "Conformity Assessment Body"@en;
    dcterms:references "ESPR Art 2 (52)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:consumer a eudpp:EndUserRole, owl:NamedIndividual;
    rdfs:comment "Consumer means any natural person who, in relation to contracts covered by Directive (EU) 2019/771, is acting for purposes which are outside that person's trade, business, craft or profession; [Directive (EU) 2019/771, Art 2 (2)]"@en;
    rdfs:label "Consumer"@en;
    dcterms:references "Directive (EU) 2019/771, Art 2 (2)"@en;
    dcterms:source "http://data.europa.eu/eli/dir/2019/771/oj";
    skos:broader eudpp:customer.
eudpp:customer a eudpp:EndUserRole, owl:NamedIndividual;
    rdfs:comment "Customer means a natural or legal person that purchases, hires or receives a product for their own use whether or not acting for purposes which are outside their trade, business, craft or profession; [ESPR Art 2 (35)]"@en;
    rdfs:label "Customer"@en;
    dcterms:references "ESPR Art 2 (35)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:credentialAgency a eudpp:Role, owl:NamedIndividual;
    rdfs:comment "A legal person that provides (professional) credentials to parties, which may be used to make and verify a variety of claims in the DPP, (ESPR) Art. 11 last paragraph. For example, a credentials agency could certify a professional repairer and provide appropriate credentials for the DPP system; [CIRPASS-2 User Stories 3.1]"@en;
    rdfs:label "Credential Agency"@en;
    dcterms:references "CIRPASS-2 User Stories 3.1"@en;
    dcterms:source "https://zenodo.org/records/17979585".
eudpp:customsAuthority a eudpp:AuthorityRole, owl:NamedIndividual;
    rdfs:comment "Customs authorities means  customs authorities as defined in point 1 of Article 5 of Regulation (EU) No 952/2013; [Regulation (EU) 2019/1020, Art 3 (24)]"@en, "Customs authorities means the customs administrations of the Member States responsible for applying the customs legislation and any other authorities empowered under national law to apply certain customs legislation (Regulation (EU) No 952/2013 Art 5 (1);"@en;
    rdfs:label "Customs Authority"@en;
    dcterms:references "Regulation (EU) 2019/1020, Art 3 (24)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2019/1020/oj".
eudpp:dealer a eudpp:EconomicOperatorRole, owl:NamedIndividual;
    rdfs:comment "Dealer means a distributor or any other natural or legal person that offers products for sale, hire or hire purchase, or that displays products, to end users in the course of a commercial activity, including through distance selling; and includes any natural or legal person that puts a product into service in the course of a commercial activity; [ESPR Art 2 (55)]"@en;
    rdfs:label "Dealer"@en;
    dcterms:references "ESPR Art 2 (55)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    skos:related eudpp:distributor.
eudpp:distributor a eudpp:EconomicOperatorRole, owl:NamedIndividual;
    rdfs:comment "Distributor means any natural or legal person in the supply chain, other than the manufacturer or the importer, that makes a product available on the market; [ESPR Art 2 (45)]"@en;
    rdfs:label "Distributor"@en;
    dcterms:references "ESPR Art 2 (45)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    skos:related eudpp:dealer.
eudpp:dppServiceProvider a eudpp:Role, owl:NamedIndividual;
    rdfs:comment "Digital product passport service provider means a natural or legal person that is an independent third-party authorised by the economic operator which places the product on the market or puts it into service and that processes the digital product passport data for that product for the purpose of making such data available to economic operators and other relevant actors with a right to access those data under this Regulation or other Union law; [ESPR Art 2 (32)]"@en;
    rdfs:label "DPP Service Provider"@en;
    dcterms:references "ESPR Art 2 (32)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:endUser a eudpp:EndUserRole, owl:NamedIndividual;
    rdfs:comment "End user means any natural or legal person residing or established in the Union, to whom a product has been made available either as a consumer outside of any trade, business, craft or profession or as a professional end user in the course of its industrial or professional activities; [Regulation (EU) 2019/1020  Art 3 (21)]"@en;
    rdfs:label "End User"@en;
    dcterms:references "Regulation (EU) 2019/1020, Art 3 (21)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2019/1020/oj";
    skos:related eudpp:customer.
eudpp:fulfilmentServiceProvider a eudpp:EconomicOperatorRole, owl:NamedIndividual;
    rdfs:comment "Fulfilment service provider means any natural or legal person offering, in the course of commercial activity, at least two of the following services: warehousing, packaging, addressing and dispatching, without having ownership of the products involved, excluding postal services as defined in point 1 of Article 2 of Directive 97/67/EC of the European Parliament and of the Council (31), parcel delivery services as defined in point 2 of Article 2 of Regulation (EU) 2018/644 of the European Parliament and of the Council (32), and any other postal services or freight transport services; [Regulation (EU) 2019/1020 Art 3 (11)]."@en;
    rdfs:label "Fulfilment Service Provider"@en;
    dcterms:references "Regulation (EU) 2019/1020, Art 3 (11)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2019/1020/oj".
eudpp:importer a eudpp:EconomicOperatorRole, owl:NamedIndividual;
    rdfs:comment "Importer means any natural or legal person established in the Union that places a product from a third country on the Union market; [ESPR Art 2 (44)]"@en;
    rdfs:label "Importer"@en;
    dcterms:references "ESPR Art 2 (44)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:independentOperator a eudpp:CircularEconomyRole, owl:NamedIndividual;
    rdfs:comment "Independent operator means natural or legal person that is independent of the manufacturer and is directly or indirectly involved in the refurbishment, repair, maintenance or repurposing of a product, and includes waste management operators, refurbishers, repairers, manufacturers or distributors of repair equipment, tools or spare parts, as well as publishers of technical information, operators offering inspection and testing services and operators offering training for installers, manufacturers and repairers of equipment; [ESPR Art 2 (47)]"@en;
    rdfs:label "Independent Operator"@en;
    dcterms:references "ESPR Art 2 (47)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:issuingAgency a eudpp:Role, owl:NamedIndividual;
    rdfs:comment "Issuing agency is a legal person that provides unique identifiers and data carriers Art 12 (4a). Under specific conditions, economic operators may perform the functions associated with an Issuing Agency; [ESPR Art 12 (4b)]"@en;
    rdfs:label "Issuing Agency"@en;
    dcterms:references "ESPR Art 12 (4a)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:lcaVerifier a eudpp:Role, owl:NamedIndividual;
    rdfs:comment "Verifier means a person or organisation that carries out the independent verification of an EPD or LCA study, i.e. confirms through objective evidence that the specified requirements are fulfilled, e.g. the PCR and EN 15804+A2. It also covers the critical reviewer of an LCA study and the verifier of a PEF study. Independent verification may be internal or external; EPDs for business-to-consumer communication require third-party verification, also comparative assertions under ISO 14040 and any comparisons under the European Commission’s ILCD Handbook. The type of verification is recorded on the Review (TypeOfReview). ILCD: reviewer (1-3-20-87); [ISO 14025:2006, 3.8, adapted]"@en;
    rdfs:label "LCA or EPD verifier"@en;
    dcterms:references "ISO 14025:2026, 9 and 10.4; ISO 14025:2006, 3.8 and 3.9; ISO 14044:2006, 6; EN 15804:2012+A2:2019, 7.1, Table 2"@en;
    dcterms:source "https://www.iso.org/standard/87610.html".
eudpp:manufacturer a eudpp:EconomicOperatorRole, owl:NamedIndividual;
    rdfs:comment "Manufacturer means any natural or legal person that manufactures a product or that has a product designed or manufactured and markets that product under their name or trademark; [ESPR Art 2 (42)]"@en;
    rdfs:label "Manufacturer"@en;
    dcterms:references "ESPR Art 2 (42)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:marketSurveillanceAuthority a eudpp:AuthorityRole, owl:NamedIndividual;
    rdfs:comment "Market surveillance authority means an authority designated by a Member State under Article 10 as responsible for carrying out market surveillance in the territory of that Member State; [Regulation (EU) 2019/1020 Art 3 (4)]"@en;
    rdfs:label "Market Surveillance Authority"@en;
    dcterms:references "Regulation (EU) 2019/1020, Art 3 (4)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2019/1020/oj".
eudpp:notifiedBody a eudpp:ConformityAssessmentRole, owl:NamedIndividual;
    rdfs:comment "Notified body means a conformity assessment body notified in accordance with Chapter IX; [ESPR Art 2 (53)]"@en;
    rdfs:label "Notified Body"@en;
    dcterms:references "ESPR Art 2 (53)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:professionalRepairer a eudpp:CircularEconomyRole, owl:NamedIndividual;
    rdfs:comment "Professional repairer means a natural or legal person that provides professional repair or maintenance services for a product, irrespective of whether that person acts within the manufacturer’s distribution system or independently; [ESPR Art 2 (48)]"@en;
    rdfs:label "Professional Repairer"@en;
    dcterms:references "ESPR Art 2 (48)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:recycler a eudpp:CircularEconomyRole, owl:NamedIndividual;
    rdfs:comment "An actor performing recycling, which means \"any recovery operation by which waste materials are reprocessed into products, materials or substances whether for the original or other purposes. It includes the reprocessing of organic material but does not include energy recovery and the reprocessing into materials that are to be used as fuels or for backfilling operations\" [WFD Art 3 (17)]"@en;
    rdfs:label "Recycler"@en;
    dcterms:references "WFD Art 3 (17)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dir/2008/98/oj";
    skos:broader eudpp:independentOperator.
eudpp:refurbisher a eudpp:CircularEconomyRole, owl:NamedIndividual;
    rdfs:comment "An actor performing refurbishment, which means \"actions carried out to prepare, clean, test, service and, where necessary, repair a product or a discarded product in order to restore its performance or functionality within the intended use and range of performance originally conceived at the design stage at the time of the placing of the product on the market.\"; [ESPR Art 2 (18)]"@en;
    rdfs:label "Refurbisher"@en;
    dcterms:references "ESPR Art 2 (18)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    skos:broader eudpp:independentOperator.
eudpp:remanufacturer a eudpp:CircularEconomyRole, owl:NamedIndividual;
    rdfs:comment "An actor performing remanufacturing, which means \"actions through which a new product is produced from objects that are waste, products or components and through which at least one change is made that substantially affects the safety, performance, purpose or type of the product\"; [ESPR Art 2 (16)]"@en;
    rdfs:label "Remanufacturer"@en;
    dcterms:references "ESPR Art 2 (16)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    skos:broader eudpp:manufacturer.
eudpp:concernsDPP a owl:ObjectProperty;
    rdfs:comment "Links a DPP event to the Digital Product Passport whose content, state, or accessibility is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.\n\nDPP is modelled in the EU DPP CO P_DPP module.\nDPPEvent is modelled in the EU DPP CO EVENT module."@en;
    rdfs:label "concerns DPP"@en;
    rdfs:domain eudpp:DPPEvent;
    rdfs:range eudpp:DPP.
eudpp:DPPEvent a owl:Class;
    rdfs:comment "An ESPR-level event concept representing an event that affects the existence, content, accessibility, update, correction, or governance of a DPP. A DPPEvent captures the passport-facing semantics of the occurrence and is modelled as distinct from the product event that may trigger it."@en;
    rdfs:label "DPP Event"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/EVENT";
    rdfs:subClassOf eudpp:ESPREvent, _:n3-39;
    owl:disjointWith eudpp:ProductEvent, eudpp:DPPEventRecord.
eudpp:DPP a owl:Class;
    rdfs:comment "Digital Product Passport (DPP) means a set of data specific to a product that includes the information specified in the applicable\ndelegated act adopted pursuant to Article 4 and that is accessible via electronic means through a data carrier in accordance with Chapter III. (ESPR Art 2 (28))"@en;
    rdfs:label "Digital Product Passport (DPP)"@en;
    dcterms:references "ESPR Art 2 (28)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP>.
eudpp:concernsProduct a owl:ObjectProperty;
    rdfs:comment "Links a product event to the product whose state, condition, or lifecycle is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nProductEvent is modelled in the EU DPP CO EVENT module."@en;
    rdfs:label "concerns product"@en;
    rdfs:domain eudpp:ProductEvent;
    rdfs:range eudpp:Product.
eudpp:ProductEvent a owl:Class;
    rdfs:comment "An ESPR-level event concept representing an event that affects the state, condition, use, circulation, transformation, maintenance, or end-of-life status of a product. A ProductEvent captures the product-facing semantics of the occurrence and is distinct from any DPP-side event that may be triggered to record or reflect it."@en;
    rdfs:label "Product Event"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/EVENT";
    rdfs:subClassOf eudpp:ESPREvent.
eudpp:Product a owl:Class;
    rdfs:comment "Product means any physical goods that are placed on the market or put into service. ESPR Art 2 (1))"@en;
    rdfs:label "Product"@en;
    dcterms:references "ESPR Art 2 (1)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP>;
    skos:closeMatch "schema:Product".
eudpp:conformityAttestedBy a owl:ObjectProperty;
    rdfs:comment "Specifies the notified body that attests the product's conformity with Union harmonisation legislation. \n\nUnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "conformity attested by"@en;
    dcterms:references "ESPR Annex V (7)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V";
    rdfs:domain eudpp:UnionHarmonisationLegislation;
    rdfs:range eudpp:Actor.
eudpp:UnionHarmonisationLegislation a owl:Class;
    rdfs:comment "Union Harmonisation Legislation shall mean any Union legislation harmonising the conditions for the marketing of products. Examples are directives, regulations and delegated acts."@en;
    rdfs:label "Union Harmonised Legislation"@en;
    dcterms:source "Decision No 768/2008/EC Annex I Art R1 (17)\nhttps://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/COMP".
eudpp:containsSubstanceOfConcern a owl:ObjectProperty;
    rdfs:comment "Linking the product to a substance of concern the product contains.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nSubstance of concern is modelled in the EU DPP CO SOC module."@en;
    rdfs:label "contains substance of concern"@en;
    rdfs:domain _:n3-7;
    rdfs:range eudpp:SubstanceOfConcern.
_:n3-7 a owl:Class;
    owl:unionOf _:n3-8.
_:n3-8 rdf:first eudpp:MaterialOfComposition;
    rdf:rest _:n3-9.
eudpp:MaterialOfComposition a owl:Class;
    rdfs:comment "Material the product (or component) is made of [ESPR Annex I]. Material as an element of composition."@en;
    rdfs:label "Material of composition"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/MAT".
_:n3-9 rdf:first eudpp:Product;
    rdf:rest rdf:nil.
eudpp:SubstanceOfConcern a owl:Class;
    rdfs:comment "A substance that: (a) meets the criteria laid down in Article 57 of Regulation (EC) No 1907/2006 and is identified in accordance with Article 59(1) of that Regulation; (b) is classified in Part 3 of Annex VI to Regulation (EC) No 1272/2008 in one of the following hazard classes or hazard categories: (i) carcinogenicity categories 1 and 2; (ii) germ cell mutagenicity categories 1 and 2; (iii) reproductive toxicity categories 1 and 2; (iv) endocrine disruption for human health categories 1 and 2; (v) endocrine disruption for the environment categories 1 and 2; (vi) persistent, mobile and toxic or very persistent, very mobile properties; (vii) persistent, bioaccumulative and toxic or very persistent, very bioaccumulative properties; (viii) respiratory sensitisation category 1; (ix) skin sensitisation category 1; (x) hazardous to the aquatic environment — categories chronic 1 to 4; (xi) hazardous to the ozone layer; (xii) specific target organ toxicity — repeated exposure categories 1 and 2; (xiii) specific target organ toxicity — single exposure categories 1 and 2; (c) is regulated under Regulation (EU) 2019/1021; or (d) negatively affects the reuse and recycling of materials in the product in which it is present."@en;
    rdfs:label "Substance of concern"@en;
    dcterms:references "ESPR Article 2(27)"@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    rdfs:subClassOf eudpp:Substance;
    eudpp:sourceStatus "direct legal definition reproduced from the cited legislation."@en.
eudpp:hasActorRoleAssignment a owl:ObjectProperty;
    rdfs:comment "Links an event to an actor-role assignment that is valid in the context of that event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.\n\nESPREvent is modelled in the EU DPP CO EVENT module.\nActorRoleAssignment is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has actor role assignment"@en;
    rdfs:domain eudpp:ESPREvent;
    rdfs:range eudpp:ActorRoleAssignment;
    owl:inverseOf eudpp:isActorRoleAssignmentForEvent.
eudpp:isActorRoleAssignmentForEvent a owl:ObjectProperty;
    rdfs:comment "Links an actor-role assignment to the event context in which the role assignment applies. This is the inverse of evt:hasActorRoleAssignment and is managed in the Connector/mapping layer.\n\nESPREvent is modelled in the EU DPP CO EVENT module.\nActorRoleAssignment is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "is actor role assignment for event"@en;
    rdfs:domain eudpp:ActorRoleAssignment;
    rdfs:range eudpp:ESPREvent.
eudpp:ESPREvent a owl:Class;
    rdfs:comment "Abstract superclass introduced for modelling purposes. Used to represent the regulatory or business semantics of an event relevant in the ESPR context and concerning either a product or its DPP, independently of its technical journalisation."@en;
    rdfs:label "ESPR Event"@en;
    dcterms:identifier "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    dcterms:source "Regulation (EU) 2024/1781; lifecycle-event-oriented abstraction introduced for modelling purposes."@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/EVENT".
eudpp:hasAuthorisedRepresentative a owl:ObjectProperty;
    rdfs:comment "Specifies the natural or legal person established within the Union who has received a written mandate from a manufacturer to act on his behalf in relation to the Declaration of Conformity.\n\nEUDeclarationOfConformity is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module.\n\nSource: \nDecision No 768/2008/EC Annex I Art R1 (4)\nhttps://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I\n\nESPR Annex V (2,9)\nhttps://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V"@en;
    rdfs:label "has authorised representative"@en;
    dcterms:references "Decision No 768/2008/EC Annex I Art R1 (4)", "ESPR Annex V (2,9)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V", "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I";
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:Actor.
eudpp:EUDeclarationOfConformity a owl:Class;
    rdfs:comment "The EU Declaration of Conformity shall state that the fulfilment of the ecodesign requirements specified in the applicable delegated acts adopted pursuant to ESPR Article 4 has been demonstrated or that a presumption of conformity applies in accordance with ESPR Article 41."@en;
    rdfs:label "EU Declaration of Conformity"@en;
    dcterms:source "Decision No 768/2008/EC Annex I Art R10, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I"@en, "ESPR Art 44, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/COMP";
    rdfs:subClassOf eudpp:DocumentFormattedProperty, owl:Thing.
eudpp:hasBackUpCopyHost a owl:ObjectProperty;
    rdfs:comment "The reference of the digital product passport service provider hosting the back-up copy of the digital product passport [ESPR Annex III].\n\nDPP is modelled in the EU DPP CO P_DPP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has back-up-copy host"@en;
    dcterms:references "ESPR Annex III";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:DPP;
    rdfs:range eudpp:Actor.
eudpp:hasConcentration a owl:ObjectProperty;
    rdfs:comment "Links a substance presence to concentration information. A concentration is contextual to the structural location identified by the associated SubstancePresence. \n\nDifferent product, component, or spare-part locations requiring different concentrations should normally use distinct SubstancePresence records. \n\nExact, maximum, and range representations remain distinguished by the existing P_DPP/SOC concentration model.\n\nConcentrationOfSubstanceOfConcern is modelled in the EU DPP CO P_DPP module.\nSubstancePresence is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "has concentration"@en;
    rdfs:domain eudpp:SubstancePresence;
    rdfs:range eudpp:ConcentrationOfSubstanceOfConcern.
eudpp:SubstancePresence a owl:Class;
    rdfs:comment "A contextual relation entity representing the presence of a substance in relation to a product as placed on the market, including a product, component or spare part. It enables product-dependent location, concentration and instruction information to be represented without treating those data as intrinsic characteristics of the substance itself or classifying the presence as a product property. In the CORE profile the modelling pattern is one SubstancePresence per reported location when different locations require different concentrations; sector-specific extensions may provide explicit reference bases for several calculation perspectives. This class is an ontology modelling abstraction supporting ESPR Article 7(5), rather than a term explicitly defined by the Regulation."@en;
    rdfs:label "Substance presence"@en;
    dcterms:references "ESPR Article 7(5)(a)–(e)"@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>, "https://w3id.org/eudpp/SOC";
    eudpp:sourceStatus "ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation."@en.
eudpp:ConcentrationOfSubstanceOfConcern a owl:Class;
    rdfs:comment "The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)"@en;
    rdfs:label "Concentration of the substance of concern"@en;
    dcterms:references "ESPR Art 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP>;
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:hasDigitalProductPassportId a owl:ObjectProperty;
    rdfs:comment "Realisation for the Unique identifier of an instance of the digital product passport.\n\nDPP is modelled in the EU DPP CO P_DPP module.\nDPPIdentifier is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "has digital product passport id"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range eudpp:DPPIdentifier.
eudpp:DPPIdentifier a owl:Class;
    rdfs:comment "A type of identifier to identify DPP. DPP Identifier."@en;
    rdfs:label "DPP identifier"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/IDENT";
    rdfs:subClassOf eudpp:Identifier, _:n3-57;
    owl:disjointWith eudpp:MaterialIdentifier, eudpp:SubstanceIdentifier, eudpp:FacilityIdentifier, eudpp:ProductIdentifier, eudpp:SoCIdentifier.
eudpp:hasEUDeclarationOfConformity a owl:ObjectProperty;
    rdfs:comment "Specifies the EU declaration of conformity issued for the product.\n\nEUDeclarationOfConformity is modelled in the EU DPP CO COMP module.\nProduct is modelled in the EU DPP CO P_DPP module."@en;
    rdfs:label "has EU Declaration of Conformity"@en;
    dcterms:references "Decision No 768/2008/EC Annex I Art R10", "ESPR Art 44";
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I", "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44";
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:EUDeclarationOfConformity.
eudpp:hasEconomicOperator a owl:ObjectProperty;
    rdfs:comment "Linking the product to the economic operator (Actor from ACTOR module).\n\nProduct is modelled in the EU DPP CO P_DPP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has economic operator"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:Actor.
eudpp:hasFacility a owl:ObjectProperty;
    rdfs:comment "Links a product to a facility.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nFacility is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has facility"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:Facility.
eudpp:hasIssuer a owl:ObjectProperty;
    rdfs:comment "Linking DPP with its issuer (Actor from ACTOR module).\n\nDPP is modelled in the EU DPP CO P_DPP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has issuer"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range eudpp:Actor.
eudpp:hasLCAStudy a owl:ObjectProperty;
    rdfs:comment "A product has a LCA Study -- a measurable outcome of a life cycle assessment, representing the quantified effect of a product.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nLCAStudy is modelled in the EU DPP CO LCA module."@en;
    rdfs:label "has LCA study"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:LCAStudy.
eudpp:LCAStudy a owl:Class;
    rdfs:comment "A life-cycle assessment study of a product, conducted per ISO 14040/14044, producing one or more LCA results. The general study container, applicable to any product whether or not the study follows EN 15804+A2. \nCarries study-level metadata (UUID, dataset version, name, reference year, license, copyright, ILCD format version, compliance declarations, manufacturer records, reviews, references to data sources / background databases / PEFCR, etc.). \nCross-module link from a product to this class is provided by the Connector property eudpp:hasLCAStudy."@en;
    rdfs:label "LCA Study"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/LCA>;
    eudpp:sourceVocabulary "LCA ontology"@en, "LCAnet: relates to the element LcaModel (https://w3id.org/lcanet/core#LcaModel) of the Core module, which represents an LCA instance."@en.
eudpp:hasLCAVerifier a owl:ObjectProperty;
    rdfs:comment "Links a review to the independent, third-party actor responsible for validating the Life Cycle Assessment (LCA) or Environmental Product Declaration (EPD).\n\nVerifier means a person or organisation that carries out the independent verification of an EPD or LCA study, i.e. confirms through objective evidence that the specified requirements are fulfilled, e.g. the PCR and EN 15804+A2. It also covers the critical reviewer of an LCA study and the verifier of a PEF study. Independent verification may be internal or external; EPDs for business-to-consumer communication require third-party verification, also comparative assertions under ISO 14040 and any comparisons under the European Commission’s ILCD Handbook. The type of verification is recorded on the Review (TypeOfReview). ILCD: reviewer (1-3-20-87); [ISO 14025:2006, 3.8, adapted]\n\nReview is modelled in the EU DPP CO LCA module. \nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has LCA verifier"@en;
    dcterms:references "ISO 14025:2026, 9 and 10.4; ISO 14025:2006, 3.8 and 3.9; ISO 14044:2006, 6; EN 15804:2012+A2:2019, 7.1, Table 2";
    dcterms:source "https://www.iso.org/standard/87610.html";
    rdfs:domain eudpp:Review;
    rdfs:range eudpp:Actor.
eudpp:Review a owl:Class;
    rdfs:comment "A verification / critical review performed on an LCA study or EPD study."@en;
    rdfs:label "Review"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/LCA>;
    rdfs:subClassOf <http://www.w3.org/ns/prov#Activity>;
    rdfs:seeAlso <https://indatawg.github.io/ILCD-EPD-Data-Format/doc/>;
    eudpp:sourceVocabulary "ILCD base: corresponds to the element validation/review."@en.
eudpp:hasManufacturer a owl:ObjectProperty;
    rdfs:comment "A product has a manufacturer (Actor from ACTOR module).\n\nProduct is modelled in the EU DPP CO P_DPP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has manufacturer"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:Actor.
eudpp:hasManufacturingSite a owl:ObjectProperty;
    rdfs:comment "Links a manufacturer record to the facility it applies to, e.g., a production site covered by an LCA study or EPD. ILCD+EPD v1.3: manufacturer/sites/site.\n\nManufacturerRecord is modelled in the EU DPP CO LCA module.\nFacility is modelled in the EU DPP CO ACTOR module.\n        "@en;
    rdfs:label "has manufacturing site"@en;
    rdfs:domain eudpp:ManufacturerRecord;
    rdfs:range eudpp:Facility.
eudpp:ManufacturerRecord a owl:Class;
    rdfs:comment "A container provenance entity (prov:Entity) documenting the involvement of a manufacturer (and optionally a data provider) in a specific LCA study, including the facility concerned and whether primary LCA data was provided."@en;
    rdfs:label "Manufacturer Record"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/LCA>;
    rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element epd24:manufacturer inside epd24:manufacturers."@en.
eudpp:hasMaterial a owl:ObjectProperty;
    rdfs:comment "Linking the Product to a MaterialOfComposition.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nMaterialOfComposition is modelled in the EU DPP CO MAT module."@en;
    rdfs:label "has material"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:MaterialOfComposition.
eudpp:hasMaterialIdentifier a owl:ObjectProperty;
    rdfs:comment "Realisation of the material identifier as \"Product parameters: identification of  ... materials [ESPR Annex I c)]\"\n\nMaterialOfComposition is modelled in the EU DPP CO MAT module.\nMaterialIdentifier is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "has material identifier"@en;
    rdfs:domain eudpp:MaterialOfComposition;
    rdfs:range eudpp:MaterialIdentifier.
eudpp:MaterialIdentifier a owl:Class;
    rdfs:comment "A type of identifier to identify materials. A unique code assigned to Material based on a scheme."@en;
    rdfs:label "Material identifier"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/IDENT";
    rdfs:subClassOf eudpp:Identifier, _:n3-59, _:n3-60;
    owl:disjointWith eudpp:SubstanceIdentifier, eudpp:ProductIdentifier, eudpp:SoCIdentifier.
eudpp:hasNotifiedBody a owl:ObjectProperty;
    rdfs:comment "Specifies the conformity assessment body notified in accordance with ESPR Chapter IX\t\n\nEUDeclarationOfConformity is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has notified body"@en;
    dcterms:references "Decision No 768/2008/EC Annex I Chapter R4", "ESPR Chapter IX";
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I", "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#cpt_IX";
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:Actor.
eudpp:hasProductStatus a owl:ObjectProperty;
    rdfs:comment "Links a Product to its current lifecycle status, as declared in its DPP.\nIt gives the current status only; the history of changes is represented with the events. \nProduct status is distinct from DPP status (#dppStatus), i.e., the status of the passport.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nProductStatus is modelled in the EU DPP CO EVENT module."@en;
    rdfs:label "has product status"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:ProductStatus.
eudpp:ProductStatus a owl:Class;
    rdfs:comment "Represents the current lifecycle status of a product."@en;
    rdfs:label "Product Status"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/EVENT".
eudpp:hasResponsibleManufacturer a owl:ObjectProperty;
    rdfs:comment "Defines the natural or legal person responsible for the EU declaration of conformity.\n\n\nEUDeclarationOfConformity is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "has responsible manufacturer"@en;
    dcterms:references "ESPR Annex V (2,9)", "Decision No 768/2008/EC Annex I Art R1 (3)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V", "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I";
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:Actor.
eudpp:hasSubstanceIdentifier a owl:ObjectProperty;
    rdfs:comment "Substance to an IDENT-owned SubstanceIdentifier link.\n\nSubstance is modelled in the EU DPP CO SOC module.\nSubstanceIdentifier is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "has substance identifier"@en;
    rdfs:domain eudpp:Substance;
    rdfs:range eudpp:SubstanceIdentifier.
eudpp:Substance a owl:Class;
    rdfs:comment "A chemical substance used as the generic superclass for substance identity and naming information. In this SOC module it primarily supports the modelling of dpp:SubstanceOfConcern; its presence does not make SOC a general-purpose substance-reporting module."@en;
    rdfs:label "Substance"@en;
    dcterms:references "REACH Article 3(1)"@en;
    dcterms:source <http://data.europa.eu/eli/reg/2006/1907/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>, "https://w3id.org/eudpp/SOC";
    eudpp:sourceStatus "direct legal definition reproduced from the cited legislation."@en.
eudpp:SubstanceIdentifier a owl:Class;
    rdfs:comment "A type of identifier to identify substances. A unique code assigned to substance based on a scheme."@en;
    rdfs:label "substance identifier"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/IDENT";
    rdfs:subClassOf eudpp:Identifier, _:n3-69, _:n3-70.
eudpp:hasSubstancePresence a owl:ObjectProperty;
    rdfs:comment "Relation from Product to contextual SubstancePresence.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nSubstancePresence is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "has substance presence"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:SubstancePresence;
    owl:inverseOf eudpp:isSubstancePresenceOf.
eudpp:isSubstancePresenceOf a owl:ObjectProperty;
    rdfs:comment "Inverse relation from SubstancePresence to Product.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nSubstancePresence is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "is substance presence of"@en;
    rdfs:domain eudpp:SubstancePresence;
    rdfs:range eudpp:Product.
eudpp:hasUniqueFacilityIdentifier a owl:ObjectProperty;
    rdfs:comment "Linking a Facility to its unique facility identifier.\nFacility is modelled in the EU DPP CO ACTOR module.\nFacilityIdentifier is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "has unique facility identifier"@en;
    dcterms:references "ESPR Art 2 (33)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:Facility;
    rdfs:range eudpp:FacilityIdentifier.
eudpp:FacilityIdentifier a owl:Class;
    rdfs:comment "A unique code assigned to a physical site (factory, warehouse, plant, school, hospital, etc.), i.e., identifies a location."@en;
    rdfs:label "Facility identifier"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/IDENT>;
    rdfs:subClassOf eudpp:Identifier, _:n3-58;
    owl:disjointWith eudpp:MaterialIdentifier, eudpp:SubstanceIdentifier, eudpp:ProductIdentifier, eudpp:SoCIdentifier.
eudpp:hasUniqueOperatorIdentifier a owl:ObjectProperty;
    rdfs:comment "Linking an Actor to their unique operator identifier. \nActor is modelled in the EU DPP CO ACTOR module.\nActorIdentifier is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "has unique operator identifier"@en;
    dcterms:references "ESPR Art 2 (31)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:Actor;
    rdfs:range eudpp:ActorIdentifier.
eudpp:ActorIdentifier a owl:Class;
    rdfs:comment "A type of identifier to identify Actors. A unique code assigned to Actor based on a scheme."@en;
    rdfs:label "Actor identifier"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/IDENT>;
    rdfs:subClassOf eudpp:Identifier, _:n3-55, _:n3-56;
    owl:disjointWith eudpp:DPPIdentifier, eudpp:MaterialIdentifier, eudpp:SubstanceIdentifier, eudpp:FacilityIdentifier, eudpp:ProductIdentifier, eudpp:SoCIdentifier.
eudpp:hasUniqueProductIdentifier a owl:ObjectProperty;
    rdfs:comment "Realisation of the uniqueProductIdentifier.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nProductIdentifier is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "has unique product identifier"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:ProductIdentifier.
eudpp:ProductIdentifier a owl:Class;
    rdfs:comment "A type of identifier to identify Products. A unique code assigned to identify a product. e.g., GTIN."@en;
    rdfs:label "Product identifier"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/IDENT";
    rdfs:subClassOf eudpp:Identifier, _:n3-61, _:n3-62, _:n3-63;
    owl:disjointWith eudpp:SubstanceIdentifier, eudpp:SoCIdentifier.
eudpp:identifiesDataProvider a owl:ObjectProperty;
    rdfs:comment "Identifies the entity that supplied or submitted the inventory data for this record, which may be different from the manufacturer (e.g., an industry association, a consultant, or a consortium lead for an average EPD).\n\nManufacturerRecord is modelled in the EU DPP CO LCA module.\nActor is modelled in the EU DPP CO ACTOR module.\n        "@en;
    rdfs:label "identifies data provider"@en;
    rdfs:domain eudpp:ManufacturerRecord;
    rdfs:range eudpp:Actor.
eudpp:identifiesManufacturer a owl:ObjectProperty;
    rdfs:comment "Identifies the specific economic operator or manufacturing company whose production process and product are represented by this manufacturer record.\n\nManufacturerRecord is modelled in the EU DPP CO LCA module.\nActor is modelled in the EU DPP CO ACTOR module.\n        "@en;
    rdfs:label "identifies manufacturer"@en;
    rdfs:domain eudpp:ManufacturerRecord;
    rdfs:range eudpp:Actor.
eudpp:inContextOfDPP a owl:ObjectProperty;
    rdfs:comment "Relates the actor role assignment to a specific Digital Product Passport instance (from P_DPP module).\n\nActorRoleAssignment is modelled in the EU DPP CO ACTOR module.\nDPP is modelled in the EU DPP CO P_DPP module.\n        "@en;
    rdfs:label "in context of DPP"@en;
    rdfs:domain eudpp:ActorRoleAssignment;
    rdfs:range eudpp:DPP.
eudpp:inContextOfProduct a owl:ObjectProperty;
    rdfs:comment "Relates the actor role assignment to a specific product (from P_DPP module).\n\nActorRoleAssignment is modelled in the EU DPP CO ACTOR module.\nProduct is modelled in the EU DPP CO P_DPP module."@en;
    rdfs:label "in context of product"@en;
    rdfs:domain eudpp:ActorRoleAssignment;
    rdfs:range eudpp:Product.
eudpp:isConformWith a owl:ObjectProperty;
    rdfs:comment "Specifies Union Harmonised Legislation for which conformity of the product is stated."@en;
    rdfs:label "is conform with"@en;
    rdfs:domain eudpp:Product.
eudpp:isConnectedTo a owl:ObjectProperty;
    rdfs:comment "A DPP is connected to a facility.\n\nDPP is modelled in the EU DPP CO P_DPP module.\nFacility is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "is connected to"@en;
    rdfs:domain eudpp:DPP;
    rdfs:range eudpp:Facility.
eudpp:isIssuedBy a owl:ObjectProperty;
    rdfs:comment "Specifies the natural or legal person issuing the Declaration of Conformity; ESPR Annex V, paragraph 3 requirement: \"This declaration of conformity is issued under the sole responsibility of the manufacturer:\"\n\n\nEUDeclarationOfConformity is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "issued by"@en;
    dcterms:references "ESPR Annex V (3)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V";
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:Actor.
eudpp:isLocatedInProduct a owl:ObjectProperty;
    rdfs:comment "Location of a substance presence in a product, component or spare part, connection between substance presence and product.\n\nProduct is modelled in the EU DPP CO P_DPP module.\nSubstancePresence is modelled in the EU DPP CO IDENT module."@en;
    rdfs:label "is located in product"@en;
    rdfs:domain eudpp:SubstancePresence;
    rdfs:range eudpp:Product.
eudpp:isNotifiedFor a owl:ObjectProperty;
    rdfs:comment "Specifies the conformity assessment activities, the conformity assessment module or modules and product or products concerned and the relevant attestation of competence\t\n\nUnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "is notified for"@en;
    dcterms:references "Decision No 768/2008/EC Annex I Art R23 (3)", "ESPR Article 56 (3)";
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I", "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_56";
    rdfs:domain eudpp:Actor;
    rdfs:range eudpp:UnionHarmonisationLegislation.
eudpp:isSignedBy a owl:ObjectProperty;
    rdfs:comment "Specifies the natural or legal person signing the Declaration of Conformity.\n\n\nEUDeclarationOfConformity is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "is signed by"@en;
    dcterms:references "ESPR Annex V (9, 10)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V";
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:Actor.
eudpp:issuesCertificate a owl:ObjectProperty;
    rdfs:comment "Specifies conformity assessment certificate issued for a certification.\n\n\nConformityCertificate is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "issues certificate"@en;
    dcterms:references "ESPR Annex V (7)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V";
    rdfs:domain eudpp:Actor;
    rdfs:range eudpp:ConformityCertificate.
eudpp:ConformityCertificate a owl:Class;
    rdfs:comment "Conformity assessment certificate for a certification. The blue guide uses the term \"cerficate of conformity\". The ESPR uses \"conformity certificate\" as well as \"certificate\" and \"approval decision\"."@en;
    rdfs:label "Conformity Certificate"@en;
    dcterms:source "Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4, https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001"@en, "ESPR Annex III (e)"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/COMP".
eudpp:performedAssessmentAccordingTo a owl:ObjectProperty;
    rdfs:comment "Specifies conformity assessment procedure/certification scheme performed by the notified body.\n\n\nConformityAssessmentModule is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "performed assessment according to"@en;
    dcterms:references "ESPR Annex V (7)";
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V";
    rdfs:domain eudpp:Actor;
    rdfs:range eudpp:ConformityAssessmentModule.
eudpp:ConformityAssessmentModule a owl:Class;
    rdfs:comment "Conformity Assessment module means the possible conformity assessment elements that can be chosen, in accordance with certain criteria, to fullfill the conformity accessement required to be performed by Community harmonisation legislation in respect of a particular product."@en;
    rdfs:label "Conformity Assessment Module"@en;
    dcterms:source "Decision No 768/2008/EC Art 4, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4"@en, "ESPR Art 43, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43"@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/COMP".
eudpp:performedAt a owl:ObjectProperty;
    rdfs:comment "Links a product event to the facility where the event was performed or operationally occurred. This is a cross-module relation between EVENT and ACTOR/Facility and is therefore managed in the Connector/mapping layer.\n\nProductEvent is modelled in the EU DPP CO EVENT module.\nFacility is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "performed at"@en;
    rdfs:domain eudpp:ProductEvent;
    rdfs:range eudpp:Facility;
    rdfs:seeAlso <https://ref.gs1.org/epcis/bizLocation>, <https://ref.gs1.org/epcis/readPoint>.
<https://ref.gs1.org/epcis/bizLocation> a owl:ObjectProperty;
    rdfs:comment "(Optional) The business location where the objects associated with the EPCs may be found, until contradicted by a subsequent event."@en;
    rdfs:label "bizLocation";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://ref.gs1.org/epcis/readPoint> a owl:ObjectProperty;
    rdfs:comment "(Optional) The read point at which the event took place."@en;
    rdfs:label "readPoint";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
eudpp:performedBy a owl:ObjectProperty;
    rdfs:comment "Links a product event to the actor that performed, carried out, or was operationally responsible for the event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.\n\nProductEvent is modelled in the EU DPP CO EVENT module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "performed by"@en;
    rdfs:domain eudpp:ProductEvent;
    rdfs:range eudpp:Actor;
    rdfs:seeAlso eudpp:ActorRoleAssignment.
eudpp:recordedBy a owl:ObjectProperty;
    rdfs:comment "Links a DPP event record to the actor that created the technical record of the logged DPP-side event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.\n\nDPPEventRecord is modelled in the EU DPP CO EVENT module.\nActor is modelled in the EU DPP CO ACTOR module."@en;
    rdfs:label "recorded by"@en;
    rdfs:domain eudpp:DPPEventRecord;
    rdfs:range eudpp:Actor.
eudpp:DPPEventRecord a owl:Class;
    rdfs:comment "A technical audit record used to represent and log an information-level event affecting a Digital Product Passport. Unlike EPCIS carriers, this class is intended for recording DPP-side information events rather than product-facing operational events."@en;
    rdfs:label "DPP Event Record"@en;
    dcterms:source "Defined in the EU DPP Core Ontology Event module to support the technical recording of DPP-related events."@en;
    rdfs:isDefinedBy "https://w3id.org/eudpp/EVENT";
    rdfs:subClassOf _:n3-40, _:n3-41, _:n3-42, _:n3-43, _:n3-44.
eudpp:representsManufacturerForProduct a owl:ObjectProperty;
    rdfs:comment "Indicates which product(s) the authorised representative's mandate covers.\n\nAuthorisedRepresentativeRoleAssignment is modelled in the EU DPP CO ACTOR module.\nProduct is modelled in the EU DPP CO P_DPP module."@en;
    rdfs:label "represents manufacturer for product"@en;
    rdfs:domain eudpp:AuthorisedRepresentativeRoleAssignment;
    rdfs:range eudpp:Product.
eudpp:DigitalInstruction a owl:Class;
    rdfs:comment "Digital instructions\nmean instructions in digital format concerning the product (‘digital instructions’) in a language that can be easily understood. ESPR Art 27(7)\nDigital instructions are ensured by manufacturers. These should also ensured by importers. (ESPR Art 29(4))\n\nThis class can be extended/specialised according to delegated acts or industry standards."@en;
    rdfs:label "DigitalInstruction"@en;
    dcterms:references "ESPR Art 27(7)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP>;
    rdfs:subClassOf eudpp:DocumentFormattedProperty.
eudpp:DocumentFormattedProperty a owl:Class;
    rdfs:comment "The document class describes the semantic representation of any instance of a document that might be required to be included into a digital product passport instance."@en;
    rdfs:label "Document"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP>;
    rdfs:subClassOf eudpp:Property.
eudpp:EPDStudy a owl:Class;
    rdfs:comment "An LCA study that conforms to EN 15804+A2 with EF 3.1 characterisation, i.e. an Environmental Product Declaration. Inherits all study-level metadata from eudpp:LCAStudy (compliance declarations, manufacturer records, reviews, LCA results, etc.) and adds EPD-specific properties: ILCD+EPD format version (eudpp:epdFormatVersion), registration number, expiry date, reference to the published EPD document (eudpp:EPDDocument via referenceToOriginalEPD), reference to the applicable Product Category Rules (eudpp:PCR via referenceToPCR). EN 15804+A2 module values per LCAResult are used to populate per-life-cycle-module values. Replaces v1.9.4's mixed structure and v1.9.5's eudpp:EPDDataSet."@en;
    rdfs:label "EPD Study"@en, "EPD-Studie"@de;
    rdfs:isDefinedBy <https://w3id.org/eudpp/LCA>;
    rdfs:subClassOf eudpp:LCAStudy;
    rdfs:seeAlso <https://indatawg.github.io/ILCD-EPD-Data-Format/doc/>;
    eudpp:sourceVocabulary "ILCD+EPD extension"@en.
eudpp:LCAModuleValue a owl:Class;
    rdfs:comment "One numerical LCA-result value (impact or inventory-indicator) for a specific EN 15804+A2 life-cycle module (A1-A3, A4, ..., D) and optionally a specific scenario. \nIt carries eudpp:amount (the numeric value), eudpp:forLifeCycleModule, optionally eudpp:forScenario, and eudpp:isDeclared (boolean: true if the module is declared with this value; false if the module is explicitly not declared for this indicator)."@en;
    rdfs:label "LCA Module Value"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/LCA>;
    rdfs:subClassOf eudpp:QuantitativeProperty, _:n3-120, _:n3-121, _:n3-122, _:n3-123;
    eudpp:sourceVocabulary "ILCD+EPD extension: corresponds to the element epd:amount inside LCIAResult/other."@en.
eudpp:QuantitativeProperty a owl:Class;
    rdfs:comment "A property (respectively measurand of a property) of the product (model) that is expressed by a quantity value. A specific quantity."@en;
    rdfs:label "Quantitative Property"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/P_DPP>;
    rdfs:subClassOf eudpp:Property.
eudpp:LCAResult a owl:Class;
    rdfs:comment "Abstract class for any LCA computation output of a study. Has three subclasses: \neudpp:LCIAResult (characterised impact result) which applies characterisation factors of an LCIA method, eudpp:InventoryIndicatorResult (aggregated inventory-indicator result) whcih is a sum/aggregation over the inventory without characterisation, and eudpp:EnvironmentalFootprintScoreResult which represents the aggregated EF single score result. \n\nIn the regulatory sense of ESPR Art. 2(24), some characterized individuals of LCAResult constitute environmental footprints — quantifications of environmental impacts of a product throughout its life cycle.Other LCAResult instances, however, fall outside the strict ESPR definition. For this reason, LCAResult is linked to the ESPR \"Environmental Footprint\" concept via skos:broadMatch rather than owl:equivalentClass."@en;
    rdfs:label "LCA Result"@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/LCA>;
    rdfs:subClassOf eudpp:QuantitativeProperty, _:n3-124;
    skos:broadMatch "ESPR Art 2 (24) https://eur-lex.europa.eu/eli/reg/2024/1781/oj#Art2_24"@en;
    eudpp:sourceVocabulary "LCA ontology"@en, "LCAnet: relates to the element LcaResult (https://w3id.org/lcanet/ia#LcaResult) of the IA module."@en.
eudpp:SubstanceManagementInstruction a owl:Class;
    rdfs:comment "An instruction concerning the management of a substance of concern in its SubstancePresence context, including safe use, disassembly, preparation for reuse, reuse, recycling and environmentally sound end-of-life management. This domain-specific modelling abstraction supports the information elements in ESPR Article 7(5)(d)-(e); it is not a term defined by the Regulation and does not determine legal obligations or applicability."@en;
    rdfs:label "Substance management instruction"@en;
    dcterms:references "ESPR Article 7(5)(d)-(e)"@en;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    rdfs:subClassOf eudpp:DigitalInstruction;
    eudpp:sourceStatus "ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation."@en.
vann:preferredNamespaceUri a owl:AnnotationProperty.
<http://schema.org/domainIncludes> a owl:AnnotationProperty.
<http://schema.org/rangeIncludes> a owl:AnnotationProperty.
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> a owl:AnnotationProperty.
<https://ref.gs1.org/epcis/jsonldLabel> a owl:AnnotationProperty.
<https://ref.gs1.org/epcis/jsonldUriLabel> a owl:AnnotationProperty.
<https://ref.gs1.org/epcis/EPCISEvent> a owl:Class;
    rdfs:comment "A logistics event. This is a common superclass (base type) for all EPCIS events. All of the more specific event types are subclasses of EPCISEvent."@en;
    rdfs:label "EPCISEvent";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    owl:disjointWith eudpp:DPPEventRecord;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://ref.gs1.org/epcis/bizStep> a owl:ObjectProperty;
    rdfs:comment "(Optional) The business step of which this event was a part."@en;
    rdfs:label "bizStep";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent>;
    rdfs:range <https://ref.gs1.org/cbv/BizStep>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent>;
    <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/BizStep>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://ref.gs1.org/cbv/BizStep> a owl:Class.
<https://ref.gs1.org/epcis/bizTransactionList> a owl:ObjectProperty;
    rdfs:comment "(Optional) An unordered list of business transactions that define the context of this event."@en;
    rdfs:label "bizTransactionList";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent>;
    rdfs:range <https://ref.gs1.org/epcis/BizTransaction>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent>;
    <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/BizTransaction>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://ref.gs1.org/epcis/BizTransaction> a owl:Class;
    rdfs:comment "Document that describes a particular business transaction. An example is a specific Purchase Order or Despatch Advice. Business Transaction information may be included in EPCIS events to record an event's participation in particular business transactions."@en;
    rdfs:label "BizTransaction";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
    <https://ref.gs1.org/epcis/jsonldUriLabel> "bizTransaction".
<https://ref.gs1.org/epcis/bizTransactionType> a owl:ObjectProperty;
    rdfs:comment "An identifier that indicates the type of BizTransaction document (e.g. Purchase Order, Despatch Advice)."@en;
    rdfs:label "bizTransactionType";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain <https://ref.gs1.org/epcis/BizTransaction>;
    rdfs:range <https://ref.gs1.org/cbv/BTT>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/BizTransaction>;
    <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/BTT>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
    <https://ref.gs1.org/epcis/jsonldLabel> "type".
<https://ref.gs1.org/cbv/BTT> a owl:Class.
<https://ref.gs1.org/epcis/childEPCs> a owl:ObjectProperty;
    rdfs:comment "(Optional) An unordered list of the EPCs of contained objects identified by instance-level identifiers. An AggregationEvent SHALL contain either a nonempty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.  An AssociationEvent SHALL contain either a non-empty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disassociated from the parent."@en;
    rdfs:label "childEPCs";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain _:n3-10;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent>, <https://ref.gs1.org/epcis/AssociationEvent>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
_:n3-10 a owl:Class;
    owl:unionOf _:n3-11.
_:n3-11 rdf:first <https://ref.gs1.org/epcis/AggregationEvent>;
    rdf:rest _:n3-12.
<https://ref.gs1.org/epcis/AggregationEvent> a owl:Class;
    rdfs:comment "The event type AggregationEvent describes events that apply to objects that have been aggregated to one another. In such an event, there is a set of 'contained' objects that have been aggregated within a 'containing' entity that's meant to identify the aggregation itself.  This event type is intended to be used for 'aggregations', meaning an association where there is a strong physical relationship between the containing and the contained objects such that they will all occupy the same location at the same time, until such time as they are disaggregated."@en;
    rdfs:label "AggregationEvent";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
    <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID".
_:n3-12 rdf:first <https://ref.gs1.org/epcis/AssociationEvent>;
    rdf:rest rdf:nil.
<https://ref.gs1.org/epcis/AssociationEvent> a owl:Class;
    rdfs:comment "The event type AssociationEvent describes the association or disassociation of one or several physical objects with a parent object or a specific physical location.  Like the AggregationEvent, the AssociationEvent is also used to capture associations where there is a strong physical relationship between the containing and the contained objects such that they will all occupy the same location at the same time, until such time as they are disaggregated. However, the AggregationEvent does not allow for associations of objects with physical locations;  if action is DELETE while omitting the childEPC and childQuantityList field, all contained children are disaggregated from the containing parent. Because there are situations in which associations are more permanent, i.e. beyond the physical flow of goods (e.g. packing/unpacking and loading/unloading), an AssociationEvent SHOULD be used: (a) when objects need to be associated with a physical location or (b) when the parent object could also be subject to other, more temporary associations (i.e. captured using AggregationEvent)."@en;
    rdfs:label "AssociationEvent";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
    <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID".
<https://ref.gs1.org/epcis/childQuantityList> a owl:ObjectProperty;
    rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) contained objects. An AggregationEvent SHALL contain either a nonempty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.  An AssociationEvent SHALL contain either a non-empty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent."@en;
    rdfs:label "childQuantityList";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain _:n3-13;
    rdfs:range <https://ref.gs1.org/epcis/QuantityElement>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent>, <https://ref.gs1.org/epcis/AssociationEvent>;
    <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
_:n3-13 a owl:Class;
    owl:unionOf _:n3-14.
_:n3-14 rdf:first <https://ref.gs1.org/epcis/AggregationEvent>;
    rdf:rest _:n3-15.
