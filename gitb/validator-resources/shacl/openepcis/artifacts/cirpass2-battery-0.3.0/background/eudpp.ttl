    eudpp:sourceVocabulary "LCA ontology extension";
    eudpp:unitAsString "MJ"@en;
    <https://w3id.org/eudpp/LCA#assessesImpactCategory> eudpp:resourceUseFossil.
eudpp:ind_AP a owl:NamedIndividual, eudpp:EN15804ImpactIndicator;
    rdfs:comment "Acidification accumulated exceedance, in mol H+-equivalent. Core EN 15804+A2 impact indicator (note: unit change versus EN 15804+A1, which used kg SO2-eq)."@en;
