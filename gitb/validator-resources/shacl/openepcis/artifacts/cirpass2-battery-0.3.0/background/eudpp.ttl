    skos:altLabel "Resource use, minerals and metals"@en;
    eudpp:sourceVocabulary "LCA ontology extension";
    eudpp:unitAsString "kg Sb-eq"@en;
    <https://w3id.org/eudpp/LCA#assessesImpactCategory> eudpp:resourceUseMineralsMetals.
eudpp:ind_ADPF a owl:NamedIndividual, eudpp:EN15804ImpactIndicator;
    rdfs:comment "Abiotic depletion potential for fossil resources, in MJ (net calorific value). Core EN 15804+A2 impact indicator."@en;
