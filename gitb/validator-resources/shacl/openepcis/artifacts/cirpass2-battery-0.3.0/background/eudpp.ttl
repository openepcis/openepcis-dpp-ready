eudpp:ind_EEE a owl:NamedIndividual, eudpp:EN15804InventoryIndicator;
    rdfs:comment "Exported electrical energy, in MJ per energy carrier. EN 15804+A2 inventory indicator (output flow - exported energy)."@en;
    rdfs:label "EEE - Exported electrical energy"@en;
    skos:altLabel "EEE"@en;
