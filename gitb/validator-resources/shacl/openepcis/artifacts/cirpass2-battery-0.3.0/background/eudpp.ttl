    <https://w3id.org/eudpp/LCA#relatesToLCAIndicator> eudpp:ind_EF_acidification;
    eudpp:belongsToEn15804Group eudpp:group_coreImpact.
eudpp:ind_EF_acidification a owl:NamedIndividual, eudpp:LCIAImpactIndicator;
    rdfs:comment "Accumulated exceedance, in mol H+-equivalent. EF 3.1 / PEF impact category."@en;
    rdfs:label "Acidification EF"@en;
    skos:altLabel "Acidification"@en;
    eudpp:sourceVocabulary "LCA ontology extension";
    eudpp:unitAsString "mol H+-eq"@en;
    <https://w3id.org/eudpp/LCA#assessesImpactCategory> eudpp:acidification.
eudpp:ind_CRU a owl:NamedIndividual, eudpp:EN15804InventoryIndicator;
    rdfs:comment "Components for re-use, in kg. EN 15804+A2 inventory indicator (output flow - valorisation)."@en;
    rdfs:label "CRU - Components for re-use"@en;
    skos:altLabel "CRU"@en;
