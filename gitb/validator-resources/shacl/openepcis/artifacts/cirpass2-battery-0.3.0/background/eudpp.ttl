eudpp:ind_EET a owl:NamedIndividual, eudpp:EN15804InventoryIndicator;
    rdfs:comment "Exported thermal energy, in MJ per energy carrier. EN 15804+A2 inventory indicator (output flow - exported energy)."@en;
