<https://ref.gs1.org/epcis/sourceOrDestination> a owl:ObjectProperty;
    rdfs:comment "An identifier that denotes the specific source or destination of a business transfer.\nThe semantic role of the identifier is indicated by sourceOrDestinationType. Resolution of that identifier to EU DPP Actor or Facility concepts, when applicable, is handled outside the EPCIS technical carrier layer."@en;
    rdfs:label "sourceOrDestination";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain <https://ref.gs1.org/epcis/SourceOrDestination>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/SourceOrDestination>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
    <https://ref.gs1.org/epcis/jsonldLabel> "destination", "source".
<https://ref.gs1.org/epcis/sourceOrDestinationType> a owl:ObjectProperty;
    rdfs:comment "An identifier that indicates the role of SourceOrDestination in a transfer (Owning Party, Possessing Party, or Location).\nThis role determines how the corresponding sourceOrDestination identifier is interpreted. Mapping to EU DPP Actor or Facility concepts, when applicable, is handled outside the EPCIS technical carrier layer."@en;
    rdfs:label "sourceOrDestinationType";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain <https://ref.gs1.org/epcis/SourceOrDestination>;
    rdfs:range <https://ref.gs1.org/cbv/SDT>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/SourceOrDestination>;
    <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/SDT>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
    <https://ref.gs1.org/epcis/jsonldLabel> "type".
<https://ref.gs1.org/cbv/SDT> a owl:Class.
<https://ref.gs1.org/epcis/transformationID> a owl:ObjectProperty;
    rdfs:comment "(Optional) Associates several TransformationEvents with a longer-running Transformation process, therefore linking them together."@en;
    rdfs:label "transformationID";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent>;
    rdfs:range <https://ref.gs1.org/epcis/Transformation>;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent>;
    <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/Transformation>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://ref.gs1.org/epcis/Transformation> a owl:Class;
    rdfs:comment "A transformation business processes that takes a longer period of time than a single TransformationEvent, so is associated with a series of such events.\nWhen events share the same Transformation, the meaning is that the inputs to any of those events may have contributed in some way to each of the outputs in any of those same events."@en;
    rdfs:label "Transformation";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
eudpp:hasDPPActionType a owl:ObjectProperty;
    rdfs:comment "Links a DPP update event to the type of information-level action performed on the Digital Product Passport."@en;
    rdfs:label "has DPP action type"@en;
    rdfs:domain eudpp:DPPUpdateEvent;
    rdfs:range eudpp:DPPActionType.
eudpp:DPPUpdateEvent a owl:Class;
    rdfs:comment "An event corresponding to an update of the content of a Digital Product Passport."@en;
    rdfs:label "DPP Update Event"@en;
    rdfs:subClassOf eudpp:DPPEvent, _:n3-45.
eudpp:DPPActionType a owl:Class;
    rdfs:comment "A classification indicating the type of information-level action performed during a DPP update event."@en;
    rdfs:label "DPP Action Type"@en;
    owl:equivalentClass _:n3-34.
eudpp:hasProductEvent a owl:ObjectProperty;
    rdfs:comment "Links an EPCIS-inspired technical event carrier to the product event semantics it journalises."@en;
    rdfs:label "has product event"@en;
    rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent>;
    rdfs:range eudpp:ProductEvent;
    owl:inverseOf eudpp:isRepresentedByCarrier.
eudpp:isRepresentedByCarrier a owl:ObjectProperty;
    rdfs:comment "Links a product event concept to an EPCIS-inspired technical event carrier used to journalise and structure the corresponding event data."@en;
    rdfs:label "is represented by carrier"@en;
    rdfs:domain eudpp:ProductEvent;
    rdfs:range <https://ref.gs1.org/epcis/EPCISEvent>.
eudpp:isRecordedAs a owl:ObjectProperty;
    rdfs:comment "Links a DPP event to a technical audit record representing its registration in an information system or audit trail."@en;
    rdfs:label "is recorded as"@en;
    rdfs:domain eudpp:DPPEvent;
    rdfs:range eudpp:DPPEventRecord.
eudpp:isTriggeredByProductEvent a owl:ObjectProperty;
    rdfs:comment "Links a DPP event to the product event that caused or required it. This property is used when the DPP event results from a lifecycle change affecting the product."@en;
    rdfs:label "is triggered by product event"@en;
    rdfs:domain eudpp:DPPEvent;
    rdfs:range eudpp:ProductEvent.
eudpp:recordsDPPEvent a owl:ObjectProperty;
    rdfs:comment "Links a DPP event record to the DPP event whose technical registration it captures."@en;
    rdfs:label "records DPP event"@en;
    rdfs:domain eudpp:DPPEventRecord;
    rdfs:range eudpp:DPPEvent;
    owl:inverseOf eudpp:isRecordedAs.
eudpp:triggersDPPEvent a owl:ObjectProperty;
    rdfs:comment "Links a product event to a DPP event that is triggered as a consequence of it, reflecting the obligation to update the DPP following lifecycle changes of the product."@en;
    rdfs:label "triggers DPP event"@en;
    rdfs:domain eudpp:ProductEvent;
    rdfs:range eudpp:DPPEvent;
    owl:inverseOf eudpp:isTriggeredByProductEvent.
<https://ref.gs1.org/epcis/action> a owl:DatatypeProperty;
    rdfs:comment "How this event relates to the lifecycle of the EPCs named in this event."@en;
    rdfs:label "action";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain _:n3-26;
    rdfs:range xsd:string;
    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent>, <https://ref.gs1.org/epcis/AssociationEvent>, <https://ref.gs1.org/epcis/ObjectEvent>, <https://ref.gs1.org/epcis/TransactionEvent>;
    <http://schema.org/rangeIncludes> xsd:string;
    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
_:n3-26 a owl:Class;
    owl:unionOf _:n3-27.
_:n3-27 rdf:first <https://ref.gs1.org/epcis/AggregationEvent>;
    rdf:rest _:n3-28.
_:n3-28 rdf:first <https://ref.gs1.org/epcis/AssociationEvent>;
    rdf:rest _:n3-29.
