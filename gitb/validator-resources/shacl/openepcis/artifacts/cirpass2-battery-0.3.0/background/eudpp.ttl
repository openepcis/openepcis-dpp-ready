<https://ref.gs1.org/epcis/epcList> a owl:ObjectProperty;
    rdfs:comment "(Optional) An unordered list of one or more EPCs naming specific objects to which the event pertained."@en;
    rdfs:label "epcList";
    rdfs:isDefinedBy <https://ref.gs1.org/epcis/>;
    rdfs:domain _:n3-16;
