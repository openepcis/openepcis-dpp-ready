    rdfs:domain eudpp:ConcentrationRange;
    rdfs:range xsd:decimal;
    eudpp:sourceStatus "ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation."@en.
eudpp:qualificationNote a owl:DatatypeProperty;
    rdfs:comment "Additional explanation or limitation of the qualification assertion."@en;
    rdfs:label "qualification note"@en;
    dcterms:references "Qualification assertion metadata."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/SOC>;
    rdfs:domain eudpp:SoCQualificationAssertion;
