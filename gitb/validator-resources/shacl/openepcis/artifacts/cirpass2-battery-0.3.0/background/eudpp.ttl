    rdfs:label "module B"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleC a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module C\n\nConformity to type based on internal production control"@en;
    rdfs:label "module C"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleC1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module C1\n\nConformity to type based on internal production control plus supervised product testing"@en;
    rdfs:label "module C1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleC2 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module C2\n\nConformity to type based on internal production control plus supervised product checks at random intervals"@en;
    rdfs:label "module C2"@en;
    dcterms:source "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en, "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\t\nDecision No 768/2008/EC Annex II"@en.
eudpp:moduleD a owl:NamedIndividual, eudpp:ConformityAssessmentModule, eudpp:LifeCycleModule;
    rdfs:comment "Decision No 768/2008/EC module D\n\nConformity to EU-type based on quality assurance of the production process"@en;
    rdfs:label "module D"@en, "D - Benefits and loads beyond the system boundary"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en;
    skos:altLabel "D"@en;
    eudpp:sourceVocabulary "ILCD+EPD extension".
eudpp:moduleD1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module D1\n\nQuality assurance of the production process"@en;
    rdfs:label "module D1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleE a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module E\n\nConformity to EU-type based on product quality assurance"@en;
    rdfs:label "module E"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleE1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module E1\n\nQuality assurance of final product inspection and testing"@en;
    rdfs:label "module E1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleF a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module F\n\nConformity to EU-type based on product verification"@en;
    rdfs:label "module F"@en;
    dcterms:source "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en, "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\t\nDecision No 768/2008/EC Annex II"@en.
eudpp:moduleF1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module F1\n\nConformity based on product verification"@en;
    rdfs:label "module F1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleG a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module G\n\nConformity based on unit verification"@en;
    rdfs:label "module G"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleH a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC moduleH\n\nConformity based on full quality assurance"@en;
    rdfs:label "module H"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleH1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module H1\n\nConformity based on full quality assurance plus design examination"@en;
    rdfs:label "module H1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
dcterms:accessRights a owl:AnnotationProperty.
owl:priorVersion a owl:AnnotationProperty.
skos:broadMatch a owl:AnnotationProperty.
eudpp:sourceVocabulary a owl:AnnotationProperty;
    rdfs:comment "Provenance annotation identifying the vocabulary, standard, or ontology from which a class, property, or named individual of this ontology aligns with. \nPossible values: \"LCA ontology\" (introduced by this ontology, no direct external counterpart), \"ILCD base\" (corresponds to the ILCD base data format), \"ILCD+EPD extension\" (corresponds to the ILCD+EPD v1.3 extension, InData epd/epd2/epd24 namespaces), \"Dublin Core\" (aligned with dcterms), \"PROV-O\" (aligned with W3C Provenance Ontology), \"SKOS\" (aligned with W3C Simple Knowledge Organization System), \"FOAF\" (aligned with Friend of a Friend vocabulary), \"LCAnet\" (aligned with the LCAnet ontology)."@en;
    rdfs:label "source vocabulary"@en;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:unitAsString a owl:AnnotationProperty;
    rdfs:comment "Human-readable label of the unit in which the associated EN 15804 indicator value is expressed, e.g. \"kg CO2-eq\", \"MJ, net calorific value\", \"m3\". Annotation property (not for automated unit arithmetic)."@en;
    rdfs:label "unit as string"@en;
    eudpp:sourceVocabulary "LCA ontology"@en.
<https://w3id.org/eudpp/LCA#assessesImpactCategory> a owl:AnnotationProperty.
<https://w3id.org/eudpp/LCA#relatesToLCAIndicator> a owl:AnnotationProperty.
xsd:gYear a rdfs:Datatype.
eudpp:addressesAoP a owl:ObjectProperty;
    rdfs:comment "Link between an LCIAImpactCategory and the Area(s)-of-protection it addresses.\n1..n cardinality: a single impact category can address several Areas of Protection — for example, ozone depletion affects both Natural Environment and Human Health."@en;
    rdfs:label "addresses AoP"@en;
    rdfs:domain eudpp:LCIAImpactCategory;
    rdfs:range eudpp:AreaOfProtection;
    eudpp:sourceVocabulary "ILCD base"@en.
eudpp:LCIAImpactCategory a owl:Class;
    rdfs:comment "A mid-point impact category that an LCAMethod addresses. A closed enumeration."@en;
    rdfs:label "LCIA Impact Category"@en;
    owl:equivalentClass _:n3-125;
    eudpp:sourceVocabulary "ILCD base: matches the LCIAImpactCategoryValues."@en, "LCAnet: relates to the element ImpactCategory (https://w3id.org/lcanet/ia#ImpactCategory) of the IA module."@en.
eudpp:AreaOfProtection a owl:Class;
    rdfs:comment "Damage area addressed by an LCIA method via the LCIA Impact Category class using the addressesAoP object property. A closed enumeration of 5 individuals."@en;
    rdfs:label "Area of Protection"@en;
    owl:equivalentClass _:n3-95;
    eudpp:sourceVocabulary "ILCD base: corresponds to the element AreaOfProtectionValues."@en.
eudpp:assessesImpactCategory a owl:ObjectProperty;
    rdfs:comment "Link from an LCIA impact indicator to the mid-point impact category it characterises. Multiple indicators may assess the same category (e.g. Eutrophication, freshwater and Eutrophication, marine both relate to Eutrophication). This property expresses a conceptual classification link, not equivalence."@en;
    rdfs:label "assesses impact category"@en;
    rdfs:domain eudpp:LCIAImpactIndicator;
    rdfs:range eudpp:LCIAImpactCategory;
    eudpp:sourceVocabulary "LCAnet: relates to the element assessIC (https://w3id.org/lcanet/ia#assessIC) in the IA module."@en.
eudpp:LCIAImpactIndicator a owl:Class;
    rdfs:comment "A characterised impact indicator outside the EN 15804+A2 selection — direct subclass of eudpp:LCAIndicator, sibling of eudpp:EN15804Indicator. Holds the 16 official EF 3.1 / PEF impact category indicators as named individuals (Andreasi Bassi et al., JRC, 2023). \nThese are the impact indicators used by general LCA studies (eudpp:LCAStudy) following the EU Environmental Footprint method, distinct from the EN 15804+A2 set used by EPDStudy. \nThe two sets overlap conceptually — both have e.g. a \"Climate change\" indicator with kg CO2-eq — but differ operationally: EN 15804+A2 splits Climate change into four sub-indicators (total, fossil, biogenic, luluc) and selects 6 \"with caveats\" indicators with EN-specific reporting rules; EF 3.1 keeps Climate change as one indicator and presents 16 categories at one aggregation level."@en;
    rdfs:label "LCIA Impact Indicator"@en;
    rdfs:subClassOf eudpp:LCAIndicator;
    eudpp:sourceVocabulary "LCA ontology"@en, "LCAnet: relates to the element ImpactCategoryIndicator (https://w3id.org/lcanet/ia#ImpactCategoryIndicator) of the IA module."@en.
eudpp:belongsToEn15804Group a owl:ObjectProperty;
    rdfs:comment "Link from an EN15804Indicator individual to the indicator EN15804IndicatorGroup it belongs to (core impact, with-caveats, resource use, waste, valorisation, exported energy)."@en;
    rdfs:label "belongs to EN 15804 indicator group"@en;
    rdfs:domain eudpp:EN15804Indicator;
    rdfs:range eudpp:EN15804IndicatorGroup;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:EN15804Indicator a owl:Class;
    rdfs:comment "An indicator defined by EN 15804+A2 (core impact, impact with caveats, resource use, waste output, or output-flow indicator). \nSubclass of the abstract eudpp:LCAIndicator parent. \nNote: an EN15804Indicator individual is the indicator definition; a result computed for that indicator is an eudpp:LCAResult instance (LCIAResult or InventoryIndicatorResult sibling)."@en;
    rdfs:label "EN 15804 Indicator"@en;
    rdfs:subClassOf eudpp:LCAIndicator;
    eudpp:sourceVocabulary "ILCD+EPD extension"@en.
eudpp:EN15804IndicatorGroup a owl:Class;
    rdfs:comment "Grouping of the EN 15804+A2 indicators based on the printed standard's tables: core impact (Table 3), impact indicators with caveats (Table 4), resource use (Table 5 resource use), waste categories (Table 5 waste), output flows valorisation (Table 5 output flows), exported energy (Table 5 output flows). Enumeration of 6 named individuals."@en;
    rdfs:label "EN 15804 Indicator Group"@en;
    owl:equivalentClass _:n3-110;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:belongsToMethodology a owl:ObjectProperty;
    rdfs:comment "Link from a Method to one or several LCAMethodology individuals it belongs to (e.g. eudpp:methodology_EF3_1). Cardinality 1..n: a single method can be classified into more than one methodology (for example, when two methodologies share the same characterisation factors for one indicator)."@en;
    rdfs:label "belongs to methodology"@en;
    rdfs:domain eudpp:LCAMethod;
    rdfs:range eudpp:LCAMethodology;
    eudpp:sourceVocabulary "LCA ontology"@en, "LCAnet: relates to the element includedInMethodology (https://w3id.org/lcanet/ia#includedInMethodology) in the IA module.".
eudpp:LCAMethod a owl:Class;
    rdfs:comment "A life-cycle assessement method that produces values for one indicator from an inventory of elementary flows. \nCovers both (a) characterised LCIA methods (which apply characterisation factors to compute a midpoint impact result), and (b) inventory aggregation methods (which sum / aggregate inventory flows to produce an inventory-indicator result, e.g. the EN 15804+A2 inventory indicators FW, HWD, PERE etc. defined as inventory-level by the standard's calculation rules)."@en;
    rdfs:label "LCA Method"@en;
    rdfs:seeAlso <https://indatawg.github.io/ILCD-EPD-Data-Format/gitBranches/release/v1.3/schemadoc/ILCD_LCIAMethodDataSet.html>;
    eudpp:sourceVocabulary "ILCD+EPD extension: corresponds to the element LCIA Method Data Set, which is used in practice for both LCIA method and inventory indicator methods."@en, "LCAnet: relates to the element Method (https://w3id.org/lcanet/ia#Method) in the IA module."@en.
eudpp:LCAMethodology a owl:Class;
    rdfs:comment "A named, versioned LCA methodology (a coherent set of LCA methods sharing principles and a set of characterisation factors), to which one or more Method instances belong. \nEach individual SHOULD carry a skos:altLabel giving a short code (e.g. \"EF 3.1\") and eudpp:methodologyVersion giving the version identifier."@en;
    rdfs:label "LCA Methodology"@en;
    eudpp:sourceVocabulary "LCA ontology"@en, "LCAnet: relates to the element Methodology (https://w3id.org/lcanet/ia#Methodology) of the IA module."@en.
eudpp:computedByMethod a owl:ObjectProperty;
    rdfs:comment "Link from an LCAIndicator individual to the IndicatorMethod instance that describes how this indicator is computed — its impact model, impact category, methodology reference, reference report, and ILCD method metadata. \nCardinality: at most 1 per indicator individual.\""@en;
    rdfs:label "computed by method"@en;
    rdfs:domain eudpp:LCAIndicator;
    rdfs:range eudpp:LCAMethod;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:LCAIndicator a owl:Class;
    rdfs:comment "Abstract umbrella class for an indicator definition (impact or inventory category) that an eudpp:Method calculates values for. \nEach instance identifies exactly one method under which it is computed; this constraint is formalised as owl:maxCardinality 1 on eudpp:computedByMethod. \nNote: an indicator individual is the indicator DEFINITION (e.g. \"FW – Net use of fresh water, in m3\"); a numerical value computed for that indicator on a specific study is an eudpp:LCAResult instance (LCIAResult or InventoryIndicatorResult)."@en;
    rdfs:label "LCA Indicator"@en;
    rdfs:subClassOf _:n3-119;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:declaresManufacturerRecord a owl:ObjectProperty;
    rdfs:comment "Links an LCA study to a manufacturer record documenting the manufacturers whose data is included in the study."@en;
    rdfs:label "declares Manufacturer Record"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:ManufacturerRecord;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element epd24:manufacturers/epd24:manufacturer"@en.
eudpp:followsPCR a owl:ObjectProperty;
    rdfs:comment "Link from an EPDStudy to the Product Category Rules document(s) it follows (1..n)."@en;
    rdfs:label "follows PCR"@en;
    rdfs:domain eudpp:EPDStudy;
    rdfs:range eudpp:PCR;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element referenceToPCR."@en.
eudpp:PCR a owl:Class;
    rdfs:comment "Source that is a Product Category Rules document (EN 15804+A2 Table 2 Line 1). Used in EN 15804+A2 EPDStudy via eudpp:referenceToPCR."@en;
    rdfs:label "Product Category Rules (PCR)"@en;
    rdfs:subClassOf eudpp:Source;
    skos:broadMatch <http://xmlns.com/foaf/0.1/Document>;
    eudpp:sourceVocabulary "ILCD base"@en.
eudpp:followsPEFCR a owl:ObjectProperty;
    rdfs:comment "Link from an LCAStudy to a Product Environmental Footprint Category Rules document (1..n)."@en;
    rdfs:label "follows PEFCR"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:PEFCR;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:PEFCR a owl:Class;
    rdfs:comment "Source that is a Product Environmental Footprint Category Rules document, the European Commission Environmental Footprint methodology's product-category-specific rules. Parallel role to PCR but for PEF studies (rather than EN 15804+A2 EPD studies). Used by an LCAStudy via eudpp:referenceToPEFCR. NEW in v1.9.7."@en;
    rdfs:label "Product Environmental Footprint Category Rules (PEFCR)"@en;
    rdfs:subClassOf eudpp:Source;
    skos:broadMatch <http://xmlns.com/foaf/0.1/Document>;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:forLifeCycleModule a owl:ObjectProperty;
    rdfs:comment "Link from an LCAModuleValue to the Life-cycle module it refers to."@en;
    rdfs:label "for life-cycle module"@en;
    rdfs:domain eudpp:LCAModuleValue;
    rdfs:range eudpp:LifeCycleModule;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the attribute @epd:module on epd:amount."@en.
eudpp:LifeCycleModule a owl:Class;
    rdfs:comment "A modelled life-cycle module per EN 15804+A2 (product stage A1-A3, construction A4-A5, use stage B1-B7, end-of-life C1-C4, benefits/loads D). Enumeration of 18 named individuals. \nNote that moduleA1A3 (aggregated product stage) is an alternative reporting form of A1+A2+A3; an EPD that reports A1-A3 should not additionally report A1, A2, A3 separately for the same indicator/scenario."@en;
    rdfs:label "Life Cycle Module"@en;
    owl:equivalentClass _:n3-152;
    eudpp:sourceVocabulary "ILCD+EPD extension"@en.
eudpp:hasComplianceDeclaration a owl:ObjectProperty;
    rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to a ComplianceDeclaration. Compliance can be declared against any standard relevant to the study type (ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR-specific rules, etc.)."@en;
    rdfs:label "has compliance declaration"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:ComplianceDeclaration;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element complianceDeclarations/compliance. Domain widened in v1.9.7 from EPDStudy to LCAStudy."@en.
eudpp:ComplianceDeclaration a owl:Class;
    rdfs:comment "A statement that the LCA or EPD study complies with a given compliance system (typically ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, or a PEFCR). The level of compliance (fully, partially, not compliant) is recorded via eudpp:complianceStatus."@en;
    rdfs:label "Compliance Declaration"@en;
    rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element complianceDeclarations/compliance."@en.
eudpp:hasExternalSource a owl:ObjectProperty;
    rdfs:comment "Link from an LCAStudy to a background source. It can be a (a) documentation (e.g. an LCA project report, safety data sheet, or explanatory material) - covering the ILCD+EPD element referenceToExternalDocumentation on dataSetInformation, (b) databases or, (c)  literature sources used for modelling."@en;
    rdfs:label "has external source"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:Source;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:Source a owl:Class;
    rdfs:comment "A bibliographic or documentary source referenced from an LCA study, EPD study or LCIA Method. Abstract superclass; concrete source instances typically use one of the more specific subclasses (PCR, LCAMethodReport, BackgroundDatabase, ComplianceSystem, ReviewReport, EPDDocument)."@en;
    rdfs:label "Source"@en;
    rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element Source Data Set."@en.
eudpp:hasImpactCategory a owl:ObjectProperty;
    rdfs:comment "Impact category addressed by the Method."@en;
    rdfs:label "has impact category"@en;
    rdfs:domain eudpp:LCAMethod;
    rdfs:range eudpp:LCIAImpactCategory;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element impactCategory on LCIAMethodDataSet."@en, "LCAnet: relates to the element hasImpactCategory (https://w3id.org/lcanet/ia#hasIC) in the IA module."@en.
eudpp:hasImpactModel a owl:ObjectProperty;
    rdfs:comment "Link from an Method to its characterisation-model block (where applicable; inventory-only methods may not have one)."@en;
    rdfs:label "has impact model"@en;
    rdfs:domain eudpp:LCAMethod;
    rdfs:range eudpp:ImpactModel;
    eudpp:sourceVocabulary "LCAnet: relates to the element usesCM (https://w3id.org/lcanet/ia#usesCM) in the IA module."@en.
eudpp:ImpactModel a owl:Class;
    rdfs:comment "The characterisation model underlying an LCIA method (e.g. IPCC AR6 2021 for GWP). It carries a model name (eudpp:modelName), optional version (eudpp:modelVersion), and optional bibliographic source (eudpp:referenceToModelSource)."@en;
    rdfs:label "Impact Model"@en;
    eudpp:sourceVocabulary "ILCD+EPD extension: corresponds to the element impactModel of an LCIA Method Data Set."@en, "LCAnet: relates to the element CharacterizationModel (https://w3id.org/lcanet/ia#CharacterizationModel) of the IA module."@en.
eudpp:hasInventoryIndicatorResult a owl:ObjectProperty;
    rdfs:comment "Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:InventoryIndicatorResult."@en;
    rdfs:label "has inventory indicator result"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:InventoryIndicatorResult;
    rdfs:subPropertyOf eudpp:hasLCAResult;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 inventory indicator (resource use, waste, output flows)."@en.
eudpp:hasLCAResult a owl:ObjectProperty;
    rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to one of its LCA results. Range is the abstract eudpp:LCAResult; sub-properties eudpp:hasLCIAResult and eudpp:hasInventoryResult narrow the result to the corresponding sibling subclass. Querying for eudpp:hasLCAResult retrieves both kinds of results in one go."@en;
    rdfs:label "has LCA result"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:LCAResult;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:InventoryIndicatorResult a owl:Class;
    rdfs:comment "A specific LCA result representing an aggregated inventory-indicator result computed for an EN 15804+A2 inventory indicator (Table 5: resource use, waste categories, output flows). \nImportant disambiguation: this class represents the AGGREGATED inventory-indicator value (e.g. total kg of HWD across A1-A3 for one product), as printed in EN 15804+A2 EPD tables and computed by a Method instance. It is NOT the raw flow-level life-cycle inventory (LCI) result of a process (which would be a list of elementary-flow exchanges with amounts and units, and is out of scope for this DPP-oriented LCA module)."@en;
    rdfs:label "Inventory Indicator Result"@en;
    rdfs:subClassOf eudpp:LCAResult, _:n3-118;
    eudpp:sourceVocabulary "ILCD+EPD extension"@en.
eudpp:hasLCIAResult a owl:ObjectProperty;
    rdfs:comment "Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:LCIAResult."@en;
    rdfs:label "has LCIA result"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:LCIAResult;
    rdfs:subPropertyOf eudpp:hasLCAResult;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 impact indicator."@en.
eudpp:LCIAResult a owl:Class;
    rdfs:comment "A characterised LCA result quantifying one LCIA indicator (an EN15804ImpactIndicator or an LCIAImpactIndicator ) for a product system. Each instance is linked to exactly one indicator individual via quantifiesIndicator, and carries its numerical value per life-cycle module via hasLCAModuleValue."@en;
    rdfs:label "LCIA Result"@en;
    rdfs:subClassOf eudpp:LCAResult, _:n3-142;
    eudpp:sourceVocabulary "ILCD+EPD extension: corresponds to the element LCIAResults/LCIAResult when the indicator is a characterised impact indicator."@en.
eudpp:hasLicenseType a owl:ObjectProperty;
    rdfs:comment "License applicable to the LCA / EPD study."@en;
    rdfs:label "has license type"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:LicenseType;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element publicationAndOwnership/licenseType."@en.
eudpp:LicenseType a owl:Class;
    rdfs:comment "License applicable to access and use of the LCA / EPD study. A closed enumeration."@en;
    rdfs:label "License Type"@en;
    rdfs:subClassOf <http://spdx.org/rdf/terms#License>;
    owl:equivalentClass _:n3-146;
    eudpp:sourceVocabulary "ILCD base: matching the ILCD LicenseTypeValues."@en.
eudpp:hasPerModuleValue a owl:ObjectProperty;
    rdfs:comment "Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to one of its per-module (and optionally per-scenario) numerical values."@en;
    rdfs:label "has per module value"@en;
    rdfs:domain eudpp:LCAResult;
    rdfs:range eudpp:LCAModuleValue;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element LCIAResult/other/epd:amount."@en.
eudpp:hasReferenceToBackgroundDatabase a owl:ObjectProperty;
    rdfs:comment "Link from an LCAStudy to a background LCI database used for the modelling (1..n). Sub-property of eudpp:hasExternalSource."@en;
    rdfs:label "has reference to background database"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:BackgroundDatabase;
    rdfs:subPropertyOf eudpp:hasExternalSource;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:BackgroundDatabase a owl:Class;
    rdfs:comment "Source representing a background LCI database used for the LCA modelling (e.g. ecoinvent, GaBi/Sphera, Okobaudat)."@en;
    rdfs:label "Background Database"@en;
    rdfs:subClassOf eudpp:Source;
    eudpp:sourceVocabulary "ILCD base"@en.
eudpp:hasReview a owl:ObjectProperty;
    rdfs:comment "Link from an LCAStudy to a critical-review / verification record."@en;
    rdfs:label "has review"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range eudpp:Review;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element validation/review."@en.
eudpp:hasTypeOfReview a owl:ObjectProperty;
    rdfs:comment "The kind of review performed (independent external, accredited third party, etc.)."@en;
    rdfs:label "has type of review"@en;
    rdfs:domain eudpp:Review;
    rdfs:range eudpp:TypeOfReview;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the attribute review/@type."@en.
eudpp:TypeOfReview a owl:Class;
    rdfs:comment "Kind of critical-review/verification performed on a dataset. Enumeration matching ILCD TypeOfReviewValues."@en;
    rdfs:label "Type of Review"@en;
    rdfs:subClassOf skos:Concept;
    owl:equivalentClass _:n3-171;
    eudpp:sourceVocabulary "ILCD base"@en.
eudpp:includesMethod a owl:ObjectProperty;
    rdfs:comment "Link from a Method (a collection of methods sharing a methodology such as \"EF 3.1\") to each of the individual-indicator method instances it aggregates."@en;
    rdfs:label "includes method"@en;
    rdfs:domain eudpp:LCAMethod;
    rdfs:range eudpp:LCAMethod;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element referenceToIncludedMethods.\nILCD+EPD LCIA Method Data Sets can represent either a single LCIA or inventory method (one indicator) or a methodology (a collection/list of methods); this property is used only in the latter case."@en.
eudpp:quantifiesIndicator a owl:ObjectProperty;
    rdfs:comment "Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to the LCAIndicator individual that this result quantifies. \nThis is the primary semantic identity of a result: a result is a quantification of an indicator, not of a method. \nCardinality: exactly 1 per result instance.\nRange: LCAIndicator (covers both EN15804Indicator individuals and non-EN-15804 indicators)."@en;
    rdfs:label "quantifies indicator"@en;
    rdfs:domain eudpp:LCAResult;
    rdfs:range eudpp:LCAIndicator;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:referenceToCompleteReviewReport a owl:ObjectProperty;
    rdfs:comment "Link from a Review to the full review report."@en;
    rdfs:label "reference to complete review report"@en;
    rdfs:domain eudpp:Review;
    rdfs:range eudpp:ReviewReport;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element review/referenceToCompleteReviewReport."@en.
eudpp:ReviewReport a owl:Class;
    rdfs:comment "Source holding the complete critical-review / verification report referenced from a Review."@en;
    rdfs:label "Review Report"@en;
    rdfs:subClassOf eudpp:Source;
    skos:broadMatch <http://xmlns.com/foaf/0.1/Document>;
    eudpp:sourceVocabulary "ILCD base"@en.
eudpp:referenceToComplianceStatus a owl:ObjectProperty;
    rdfs:comment "Level of compliance declared by a ComplianceDeclaration (fully compliant, partially compliant, or not compliant)."@en;
    rdfs:label "reference to compliance status"@en;
    rdfs:domain eudpp:ComplianceDeclaration;
    rdfs:range eudpp:ComplianceStatus;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:ComplianceStatus a owl:Class;
    rdfs:comment "Level of compliance declared by a ComplianceDeclaration relative to its compliance system. Enumeration of 3 named individuals (fullyCompliant, partiallyCompliant, notCompliant)."@en;
    rdfs:label "Compliance Status"@en;
    rdfs:subClassOf skos:Concept;
    owl:equivalentClass _:n3-106;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:referenceToComplianceSystem a owl:ObjectProperty;
    rdfs:comment "Link from a ComplianceDeclaration to the standard or programme it references (EN 15804+A2, ISO 14025, ISO 21930, etc.)."@en;
    rdfs:label "reference to compliance system"@en;
    rdfs:domain eudpp:ComplianceDeclaration;
    rdfs:range eudpp:ComplianceSystem;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element compliance/referenceToComplianceSystem."@en.
eudpp:ComplianceSystem a owl:Class;
    rdfs:comment "A standard or programme against which an LCA or EPD study is declared compliant, such as ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR programmes, or a specific programme operator's scheme."@en;
    rdfs:label "Compliance System"@en;
    rdfs:subClassOf eudpp:Source;
    eudpp:sourceVocabulary "ILCD base"@en.
eudpp:referenceToExternalSource a owl:ObjectProperty;
    rdfs:comment "Link from a Method to the external documentation describing the method."@en;
    rdfs:label "reference to external source"@en;
    rdfs:domain eudpp:LCAMethod;
    rdfs:range eudpp:Source;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element referenceToExternalDocumentation on LCIAMethodDataSet/dataSetInformation."@en.
eudpp:referenceToLCAMethodReport a owl:ObjectProperty;
    rdfs:comment "Link from a Method to the formal LCIA method report (e.g. the EF 3.1 method description)."@en;
    rdfs:label "reference to LCA method report"@en;
    rdfs:domain eudpp:LCAMethod;
    rdfs:range eudpp:LCAMethodReport;
    rdfs:subPropertyOf eudpp:referenceToExternalSource;
    eudpp:sourceVocabulary "ILCD base"@en.
eudpp:LCAMethodReport a owl:Class;
    rdfs:comment "Source that documents a life-cycle impact assessment (LCIA) method (e.g. the EF 3.1 method description)."@en;
    rdfs:label "LCIA Method Report"@en;
    rdfs:subClassOf eudpp:Source;
    skos:broadMatch <http://xmlns.com/foaf/0.1/Document>;
    eudpp:sourceVocabulary "ILCD base"@en.
eudpp:referenceToModelSource a owl:ObjectProperty;
    rdfs:comment "Link from an ImpactModel to the bibliographic source(s) describing the characterisation model."@en;
    rdfs:label "reference to model source"@en;
    rdfs:domain eudpp:ImpactModel;
    rdfs:range eudpp:Source;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element referenceToModelSource."@en.
eudpp:referenceToOriginalEPD a owl:ObjectProperty;
    rdfs:comment "Link from the machine-readable EPDStudy to the published EPD document (typically PDF)."@en;
    rdfs:label "reference to original EPD"@en;
    rdfs:domain eudpp:EPDStudy;
    rdfs:range eudpp:EPDDocument;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element epd2:referenceToOriginalEPD."@en.
eudpp:EPDDocument a owl:Class;
    rdfs:comment "Source representing the published PDF or HTML EPD document itself (as distinct from the ILCD+EPD machine-readable EPDStudy)."@en;
    rdfs:label "EPD Document"@en;
    rdfs:subClassOf eudpp:Source;
    skos:broadMatch <http://xmlns.com/foaf/0.1/Document>;
    eudpp:sourceVocabulary "ILCD+EPD extension"@en.
eudpp:relatesToLCAIndicator a owl:ObjectProperty;
    rdfs:comment "Relates an EN15804 impact indicator to the conceptually corresponding EF 3.1 / PEF LCIA impact indicator. \nThe two indicators are not equivalent — EN15804 indicators are EPD-specific reporting slots defined by EN15804+A2, while LCIA impact indicators follow the broader EF 3.1 characterisation framework. This property records a conceptual correspondence without implying any equivalence."@en;
    rdfs:label "relates to LCA indicator"@en;
    rdfs:domain eudpp:EN15804ImpactIndicator;
    rdfs:range eudpp:LCIAImpactIndicator;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:EN15804ImpactIndicator a owl:Class;
    rdfs:comment "An EN 15804+A2 characterised impact indicator (core set of 13 or the 6 additional \"with caveats\" indicators). Characterised via the EF 3.1 characterisation models. Results computed for this indicator are eudpp:LCIAResult instances."@en;
    rdfs:label "EN 15804 Impact Indicator"@en;
    rdfs:subClassOf eudpp:EN15804Indicator;
    eudpp:sourceVocabulary "ILCD+EPD extension"@en.
dcterms:hasVersion a owl:DatatypeProperty.
eudpp:accessRestrictions a owl:DatatypeProperty;
    rdfs:comment "Human-readable description of access and use restrictions for the LCA / EPD study (equivalent to dcterms:accessRights)."@en;
    rdfs:label "access restrictions"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range rdf:langString;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element accessRestrictions."@en.
eudpp:amount a owl:DatatypeProperty;
    rdfs:comment "Numerical value of an LCA result or an LCIAModuleValue."@en;
    rdfs:label "amount"@en;
    rdfs:domain _:n3-92;
    rdfs:range xsd:double;
    eudpp:sourceVocabulary "ILCD+EPD extension: corresponds to the text content of epd:amount inside LCIAResult/other."@en.
_:n3-92 a owl:Class;
    owl:unionOf _:n3-93.
_:n3-93 rdf:first eudpp:LCAModuleValue;
    rdf:rest _:n3-94.
_:n3-94 rdf:first eudpp:LCAResult;
    rdf:rest rdf:nil.
eudpp:dataSetVersion a owl:DatatypeProperty;
    rdfs:comment "Version number of this LCA / EPD study instance, independent of the ontology version. Format: major.minor.sub-minor (e.g. \"02.00.011\")."@en;
    rdfs:label "data set version"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:hasVersion;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element publicationAndOwnership/dataSetVersion."@en.
eudpp:epdFormatVersion a owl:DatatypeProperty;
    rdfs:comment "Version tag of the ILCD+EPD format used (e.g. \"1.3\")."@en;
    rdfs:label "EPD format version"@en;
    rdfs:domain eudpp:EPDStudy;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:hasVersion;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the attribute @epd2:epd-version on processDataSet."@en.
eudpp:expiryDate a owl:DatatypeProperty;
    rdfs:comment "Date on which the EPD's validity expires. EN 15804+A2 EPDs are typically valid for five years from publication."@en;
    rdfs:label "expiry date"@en;
    rdfs:domain eudpp:EPDStudy;
    rdfs:range xsd:date;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the element epd2:expirationDateOfEPD on time/other."@en.
eudpp:forScenario a owl:DatatypeProperty;
    rdfs:comment "Identifier of the scenario this LCIAModuleValue applies to (free-text label matching the EPD's scenario declaration)."@en;
    rdfs:label "for scenario"@en;
    rdfs:domain eudpp:LCAModuleValue;
    rdfs:range xsd:string;
    eudpp:sourceVocabulary "ILCD+EPD extension: Corresponds to the attribute @epd:scenario on epd:amount."@en.
eudpp:hasCopyright a owl:DatatypeProperty;
    rdfs:comment "True if a copyright applies to the LCA / EPD study, false otherwise."@en;
    rdfs:label "has copyright"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range xsd:boolean;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element publicationAndOwnership/copyright. Modelled as xsd:boolean per the ILCD+EPD schema definition (two-valued)."@en.
eudpp:ilcdFormatVersion a owl:DatatypeProperty;
    rdfs:comment "ILCD schema version used by the source serialisation of this study (e.g. '1.1')."@en;
    rdfs:label "ILCD format version"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:hasVersion;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the attribute @version on processDataSet."@en.
eudpp:isDeclared a owl:DatatypeProperty;
    rdfs:comment "True if this module value is declared in the study (has a numerical amount), false if the module is explicitly marked as not declared (ND / MND) for this indicator/scenario. Absence of the LCIAModuleValue triple altogether means the module was not in scope of the study (MNA - module not applicable)."@en;
    rdfs:label "is declared"@en;
    rdfs:domain eudpp:LCAModuleValue;
    rdfs:range xsd:boolean;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:methodVersion a owl:DatatypeProperty;
    rdfs:comment "Version of the specific LCIA or Inventory method instance (where applicable). Captures method-instance-level versioning, distinct from methodology-level versioning (eudpp:methodologyVersion on LCAMethodology)."@en;
    rdfs:label "method version"@en;
    rdfs:domain eudpp:LCAMethod;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:hasVersion;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:methodologyVersion a owl:DatatypeProperty;
    rdfs:comment "Version identifier of an LCAMethodology individual (e.g. \"3.1\" for EF 3.1, \"2002\" for CML 2002)."@en;
    rdfs:label "methodology version"@en;
    rdfs:domain eudpp:LCAMethodology;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:hasVersion;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:modelVersion a owl:DatatypeProperty;
    rdfs:comment "Version of the characterisation model used (e.g. \"IPCC AR6 2021\" vs \"IPCC AR5 2013\", which give different GWP100 values)."@en;
    rdfs:label "model version"@en;
    rdfs:domain eudpp:ImpactModel;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:hasVersion;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:providesLCAData a owl:DatatypeProperty;
    rdfs:comment "Indicates whether the manufacturer identified in this record directly provided primary LCA data for the study. Set to true for the reference manufacturer; may be false for manufacturers listed for traceability only."@en;
    rdfs:label "provides LCA data"@en;
    rdfs:domain eudpp:ManufacturerRecord;
    rdfs:range xsd:boolean.
eudpp:referenceYear a owl:DatatypeProperty;
    rdfs:comment "Start year of the time period for which the study is valid."@en;
    rdfs:label "reference year"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range xsd:gYear;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element time/referenceYear on processDataSet."@en.
eudpp:registrationNumber a owl:DatatypeProperty;
    rdfs:comment "Identifying number issued by the EPD programme operator (typically visible on the EPD document). Distinct from the dataset UUID."@en;
    rdfs:label "registration number"@en;
    rdfs:domain eudpp:EPDStudy;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:identifier;
    eudpp:sourceVocabulary "ILCD base: Corresponds to the element publicationAndOwnership/registrationNumber."@en.
eudpp:reviewDate a owl:DatatypeProperty;
    rdfs:comment "Date on which the review was completed. Important for DPP consumers to assess whether the review is still current."@en;
    rdfs:label "review date"@en;
    rdfs:domain eudpp:Review;
    rdfs:range xsd:date;
    eudpp:sourceVocabulary "LCA ontology"@en.
eudpp:uuid a owl:DatatypeProperty;
    rdfs:comment "The Universally Unique Identifier of this LCA / EPD study, as mandated by ILCD+EPD as the primary persistent identifier. Once a study is created and a UUID is generated, the UUID stays the same forever; any change increments eudpp:dataSetVersion. String formatted as an RFC 4122 UUID (36 characters, hyphenated)."@en;
    rdfs:label "UUID"@en;
    rdfs:domain eudpp:LCAStudy;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:identifier;
    eudpp:sourceVocabulary "ILCD base"@en.
