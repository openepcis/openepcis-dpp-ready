eudpp:ProductIdentifierGranularity a owl:Class;
    rdfs:comment "The granularity level (batch, item, model) at which the product identifier represents the product."@en;
    rdfs:label "Product identifier granularity"@en;
    rdfs:subClassOf eudpp:IdentifierGranularity;
    owl:equivalentClass _:n3-64.
_:n3-63 a owl:Restriction;
    owl:onProperty eudpp:identifierValue;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
