eudpp:MaximumConcentration a owl:Class;
    rdfs:comment "A concentration reported as a maximum value. The inherited dpp:numericalValue denotes the upper bound, and dpp:hasMeasurementUnit supplies its unit."@en;
    rdfs:label "Maximum concentration"@en;
