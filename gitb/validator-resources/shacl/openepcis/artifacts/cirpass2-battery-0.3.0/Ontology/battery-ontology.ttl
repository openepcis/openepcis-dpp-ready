@prefix bat: <https://w3id.org/eudpp/battery#> .
@prefix batcat: <https://w3id.org/eudpp/battery-categories#> .
@prefix batstat: <https://w3id.org/eudpp/battery-statuses#> .
@prefix batloc: <https://w3id.org/eudpp/battery-locations#> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################
# Ontology
#################################################
# Umbrella module of the EU DPP Battery sectoral ontology.
# Battery data is organised in nine companion modules:
#   battery-performance, battery-materials, battery-labeling,
#   battery-categories, battery-chemistries, battery-locations, battery-metals,
#   battery-statuses, battery-extinguisher-classes,
#   plus the battery-cf-shapes SHACL profile.
#
# v0.4.0: bat:partNumber added (Annex XIII 2(b), data point 46 of
# the Commission guidance). CIRPASS-2 decided in June 2026 not to
# add a cross-sectoral part number to the CORE, so the term is
# declared here; a recommendation went to the Commission.
#
# Manufacturing date (27 August 2026): carried by the CORE property
# eudpp:manufacturingDate, not declared here. Settled on
# ontologies-core#33 and released in P_DPP v2.0.6 (27 August 2026):
# domain eudpp:Product, optional, and the range deliberately left open
# "to be specified in accordance of sectorial needs". Both the
# xsd:gYearMonth typing and the battery obligation are therefore
# conformance rules and belong to the #10 shape set.
#
# v0.3.0 (issue #3): bat:hasBatteryStatus added, pointing at the
# battery-statuses vocabulary. The lifecycle status of the battery as a
# physical item is a battery term; the status of its passport as a
# digital resource is not, and stays on dpp:dppStatus.
# bat:hasBatteryStatus is a stopgap pending ontologies-core#35, which
# requests a cross-sectoral eudpp:productStatus.
#
# 6 October 2026 (ontologies-core#45): bat:SafetyInstruction added, a
# subclass of the CORE class dpp:DigitalInstruction; bat:safetyMeasures
# is deprecated in its favour.
# Modelling rules applied (Hbeich et al. 2026, "Ontology Reuse as
# Commitment Management"):
#   - CORE concepts are referenced, never copied; no owl:imports
#     (same approach as the Textile sector modules).
#   - No cardinality restrictions in OWL: mandatory/optional constraints
#     of Regulation (EU) 2023/1542 belong to separate SHACL shapes.
#   - Controlled vocabularies live in their own module.

<https://w3id.org/eudpp/battery>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/eudpp/battery/0.4.0> ;
    rdfs:seeAlso <https://w3id.org/eudpp/battery-performance> ,
                 <https://w3id.org/eudpp/battery-materials> ,
                 <https://w3id.org/eudpp/battery-labeling> ,
                 <https://w3id.org/eudpp/battery-categories> ,
                 <https://w3id.org/eudpp/battery-chemistries> ,
                 <https://w3id.org/eudpp/battery-locations> ,
                 <https://w3id.org/eudpp/battery-metals> ,
                 <https://w3id.org/eudpp/battery-statuses> ,
                 <https://w3id.org/eudpp/battery-extinguisher-classes> ,
                 <https://w3id.org/eudpp/battery-cf-shapes> ;
    rdfs:label "EU DPP Battery Ontology"@en ;
    dcterms:title "EU DPP Battery Ontology"@en ;
    dcterms:description "Sectoral ontology for battery Digital Product Passports under Regulation (EU) 2023/1542. This umbrella module declares the Battery product class and the SafetyInstruction class; battery data is organised in nine companion modules: battery-performance (electrochemical performance, durability and in-use state), battery-materials (chemistry and material location), battery-labeling (labels and symbols), battery-categories (the five Art. 3(1) battery categories), battery-chemistries (the ten labelling chemistries), battery-locations (cathode, anode, electrolyte), battery-metals (the four metals whose recycled content Art. 8(1) requires), battery-statuses (the five Annex XIII 4(c) lifecycle statuses) and battery-extinguisher-classes; battery-cf-shapes carries the carbon footprint SHACL profile. It extends the CIRPASS-2 cross-sectoral CORE ontology by direct reference, following the approach of the Textile sector modules."@en ;
    rdfs:comment "Developed against the CIRPASS-2 CORE ontology of October 2026 (P_DPP v2.1.0, MAT v1.1.0). External references are pinned to these versions."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:license "This ontology is licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0). In case of dispute over CC BY 4.0 applicability, or in case considering the ontology as a software or part of it, this ontology is to be considered licensed under the Apache License, Version 2.0."@en ;
    dcterms:bibliographicCitation "EU DPP Battery Ontology. Draft version 0.4.0."@en ;
    dcterms:creator "Nader Jelassi"@en , "Marc-Andree Wolf"@en ;
    dcterms:contributor "Arnab Sinha"@en ;
    dcterms:created "2026-07-07"^^xsd:date ;
    dcterms:issued "2026-07-07"^^xsd:date ;
    dcterms:modified "2026-11-03"^^xsd:date ;
    dcterms:references "Regulation (EU) 2023/1542 (Batteries Regulation)"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    owl:versionInfo "Version 0.4.0 DRAFT"@en ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/battery#" ;
    vann:preferredNamespacePrefix "bat" .

#################################################
# Classes
#################################################

bat:Battery
    a owl:Class ;
    rdfs:subClassOf dpp:Product ;
    rdfs:label "Battery"@en ;
    rdfs:seeAlso batcat:BatteryCategoryScheme ;
    rdfs:comment "A battery placed on the market or put into service, subject of a battery passport under Regulation (EU) 2023/1542. Modelled as a subclass of the cross-sectoral Product class. A battery incorporated as a component of another product remains a Product, linked through the CORE component property (no dedicated Component class), in line with CIRPASS-2 modelling decisions. The regulatory category of a battery is expressed through the CORE property dpp:hasProductGroup, pointing to one of the five individuals of the battery-categories vocabulary; no category property is declared in the battery namespace. Its lifecycle status is expressed through bat:hasBatteryStatus, declared locally for want of a cross-sectoral equivalent. The date of manufacture is carried by the cross-sectoral property dpp:manufacturingDate, settled on ontologies-core#33; no manufacturing date property is declared in the battery namespace."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 3(1)(1)"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

bat:SafetyInstruction
    a owl:Class ;
    rdfs:subClassOf dpp:DigitalInstruction ;
    rdfs:label "Safety instruction"@en ;
    rdfs:comment "Instruction manual giving the safety measures to be taken when handling the battery, including dismantling. A digital instruction in the sense of the cross-sectoral class eudpp:DigitalInstruction (P_DPP): reached from the battery through dpp:hasProperty, with its URL on dpp:webLink. Declared here so that the safety measures can be told apart from the other instructions of a battery; replaces the datatype property bat:safetyMeasures (ontologies-core#45)."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(d); BatteryPass-Ready Data Attribute Long List v1.3, attribute 47"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

#################################################
# Object Properties
#################################################

bat:hasBatteryStatus
    a owl:ObjectProperty ;
    rdfs:domain bat:Battery ;
    rdfs:range skos:Concept ;
    rdfs:label "has battery status"@en ;
    rdfs:comment "Links a battery to its lifecycle status: one of the five individuals of the battery-statuses vocabulary (original, repurposed, re-used, remanufactured, waste). This is the status of the battery as a physical item, and not the status of its passport as a digital resource, which the CORE carries on dpp:DPP through dpp:dppStatus. Declared locally, unlike the battery category and the battery chemistry, because the CORE has no generic product status property to reuse: dpp:hasProductGroup carries the product group, not the state of the item. This is a stopgap: a cross-sectoral eudpp:productStatus on eudpp:Product was requested in CIRPASS-2/ontologies-core#35 (opened 22 June 2026, still open), motivated by this very attribute. When it lands, this property is to be deprecated in favour of it, using owl:deprecated and dcterms:isReplacedBy."@en ;
    rdfs:seeAlso batstat:BatteryStatusScheme ,
                 <https://github.com/CIRPASS-2/ontologies-core/issues/35> ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c); BatteryPass-Ready Data Attribute Long List v1.3, attribute 20"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

#################################################
# Datatype Properties — documentation links
#################################################
# Battery-specific documentation links. xsd:anyURI rather than the CORE
# Source pattern: Source is declared in the LCA module, which is not yet
# integrated into the CORE. bat:safetyMeasures is deprecated: the safety
# measures are a bat:SafetyInstruction (see Classes).

bat:dueDiligenceReport
    a owl:DatatypeProperty ;
    rdfs:domain bat:Battery ;
    rdfs:range xsd:anyURI ;
    rdfs:label "due diligence report"@en ;
    rdfs:comment "Link to the battery due diligence policy and report on the supply chain, covering the raw materials listed in Annex X (cobalt, natural graphite, lithium, nickel) and the chemical compounds based on them. Migration to the CORE document pattern eudpp:Source (LCA module) is tracked in ontologies-battery#11 and deferred until the LCA module is integrated into the CORE; xsd:anyURI is the agreed interim."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 52 and Annex X; Annex XIII Part C"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

bat:dueDiligenceAudit
    a owl:DatatypeProperty ;
    rdfs:domain bat:Battery ;
    rdfs:range xsd:anyURI ;
    rdfs:label "due diligence audit"@en ;
    rdfs:comment "Link to the third-party verification of the battery due diligence policy, carried out by a notified body. Migration to the CORE document pattern eudpp:Source (LCA module) is tracked in ontologies-battery#11 and deferred until the LCA module is integrated into the CORE; xsd:anyURI is the agreed interim."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Art. 52 and Annex X; Annex XIII Part C"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

bat:dismantlingInformation
    a owl:DatatypeProperty ;
    rdfs:domain bat:Battery ;
    rdfs:range xsd:anyURI ;
    rdfs:label "dismantling information"@en ;
    rdfs:comment "Link to the dismantling documentation: exploded diagrams, disassembly sequences, fastening techniques, required tools, safety warnings, and the number and layout of cells. Migration to the CORE document pattern eudpp:Source (LCA module) is tracked in ontologies-battery#11 and deferred until the LCA module is integrated into the CORE; xsd:anyURI is the agreed interim."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(c)"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

bat:safetyMeasures
    a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:domain bat:Battery ;
    rdfs:range xsd:anyURI ;
    rdfs:label "safety measures"@en ;
    rdfs:seeAlso bat:SafetyInstruction ;
    rdfs:comment "Deprecated on 6 October 2026 and kept for existing data: the safety measures are now a bat:SafetyInstruction, subclass of eudpp:DigitalInstruction (P_DPP), reached through dpp:hasProperty with its URL on dpp:webLink (ontologies-core#45). Link to the safety measures applicable to the battery."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(d)"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

bat:testReportResults
    a owl:DatatypeProperty ;
    rdfs:domain bat:Battery ;
    rdfs:range xsd:anyURI ;
    rdfs:label "test report results"@en ;
    rdfs:comment "Link to the test report results. Access is restricted to notified bodies, market surveillance authorities and the Commission; the restriction is expressed in the SHACL layer, not here. Migration to the CORE document pattern eudpp:Source (LCA module) is tracked in ontologies-battery#11 and deferred until the LCA module is integrated into the CORE; xsd:anyURI is the agreed interim."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 3"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

#################################################
# Datatype Properties - identification
#################################################

bat:partNumber
    a owl:DatatypeProperty ;
    rdfs:domain dpp:Product ;
    rdfs:range xsd:string ;
    rdfs:label "part number"@en ;
    rdfs:comment "Manufacturer part number of a component of the battery, and of the battery itself where one is assigned. Annex XIII 2(b) asks for the part numbers of the components, so the subject is the component and not the battery: CIRPASS-2 decided in June 2026 not to introduce a Component class, a component being a product in its own right, linked to the battery through the CORE property dpp:isComponentOf. The domain is therefore dpp:Product rather than bat:Battery. The property is declared in the battery namespace because the CORE has no cross-sectoral part number; adding one was raised as a recommendation to the Commission. Typed as in the Spherity Battery Pass ontology v0.1, where bp:partNumber is an xsd:string datatype property."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(b); BatteryPass-Ready Data Attribute Long List v1.3, attribute 45; Spherity Battery Pass ontology v0.1, partNumber"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .

#################################################
# Datatype Properties - commercial
#################################################

bat:warrantyPeriod
    a owl:DatatypeProperty ;
    rdfs:domain bat:Battery ;
    rdfs:range xsd:duration ;
    rdfs:label "warranty period"@en ;
    rdfs:comment "Length of the commercial warranty covering the calendar life of the battery, as an ISO 8601 duration - for example \"P24M\" for twenty-four months. Declared in the battery namespace on the decision of 26 August 2026: a cross-sectoral warranty period was requested in CIRPASS-2/ontologies-core#34, but the ESPR does not require one, whereas Regulation (EU) 2023/1542 does, so the term stays sectoral."@en ;
    rdfs:seeAlso <https://github.com/CIRPASS-2/ontologies-core/issues/34> ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 1(m); BatteryPass-Ready Data Attribute Long List v1.3, attribute 17; Spherity Battery Pass ontology v0.1, warrentyPeriod"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery> .
