@prefix batext: <https://w3id.org/eudpp/battery-extinguisher-classes#> .
@prefix batlab: <https://w3id.org/eudpp/battery-labeling#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################
# Ontology
#################################################
# The five extinguisher classes A, B, C, D and F, replacing the free
# text of batlab:extinguishingAgent. skos:notation carries the letter.
#
# REFERENCE STANDARD: EN 2:2005, settled in issue #8 on 26 August 2026.
# BatteryPass-Ready Data Attribute Long List v1.3, attribute 24, pins
# the determination of the fire class to EN 2:2005, which defines
# classes A, B, C, D and F. The earlier class K came from the Spherity
# Battery Pass ontology v0.1 and belongs to NFPA 10 (US); its EN 2
# counterpart is class F, and the concept is renamed accordingly, with
# skos:altLabel keeping the US term so Spherity-sourced data still
# maps. Class C likewise takes its EN 2 reading (flammable gases) and
# no longer the NFPA one (energised electrical equipment); the
# divergence is kept as an editorial note, since it is a mapping trap
# rather than an open question.
#
# RE-CHECK FLAG: ISO 3941:2026 introduces a class L for lithium-ion
# battery fires. EN 2 has no such class. For batteries the class is
# obviously pertinent, so this vocabulary is to be re-checked if EN 2
# is amended, or if the final labelling Implementing Act references a
# different standard.

<https://w3id.org/eudpp/battery-extinguisher-classes>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/eudpp/battery-extinguisher-classes/0.1.1> ;
    rdfs:seeAlso <https://w3id.org/eudpp/battery-labeling> ;
    rdfs:label "EU DPP Battery Extinguisher Classes Vocabulary"@en ;
    dcterms:title "EU DPP Battery Extinguisher Classes Vocabulary"@en ;
    dcterms:description "Controlled vocabulary of the extinguisher classes applicable to a battery, used as the value set of batlab:extinguishingAgent. Replaces the free-text values of the battery-labeling module. The five classes A, B, C, D and F are those of EN 2:2005, the standard to which BatteryPass-Ready long list attribute 24 pins the determination of the fire class."@en ;
    rdfs:comment "Developed against the CIRPASS-2 CORE ontology of October 2026 (P_DPP v2.1.0, MAT v1.1.0). External references are pinned to these versions."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:license "This ontology is licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0). In case of dispute over CC BY 4.0 applicability, or in case considering the ontology as a software or part of it, this ontology is to be considered licensed under the Apache License, Version 2.0."@en ;
    dcterms:bibliographicCitation "EU DPP Battery Extinguisher Classes Vocabulary. Draft version 0.1.1."@en ;
    dcterms:creator "Nader Jelassi"@en , "Marc-Andree Wolf"@en ;
    dcterms:contributor "Arnab Sinha"@en ;
    dcterms:created "2026-08-19"^^xsd:date ;
    dcterms:issued "2026-08-19"^^xsd:date ;
    dcterms:modified "2026-11-03"^^xsd:date ;
    dcterms:references "EN 2:2005, Classification of fires; BatteryPass-Ready Data Attribute Long List v1.3, attribute 24 (Regulation (EU) 2023/1542, Annex VI Part A (9)); Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    owl:versionInfo "Version 0.1.1 DRAFT"@en ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/battery-extinguisher-classes#" ;
    vann:preferredNamespacePrefix "batext" .

#################################################
# Concept Scheme
#################################################

batext:ExtinguisherClassScheme
    a skos:ConceptScheme ;
    rdfs:label "Extinguisher classes applicable to a battery"@en ;
    skos:prefLabel "Extinguisher classes applicable to a battery"@en ;
    skos:scopeNote "Closed list of the five classes of EN 2:2005 \u2014 A, B, C, D and F \u2014 the standard to which BatteryPass-Ready long list attribute 24 pins the determination of the fire class. Two mapping traps for data sourced from NFPA 10 (US), which the Spherity Battery Pass ontology v0.1 follows: NFPA class K is EN 2 class F, kept here as a skos:altLabel on batext:ClassF; and NFPA class C denotes energised electrical equipment where EN 2 class C denotes flammable gases, so the letter C cannot be carried across unchanged."@en ;
    skos:editorialNote "Re-check flag. ISO 3941:2026 introduces a class L for lithium-ion battery fires, which EN 2 does not have. The class is directly pertinent to batteries, so this vocabulary is to be re-checked if EN 2 is amended, or if the final labelling Implementing Act references a standard other than EN 2:2005."@en ;
    skos:hasTopConcept batext:ClassA ,
                       batext:ClassB ,
                       batext:ClassC ,
                       batext:ClassD ,
                       batext:ClassF ;
    dcterms:references "EN 2:2005, Classification of fires; BatteryPass-Ready Data Attribute Long List v1.3, attribute 24; Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

#################################################
# Extinguisher classes — skos:Concept individuals
#################################################
# skos:notation is the letter to be used on the battery label.

batext:ClassA
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "A" ;
    rdfs:label "Extinguisher class A"@en ;
    skos:prefLabel "Extinguisher class A"@en ;
    skos:definition "Fires involving combustible solids. Same scope in EN 2:2005 and in NFPA 10."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

batext:ClassB
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "B" ;
    rdfs:label "Extinguisher class B"@en ;
    skos:prefLabel "Extinguisher class B"@en ;
    skos:definition "Fires involving flammable liquids or liquefiable solids. Same scope in EN 2:2005 and in NFPA 10."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

batext:ClassC
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "C" ;
    rdfs:label "Extinguisher class C"@en ;
    skos:prefLabel "Extinguisher class C"@en ;
    skos:definition "Fires involving flammable gases, per EN 2:2005."@en ;
    skos:editorialNote "Mapping trap. Under NFPA 10 the same letter denotes fires involving energised electrical equipment. The two readings are not interchangeable, so a value of C taken from a US-sourced data set must not be carried across unchecked."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

batext:ClassD
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "D" ;
    rdfs:label "Extinguisher class D"@en ;
    skos:prefLabel "Extinguisher class D"@en ;
    skos:definition "Fires involving combustible metals. Same scope in EN 2:2005 and in NFPA 10; the class most likely to be relevant to lithium battery cells."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

batext:ClassF
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "F" ;
    rdfs:label "Extinguisher class F"@en ;
    skos:prefLabel "Extinguisher class F"@en ;
    skos:altLabel "K (NFPA 10)"@en ;
    skos:definition "Fires involving cooking media (vegetable or animal oils and fats), per EN 2:2005."@en ;
    skos:scopeNote "EN 2:2005 class F and NFPA 10 (US) class K have the same scope. The US letter is kept as skos:altLabel so that data sourced from NFPA 10, such as the Spherity Battery Pass ontology v0.1, still maps onto this concept."@en ;
    skos:editorialNote "Renamed from batext:ClassK on 26 August 2026, when EN 2:2005 was settled as the reference standard in issue #8. Renamed outright rather than deprecated: the namespace has never been published under w3id.org."@en ;
    dcterms:references "EN 2:2005, Classification of fires; Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .
