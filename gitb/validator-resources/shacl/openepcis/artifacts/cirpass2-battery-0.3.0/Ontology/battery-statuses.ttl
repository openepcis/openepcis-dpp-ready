@prefix batstat: <https://w3id.org/eudpp/battery-statuses#> .
@prefix bat: <https://w3id.org/eudpp/battery#> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################
# Ontology
#################################################
# The five battery lifecycle statuses of Annex XIII 4(c), as listed in
# BatteryPass-Ready Data Attribute Long List v1.3, attribute 20.
# skos:notation carries the literal value to be published in the
# passport; skos:prefLabel the display name.
#
# This is the status of the BATTERY as a physical item. It is not the
# status of its passport as a digital resource: that one is carried by
# the CORE property dpp:dppStatus (Active / Archived / Inactive /
# Invalid) on dpp:DPP, and is not restated here.
#
# Unlike the battery categories and chemistries, this vocabulary has no
# CORE anchor: the CORE declares no generic product status. The terms
# are therefore plain skos:Concept individuals, reached through the
# locally declared bat:hasBatteryStatus. If the CORE later generalises
# product status — remanufacturing is ESPR-wide — both the property and
# these individuals are to be re-anchored on it.
#
# Repair is not a status. Annex XIII 4(c) records a repaired battery
# under the "re-used" status, and the repair history itself belongs to
# the CORE event module (dpp:RepairEvent).

<https://w3id.org/eudpp/battery-statuses>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/eudpp/battery-statuses/0.1.1> ;
    rdfs:seeAlso <https://w3id.org/eudpp/battery> ;
    rdfs:label "EU DPP Battery Statuses Vocabulary"@en ;
    dcterms:title "EU DPP Battery Statuses Vocabulary"@en ;
    dcterms:description "The five lifecycle statuses of a battery required by Regulation (EU) 2023/1542, Annex XIII 4(c): original, repurposed, re-used, remanufactured and waste. Value set of bat:hasBatteryStatus. Distinct from the status of the digital passport, which is carried by the cross-sectoral dpp:dppStatus."@en ;
    rdfs:comment "Developed against the CIRPASS-2 CORE ontology of October 2026 (P_DPP v2.1.0, MAT v1.1.0). External references are pinned to these versions."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:license "This ontology is licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0). In case of dispute over CC BY 4.0 applicability, or in case considering the ontology as a software or part of it, this ontology is to be considered licensed under the Apache License, Version 2.0."@en ;
    dcterms:bibliographicCitation "EU DPP Battery Statuses Vocabulary. Draft version 0.1.1."@en ;
    dcterms:creator "Nader Jelassi"@en , "Marc-Andree Wolf"@en ;
    dcterms:contributor "Arnab Sinha"@en ;
    dcterms:created "2026-08-19"^^xsd:date ;
    dcterms:issued "2026-08-19"^^xsd:date ;
    dcterms:modified "2026-11-03"^^xsd:date ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c); BatteryPass-Ready Data Attribute Long List v1.3, attribute 20"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    owl:versionInfo "Version 0.1.1 DRAFT"@en ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/battery-statuses#" ;
    vann:preferredNamespacePrefix "batstat" .

#################################################
# Concept Scheme
#################################################

batstat:BatteryStatusScheme
    a skos:ConceptScheme ;
    rdfs:label "Battery lifecycle statuses per Annex XIII 4(c)"@en ;
    skos:prefLabel "Battery lifecycle statuses per Annex XIII 4(c)"@en ;
    skos:scopeNote "Closed list of five terms. The status is dynamic at individual-battery granularity: it is updated on placing on the market and on every status change. A new battery passport is issued when the battery has been remanufactured, repurposed or subjected to a treatment operation preparing for re-use or repurposing and is placed on the market again; the link back to the previous passport is carried by the CORE, not by this vocabulary: dpp:linkToPreviousDPP, and since P_DPP v2.1.0 the object properties linking a passport to its previous and next passports (ontologies-core#56). Access to the battery status is restricted to persons with a legitimate interest — a conformance rule expressed in the SHACL shapes, not in this ontology."@en ;
    skos:hasTopConcept batstat:Original ,
                       batstat:Repurposed ,
                       batstat:ReUsed ,
                       batstat:Remanufactured ,
                       batstat:Waste ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c); BatteryPass-Ready Data Attribute Long List v1.3, attribute 20"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses> .

#################################################
# Statuses — skos:Concept individuals
#################################################
# skos:notation is the literal value to be published in the passport.

batstat:Original
    a skos:Concept ;
    skos:inScheme batstat:BatteryStatusScheme ;
    skos:topConceptOf batstat:BatteryStatusScheme ;
    skos:notation "original" ;
    rdfs:label "Original"@en ;
    skos:prefLabel "Original"@en ;
    skos:definition "The battery is in its first life, as placed on the market by the manufacturer, and has not been subjected to re-use, repurposing or remanufacturing."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses> .

batstat:Repurposed
    a skos:Concept ;
    skos:inScheme batstat:BatteryStatusScheme ;
    skos:topConceptOf batstat:BatteryStatusScheme ;
    skos:notation "repurposed" ;
    rdfs:label "Repurposed"@en ;
    skos:prefLabel "Repurposed"@en ;
    skos:definition "The battery has been subjected to repurposing and placed on the market again for a purpose or application other than the one it was originally designed for."@en ;
    skos:editorialNote "The definition of 'repurposing' is in Art. 3(1) of Regulation (EU) 2023/1542; the point number is to be confirmed against the consolidated text."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses> .

batstat:ReUsed
    a skos:Concept ;
    skos:inScheme batstat:BatteryStatusScheme ;
    skos:topConceptOf batstat:BatteryStatusScheme ;
    skos:notation "re-used" ;
    rdfs:label "Re-used"@en ;
    skos:prefLabel "Re-used"@en ;
    skos:altLabel "reused"@en ;
    skos:definition "The battery has been subjected to a treatment operation preparing it for re-use and placed on the market again for the purpose it was originally designed for."@en ;
    skos:scopeNote "A repaired battery is recorded under this status, with the repair itself made transparent through the repair history. The history belongs to the CORE event module (dpp:RepairEvent); no 'repaired' status is declared here."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses> .

batstat:Remanufactured
    a skos:Concept ;
    skos:inScheme batstat:BatteryStatusScheme ;
    skos:topConceptOf batstat:BatteryStatusScheme ;
    skos:notation "remanufactured" ;
    rdfs:label "Remanufactured"@en ;
    skos:prefLabel "Remanufactured"@en ;
    skos:definition "The battery has been subjected to remanufacturing and placed on the market again."@en ;
    skos:editorialNote "Remanufacturing is an ESPR-wide notion, not a battery-specific one. This is the concept most likely to move to the CORE if a generic product status is introduced."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses> .

batstat:Waste
    a skos:Concept ;
    skos:inScheme batstat:BatteryStatusScheme ;
    skos:topConceptOf batstat:BatteryStatusScheme ;
    skos:notation "waste" ;
    rdfs:label "Waste"@en ;
    skos:prefLabel "Waste"@en ;
    skos:definition "The battery is a waste battery: it is discarded or intended to be discarded, and is no longer placed on the market as a battery."@en ;
    skos:scopeNote "Reaching this status does not by itself deactivate the passport. Passport deactivation is a property of the digital resource, carried by dpp:dppStatus on dpp:DPP."@en ;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses> .
