<https://ref.openepcis.org/extensions/eu/electronics/shapes/> a sh:ShapesGraph;
    dcterms:title "OpenEPCIS Electronics SHACL Shapes"@en;
    dcterms:description "SHACL validation shapes for Electronics vocabulary."@en;
    dcterms:created "2025-02-02"^^xsd:date;
    dcterms:modified "2026-06-07"^^xsd:date.
<https://ref.openepcis.org/extensions/eu/electronics/ElectronicDeviceShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/electronics/ElectronicDevice>;
    sh:property _:b180, _:b181, _:b182, _:b183, _:b184, _:b185, _:b186, _:b187, _:b188, _:b189, _:b190;
    rdfs:label "Electronic Device Shape";
    rdfs:comment "Validation shape for ElectronicDevice instances as defined by ESPR Electronics delegated acts.".
_:b180 sh:name "Device Category";
    sh:description "The product category of the electronic device.";
    sh:path schema:category;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/DeviceCategory>;
    sh:maxCount 1.
_:b181 sh:name "Model Identifier";
    sh:description "Manufacturer model identifier for the device.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/modelIdentifier>;
    sh:maxCount 1;
    sh:datatype xsd:string.
_:b182 sh:name "Commercial Name";
    sh:description "Commercial or trade name of the device.";
    sh:path _:b191;
    sh:node dpp-sh:TranslatableText.
_:b183 sh:name "Repairability Index";
    sh:description "Repairability index assessment for the device.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasRepairabilityIndex>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/RepairabilityIndex>.
_:b184 sh:name "Software Support";
    sh:description "Software and firmware support information.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasSoftwareSupport>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/SoftwareSupport>.
_:b185 sh:name "Energy Efficiency";
    sh:description "Energy efficiency rating and consumption data.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasEnergyEfficiency>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/EnergyEfficiency>.
_:b186 sh:name "Bill of Materials";
    sh:description "Component bill of materials for the device.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasBillOfMaterials>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/ComponentBOM>.
_:b187 sh:name "WEEE Compliance";
    sh:description "Waste Electrical and Electronic Equipment compliance data.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasWeeeCompliance>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/WEEECompliance>.
_:b188 sh:name "RoHS Compliance";
    sh:description "Restriction of Hazardous Substances compliance data.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasRohsCompliance>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/RoHSCompliance>.
_:b189 sh:name "Display Specification";
    sh:description "Display panel technical specifications.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasDisplaySpecification>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/DisplaySpecification>.
_:b190 sh:name "Material Declaration";
    sh:description "Declared substances of concern present in the device.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasMaterialDeclaration>;
    sh:class oec:SubstanceOfConcern.
<https://ref.openepcis.org/extensions/eu/electronics/RepairabilityIndexShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/electronics/RepairabilityIndex>;
    sh:property _:b192, _:b193, _:b194, _:b195, _:b196, _:b197, _:b198;
    rdfs:label "Repairability Index Shape";
    rdfs:comment "Validation shape for repairability index assessments per EU methodology.".
_:b192 sh:name "Total Score";
    sh:description "Overall repairability score from 0 to 100.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/totalScore>;
    sh:maxCount 1;
    sh:message "Total score must be a decimal between 0 and 100.";
    sh:datatype xsd:decimal;
    sh:minInclusive 0;
    sh:maxInclusive 100.
_:b193 sh:name "Display Score";
    sh:description "Simplified repairability score from 0 to 10 shown on the label.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/displayScore>;
    sh:maxCount 1;
    sh:message "Display score must be a decimal between 0 and 10.";
    sh:datatype xsd:decimal;
    sh:minInclusive 0;
    sh:maxInclusive 10.
_:b194 sh:name "Repairability Class";
    sh:description "EU repairability class designation.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasRepairabilityClass>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/EURepairabilityClass>;
    sh:maxCount 1.
_:b195 sh:name "Repair Criteria";
    sh:description "Individual repair criteria scores contributing to the index.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasRepairCriteria>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/RepairCriterion>.
_:b196 sh:name "Assessment Date";
    sh:description "Date the repairability assessment was performed.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/assessmentDate>;
    sh:maxCount 1;
    sh:datatype xsd:date.
_:b197 sh:name "Assessment Body";
    sh:description "Organization that performed the repairability assessment.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasAssessmentBody>;
    sh:class gs1:Organization;
    sh:maxCount 1.
_:b198 sh:name "Repairability Label URL";
    sh:description "URL of the repairability label image.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/repairabilityLabelUrl>;
    sh:maxCount 1;
    sh:datatype xsd:anyURI.
<https://ref.openepcis.org/extensions/eu/electronics/RepairCriterionShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/electronics/RepairCriterion>;
    sh:property _:b199, _:b200, _:b201, _:b202;
    rdfs:label "Repair Criterion Shape";
    rdfs:comment "Validation shape for individual repair criterion scores.".
_:b199 sh:name "Criterion Type";
    sh:description "The type of repair criterion being scored.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasCriterionType>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/RepairCriterionType>;
    sh:maxCount 1;
    sh:minCount 1.
_:b200 sh:name "Criterion Score";
    sh:description "Score awarded for this criterion, from 0 to 20.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/criterionScore>;
    sh:maxCount 1;
    sh:message "Criterion score must be a decimal between 0 and 20.";
    sh:datatype xsd:decimal;
    sh:minInclusive 0;
    sh:minCount 1;
    sh:maxInclusive 20.
_:b201 sh:name "Criterion Max Score";
    sh:description "Maximum possible score for this criterion.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/criterionMaxScore>;
    sh:maxCount 1;
    sh:datatype xsd:decimal.
_:b202 sh:name "Criterion Details";
    sh:description "Textual details or justification for the score.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/criterionDetails>;
