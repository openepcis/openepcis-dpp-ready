<https://ref.openepcis.org/extensions/eu/electronics/shapes/> a sh:ShapesGraph;
    dcterms:title "OpenEPCIS Electronics SHACL Shapes"@en;
    dcterms:description "SHACL validation shapes for Electronics vocabulary."@en;
    dcterms:created "2025-02-02"^^xsd:date;
    dcterms:modified "2026-06-07"^^xsd:date.
<https://ref.openepcis.org/extensions/eu/electronics/ElectronicDeviceShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/electronics/ElectronicDevice>;
    sh:property _:b191, _:b192, _:b193, _:b194, _:b195, _:b196, _:b197, _:b198, _:b199, _:b200, _:b201;
    rdfs:label "Electronic Device Shape";
    rdfs:comment "Validation shape for ElectronicDevice instances as defined by ESPR Electronics delegated acts.".
_:b191 sh:name "Device Category";
    sh:description "The product category of the electronic device.";
    sh:path schema:category;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/DeviceCategory>;
    sh:maxCount 1.
_:b192 sh:name "Model Identifier";
    sh:description "Manufacturer model identifier for the device.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/modelIdentifier>;
    sh:maxCount 1;
    sh:datatype xsd:string.
_:b193 sh:name "Commercial Name";
    sh:description "Commercial or trade name of the device.";
    sh:path _:b202;
    sh:node dpp-sh:TranslatableText.
_:b194 sh:name "Repairability Index";
    sh:description "Repairability index assessment for the device.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasRepairabilityIndex>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/RepairabilityIndex>.
_:b195 sh:name "Software Support";
    sh:description "Software and firmware support information.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasSoftwareSupport>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/SoftwareSupport>.
_:b196 sh:name "Energy Efficiency";
    sh:description "Energy efficiency rating and consumption data.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasEnergyEfficiency>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/EnergyEfficiency>.
_:b197 sh:name "Bill of Materials";
    sh:description "Component bill of materials for the device.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasBillOfMaterials>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/ComponentBOM>.
_:b198 sh:name "WEEE Compliance";
    sh:description "Waste Electrical and Electronic Equipment compliance data.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasWeeeCompliance>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/WEEECompliance>.
_:b199 sh:name "RoHS Compliance";
    sh:description "Restriction of Hazardous Substances compliance data.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasRohsCompliance>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/RoHSCompliance>.
_:b200 sh:name "Display Specification";
    sh:description "Display panel technical specifications.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasDisplaySpecification>;
    sh:class <https://ref.openepcis.org/extensions/eu/electronics/DisplaySpecification>.
_:b201 sh:name "Material Declaration";
    sh:description "Declared substances of concern present in the device.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/hasMaterialDeclaration>;
    sh:class oec:SubstanceOfConcern.
<https://ref.openepcis.org/extensions/eu/electronics/RepairabilityIndexShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/electronics/RepairabilityIndex>;
    sh:property _:b203, _:b204, _:b205;
    rdfs:label "Repairability Index Shape";
    rdfs:comment "A repairability index applies the French index method; criterion results, scores and class follow the common/assessment shapes.".
_:b203 sh:name "Method";
    sh:path <https://ref.openepcis.org/extensions/common/assessment/hasMethod>;
    sh:message "euelec:RepairabilityIndex applies euelec:FrenchRepairabilityIndexMethod."@en;
    sh:hasValue <https://ref.openepcis.org/extensions/eu/electronics/FrenchRepairabilityIndexMethod>.
_:b206 rdf:first <https://ref.openepcis.org/extensions/common/assessment/hasResult>;
    rdf:rest _:b207.
_:b207 rdf:first <https://ref.openepcis.org/extensions/common/assessment/awardedScore>;
    rdf:rest rdf:nil.
_:b204 sh:name "Criterion Score";
    sh:path _:b206;
    sh:message "A criterion score is a decimal between 0 and 20.";
    sh:datatype xsd:decimal;
    sh:minInclusive 0;
    sh:maxInclusive 20.
_:b205 sh:name "Repairability Label URL";
    sh:description "URL of the repairability label image.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/repairabilityLabelUrl>;
    sh:maxCount 1;
    sh:datatype xsd:anyURI.
<https://ref.openepcis.org/extensions/eu/electronics/SoftwareSupportShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/electronics/SoftwareSupport>;
    sh:property _:b208, _:b209, _:b210, _:b211, _:b212, _:b213, _:b214, _:b215, _:b216;
    rdfs:label "Software Support Shape";
    rdfs:comment "Validation shape for software and firmware support commitments.".
_:b208 sh:name "Operating System";
    sh:description "Name of the operating system.";
    sh:path schema:operatingSystem;
    sh:maxCount 1;
    sh:datatype xsd:string.
_:b209 sh:name "OS Version";
    sh:description "Version of the operating system at time of manufacture.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/osVersion>;
    sh:maxCount 1;
    sh:datatype xsd:string.
_:b210 sh:name "Firmware Version";
    sh:description "Current firmware version identifier.";
    sh:path <https://ref.openepcis.org/extensions/eu/electronics/firmwareVersion>;
    sh:maxCount 1;
    sh:datatype xsd:string.
