    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:CarbonFootprintDeclaration.
oec:hasCarbonFootprintEndOfLife a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>, oec:carbonFootprintTotal, <https://dpp-keystone.org/spec/v3/terms#carbonFootprintAbsolute>, <https://dpp-keystone.org/spec/v3/terms#environmentalFootprint>, <https://dpp-keystone.org/spec/v3/terms#carbonFootprint>;
