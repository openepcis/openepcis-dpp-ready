    skos:exactMatch <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContentPercentage>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContent>, <urn:samm:io.BatteryPass.Circularity:1.2.0#preConsumerShare>;
    skos:broadMatch <https://w3id.org/eudpp#materialRecycledContent>;
    rdfs:range xsd:decimal;
    rdfs:domain oec:RecycledContent.
