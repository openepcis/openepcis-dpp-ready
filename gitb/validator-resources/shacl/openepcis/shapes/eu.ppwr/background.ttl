oec:RecyclabilityAssessment a owl:Class;
    rdfs:seeAlso <https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment>;
    rdfs:subClassOf <https://ref.openepcis.org/extensions/common/assessment/Assessment>;
    rdfs:label "Recyclability Assessment"@en;
    rdfs:comment "An assessment of a product's recyclability, an oea:Assessment. Regulations express the\noutcome differently, and each form has its place in the assessment model: a score (JRC textile 0-10,\nPPWR percentage) or a grade (PPWR A/B/C) is an oea:Indicator of kind oea:RecyclabilityScore; a\nrecyclability, recoverable or collection rate is an oea:MeasurementResult observing oea:RecyclabilityRate,\noea:RecoverableRate or oea:RecyclingCollectionRate; the methodology is oea:hasMethod; whether the product\ncounts as recyclable is oea:hasOutcome."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch <https://vocabulary.uncefact.org/untp/ConformityAssessment>.
oec:hasRecyclabilityAssessment a owl:ObjectProperty;
    rdfs:label "Recyclability Assessment"@en;
    rdfs:comment "Links a product to its recyclability assessment."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:exactMatch <https://w3id.org/eudpp/textile-recyclability#hasRecyclabilityAssessment>;
    rdfs:range oec:RecyclabilityAssessment;
    rdfs:subPropertyOf <https://ref.openepcis.org/extensions/common/assessment/hasAssessment>.
oec:ProductToPackagingRatio a <https://ref.openepcis.org/extensions/common/assessment/IndicatorKind>;
    rdfs:seeAlso gs1:netWeight, <https://w3id.org/eudpp#ProductToPackagingRatio>;
    rdfs:label "Product-to-Packaging Ratio"@en;
    rdfs:comment "Ratio of product weight to total packaging weight, indicating packaging efficiency (unitCode C62). Replaces oec:productToPackagingRatio."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "ESPR Annex I ecodesign parameter; PPWR Annex IV minimisation assessments need the same figure. GS1 carries product and packaging weights separately (gs1:netWeight, gs1:packaging) but publishes no ratio."@en.
oec:WasteGeneration a <https://ref.openepcis.org/extensions/common/assessment/IndicatorKind>;
    rdfs:seeAlso <https://w3id.org/eudpp#WasteGenerationAmount>, <https://w3id.org/eudpp#HazardousWasteAmount>;
    rdfs:label "Waste Generation"@en;
    rdfs:comment "Quantity of waste generated over the product life cycle per declared unit, including hazardous fractions (unitCode KGM). Replaces oec:wasteGenerationAmount."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "ESPR Annex I ecodesign parameter. Life-cycle scoped like oec:carbonFootprintTotal, not an EN 15804 impact category."@en.
oec:PackagingWaste a <https://ref.openepcis.org/extensions/common/assessment/IndicatorKind>;
    rdfs:seeAlso oec:ProductToPackagingRatio, <https://w3id.org/eudpp#PackagingWasteAmount>;
    rdfs:label "Packaging Waste"@en;
    rdfs:comment "Quantity of packaging waste generated per declared unit (unitCode KGM). Replaces oec:packagingWasteAmount."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "ESPR Annex I ecodesign parameter; PPWR reporting needs the same figure per packaging unit."@en.
oec:WaterConsumption a <https://ref.openepcis.org/extensions/common/assessment/IndicatorKind>;
    rdfs:seeAlso oec:WDP, <https://w3id.org/eudpp#WaterConsumptionResult>;
    rdfs:label "Water Consumption"@en;
    rdfs:comment "Net fresh water consumed over the product life cycle per declared unit (unitCode MTQ). Replaces oec:waterConsumption."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "ESPR Annex I ecodesign parameter (water use). The EN 15804 category oec:WDP is the deprivation-weighted impact; this is the plain consumed volume."@en;
    skos:closeMatch <https://dpp-keystone.org/spec/v3/terms/epd#fw>.
oec:WDP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#wdp>;
    rdfs:label "Water (user) deprivation potential"@en;
    skos:notation "WDP".
oec:LandUse a <https://ref.openepcis.org/extensions/common/assessment/IndicatorKind>;
    rdfs:seeAlso <https://w3id.org/eudpp#LandUseResult>;
    rdfs:label "Land Use"@en;
    rdfs:comment "Land area occupied or transformed over the product life cycle per declared unit (unitCode MTK). Replaces oec:landUse."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "ESPR Annex I ecodesign parameter; EUDR geolocation (eudr:) covers plot provenance, this the quantitative footprint."@en.
oec:MaterialFootprint a <https://ref.openepcis.org/extensions/common/assessment/IndicatorKind>;
    rdfs:seeAlso <https://w3id.org/eudpp#MaterialFootprint>, <https://w3id.org/eudpp#InventoryIndicatorResult>;
    rdfs:label "Material Footprint"@en;
    rdfs:comment "Total raw material input mobilised over the product life cycle per declared unit (unitCode KGM). Replaces oec:materialFootprint."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "ESPR Annex I ecodesign parameter (resource use). Distinct from oec:hasMaterialComposition, which lists what is in the product; the footprint counts what was consumed to make it."@en.
oec:EnergyEfficiency a owl:Class;
