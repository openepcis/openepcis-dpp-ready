oec:recycledContent a owl:DatatypeProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledContent>, <https://dpp-keystone.org/spec/v3/terms#postConsumerRecycledContentPercentage>, <https://dpp-keystone.org/spec/v3/terms#packagingRecycledContent>;
    rdfs:label "Recycled Content"@en;
    rdfs:comment "Total fraction of recycled content (0-1 scale where 0.45 = 45%)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Value is a decimal fraction 0-1. Aligned with UNTP recycledContent."@en;
    skos:exactMatch <https://dpp-keystone.org/spec/v3/terms#recycledContentPercentage>;
    skos:broadMatch <https://dpp-keystone.org/spec/v3/terms#postConsumerRecycledContent>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContentPercentage>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContent>;
    skos:closeMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledContent>;
    rdfs:range xsd:decimal;
    rdfs:domain oec:RecycledContent.
oec:preConsumerRecycledContent a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.org/extensions/common/assessment/RecyclabilityRate>, <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledContent>, <https://vocabulary.uncefact.org/untp/recycledMassFraction>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContent>, gs1:textileMaterialContent;
