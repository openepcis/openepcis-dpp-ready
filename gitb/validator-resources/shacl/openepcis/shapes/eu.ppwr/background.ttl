oec:hasCarbonFootprint a owl:ObjectProperty;
    rdfs:seeAlso <https://gs1.eu/wp-content/uploads/2025/02/GDSN-Implementation-Guideline-for-exchanging-Carbon-Footprint-Data-3.pdf>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#absoluteCarbonFootprint>;
    rdfs:label "Carbon Footprint"@en;
    rdfs:comment "Carbon footprint measurement for the product."@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Required extension: GS1 GDSN provides carbon footprint attributes but they are not\nyet part of GS1 Web Vocabulary. This property aligns with the GDSN CFP Implementation Guideline.\nUse gs1:QuantitativeValue for the measurement value with appropriate unitCode."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>;
    rdfs:range gs1:QuantitativeValue.
oec:carbonFootprintTotal a owl:DatatypeProperty;
    rdfs:seeAlso <https://gs1.eu/wp-content/uploads/2025/02/GDSN-Implementation-Guideline-for-exchanging-Carbon-Footprint-Data-3.pdf>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>, oec:hasCarbonFootprintProduction;
    rdfs:label "Carbon Footprint Total"@en;
    rdfs:comment "Total lifecycle carbon footprint in kg CO2e. Aligned with UNTP carbonFootprint."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Aligned with GDSN CarbonFootprintHeader/cfpValue and UNTP carbonFootprint. Value in kg CO2 equivalent."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#absoluteCarbonFootprint>;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>;
    rdfs:range xsd:decimal.
oec:hasCarbonFootprintProduction a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#absoluteCarbonFootprint>, oec:carbonFootprintTotal, <https://dpp-keystone.org/spec/v3/terms#carbonFootprint>;
    rdfs:label "Carbon Footprint: Production"@en;
    rdfs:comment "Lifecycle stage emissions from main product production. gs1:QuantitativeValue with unitCode 'KGM'."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting carbon / emissions performance pattern aligned with ESPR 2024/1781 and the UN Transparency Protocol (UNTP)."@en;
    skos:exactMatch <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#contributionOfMainProductProductionLifecycleStage>;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain oec:CarbonFootprintDeclaration.
oec:declaredUnit a owl:DatatypeProperty;
    rdfs:label "Declared Unit"@en;
    rdfs:comment "Functional unit for carbon footprint or other metrics (e.g., kg CO2e/kWh, kg CO2e/kg). Aligned with UNTP declaredUnit."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
