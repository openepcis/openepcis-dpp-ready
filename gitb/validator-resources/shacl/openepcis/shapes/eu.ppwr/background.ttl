oec:hasMaterialComposition a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#postConsumerRecycledMaterialComposition>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledMaterialComposition>, gs1:textileMaterialContent, <https://dpp-keystone.org/spec/v3/terms#fibreComposition>, <https://dpp-keystone.org/spec/v3/terms#packagingMaterialCompositionQuantity>, gs1:textileMaterialDescription, gs1:packagingMaterial, gs1:packagingMaterialType, <https://dpp-keystone.org/spec/v3/terms#packagingMaterialType>, <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledMaterial>, gs1:upperMaterialType;
    rdfs:label "Material Composition"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
