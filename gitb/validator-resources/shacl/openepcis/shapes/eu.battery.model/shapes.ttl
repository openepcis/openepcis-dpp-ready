<https://ref.openepcis.org/extensions/eu/battery/shapes/> a sh:ShapesGraph;
    dcterms:title "OpenEPCIS Battery SHACL Shapes"@en;
    dcterms:description "SHACL validation shapes for Battery Digital Product Passport vocabulary, aligned with BatteryPass-Ready Data Attribute Longlist v1.3 (March 2026)."@en;
    dcterms:created "2025-02-02"^^xsd:date;
    dcterms:modified "2026-06-07"^^xsd:date.
<https://ref.openepcis.org/extensions/eu/battery/BatteryShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/battery/Battery>;
    sh:property _:b181, _:b182, _:b183, _:b184, _:b185, _:b186, _:b187, _:b188, _:b189, _:b190, _:b191, _:b192, _:b193, _:b194, _:b195, _:b196, _:b197, _:b198, _:b199, _:b200;
    rdfs:label "Battery Shape";
    rdfs:comment "Validation shape for Battery instances as defined by EU Battery Regulation 2023/1542.".
_:b181 sh:name "Battery Category";
    sh:description "The regulatory category of the battery (LMT, EV, Industrial, Stationary).";
    sh:path schema:category;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/BatteryCategory>;
    sh:maxCount 1.
_:b182 sh:name "Battery Status";
    sh:description "Current lifecycle status of the battery.";
    sh:path schema:status;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/BatteryStatus>;
    sh:maxCount 1.
_:b183 sh:name "Battery Chemistry";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/hasBatteryChemistry>;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/BatteryChemistry>.
_:b184 sh:name "Technical Specifications";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/hasTechnicalSpecifications>;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification>.
_:b185 sh:name "Material Composition";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/hasMaterialComposition>;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/BatteryMaterial>.
_:b186 sh:name "Recycled Content";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/hasRecycledContent>;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/RecycledContent>.
_:b187 sh:name "End of Life Information";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/hasEndOfLifeInfo>;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/EndOfLifeInfo>.
_:b188 sh:name "Hazardous Substances";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/hasHazardousSubstances>;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/HazardousSubstance>.
_:b189 sh:name "Operator Information";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/hasOperatorInformation>;
    sh:class oec:OperatorInformation.
_:b190 sh:name "Supply Chain Due Diligence";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/hasSupplyChainDueDiligence>;
    sh:class <https://ref.openepcis.org/extensions/eu/battery/SupplyChainDueDiligence>.
_:b191 sh:name "Battery Model Identifier";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#7). Manufacturer-assigned model ID; referenced by the carbon footprint declaration.";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/batteryModelIdentifier>;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:minCount 1.
_:b192 sh:name "Battery Serial Number";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#8) at item granularity. Required on the Declaration of Conformity.";
    sh:path gs1:hasSerialNumber;
    sh:maxCount 1;
    sh:datatype xsd:string.
_:b193 sh:name "Facility Identifier";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#11). Recommend GLN of the gs1:Place referenced by eubat:hasManufacturingPlace.";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/facilityIdentifier>;
    sh:datatype xsd:string.
_:b194 sh:name "Economic Operator Identifier";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#9). Access-restricted (AuthorizedOnly).";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/operatorIdentifier>;
    sh:datatype xsd:string.
_:b195 sh:name "Manufacturer Identifier";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#10). Access-restricted (AuthorizedOnly).";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/manufacturerIdentifier>;
    sh:datatype xsd:string.
_:b196 sh:name "Manufacturer Information";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#13).";
    sh:path gs1:manufacturer;
    sh:or _:b201.
_:b201 rdf:first _:b202;
    rdf:rest _:b203.
_:b202 sh:class oec:OperatorInformation.
_:b203 rdf:first _:b204;
    rdf:rest _:b205.
_:b204 sh:class gs1:Organization.
_:b205 rdf:first _:b206;
    rdf:rest rdf:nil.
_:b206 sh:nodeKind sh:IRI.
_:b197 sh:name "DPP Schema Version";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#1). Identifies the schema version this DPP instance follows (e.g. \"1.3\").";
    sh:path schema:schemaVersion;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:minCount 1.
_:b198 sh:name "DPP Status";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#2). EN 18223 dppStatus.";
    sh:path oec:passportStatus;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in _:b207;
    sh:minCount 1.
_:b207 rdf:first "active";
    rdf:rest _:b208.
_:b208 rdf:first "inactive";
    rdf:rest _:b209.
_:b209 rdf:first "archived";
    rdf:rest _:b210.
_:b210 rdf:first "invalid";
    rdf:rest _:b211.
_:b211 rdf:first "draft";
    rdf:rest _:b212.
_:b212 rdf:first "withdrawn";
    rdf:rest _:b213.
_:b213 rdf:first "suspended";
    rdf:rest rdf:nil.
_:b199 sh:name "DPP Reporting Granularity";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#3).";
    sh:path oec:hasReportingGranularity;
    sh:class oec:DPPGranularity;
    sh:maxCount 1;
    sh:minCount 1.
_:b200 sh:name "Date-time of latest update";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#4). Updated whenever any passport attribute changes.";
    sh:path oec:lastUpdated;
    sh:maxCount 1;
    sh:datatype xsd:dateTime;
    sh:minCount 1.
<https://ref.openepcis.org/extensions/eu/battery/CarbonFootprintDeclarationShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/battery/CarbonFootprintDeclaration>;
    sh:property _:b214, _:b215, _:b216;
