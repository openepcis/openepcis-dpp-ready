    dcterms:modified "2026-06-07"^^xsd:date.
<https://ref.openepcis.org/extensions/eu/eudr/OriginDeclarationShape> a sh:NodeShape;
    sh:property _:b179, _:b180, _:b181, _:b182, _:b183, _:b184, _:b185, _:b186, _:b187, _:b188, _:b189, _:b190;
