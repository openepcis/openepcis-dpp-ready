_:b201 rdf:first _:b202;
    rdf:rest _:b203.
_:b202 sh:class oec:OperatorInformation.
_:b203 rdf:first _:b204;
    rdf:rest _:b205.
_:b204 sh:class gs1:Organization.
_:b205 rdf:first _:b206;
    rdf:rest rdf:nil.
_:b206 sh:nodeKind sh:IRI.
_:b197 sh:name "DPP Schema Version";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#1). Identifies the schema version this DPP instance follows (e.g. \"1.3\").";
    sh:path schema:schemaVersion;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:minCount 1.
_:b198 sh:name "DPP Status";
