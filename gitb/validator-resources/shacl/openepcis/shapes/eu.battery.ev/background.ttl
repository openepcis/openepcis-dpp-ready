    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#sparePartSources>, <https://dpp-keystone.org/spec/v3/terms#sparePartsSources>, <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#informationOnSourcesOfSpareParts>;
    skos:broadMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#sparePartReplacementDetails>;
    rdfs:range gs1:Organization;
    rdfs:domain gs1:Product.
<https://ref.openepcis.org/extensions/eu/battery/spareParts> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-47>, schema:mpn;
    rdfs:label "Spare Parts"@en;
    rdfs:comment "Part numbers of the battery's components, listed as the spare-part component identifiers available from this supplier."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute: the part numbers for components reserved for persons with a legitimate interest. No GS1 or schema.org equivalent (schema:mpn / schema:sku identify the product itself, not its components)."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#sparePartSources>, <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#sparePartReplacementDetails>;
    rdfs:range rdf:langString;
    rdfs:domain gs1:Organization.
<https://ref.openepcis.org/extensions/eu/battery/hasSupplierContact> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-47>, <http://data.europa.eu/m8g/ContactPoint>, <http://data.europa.eu/m8g/contactPoint>, <urn:samm:io.BatteryPass.Circularity:1.2.0#emailAddressOfSupplier>;
    rdfs:label "Supplier Contact"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "gs1:ContactPoint is range-equivalent to cv:ContactPoint (EU SEMICeu CPOV). Either is acceptable; cv:ContactPoint is the EU-portal canonical for recall coordinators / customer service / regulatory liaison."@en;
    skos:narrowMatch gs1:afterHoursContact;
    skos:broadMatch <http://data.europa.eu/m8g/contactPoint>, schema:contactPoint, gs1:contactPoint;
    rdfs:range gs1:ContactPoint;
    rdfs:domain gs1:Organization.
