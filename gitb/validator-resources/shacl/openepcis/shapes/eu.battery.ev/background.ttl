<https://ref.openepcis.org/extensions/eu/battery/numberOfDeepDischargeEvents> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.org/extensions/eu/battery/DeepDischarge>, <https://ref.openepcis.org/extensions/eu/battery/hasNegativeEvents>;
    rdfs:label "Number of Deep Discharge Events"@en;
    rdfs:comment "Cumulative count of deep-discharge events recorded over the battery lifetime."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "Negative-event counter belonging to the same flat cumulative-counter family as eubat:timeSpentInExtremeTemperaturesAboveBoundary: a single lifetime total the BatteryPass-Ready longlist and the GEFEG live validator carry as one number, where eubat:hasNegativeEvents / eubat:DeepDischarge carry the individually dated events. Neither GS1, SEMICeu nor schema.org has a deep-discharge counter."@en;
    skos:exactMatch <https://w3id.org/eudpp/battery-performance#numberOfDeepDischargeEvents>, <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#numberOfDeepDischargeEvents>, <https://dpp-keystone.org/spec/v3/terms#eventsDeepDischarge>;
    skos:broadMatch <urn:samm:io.BatteryPass.Performance:1.2.1#negativeEvents>;
    rdfs:range xsd:integer;
    rdfs:domain gs1:Product;
    skos:broader <https://ref.openepcis.org/extensions/eu/battery/hasNegativeEvents>.
<https://ref.openepcis.org/extensions/eu/battery/hasNegativeEvents> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-69>, <https://dpp-keystone.org/spec/v3/terms#negativeEvents>;
    rdfs:label "Negative Events"@en;
    rdfs:comment "Log of safety- or performance-relevant negative events recorded over the battery lifetime: accident, thermal event, deep discharge, short circuit, etc. Range is the existing eubat:NegativeEvent class."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "BatteryPass-Ready v1.3 (current canonical SAMM submodel: urn:samm:io.BatteryPass.Performance:1.2.0#negativeEvents). eubat:NegativeEvent already declared with a typed enumeration of incident classes (Accident / PhysicalDamage / ThermalEvent / ElectricalFault / WaterIngress / Overcharge / DeepDischarge / ShortCircuit)."@en;
    skos:exactMatch <https://dpp-keystone.org/spec/v3/terms#negativeEvents>, <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#negativeEvents>;
    skos:narrowMatch <https://dpp-keystone.org/spec/v3/terms#eventsDeepDischarge>, <https://dpp-keystone.org/spec/v3/terms#eventsOvercharge>;
    skos:closeMatch <urn:samm:io.BatteryPass.Performance:1.2.1#negativeEvents>, <urn:samm:io.BatteryPass.Performance:1.2.1#negativeEvent>;
    rdfs:range <https://ref.openepcis.org/extensions/eu/battery/NegativeEvent>;
    rdfs:domain oec:PerformanceInfo.
