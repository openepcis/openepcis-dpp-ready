<https://ref.openepcis.org/extensions/eu/battery/hasCurrentSelfDischargingRate> a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#selfDischargeEvolution>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-65>, <https://dpp-keystone.org/spec/v3/terms#selfDischargeCurrent>;
    rdfs:label "Current Self-Discharging Rate"@en;
