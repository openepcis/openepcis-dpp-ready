_:b132 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Binder>;
    rdf:rest _:b133.
<https://ref.openepcis.org/extensions/eu/battery/Binder> a <https://ref.openepcis.org/extensions/eu/battery/MaterialCategory>;
