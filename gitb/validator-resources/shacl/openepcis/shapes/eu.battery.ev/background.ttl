oec:hasEnergyEfficiencyClass a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#energyEfficiencyClass>, schema:energyEfficiencyScaleMin;
    rdfs:label "Energy Efficiency Class"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
