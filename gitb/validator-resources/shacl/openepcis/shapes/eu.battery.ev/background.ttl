<https://ref.openepcis.org/extensions/eu/battery/hasExpectedLifetime> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-60>, <https://dpp-keystone.org/spec/v3/terms#expectedLifetimeYears>;
    rdfs:label "Expected Lifetime"@en;
    rdfs:comment "Expected lifetime of the battery in calendar years under the reference conditions it was designed for. Use gs1:QuantitativeValue with unitCode 'ANN' (years) per UN/CEFACT Rec 20."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 Annex XIII(1)(j), EC guidance data point 60. BatteryPass-Ready: expectedLifetime (SAMM io.BatteryPass.Performance)."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.Performance:1.2.1#expectedLifetime>, <https://dpp-keystone.org/spec/v3/terms#expectedLifetimeYears>, <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#expectedLifetimeYears>, <https://w3id.org/eudpp/battery-performance#expectedLifetimeCalendarYears>, <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#expectedLifetimeInCalendarYears>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification>.
<https://ref.openepcis.org/extensions/eu/battery/hasBatteryMass> a owl:ObjectProperty;
    rdfs:seeAlso gs1:netWeight, <https://dpp-keystone.org/spec/v3/terms#batteryMass>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-10>;
    rdfs:label "Battery Mass"@en;
    rdfs:comment "Net mass of the battery. Use unitCode 'KGM' (kilogram) per UN/CEFACT Rec 20. Sub-property of gs1:netWeight to keep GS1-first."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "BatteryPass-Ready v1.3 (current canonical SAMM submodel: urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#batteryMass). EU Battery Regulation Annex VI Part A weight declaration."@en;
    skos:exactMatch <https://dpp-keystone.org/spec/v3/terms#batteryMass>, <urn:samm:io.BatteryPass.GeneralProductInformation:1.2.0#batteryMass>, <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#batteryWeight>, <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#batteryMass>;
    skos:broadMatch gs1:netWeight;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain gs1:Product;
    rdfs:subPropertyOf gs1:netWeight.
<https://ref.openepcis.org/extensions/eu/battery/hasDismantlingAndRemovalInformation> a owl:ObjectProperty;
    rdfs:seeAlso gs1:ReferencedFileDetails, oec:hasDismantlingInstructions, <https://dpp-keystone.org/spec/v3/terms#dismantlingInformation>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-48>;
    rdfs:label "Dismantling and Removal Information"@en;
    rdfs:comment "Documents with the dismantling and removal information of the battery: exploded diagrams, disassembly sequences, fastening techniques, tools, warnings and cell layout. Each document is typed per DIN DKE SPEC 99100 (bill of material, 3D model, dismantling manual, removal manual, ...)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 Annex XIII(2)(c), EC guidance data point 48. BatteryPass-Ready: dismantlingAndRemovalInformation (SAMM io.BatteryPass.Circularity)."@en;
    skos:exactMatch <https://dpp-keystone.org/spec/v3/terms#dismantlingInformation>, <urn:samm:io.BatteryPass.Circularity:1.2.0#dismantlingAndRemovalInformation>, <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#dismantlingInformation>, <https://w3id.org/eudpp/battery#dismantlingInformation>, <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#dismantlingInformation>;
    skos:broadMatch gs1:instructions, <https://dpp-keystone.org/spec/v3/terms#documents>;
    rdfs:range <https://ref.openepcis.org/extensions/eu/battery/DismantlingDocument>;
    rdfs:domain gs1:Product.
<https://ref.openepcis.org/extensions/eu/battery/hasSafetyMeasures> a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.Circularity:1.2.0#endOfLifeInformation>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-49>, <https://dpp-keystone.org/spec/v3/terms#safetyMeasures>, <https://dpp-keystone.org/spec/v3/terms#safetyDataSheet>;
    rdfs:label "Safety Measures"@en;
    rdfs:comment "Documents with the safety measures for handling and dismantling the battery, addressed to persons with a legitimate interest. Each is an oec:DocumentReference carrying oec:documentUrl."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 Annex XIII(2)(d), EC guidance data point 49 (safety measures, a web link). BatteryPass-Ready: safetyMeasures (SAMM io.BatteryPass.Circularity)."@en;
    skos:exactMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#safetyMeasures>, <https://dpp-keystone.org/spec/v3/terms#safetyMeasures>, <urn:samm:io.BatteryPass.Circularity:1.2.0#safetyMeasures>, <https://w3id.org/eudpp/battery#safetyMeasures>, <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#wasteBatterySafetyInstructions>, <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#safetyMeasures>;
    skos:narrowMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#safetyInstructions>;
    skos:broadMatch gs1:instructions, gs1:consumerSafetyInformation, gs1:safetyInfo;
    rdfs:range oec:DocumentReference;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/EndOfLifeInfo>.
