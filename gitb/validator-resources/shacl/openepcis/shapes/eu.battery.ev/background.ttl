    skos:exactMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#absoluteCarbonFootprint>;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>;
    rdfs:range xsd:decimal.
oec:hasCarbonFootprintProduction a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#batteryCarbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#absoluteCarbonFootprint>, oec:carbonFootprintTotal, <https://dpp-keystone.org/spec/v3/terms#carbonFootprint>;
    rdfs:label "Carbon Footprint: Production"@en;
    rdfs:comment "Lifecycle stage emissions from main product production. gs1:QuantitativeValue with unitCode 'KGM'."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
