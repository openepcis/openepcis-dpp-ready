<https://ref.openepcis.org/extensions/eu/battery/hasInitialCellInternalResistance> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-38>;
    rdfs:label "Initial Internal Cell Resistance"@en;
    rdfs:comment "Initial internal resistance of the battery cell at commissioning in Ohms (Annex XIII 1 (o)). Use unitCode 'OHM' (UN/CEFACT Rec 20). Annex XIII 1 (o) asks for both the cell and the pack value; the pack value is eubat:hasInitialPackInternalResistance."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "The EC data-point guidance (version 3.2) lists data point 38 as two values, internal battery cell resistance and internal battery pack resistance. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#internalCellResistance>, <https://w3id.org/eudpp/battery-performance#initialCellInternalResistance>;
    skos:broadMatch <urn:samm:io.BatteryPass.Performance:1.2.1#initialInternalResistance>, <https://dpp-keystone.org/spec/v3/terms#internalResistanceInitial>, <https://w3id.org/eudpp/battery-performance#initialInternalResistance>, <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#initialInternalResistanceOfBatteryCellAndPackModuleRecommended>;
    rdfs:range gs1:QuantitativeValue;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification>.
<https://ref.openepcis.org/extensions/eu/battery/hasInitialPackInternalResistance> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-38>;
    rdfs:label "Initial Internal Pack Resistance"@en;
    rdfs:comment "Initial internal resistance of the battery pack at commissioning in Ohms (Annex XIII 1 (o)). Use unitCode 'OHM' (UN/CEFACT Rec 20). Annex XIII 1 (o) asks for both the cell and the pack value; the cell value is eubat:hasInitialCellInternalResistance."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "The EC data-point guidance (version 3.2) lists data point 38 as two values, internal battery cell resistance and internal battery pack resistance. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#internalPackResistance>, <https://w3id.org/eudpp/battery-performance#initialPackInternalResistance>, <urn:samm:io.BatteryPass.Performance:1.2.1#ohmicResistance>;
    skos:broadMatch <urn:samm:io.BatteryPass.Performance:1.2.1#initialInternalResistance>, <https://dpp-keystone.org/spec/v3/terms#internalResistanceInitial>, <https://w3id.org/eudpp/battery-performance#initialInternalResistance>, <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#initialInternalResistanceOfBatteryCellAndPackModuleRecommended>;
