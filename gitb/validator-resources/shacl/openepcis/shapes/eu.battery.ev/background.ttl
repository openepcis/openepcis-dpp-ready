_:b116 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Reused>;
    rdf:rest _:b117.
<https://ref.openepcis.org/extensions/eu/battery/Reused> a <https://ref.openepcis.org/extensions/eu/battery/BatteryStatus>;
