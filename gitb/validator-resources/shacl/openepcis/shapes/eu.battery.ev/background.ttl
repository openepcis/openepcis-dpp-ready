    skos:closeMatch <https://dpp-keystone.org/spec/v3/terms#referenceTestCycleLife>;
    rdfs:range xsd:anyURI;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification>.
<https://ref.openepcis.org/extensions/eu/battery/powerCapabilityRatio> a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#powerEnergyRatio>;
    rdfs:label "Power Capability Ratio"@en;
    rdfs:comment "Ratio of rated power to rated energy (W/Wh)."@en;
