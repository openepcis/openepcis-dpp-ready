    skos:exactMatch <https://dpp-keystone.org/spec/v3/terms#powerEnergyRatio>, <urn:samm:io.BatteryPass.Performance:1.2.1#powerCapabilityRatio>, <https://w3id.org/eudpp/battery-performance#powerToEnergyRatio>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification>.
<https://ref.openepcis.org/extensions/eu/battery/cRate> a owl:DatatypeProperty;
    rdfs:label "C-Rate"@en;
    rdfs:comment "Nominal charge/discharge rate relative to capacity (e.g., 1C = full charge in 1 hour)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.Performance:1.2.1#powerCapabilityRatio>, <urn:samm:io.BatteryPass.Performance:1.2.1#cRate>;
    skos:narrowMatch <https://w3id.org/eudpp/battery-performance#cRateOfCycleLifeTest>, <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#cycleLifeChargeCRate>, <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#cycleLifeDischargeCRate>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification>.
<https://ref.openepcis.org/extensions/eu/battery/cRateLifeCycleTest> a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#cRateCycleTest>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-39>;
    rdfs:label "C-Rate Life Cycle Test"@en;
    rdfs:comment "C-rate used for lifecycle testing. Since the EC data-point guidance version 3.2 this is the charge C-rate (data point 39); the discharge C-rate of the same test has its own term, eubat:dischargeCRateLifeCycleTest (data point 40)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#cycleLifeChargeCRate>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-39>, <https://w3id.org/eudpp/battery-performance#chargeCRateOfCycleLifeTest>;
    skos:broadMatch <urn:samm:io.BatteryPass.Performance:1.2.1#cRate>, <https://w3id.org/eudpp/battery-performance#cRateOfCycleLifeTest>, <https://dpp-keystone.org/spec/v3/terms#cRateCycleTest>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification>.
<https://ref.openepcis.org/extensions/eu/battery/dischargeCRateLifeCycleTest> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.org/extensions/eu/battery/cRateLifeCycleTest>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-40>;
    rdfs:label "Discharge C-Rate Life Cycle Test"@en;
    rdfs:comment "Discharge C-rate of the relevant cycle-life test (Annex XIII 1 (p)), in 1/h. The charge C-rate of the same test is eubat:cRateLifeCycleTest."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 Annex XIII 1 (p) asks for the C-rate of the relevant cycle-life test; the EC data-point guidance (version 3.2, 2026-10-19) splits it into a charge C-rate (data point 39, mandatory) and a discharge C-rate (data point 40, optional). No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#cycleLifeDischargeCRate>, <https://w3id.org/eudpp/battery-performance#dischargeCRateOfCycleLifeTest>;
    skos:broadMatch <https://w3id.org/eudpp/battery-performance#cRateOfCycleLifeTest>, <https://dpp-keystone.org/spec/v3/terms#cRateCycleTest>, <urn:samm:io.BatteryPass.Performance:1.2.1#cRateLifeCycleTest>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification>.
<https://ref.openepcis.org/extensions/eu/battery/hasOriginalPowerCapability> a owl:ObjectProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-29>;
