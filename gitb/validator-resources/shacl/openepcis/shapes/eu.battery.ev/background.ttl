    skos:broadMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#environmentalConditionHistogramSet>;
    rdfs:range xsd:integer;
    rdfs:domain gs1:Product.
<https://ref.openepcis.org/extensions/eu/battery/timeSpentInExtremeTemperaturesBelowBoundary> a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-70>, <urn:samm:io.BatteryPass.Performance:1.2.1#timeExtremeLowTempCharging>;
    rdfs:label "Time Spent in Extreme Temperatures Below Boundary"@en;
    rdfs:comment "Cumulative time the battery spent below the lower temperature boundary, in minutes."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "BatteryPass-Ready v1.3 longlist attribute #95. Performance & durability passport property per Annex XIII; required by the GEFEG BatteryPass-Ready live validator for LMT and Stationary Industrial batteries (TimeSpentInExtremeTemperaturesBelowBoundary). Cumulative lifetime counter, distinct from the per-event eubat:exposureDurationMinutes. No equivalent GS1 term exists."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.Performance:1.2.1#timeExtremeLowTemp>, <https://w3id.org/eudpp/battery-performance#timeSpentInExtremeTemperaturesBelowBoundary>, <https://dpp-keystone.org/spec/v3/terms#timeExtremeTempLower>;
    skos:narrowMatch <urn:samm:io.BatteryPass.Performance:1.2.1#timeExtremeLowTempCharging>;
