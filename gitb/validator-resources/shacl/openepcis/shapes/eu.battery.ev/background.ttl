    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "Battery categories per EU Battery Regulation Art. 3. Can alternatively be expressed\nvia gs1:additionalProductClassification with gs1:additionalProductClassificationCode\nset to 'BATTERY_REGULATION_2023_1542' and gs1:additionalProductClassificationCode set to\nthe category code (lmt, ev, industrial, stationary, portable, sli)."@en;
    skos:broadMatch schema:CategoryCodeSet;
    owl:oneOf _:b108.
_:b108 rdf:first <https://ref.openepcis.org/extensions/eu/battery/LMTBattery>;
    rdf:rest _:b109.
<https://ref.openepcis.org/extensions/eu/battery/LMTBattery> a <https://ref.openepcis.org/extensions/eu/battery/BatteryCategory>;
    rdfs:label "Light Means of Transport Battery"@en;
    rdfs:comment "Battery for e-bikes, e-scooters, and other light electric vehicles. Subject to DPP requirements from 18 Feb 2027."@en;
    skos:exactMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-category#lightMeansOfTransportBattery>;
