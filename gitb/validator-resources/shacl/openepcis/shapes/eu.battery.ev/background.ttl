    rdfs:label "Electric Vehicle Battery"@en;
    rdfs:comment "Traction battery for electric vehicles providing propulsion power. Subject to most stringent DPP requirements from 18 Feb 2027."@en;
    skos:exactMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-category#electricVehicleBattery>;
    skos:notation "ev".
_:b110 rdf:first <https://ref.openepcis.org/extensions/eu/battery/IndustrialBattery>;
    rdf:rest _:b111.
