<https://ref.openepcis.org/extensions/eu/battery/leadRecycledShare> a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#postConsumerRecycledContent>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContentPercentage>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContent>, <urn:samm:io.BatteryPass.Circularity:1.2.0#postConsumerShare>, <https://dpp-keystone.org/spec/v3/terms#postConsumerRecycledContentPercentage>, <urn:samm:io.BatteryPass.Circularity:1.2.0#preConsumerShare>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-23>;
    rdfs:label "Lead Recycled Share"@en;
    rdfs:comment "Total percentage of recycled lead content (combined pre- and post-consumer). The EU Battery Regulation does not require a pre/post split for lead, in contrast to lithium, cobalt, nickel; v1.3 of the BatteryPass-Ready longlist consolidated the two former v1.2 attributes (#43 + #47) into this single share."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://thebatterypass.eu/battery-pass-ready/publications/>;
    skos:note "BatteryPass-Ready v1.3 longlist attribute #54. Granularity: batch level."@en;
    skos:exactMatch <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#leadRecycledContentShare>;
    skos:narrowMatch <https://dpp-keystone.org/spec/v3/terms#postConsumerRecycledContent>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContentPercentage>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContent>, <urn:samm:io.BatteryPass.Circularity:1.2.0#postConsumerShare>, <https://dpp-keystone.org/spec/v3/terms#postConsumerRecycledContentPercentage>, <urn:samm:io.BatteryPass.Circularity:1.2.0#preConsumerShare>;
    skos:broadMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledContent>, <https://vocabulary.uncefact.org/untp/recycledMassFraction>, <https://w3id.org/eudpp#materialRecycledContent>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/RecycledContent>.
<https://ref.openepcis.org/extensions/eu/battery/leadPreConsumerShare> a owl:DatatypeProperty;
    rdfs:seeAlso oec:recycledContent, <https://ref.openepcis.org/extensions/eu/battery/leadRecycledShare>;
    rdfs:label "Lead Pre-Consumer Recycled Share"@en;
    rdfs:comment "Percentage of the lead content recovered from pre-consumer (manufacturing) waste, expressed on the same basis as the lithium, cobalt and nickel pre-consumer shares. Voluntary breakdown of the aggregate eubat:leadRecycledShare."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "Pre-consumer breakdown of the Art. 8 recycled-lead share, following the same recycled-content calculation methodology as eubat:lithiumPreConsumerShare / eubat:cobaltPreConsumerShare / eubat:nickelPreConsumerShare. The Battery Regulation mandates only the aggregate share for lead, and BatteryPass-Ready v1.3 consolidated its two v1.2 lead attributes into the single RecycledLeadShare, so this split is a voluntary declaration retained for parity with the other three metals. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledContent>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContentPercentage>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledContent>, <https://dpp-keystone.org/spec/v3/terms#preConsumerRecycledMaterialComposition>;
    skos:closeMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#preConsumerShare>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/RecycledContent>;
    skos:broader <https://ref.openepcis.org/extensions/eu/battery/leadRecycledShare>.
<https://ref.openepcis.org/extensions/eu/battery/leadPostConsumerShare> a owl:DatatypeProperty;
    rdfs:seeAlso oec:recycledContent, <https://ref.openepcis.org/extensions/eu/battery/leadRecycledShare>;
    rdfs:label "Lead Post-Consumer Recycled Share"@en;
    rdfs:comment "Percentage of the lead content recovered from post-consumer waste, expressed on the same basis as the lithium, cobalt and nickel post-consumer shares. Voluntary breakdown of the aggregate eubat:leadRecycledShare."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "Post-consumer breakdown of the Art. 8 recycled-lead share, following the same recycled-content calculation methodology as eubat:lithiumPostConsumerShare / eubat:cobaltPostConsumerShare / eubat:nickelPostConsumerShare. The Battery Regulation mandates only the aggregate share for lead, and BatteryPass-Ready v1.3 consolidated its two v1.2 lead attributes into the single RecycledLeadShare, so this split is a voluntary declaration retained for parity with the other three metals. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch <https://dpp-keystone.org/spec/v3/terms#recycledContentPercentage>, <urn:samm:io.BatteryPass.Circularity:1.2.0#recycledContent>, <https://dpp-keystone.org/spec/v3/terms#postConsumerRecycledMaterialComposition>;
    skos:closeMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#postConsumerShare>;
    rdfs:range xsd:decimal;
    rdfs:domain <https://ref.openepcis.org/extensions/eu/battery/RecycledContent>;
    skos:broader <https://ref.openepcis.org/extensions/eu/battery/leadRecycledShare>.
