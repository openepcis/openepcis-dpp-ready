<https://ref.openepcis.org/extensions/eu/battery/timeSpentChargingDuringExtremeTemperaturesBelowBoundary> a owl:DatatypeProperty;
    rdfs:label "Time Spent Charging During Extreme Temperatures Below Boundary"@en;
