<https://ref.openepcis.org/extensions/eu/battery/capacityThresholdForExhaustion> a owl:DatatypeProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#exhaustionCapacityThreshold>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-33>;
