    owl:oneOf _:b136.
_:b136 rdf:first <https://ref.openepcis.org/extensions/eu/battery/AcuteToxicity>;
    rdf:rest _:b137.
<https://ref.openepcis.org/extensions/eu/battery/AcuteToxicity> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Acute Toxicity"@en;
    rdfs:comment "Substances causing harmful effects after single or short-term exposure via oral, dermal, or inhalation routes."@en.
_:b137 rdf:first <https://ref.openepcis.org/extensions/eu/battery/SkinCorrosionOrIrritation>;
    rdf:rest _:b138.
<https://ref.openepcis.org/extensions/eu/battery/SkinCorrosionOrIrritation> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Skin Corrosion or Irritation"@en;
    rdfs:comment "Substances causing irreversible damage (corrosion) or reversible damage (irritation) to skin tissue."@en.
_:b138 rdf:first <https://ref.openepcis.org/extensions/eu/battery/EyeDamageOrIrritation>;
    rdf:rest _:b139.
<https://ref.openepcis.org/extensions/eu/battery/EyeDamageOrIrritation> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Eye Damage or Irritation"@en;
    rdfs:comment "Substances causing serious eye damage or reversible eye irritation upon contact."@en.
_:b139 rdf:first <https://ref.openepcis.org/extensions/eu/battery/RespiratoryOrSkinSensitization>;
    rdf:rest _:b140.
<https://ref.openepcis.org/extensions/eu/battery/RespiratoryOrSkinSensitization> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Respiratory or Skin Sensitization"@en;
    rdfs:comment "Substances causing hypersensitivity of airways (asthma) or allergic skin reactions after exposure."@en.
_:b140 rdf:first <https://ref.openepcis.org/extensions/eu/battery/GermCellMutagenicity>;
    rdf:rest _:b141.
<https://ref.openepcis.org/extensions/eu/battery/GermCellMutagenicity> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Germ Cell Mutagenicity"@en;
    rdfs:comment "Substances that may cause heritable genetic mutations in human germ cells."@en.
_:b141 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Carcinogenicity>;
    rdf:rest _:b142.
<https://ref.openepcis.org/extensions/eu/battery/Carcinogenicity> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Carcinogenicity"@en;
    rdfs:comment "Substances known or suspected to cause cancer in humans."@en.
_:b142 rdf:first <https://ref.openepcis.org/extensions/eu/battery/ReproductiveToxicity>;
    rdf:rest _:b143.
<https://ref.openepcis.org/extensions/eu/battery/ReproductiveToxicity> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Reproductive Toxicity"@en;
    rdfs:comment "Substances adversely affecting sexual function, fertility, or development of offspring."@en.
_:b143 rdf:first <https://ref.openepcis.org/extensions/eu/battery/SpecificTargetOrganToxicity>;
    rdf:rest _:b144.
<https://ref.openepcis.org/extensions/eu/battery/SpecificTargetOrganToxicity> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Specific Target Organ Toxicity"@en;
    rdfs:comment "Substances causing non-lethal damage to specific organs after single or repeated exposure."@en.
_:b144 rdf:first <https://ref.openepcis.org/extensions/eu/battery/AspirationHazard>;
    rdf:rest _:b145.
<https://ref.openepcis.org/extensions/eu/battery/AspirationHazard> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
    rdfs:label "Aspiration Hazard"@en;
    rdfs:comment "Liquid or solid substances causing chemical pneumonia or pulmonary injury if aspirated into airways."@en.
_:b145 rdf:first <https://ref.openepcis.org/extensions/eu/battery/HazardousToAquaticEnvironment>;
    rdf:rest rdf:nil.
<https://ref.openepcis.org/extensions/eu/battery/HazardousToAquaticEnvironment> a <https://ref.openepcis.org/extensions/eu/battery/HazardClass>;
