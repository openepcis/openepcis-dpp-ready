<https://ref.openepcis.org/extensions/eu/battery/ComponentLocation> a owl:Class;
    rdfs:label "Component Location"@en;
    rdfs:comment "Component location within the battery cell or pack where a material is used."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    owl:oneOf _:b124.
_:b124 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Cathode>;
    rdf:rest _:b125.
<https://ref.openepcis.org/extensions/eu/battery/Cathode> a <https://ref.openepcis.org/extensions/eu/battery/ComponentLocation>;
    rdfs:label "Cathode"@en;
    rdfs:comment "Positive electrode where reduction occurs during discharge. Contains active materials like NMC, LFP, or NCA."@en;
    skos:closeMatch <https://w3id.org/emmo/domain/battery#Cathode>.
_:b125 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Anode>;
    rdf:rest _:b126.
<https://ref.openepcis.org/extensions/eu/battery/Anode> a <https://ref.openepcis.org/extensions/eu/battery/ComponentLocation>;
    rdfs:label "Anode"@en;
    rdfs:comment "Negative electrode where oxidation occurs during discharge. Typically contains graphite or silicon compounds."@en;
    skos:closeMatch <https://w3id.org/emmo/domain/battery#Anode>.
_:b126 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Electrolyte>;
    rdf:rest _:b127.
<https://ref.openepcis.org/extensions/eu/battery/Electrolyte> a <https://ref.openepcis.org/extensions/eu/battery/ComponentLocation>;
    rdfs:label "Electrolyte"@en;
    rdfs:comment "Ion-conducting medium between electrodes. Can be liquid, gel, or solid-state depending on battery chemistry."@en;
    skos:closeMatch <https://w3id.org/emmo/domain/battery#Electrolyte>.
_:b127 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Separator>;
    rdf:rest _:b128.
<https://ref.openepcis.org/extensions/eu/battery/Separator> a <https://ref.openepcis.org/extensions/eu/battery/ComponentLocation>;
    rdfs:label "Separator"@en;
    rdfs:comment "Porous membrane preventing direct contact between electrodes while allowing ion transport."@en;
    skos:closeMatch <https://w3id.org/emmo/domain/battery#Separator>.
_:b128 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Casing>;
    rdf:rest _:b129.
<https://ref.openepcis.org/extensions/eu/battery/Casing> a <https://ref.openepcis.org/extensions/eu/battery/ComponentLocation>;
    rdfs:label "Casing"@en;
