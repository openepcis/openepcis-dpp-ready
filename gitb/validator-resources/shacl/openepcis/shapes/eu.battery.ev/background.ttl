_:b133 rdf:first <https://ref.openepcis.org/extensions/eu/battery/Conductor>;
    rdf:rest _:b134.
<https://ref.openepcis.org/extensions/eu/battery/Conductor> a <https://ref.openepcis.org/extensions/eu/battery/MaterialCategory>;
