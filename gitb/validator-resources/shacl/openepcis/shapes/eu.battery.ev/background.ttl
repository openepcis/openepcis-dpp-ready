    rdfs:seeAlso <https://ref.openepcis.org/extensions/eu/battery/hasRatedMaximumPower>, <https://dpp-keystone.org/spec/v3/terms#powerMaximumPermitted>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-30>, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingPowerCapability>, <https://w3id.org/eudpp/battery-performance#maximumPermittedBatteryPower>;
    rdfs:label "Maximum Permitted Battery Power"@en;
    rdfs:comment "Maximum permitted battery power (single declared value). Use gs1:QuantitativeValue with unitCode 'WTT' (watt) or 'KWT' (kW), UN/CEFACT Rec 20."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
