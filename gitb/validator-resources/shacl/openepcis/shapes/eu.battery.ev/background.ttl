<https://ref.openepcis.org/extensions/eu/battery/BatteryCategory> a owl:Class;
    rdfs:seeAlso gs1:additionalProductClassification, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-06>;
    rdfs:label "Battery Category"@en;
