    skos:exactMatch <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#dismantlingInformation>;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EndOfLifeProgram.
oec:hasEndOfLifeProgram a owl:ObjectProperty;
    rdfs:label "End-of-Life Program"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range oec:EndOfLifeProgram.
oec:HazardSignalWord a owl:Class;
    rdfs:label "Hazard Signal Word"@en;
    rdfs:comment "CLP Regulation signal word: Danger or Warning."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    owl:oneOf _:b106.
_:b106 rdf:first oec:HazardDanger;
    rdf:rest _:b107.
oec:HazardDanger a oec:HazardSignalWord;
    rdfs:label "Danger"@en;
    skos:notation "Danger".
_:b107 rdf:first oec:HazardWarning;
    rdf:rest rdf:nil.
oec:HazardWarning a oec:HazardSignalWord;
    rdfs:label "Warning"@en;
    skos:notation "Warning".
oec:hasHazardSignalWord a owl:ObjectProperty;
    rdfs:label "Hazard Signal Word"@en;
    rdfs:comment "CLP Regulation 1272/2008 signal word: Danger or Warning."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range oec:HazardSignalWord;
    rdfs:domain oec:HazardousSubstance.
oec:hazardPictogramCode a owl:DatatypeProperty;
    rdfs:label "Hazard Pictogram Code"@en;
    rdfs:comment "CLP/GHS pictogram code (GHS01..GHS09). Set-valued: a substance can carry multiple pictograms."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:hazardStatement a owl:DatatypeProperty;
    rdfs:label "Hazard Statement (H-statement)"@en;
    rdfs:comment "CLP H-statement code (e.g. H315, H319). Set-valued: a substance can carry multiple H-statements."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    skos:note "Substance-of-concern pattern aligned with CLP (EC) 1272/2008 and the ECHA SCIP database. Reusable across regulation modules."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:precautionaryStatement a owl:DatatypeProperty;
    rdfs:label "Precautionary Statement (P-statement)"@en;
    rdfs:comment "CLP P-statement code (e.g. P101, P280). Set-valued."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:exactMatch <https://ref.openepcis.org/vocab/batterypass-ready/2.0.1#precautionaryPhrases>;
    rdfs:range xsd:string;
    rdfs:domain oec:HazardousSubstance.
oec:repairInformationPortalUrl a owl:DatatypeProperty;
    rdfs:label "Repair Information Portal URL"@en;
    rdfs:comment "URL of the manufacturer's public repair information portal as required by EU Right-to-Repair Directive 2024/1799 Article 4: covers spare-parts catalogue, dismantling guides, software updates available to independent repairers."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2024/1799>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:RepairabilityInfo.
oec:RepairProvider a owl:Class;
    rdfs:label "Repair Provider"@en;
    rdfs:comment "An authorised repair provider for a product. Supports the European online platform for repair (Article 7 of Directive 2024/1799) and manufacturer-published repair networks."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:AutoRepair.
oec:hasRepairProvider a owl:ObjectProperty;
    rdfs:label "Repair Provider"@en;
    rdfs:comment "Links a product to one or more authorised repair providers."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:provider;
    rdfs:range oec:RepairProvider.
oec:repairProviderName a owl:DatatypeProperty;
    rdfs:label "Repair Provider Name"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    skos:broadMatch schema:provider;
    rdfs:range xsd:string;
    rdfs:domain oec:RepairProvider.
oec:repairProviderUrl a owl:DatatypeProperty;
    rdfs:label "Repair Provider URL"@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting circularity pattern per ESPR 2024/1781 Article 7, reusable across regulation modules."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:RepairProvider.
oec:hasDueDiligenceRegulationContext a owl:ObjectProperty;
    rdfs:label "Due Diligence Regulation Context"@en;
    rdfs:comment "The specific regulation against which a due diligence statement is asserted: Battery Annex X (Reg. 2023/1542), EUDR Article 9 (Reg. 2023/1115), CSDDD (Dir. 2024/1760), Forced Labour Regulation (2024/3015), OECD Conflict Minerals, etc. Same oec:DueDiligenceReport shape; different regulatory anchor."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <http://data.europa.eu/m8g/isDerivedFrom>;
    skos:closeMatch <https://vocabulary.uncefact.org/untp/regulation>, <https://vocabulary.uncefact.org/untp/referenceRegulation>;
    rdfs:range gs1:RegulatoryInformation;
    rdfs:domain oec:DueDiligenceReport.
oec:supplyChainTransparencyUrl a owl:DatatypeProperty;
    rdfs:label "Supply-Chain Transparency URL"@en;
    rdfs:comment "URL of a public supply-chain map / transparency endpoint (CSDDD Article 16, ESPR Article 7)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:DueDiligenceReport.
oec:forcedLabourFreeAssertion a owl:DatatypeProperty;
    rdfs:label "Forced-Labour-Free Assertion"@en;
    rdfs:comment "Boolean assertion that the product is free of forced labour per EU Regulation 2024/3015. Substantiate with dueDiligenceReport URL + thirdPartyAssurance evidence."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/3015>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    rdfs:range xsd:boolean;
    rdfs:domain oec:DueDiligenceReport.
oec:isStrategicRawMaterial a owl:DatatypeProperty;
    rdfs:label "Is Strategic Raw Material"@en;
    rdfs:comment "Boolean flag: material is on the EU Strategic Raw Materials list per CRMA Annex I (2024/1252). Strategic ⊂ Critical: every strategic raw material is also a critical raw material, but not vice versa."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1252>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <https://w3id.org/eudpp#isCriticalRawMaterial>, <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#isCriticalRawMaterial>;
    rdfs:range xsd:boolean;
    rdfs:domain oec:MaterialComposition;
    skos:broader oec:isCriticalRawMaterial.
oec:crmListVersion a owl:DatatypeProperty;
    rdfs:label "CRM List Version"@en;
    rdfs:comment "Version reference of the EU Critical Raw Materials list against which the isCriticalRawMaterial / isStrategicRawMaterial flags were determined (e.g. CRMA-2024 Annex II / Annex I). The list is updated periodically by the Commission."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Cross-cutting Digital Product Passport pattern under ESPR 2024/1781, reusable across regulation modules. Anchored upward to GS1/SEMICeu/schema.org/UNTP where an equivalent exists."@en;
    skos:broadMatch <https://vocabulary.uncefact.org/untp/version>;
    rdfs:range xsd:string;
    rdfs:domain oec:MaterialComposition.
oec:remanufacturingDate a owl:DatatypeProperty;
    rdfs:seeAlso <https://ref.gs1.ch/voc/rail/itemReconditioningDate>;
    rdfs:label "Remanufacturing / refurbishment date"@en;
    rdfs:comment "Date on which a product was remanufactured or refurbished and re-released as fit for purpose. Cross-sector: applies to any DPP-covered product that re-enters service after refurbishment (rail rolling stock, batteries, electronics, textiles)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "No upstream equivalent: GS1 Web Vocabulary covers production dates but not refurbishment; schema.org has schema:productionDate / schema:purchaseDate but no remanufacture/reconditioning date; SEMICeu does not cover product lifecycle dates."@en;
    skos:narrowMatch <https://ref.gs1.ch/voc/rail/itemReconditioningDate>;
    rdfs:range xsd:dateTime;
    rdfs:domain schema:Product.
oec:EnvironmentalProductDeclaration a owl:Class;
    rdfs:seeAlso oec:EmissionsPerformance, oec:CarbonFootprintDeclaration, <https://dpp-keystone.org/spec/v3/terms#EPDBlock>, <https://w3id.org/eudpp#EPDStudy>, <https://w3id.org/eudpp#EPDDocument>;
    rdfs:subClassOf schema:Certification;
    rdfs:label "Environmental Product Declaration"@en;
    rdfs:comment "A type III environmental declaration per EN 15804:2012+A2:2019 / ISO 14025,\nreporting life-cycle environmental impact indicators broken down by lifecycle module."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "Required extension: EN 15804 EPDs carry a full impact-indicator set with modular\nlifecycle breakdown not covered by GS1 Web Vocabulary, schema.org, or SEMICeu. Aligned with\nDPP Keystone dppk:EPDBlock (peer DPP profile). For a single aggregate carbon figure use\noec:carbonFootprintTotal; for a 5-stage carbon breakdown use oec:CarbonFootprintDeclaration."@en;
    skos:exactMatch <https://w3id.org/eudpp#EPDDocument>.
oec:ImpactIndicatorResult a owl:Class;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#ImpactValues>, <https://w3id.org/eudpp#LCAResult>;
    rdfs:label "Impact Indicator Result"@en;
    rdfs:comment "One environmental impact indicator (e.g. Global Warming Potential) reported within\nan EPD: its indicator type, declared unit, aggregate value, and optional per-lifecycle-module values."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 impact-indicator result. Anchored to DPP Keystone dppk-epd:ImpactValues (peer DPP profile)."@en;
    skos:broadMatch <https://w3id.org/eudpp#LCIAResult>, <https://w3id.org/eudpp#LCAResult>, <https://w3id.org/eudpp/textile-assessment#MeasurementResult>;
    skos:closeMatch <https://dpp-keystone.org/spec/v3/terms/epd#ImpactValues>.
oec:LifecycleStageResult a owl:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#LCAModuleValue>;
    rdfs:label "Lifecycle Stage Result"@en;
    rdfs:comment "The value of an impact indicator for a single EN 15804 lifecycle module (e.g. A1, B6, C3, D)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 modular lifecycle value. Pairs an oec:LifecycleStage code with a decimal value in the indicator's declared unit."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>, <https://w3id.org/eudpp#LCAResult>.
oec:ImpactIndicatorType a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#EN15804ImpactIndicator>, <https://w3id.org/eudpp#LCIAImpactIndicator>, <https://w3id.org/eudpp#AreaOfProtection>;
    rdfs:label "Impact Indicator Type"@en;
    rdfs:comment "Controlled list of EN 15804:2012+A2:2019 environmental impact indicators."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804+A2 core impact category set."@en;
    skos:broadMatch <https://w3id.org/eudpp#LCIAImpactCategory>.
oec:GWPTotal a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#gwp>, <https://w3id.org/eudpp#ind_GWPtotal>;
    rdfs:label "Global Warming Potential, total"@en;
    skos:notation "GWP-total".
oec:GWPFossil a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#gwpF>, <https://w3id.org/eudpp#ind_GWPfossil>;
    rdfs:label "Global Warming Potential, fossil"@en;
    skos:notation "GWP-fossil".
oec:GWPBiogenic a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#gwpB>, <https://w3id.org/eudpp#ind_GWPbiogenic>;
    rdfs:label "Global Warming Potential, biogenic"@en;
    skos:notation "GWP-biogenic".
oec:GWPLuluc a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#gwpLuluc>, <https://w3id.org/eudpp#ind_GWPluluc>;
    rdfs:label "Global Warming Potential, land use and land-use change"@en;
    skos:notation "GWP-luluc".
oec:ODP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#odp>, <https://w3id.org/eudpp#ind_ODP>;
    rdfs:label "Depletion potential of the stratospheric ozone layer"@en;
    skos:notation "ODP".
oec:AP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#ap>, <https://w3id.org/eudpp#ind_AP>;
    rdfs:label "Acidification potential"@en;
    skos:notation "AP".
oec:EPFreshwater a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#epF>, <https://w3id.org/eudpp#ind_EPfreshwater>;
    rdfs:label "Eutrophication potential, freshwater"@en;
    skos:notation "EP-freshwater".
oec:EPMarine a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#epM>, <https://w3id.org/eudpp#ind_EPmarine>;
    rdfs:label "Eutrophication potential, marine"@en;
    skos:notation "EP-marine".
oec:EPTerrestrial a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#epT>, <https://w3id.org/eudpp#ind_EPterrestrial>;
    rdfs:label "Eutrophication potential, terrestrial"@en;
    skos:notation "EP-terrestrial".
oec:POCP a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#pocp>, <https://w3id.org/eudpp#ind_POCP>;
    rdfs:label "Formation potential of tropospheric ozone"@en;
    skos:notation "POCP".
oec:ADPElements a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#adpe>, <https://w3id.org/eudpp#ind_ADPE>;
    rdfs:label "Abiotic depletion potential, minerals and metals"@en;
    skos:notation "ADP-minerals&metals".
oec:ADPFossil a oec:ImpactIndicatorType;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#adpf>, <https://w3id.org/eudpp#ind_ADPF>;
    rdfs:label "Abiotic depletion potential, fossil resources"@en;
    skos:notation "ADP-fossil".
oec:LifecycleStage a rdfs:Class;
    rdfs:seeAlso <https://w3id.org/eudpp#LifeCycleModule>;
    rdfs:label "Lifecycle Stage"@en;
    rdfs:comment "Controlled list of EN 15804 lifecycle modules (product, construction, use, end-of-life, and benefits beyond the system boundary)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 modular lifecycle stages."@en;
    skos:exactMatch <https://w3id.org/eudpp#LifeCycleModule>.
oec:StageA1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#a1>, <https://w3id.org/eudpp#en15804moduleA1>;
    rdfs:label "A1 Raw material supply"@en;
    skos:notation "A1".
oec:StageA2 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#a2>, <https://w3id.org/eudpp#en15804moduleA2>;
    rdfs:label "A2 Transport to manufacturer"@en;
    skos:notation "A2".
oec:StageA3 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#a3>, <https://w3id.org/eudpp#en15804moduleA3>;
    rdfs:label "A3 Manufacturing"@en;
    skos:notation "A3".
oec:StageA4 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#a4>, <https://w3id.org/eudpp#en15804moduleA4>;
    rdfs:label "A4 Transport to site"@en;
    skos:notation "A4".
oec:StageA5 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#a5>, <https://w3id.org/eudpp#en15804moduleA5>;
    rdfs:label "A5 Installation"@en;
    skos:notation "A5".
oec:StageB1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#b1>, <https://w3id.org/eudpp#en15804moduleB1>;
    rdfs:label "B1 Use"@en;
    skos:notation "B1".
oec:StageB2 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#b2>, <https://w3id.org/eudpp#en15804moduleB2>;
    rdfs:label "B2 Maintenance"@en;
    skos:notation "B2".
oec:StageB3 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#b3>, <https://w3id.org/eudpp#en15804moduleB3>;
    rdfs:label "B3 Repair"@en;
    skos:notation "B3".
oec:StageB4 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#b4>, <https://w3id.org/eudpp#en15804moduleB4>;
    rdfs:label "B4 Replacement"@en;
    skos:notation "B4".
oec:StageB5 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#b5>, <https://w3id.org/eudpp#en15804moduleB5>;
    rdfs:label "B5 Refurbishment"@en;
    skos:notation "B5".
oec:StageB6 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#b6>, <https://w3id.org/eudpp#en15804moduleB6>;
    rdfs:label "B6 Operational energy use"@en;
    skos:notation "B6".
oec:StageB7 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#b7>, <https://w3id.org/eudpp#en15804moduleB7>;
    rdfs:label "B7 Operational water use"@en;
    skos:notation "B7".
oec:StageC1 a oec:LifecycleStage;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#c1>, <https://w3id.org/eudpp#en15804moduleC1>;
    rdfs:label "C1 Deconstruction / demolition"@en;
    skos:notation "C1".
oec:StageC2 a oec:LifecycleStage;
    rdfs:seeAlso <https://w3id.org/eudpp#en15804moduleC2>;
    rdfs:label "C2 Transport to waste processing"@en;
    skos:notation "C2".
oec:StageC3 a oec:LifecycleStage;
    rdfs:seeAlso <https://w3id.org/eudpp#en15804moduleC3>;
    rdfs:label "C3 Waste processing"@en;
    skos:notation "C3".
oec:StageC4 a oec:LifecycleStage;
    rdfs:seeAlso <https://w3id.org/eudpp#en15804moduleC4>;
    rdfs:label "C4 Disposal"@en;
    skos:notation "C4".
oec:StageD a oec:LifecycleStage;
    rdfs:seeAlso <https://w3id.org/eudpp#moduleD>;
    rdfs:label "D Benefits and loads beyond the system boundary"@en;
    skos:notation "D".
oec:hasEnvironmentalProductDeclaration a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#epd>;
    rdfs:label "Environmental Product Declaration"@en;
    rdfs:comment "Links a product to its EN 15804 environmental product declaration."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 EPD link. Anchored to DPP Keystone dppk:epd (peer DPP profile)."@en;
    skos:exactMatch <https://dpp-keystone.org/spec/v3/terms#epd>;
    rdfs:range oec:EnvironmentalProductDeclaration.
oec:epdRegistrationNumber a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#registrationNumber>;
    rdfs:label "EPD Registration Number"@en;
    rdfs:comment "Registration / declaration number assigned by the EPD programme operator."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    skos:exactMatch <https://w3id.org/eudpp#registrationNumber>;
    skos:broadMatch gs1:regulatoryReferenceNumber;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:productCategoryRules a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#PCR>, <https://w3id.org/eudpp#PEFCR>, <https://w3id.org/eudpp#followsPCR>, <https://w3id.org/eudpp#followsPEFCR>;
    rdfs:label "Product Category Rules"@en;
    rdfs:comment "URI of the Product Category Rules (PCR) or Product Environmental Footprint Category Rules (PEFCR) document under which the environmental declaration was produced."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "ISO 14025 / EN 15804 EPD metadata: results are only comparable within one PCR/PEFCR, so the passport must say which one applies. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <https://w3id.org/eudpp#followsPCR>;
    skos:narrowMatch <https://w3id.org/eudpp#followsPEFCR>;
    rdfs:range xsd:anyURI;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdProgramOperator a owl:DatatypeProperty;
    rdfs:label "EPD Programme Operator"@en;
    rdfs:comment "Name of the EPD programme operator (e.g. EPD International, IBU, EcoPlatform)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdStandard a owl:DatatypeProperty;
    rdfs:label "EPD Reference Standard"@en;
    rdfs:comment "Reference standard and product category rules version used (e.g. EN 15804+A2)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    rdfs:range xsd:string;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:epdValidUntil a owl:DatatypeProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#expiryDate>;
    rdfs:label "EPD Valid Until"@en;
    rdfs:comment "Date until which the EPD is valid."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 / ISO 14025 EPD metadata."@en;
    skos:exactMatch schema:validUntil, <https://w3id.org/eudpp#expiryDate>;
    skos:broadMatch schema:validThrough;
    rdfs:range xsd:date;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:hasImpactIndicator a owl:ObjectProperty;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms/epd#indicator>;
    rdfs:label "Impact Indicator"@en;
    rdfs:comment "An environmental impact indicator result reported within the EPD."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 impact indicator. Anchored to DPP Keystone dppk-epd:indicator (peer DPP profile)."@en;
    rdfs:range oec:ImpactIndicatorResult;
    rdfs:domain oec:EnvironmentalProductDeclaration.
oec:hasIndicatorType a owl:ObjectProperty;
    rdfs:label "Indicator Type"@en;
    rdfs:comment "The EN 15804 impact category this result reports (e.g. oec:GWPTotal)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804+A2 impact category selector."@en;
    rdfs:range oec:ImpactIndicatorType;
    rdfs:domain oec:ImpactIndicatorResult.
oec:indicatorUnit a owl:DatatypeProperty;
    rdfs:label "Indicator Unit"@en;
    rdfs:comment "Declared unit for this indicator (e.g. kg CO2 eq, kg CFC11 eq, mol H+ eq, m3 world eq deprived)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 declared characterisation unit for the indicator."@en;
    skos:closeMatch gs1:unitCode;
    rdfs:range xsd:string;
    rdfs:domain oec:ImpactIndicatorResult.
oec:indicatorTotalValue a owl:DatatypeProperty;
    rdfs:seeAlso schema:value, gs1:value;
    rdfs:label "Indicator Total Value"@en;
    rdfs:comment "Aggregate value of the indicator across the declared lifecycle modules, in the declared unit."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 aggregate indicator value. Use oec:hasLifecycleStageResult for the modular breakdown."@en;
    rdfs:range xsd:decimal;
    rdfs:domain oec:ImpactIndicatorResult.
oec:hasLifecycleStageResult a owl:ObjectProperty;
    rdfs:seeAlso <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>;
    rdfs:label "Lifecycle Stage Result"@en;
    rdfs:comment "A single EN 15804 module value contributing to this indicator."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 modular lifecycle breakdown."@en;
    rdfs:range oec:LifecycleStageResult;
    rdfs:domain oec:ImpactIndicatorResult.
oec:hasLifecycleStage a owl:ObjectProperty;
    rdfs:seeAlso <https://w3id.org/eudpp#forLifeCycleModule>;
    rdfs:label "Lifecycle Stage"@en;
    rdfs:comment "The EN 15804 lifecycle module this value applies to (e.g. oec:StageA1)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 module selector."@en;
    skos:exactMatch <https://w3id.org/eudpp#forLifeCycleModule>;
    skos:closeMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#lifecycleStage>;
    rdfs:range oec:LifecycleStage;
    rdfs:domain oec:LifecycleStageResult.
oec:stageValue a owl:DatatypeProperty;
    rdfs:seeAlso schema:value, gs1:value, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingPowerCapabilityValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#numberOfFullCyclesValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#remainingCapacityValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#capacityThroughputValue>, <urn:samm:io.BatteryPass.Performance:1.2.1#internalResistanceIncreaseValue>;
    rdfs:label "Stage Value"@en;
    rdfs:comment "Indicator value for this lifecycle module, in the indicator's declared unit."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/>;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1781>;
    skos:note "EN 15804 modular value. DPP Keystone expresses these as flat dppk-epd:a1..dppk-epd:d properties; here normalised as oec:LifecycleStage + oec:stageValue pairs."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#carbonFootprintPerLifecycleStage>;
    rdfs:range xsd:decimal;
    rdfs:domain oec:LifecycleStageResult.
<https://ref.openepcis.org/extensions/eu/battery/> a owl:Ontology;
    dcterms:title "OpenEPCIS Battery Vocabulary"@en;
    dcterms:description "Battery-specific vocabulary extending GS1 Web Vocabulary for Digital Product Passports.\n\nA lightweight, 100% JSON-LD compatible alternative to BatteryPass/SAMM that covers all\nEU Battery Regulation 2023/1542 Annex XIII requirements while leveraging existing GS1 standards.\n\nAligned with:\n- EU Battery Regulation 2023/1542 Annex XIII\n- DIN DKE SPEC 99100:2025-02\n- GS1 Web Vocabulary (gs1:regulatoryInformation pattern)\n- GS1 EPCIS 2.0 (gs1:masterDataAvailableFor)\n\nGS1 Properties to Use (not redefined here):\n- gs1:gtin - Global Trade Item Number\n- gs1:netWeight / gs1:grossWeight - Battery weight\n- gs1:productionDate - Manufacturing date\n- gs1:countryOfOrigin - Country of manufacture\n- gs1:manufacturer - Manufacturer organization\n- gs1:warranty / gs1:WarrantyPromise - Warranty information\n- gs1:certification / gs1:CertificationDetails - Certifications\n- gs1:regulatoryInformation - Regulatory compliance\n\nFor regulatory compliance data, use gs1:regulatoryInformation with gs1:RegulationTypeCode-BATTERY_DIRECTIVE.\n\nEPCIS 2.0 Extension Declaration:\nGS1-Extensions: eubat=https://ref.openepcis.org/extensions/eu/battery/\n\nExtension Governance:\nThis vocabulary extends GS1 Web Vocabulary only where no equivalent term exists.\nEach extension term includes dcterms:source, skos:note, and rdfs:seeAlso where applicable.\nBattery categories can also be expressed via gs1:additionalProductClassification."@en;
    dcterms:creator "OpenEPCIS";
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0>;
    dcterms:created "2024-01-15"^^xsd:date;
    dcterms:modified "2026-06-19"^^xsd:date;
    owl:versionInfo "0.9.9";
    owl:versionIRI <https://ref.openepcis.org/extensions/eu/battery/0.9.9>;
    <http://purl.org/vocab/vann/preferredNamespacePrefix> "eubat";
    <http://purl.org/vocab/vann/preferredNamespaceUri> "https://ref.openepcis.org/extensions/eu/battery/";
    rdfs:seeAlso gs1:CertificationDetails, <https://ref.gs1.org/standards/epcis/>, <https://ref.gs1.org/standards/>, gs1:RegulationTypeCode-BATTERY_DIRECTIVE, <https://github.com/batterypass/BatteryPassDataModel>, <https://gs1.eu/wp-content/uploads/2024/10/Identification-and-labelling-of-industrial-and-electrical-vehicle-batteries-1.pdf>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2>.
<https://ref.openepcis.org/extensions/eu/battery/Battery> a owl:Class;
    rdfs:seeAlso <https://dpp-keystone.org/spec/v3/terms#BatteryProduct>;
    rdfs:subClassOf gs1:Product;
    rdfs:label "Battery"@en;
    rdfs:comment "A self-contained energy-storage device whose Digital Product Passport falls in scope of EU Regulation 2023/1542. Use as the primary `type` discriminator on a Battery product (typically paired with `gs1:Product` for canonical JSON-LD dual-typing, e.g. `\"type\": [\"Product\", \"Battery\"]`). The Battery Regulation Art. 3 category (eubat:LMTBattery, EVBattery, IndustrialBattery, StationaryBattery, PortableBattery, SLIBattery) is carried by schema:category, or alternatively by gs1:additionalProductClassification; see eubat:BatteryCategory."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <https://w3id.org/eudpp/battery#Battery>;
    skos:closeMatch <https://dpp-keystone.org/spec/v3/terms#BatteryProduct>.
<https://ref.openepcis.org/extensions/eu/battery/BatteryChemistry> a owl:Class;
    rdfs:label "Battery Chemistry"@en;
    rdfs:comment "The electrochemical system of the battery including cathode, anode, and electrolyte materials."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <https://w3id.org/eudpp/battery-materials#BatteryChemistry>.
<https://ref.openepcis.org/extensions/eu/battery/TechnicalSpecification> a owl:Class;
    rdfs:label "Technical Specification"@en;
    rdfs:comment "Technical specifications of a battery including capacity, voltage, and performance parameters."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "Required extension: GS1 Web Vocabulary does not provide battery-specific technical\nspecification properties (rated capacity, nominal voltage, cycle life, etc.) required by\nEU Battery Regulation Annex XIII. All measurements use gs1:QuantitativeValue pattern."@en;
    skos:broadMatch <urn:samm:io.BatteryPass.Performance:1.2.1#BatteryTechnicalPropertiesEntity>.
<https://ref.openepcis.org/extensions/eu/battery/BatteryMaterial> a owl:Class;
    rdfs:seeAlso oec:MaterialComposition;
    rdfs:subClassOf oec:MaterialComposition;
    rdfs:label "Battery Material"@en;
    rdfs:comment "A material used in battery construction with its composition percentage, CAS/EC identifiers, and sourcing information."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#BatteryMaterialEntity>;
    skos:broadMatch schema:Substance, oec:MaterialComposition, <https://w3id.org/eudpp#MaterialOfComposition>.
<https://ref.openepcis.org/extensions/eu/battery/RecycledContent> a owl:Class;
    rdfs:seeAlso oec:RecycledContent, oec:recycledContent;
    rdfs:label "Recycled Content"@en;
    rdfs:comment "Declaration of recycled material content in the battery with pre/post-consumer breakdown."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch oec:RecycledContent;
    skos:broadMatch <https://w3id.org/eudpp#RecycledMaterialsUseResult>;
    skos:closeMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#RecycledContentEntity>.
<https://ref.openepcis.org/extensions/eu/battery/EndOfLifeInfo> a owl:Class;
    rdfs:seeAlso oec:CircularityPerformance;
    rdfs:label "End of Life Information"@en;
    rdfs:comment "Information required for safe handling, dismantling, and recycling at end of battery life."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#EndOfLifeInformationEntity>;
    skos:narrowMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#DismantlingAndRemovalDocumentation>.
<https://ref.openepcis.org/extensions/eu/battery/HazardousSubstance> a owl:Class;
    rdfs:seeAlso schema:ChemicalSubstance, schema:Substance, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-13>;
    rdfs:label "Hazardous Substance"@en;
    rdfs:comment "A hazardous substance present in the battery, classified per EU CLP Regulation 1272/2008."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32008R1272>;
    skos:note "Hazardous-substance classification aligned with CLP (EC) 1272/2008, as required by the EU Battery Regulation (EU) 2023/1542."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.MaterialComposition:1.2.0#HazardousSubstanceEntity>;
    skos:broadMatch <https://w3id.org/eudpp#Substance>, schema:ChemicalSubstance, schema:Substance, <https://w3id.org/eudpp#SubstanceOfConcern>.
<https://ref.openepcis.org/extensions/eu/battery/DismantlingDocument> a owl:Class;
    rdfs:seeAlso gs1:ReferencedFileDetails;
    rdfs:subClassOf oec:DocumentReference;
    rdfs:label "Dismantling Document"@en;
    rdfs:comment "A document supporting battery dismantling, as specified in DIN DKE SPEC 99100."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://www.dinmedia.de/en/technical-rule/din-dke-spec-99100/385692321>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:narrowMatch <urn:samm:io.BatteryPass.Circularity:1.2.0#DismantlingAndRemovalDocumentation>;
    skos:broadMatch schema:DigitalDocument, <https://w3id.org/eudpp#DocumentFormattedProperty>.
<https://ref.openepcis.org/extensions/eu/battery/Label> a owl:Class;
    rdfs:label "Label"@en;
    rdfs:comment "A label or marking on the battery as required by EU Battery Regulation Annex VI."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en.
<https://ref.openepcis.org/extensions/eu/battery/SupplyChainDueDiligence> a owl:Class;
    rdfs:seeAlso <https://doi.org/10.1787/9789264252479-en>;
    rdfs:label "Supply Chain Due Diligence"@en;
    rdfs:comment "Supply chain due diligence information as required by EU Battery Regulation Art. 39."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "Required extension: Battery Regulation Art. 39 mandates due diligence for raw materials\n(cobalt, lithium, nickel, graphite). Aligned with OECD Due Diligence Guidance. GS1 does not\nprovide supply chain due diligence vocabulary."@en.
<https://ref.openepcis.org/extensions/eu/battery/PowerCapabilityAtSoC> a owl:Class;
    rdfs:label "Power Capability at SoC"@en;
    rdfs:comment "Power capability measurement at a specific state of charge level (80% or 20%)."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:closeMatch <urn:samm:io.BatteryPass.Performance:1.2.1#PowerCapabilityAtEntity>.
<https://ref.openepcis.org/extensions/eu/battery/TemperatureRange> a owl:Class;
    rdfs:label "Temperature Range"@en;
    rdfs:comment "A temperature range specification with minimum and maximum values for a specific operating context."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en.
<https://ref.openepcis.org/extensions/eu/battery/NegativeEvent> a owl:Class;
    rdfs:seeAlso <http://data.europa.eu/m8g/Event>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-69>;
    rdfs:label "Negative Event"@en;
    rdfs:comment "An adverse event affecting the battery such as accident, damage, or safety incident."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:exactMatch <urn:samm:io.BatteryPass.Performance:1.2.1#NegativeEventEntity>;
    skos:narrowMatch <https://w3id.org/eudpp/battery-performance#AccidentEvent>;
    skos:broadMatch schema:Event, <https://w3id.org/eudpp#ProductEvent>.
<https://ref.openepcis.org/extensions/eu/battery/CarbonFootprintDeclaration> a owl:Class;
    rdfs:seeAlso <https://gs1.eu/wp-content/uploads/2025/02/GDSN-Implementation-Guideline-for-exchanging-Carbon-Footprint-Data-3.pdf>, oec:EmissionsPerformance, <https://w3id.org/eudpp#LCIAResult>, oec:carbonFootprintTotal, oec:CarbonFootprintDeclaration, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>, <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-17>;
    rdfs:subClassOf oec:CarbonFootprintDeclaration;
    rdfs:label "Carbon Footprint Declaration"@en;
    rdfs:comment "Carbon footprint declaration for a battery including lifecycle breakdown and third-party verification."@en;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "Required extension: Battery Regulation Art. 7 requires lifecycle carbon footprint\nwith breakdown by phase (raw materials, production, distribution, recycling). This extends the\nGDSN CFP pattern with battery-specific lifecycle phases and performance class labeling.\nAligned with oec:EmissionsPerformance for core carbon footprint properties."@en;
    skos:narrowMatch <https://w3id.org/eudpp#CarbonFootprint>, <urn:samm:io.BatteryPass.CarbonFootprint:1.2.0#CarbonFootprintPerLifecycleStageEntity>;
    skos:broadMatch <https://w3id.org/eudpp#LCIAResult>.
<https://ref.openepcis.org/extensions/eu/battery/ThirdPartyVerification> a owl:Class;
    rdfs:label "Third Party Verification"@en;
    rdfs:comment "Third-party verification details for carbon footprint or other certified data."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R1542>;
    skos:note "EU Battery Regulation (EU) 2023/1542 (Annex XIII Digital Product Passport) attribute. No GS1, SEMICeu, or schema.org equivalent."@en;
    skos:broadMatch schema:Certification, <https://vocabulary.uncefact.org/untp/ConformityAssessment>, <https://dpp-keystone.org/spec/v3/terms#Certification>.
<https://ref.openepcis.org/extensions/eu/battery/MaterialRecoveryTarget> a owl:Class;
    rdfs:label "Material Recovery Target"@en;
    rdfs:comment "Recovery rate target or achievement for a specific material."@en;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/battery/>;
