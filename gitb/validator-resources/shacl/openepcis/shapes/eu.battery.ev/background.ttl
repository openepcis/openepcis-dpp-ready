    skos:notation "stationary".
_:b112 rdf:first <https://ref.openepcis.org/extensions/eu/battery/PortableBattery>;
    rdf:rest _:b113.
<https://ref.openepcis.org/extensions/eu/battery/PortableBattery> a <https://ref.openepcis.org/extensions/eu/battery/BatteryCategory>;
