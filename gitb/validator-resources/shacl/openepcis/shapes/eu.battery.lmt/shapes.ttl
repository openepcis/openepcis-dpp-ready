    sh:path gs1:hasSerialNumber;
    sh:maxCount 1;
    sh:datatype xsd:string.
_:b193 sh:name "Facility Identifier";
    sh:description "Mandatory per BatteryPass-Ready v1.3 (#11). Recommend GLN of the gs1:Place referenced by eubat:hasManufacturingPlace.";
    sh:path <https://ref.openepcis.org/extensions/eu/battery/facilityIdentifier>;
    sh:datatype xsd:string.
_:b194 sh:name "Economic Operator Identifier";
