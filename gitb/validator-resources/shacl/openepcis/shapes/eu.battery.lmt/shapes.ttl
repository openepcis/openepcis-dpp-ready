<https://ref.openepcis.org/extensions/eu/battery/BatteryShape> a sh:NodeShape;
    sh:targetClass <https://ref.openepcis.org/extensions/eu/battery/Battery>;
    sh:property _:b186, _:b187, _:b188, _:b189, _:b190, _:b191, _:b192, _:b193, _:b194, _:b195, _:b196, _:b197, _:b198, _:b199, _:b200, _:b201, _:b202, _:b203, _:b204, _:b205;
