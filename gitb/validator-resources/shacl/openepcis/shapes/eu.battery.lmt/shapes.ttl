dpp-sh:GranularityLevelConstraint a sh:NodeShape;
    sh:name "Granularity Level Constraint"@en;
    sh:property _:b148.
_:b148 sh:path oec:granularityLevel;
    sh:maxCount 1;
    sh:message "granularity must be model, batch, or item (EN 18223)"@en;
    sh:datatype xsd:string;
    sh:in _:b149.
_:b149 rdf:first "model";
    rdf:rest _:b150.
_:b150 rdf:first "batch";
    rdf:rest _:b151.
_:b151 rdf:first "item";
    rdf:rest rdf:nil.
dpp-sh:GranularityDigitalLinkConstraint a sh:NodeShape;
    sh:targetSubjectsOf oec:granularityLevel;
    sh:sparql _:b152.
_:b152 a sh:SPARQLConstraint;
    sh:message "granularity must match the GS1 Digital Link Application Identifiers of the passport IRI (01 -> model, 01+10 -> batch, 01+21 -> item) per EN 18219 4.4 / EN 18223."@en;
    sh:prefixes <https://ref.openepcis.org/extensions/common/core/shapes/>;
    sh:select "\n            SELECT $this ?value WHERE {\n                $this oec:granularityLevel ?value .\n                # The Digital Link is the node's own IRI; gs1:productID is honoured\n                # as an alternative carrier where a passport states it separately.\n                OPTIONAL { $this gs1:productID ?stated }\n                BIND( COALESCE(?stated, STR($this)) AS ?dl )\n                FILTER( REGEX(STR(?dl), \"/01/\") )\n                BIND( IF(REGEX(STR(?dl), \"/21/\"), \"item\",\n                       IF(REGEX(STR(?dl), \"/10/\"), \"batch\", \"model\")) AS ?expected )\n                FILTER( STR(?value) != ?expected )\n            }\n        ".
