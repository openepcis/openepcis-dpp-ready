_:b157 sh:path oec:granularityLevel;
    sh:maxCount 1;
    sh:message "granularity must be model, batch, or item (EN 18223)"@en;
    sh:datatype xsd:string;
    sh:in _:b158.
_:b158 rdf:first "model";
    rdf:rest _:b159.
_:b159 rdf:first "batch";
