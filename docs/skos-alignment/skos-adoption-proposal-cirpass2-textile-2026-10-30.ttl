    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#refersToTextileElement> .

eutex:relevantToTextileProcess
    a owl:ObjectProperty ;
    rdfs:label "Relevant To Textile Process"@en ;
    rdfs:comment "Links a textile substance‑of‑concern presence context to the textile process type that introduced, used, transformed or is affected by that substance."@en ;
    rdfs:domain eutex:TextileSubstanceOfConcernPresenceContext ;
    rdfs:range eutex:TextileProcess ;
