    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreCharacteristic> .

eutex:FibreCleanliness
    a owl:Class ;
    rdfs:label "Fibre Cleanliness"@en ;
    rdfs:comment "Quality characteristic describing the level of impurities or foreign matter remaining in a fibre."@en ;
