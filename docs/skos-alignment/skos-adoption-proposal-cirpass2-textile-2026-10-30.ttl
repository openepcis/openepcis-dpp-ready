    dcterms:source <https://w3id.org/eudpp/textile-durability#FunctionalFailureMode> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FunctionalFailureMode. Defines the generic functional‑failure mode concept for textile durability, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-durability#FunctionalFailureMode> .

eutex:FuzzingOrMatting
