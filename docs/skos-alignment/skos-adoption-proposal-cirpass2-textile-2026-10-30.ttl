    skos:closeMatch <https://w3id.org/eudpp/textile-process#TwistNumber> .

eutex:Upgradability
    a owl:Class ;
    rdfs:label "Upgradability"@en ;
    rdfs:comment "Ability of a textile product to be enhanced in functionality, performance, capacity, safety or aesthetics through upgrade actions."@en ;
