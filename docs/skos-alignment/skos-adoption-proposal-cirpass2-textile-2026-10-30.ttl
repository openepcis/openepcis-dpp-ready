    skos:closeMatch <https://w3id.org/eudpp/textile-process#FabricManufacturingMethodConcept> .

eutex:FabricManufacturingParameter
    a owl:Class ;
    rdfs:label "Fabric Manufacturing Parameter"@en ;
    rdfs:comment "Superclass covering process‑side parameters used during fabric manufacturing, excluding resulting structural characteristics."@en ;
