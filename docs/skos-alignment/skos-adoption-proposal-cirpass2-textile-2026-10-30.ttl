    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FabricRigidity> .

eutex:FabricSmoothness
    a owl:Class ;
    rdfs:label "Fabric Smoothness"@en ;
    rdfs:comment "Observed performance parameter describing the visible or tactile smoothness of a fabric surface, commonly assessed during visual inspection after washing, drying or other durability-related stress."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#FabricSmoothness> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricSmoothness. Captures the generic fabric‑smoothness concept for textile durability, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-durability#FabricSmoothness> .

eutex:FabricStrength
    a owl:Class ;
    rdfs:label "Fabric Strength"@en ;
    rdfs:comment "Aggregated observed mechanical performance parameter describing the strength of a fabric, potentially covering tensile strength, tear strength or bursting strength depending on the test context."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#FabricStrength> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricStrength. Defines the generic fabric‑strength concept for textile durability, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-durability#FabricStrength> .

eutex:FabricTactileCharacteristic
