    skos:closeMatch <https://w3id.org/eudpp/textile-core#hasTextileApparelProductType> .

eutex:hasTextileChemicalUseCategory
    a owl:ObjectProperty ;
    rdfs:label "Has Textile Chemical Use Category"@en ;
    rdfs:comment "Links a textile chemical substance to the controlled category that indicates whether it is used as a process chemical, a performance chemical or occurs unintentionally."@en ;
