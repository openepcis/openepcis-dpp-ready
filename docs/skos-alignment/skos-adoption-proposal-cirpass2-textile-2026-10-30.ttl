    dcterms:source <https://w3id.org/eudpp/textile-structure#FabricLustre> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricLustre. Captures the specific textile property of lustre, distinct from type or durability."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FabricLustre> .

eutex:FabricManufacturingMethodConcept
    a owl:Class ;
