    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:VisualPerformanceParameter. Captures measurable visual attributes distinct from generic performance or emissions data."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter> .

eutex:WashingTemperature
    a owl:Class ;
    rdfs:label "Washing Temperature"@en ;
    rdfs:comment "Care parameter describing the temperature used in a washing process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#WashingTemperature> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:WashingTemperature. Defines the specific temperature setting for textile washing, distinct from a generic temperature range."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#WashingTemperature> .

eutex:WeavePatternSpecification
    a owl:Class ;
    rdfs:label "Weave Pattern Specification"@en ;
    rdfs:comment "Process target specification stating the weave pattern to be produced."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#WeavePatternSpecification> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:WeavePatternSpecification. Captures the specific weave pattern intended for a textile product, distinct from generic product or display specifications."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#WeavePatternSpecification> .

eutex:WeavingProcess
    a owl:Class ;
    rdfs:label "Weaving Process"@en ;
    rdfs:comment "Fabric manufacturing process in which two sets of yarns are interlaced at right angles on a loom."@en ;
