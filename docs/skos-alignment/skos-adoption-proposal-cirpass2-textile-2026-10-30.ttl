    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#providedBy> .

eutex:providesGuidance
    a owl:ObjectProperty ;
    rdfs:label "Provides Guidance"@en ;
    rdfs:comment "Links a repair service to the guidance made available through that service."@en ;
    rdfs:range eutex:RepairGuidance ; # CHECK: unknown class
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#providesGuidance> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:providesGuidance. Captures the relationship between a repair service and its guidance content."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#providesGuidance> .

eutex:refersToComponent
    a owl:ObjectProperty ;
    rdfs:label "Refers To Component"@en ;
    rdfs:comment "Links a priority repair element role to the concrete non‑textile component it targets."@en ;
    rdfs:range eutex:NonTextileComponent ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#refersToComponent> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:refersToComponent. Captures the relationship between a priority repair element and the non‑textile component it addresses."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#refersToComponent> .

eutex:refersToNonTextileComponent
    a owl:ObjectProperty ;
    rdfs:label "Refers To Non‑Textile Component"@en ;
    rdfs:comment "Relates a recyclability barrier to the non‑textile component that is responsible for or affected by the barrier."@en ;
