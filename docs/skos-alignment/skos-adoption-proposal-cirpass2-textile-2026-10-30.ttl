    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#refersToNonTextileComponent> .

eutex:refersToSubstancePresence
    a owl:ObjectProperty ;
    rdfs:label "Refers To Substance Presence"@en ;
    rdfs:comment "Relates a recyclability barrier to the textile substance‑of‑concern presence context that it addresses or is affected by."@en ;
