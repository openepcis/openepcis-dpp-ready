    dcterms:source <https://w3id.org/eudpp/textile-durability#FailureMode> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FailureMode. Captures the discrete failure events that are separate from performance metrics, aligning with textile durability reporting."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#FailureMode> .

eutex:FibreCharacteristic
