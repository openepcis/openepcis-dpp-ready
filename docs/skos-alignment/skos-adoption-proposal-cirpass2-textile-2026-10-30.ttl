    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#assessesRecyclingRoute> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:assessesRecyclingRoute. Links a recyclability assessment to the specific recycling route it examines."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#assessesRecyclingRoute> .

eutex:awardsScoreValue
    a owl:ObjectProperty ;
