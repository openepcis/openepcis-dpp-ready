    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#requiresRouteStage> .

eutex:resultForRecyclingRoute
    a owl:ObjectProperty ;
    rdfs:label "Result For Recycling Route"@en ;
    rdfs:comment "Relates a recyclability assessment result to the recycling route for which it is valid."@en ;
    rdfs:domain eutex:RecyclabilityAssessmentResult ; # CHECK: unknown class
