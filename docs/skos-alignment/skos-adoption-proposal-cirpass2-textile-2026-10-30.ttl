    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreCleanliness> .

eutex:FibreColour
    a owl:Class ;
    rdfs:label "Fibre Colour"@en ;
    rdfs:comment "Visual characteristic of a textile fibre describing its colour and how that influences dyeing or bleaching behaviour."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FibreColour> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FibreColour. Adds a fibre‑level colour attribute distinct from overall fabric type or substance of concern."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreColour> .

eutex:FibreElasticity
