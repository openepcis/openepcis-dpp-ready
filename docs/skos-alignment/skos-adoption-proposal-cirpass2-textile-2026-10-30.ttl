    dcterms:source <https://w3id.org/eudpp/textile-structure#FibreElasticity> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FibreElasticity. Adds a fibre‑level elasticity attribute distinct from overall fabric type or recovered material."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreElasticity> .

eutex:FibreFineness
    a owl:Class ;
    rdfs:label "Fibre Fineness"@en ;
    rdfs:comment "Structural property of a textile fibre expressed as linear density or fineness."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FibreFineness> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FibreFineness. Captures the fibre‑level fineness attribute, distinct from overall fabric type or essential characteristics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreFineness> .

eutex:FibreLength
    a owl:Class ;
    rdfs:label "Fibre Length"@en ;
    rdfs:comment "Structural property of a textile fibre expressed as the length of the individual fibre."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FibreLength> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FibreLength. Captures the fibre‑level length attribute, distinct from fabric type or microplastic shedding information."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreLength> .

eutex:FibrePreparationProcess
    a owl:Class ;
    rdfs:label "Fibre Preparation Process"@en ;
