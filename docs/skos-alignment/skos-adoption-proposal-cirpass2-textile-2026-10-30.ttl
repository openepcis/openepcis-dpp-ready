    skos:closeMatch <https://w3id.org/eudpp/textile-durability#HoleInSeam> .

eutex:HumidityControl
    a owl:Class ;
    rdfs:label "Humidity Control"@en ;
    rdfs:comment "Process parameter describing control of humidity during textile manufacturing, processing or care."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#HumidityControl> ;
