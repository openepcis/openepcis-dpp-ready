    skos:closeMatch <https://w3id.org/eudpp/textile-process#HumidityControl> .

eutex:IncinerationProcess
    a owl:Class ;
    rdfs:label "Incineration Process"@en ;
    rdfs:comment "End‑of‑life process involving combustion of textile products or textile waste."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#IncinerationProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:IncinerationProcess. Captures the specific incineration step in textile end‑of‑life treatment, distinct from general take‑back or program classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#IncinerationProcess> .

eutex:InputYarnCountSpecification
    a owl:Class ;
    rdfs:label "Input Yarn Count Specification"@en ;
    rdfs:comment "Process target or input specification stating the yarn count or yarn linear‑density class selected for fabric manufacturing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#InputYarnCountSpecification> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:InputYarnCountSpecification. Defines the yarn‑count specification used as a manufacturing input, distinct from general textile product or fabric type classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#InputYarnCountSpecification> .

eutex:IntermediateTextileCharacteristic
    a owl:Class ;
    rdfs:label "Intermediate Textile Characteristic"@en ;
    rdfs:comment "Property of an intermediate textile structure such as yarn, fabric or assembly that is not a final product but influences performance."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:IntermediateTextileCharacteristic. Adds a generic intermediate‑level characteristic class, distinct from overall textile product or essential characteristics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic> .

eutex:InterpretationScale
    a owl:Class ;
    rdfs:label "Interpretation Scale"@en ;
    rdfs:comment "A numeric or categorical scale used to interpret, classify or rate the result of a textile assessment."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#InterpretationScale> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:InterpretationScale. Captures the scale that translates raw assessment data into a meaningful rating, distinct from the assessment method or parameter."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#InterpretationScale> .

eutex:IroningProcess
    a owl:Class ;
    rdfs:label "Ironing Process"@en ;
    rdfs:comment "Confectioning or care‑related process applying heat and pressure to shape, smooth or finish textile products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#IroningProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:IroningProcess. Captures the specific ironing step in textile manufacturing or care, distinct from general textile product classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#IroningProcess> .

eutex:KnittingPatternSpecification
    a owl:Class ;
    rdfs:label "Knitting Pattern Specification"@en ;
    rdfs:comment "Process target specification stating the knitting structure or pattern to be produced."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#KnittingPatternSpecification> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:KnittingPatternSpecification. Captures the specific knitting pattern target in textile manufacturing, distinct from general textile product or fabric type classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#KnittingPatternSpecification> .

eutex:KnittingProcess
    a owl:Class ;
    rdfs:label "Knitting Process"@en ;
    rdfs:comment "Fabric manufacturing process in which yarns are interlooped using needles to form fabric on knitting machines."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#KnittingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:KnittingProcess. Defines the specific knitting manufacturing step, distinct from general textile product or fabric type classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#KnittingProcess> .

eutex:LaminatingProcess
    a owl:Class ;
    rdfs:label "Laminating Process"@en ;
    rdfs:comment "Finishing or assembly process joining textile materials with layers or membranes."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#LaminatingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:LaminatingProcess. Captures the specific laminating step in textile finishing, distinct from general textile product or fabric type classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#LaminatingProcess> .

eutex:LandfillingProcess
    a owl:Class ;
    rdfs:label "Landfilling Process"@en ;
    rdfs:comment "End‑of‑life process involving disposal of textile products or textile waste in landfill."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#LandfillingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:LandfillingProcess. Captures the specific landfill disposal step for textile waste, distinct from general end‑of‑life program classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#LandfillingProcess> .

eutex:LifeExtensionInterventionAspect
    a owl:Class ;
    rdfs:label "Life Extension Intervention Aspect"@en ;
    rdfs:comment "Product aspect concerning intervention‑based extension or restoration of textile product use, functionality or value through repair, upgrade, refurbishment or remanufacturing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:LifeExtensionInterventionAspect. This class captures the textile‑specific intervention aspect that aligns with the broader lifecycle stage concept but is focused on life‑extension activities."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect> .

eutex:LifeExtensionProductEvent
    a owl:Class ;
    rdfs:label "Life Extension Product Event"@en ;
    rdfs:comment "Concrete textile process occurrence that extends, restores or substantially changes the useful life, functionality or condition of a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:LifeExtensionProductEvent. Captures the textile‑specific product event that aligns with the broader lifecycle stage concept but focuses on life‑extension activities."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent> .

eutex:LiquorRatio
    a owl:Class ;
    rdfs:label "Liquor Ratio"@en ;
    rdfs:comment "Dyeing‑process parameter expressing the relation between the quantity of treatment liquor and the mass of dry textile material, with explicit reporting basis and unit."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#LiquorRatio> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:LiquorRatio. Captures the specific dyeing parameter needed for textile process reporting, not covered by existing classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#LiquorRatio> .

eutex:LogoFailure
    a owl:Class ;
    rdfs:label "Logo Failure"@en ;
    rdfs:comment "Failure of a logo on a textile product, whether printed, embroidered or applied as a separate component."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#LogoFailure> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:LogoFailure. Captures a visual‑failure mode specific to logos, distinct from general repair or durability terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#LogoFailure> .

eutex:LossOfComfort
    a owl:Class ;
    rdfs:label "Loss of Comfort"@en ;
    rdfs:comment "Functional failure mode indicating a loss of comfort or comfort‑related suitability during use, maintenance or ageing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#LossOfComfort> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:LossOfComfort. Captures a specific comfort‑related failure distinct from general durability or repairability concepts."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#LossOfComfort> .

eutex:LossOfDimensionalStability
    a owl:Class ;
    rdfs:label "Loss Of Dimensional Stability"@en ;
    rdfs:comment "Failure expression corresponding to loss of the ability of a textile product or fabric to retain its dimensions after use, laundering or treatment cycles."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:LossOfDimensionalStability. Defines the specific failure mode for dimensional stability loss in textile durability, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability> .

eutex:MachineryCharacteristic
    a owl:Class ;
    rdfs:label "Machinery Characteristic"@en ;
    rdfs:comment "Process parameter or equipment characteristic describing machinery quality, configuration or components relevant to textile processing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#MachineryCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:MachineryCharacteristic. Captures the generic machinery‑characteristic concept for textile processes, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#MachineryCharacteristic> .

eutex:MaintenanceAndRepairProcess
    a owl:Class ;
    rdfs:label "Maintenance and Repair Process"@en ;
    rdfs:comment "Process that extends product lifetime through maintenance or repair activities, distinct from assessment indicators."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#MaintenanceAndRepairProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:MaintenanceAndRepairProcess. Captures the specific maintenance/repair activity class needed for textile lifecycle reporting."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#MaintenanceAndRepairProcess> .

eutex:MeasurementParameter
    a owl:Class ;
    rdfs:label "Measurement Parameter"@en ;
    rdfs:comment "A protocol variable that is controlled or recorded during a measurement or test, distinct from the product performance characteristic being assessed."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#MeasurementParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:MeasurementParameter. Captures the controlled or recorded settings that influence a measurement, separate from the assessed attribute."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#MeasurementParameter> .

eutex:MeasurementParameterSetting
    a owl:Class ;
    rdfs:label "Measurement Parameter Setting"@en ;
    rdfs:comment "A concrete assignment of a quantitative or controlled value to a measurement parameter within an assessment execution or protocol."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#MeasurementParameterSetting> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:MeasurementParameterSetting. Captures the specific value given to a measurement parameter, distinct from the parameter definition itself."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#MeasurementParameterSetting> .

eutex:MechanicalFailureMode
    a owl:Class ;
    rdfs:label "Mechanical Failure Mode"@en ;
    rdfs:comment "Category of failure modes primarily involving rupture, tearing or other mechanical damage to a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#MechanicalFailureMode> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:MechanicalFailureMode. Captures a distinct mechanical failure category not represented by existing repair or durability terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#MechanicalFailureMode> .

eutex:MechanicalFinishingProcess
    a owl:Class ;
    rdfs:label "Mechanical Finishing Process"@en ;
    rdfs:comment "Finishing process that uses mechanical treatment to modify the physical properties, surface behaviour, handling or appearance of textile materials or products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#MechanicalFinishingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:MechanicalFinishingProcess. Captures the specific mechanical finishing activity required for textile lifecycle reporting, distinct from other process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#MechanicalFinishingProcess> .

eutex:MechanicalRecyclingProcess
    a owl:Class ;
    rdfs:label "Mechanical Recycling Process"@en ;
    rdfs:comment "Recycling process mechanically transforming textile products or textile waste into reusable fibres or materials."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:MechanicalRecyclingProcess. Defines the generic mechanical recycling process for textile products, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess> .

eutex:ModularityFeature
    a owl:Class ;
    rdfs:label "Modularity Feature"@en ;
    rdfs:comment "Design feature by which relevant product elements are modular, detachable or interchangeable to support repair or upgrade."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#ModularityFeature> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ModularityFeature. Captures the textile‑specific modularity concept, aligning with the broader component type notion used in electronics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#ModularityFeature> .

eutex:MoistureRetention
    a owl:Class ;
    rdfs:label "Moisture Retention"@en ;
    rdfs:comment "Physical fibre property describing the capacity of fibres to absorb or retain moisture."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#MoistureRetention> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:MoistureRetention. Adds a fibre‑level moisture handling characteristic, distinct from recovery or material categories."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#MoistureRetention> .

eutex:NonTextileComponent
    a owl:Class ;
    rdfs:label "Non-Textile Component"@en ;
    rdfs:comment "A physical component integrated into a textile product that is not part of the primary textile fibre composition, such as a button, zipper or sequin."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:NonTextileComponent. Captures the generic concept of a non‑textile component within textile products, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent> .

eutex:NonTextileComponentMaterialGroup
    a owl:Class ;
    rdfs:label "Non-Textile Component Material Group"@en ;
    rdfs:comment "Material grouping associated with one or more non‑textile components, used as a location or concentration reference unit without treating the component itself as a material group."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#NonTextileComponentMaterialGroup> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:NonTextileComponentMaterialGroup. Captures the grouping of non‑textile components for SOC reporting, distinct from textile material categories."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#NonTextileComponentMaterialGroup> .

eutex:NonTextileComponentTypeConcept
    a owl:Class ;
    rdfs:label "Non-Textile Component Type Concept"@en ;
    rdfs:comment "A controlled SKOS concept used to classify the functional type of a non‑textile component integrated into a textile product, such as button, zipper or sequin."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials#NonTextileComponentTypeConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:NonTextileComponentTypeConcept. Provides a reusable taxonomy for the functional categories of non‑textile parts that influence durability, recyclability or compliance."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-associated-materials#NonTextileComponentTypeConcept> .

eutex:NonwovenManufacturingProcess
    a owl:Class ;
    rdfs:label "Nonwoven Manufacturing Process"@en ;
    rdfs:comment "Fabric manufacturing process that produces non‑woven textile structures by bonding or entangling fibres or filaments."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#NonwovenManufacturingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:NonwovenManufacturingProcess. Captures the specific non‑woven production activity required for textile lifecycle reporting, distinct from other process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#NonwovenManufacturingProcess> .

eutex:NumberOfCycles
    a owl:Class ;
    rdfs:label "Number of Cycles"@en ;
    rdfs:comment "The count of repeated test, washing, abrasion or simulated‑use cycles performed on a textile product during an assessment."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#NumberOfCycles> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:NumberOfCycles. Defines the specific measurement parameter for textile durability tests, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#NumberOfCycles> .

eutex:ObservedDegradationPhenomenon
    a owl:Class ;
    rdfs:label "Observed Degradation Phenomenon"@en ;
    rdfs:comment "Observable physical deterioration of a textile material or product, distinct from the performance characteristic that measures resistance to such degradation."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ObservedDegradationPhenomenon. Captures a specific observable degradation event not represented by existing durability or biodegradability terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon> .

eutex:PackagingMaterial
    a owl:Class ;
    rdfs:label "Packaging Material"@en ;
    rdfs:comment "A material occurrence used for the packaging, transport, storage or delivery of a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PackagingMaterial. Defines the generic concept of a material used in textile packaging, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial> .

eutex:PackagingMaterialTypeConcept
    a owl:Class ;
    rdfs:label "Packaging Material Type Concept"@en ;
    rdfs:comment "A controlled SKOS concept used to classify a packaging material occurrence."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials#PackagingMaterialTypeConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PackagingMaterialTypeConcept. Provides a reusable taxonomy for the functional type of packaging materials used with textile products, supporting traceability and sustainability reporting."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-associated-materials#PackagingMaterialTypeConcept> .

eutex:PackagingProcess
    a owl:Class ;
    rdfs:label "Packaging Process"@en ;
    rdfs:comment "Process context in which packaging material is used as an input, distinct from ordinary textile manufacturing processes."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#PackagingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PackagingProcess. Defines the generic packaging process for textile products, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#PackagingProcess> .

eutex:PerformanceThreshold
    a owl:Class ;
    rdfs:label "Performance Threshold"@en ;
    rdfs:comment "A decision criterion that specifies a minimum, maximum, target or equality value against which an assessment result is evaluated."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#PerformanceThreshold> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PerformanceThreshold. Captures the generic threshold concept used in textile performance assessments, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#PerformanceThreshold> .

eutex:Pilling
    a owl:Class ;
    rdfs:label "Pilling"@en ;
    rdfs:comment "Observed surface degradation phenomenon involving the formation of small balls or pills of entangled fibres on a textile surface during wear, friction, use or testing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#Pilling> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:Pilling. Captures the specific surface‑degradation failure mode for pilling in textile durability, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-durability#Pilling> .

eutex:PolycottonThermoChemicalRecyclingProcess
    a owl:Class ;
    rdfs:label "Polycotton Thermo‑Chemical Recycling Process"@en ;
    rdfs:comment "Chemical or thermo‑chemical recycling process for polycotton blends that produces cellulosic pulp, polyester fibres, polymers or monomers depending on the applied technique."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#PolycottonThermoChemicalRecyclingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PolycottonThermoChemicalRecyclingProcess. Captures the specific polycotton thermo‑chemical recycling activity required for textile lifecycle reporting, distinct from other process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#PolycottonThermoChemicalRecyclingProcess> .

eutex:PrintingBinderUse
    a owl:Class ;
    rdfs:label "Printing Binder Use"@en ;
    rdfs:comment "Use of a binder substance or chemical in the printing process, recorded as a process‑use aspect within TEXTILE_ASSOCIATED_MATERIALS."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#PrintingBinderUse> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PrintingBinderUse. Captures the specific binder‑use activity in textile printing, distinct from other process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#PrintingBinderUse> .

eutex:PrintingParameter
    a owl:Class ;
    rdfs:label "Printing Parameter"@en ;
    rdfs:comment "Process parameter relevant to textile printing, such as temperature, pressure or ink composition."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#PrintingParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PrintingParameter. Captures the specific printing‑parameter activity in textile manufacturing, distinct from other process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#PrintingParameter> .

eutex:PrintingProcess
    a owl:Class ;
    rdfs:label "Printing Process"@en ;
    rdfs:comment "Textile process that applies colour, patterns or markings to textile materials or products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#PrintingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PrintingProcess. Captures the specific printing activity in textile manufacturing, distinct from other process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#PrintingProcess> .

eutex:PriorityRepairElement
    a owl:Class ;
    rdfs:label "Priority Repair Element"@en ;
    rdfs:comment "Assessment role assigned to a product element that is important for repairability because of failure frequency or functional relevance."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#PriorityRepairElement> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PriorityRepairElement. Captures the textile‑specific priority repair element concept, aligning with the broader repair criterion used in electronics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#PriorityRepairElement> .

eutex:ProcessControlParameter
    a owl:Class ;
    rdfs:label "Process Control Parameter"@en ;
    rdfs:comment "Parameter that controls, configures or monitors the execution conditions of a textile process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ProcessControlParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ProcessControlParameter. Captures the specific control‑parameter concept needed for textile process monitoring, distinct from other parameter classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ProcessControlParameter> .

eutex:ProcessMethodConcept
    a owl:Class ;
    rdfs:label "Process Method Concept"@en ;
    rdfs:comment "Controlled value representing a textile process method or technique."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ProcessMethodConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ProcessMethodConcept. Provides a dedicated concept class for enumerating textile process methods, distinct from existing product or chain‑of‑custody classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ProcessMethodConcept> .

eutex:ProcessParameter
    a owl:Class ;
    rdfs:label "Process Parameter"@en ;
    rdfs:comment "Semantic type for a configurable process condition, method choice, control variable or target specification relevant to a textile process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ProcessParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ProcessParameter. Provides a dedicated class for representing any adjustable or targetable aspect of a textile process, distinct from existing product or chain‑of‑custody classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ProcessParameter> .

eutex:ProcessParameterSetting
    a owl:Class ;
    rdfs:label "Process Parameter Setting"@en ;
    rdfs:comment "Concrete value or selected category assigned to a process parameter for a specific textile process execution."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ProcessParameterSetting> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ProcessParameterSetting. Captures the instantiated setting of a process parameter, distinct from the abstract parameter definition."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ProcessParameterSetting> .

eutex:ProductAgeing
    a owl:Class ;
    rdfs:label "Product Ageing"@en ;
    rdfs:comment "Progressive change or degradation of textile product performance over time under repeated use, care, environmental exposure or stress."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#ProductAgeing> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ProductAgeing. Captures the generic ageing concept for textile durability, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-durability#ProductAgeing> .

eutex:ProductReplacementFrequency
    a owl:Class ;
    rdfs:label "Product Replacement Frequency"@en ;
    rdfs:comment "Indicator of how often a product is replaced, recognising that replacement depends on durability, fit, perceived value and fashion trends."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-indicator#ProductReplacementFrequency> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ProductReplacementFrequency. Captures a consumer‑centric replacement metric not represented by durability or repairability terms."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-indicator#ProductReplacementFrequency> .

eutex:ProductTechnologyLevelConcept
    a owl:Class ;
    rdfs:label "Product Technology Level Concept"@en ;
    rdfs:comment "A controlled concept classifying a product technology as base case, best‑available technology or best‑not‑yet‑available technology."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ProductTechnologyLevelConcept. Captures the maturity tier of a textile product’s technology, enabling comparison across supply‑chain stages."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept> .

eutex:PyrolysisGasificationRecyclingProcess
    a owl:Class ;
    rdfs:label "Pyrolysis or Gasification Recycling Process"@en ;
    rdfs:comment "Thermo‑chemical process that produces syngas or pyrolysis oil for use as a feedstock in material production; fuel‑use energy recovery is not considered recycling."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#PyrolysisGasificationRecyclingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:PyrolysisGasificationRecyclingProcess. Defines the specific thermo‑chemical recycling pathway for textile products, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#PyrolysisGasificationRecyclingProcess> .

eutex:RadiationInducedDegradation
    a owl:Class ;
    rdfs:label "Radiation-Induced Degradation"@en ;
    rdfs:comment "Degradation of textile material or product properties caused by exposure to ultraviolet or other relevant radiation."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#RadiationInducedDegradation> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RadiationInducedDegradation. Captures a specific degradation mechanism not covered by general durability or biodegradability terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#RadiationInducedDegradation> .

eutex:RatingScale
    a owl:Class ;
    rdfs:label "Rating Scale"@en ;
    rdfs:comment "An interpretation scale composed of controlled rating values or grades used to evaluate assessment results."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#RatingScale> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RatingScale. Captures the set of allowed rating values or grades applied to a textile assessment outcome, distinct from the raw result."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#RatingScale> .

eutex:RatingValueConcept
    a owl:Class ;
    rdfs:label "Rating Value Concept"@en ;
    rdfs:comment "A controlled rating value, grade or scale level used as a SKOS concept in textile assessment results."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#RatingValueConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RatingValueConcept. Provides the individual value that populates a RatingScale for textile assessment outcomes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#RatingValueConcept> .

eutex:RecoveredMaterialQualityResult
    a owl:Class ;
    rdfs:label "Recovered Material Quality Result"@en ;
    rdfs:comment "Assessment result indicating whether recovered textile material meets the quality requirements for its intended use."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecoveredMaterialQualityResult> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecoveredMaterialQualityResult. Captures the outcome of a quality check on recovered textile material, distinct from generic recovery or target classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecoveredMaterialQualityResult> .

eutex:RecoveredTextileMaterial
    a owl:Class ;
    rdfs:label "Recovered Textile Material"@en ;
    rdfs:comment "Material output recovered from an actual textile recycling process and potentially usable as input to another production process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecoveredTextileMaterial. Defines the specific recovered textile stream distinct from generic recovered material classes, enabling traceability of textile recycling outputs."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial> .

eutex:RecyclabilityBarrier
    a owl:Class ;
    rdfs:label "Recyclability Barrier"@en ;
    rdfs:comment "Product, material, substance, information or system condition that hinders collection, sorting, preparation, recycling or the use and quality of recovered material for a specified route."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecyclabilityBarrier. Captures the specific concept of a barrier to recyclability, not represented by existing terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier> .

eutex:RecyclabilityBarrierTypeConcept
    a owl:Class ;
    rdfs:label "Recyclability Barrier Type Concept"@en ;
    rdfs:comment "Controlled concept classifying a recyclability barrier."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecyclabilityBarrierTypeConcept. Provides a controlled vocabulary for the different kinds of barriers that can impede textile recyclability, distinct from individual barrier instances."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept> .

eutex:RecyclabilityLabelConcept
    a owl:Class ;
    rdfs:label "Recyclability Label Concept"@en ;
    rdfs:comment "Controlled categorical label used by a specified recyclability scoring method."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecyclabilityLabelConcept. Provides a controlled vocabulary for the labels (e.g., A/B/C, 0‑10 score) that a recyclability assessment can assign to a textile product."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept> .

eutex:RecycledContentAssessment
    a owl:Class ;
    rdfs:label "Recycled Content Assessment"@en ;
    rdfs:comment "Assessment execution that verifies or evaluates a recycled‑content declaration for a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecycledContentAssessment. Defines the specific act of assessing a recycled‑content declaration, distinct from the declaration itself."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment> .

eutex:RecycledContentAssessmentResult
    a owl:Class ;
    rdfs:label "Recycled Content Assessment Result"@en ;
    rdfs:comment "Assessment result reporting the outcome of verifying or evaluating a recycled‑content declaration."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecycledContentAssessmentResult. Captures the outcome of a recycled‑content assessment, distinct from the declaration or the assessment itself."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult> .

eutex:RecycledContentPerformanceThreshold
    a owl:Class ;
    rdfs:label "Recycled Content Performance Threshold"@en ;
    rdfs:comment "Performance threshold defining a minimum recycled‑content value for a stated product, fibre or source context."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecycledContentPerformanceThreshold> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecycledContentPerformanceThreshold. Captures the minimum recycled‑content requirement that a textile item must meet, distinct from declarations or assessment results."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecycledContentPerformanceThreshold> .

eutex:RecycledContentVerificationMethod
    a owl:Class ;
    rdfs:label "Recycled Content Verification Method"@en ;
    rdfs:comment "Assessment method used to verify a recycled‑content declaration where no direct laboratory determination of recycled versus virgin fibre origin is available at scale."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecycledContentVerificationMethod. Defines the method by which recycled‑content claims are verified, distinct from declarations or assessment results."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod> .

eutex:RecycledTextileFibre
    a owl:Class ;
    rdfs:label "Recycled Textile Fibre"@en ;
    rdfs:comment "Recovered textile material represented as a textile fibre suitable, subject to quality and process requirements, for use in textile products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecycledTextileFibre> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecycledTextileFibre. Captures the specific material type of recycled textile fibre, distinct from generic recycled content or fibre types."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecycledTextileFibre> .

eutex:RecyclingLoopConcept
    a owl:Class ;
    rdfs:label "Recycling Loop Concept"@en ;
    rdfs:comment "Controlled concept identifying the intended material‑loop destination of a recycling route."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RecyclingLoopConcept. Captures the specific loop destination concept for textile recycling, distinct from generic recycled content or rate."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept> .

eutex:ReferencePeriod
    a owl:Class ;
    rdfs:label "Reference Period"@en ;
    rdfs:comment "A structured temporal interval that specifies the period to which an observation, indicator or other time‑bound textile statement applies."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-connector#ReferencePeriod> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ReferencePeriod. Provides a reusable representation for time intervals used in textile product passports."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-connector#ReferencePeriod> .

eutex:RefurbishmentProcess
    a owl:Class ;
    rdfs:label "Refurbishment Process"@en ;
    rdfs:comment "Process involving preparation, cleaning, testing, servicing and, where necessary, repair to restore a textile product within its originally intended use and performance range."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RefurbishmentProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RefurbishmentProcess. Captures the textile‑specific refurbishment process concept, aligning with the broader repair criterion used in electronics repairability assessments."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RefurbishmentProcess> .

eutex:RemanufacturingPossibility
    a owl:Class ;
    rdfs:label "Remanufacturing Possibility"@en ;
    rdfs:comment "Potential to produce a new product from waste textiles, components or products through at least one change that may alter performance, purpose or type."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RemanufacturingPossibility> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RemanufacturingPossibility. Captures the generic remanufacturing capability for textiles, distinct from specific repair or refurbishment events."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RemanufacturingPossibility> .

eutex:RemanufacturingProcess
    a owl:Class ;
    rdfs:label "Remanufacturing Process"@en ;
    rdfs:comment "Process that creates a new textile product from waste textiles, components or products through at least one change that may alter performance, purpose or type, distinct from material recycling."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RemanufacturingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RemanufacturingProcess. Defines the specific remanufacturing activity for textiles, separate from generic remanufacturing possibility or recycling."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RemanufacturingProcess> .

eutex:RepairActionTypeConcept
    a owl:Class ;
    rdfs:label "Repair Action Type Concept"@en ;
    rdfs:comment "Controlled process‑method concept identifying a textile repair action such as patching, mending, button replacement or zipper replacement."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RepairActionTypeConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RepairActionTypeConcept. Aligns with the existing Repair Criterion Type concept, which captures repair‑action categories in a similar context."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RepairActionTypeConcept> .

eutex:RepairActorTypeConcept
    a owl:Class ;
    rdfs:label "Repair Actor Type Concept"@en ;
    rdfs:comment "SKOS concept used to classify the role or category of an actor participating in textile repair."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RepairActorTypeConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RepairActorTypeConcept. Aligns with the generic Actor Role concept, which captures roles such as repair provider, technician or consumer in a repair context."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RepairActorTypeConcept> .

eutex:RepairCostCondition
    a owl:Class ;
    rdfs:label "Repair Cost Condition"@en ;
    rdfs:comment "Economic condition describing repair cost relative to a comparable new product price and its influence on a repair decision."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RepairCostCondition> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RepairCostCondition. Captures the cost‑based decision factor for textile repair, distinct from generic repair criteria or cost property."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RepairCostCondition> .

eutex:RepairProcess
    a owl:Class ;
    rdfs:label "Repair Process"@en ;
    rdfs:comment "Process that extends the usable lifetime of a textile product; links to repair‑related indicators are handled in other modules."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#RepairProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RepairProcess. Defines the generic repair process for textile products, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#RepairProcess> .

eutex:RepairRelatedProcess
    a owl:Class ;
    rdfs:label "Repair-Related Life‑Extension Process"@en ;
    rdfs:comment "Textile process type related to upgrade, refurbishment or remanufacturing and organised with repair under the broader family of life‑extension interventions."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RepairRelatedProcess. Defines the specific category of textile processes that extend product life through repair‑related activities, distinct from general repair criteria."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess> .

eutex:RepairServiceConfigurationConcept
    a owl:Class ;
    rdfs:label "Repair Service Configuration Concept"@en ;
    rdfs:comment "SKOS concept representing a BC, BAT or BNAT repair‑service and guidance configuration from JRC Table 48."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RepairServiceConfigurationConcept. Captures the specific configuration of repair services required for textile products, distinct from generic repair providers or criteria."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept> .

eutex:Repairability
    a owl:Class ;
    rdfs:label "Repairability"@en ;
    rdfs:comment "Ability of a defective textile product or waste object to return, through one or more actions, to a condition that fulfills its intended use, with user acceptance of restored functionality and possibly altered aesthetics."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#Repairability> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:Repairability. Captures the broader textile‑specific repairability concept, distinct from generic repair information or index."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#Repairability> .

eutex:RepairabilityContextCondition
    a owl:Class ;
    rdfs:label "Repairability Contextual Condition"@en ;
    rdfs:comment "Assessment condition external to intrinsic product design that influences repair feasibility or the decision to repair."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RepairabilityContextCondition. Captures external factors affecting repairability, distinct from the intrinsic product design or specific criteria."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition> .

eutex:RepairabilityDesignFeature
    a owl:Class ;
    rdfs:label "Repairability Design Feature"@en ;
    rdfs:comment "Design‑related feature that may enable repair, upgrade, refurbishment or remanufacturing, such as modularity, standardisation or disassembly."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RepairabilityDesignFeature. Captures intrinsic product design attributes that facilitate repair, distinct from external contextual conditions or specific criteria."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature> .

eutex:ReuseProcess
    a owl:Class ;
    rdfs:label "Reuse Process"@en ;
    rdfs:comment "End‑of‑life or post‑use process that enables a textile product to be used again without major material transformation."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ReuseProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ReuseProcess. Captures the generic reuse activity for textiles, distinct from take‑back or end‑of‑life programs."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ReuseProcess> .

eutex:RoughOrStiffFabric
    a owl:Class ;
    rdfs:label "Rough or Stiff Fabric"@en ;
    rdfs:comment "Failure mode in which a fabric becomes or is perceived as rough, stiff or unpleasant to touch, affecting user acceptance and comfort-related use."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:RoughOrStiffFabric. Captures a specific tactile degradation that is not represented by general durability or robustness assessments."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric> .

eutex:SeamConstructionParameter
    a owl:Class ;
    rdfs:label "Seam Construction Parameter"@en ;
    rdfs:comment "Sewing parameter describing seam type, stitch, thread, construction or other seam‑related configuration."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SeamConstructionParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SeamConstructionParameter. Captures the specific sewing configuration that influences durability and recyclability of a textile product."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SeamConstructionParameter> .

eutex:SeamFailure
    a owl:Class ;
    rdfs:label "Seam Failure"@en ;
    rdfs:comment "Structural or assembly‑related failure mode involving loss of seam integrity or functionality."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#SeamFailure> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SeamFailure. Captures a specific failure mode not represented by existing repair or durability terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#SeamFailure> .

eutex:SeamSlippage
    a owl:Class ;
    rdfs:label "Seam Slippage"@en ;
    rdfs:comment "Durability‑related assembly performance characteristic describing displacement of yarns at or near a seam under mechanical stress, which may lead to deformation or opening."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#SeamSlippage> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SeamSlippage. Captures a specific seam‑related failure mode not covered by general durability or repair terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#SeamSlippage> .

eutex:SeamStrength
    a owl:Class ;
    rdfs:label "Seam Strength"@en ;
    rdfs:comment "Assembly characteristic expressing the mechanical strength or integrity of a seam."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#SeamStrength> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SeamStrength. Captures the specific textile property of seam strength, distinct from fabric tensile or tear strength."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#SeamStrength> .

eutex:SewingCharacteristic
    a owl:Class ;
    rdfs:label "Sewing Characteristic"@en ;
    rdfs:comment "Assembly property describing the quality or construction of sewing in a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#SewingCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SewingCharacteristic. Captures sewing‑related construction details, distinct from overall fabric type or essential characteristics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#SewingCharacteristic> .

eutex:SewingParameter
    a owl:Class ;
    rdfs:label "Sewing Parameter"@en ;
    rdfs:comment "Confectioning parameter relevant to sewing operations and seam formation."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SewingParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SewingParameter. Defines the sewing‑related configuration that influences product durability and recyclability."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SewingParameter> .

eutex:SewingProcess
    a owl:Class ;
    rdfs:label "Sewing Process"@en ;
    rdfs:comment "Confectioning process joining textile parts or components using stitches or seams."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SewingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SewingProcess. Captures the generic sewing activity that creates seams in textile products, distinct from product or category classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SewingProcess> .

eutex:SortingForRecyclingProcess
    a owl:Class ;
    rdfs:label "Sorting for Recycling Process"@en ;
    rdfs:comment "End‑of‑life process in which collected textile products or materials are segregated into streams suitable for subsequent recycling routes."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#SortingForRecyclingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SortingForRecyclingProcess. Defines the specific sorting step in textile recycling, distinct from generic recyclability assessment or process."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#SortingForRecyclingProcess> .

eutex:SortingTechniqueConcept
    a owl:Class ;
    rdfs:label "Sorting Technique Concept"@en ;
    rdfs:comment "SKOS concept used to classify a textile sorting technique."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SortingTechniqueConcept. Provides a controlled vocabulary for the various sorting methods applied to textile end‑of‑life streams."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept> .

eutex:SpinSpeed
    a owl:Class ;
    rdfs:label "Spin Speed"@en ;
    rdfs:comment "Care parameter describing the spin speed used in laundering."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinSpeed> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinSpeed. Captures the laundering spin‑speed setting that influences fabric care and durability, distinct from other textile care properties."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinSpeed> .

eutex:SpinningLimit
    a owl:Class ;
    rdfs:label "Spinning Limit"@en ;
    rdfs:comment "Process parameter expressing the range of yarn counts achievable from a given fibre using a specific spinning system; it depends on the number and thickness of fibres or filaments twisted together."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinningLimit> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinningLimit. Captures the technical limit of yarn production for a fibre‑spinning system, distinct from other textile process or care properties."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinningLimit> .

eutex:SpinningMethodConcept
    a owl:Class ;
    rdfs:label "Spinning Method Concept"@en ;
    rdfs:comment "SKOS concept used as a controlled value for a spinning method."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinningMethodConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinningMethodConcept. Provides a controlled vocabulary for the various spinning methods applied in textile production."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinningMethodConcept> .

eutex:SpinningMethodParameter
    a owl:Class ;
    rdfs:label "Spinning Method Parameter"@en ;
    rdfs:comment "When the selected method is represented directly as a controlled value on a spinning process, use txtprc:hasSpinningMethod with a txtprc:SpinningMethodConcept. This class is retained only when the method must be treated explicitly as a process parameter."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinningMethodParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinningMethodParameter. Captures the explicit process‑level representation of a spinning method, distinct from the concept itself."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinningMethodParameter> .

eutex:SpinningParameter
    a owl:Class ;
    rdfs:label "Spinning Parameter"@en ;
    rdfs:comment "Process parameter relevant to spinning or yarn manufacturing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinningParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinningParameter. Captures generic spinning‑related process parameters distinct from the method concept."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinningParameter> .

eutex:SpinningProcess
    a owl:Class ;
    rdfs:label "Spinning Process"@en ;
    rdfs:comment "Specific spinning techniques such as ring spinning, rotor open‑end spinning and air‑jet spinning are represented as SKOS concepts in the spinning method scheme."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinningProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinningProcess. Captures the high‑level spinning process category distinct from individual method concepts."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinningProcess> .

eutex:SpinningProductivity
    a owl:Class ;
    rdfs:label "Spinning Productivity"@en ;
    rdfs:comment "Process parameter expressing the finest yarn count producible from a given fibre while maintaining acceptable performance and minimising end‑breakage rates."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinningProductivity> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinningProductivity. Captures the productivity metric of a spinning process, distinct from other performance or quality metrics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinningProductivity> .

eutex:SpinningSpeed
    a owl:Class ;
    rdfs:label "Spinning Speed"@en ;
    rdfs:comment "Process parameter describing the speed of spinning."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinningSpeed> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinningSpeed. Captures the operational speed of a spinning process, distinct from other performance metrics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinningSpeed> .

eutex:SpinningTension
    a owl:Class ;
    rdfs:label "Spinning Tension"@en ;
    rdfs:comment "Process parameter describing tension during spinning."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SpinningTension> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SpinningTension. Captures the tension applied in a spinning process, distinct from other performance or quality metrics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SpinningTension> .

eutex:StandardisationFeature
    a owl:Class ;
    rdfs:label "Standardisation Feature"@en ;
    rdfs:comment "Design feature by which components or interfaces are standardised in a way that may support replacement, repair or upgrade."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#StandardisationFeature> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:StandardisationFeature. Captures product design elements that rely on standardisation to enable repair, distinct from generic specifications or common specs."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#StandardisationFeature> .

eutex:StorageConditionParameter
    a owl:Class ;
    rdfs:label "Storage Condition Parameter"@en ;
    rdfs:comment "Care parameter describing storage‑related conditions, such as humidity, sunlight exposure, folding or hanging."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#StorageConditionParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:StorageConditionParameter. Captures the environmental conditions under which a textile product should be stored, distinct from other care or performance properties."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#StorageConditionParameter> .

eutex:StorageProcess
    a owl:Class ;
    rdfs:label "Storage Process"@en ;
    rdfs:comment "Use‑phase or care‑related process involving storage of a textile product under specified or unspecified conditions."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#StorageProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:StorageProcess. Captures the act of storing a textile product, distinct from other care or performance properties."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#StorageProcess> .

eutex:StructuralFailureMode
    a owl:Class ;
    rdfs:label "Structural Failure Mode"@en ;
    rdfs:comment "Category of failure modes primarily affecting structure, integrity or dimensional behaviour."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#StructuralFailureMode> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:StructuralFailureMode. Provides a generic umbrella for failure modes that impact the physical structure of textile products, distinct from repair or durability ratings."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#StructuralFailureMode> .

eutex:StudyScopeStatusConcept
    a owl:Class ;
    rdfs:label "Study Scope Status Concept"@en ;
    rdfs:comment "A SKOS concept used to indicate whether a textile product type is included in, excluded from, or otherwise qualified with respect to a study or regulatory modelling scope."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-core#StudyScopeStatusConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:StudyScopeStatusConcept. Provides a reusable vocabulary for marking product types against study or regulatory scope, enabling consistent exclusion/inclusion logic in DPPs."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-core#StudyScopeStatusConcept> .

eutex:SurfaceDegradationPhenomenon
    a owl:Class ;
    rdfs:label "Surface Degradation Phenomenon"@en ;
    rdfs:comment "Observed degradation phenomenon affecting the surface condition of a textile material or product, such as pilling, fuzzing or matting."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SurfaceDegradationPhenomenon. Captures surface‑level degradation that is distinct from chemical concerns or overall durability metrics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon> .

eutex:SurfaceFailureMode
    a owl:Class ;
    rdfs:label "Surface Failure Mode"@en ;
    rdfs:comment "Category of failure modes primarily affecting the textile surface, distinct from performance parameters that are captured under Observed Degradation Phenomenon."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#SurfaceFailureMode> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SurfaceFailureMode. Separates surface‑specific failures from broader degradation phenomena to maintain module disjointness."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#SurfaceFailureMode> .

eutex:SyntheticFibreChemicalRecyclingProcess
    a owl:Class ;
    rdfs:label "Synthetic Fibre Chemical Recycling Process"@en ;
    rdfs:comment "Chemical recycling process for synthetic textile feedstock such as polyester or polyamide 6, producing recovered monomers, oligomers or polymers."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#SyntheticFibreChemicalRecyclingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:SyntheticFibreChemicalRecyclingProcess. Captures the specific chemical recycling pathway for synthetic fibres, distinct from general recyclability or content declarations."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#SyntheticFibreChemicalRecyclingProcess> .

eutex:TactileFailureMode
    a owl:Class ;
    rdfs:label "Tactile Failure Mode"@en ;
    rdfs:comment "Category of failure modes primarily affecting tactile perception, hand feel or comfort‑related touch properties of a textile product or fabric."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#TactileFailureMode> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TactileFailureMode. Separates touch‑related failures from general durability and repair criteria, keeping the module disjoint."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#TactileFailureMode> .

eutex:TargetFabricDensity
    a owl:Class ;
    rdfs:label "Target Fabric Density"@en ;
    rdfs:comment "Process target specification stating the intended thread or loop density of the resulting fabric."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#TargetFabricDensity> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TargetFabricDensity. Captures the desired fabric density target for a textile process, distinct from general fabric type or product properties."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#TargetFabricDensity> .

eutex:TargetFabricMassPerUnitArea
    a owl:Class ;
    rdfs:label "Target Fabric Mass Per Unit Area"@en ;
    rdfs:comment "Specification of the intended mass of fabric per unit surface area for a textile process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#TargetFabricMassPerUnitArea> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TargetFabricMassPerUnitArea. Captures the process‑level target for fabric density, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#TargetFabricMassPerUnitArea> .

eutex:TearOrRip
    a owl:Class ;
    rdfs:label "Tear or Rip"@en ;
    rdfs:comment "Mechanical failure mode involving rupture, tearing or ripping of textile material under stress, snagging or damage."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#TearOrRip> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TearOrRip. Captures a specific structural failure distinct from general durability or repair criteria."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#TearOrRip> .

eutex:TemperatureControl
    a owl:Class ;
    rdfs:label "Temperature Control"@en ;
    rdfs:comment "Process parameter describing the control of temperature during textile manufacturing, processing or care."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#TemperatureControl> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TemperatureControl. Defines the generic temperature‑control concept for textile processes, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#TemperatureControl> .

eutex:TestCondition
    a owl:Class ;
    rdfs:label "Test Condition"@en ;
    rdfs:comment "A controlled assessment condition used in a test protocol, such as temperature, humidity, load, duration, washing cycle or abrasion cycle."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#TestCondition> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TestCondition. Defines the generic test‑condition concept for textile assessments, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#TestCondition> .

eutex:TestEndpoint
    a owl:Class ;
    rdfs:label "Test Endpoint"@en ;
    rdfs:comment "A defined observation or stopping condition used to determine when a textile test is complete, such as specimen breakdown or a specified appearance change."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#TestEndpoint> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TestEndpoint. Captures the termination criterion that signals completion of a textile test protocol."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#TestEndpoint> .

eutex:TestExecution
    a owl:Class ;
    rdfs:label "Test Execution"@en ;
    rdfs:comment "An assessment execution that performs a textile test method under controlled test conditions."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#TestExecution> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TestExecution. Captures the concrete instance of a textile test run, linking method, conditions and endpoint."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#TestExecution> .

eutex:TestMethod
    a owl:Class ;
    rdfs:label "Test Method"@en ;
    rdfs:comment "An assessment method that applies a controlled experimental or inspection procedure to a durability‑related performance parameter."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#TestMethod> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TestMethod. Captures the generic test‑method concept for textile durability assessments, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#TestMethod> .

eutex:TextileChemicalFunctionConcept
    a owl:Class ;
    rdfs:label "Textile Chemical Function Concept"@en ;
    rdfs:comment "A controlled concept describing the technical function performed by a chemical in textile production or treatment."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileChemicalFunctionConcept. Provides a reusable taxonomy for the functional roles of chemicals used in textile processes, supporting traceability and compliance."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept> .

eutex:TextileChemicalRecyclingEvent
    a owl:Class ;
    rdfs:label "Textile Chemical Recycling Event"@en ;
    rdfs:comment "Event in which a textile product or material undergoes a chemical recycling process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#TextileChemicalRecyclingEvent> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileChemicalRecyclingEvent. Captures the specific chemical recycling activity for textiles, distinct from generic recyclability assessment or process."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#TextileChemicalRecyclingEvent> .

eutex:TextileChemicalSubstance
    a owl:Class ;
    rdfs:label "Textile Chemical Substance"@en ;
    rdfs:comment "A substance used or occurring in textile manufacturing, treatment, finishing, coating or related production contexts."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileChemicalSubstance. Provides a reusable taxonomy for chemicals that appear in textile processes, distinct from generic substances of concern."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance> .

eutex:TextileChemicalUseCategoryConcept
    a owl:Class ;
    rdfs:label "Textile Chemical Use Category Concept"@en ;
    rdfs:comment "A controlled concept describing whether a chemical is intended to act during processing, remain for product performance, or occur unintentionally."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileChemicalUseCategoryConcept. Provides a reusable taxonomy for the intended use of chemicals in textile processes, distinct from generic substances of concern."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept> .

eutex:TextileConcentrationInformation
    a owl:Class ;
    rdfs:label "Textile Concentration Information"@en ;
    rdfs:comment "Concentration information for a substance present in a textile product, expressed at product, component, material‑group or spare‑part level as an exact value, maximum value or range."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileConcentrationInformation> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileConcentrationInformation. Captures the concentration data required for SOC reporting, distinct from general material composition."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileConcentrationInformation> .

eutex:TextileContextFactorConcept
    a owl:Class ;
    rdfs:label "Textile Context Factor Concept"@en ;
    rdfs:comment "A SKOS concept identifying the type of contextual condition observed or declared for a textile product or process execution."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-context#TextileContextFactorConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileContextFactorConcept. Provides a reusable taxonomy for contextual factors that influence textile product performance or compliance."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-context#TextileContextFactorConcept> .

eutex:TextileContextObservation
    a owl:Class ;
    rdfs:label "Textile Context Observation"@en ;
    rdfs:comment "A concrete observation, declaration or setting of a contextual condition applying to a textile product or a textile process execution."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-context#TextileContextObservation> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileContextObservation. Captures specific instances of contextual factors that affect textile product performance or compliance."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-context#TextileContextObservation> .

eutex:TextileFibre
    a owl:Class ;
    rdfs:label "Textile Fibre"@en ;
    rdfs:comment "Unit of matter characterised by flexibility, fineness and a high ratio of length to maximum transverse dimension, suitable for textile applications."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-core#TextileFibre> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileFibre. Captures the generic concept of a textile fibre, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-core#TextileFibre> .

eutex:TextileManufacturingProcess
    a owl:Class ;
    rdfs:label "Textile Manufacturing Process"@en ;
    rdfs:comment "Process involved in the manufacturing or transformation of textile fibres, yarns, fabrics, assemblies or finished textile products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#TextileManufacturingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileManufacturingProcess. Defines the overarching manufacturing process for textiles, distinct from product or category classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#TextileManufacturingProcess> .

eutex:TextileMaterialGroup
    a owl:Class ;
    rdfs:label "Textile Material Group"@en ;
    rdfs:comment "A fibre‑, yarn‑ or fabric‑based material grouping within a textile product that serves as a location or mass‑reference unit for substance reporting."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileMaterialGroup> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileMaterialGroup. Defines the material grouping unit required for SOC substance reporting, distinct from broader textile product categories."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileMaterialGroup> .

eutex:TextileMechanicalRecyclingEvent
    a owl:Class ;
    rdfs:label "Textile Mechanical Recycling Event"@en ;
    rdfs:comment "Event in which a textile product or material undergoes a mechanical recycling process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#TextileMechanicalRecyclingEvent> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileMechanicalRecyclingEvent. Captures the specific mechanical recycling activity for textiles, distinct from generic recyclability assessment or chemical process."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#TextileMechanicalRecyclingEvent> .

eutex:TextileProcess
    a owl:Class ;
    rdfs:label "Textile Process"@en ;
    rdfs:comment "Process involved in manufacturing, transforming, using, caring for, repairing, reusing, recycling or treating a textile product, including components used in other products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#TextileProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileProcess. Captures the generic textile process concept, broader than specific manufacturing or recycling subclasses."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#TextileProcess> .

eutex:TextileProductGroupSoCReference
    a owl:Class ;
    rdfs:label "Textile Product‑Group SoC Reference"@en ;
    rdfs:comment "A versioned reference identifying the textile‑product‑group source that qualifies a substance under the product‑group‑specific type (d) criterion."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileProductGroupSoCReference> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileProductGroupSoCReference. Provides the specific SoC reference needed for type‑D substance reporting within a textile product group."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileProductGroupSoCReference> .

eutex:TextileRecyclingAlertThreshold
    a owl:Class ;
    rdfs:label "Textile Recycling Alert Threshold"@en ;
    rdfs:comment "A textile‑sector alert concentration used to inform sorting, recycling or environmentally sound end‑of‑life handling when the substance may hinder circular treatment."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileRecyclingAlertThreshold> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileRecyclingAlertThreshold. Captures the threshold value that triggers a recycling alert for substances that impede circularity in textiles."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileRecyclingAlertThreshold> .

eutex:TextileRecyclingEvent
    a owl:Class ;
    rdfs:label "Textile Recycling Event"@en ;
    rdfs:comment "Concrete occurrence of textile recycling, represented as both a product event and an execution of a textile process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileRecyclingEvent. Captures the generic recycling event for textiles, distinct from specific chemical or mechanical sub‑events."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent> .

eutex:TextileSoCHandlingInformation
    a owl:Class ;
    rdfs:label "Textile SoC Handling Information"@en ;
    rdfs:comment "Textile‑specific instruction information concerning safe use and lifecycle handling in the presence of a substance of concern, covering disassembly, preparation for reuse, reuse, recycling and environmentally sound end‑of‑life management; repair guidance may be added as a textile/JRC extension."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileSoCHandlingInformation> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileSoCHandlingInformation. Provides the detailed handling guidance required for substances of concern in textile products."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileSoCHandlingInformation> .

eutex:TextileSoCLocationTypeConcept
    a owl:Class ;
    rdfs:label "Textile SoC Location Type Concept"@en ;
    rdfs:comment "Controlled concept describing a textile‑specific kind of product location used to qualify a substance location statement."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileSoCLocationTypeConcept. Defines the set of permissible location types for substances of concern within textile products."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeConcept> .

eutex:TextileSubstanceOfConcernPresenceContext
    a owl:Class ;
    rdfs:label "Textile Substance of Concern Presence Context"@en ;
    rdfs:comment "Specialised context for a textile product, textile material group or non‑textile component indicating where and how a substance of concern is present."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileSubstanceOfConcernPresenceContext. Captures the specific context in which a substance of concern occurs within textile products, enabling precise location statements."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext> .

eutex:TextileTrackingThreshold
    a owl:Class ;
    rdfs:label "Textile Tracking Threshold"@en ;
    rdfs:comment "Threshold for tracking or disclosure of a substance occurrence in a textile product or textile product group."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileTrackingThreshold> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileTrackingThreshold. Defines the quantitative or qualitative limit at which a substance must be tracked or disclosed within textile products."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileTrackingThreshold> .

eutex:TextileTypeDQualification
    a owl:Class ;
    rdfs:label "Textile Type D Qualification"@en ;
    rdfs:comment "Product‑group‑specific qualification indicating that a substance hinders the reuse or recycling of a textile product or textile material stream."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-soc#TextileTypeDQualification> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileTypeDQualification. Captures the type‑D status required for substances that impede circularity in textile products."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-soc#TextileTypeDQualification> .

eutex:TextileWasteSourceConcept
    a owl:Class ;
    rdfs:label "Textile Waste Source Concept"@en ;
    rdfs:comment "Controlled concept classifying textile waste according to the lifecycle stage at which it became waste."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TextileWasteSourceConcept. Provides a textile‑specific waste source concept that aligns with the broader WasteOriginType but is tailored to textile lifecycle stages."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept> .

eutex:ThermoMechanicalRecyclingProcess
    a owl:Class ;
    rdfs:label "Thermo‑Mechanical Recycling Process"@en ;
    rdfs:comment "Recycling process in which thermoplastic textile polymers are remelted or otherwise thermally and mechanically reprocessed into granulate or fibre material."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ThermoMechanicalRecyclingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ThermoMechanicalRecyclingProcess. Defines the specific thermo‑mechanical recycling pathway for textile polymers, a narrower form of the generic Recycling Process."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ThermoMechanicalRecyclingProcess> .

eutex:ThreadCount
    a owl:Class ;
    rdfs:label "Thread Count"@en ;
    rdfs:comment "Fabric construction property indicating the number of threads per specified unit length in a woven textile."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#ThreadCount> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ThreadCount. Adds a specific woven‑fabric metric distinct from general fabric type or textile category."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#ThreadCount> .

eutex:ThresholdComparisonOperatorConcept
    a owl:Class ;
    rdfs:label "Threshold Comparison Operator Concept"@en ;
    rdfs:comment "A SKOS concept that identifies the comparison operator (e.g., &lt;, &gt;, =, ≤, ≥) used to evaluate a performance threshold."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ThresholdComparisonOperatorConcept. Provides the controlled vocabulary for operators that compare measured values against threshold limits in textile durability assessments."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept> .

eutex:TrimFailure
    a owl:Class ;
    rdfs:label "Trim Failure"@en ;
    rdfs:comment "Component failure mode involving failure of trims or auxiliary components associated with a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#TrimFailure> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TrimFailure. Captures a distinct failure of ancillary textile components, separate from general durability or repair criteria."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#TrimFailure> .

eutex:TwistLevel
    a owl:Class ;
    rdfs:label "Twist Level"@en ;
    rdfs:comment "Spinning parameter describing the degree or level of twist inserted into a yarn."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#TwistLevel> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:TwistLevel. Captures the yarn twist characteristic used in textile manufacturing, distinct from other process metrics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#TwistLevel> .

eutex:TwistNumber
    a owl:Class ;
    rdfs:label "Twist Number"@en ;
    rdfs:comment "Spinning parameter describing the number of twists inserted into a yarn."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
