    dcterms:source <https://w3id.org/eudpp/textile-process#FinishingTreatmentParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FinishingTreatmentParameter. Captures the specific attributes of a finishing treatment step, distinct from the overall FinishingProcess class."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#FinishingTreatmentParameter> .

eutex:FixationCondition
