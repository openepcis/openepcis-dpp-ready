    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#resultForRecyclingRoute> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:resultForRecyclingRoute. Links an assessment result to the specific recycling route it applies to."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#resultForRecyclingRoute> .

eutex:resultOfAssessment
    a owl:ObjectProperty ;
    rdfs:label "Result Of Assessment"@en ;
    rdfs:comment "Links an assessment result to the execution that produced it."@en ;
    rdfs:domain eutex:AssessmentResult ; # CHECK: unknown class
