    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FabricTactileCharacteristic> .

eutex:FabricVisualCharacteristic
    a owl:Class ;
    rdfs:label "Fabric Visual Characteristic"@en ;
    rdfs:comment "Fabric-level characteristic concerning visible appearance, lustre, shininess, sheen or other visual qualities."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricVisualCharacteristic. Captures the visual appearance attributes of textiles, distinct from inspection results and structural properties."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic> .

eutex:FailureMode
