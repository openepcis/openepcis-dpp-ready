    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnTactileCharacteristic. Adds a yarn‑level tactile descriptor distinct from durability or essential characteristics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#YarnTactileCharacteristic> .

eutex:YarnUniformity
    a owl:Class ;
    rdfs:label "Yarn Uniformity"@en ;
