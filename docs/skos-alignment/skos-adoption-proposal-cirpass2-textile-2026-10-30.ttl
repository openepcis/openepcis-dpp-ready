    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#resultOfAssessment> .

eutex:ruleAppliesToRoute
    a owl:ObjectProperty ;
    rdfs:label "Rule Applies To Route"@en ;
    rdfs:comment "Relates a recyclability scoring rule to the recycling route in which it is applicable."@en ;
