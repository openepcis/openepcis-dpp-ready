    dcterms:source <https://w3id.org/eudpp/textile-structure#FabricDrape> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricDrape. Defines the specific textile property of drape, distinct from type or product class."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FabricDrape> .

eutex:FabricElasticity
    a owl:Class ;
    rdfs:label "Fabric Elasticity"@en ;
