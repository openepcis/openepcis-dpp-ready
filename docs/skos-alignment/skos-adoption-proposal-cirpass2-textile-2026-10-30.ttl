    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:settingForProcessParameter. Captures the instantiation link between a parameter setting and its defining process parameter in the textile‑process module."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#settingForProcessParameter> .

eutex:sourceLocator
    a owl:DatatypeProperty ;
    rdfs:label "Source Locator"@en ;
    rdfs:comment "Human‑readable reference to the section, page, table, figure, line range or file location in a cited source that supports an ontology resource."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
