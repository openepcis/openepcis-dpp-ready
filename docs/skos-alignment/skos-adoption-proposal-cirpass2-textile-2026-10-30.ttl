# Proposed terms from the cirpass2-textile reverse-coverage run of 2026-10-30.
# Drafted by the QA model, one block per uncovered upstream term; a proposal for the
# curator, not an ontology. Copy a block into its module's ontology/*.ttl when adopted and
# add the changelog line; the skos:note keeps the provenance.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix eudpp: <https://w3id.org/eudpp#> .
@prefix gs1: <https://ref.gs1.org/voc/> .
@prefix schema: <https://schema.org/> .
@prefix eubat: <https://ref.openepcis.org/extensions/eu/battery/> .
@prefix carrier: <https://ref.openepcis.org/extensions/common/carrier/> .
@prefix oec: <https://ref.openepcis.org/extensions/common/core/> .
@prefix eucpr: <https://ref.openepcis.org/extensions/eu/cpr/> .
@prefix eudet: <https://ref.openepcis.org/extensions/eu/detergent/> .
@prefix euelec: <https://ref.openepcis.org/extensions/eu/electronics/> .
@prefix eudr: <https://ref.openepcis.org/extensions/eu/eudr/> .
@prefix usfsma: <https://ref.openepcis.org/extensions/us/fsma204/> .
@prefix eusteel: <https://ref.openepcis.org/extensions/eu/iron-steel/> .
@prefix euppwr: <https://ref.openepcis.org/extensions/eu/ppwr/> .
@prefix eutex: <https://ref.openepcis.org/extensions/eu/textile/> .

# ===== textile (403) =====

eutex:AccidentalDamage
    a owl:Class ;
    rdfs:label "Accidental Damage"@en ;
    rdfs:comment "External damage occurring during use, such as accidental tearing, ripping or staining, which may lead to product rejection or disposal."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#AccidentalDamage> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:AccidentalDamage. Captures the specific event of accidental damage, distinct from general durability or hazard classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#AccidentalDamage> .

eutex:AgeingSimulationMethod
    a owl:Class ;
    rdfs:label "Ageing Simulation Method"@en ;
    rdfs:comment "A laboratory or field test method that applies controlled, repeatable use or care cycles to simulate product ageing before or during durability assessment."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#AgeingSimulationMethod> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:AgeingSimulationMethod. Captures the specific test method used in textile durability assessment, distinct from general biodegradability or other test methods."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#AgeingSimulationMethod> .

eutex:AssemblyCharacteristic
    a owl:Class ;
    rdfs:label "Assembly Characteristic"@en ;
    rdfs:comment "Characteristic of a garment or textile assembly, covering seams, sewing and cutting quality."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:AssemblyCharacteristic. Captures the quality attributes of textile construction that affect durability and circularity."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic> .

eutex:AssessmentCondition
    a owl:Class ;
    rdfs:label "Assessment Condition"@en ;
    rdfs:comment "The set of circumstances or criteria under which a textile assessment is performed, such as environmental testing conditions or regulatory compliance checks."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#AssessmentCondition> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:AssessmentCondition. This class captures the generic concept of assessment conditions needed for textile product passports, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#AssessmentCondition> .

eutex:AssessmentExecution
    a owl:Class ;
    rdfs:label "Assessment Execution"@en ;
    rdfs:comment "The actual performance of a textile assessment method on a specified product under defined conditions and parameter settings."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#AssessmentExecution> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:AssessmentExecution. This class represents the concrete execution of a textile assessment, matching the upstream concept exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#AssessmentExecution> .

eutex:AssessmentMethod
    a owl:Class ;
    rdfs:label "Assessment Method"@en ;
    rdfs:comment "The documented procedure or approach used to assess, observe, test, measure or evaluate a textile product or a durability‑related performance parameter."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#AssessmentMethod> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:AssessmentMethod. This class captures the generic concept of a textile assessment method, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#AssessmentMethod> .

eutex:AssessmentParameter
    a owl:Class ;
    rdfs:label "Assessment Parameter"@en ;
    rdfs:comment "A configurable value or setting that qualifies, limits, or interprets a textile assessment procedure."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#AssessmentParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:AssessmentParameter. Captures the generic concept of a parameter used in textile assessment, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#AssessmentParameter> .

eutex:CareParameter
    a owl:Class ;
    rdfs:label "Care Parameter"@en ;
    rdfs:comment "Process parameter relevant to textile care, such as washing temperature, drying time or storage conditions."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#CareParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CareParameter. Provides a reusable concept for individual care parameters that can be linked to specific instructions."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#CareParameter> .

eutex:ChemicalFinishingProcess
    a owl:Class ;
    rdfs:label "Chemical Finishing Process"@en ;
    rdfs:comment "Finishing process that uses chemical substances or treatments to confer or modify functional properties of textile materials or products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ChemicalFinishingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ChemicalFinishingProcess. Captures a distinct textile finishing activity that is not represented by existing process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ChemicalFinishingProcess> .

eutex:CleaningProcess
    a owl:Class ;
    rdfs:label "Cleaning Process"@en ;
    rdfs:comment "Care process involving domestic laundering, professional cleaning, dry cleaning or wet cleaning of a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#CleaningProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CleaningProcess. Defines a distinct cleaning activity not covered by existing care instruction classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#CleaningProcess> .

eutex:CoatingAdditiveUse
    a owl:Class ;
    rdfs:label "Coating Additive Use"@en ;
    rdfs:comment "Process‑level record of an additive or chemical used to coat a textile material, capturing the role rather than the substance itself."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#CoatingAdditiveUse> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CoatingAdditiveUse. Adds a distinct process‑use concept for textile coatings not represented by existing substance or product classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#CoatingAdditiveUse> .

eutex:CoatingParameter
    a owl:Class ;
    rdfs:label "Coating Parameter"@en ;
    rdfs:comment "Process parameter relevant to textile coating or surface treatment, such as thickness, cure time or temperature."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#CoatingParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CoatingParameter. Captures a generic coating‑related process parameter not covered by existing classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#CoatingParameter> .

eutex:CoatingProcess
    a owl:Class ;
    rdfs:label "Coating Process"@en ;
    rdfs:comment "Finishing process that applies a coating layer or functional surface treatment to a textile material or product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#CoatingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CoatingProcess. Adds a distinct coating‑application concept not covered by existing classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#CoatingProcess> .

eutex:CollectionSchemeConcept
    a owl:Class ;
    rdfs:label "Collection Scheme Concept"@en ;
    rdfs:comment "SKOS concept used to classify an arrangement for collecting textile waste."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#CollectionSchemeConcept> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CollectionSchemeConcept. Provides a distinct concept for classifying textile waste collection schemes, not covered by existing terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#CollectionSchemeConcept> .

eutex:ComponentFailureMode
    a owl:Class ;
    rdfs:label "Component Failure Mode"@en ;
    rdfs:comment "Category of failure modes affecting components or trims in textile products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#ComponentFailureMode> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ComponentFailureMode. Defines the generic failure mode concept for textile components, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-durability#ComponentFailureMode> .

eutex:ConfectioningParameter
    a owl:Class ;
    rdfs:label "Confectioning Parameter"@en ;
    rdfs:comment "Process parameter relevant to garment making, cutting, sewing, assembly or make‑up operations."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ConfectioningParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ConfectioningParameter. Adds a distinct parameter class for garment‑making operations not covered by existing classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ConfectioningParameter> .

eutex:ConfectioningProcess
    a owl:Class ;
    rdfs:label "Confectioning Process"@en ;
    rdfs:comment "Manufacturing process that transforms fabrics and components into finished textile apparel or articles, including cutting, sewing and make‑up operations."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#ConfectioningProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ConfectioningProcess. Adds a distinct process class for garment manufacturing not covered by existing classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#ConfectioningProcess> .

eutex:CutPrecision
    a owl:Class ;
    rdfs:label "Cut Precision"@en ;
    rdfs:comment "Assembly characteristic describing the precision of cutting or pattern construction in a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#CutPrecision> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CutPrecision. Captures the quality of cutting that influences durability and circularity in textile assemblies."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#CutPrecision> .

eutex:CuttingParameter
    a owl:Class ;
    rdfs:label "Cutting Parameter"@en ;
    rdfs:comment "Confectioning parameter relevant to cutting operations."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#CuttingParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CuttingParameter. Adds a distinct parameter class for cutting operations not covered by existing classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#CuttingParameter> .

eutex:CuttingProcess
    a owl:Class ;
    rdfs:label "Cutting Process"@en ;
    rdfs:comment "Confectioning process in which textile materials are cut into components or pattern pieces."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#CuttingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:CuttingProcess. Adds a distinct process class for cutting operations not covered by existing classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#CuttingProcess> .

eutex:DefectControl
    a owl:Class ;
    rdfs:label "Defect Control"@en ;
    rdfs:comment "Process parameter or quality‑control practice aimed at preventing or detecting defects during textile processing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#DefectControl> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:DefectControl. Adds a distinct class for defect‑control activities not covered by existing classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#DefectControl> .

eutex:DeformationPerformanceParameter
    a owl:Class ;
    rdfs:label "Deformation Performance Parameter"@en ;
    rdfs:comment "Category of observed performance parameters related to deformation, shape retention or dimensional behaviour."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:DeformationPerformanceParameter. Captures a distinct class for deformation‑related performance metrics, separate from emissions or circularity classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter> .

eutex:DegradationRate
    a owl:Class ;
    rdfs:label "Degradation Rate"@en ;
    rdfs:comment "Calculated indicator expressing change in a performance parameter or degradation phenomenon per stated unit of time, use, cycle or exposure."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-indicator#DegradationRate> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:DegradationRate. Provides a generic performance‑degradation metric for textile products, not covered by existing biodegradability or test method terms."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-indicator#DegradationRate> .

eutex:Discolouration
    a owl:Class ;
    rdfs:label "Discolouration"@en ;
    rdfs:comment "Observed performance parameter describing localised, irregular or use‑specific colour change that is distinct from general colour fading."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#Discolouration> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:Discolouration. Provides a separate class for non‑uniform or condition‑specific colour changes, complementing the broader Colour Fastness class."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#Discolouration> .

eutex:DryingTemperature
    a owl:Class ;
    rdfs:label "Drying Temperature"@en ;
    rdfs:comment "Care parameter describing the temperature used during textile drying."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#DryingTemperature> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:DryingTemperature. Adds a distinct class for drying temperature, complementing the generic TemperatureRange term."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#DryingTemperature> .

eutex:DyeConcentration
    a owl:Class ;
    rdfs:label "Dye Concentration"@en ;
    rdfs:comment "Dyeing parameter describing the concentration of dye or colourant used in a dyeing process."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#DyeConcentration> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:DyeConcentration. Defines the generic dye concentration concept for textile processes, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#DyeConcentration> .

eutex:DyeingParameter
    a owl:Class ;
    rdfs:label "Dyeing Parameter"@en ;
    rdfs:comment "Process parameter relevant to textile dyeing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#DyeingParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:DyeingParameter. Adds a distinct class for dyeing parameters, separate from visual inspection or substance terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#DyeingParameter> .

eutex:DyeingProcess
    a owl:Class ;
    rdfs:label "Dyeing Process"@en ;
    rdfs:comment "Wet processing process used to impart colour to textile fibres, yarns, fabrics or finished products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#DyeingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:DyeingProcess. Adds a distinct class for dyeing processes, separate from general textile product or visual inspection classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#DyeingProcess> .

eutex:DyeingTime
    a owl:Class ;
    rdfs:label "Dyeing Time"@en ;
    rdfs:comment "Dyeing parameter describing the duration of a dyeing process or dyeing step."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#DyeingTime> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:DyeingTime. Defines the generic dyeing time concept for textile processes, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#DyeingTime> .

eutex:ElasticityLoss
    a owl:Class ;
    rdfs:label "Elasticity Loss"@en ;
    rdfs:comment "Structural failure mode describing loss of elastic recovery or stretch‑related functionality in a textile product or fabric."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#ElasticityLoss> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ElasticityLoss. Captures a specific durability failure that is distinct from general robustness or dimensional change, aligning with textile performance testing."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#ElasticityLoss> .

eutex:ExternalDamage
    a owl:Class ;
    rdfs:label "External Damage"@en ;
    rdfs:comment "Damage caused by external or accidental events during product use, not necessarily resulting from intrinsic lack of durability."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#ExternalDamage> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ExternalDamage. Captures non‑intrinsic damage events that affect textile durability, distinct from internal failure modes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#ExternalDamage> .

eutex:FabricAppearance
    a owl:Class ;
    rdfs:label "Fabric Appearance"@en ;
    rdfs:comment "Visual characteristic of a fabric that describes its overall visible appearance or visual quality."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FabricAppearance> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricAppearance. Captures the generic fabric visual quality concept, distinct from specific inspection sub‑ratings."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FabricAppearance> .

eutex:FabricBehaviouralCharacteristic
    a owl:Class ;
    rdfs:label "Fabric Behavioural Characteristic"@en ;
    rdfs:comment "Physical behaviour of a fabric under use, gravity, movement, care or stress conditions."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FabricBehaviouralCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricBehaviouralCharacteristic. Captures how a textile fabric behaves in real‑world conditions, complementing structural and visual characteristics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FabricBehaviouralCharacteristic> .

eutex:FabricBreakdown
    a owl:Class ;
    rdfs:label "Fabric Breakdown"@en ;
    rdfs:comment "Aggregated failure mode of a textile fabric that may later be decomposed into specific phenomena such as fraying, thinning, localised wear or hole formation."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#FabricBreakdown> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricBreakdown. Captures the generic fabric‑breakdown concept for textile durability, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-durability#FabricBreakdown> .

eutex:FabricBreathability
    a owl:Class ;
    rdfs:label "Fabric Breathability"@en ;
    rdfs:comment "Functional characteristic of a fabric that describes the passage of water vapour through it and its evaporative cooling effect."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FabricBreathability> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FabricBreathability. Captures the specific textile property of breathability, distinct from durability or compostability."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FabricBreathability> .

eutex:FabricConstructionParameter
    a owl:Class ;
    rdfs:label "Fabric Construction Parameter"@en ;
    rdfs:comment "Process-side parameter describing how a fabric construction is specified or controlled during manufacturing. The resulting observable construction characteristics are represented in TEXTILE_STRUCTURE."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#FabricConstructionParameter> ;
