    rdfs:comment "Observed surface degradation phenomenon involving fuzzing or matting of the fabric surface, following JRC and ISO wording."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#FuzzingOrMatting> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FuzzingOrMatting. Captures the specific surface‑degradation phenomenon distinct from microplastic shedding or other durability metrics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#FuzzingOrMatting> .

eutex:HoleInSeam
