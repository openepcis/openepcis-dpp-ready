    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#awardsScoreValue> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:awardsScoreValue. Captures the numeric score produced by a recyclability scoring rule."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#awardsScoreValue> .

eutex:barrierAppliesToRoute
    a owl:ObjectProperty ;
    rdfs:label "Barrier Applies To Route"@en ;
    rdfs:comment "Relates a recyclability barrier to the recycling route it hinders."@en ;
    rdfs:domain eutex:RecyclabilityBarrier ;
    rdfs:range eutex:RecyclingTechnology ;
