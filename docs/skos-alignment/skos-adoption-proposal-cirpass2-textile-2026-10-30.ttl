    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#settingForParameter> .

eutex:settingForProcessParameter
    a owl:ObjectProperty ;
    rdfs:label "Setting For Process Parameter"@en ;
    rdfs:comment "Relates a concrete process parameter setting to the process parameter type or target specification it instantiates."@en ;
    rdfs:domain eutex:ProcessParameterSetting ;
    rdfs:range eutex:ProcessParameter ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
