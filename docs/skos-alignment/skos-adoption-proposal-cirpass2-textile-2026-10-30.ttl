    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#refersToSubstancePresence> .

eutex:refersToTextileElement
    a owl:ObjectProperty ;
    rdfs:label "Refers To Textile Element"@en ;
    rdfs:comment "Links a priority repair element role to the textile product that is used as a component or repairable element."@en ;
