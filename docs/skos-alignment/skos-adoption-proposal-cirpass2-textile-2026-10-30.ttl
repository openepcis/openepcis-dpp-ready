    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#ruleAppliesToRoute> .

eutex:settingForParameter
    a owl:ObjectProperty ;
    rdfs:label "Setting For Parameter"@en ;
    rdfs:comment "Links a concrete parameter setting to the measurement parameter it configures."@en ;
    rdfs:range eutex:MeasurementParameter ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#settingForParameter> ;
