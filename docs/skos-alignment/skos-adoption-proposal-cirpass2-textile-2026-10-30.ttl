    skos:closeMatch <https://w3id.org/eudpp/textile-process#FibrePreparationProcess> .

eutex:FibreQualityCharacteristic
    a owl:Class ;
    rdfs:label "Fibre Quality Characteristic"@en ;
    rdfs:comment "Non‑structural, non‑mechanical, non‑physical or visual property of a textile fibre that influences its overall quality."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FibreQualityCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FibreQualityCharacteristic. Captures fibre‑level quality attributes that are not covered by structural, mechanical or visual classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreQualityCharacteristic> .

eutex:FibreSectionShape
    a owl:Class ;
    rdfs:label "Fibre Section Shape"@en ;
    rdfs:comment "Cross‑sectional shape of a textile fibre, such as round, oval or irregular."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FibreSectionShape> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FibreSectionShape. Captures the structural shape of individual fibres, not covered by existing fibre or fabric type classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreSectionShape> .

eutex:FibreStrength
    a owl:Class ;
    rdfs:label "Fibre Strength"@en ;
    rdfs:comment "Mechanical characteristic expressing a fibre’s resistance to tensile stress or breakage."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#FibreStrength> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FibreStrength. Captures the specific textile property of fibre strength, distinct from fabric tear strength or durability class."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#FibreStrength> .

eutex:FinishingParameter
    a owl:Class ;
    rdfs:label "Finishing Parameter"@en ;
    rdfs:comment "Process parameter relevant to textile finishing, including chemical and mechanical finishing."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#FinishingParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FinishingParameter. Captures the generic finishing‑parameter concept for textile processes, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#FinishingParameter> .

eutex:FinishingProcess
    a owl:Class ;
    rdfs:label "Finishing Process"@en ;
    rdfs:comment "Textile process applied to modify appearance, handle, function or physical properties of textile materials or products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#FinishingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:FinishingProcess. Defines the generic finishing‑process concept for textile processes, matching the upstream term exactly."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#FinishingProcess> .

eutex:FinishingTreatmentParameter
