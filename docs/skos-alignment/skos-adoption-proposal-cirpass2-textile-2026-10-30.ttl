    skos:closeMatch <https://w3id.org/eudpp/textile-process#FabricConstructionParameter> .

eutex:FabricDrape
    a owl:Class ;
    rdfs:label "Fabric Drape"@en ;
    rdfs:comment "Behavioural characteristic describing how a fabric hangs in three dimensions and adapts to contours."@en ;
