    skos:closeMatch <https://w3id.org/eudpp/textile-connector#sourceLocator> .

eutex:supportsAssessmentOf
    a owl:ObjectProperty ;
    rdfs:label "Supports Assessment Of"@en ;
    rdfs:comment "Links an indicator to a durability concept whose assessment it supports without asserting equivalence."@en ;
    rdfs:domain eutex:Indicator ; # CHECK: unknown class
    rdfs:range eutex:Durability ; # CHECK: unknown class
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-indicator#supportsAssessmentOf> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:supportsAssessmentOf. Captures the relationship where an indicator underpins a durability assessment."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-indicator#supportsAssessmentOf> .

eutex:supportsProcessType
    a owl:ObjectProperty ;
    rdfs:label "Supports Process Type"@en ;
    rdfs:comment "Relates a repair service or guidance to the maintenance, repair, upgrade, refurbishment or remanufacturing process type it supports."@en ;
    rdfs:range eutex:RepairProcess ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#supportsProcessType> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:supportsProcessType. Captures the process type that a repair service or guidance enables."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#supportsProcessType> .

eutex:typicalDegradationExpression
    a owl:DatatypeProperty ;
    rdfs:label "Typical Degradation Expression"@en ;
    rdfs:comment "Annotation used at class level to document a usual degradation expression of a durability‑related performance characteristic without imposing an OWL restriction."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#typicalDegradationExpression> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicalDegradationExpression. Provides a free‑text note for typical degradation expressions in the textile‑durability module."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#typicalDegradationExpression> .

eutex:typicalFailureExpression
    a owl:DatatypeProperty ;
    rdfs:label "Typical Failure Expression"@en ;
    rdfs:comment "Annotation used at class level to document the usual failure expression of an observed performance parameter without imposing a mandatory OWL restriction."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#typicalFailureExpression> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicalFailureExpression. Provides a free‑text note for typical failure expressions in the textile‑durability module."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#typicalFailureExpression> .

eutex:typicalInfluenceOn
    a owl:DatatypeProperty ;
    rdfs:label "Typical Influence On"@en ;
    rdfs:comment "Weak annotation relation indicating that a source concept, parameter, process, context factor or structural characteristic typically influences a target concept without asserting deterministic causality."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicalInfluenceOn. Captures non‑deterministic influence relationships within the textile connector."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> .

eutex:typicalProgressionTo
    a owl:DatatypeProperty ;
    rdfs:label "Typical Progression To"@en ;
    rdfs:comment "Annotation used at class level to document a typical degradation progression without asserting a mandatory causal relation."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#typicalProgressionTo> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicalProgressionTo. Provides a free‑text note for typical progression descriptions in the textile‑durability module."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#typicalProgressionTo> .

eutex:typicallyContributesTo
    a owl:DatatypeProperty ;
    rdfs:label "Typically Contributes To"@en ;
    rdfs:comment "Weak annotation relation indicating that a source entity typically contributes to, supports or participates in the realisation of a target characteristic, performance aspect or outcome."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-connector#typicallyContributesTo> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicallyContributesTo. Captures non‑deterministic contribution relationships within the textile connector."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-connector#typicallyContributesTo> .

eutex:typicallyIncreasesLikelihoodOf
    a owl:DatatypeProperty ;
    rdfs:label "Typically Increases Likelihood Of"@en ;
    rdfs:comment "Weak annotation relation indicating that a source entity typically increases the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicallyIncreasesLikelihoodOf. Captures non‑deterministic likelihood relationships within the textile connector."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf> .

eutex:typicallyQualifiesProcess
    a owl:ObjectProperty ;
    rdfs:label "Typically Qualifies Process"@en ;
    rdfs:comment "Weak annotation indicating that a context factor usually qualifies the interpretation, applicability or expected effect of a textile process type."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-context#typicallyQualifiesProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicallyQualifiesProcess. Captures the informal, typical relationship between a context factor and a textile process within the textile‑context module."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-context#typicallyQualifiesProcess> .

eutex:typicallyReducesLikelihoodOf
    a owl:DatatypeProperty ;
    rdfs:label "Typically Reduces Likelihood Of"@en ;
    rdfs:comment "Weak annotation relation indicating that a source entity typically reduces the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicallyReducesLikelihoodOf. Captures non‑deterministic reduction relationships within the textile connector."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf> .

eutex:typicallyUsesChemicalFunction
    a owl:ObjectProperty ;
    rdfs:label "Typically Uses Chemical Function"@en ;
    rdfs:comment "Indicates that a textile process type usually employs a particular chemical function represented in Textile Associated Materials."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#typicallyUsesChemicalFunction> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicallyUsesChemicalFunction. Provides a weak annotation linking textile processes to the chemical functions they commonly use, useful for inference and search."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#typicallyUsesChemicalFunction> .

eutex:typicallyUsesChemicalUseCategory
    a owl:ObjectProperty ;
    rdfs:label "Typically Uses Chemical Use Category"@en ;
    rdfs:comment "Weak annotation indicating that a textile process type usually employs chemicals from a specific use category represented in Textile Associated Materials."@en ;
    rdfs:range eutex:TextileChemicalUseCategoryConcept ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#typicallyUsesChemicalUseCategory> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:typicallyUsesChemicalUseCategory. Provides a lightweight link from textile processes to the chemical use categories they commonly involve."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#typicallyUsesChemicalUseCategory> .

eutex:usesChemicalUseCategory
    a owl:ObjectProperty ;
    rdfs:label "Uses Chemical Use Category"@en ;
    rdfs:comment "Relates a textile process type or execution to the use category of a chemical employed in that process, such as process or performance chemical."@en ;
    rdfs:range eutex:TextileChemicalUseCategoryConcept ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#usesChemicalUseCategory> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:usesChemicalUseCategory. Links textile processes to the chemical use category they involve, aiding traceability and compliance."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#usesChemicalUseCategory> .

eutex:usesInput
    a owl:ObjectProperty ;
    rdfs:label "Uses Input"@en ;
    rdfs:comment "Links a textile process type or execution to an input that may be a textile product, material of composition, chemical substance, non‑textile component or packaging material."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#usesInput> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:usesInput. Captures the various inputs that a textile process can consume, using the relevant classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#usesInput> .

eutex:usesPreTreatmentTechnique
    a owl:ObjectProperty ;
    rdfs:label "Uses Pre‑Treatment Technique"@en ;
    rdfs:comment "Relates a preparation‑for‑recycling process to the pre‑treatment technique it employs."@en ;
    rdfs:domain eutex:PreparationForRecyclingProcess ; # CHECK: unknown class
    rdfs:range eutex:PreTreatmentTechniqueConcept ; # CHECK: unknown class
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#usesPreTreatmentTechnique> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:usesPreTreatmentTechnique. Links a recycling preparation step to the specific pre‑treatment technique used."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#usesPreTreatmentTechnique> .

eutex:usesRepairBehaviourObservation
    a owl:ObjectProperty ;
    rdfs:label "Uses Repair Behaviour Observation"@en ;
    rdfs:comment "Links a repairability assessment to the textile context observation that records observed repair behaviour."@en ;
    rdfs:domain eutex:RepairabilityAssessment ; # CHECK: unknown class
    rdfs:range eutex:TextileContextObservation ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#usesRepairBehaviourObservation> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:usesRepairBehaviourObservation. Captures the observation of repair behaviour used in a repairability assessment."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#usesRepairBehaviourObservation> .

eutex:usesReusableTextileInput
    a owl:ObjectProperty ;
    rdfs:label "Uses Reusable Textile Input"@en ;
    rdfs:comment "Links a refurbishment or remanufacturing execution to the textile product that is used as reusable input, including components of another product."@en ;
    rdfs:domain eutex:TextileProcessExecution ; # CHECK: unknown class
    rdfs:range eutex:TextileProduct ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#usesReusableTextileInput> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:usesReusableTextileInput. Captures the textile product used as reusable input in a refurbishment or remanufacturing process."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#usesReusableTextileInput> .

eutex:usesSortingTechnique
    a owl:ObjectProperty ;
    rdfs:label "Uses Sorting Technique"@en ;
    rdfs:comment "Relates a sorting‑for‑recycling process to the sorting technique it employs."@en ;
    rdfs:domain eutex:SortingForRecyclingProcess ;
    rdfs:range eutex:SortingTechniqueConcept ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-recyclability#usesSortingTechnique> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:usesSortingTechnique. Links a recycling sorting step to the specific technique used."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-recyclability#usesSortingTechnique> .

eutex:usesSpareComponent
    a owl:ObjectProperty ;
    rdfs:label "Uses Spare Component"@en ;
    rdfs:comment "Links a textile process execution to the non‑textile component that is used as a spare part during the intervention."@en ;
    rdfs:domain eutex:TextileProcessExecution ; # CHECK: unknown class
    rdfs:range eutex:NonTextileComponent ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#usesSpareComponent> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:usesSpareComponent. Captures the spare non‑textile component used in a repair or refurbishment process."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#usesSpareComponent> .

