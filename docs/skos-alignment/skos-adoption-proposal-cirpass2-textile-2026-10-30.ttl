    dcterms:source <https://w3id.org/eudpp/textile-durability#ZipperFailure> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:ZipperFailure. Captures a distinct failure mode of textile trims not covered by general repair or replacement terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#ZipperFailure> .

eutex:addressesFailureMode
    a owl:ObjectProperty ;
    rdfs:label "Addresses Failure Mode"@en ;
    rdfs:comment "Relates a repair‑related process execution or priority element to the textile failure mode it addresses."@en ;
    rdfs:range eutex:FailureMode ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-repairability#addressesFailureMode> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:addressesFailureMode. Links a repair action to the specific failure mode it mitigates."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-repairability#addressesFailureMode> .

eutex:appliesMethod
    a owl:ObjectProperty ;
    rdfs:label "Applies Method"@en ;
    rdfs:comment "Links an assessment execution to the reusable assessment method that it performs."@en ;
    rdfs:domain eutex:AssessmentExecution ;
    rdfs:range eutex:AssessmentMethod ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#appliesMethod> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:appliesMethod. Captures the relationship between a specific assessment run and the method used, distinct from generic test methods."@en ;
    skos:broadMatch <https://w3id.org/eudpp/textile-assessment#appliesMethod> .

eutex:appliesTo
    a owl:ObjectProperty ;
    rdfs:label "Applies To"@en ;
    rdfs:comment "Links a textile process type or execution to the textile product it applies to, including component products."@en ;
    rdfs:range eutex:TextileProduct ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#appliesTo> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:appliesTo. Captures the relationship between a textile process and the product it is performed on in the textile‑process module."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#appliesTo> .

eutex:appliesToEndpoint
    a owl:ObjectProperty ;
    rdfs:label "Applies To Endpoint"@en ;
    rdfs:comment "Links a performance threshold to the test endpoint it applies to."@en ;
    rdfs:domain eutex:PerformanceThreshold ;
    rdfs:range eutex:TestEndpoint ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#appliesToEndpoint> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:appliesToEndpoint. Represents the relationship between a threshold and its corresponding endpoint, matching the upstream concept."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#appliesToEndpoint> .

eutex:assessesPerformanceParameter
    a owl:ObjectProperty ;
    rdfs:label "Assesses Performance Parameter"@en ;
    rdfs:comment "Links an assessment execution to the durability‑related performance parameter being evaluated."@en ;
    rdfs:domain eutex:AssessmentExecution ;
    rdfs:range eutex:ObservedPerformanceParameter ; # CHECK: unknown class
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#assessesPerformanceParameter> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:assessesPerformanceParameter. Represents the relationship between an execution instance and the specific performance parameter it tests, matching the upstream concept."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment#assessesPerformanceParameter> .

eutex:assessesProduct
    a owl:ObjectProperty ;
    rdfs:label "Assesses Product"@en ;
    rdfs:comment "Relates an assessment execution to the product being assessed, including a component used in another product."@en ;
    rdfs:domain eutex:AssessmentExecution ;
    rdfs:range oec:Product ; # CHECK: unknown class
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment#assessesProduct> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:assessesProduct. Captures the link from a specific assessment run to the product (or component) it evaluates, distinct from generic product‑assessment links."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-assessment#assessesProduct> .

eutex:assessesRecyclingRoute
