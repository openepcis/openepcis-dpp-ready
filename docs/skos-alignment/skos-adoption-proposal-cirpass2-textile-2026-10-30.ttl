    rdfs:comment "Links a spinning process type or concrete execution to the controlled spinning‑method concept that describes how fibers are spun into yarn."@en ;
    rdfs:range eutex:SpinningMethodConcept ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#hasSpinningMethod> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:hasSpinningMethod. Captures the spinning method used in a textile process within the textile‑process module."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-process#hasSpinningMethod> .

eutex:hasStructuralCharacteristic
    a owl:ObjectProperty ;
    rdfs:label "Has Structural Characteristic"@en ;
    rdfs:comment "Links a textile product, including products used as components of other products, to the occurrence of a textile structure characteristic."@en ;
