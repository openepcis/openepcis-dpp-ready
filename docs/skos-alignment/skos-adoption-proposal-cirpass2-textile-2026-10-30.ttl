    skos:closeMatch <https://w3id.org/eudpp/textile-process#YarnConditioning> .

eutex:YarnElasticity
    a owl:Class ;
    rdfs:label "Yarn Elasticity"@en ;
    rdfs:comment "Mechanical property of a yarn describing its ability to deform and recover."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnElasticity> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnElasticity. Captures yarn‑level elasticity, distinct from fabric durability or spirality tests."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#YarnElasticity> .

eutex:YarnHairiness
    a owl:Class ;
    rdfs:label "Yarn Hairiness"@en ;
    rdfs:comment "Structural property of a yarn describing fibre ends and loops protruding from the yarn body."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnHairiness> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnHairiness. Captures yarn‑level hairiness, distinct from fabric type or spirality tests."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#YarnHairiness> .

eutex:YarnManufacturingProcess
    a owl:Class ;
    rdfs:label "Yarn Manufacturing Process"@en ;
    rdfs:comment "Manufacturing process that transforms fibres or filaments into yarns."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#YarnManufacturingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnManufacturingProcess. Defines the specific textile manufacturing activity of yarn production, distinct from generic product or process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#YarnManufacturingProcess> .

eutex:YarnSoftness
    a owl:Class ;
    rdfs:label "Yarn Softness"@en ;
    rdfs:comment "Tactile property of a yarn describing perceived softness or smoothness."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnSoftness> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnSoftness. Captures yarn‑level softness, distinct from fabric durability or substance concerns."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#YarnSoftness> .

eutex:YarnStrength
    a owl:Class ;
    rdfs:label "Yarn Strength"@en ;
    rdfs:comment "Mechanical characteristic expressing the ability of a yarn to withstand tensile force without breaking."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnStrength> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnStrength. Adds a yarn‑level tensile strength concept that is not covered by the existing fabric tensile strength term."@en ;
    skos:broadMatch <https://w3id.org/eudpp/textile-structure#YarnStrength> .

eutex:YarnStructuralCharacteristic
    a owl:Class ;
    rdfs:label "Yarn Structural Characteristic"@en ;
    rdfs:comment "Characteristic of a yarn concerning its structural regularity or configuration."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnStructuralCharacteristic. Adds a yarn‑level structural property that is not covered by the existing EssentialCharacteristic or FabricType terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic> .

eutex:YarnTactileCharacteristic
