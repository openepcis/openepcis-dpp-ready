    skos:closeMatch <https://w3id.org/eudpp/textile-process#WeavingProcess> .

eutex:WetProcessingProcess
    a owl:Class ;
    rdfs:label "Wet Processing Process"@en ;
    rdfs:comment "Textile manufacturing process involving liquid media, chemical treatment, washing, dyeing, printing or finishing operations."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#WetProcessingProcess> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:WetProcessingProcess. Captures the specific textile manufacturing activity of wet processing, distinct from generic product or process classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-process#WetProcessingProcess> .

eutex:Wrinkling
    a owl:Class ;
    rdfs:label "Wrinkling"@en ;
    rdfs:comment "Durability‑related deformation behaviour describing the tendency of a textile material or product to form creases under use or after deformation and recovery cycles."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-durability#Wrinkling> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:Wrinkling. Captures a specific mechanical failure mode distinct from general durability classes."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-durability#Wrinkling> .

eutex:YarnAppearance
    a owl:Class ;
    rdfs:label "Yarn Appearance"@en ;
    rdfs:comment "Visual characteristic of yarn concerning diameter, hairiness, visible defects and overall appearance."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnAppearance> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnAppearance. Captures the specific yarn‑level visual quality that is not covered by the broader fabric visual inspection term."@en ;
    skos:broadMatch <https://w3id.org/eudpp/textile-structure#YarnAppearance> .

eutex:YarnCharacteristic
    a owl:Class ;
    rdfs:label "Yarn Characteristic"@en ;
    rdfs:comment "Characteristic of a yarn that may influence fabric and product durability."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnCharacteristic. Adds a yarn‑level property that is not covered by the existing EssentialCharacteristic or DurabilityClass terms."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#YarnCharacteristic> .

eutex:YarnConditioning
    a owl:Class ;
    rdfs:label "Yarn Conditioning"@en ;
    rdfs:comment "Spinning or post‑spinning parameter such as steaming that enhances yarn flexibility, strength or evenness."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-process#YarnConditioning> ;
