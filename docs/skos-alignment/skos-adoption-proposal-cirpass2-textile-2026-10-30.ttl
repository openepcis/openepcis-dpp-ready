    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnUniformity> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnUniformity. Captures yarn‑level uniformity, distinct from fabric type or robustness assessment."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#YarnUniformity> .

eutex:YarnVisualCharacteristic
    a owl:Class ;
    rdfs:label "Yarn Visual Characteristic"@en ;
    rdfs:comment "Visible quality of a yarn, covering colour, appearance and surface condition."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-structure#YarnVisualCharacteristic> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:YarnVisualCharacteristic. Captures yarn‑level visual quality, distinct from fabric visual inspection or essential characteristics."@en ;
    skos:closeMatch <https://w3id.org/eudpp/textile-structure#YarnVisualCharacteristic> .

eutex:ZipperFailure
    a owl:Class ;
    rdfs:label "Zipper Failure"@en ;
    rdfs:comment "Specific trim failure involving the failure of a zipper or zip fastener."@en ;
