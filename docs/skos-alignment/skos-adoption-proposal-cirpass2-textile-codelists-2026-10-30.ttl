# ===== values (230) =====

eutex:EqualTo
    a owl:NamedIndividual, skos:Concept, eutex:ThresholdComparisonOperatorConcept ;
    rdfs:label "equal to"@en ;
    skos:prefLabel "equal to"@en ;
    rdfs:comment "The measured or assessed value must equal the threshold value."@en ;
    skos:inScheme eutex:ThresholdComparisonOperatorScheme ;
    skos:topConceptOf eutex:ThresholdComparisonOperatorScheme ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment-codelists#equalTo> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:equalTo."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment-codelists#equalTo> .

eutex:GreaterThan
    a owl:NamedIndividual, skos:Concept, eutex:ThresholdComparisonOperatorConcept ;
    rdfs:label "greater than"@en ;
    skos:prefLabel "greater than"@en ;
    rdfs:comment "The measured or assessed value must be greater than the threshold value."@en ;
    skos:inScheme eutex:ThresholdComparisonOperatorScheme ;
    skos:topConceptOf eutex:ThresholdComparisonOperatorScheme ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment-codelists#greaterThan> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:greaterThan."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment-codelists#greaterThan> .

