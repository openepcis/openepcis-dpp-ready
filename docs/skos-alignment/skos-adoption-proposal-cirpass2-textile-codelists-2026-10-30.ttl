    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:greaterThanOrEqualTo."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment-codelists#greaterThanOrEqualTo> .

