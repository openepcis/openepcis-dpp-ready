# Proposed code-list individuals from the cirpass2-textile reverse-coverage run of 2026-10-30.
# Generated by scripts/propose-cirpass2-textile-codelists.ts (deterministic, no model): one block per
# upstream concept nothing of ours referenced, typed with the class of ours that holds the list
# (a drafted class from the term proposal, an existing class, or a stub below), the SKOS scheme
# and hierarchy kept, skos:exactMatch to the upstream concept. A proposal for the curator, not an
# ontology. The drafted classes it types with live in skos-adoption-proposal-cirpass2-textile-2026-10-30.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix eutex: <https://ref.openepcis.org/extensions/eu/textile/> .
@prefix euelec: <https://ref.openepcis.org/extensions/eu/electronics/> .

# ===== class stubs the values below need (CHECK each) =====

eutex:RecyclabilityCriterion
    a owl:Class ;
    rdfs:label "Recyclability Criterion"@en ;
    rdfs:comment "A criterion against which the recyclability of a textile product is assessed."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-textile-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

eutex:SortingCriterion
    a owl:Class ;
    rdfs:label "Sorting Criterion"@en ;
    rdfs:comment "A criterion by which collected textiles are sorted for reuse or recycling."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-textile-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

eutex:RecyclabilityOutcome
    a owl:Class ;
    rdfs:label "Recyclability Outcome"@en ;
    rdfs:comment "The outcome class of a recyclability assessment of a textile product."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-textile-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

eutex:PreTreatmentTechnique
    a owl:Class ;
    rdfs:label "Pre-Treatment Technique"@en ;
    rdfs:comment "A technique applied to collected textile waste before recycling, such as removal of trims or disassembly."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-textile-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

eutex:PriorityRepairElementType
    a owl:Class ;
    rdfs:label "Priority Repair Element Type"@en ;
    rdfs:comment "A type of product element whose repair is prioritised in a repairability assessment."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-textile-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

# ===== concept schemes (31) =====

eutex:ThresholdComparisonOperatorScheme
    a skos:ConceptScheme ;
    rdfs:label "Threshold comparison operator scheme"@en ;
    rdfs:comment "Controlled vocabulary of comparison operators used by performance thresholds."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme> .

eutex:NonTextileComponentTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Non-textile component type scheme"@en ;
    rdfs:comment "Controlled vocabulary of functional types of non-textile components integrated into textile products."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials-codelists#NonTextileComponentTypeScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-associated-materials-codelists#NonTextileComponentTypeScheme> .

eutex:PackagingMaterialTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Packaging material type scheme"@en ;
    rdfs:comment "Controlled vocabulary of material types used for textile-product packaging."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials-codelists#PackagingMaterialTypeScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-associated-materials-codelists#PackagingMaterialTypeScheme> .

eutex:TextileChemicalFunctionScheme
    a skos:ConceptScheme ;
    rdfs:label "Textile chemical function scheme"@en ;
    rdfs:comment "Controlled vocabulary of technical functions performed by chemical substances in textile manufacturing, treatment, finishing or functionalisation."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials-codelists#TextileChemicalFunctionScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-associated-materials-codelists#TextileChemicalFunctionScheme> .

eutex:TextileChemicalUseCategoryScheme
    a skos:ConceptScheme ;
    rdfs:label "Textile chemical use category scheme"@en ;
    rdfs:comment "Controlled vocabulary distinguishing process chemicals, performance chemicals and unintended chemical substances."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials-codelists#TextileChemicalUseCategoryScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-associated-materials-codelists#TextileChemicalUseCategoryScheme> .

eutex:FibreTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Textile fibre type scheme"@en ;
    rdfs:comment "Controlled vocabulary of textile fibre types used to describe textile fibre composition."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-codelists#FibreTypeScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-codelists#FibreTypeScheme> .

eutex:StudyScopeStatusScheme
    a skos:ConceptScheme ;
    rdfs:label "Study scope status scheme"@en ;
    rdfs:comment "Controlled vocabulary for representing the status of a textile product type with respect to the JRC preparatory study scope."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-codelists#StudyScopeStatusScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-codelists#StudyScopeStatusScheme> .

eutex:TextileApparelProductTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Textile apparel product type scheme"@en ;
    rdfs:comment "Controlled vocabulary representing the textile apparel categories of JRC Table 7. The JRC categories are aligned with the PEFCR Apparel and Footwear work but this scheme does not claim identity with the complete PEFCR segmentation."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-codelists#TextileApparelProductTypeScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-codelists#TextileApparelProductTypeScheme> .

eutex:EvidenceStatusScheme
    a skos:ConceptScheme ;
    rdfs:label "Evidence status scheme"@en ;
    rdfs:comment "Controlled categories describing the evidential status of weak ontology statements."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme> ;
    skos:exactMatch <https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme> .

eutex:ProductTechnologyLevelScheme
    a skos:ConceptScheme ;
