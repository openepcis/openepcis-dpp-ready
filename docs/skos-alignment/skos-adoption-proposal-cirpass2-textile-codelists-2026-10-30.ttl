eutex:AcidDye
    a owl:NamedIndividual, skos:Concept, eutex:TextileChemicalFunctionConcept ;
    rdfs:label "Acid dye"@en ;
    skos:prefLabel "Acid dye"@en ;
    skos:altLabel "Acid dyes"@en ;
    skos:notation "CHEM_ROLE_ACID_DYE" ;
    rdfs:comment "Dye function corresponding to acid dyes used for compatible fibre types such as wool, silk or polyamide."@en ;
    skos:inScheme eutex:TextileChemicalFunctionScheme ;
    skos:broader eutex:Dye ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/eu/textile/> ;
    dcterms:source <https://w3id.org/eudpp/textile-associated-materials-codelists#acidDye> ;
    skos:note "Proposed from the cirpass2-textile reverse-coverage run of 2026-10-30 to cover cirpass2-textile:acidDye."@en ;
    skos:exactMatch <https://w3id.org/eudpp/textile-associated-materials-codelists#acidDye> .

eutex:AcidOrAlkali
    a owl:NamedIndividual, skos:Concept, eutex:TextileChemicalFunctionConcept ;
    rdfs:label "Acid or alkali"@en ;
    skos:prefLabel "Acid or alkali"@en ;
    skos:altLabel "Acids and alkalis"@en ;
    skos:notation "CHEM_ROLE_ACID_OR_ALKALI" ;
    rdfs:comment "Chemical function involving pH adjustment or chemical treatment during textile preparation, dyeing or finishing."@en ;
