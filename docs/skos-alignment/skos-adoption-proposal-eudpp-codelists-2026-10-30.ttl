    dcterms:source <https://w3id.org/eudpp#ind_EF_climateChange> ;
    skos:note "Environmental Footprint 3.1 impact-assessment indicator (JRC EF reference package); unit kg CO2-eq. Proposed from the eudpp reverse-coverage run of 2026-10-30 to cover eudpp:ind_EF_climateChange."@en ;
    skos:exactMatch eudpp:ind_EF_climateChange .

