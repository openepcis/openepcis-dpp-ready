# Proposed code-list individuals from the eudpp reverse-coverage run of 2026-10-30.
# Generated by scripts/propose-cirpass2-codelists.ts (deterministic, no model): one block per
# upstream code-list value nothing of ours referenced, typed with the class of ours that holds the
# list, skos:exactMatch to the upstream value. A proposal for the curator, not an ontology.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix eudpp: <https://w3id.org/eudpp#> .
@prefix oec: <https://ref.openepcis.org/extensions/common/core/> .

# ===== class stubs the values below need (CHECK each) =====

oec:SoCCriterion
    a owl:Class ;
    rdfs:label "Substance of Concern Criterion"@en ;
    rdfs:comment "A qualification criterion of ESPR Article 2(27) under which a substance counts as a substance of concern: (a) REACH Art. 57 SVHC, (b) CLP hazard classes, (c) POPs, (d) hampers reuse or recycling. Values are skos:Concepts in oec:SoCCriterionScheme."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

oec:AreaOfProtection
    a owl:Class ;
    rdfs:label "Area of Protection"@en ;
    rdfs:comment "An area of protection in life-cycle impact assessment: what an impact category ultimately threatens (human health, natural environment, natural resources, man-made environment)."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

oec:ImpactCategory
    a owl:Class ;
    rdfs:label "Impact Category"@en ;
    rdfs:comment "A life-cycle impact-assessment impact category (climate change, eutrophication, water use, …): what an impact indicator measures, independent of the characterisation method. Values follow the EF 3.1 / ILCD category list."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

oec:LcaComplianceStatus
    a owl:Class ;
    rdfs:label "LCA Compliance Status"@en ;
    rdfs:comment "The degree to which an LCA or EPD study complies with a compliance system (fully, partially, not compliant). CHECK: eubat:ComplianceStatus exists in the battery module; decide whether to lift it to core instead of a second class."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

oec:EN15804IndicatorGroup
    a owl:Class ;
    rdfs:label "EN 15804 Indicator Group"@en ;
    rdfs:comment "A group of EN 15804+A2 indicators as the standard tabulates them: core impact indicators, impact indicators with caveats, resource use, waste, output flows for valorisation, exported energy."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    skos:note "Class stub proposed by scripts/propose-cirpass2-codelists.ts (2026-10-30) to hold the code-list values below; CHECK before adopting."@en .

oec:SoCCriterionScheme
    a skos:ConceptScheme ;
    rdfs:label "Substance of Concern Criteria"@en ;
    rdfs:comment "The qualification criteria of ESPR Article 2(27) under which a substance is a substance of concern."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    dcterms:source <https://w3id.org/eudpp#SoCCriterionScheme> ;
    skos:exactMatch eudpp:SoCCriterionScheme .

# ===== values (92) =====

oec:SoCCriterionA
    a owl:NamedIndividual, oec:SoCCriterion, skos:Concept ;
    rdfs:label "CriterionA"@en ;
    rdfs:comment "The substance meets the relevant REACH Article 57 criteria and has been identified under Article 59(1)."@en ;
    skos:inScheme oec:SoCCriterionScheme ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    dcterms:source <https://w3id.org/eudpp#CriterionA> ;
    skos:note "ESPR 2024/1781 Article 2(27). Proposed from the eudpp reverse-coverage run of 2026-10-30 to cover eudpp:CriterionA."@en ;
    skos:exactMatch eudpp:CriterionA .

oec:SoCCriterionB
    a owl:NamedIndividual, oec:SoCCriterion, skos:Concept ;
    rdfs:label "CriterionB"@en ;
    rdfs:comment "The substance has a harmonised CLP Annex VI Part 3 classification in one of the hazard classes or categories listed by ESPR Article 2(27)(b)."@en ;
    skos:inScheme oec:SoCCriterionScheme ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    dcterms:source <https://w3id.org/eudpp#CriterionB> ;
    skos:note "ESPR 2024/1781 Article 2(27). Proposed from the eudpp reverse-coverage run of 2026-10-30 to cover eudpp:CriterionB."@en ;
    skos:exactMatch eudpp:CriterionB .

oec:SoCCriterionC
    a owl:NamedIndividual, oec:SoCCriterion, skos:Concept ;
    rdfs:label "CriterionC"@en ;
    rdfs:comment "The substance is regulated under Regulation (EU) 2019/1021 on persistent organic pollutants."@en ;
    skos:inScheme oec:SoCCriterionScheme ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    dcterms:source <https://w3id.org/eudpp#CriterionC> ;
    skos:note "ESPR 2024/1781 Article 2(27). Proposed from the eudpp reverse-coverage run of 2026-10-30 to cover eudpp:CriterionC."@en ;
    skos:exactMatch eudpp:CriterionC .

oec:SoCCriterionD
    a owl:NamedIndividual, oec:SoCCriterion, skos:Concept ;
    rdfs:label "CriterionD"@en ;
    rdfs:comment "The substance negatively affects reuse and recycling of materials in the product in which it is present."@en ;
    skos:inScheme oec:SoCCriterionScheme ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    dcterms:source <https://w3id.org/eudpp#CriterionD> ;
    skos:note "ESPR 2024/1781 Article 2(27). Proposed from the eudpp reverse-coverage run of 2026-10-30 to cover eudpp:CriterionD."@en ;
    skos:exactMatch eudpp:CriterionD .

oec:AccreditedThirdPartyReview
    a owl:NamedIndividual, oec:TypeOfReview ;
    rdfs:label "Accredited third party review"@en ;
    rdfs:comment "Reviewer independent of the organisations involved and accredited by an independent accreditation body. Highest level acceptable for EN 15804+A2 compliance."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/extensions/common/core/> ;
    dcterms:source <https://w3id.org/eudpp#accreditedThirdPartyReview> ;
    skos:note "ILCD+EPD review type. Proposed from the eudpp reverse-coverage run of 2026-10-30 to cover eudpp:accreditedThirdPartyReview."@en ;
    skos:exactMatch eudpp:accreditedThirdPartyReview .

