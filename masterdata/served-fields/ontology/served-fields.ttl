# Served master-data field vocabulary — the flat field names the OpenEPCIS
# Digital Link resolver exposes for GS1 Product, Place, and Organization
# master data.
#
# This is NOT an EPCIS extension and it does NOT mint terms of its own for
# anything GS1 already defines. 135 of the 139 served fields are a GS1 Web
# Vocabulary property under the identical local name, so the GS1 IRI *is* the
# term; the only thing OpenEPCIS contributes is the curated ESPR Article 9
# access tier, attached to the GS1 IRI as an annotation (see
# served-fields-access-levels.ttl).
#
# The remaining 4 are flattened plurals or resolver-specific field shapes
# with no identically named GS1 property, and two of them (geoCoordinates,
# geoShape) share a single GS1 target (gs1:geo). Because per-field access
# enforcement matches the bare keys of the served documents verbatim, these
# keep a local identifier under /masterdata/served-fields/ and point at their
# nearest GS1 property with skos:closeMatch.
#
# Generated shape; curated by hand. Labels and comments describe the field as
# served (annotation), not a redefinition of the GS1 term.

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix gs1:   <https://ref.gs1.org/voc/> .
@prefix oemd:  <https://ref.openepcis.org/masterdata/served-fields/> .

<https://ref.openepcis.org/masterdata/served-fields/>
    a owl:Ontology ;
    dcterms:title "OpenEPCIS Served Master-Data Fields"@en ;
    dcterms:description """The flat served master-data field names exposed by the OpenEPCIS
Digital Link resolver, each carrying a curated default ESPR Article 9 access
tier. Identity for the 135 fields that are GS1 Web Vocabulary properties stays
with GS1 (https://ref.gs1.org/voc/); this file annotates those IRIs rather
than redefining them. Only the 4 resolver-specific flattened shapes carry a
local identifier.

System/facet fields of the resolver DTOs (accessLevel, isAnonymousAccessAllowed,
extensions, jws, type) are intentionally NOT part of this vocabulary: they are
envelope metadata, not master data."""@en ;
    dcterms:creator "OpenEPCIS" ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    owl:versionInfo "0.2.0" .


# =============================================================================
# GS1-identified served fields — the GS1 IRI is the term. Annotated here with
# the served label/comment; the access tier lives in the access-levels file.
# =============================================================================
gs1:gtin
    a owl:DatatypeProperty ;
    rdfs:label "GTIN"@en ;
    rdfs:comment "A Global Trade Item Number (GTIN) is the 14 digit GS1 Identification Key used to identify products."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productID
    a owl:DatatypeProperty ;
    rdfs:label "Product ID"@en ;
    rdfs:comment "Additional means to the Global Trade Item Number to identify a product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productName
    a owl:DatatypeProperty ;
    rdfs:label "Product Name"@en ;
    rdfs:comment "Consumer friendly short description of the product suitable for compact presentation."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productDescription
    a owl:DatatypeProperty ;
    rdfs:label "Product Description"@en ;
    rdfs:comment "An understandable and useable description of a product using brand and other descriptors."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productRange
    a owl:DatatypeProperty ;
    rdfs:label "Product Range"@en ;
    rdfs:comment "A name, used by a Brand Owner, that span multiple consumer categories or uses."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:gpcCategoryCode
    a owl:DatatypeProperty ;
    rdfs:label "GPC Category Code"@en ;
    rdfs:comment "8-digit code (GPC Brick Value) specifying a product category according to the GS1 Global Product Classification (GPC) standard."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:gpcCategoryDescription
    a owl:DatatypeProperty ;
    rdfs:label "GPC Category Description"@en ;
    rdfs:comment "A description of the code specifying a product category according to the GS1 Global Product Classification (GPC) standard."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:includedAccessories
    a owl:DatatypeProperty ;
    rdfs:label "Included Accessories"@en ;
    rdfs:comment "Any included object or device not part of the core product itself but which adds to its functionality or use."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:isProductRecalled
    a owl:DatatypeProperty ;
    rdfs:label "Is Product Recalled"@en ;
    rdfs:comment "An indicator for the product to determine if the Manufacturer or Supplier has recalled the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productionDate
    a owl:DatatypeProperty ;
    rdfs:label "Production Date"@en ;
    rdfs:comment "The production date is the production or assembly date determined by the manufacturer."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productionDateTime
    a owl:DatatypeProperty ;
    rdfs:label "Production Date Time"@en ;
    rdfs:comment "The date and time of production (or assembly)."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:brand
    a owl:ObjectProperty ;
    rdfs:label "Brand"@en ;
    rdfs:comment "The brand of the product that appears on the consumer package."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:brandOwner
    a owl:ObjectProperty ;
    rdfs:label "Brand Owner"@en ;
    rdfs:comment "The brand owner of the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:manufacturer
    a owl:ObjectProperty ;
    rdfs:label "Manufacturer"@en ;
    rdfs:comment "The organization that produces the item."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:manufacturingPlant
    a owl:ObjectProperty ;
    rdfs:label "Manufacturing Plant"@en ;
    rdfs:comment "A physical location consisting of one or more buildings with facilities for manufacturing."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:countryOfLastProcessing
    a owl:ObjectProperty ;
    rdfs:label "Country Of Last Processing"@en ;
    rdfs:comment "The place where the product or ingredient was last processed and tested before importation."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:countryOfOrigin
    a owl:ObjectProperty ;
    rdfs:label "Country Of Origin"@en ;
    rdfs:comment "Code indicating the country of origin of the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:countryOfAssembly
    a owl:ObjectProperty ;
    rdfs:label "Country Of Assembly"@en ;
    rdfs:comment "The place where product is assembled."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:grossArea
    a owl:ObjectProperty ;
    rdfs:label "Gross Area"@en ;
    rdfs:comment "The overall area of the item including packaging."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:grossVolume
    a owl:ObjectProperty ;
    rdfs:label "Gross Volume"@en ;
    rdfs:comment "The overall volume of the item including packaging."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:grossWeight
    a owl:ObjectProperty ;
    rdfs:label "Gross Weight"@en ;
    rdfs:comment "Used to identify the gross weight of the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:manufacturersWarranty
    a owl:ObjectProperty ;
    rdfs:label "Manufacturers Warranty"@en ;
    rdfs:comment "The warranty associated with the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:targetMarket
    a owl:ObjectProperty ;
    rdfs:label "Target Market"@en ;
    rdfs:comment "Relates to a set of target market details (product release date and associated countries)."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:colourCode
    a owl:ObjectProperty ;
    rdfs:label "Colour Code"@en ;
    rdfs:comment "Relates to a set of details about the colour code for a product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:additionalProductDescription
    a owl:DatatypeProperty ;
    rdfs:label "Additional Product Description"@en ;
    rdfs:comment "Additional variants necessary to communicate to the industry to help define the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:bestBeforeDate
    a owl:DatatypeProperty ;
    rdfs:label "Best Before Date"@en ;
    rdfs:comment "Best before date on the label or package signifies the end of the period under which the product will retain specific quality attributes or claims even though the product may continue to retain positive quality attributes after this date."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:colourDescription
    a owl:DatatypeProperty ;
    rdfs:label "Colour Description"@en ;
    rdfs:comment "A description of the colour of an object."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:consumerPackageDisclaimer
    a owl:DatatypeProperty ;
    rdfs:label "Consumer Package Disclaimer"@en ;
    rdfs:comment "Additional information that should be used in advertising and in displaying."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:consumerProductVariant
    a owl:DatatypeProperty ;
    rdfs:label "Consumer Product Variant"@en ;
    rdfs:comment "The consumer product variant may be used to distinguish one variant of a retail consumer trade item from another if the change does not require the allocation of a different Global Trade Item Number (per the GTIN Management Standard),..."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:consumerSafetyInformation
    a owl:DatatypeProperty ;
    rdfs:label "Consumer Safety Information"@en ;
    rdfs:comment "Information on consumer safety regarding the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:consumerStorageInstructions
    a owl:DatatypeProperty ;
    rdfs:label "Consumer Storage Instructions"@en ;
    rdfs:comment "Expresses in text the consumer storage instructions of a product which are normally held on the label or accompanying the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:consumerUsageInstructions
    a owl:DatatypeProperty ;
    rdfs:label "Consumer Usage Instructions"@en ;
    rdfs:comment "Free text containing the usage instructions of a product, which are normally held on the label or accompanying the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:countryOfOriginStatement
    a owl:DatatypeProperty ;
    rdfs:label "Country Of Origin Statement"@en ;
    rdfs:comment "A description of the geographic area the item may have originated from or has been processed."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:descriptiveSize
    a owl:DatatypeProperty ;
    rdfs:label "Descriptive Size"@en ;
    rdfs:comment "An alphanumeric size factor the brand owner wishes to communicate to the consumer."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:dueDate
    a owl:DatatypeProperty ;
    rdfs:label "Due Date"@en ;
    rdfs:comment "The date by which an invoice should be paid."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:expirationDate
    a owl:DatatypeProperty ;
    rdfs:label "Expiration Date"@en ;
    rdfs:comment "The expiration date is the date that determines the limit of consumption or use of a product/coupon."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:expirationDateTime
    a owl:DatatypeProperty ;
    rdfs:label "Expiration Date Time"@en ;
    rdfs:comment "The manufacturer determines the expiration date and time, which is relevant only for short duration and for items that will not be sent on long distances and not outside of the time zone."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:firstFreezeDate
    a owl:DatatypeProperty ;
    rdfs:label "First Freeze Date"@en ;
    rdfs:comment "The first freeze date is applicable to products that are frozen directly after slaughtering, harvesting, catching or after initial processing of the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:functionalName
    a owl:DatatypeProperty ;
    rdfs:label "Functional Name"@en ;
    rdfs:comment "Describes use of the product or service by the consumer."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:growingMethod
    a owl:DatatypeProperty ;
    rdfs:label "Growing Method"@en ;
    rdfs:comment "The process through which fresh produce is grown and cultivated."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:harvestDate
    a owl:DatatypeProperty ;
    rdfs:label "Harvest Date"@en ;
    rdfs:comment "The harvest date."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:harvestDateEnd
    a owl:DatatypeProperty ;
    rdfs:label "Harvest Date End"@en ;
    rdfs:comment "The harvest end date."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:harvestDateStart
    a owl:DatatypeProperty ;
    rdfs:label "Harvest Date Start"@en ;
    rdfs:comment "The harvest start date."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:hasBatchLotNumber
    a owl:DatatypeProperty ;
    rdfs:label "Has Batch Lot Number"@en ;
    rdfs:comment "The batch or lot number associates an item with information the manufacturer considers relevant for traceability of the trade item to which the element string is applied."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:hasSerialNumber
    a owl:DatatypeProperty ;
    rdfs:label "Has Serial Number"@en ;
    rdfs:comment "A serial number is assigned to an entity for its lifetime."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:hasThirdPartyControlledSerialNumber
    a owl:DatatypeProperty ;
    rdfs:label "Has Third Party Controlled Serial Number"@en ;
    rdfs:comment "This identifier is assigned to an entity for its lifetime."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:healthClaimDescription
    a owl:DatatypeProperty ;
    rdfs:label "Health Claim Description"@en ;
    rdfs:comment "A description of health claims according to regulations of the target market."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:packagingDate
    a owl:DatatypeProperty ;
    rdfs:label "Packaging Date"@en ;
    rdfs:comment "The packaging date is the date when the goods were packed as determined by the packager."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:packagingMarkedLabelAccreditation
    a owl:DatatypeProperty ;
    rdfs:label "Packaging Marked Label Accreditation"@en ;
    rdfs:comment "A marking that the product received recognition, endorsement, certification by following guidelines by the label issuing agency."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productFeatureBenefit
    a owl:DatatypeProperty ;
    rdfs:label "Product Feature Benefit"@en ;
    rdfs:comment "Element for consumer facing marketing content to describe the key features or benefits of the style suitable for display purposes."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productFormDescription
    a owl:DatatypeProperty ;
    rdfs:label "Product Form Description"@en ;
    rdfs:comment "The physical form or shape of the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productMarketingMessage
    a owl:DatatypeProperty ;
    rdfs:label "Product Marketing Message"@en ;
    rdfs:comment "Marketing message associated with the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productSustainabilityInfo
    a owl:DatatypeProperty ;
    rdfs:label "Product Sustainability Info"@en ;
    rdfs:comment "This term has been deprecated."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productionVariantDescription
    a owl:DatatypeProperty ;
    rdfs:label "Production Variant Description"@en ;
    rdfs:comment "Free text assigned by the manufacturer to describe the production variant."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:productionVariantEffectiveDateTime
    a owl:DatatypeProperty ;
    rdfs:label "Production Variant Effective Date Time"@en ;
    rdfs:comment "The start date of a production variant."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:provenanceStatement
    a owl:DatatypeProperty ;
    rdfs:label "Provenance Statement"@en ;
    rdfs:comment "Free text description of the region or place the product originates from."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:regulatedProductName
    a owl:DatatypeProperty ;
    rdfs:label "Regulated Product Name"@en ;
    rdfs:comment "The prescribed, regulated or generic product name or denomination that describes the true nature of the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:sellByDate
    a owl:DatatypeProperty ;
    rdfs:label "Sell By Date"@en ;
    rdfs:comment "The date specified by the manufacturer as the last date the retailer is to offer the product for sale to the consumer."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:supplierSpecifiedMinimumConsumerStorageDays
    a owl:DatatypeProperty ;
    rdfs:label "Supplier Specified Minimum Consumer Storage Days"@en ;
    rdfs:comment "Represents the number of days between a product's sell by date and its use by date."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:variantDescription
    a owl:DatatypeProperty ;
    rdfs:label "Variant Description"@en ;
    rdfs:comment "Free text field used to identify the variant of the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:warningCopyDescription
    a owl:DatatypeProperty ;
    rdfs:label "Warning Copy Description"@en ;
    rdfs:comment "Warning information is additional information that outlines special requirements, warning and caution information printed on the package."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:additionalProductClassification
    a owl:ObjectProperty ;
    rdfs:label "Additional Product Classification"@en ;
    rdfs:comment "Relates to a set of additional product classification details."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:additive
    a owl:ObjectProperty ;
    rdfs:label "Additive"@en ;
    rdfs:comment "Relates to details about any additives that a product may contain."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:audioFile
    a owl:ObjectProperty ;
    rdfs:label "Audio File"@en ;
    rdfs:comment "Link to a file containing an audio clip which is relevant to the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:authenticity
    a owl:ObjectProperty ;
    rdfs:label "Authenticity"@en ;
    rdfs:comment "Links to details of covert/overt security markings that may be used to check authenticity of a product instance."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:awardPrize
    a owl:ObjectProperty ;
    rdfs:label "Award Prize"@en ;
    rdfs:comment "An award or prize given to the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:certification
    a owl:ObjectProperty ;
    rdfs:label "Certification"@en ;
    rdfs:comment "Certification information about a product, organisation or location."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:consumerHandlingStorage
    a owl:ObjectProperty ;
    rdfs:label "Consumer Handling Storage"@en ;
    rdfs:comment "Link to a website, file, or image containing the manufacturer's recommendations for how the consumer or end user should store and handle the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:customerSupportCentre
    a owl:ObjectProperty ;
    rdfs:label "Customer Support Centre"@en ;
    rdfs:comment "The organization which provides product support to the trading partner organization to which merchandise is sold."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:dependentProprietaryProduct
    a owl:ObjectProperty ;
    rdfs:label "Dependent Proprietary Product"@en ;
    rdfs:comment "Dependent products are products which are required to make the current product functional."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:equivalentProduct
    a owl:ObjectProperty ;
    rdfs:label "Equivalent Product"@en ;
    rdfs:comment "A product which can be substituted for the product based on supplier-defined functional equivalence to the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:inPackageDepth
    a owl:ObjectProperty ;
    rdfs:label "In Package Depth"@en ;
    rdfs:comment "The depth of the product in its packaging, as measured according to the GS1 Package Measurement Rules."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:inPackageDiameter
    a owl:ObjectProperty ;
    rdfs:label "In Package Diameter"@en ;
    rdfs:comment "The measurement of the diameter of the product in its package at its largest point."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:inPackageHeight
    a owl:ObjectProperty ;
    rdfs:label "In Package Height"@en ;
    rdfs:comment "The height of the product in the package, as measured according to the GS1 Package Measurement Rules."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:inPackageWidth
    a owl:ObjectProperty ;
    rdfs:label "In Package Width"@en ;
    rdfs:comment "The width of the product in the package, as measured according to the GS1 Package Measurement Rules."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:massPerUnitArea
    a owl:ObjectProperty ;
    rdfs:label "Mass Per Unit Area"@en ;
    rdfs:comment "The mass per unit area of the item."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:netArea
    a owl:ObjectProperty ;
    rdfs:label "Net Area"@en ;
    rdfs:comment "The net area of the item."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:netContent
    a owl:ObjectProperty ;
    rdfs:label "Net Content"@en ;
    rdfs:comment "The quantity of the product contained by a package, usually as claimed on the label."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:netWeight
    a owl:ObjectProperty ;
    rdfs:label "Net Weight"@en ;
    rdfs:comment "Used to identify the net weight of the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:organicClaim
    a owl:ObjectProperty ;
    rdfs:label "Organic Claim"@en ;
    rdfs:comment "Relates to an organic claim about the product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:outOfPackageDepth
    a owl:ObjectProperty ;
    rdfs:label "Out Of Package Depth"@en ;
    rdfs:comment "The depth of the product out of its packaging, as measured according to the GS1 Package Measurement Rules."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:outOfPackageDiameter
    a owl:ObjectProperty ;
    rdfs:label "Out Of Package Diameter"@en ;
    rdfs:comment "The measurement of the diameter of the product out of its package at its largest point."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:outOfPackageHeight
    a owl:ObjectProperty ;
    rdfs:label "Out Of Package Height"@en ;
    rdfs:comment "The height of the product out of the package, as measured according to the GS1 Package Measurement Rules."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:outOfPackageWidth
    a owl:ObjectProperty ;
    rdfs:label "Out Of Package Width"@en ;
    rdfs:comment "The width of the product out of the package, as measured according to the GS1 Package Measurement Rules."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:packaging
    a owl:ObjectProperty ;
    rdfs:label "Packaging"@en ;
    rdfs:comment "Details on the packaging for a product including type, weight and materials."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:referencedFile
    a owl:ObjectProperty ;
    rdfs:label "Referenced File"@en ;
    rdfs:comment "Link to a file or website containing additional information on product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:primaryAlternateProduct
    a owl:ObjectProperty ;
    rdfs:label "Primary Alternate Product"@en ;
    rdfs:comment "A product that is similar to the current product but is not exact match."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:replacedByProduct
    a owl:ObjectProperty ;
    rdfs:label "Replaced By Product"@en ;
    rdfs:comment "The product which permanently replaces the current product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:replacedProduct
    a owl:ObjectProperty ;
    rdfs:label "Replaced Product"@en ;
    rdfs:comment "Indicates the product identification of an item that is being permanently replaced by this product."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:instructionsForUse
    a owl:ObjectProperty ;
    rdfs:label "Instructions For Use"@en ;
    rdfs:comment "Link to a file containing the Instructions For Use."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:additionalLocationID
    a owl:ObjectProperty ;
    rdfs:label "Additional Location ID"@en ;
    rdfs:comment "Location identifiers assigned and managed by government bodies, trade organisations, and other entities."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:address
    a owl:ObjectProperty ;
    rdfs:label "Address"@en ;
    rdfs:comment "The postal address for an organization or place."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:contactPoint
    a owl:ObjectProperty ;
    rdfs:label "Contact Point"@en ;
    rdfs:comment "Contact information."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:glnType
    a owl:DatatypeProperty ;
    rdfs:label "GLN Type"@en ;
    rdfs:comment "Indicates what type of thing is being identified by a GLN."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:globalLocationNumber
    a owl:DatatypeProperty ;
    rdfs:label "Global Location Number"@en ;
    rdfs:comment "A Global Location Number (GLN) is the GS1 Identification Key used to identify physical locations or parties."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:locationGLN
    a owl:DatatypeProperty ;
    rdfs:label "Location GLN"@en ;
    rdfs:comment "13-digit GLN that is being used to identify a physical or digital location."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:afterHoursContact
    a owl:ObjectProperty ;
    rdfs:label "After Hours Contact"@en ;
    rdfs:comment "Links to after-hours contact information."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:baseLocation
    a owl:ObjectProperty ;
    rdfs:label "Base Location"@en ;
    rdfs:comment "A fixed physical location where a mobile location most commonly resides."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:digitalAddress
    a owl:DatatypeProperty ;
    rdfs:label "Digital Address"@en ;
    rdfs:comment "The location reference associated to a digital place."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:digitalLocationName
    a owl:DatatypeProperty ;
    rdfs:label "Digital Location Name"@en ;
    rdfs:comment "The name of a digital place."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:leasedFrom
    a owl:ObjectProperty ;
    rdfs:label "Leased From"@en ;
    rdfs:comment "Links to the organisation (lessor) from which this place is leased."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:leasedTo
    a owl:ObjectProperty ;
    rdfs:label "Leased To"@en ;
    rdfs:comment "Links to the organisation(s) (lessee(s)) to which this place is leased."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:locationHistory
    a owl:ObjectProperty ;
    rdfs:label "Location History"@en ;
    rdfs:comment "Provides details on if and when a location is active or inactive."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:locationRole
    a owl:DatatypeProperty ;
    rdfs:label "Location Role"@en ;
    rdfs:comment "A location classification based on the purpose, type of site and/or what occurs there."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:managedBy
    a owl:ObjectProperty ;
    rdfs:label "Managed By"@en ;
    rdfs:comment "Links to the organisation that manages this place or organisation, as designated by the owner or another organisation."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:managedFor
    a owl:ObjectProperty ;
    rdfs:label "Managed For"@en ;
    rdfs:comment "Links to the organisation(s) for whom this place is managed."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:occupiedBy
    a owl:ObjectProperty ;
    rdfs:label "Occupied By"@en ;
    rdfs:comment "Links to the organisation(s) that occupy this place."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:ownedBy
    a owl:ObjectProperty ;
    rdfs:label "Owned By"@en ;
    rdfs:comment "Links to the organisation(s) that own this place, in full or in part."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:physicalLocationName
    a owl:DatatypeProperty ;
    rdfs:label "Physical Location Name"@en ;
    rdfs:comment "The name of a physical place."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:primaryLocationOf
    a owl:ObjectProperty ;
    rdfs:label "Primary Location Of"@en ;
    rdfs:comment "Links to the organisation(s) that designate this place as its/their primary location."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:relatedOrganization
    a owl:ObjectProperty ;
    rdfs:label "Related Organization"@en ;
    rdfs:comment "The organisation(s) associated with a place."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:replacedByPlace
    a owl:ObjectProperty ;
    rdfs:label "Replaced By Place"@en ;
    rdfs:comment "Links to the successor location that is used in place of a previous location."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:replacedPlace
    a owl:ObjectProperty ;
    rdfs:label "Replaced Place"@en ;
    rdfs:comment "Links to the previous location that this location replaces."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:responsibleOrganization
    a owl:ObjectProperty ;
    rdfs:label "Responsible Organization"@en ;
    rdfs:comment "Links to the organisation that is directly responsible for this place."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:organizationName
    a owl:DatatypeProperty ;
    rdfs:label "Organization Name"@en ;
    rdfs:comment "The name of the organization expressed in text."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:organizationRole
    a owl:DatatypeProperty ;
    rdfs:label "Organization Role"@en ;
    rdfs:comment "The role and/or purpose of a party (i.e. legal entity or function)."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:additionalOrganizationIdentificationTypeValue
    a owl:DatatypeProperty ;
    rdfs:label "Additional Organization Identification Type Value"@en ;
    rdfs:comment "The value associated with the Additional Organization Identification Type Value."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:department
    a owl:DatatypeProperty ;
    rdfs:label "Department"@en ;
    rdfs:comment "The name of a division of an organization dealing with a specific activity."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:partyGLN
    a owl:DatatypeProperty ;
    rdfs:label "Party GLN"@en ;
    rdfs:comment "13-digit GLN that is being used to identify a legal entity or function."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:additionalOrganizationID
    a owl:ObjectProperty ;
    rdfs:label "Additional Organization ID"@en ;
    rdfs:comment "Party/organisation identifiers assigned and managed by government bodies, trade organisations, and other entities."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:makesOffer
    a owl:ObjectProperty ;
    rdfs:label "Makes Offer"@en ;
    rdfs:comment "An offer made by an organization."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:manages
    a owl:ObjectProperty ;
    rdfs:label "Manages"@en ;
    rdfs:comment "Links to the place(s) or organisation(s) that this organisation manages, on behalf of the owner or another organisation."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:hasPrimaryLocation
    a owl:ObjectProperty ;
    rdfs:label "Has Primary Location"@en ;
    rdfs:comment "Links to the place(s) that this organisation designates as their primary location(s)."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:location
    a owl:ObjectProperty ;
    rdfs:label "Location"@en ;
    rdfs:comment "The place(s) associated with an organization."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:owns
    a owl:ObjectProperty ;
    rdfs:label "Owns"@en ;
    rdfs:comment "Links to the place(s) or organisation(s) that this organisation owns."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:lesseeOf
    a owl:ObjectProperty ;
    rdfs:label "Lessee Of"@en ;
    rdfs:comment "Links to the place(s) for which this organisation is the lessee (i.e., this organisation leases those places from another organisation, the lessor)."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:lessorFor
    a owl:ObjectProperty ;
    rdfs:label "Lessor For"@en ;
    rdfs:comment "Links to the place(s) for which this organisation is the lessor (i.e., this organisation leases those places to others)."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:responsibleForLocation
    a owl:ObjectProperty ;
    rdfs:label "Responsible For Location"@en ;
    rdfs:comment "Links to the place(s) for which this organisation is responsible."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:organizationHistory
    a owl:ObjectProperty ;
    rdfs:label "Organization History"@en ;
    rdfs:comment "Provides details on if and when an organisation/party is active or inactive."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:parentOrganization
    a owl:ObjectProperty ;
    rdfs:label "Parent Organization"@en ;
    rdfs:comment "Designates the legal entity or function directly above the organisation/party being identified in a hierarchy."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:replacedByOrganization
    a owl:ObjectProperty ;
    rdfs:label "Replaced By Organization"@en ;
    rdfs:comment "Links to the successor organisation that is used in place of a previous organisation."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:replacedOrganization
    a owl:ObjectProperty ;
    rdfs:label "Replaced Organization"@en ;
    rdfs:comment "Links to the previous organisation that this organisation replaces."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:usesManagedLocation
    a owl:ObjectProperty ;
    rdfs:label "Uses Managed Location"@en ;
    rdfs:comment "Links to the place(s) that this organisation uses as a managed space."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:occupies
    a owl:ObjectProperty ;
    rdfs:label "Occupies"@en ;
    rdfs:comment "Links to the place(s) that this organisation occupies."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .

gs1:subOrganization
    a owl:ObjectProperty ;
    rdfs:label "Sub Organization"@en ;
    rdfs:comment "Designates a legal entity or function directly below the organisation/party being identified in a hierarchy."@en ;
    rdfs:isDefinedBy <https://ref.gs1.org/voc/> .


# =============================================================================
# Resolver-specific served fields — flattened plurals / field shapes with no
# identically named GS1 property. Local identifier, closeMatch to nearest GS1.
# =============================================================================
oemd:images
    a owl:ObjectProperty ;
    rdfs:label "Images"@en ;
    rdfs:comment "Referenced image files for the product (flattened plural of the GS1 image link)."@en ;
    skos:closeMatch gs1:image ;
    rdfs:isDefinedBy <https://ref.openepcis.org/masterdata/served-fields/> .

oemd:sizeCodes
    a owl:DatatypeProperty ;
    rdfs:label "Size Codes"@en ;
    rdfs:comment "Size codes assigned to the product (flattened plural of the GS1 size code)."@en ;
    skos:closeMatch gs1:sizeCode ;
    rdfs:isDefinedBy <https://ref.openepcis.org/masterdata/served-fields/> .

oemd:geoCoordinates
    a owl:ObjectProperty ;
    rdfs:label "Geo Coordinates"@en ;
    rdfs:comment "Geographic coordinates (latitude/longitude) of the place."@en ;
    skos:closeMatch gs1:geo ;
    rdfs:isDefinedBy <https://ref.openepcis.org/masterdata/served-fields/> .

oemd:geoShape
    a owl:ObjectProperty ;
    rdfs:label "Geo Shape"@en ;
    rdfs:comment "Geographic shape describing the boundary or area covered by the place."@en ;
    skos:closeMatch gs1:geo ;
    rdfs:isDefinedBy <https://ref.openepcis.org/masterdata/served-fields/> .

