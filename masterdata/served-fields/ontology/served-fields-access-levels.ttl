# Access-tier annotations for the served master-data fields
# (ESPR Article 9 tiers). One entry per term; merged into the module by
# scripts/build-json.ts.
#
# These terms are the flat served field names of the resolver's Product,
# Place, and Organization master-data documents — the consumer-facing
# baseline an anonymous scanner of the GS1 Digital Link QR code sees.
# Curation therefore leans Public: product identity, label content,
# consumer instructions, and GS1-registry identity facts stay open, while
# B2B production-network detail, internal identifier schemes, and the
# ownership/lease/management relation graph default to AuthorizedOnly.
#
# Every entry carries oec:defaultAccessLevel + oec:accessLevelRationale +
# oec:accessLevelSource. No oec:accessLevelMandatedBy is used: this module
# is a consumer-information baseline grounded in ESPR (EU) 2024/1781
# generally (Art. 7(5)/Annex III information for customers, Art. 9 tiered
# access), not in per-article locks of an in-force act. No
# oec:accessLevelInherited is used: all 139 terms are served top-level
# fields with a tier of their own. Tiers are overridable defaults —
# deployments may tighten (never loosen) them at runtime.
#
# Source convention:
#   <https://eur-lex.europa.eu/eli/reg/2024/1781>  ESPR grounding — consumer
#       product information and all AuthorizedOnly confidentiality calls
#   <https://ref.gs1.org/voc/>                     pure GS1-registry facts —
#       GLN/party/place identity published via Verified by GS1

@prefix gs1:   <https://ref.gs1.org/voc/> .
@prefix oemd:  <https://ref.openepcis.io/masterdata/served-fields/> .
@prefix oec:   <https://ref.openepcis.io/extensions/common/core/> .


# =============================================================================
# Public: product identity, description & classification
# =============================================================================
# The identity block is what makes the scanned product recognisable at all;
# it appears on the consumer package, in retail listings, and in the GS1
# registry (ESPR Art. 7(5)/Annex III information for customers).

gs1:gtin oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The GTIN is encoded in the barcode on every consumer package and is the public key that resolves the ESPR Art. 9 data carrier in the first place." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productID oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Additional product identifiers serve the same public identification purpose as the GTIN printed on the package." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productName oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The consumer-friendly product name is on-package and point-of-sale information every customer already sees." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The product description is the basic consumer-facing account of what the scanned item is (ESPR Annex III information for customers)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:additionalProductDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Additional descriptive variants refine the public product description and carry no confidential content beyond it." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:brand oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The brand appears on the consumer package by definition and is core public product identity." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:brandOwner oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The brand owner is the accountable party behind the on-package brand and is published in the GS1 registry (Verified by GS1)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:functionalName oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The functional name tells the consumer what the product is used for — ordinary retail product information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:regulatedProductName oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The regulated or generic denomination is required on the label to describe the true nature of the product to consumers." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productFormDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The physical form or shape of the product is apparent from the product itself and its package." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productRange oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The product-range name is public catalogue information the brand owner itself markets across categories." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:variantDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The variant description distinguishes retail variants the consumer chooses between at point of sale." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:consumerProductVariant oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The consumer product variant distinguishes retail variants under the same GTIN and is by name and purpose consumer-facing." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:colourCode oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Colour codes describe an attribute visible on the product itself and shown in every retail listing." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:colourDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The colour description states an attribute visible on the product itself." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:descriptiveSize oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The descriptive size is, per its GS1 definition, a size factor the brand owner wishes to communicate to the consumer." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oemd:sizeCodes oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Size codes are ordinary retail information printed on the label and shown at point of sale." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:gpcCategoryCode oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The GPC brick code is a standard product classification published with the GTIN in the GS1 registry (Verified by GS1)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:gpcCategoryDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The GPC category description is the human-readable form of the public GPC brick code." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:additionalProductClassification oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Additional classification codes categorise the product the same way the public GPC classification does." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# Public: consumer instructions, safety, warnings & support
# =============================================================================
# ESPR Art. 7(5)/Annex III squarely targets use, maintenance, and safety
# information at consumers and end users; withholding it would defeat the
# purpose of the data carrier.

gs1:consumerUsageInstructions oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Usage instructions are label-carried consumer information ESPR Annex III explicitly directs at customers." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:consumerSafetyInformation oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Safety information exists to protect the end user and must reach every anonymous scanner of the product." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:consumerStorageInstructions oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Storage instructions are normally held on the label or accompany the product, so they are already public consumer information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:consumerHandlingStorage oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The manufacturer's handling and storage recommendations are consumer use-and-maintenance information under ESPR Annex III." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:consumerPackageDisclaimer oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The package disclaimer is defined as information to be used in advertising and display, i.e. inherently public." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:warningCopyDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Warning copy reproduces caution information printed on the package and is critical consumer safety content." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:healthClaimDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Health claims are made to consumers under target-market regulations and must be as visible as the claim itself." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:instructionsForUse oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The instructions-for-use file is the document a consumer or repairer needs to use the product correctly (ESPR Annex III)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:manufacturersWarranty oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Guarantee and warranty terms are customer information ESPR Annex III expects to be available to product owners." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:isProductRecalled oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Recall status is critical public safety information that must reach every holder of the product without any login." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:customerSupportCentre oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The support-centre contact is printed on packaging precisely so any customer can reach product support." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:additive oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Additive details mirror ingredient information consumers already read on the label of the products concerned." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# Public: dates the consumer relies on
# =============================================================================
# These dates are printed on the package or encoded in the GS1 element
# strings on the label; the served document only repeats label content.

gs1:bestBeforeDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The best-before date is printed on the label or package by definition and consumers rely on it directly." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:expirationDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The expiration date limits safe consumption or use and is printed on the package for the consumer." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:expirationDateTime oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The expiration date-time is the finer-grained form of the on-package expiration date for short-life products." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:sellByDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The sell-by date is marked on retail packaging and lets the consumer judge product freshness at the shelf." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:harvestDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The harvest date is provenance information for fresh produce that supports the consumer's freshness and origin judgement." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:harvestDateStart oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The harvest start date bounds the same public provenance window as the harvest date itself." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:harvestDateEnd oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The harvest end date bounds the same public provenance window as the harvest date itself." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:packagingDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The packaging date is marked on packs (GS1 element strings) and informs the consumer's freshness judgement." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productionDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The production date is encodable in the GS1 element strings on the label, so the document repeats on-pack information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productionDateTime oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The production date-time is the finer-grained form of the on-pack production date, not production-process detail." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:firstFreezeDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The first-freeze date is food-quality information consumers use like a best-before date for frozen produce." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:dueDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The due date is encodable in the GS1 element string on the payment document itself, so the holder already sees it." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# Public: origin & provenance statements
# =============================================================================
# Origin declarations are consumer-facing claims (often mandatory on-label)
# and central to the sustainability transparency ESPR pursues.

gs1:countryOfOrigin oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Country of origin is a consumer-facing declaration frequently required on the label of the target market." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:countryOfOriginStatement oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The origin statement is the free-text form of the public country-of-origin declaration." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:countryOfAssembly oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Country of assembly is an origin fact at country granularity, revealing no supplier or facility identity." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:countryOfLastProcessing oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Country of last processing is origin information at country granularity, consistent with on-label origin marking." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:provenanceStatement oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The provenance statement is a marketing-grade origin description brands print on the product page and pack." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:growingMethod oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The growing method (e.g. organic, hydroponic) is a consumer-facing produce claim shown at point of sale." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:organicClaim oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Organic claims are regulated consumer-facing label claims and must be as visible as the label itself." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# Public: measurements, net content & packaging
# =============================================================================
# Net content and dimensions are on-label or point-of-sale facts (GS1
# Package Measurement Rules measurements describe the retail unit, not any
# production process).

gs1:netWeight oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Net weight is mandatory on-label net-quantity information for consumers." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:grossWeight oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Gross weight describes the packaged retail unit the consumer physically handles." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:netContent oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Net content is, per its GS1 definition, the quantity as claimed on the label." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:netArea oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Net area is a net-quantity measurement of the retail unit, equivalent to on-label content declarations." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:grossArea oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Gross area describes the packaged retail unit and carries no confidential content." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:grossVolume oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Gross volume describes the packaged retail unit and carries no confidential content." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:massPerUnitArea oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Mass per unit area (e.g. fabric grammage) is a physical product characteristic quoted in ordinary retail listings." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:inPackageDepth oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Packaged depth is a measurable fact about the retail unit shown in any product listing." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:inPackageDiameter oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Packaged diameter is a measurable fact about the retail unit shown in any product listing." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:inPackageHeight oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Packaged height is a measurable fact about the retail unit shown in any product listing." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:inPackageWidth oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Packaged width is a measurable fact about the retail unit shown in any product listing." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:outOfPackageDepth oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Unpackaged depth is measurable by anyone holding the product and helps consumers judge fit before purchase." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:outOfPackageDiameter oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Unpackaged diameter is measurable by anyone holding the product and helps consumers judge fit before purchase." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:outOfPackageHeight oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Unpackaged height is measurable by anyone holding the product and helps consumers judge fit before purchase." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:outOfPackageWidth oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Unpackaged width is measurable by anyone holding the product and helps consumers judge fit before purchase." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:packaging oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Packaging type and material details are consumer-relevant circularity information ESPR Annex I makes central to the passport." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# Public: marketing, sustainability, media, certifications & accreditations
# =============================================================================
# Content the brand itself publishes to consumers, plus third-party marks
# consumers must be able to verify.

gs1:productMarketingMessage oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The marketing message is authored for consumer display and is public by intent." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productFeatureBenefit oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Feature-benefit copy is, per its GS1 definition, consumer-facing marketing content suitable for display." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productSustainabilityInfo oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Sustainability information is exactly the consumer transparency ESPR exists to deliver through the data carrier." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:includedAccessories oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Included accessories are box-contents information every retail listing and package already states." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:awardPrize oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Awards and prizes are promotional facts the brand itself publicises on pack and product page." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:certification oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Certification claims must be publicly verifiable by the consumers and market-surveillance actors they are addressed to." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:packagingMarkedLabelAccreditation oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Accreditation marks are printed on the packaging by definition, so the field only mirrors the label." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:audioFile oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Product audio clips are published brand media intended for consumer consumption." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oemd:images oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Product images are the published visual identity of the product shown in every listing." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:referencedFile oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Referenced files are links to additional product information the brand publishes for its audience." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# Public: product relations, authenticity & market data
# =============================================================================
# Substitution and succession links help consumers find spare, replacement,
# and compatible products (ESPR circularity goals); authenticity features
# only work if the checking public can read them.

gs1:equivalentProduct oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Supplier-declared substitutes help consumers find an equivalent product and are ordinary catalogue information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:dependentProprietaryProduct oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Products required to make this one functional are compatibility information a purchaser needs before and after buying." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:replacedByProduct oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The successor-product link routes owners of a discontinued item to its replacement — public catalogue succession." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:replacedProduct oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The predecessor-product link is the public catalogue history of what this product permanently replaces." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:primaryAlternateProduct oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The primary alternate is a similar-product suggestion of the same public catalogue nature as equivalent products." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:authenticity oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Authenticity-checking details only fulfil their purpose if the consumer verifying a product instance can read them." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:targetMarket oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Target-market countries and release dates are public availability information visible from where the product is sold." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# Public: item-level identifiers carried in the Digital Link path
# =============================================================================
# Batch/lot and serial numbers are printed on the physical label and are
# frequently part of the GS1 Digital Link URI the consumer scans, so gating
# them in the response would hide what the requester already presented.

gs1:hasBatchLotNumber oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The batch/lot number is printed on the label and appears in the GS1 Digital Link path the scanner itself resolved." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:hasSerialNumber oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The serial number is marked on the item and appears in the GS1 Digital Link path the scanner itself resolved." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# Public: organization & place identity (GS1 registry facts)
# =============================================================================
# GLNs and the party/place identity behind them are published registry data
# (Verified by GS1); the resolver adds nothing beyond what the registry
# already discloses about a business site or legal entity.

gs1:globalLocationNumber oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The GLN is the public GS1 identification key for the party or location and is discoverable in the GS1 registry." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:locationGLN oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The location GLN is the public registry key of the physical or digital location being described." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:partyGLN oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The party GLN is the public registry key of the legal entity or function being described." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:glnType oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The GLN type only says what kind of thing the public GLN identifies and is needed to interpret it." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:organizationName oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The organization name is the public legal-entity identity behind the GLN, published via Verified by GS1." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:physicalLocationName oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The name of a physical business site is public registry identity, typically also signposted at the site itself." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:digitalLocationName oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The name of a digital place (e.g. a webshop) identifies a publicly reachable endpoint." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:address oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The postal address of a registered business party or site is public registry and business-directory information." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:digitalAddress oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The digital address points at a publicly reachable digital location and reveals nothing beyond that endpoint." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:contactPoint oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Published contact points are how the organization asks to be reached and are ordinary business-directory content." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:organizationRole oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The declared role of a party (e.g. manufacturer, retailer) is coarse registry classification with no commercial detail." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:locationRole oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The location role classifies what kind of site a place is — coarse registry classification, not operational detail." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:relatedOrganization oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The organization associated with a place is the public operator identity a visitor to the site can observe." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:parentOrganization oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The parent legal entity is corporate-structure information disclosed in public company registers." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:subOrganization oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Subsidiary legal entities are corporate-structure information disclosed in public company registers." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:replacedByOrganization oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The successor-organization link keeps the public registry record resolvable after a party is superseded." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:replacedOrganization oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The predecessor-organization link is public registry succession history for the party identifier." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:replacedByPlace oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The successor-location link keeps the public registry record resolvable after a location is superseded." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:replacedPlace oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The predecessor-location link is public registry succession history for the location identifier." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:hasPrimaryLocation oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "An organization's self-designated primary location is headline registry identity, like a head-office address." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
gs1:location oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The places associated with an organization are its public registry footprint of identified sites." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
oemd:geoCoordinates oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Coordinates of a GLN-identified business site restate the public location of that site per the GS1 registry (unlike a product's manufacturingPlant link, this describes the place entity itself)." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .
oemd:geoShape oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The boundary shape of a GLN-identified site is the same public site-location fact as its coordinates." ;
    oec:accessLevelSource <https://ref.gs1.org/voc/> .


# =============================================================================
# AuthorizedOnly: production network & B2B product detail
# =============================================================================
# Facility-level production detail is professional-audience information; the
# Battery Regulation precedent keeps manufacturing-facility detail out of
# the public passport part, and ESPR Art. 9 tiering exists to protect
# exactly this class of commercially sensitive supply-chain data.

gs1:manufacturer oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The producing organization behind a brand is supply-chain sourcing detail; consumers see the brand owner, while manufacturer identity serves authorities and B2B partners." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:manufacturingPlant oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Linking a product to its production facility exposes the manufacturer's production network, which the battery-passport precedent keeps non-public." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productionVariantDescription oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Production variants are manufacturer bookkeeping about production runs, not information addressed to the consumer." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:productionVariantEffectiveDateTime oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The effective date of a production variant is production bookkeeping tied to the non-public variant record." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:hasThirdPartyControlledSerialNumber oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "A third-party-controlled serial number belongs to an external identification scheme for professional traceability, unlike the on-label GS1 serial." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:supplierSpecifiedMinimumConsumerStorageDays oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The supplier-specified minimum storage-days figure steers retail shelf-life logistics between trading partners; the consumer relies on the printed dates instead." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# AuthorizedOnly: internal identifier schemes & operational contact detail
# =============================================================================
# Secondary identifier schemes and internal operational contacts serve
# administrative B2B and authority workflows, not the anonymous consumer.

gs1:additionalLocationID oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Secondary location identifiers from government or trade schemes serve administrative cross-referencing, not consumer information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:additionalOrganizationID oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Secondary party identifiers (tax, customs, trade-body numbers) are administrative identifiers for authorities and B2B partners." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:additionalOrganizationIdentificationTypeValue oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "This value qualifies the non-public additional organization identifier and shares its administrative audience." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:department oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Internal department structure is organizational detail relevant to business partners, not to a consumer scanning a product." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:afterHoursContact oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "After-hours contacts are operational emergency channels for partners and authorities, distinct from the published consumer contact point." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:baseLocation oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The home base of a mobile asset is logistics-network detail with no consumer-information function." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:makesOffer oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Offers attached to a party record are commercial trading terms between businesses, not product information for the end user." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .


# =============================================================================
# AuthorizedOnly: ownership, lease & management relation graph; history
# =============================================================================
# Who owns, leases, manages, or occupies which site maps commercial
# relationships between companies — the class of confidential business
# information ESPR's tiered-access design shields from anonymous readers.

gs1:ownedBy oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Ownership of a site maps commercial relationships and asset holdings beyond the public registry identity of the place." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:owns oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "An organization's owned places and entities enumerate its asset portfolio — commercial detail, not consumer information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:leasedFrom oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Lessor identity discloses a commercial lease relationship between businesses." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:leasedTo oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Lessee identity discloses a commercial lease relationship between businesses." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:lessorFor oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The set of places an organization leases out maps its property dealings — commercial-relations data." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:lesseeOf oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The set of places an organization leases in maps its property dealings — commercial-relations data." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:managedBy oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The managing organization behind a site or party discloses an outsourcing/management contract between businesses." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:managedFor oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Whose behalf a place is managed on discloses the same commercial management relationship as managedBy." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:manages oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The portfolio of places and parties an organization manages enumerates its service contracts — commercial-relations data." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:usesManagedLocation oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Which managed spaces an organization uses reveals its operational footprint and supplier relationships." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:occupies oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The full list of places an organization occupies is operational-footprint detail beyond its public primary location." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:occupiedBy oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The tenant list of a site maps commercial occupancy relationships beyond the public operator identity." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:responsibleForLocation oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The places an organization is responsible for map internal accountability across the site network — B2B operational structure." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:responsibleOrganization oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The organization directly responsible for a place is internal accountability structure, distinct from the public operator identity." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:primaryLocationOf oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The reverse index of every organization headquartered at a place aggregates tenancy relationships beyond any single party's public record." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:locationHistory oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Activation/deactivation history of a location is registry lifecycle bookkeeping for data managers, not consumer information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
gs1:organizationHistory oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Activation/deactivation history of a party record is registry lifecycle bookkeeping for data managers, not consumer information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
