bat-extinguisher-classes:ClassA a skos:Concept, owl:NamedIndividual;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en;
    rdfs:label "Extinguisher class A"@en;
    skos:definition "Fires involving combustible solids. Same scope in EN 2:2005 and in NFPA 10."@en;
    skos:inScheme bat-extinguisher-classes:ExtinguisherClassScheme;
    skos:notation "A";
    skos:prefLabel "Extinguisher class A"@en;
    skos:topConceptOf bat-extinguisher-classes:ExtinguisherClassScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes>.
bat-extinguisher-classes:ClassB a skos:Concept, owl:NamedIndividual;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en;
    rdfs:label "Extinguisher class B"@en;
    skos:definition "Fires involving flammable liquids or liquefiable solids. Same scope in EN 2:2005 and in NFPA 10."@en;
    skos:inScheme bat-extinguisher-classes:ExtinguisherClassScheme;
    skos:notation "B";
    skos:prefLabel "Extinguisher class B"@en;
    skos:topConceptOf bat-extinguisher-classes:ExtinguisherClassScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes>.
bat-extinguisher-classes:ClassC a skos:Concept, owl:NamedIndividual;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en;
    rdfs:label "Extinguisher class C"@en;
    skos:definition "Fires involving flammable gases, per EN 2:2005."@en;
    skos:editorialNote "Mapping trap. Under NFPA 10 the same letter denotes fires involving energised electrical equipment. The two readings are not interchangeable, so a value of C taken from a US-sourced data set must not be carried across unchecked."@en;
    skos:inScheme bat-extinguisher-classes:ExtinguisherClassScheme;
    skos:notation "C";
    skos:prefLabel "Extinguisher class C"@en;
    skos:topConceptOf bat-extinguisher-classes:ExtinguisherClassScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes>.
bat-extinguisher-classes:ClassD a skos:Concept, owl:NamedIndividual;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en;
    rdfs:label "Extinguisher class D"@en;
    skos:definition "Fires involving combustible metals. Same scope in EN 2:2005 and in NFPA 10; the class most likely to be relevant to lithium battery cells."@en;
    skos:inScheme bat-extinguisher-classes:ExtinguisherClassScheme;
    skos:notation "D";
    skos:prefLabel "Extinguisher class D"@en;
    skos:topConceptOf bat-extinguisher-classes:ExtinguisherClassScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes>.
bat-extinguisher-classes:ClassF a skos:Concept, owl:NamedIndividual;
    dcterms:references "EN 2:2005, Classification of fires; Spherity Battery Pass ontology v0.1, extinguishingAgent"@en;
    rdfs:label "Extinguisher class F"@en;
    skos:altLabel "K (NFPA 10)"@en;
    skos:definition "Fires involving cooking media (vegetable or animal oils and fats), per EN 2:2005."@en;
    skos:editorialNote "Renamed from batext:ClassK on 26 August 2026, when EN 2:2005 was settled as the reference standard in issue #8. Renamed outright rather than deprecated: the namespace has never been published under w3id.org."@en;
    skos:inScheme bat-extinguisher-classes:ExtinguisherClassScheme;
    skos:notation "F";
    skos:prefLabel "Extinguisher class F"@en;
    skos:scopeNote "EN 2:2005 class F and NFPA 10 (US) class K have the same scope. The US letter is kept as skos:altLabel so that data sourced from NFPA 10, such as the Spherity Battery Pass ontology v0.1, still maps onto this concept."@en;
    skos:topConceptOf bat-extinguisher-classes:ExtinguisherClassScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes>.
bat-locations:Anode a skos:Concept, bat-materials:BatteryLocation, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41"@en;
    rdfs:label "Anode"@en;
    skos:inScheme bat-locations:BatteryLocationScheme;
    skos:notation "anode";
    skos:prefLabel "Anode"@en;
    skos:topConceptOf bat-locations:BatteryLocationScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-locations>.
bat-locations:BatteryLocationScheme a skos:ConceptScheme, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41"@en;
    rdfs:label "Battery locations per Annex XIII 2(a)"@en;
    skos:hasTopConcept bat-locations:Anode, bat-locations:Cathode, bat-locations:Electrolyte;
    skos:prefLabel "Battery locations per Annex XIII 2(a)"@en;
    skos:scopeNote "The three locations named by Regulation (EU) 2023/1542, Annex XIII 2(a). The Regulation names them without defining them, so no definition is asserted here. Access to the detailed composition is restricted to notified bodies, market surveillance authorities and the Commission; per the tier-free convention of this ontology, that restriction is expressed in the SHACL layer, not here."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-locations>.
bat-locations:Cathode a skos:Concept, bat-materials:BatteryLocation, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41"@en;
    rdfs:label "Cathode"@en;
    skos:inScheme bat-locations:BatteryLocationScheme;
    skos:notation "cathode";
    skos:prefLabel "Cathode"@en;
    skos:topConceptOf bat-locations:BatteryLocationScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-locations>.
bat-locations:Electrolyte a skos:Concept, bat-materials:BatteryLocation, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41"@en;
    rdfs:label "Electrolyte"@en;
    skos:inScheme bat-locations:BatteryLocationScheme;
    skos:notation "electrolyte";
    skos:prefLabel "Electrolyte"@en;
    skos:topConceptOf bat-locations:BatteryLocationScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-locations>.
bat-metals:BatteryMetalScheme a skos:ConceptScheme, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1)"@en;
    rdfs:label "Battery metals subject to recycled content declaration, Art. 8(1)"@en;
    skos:hasTopConcept bat-metals:Cobalt, bat-metals:Lead, bat-metals:Lithium, bat-metals:Nickel;
    skos:prefLabel "Battery metals subject to recycled content declaration, Art. 8(1)"@en;
    skos:scopeNote "Art. 8(1) does not treat the four metals alike. For cobalt, lithium and nickel it asks for the share present in ACTIVE MATERIALS and recovered from battery manufacturing waste or post-consumer waste; for lead it asks for the share present in THE BATTERY and recovered from waste. The distinction is recorded on each concept and is not expressible in the CORE today."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals>.
bat-metals:Cobalt a skos:Concept, eudpp:MaterialType, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 49 and 52"@en;
    rdfs:label "Cobalt"@en;
    skos:altLabel "Co"@en;
    skos:inScheme bat-metals:BatteryMetalScheme;
    skos:notation "Co";
    skos:prefLabel "Cobalt"@en;
    skos:scopeNote "Recycled share is measured on the cobalt present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 49 and 52."@en;
    skos:topConceptOf bat-metals:BatteryMetalScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals>.
bat-metals:Lead a skos:Concept, eudpp:MaterialType, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attribute 54"@en;
    rdfs:label "Lead"@en;
    skos:altLabel "Pb"@en;
    skos:editorialNote "Not to be confused with batchem:Pb, the lead-acid CELL CHEMISTRY of battery-chemistries. This concept is the METAL whose recycled content is declared. Different namespaces, different meanings."@en;
    skos:inScheme bat-metals:BatteryMetalScheme;
    skos:notation "Pb";
    skos:prefLabel "Lead"@en;
    skos:scopeNote "Lead is the exception in Art. 8(1): the recycled share is measured on the lead present in THE BATTERY, not in active materials, and recovered from waste without the manufacturing / post-consumer split. Long list attribute 54, which has no pre- and post-consumer counterpart."@en;
    skos:topConceptOf bat-metals:BatteryMetalScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals>.
bat-metals:Lithium a skos:Concept, eudpp:MaterialType, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 50 and 53"@en;
    rdfs:label "Lithium"@en;
    skos:altLabel "Li"@en;
    skos:inScheme bat-metals:BatteryMetalScheme;
    skos:notation "Li";
    skos:prefLabel "Lithium"@en;
    skos:scopeNote "Recycled share is measured on the lithium present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 50 and 53."@en;
    skos:topConceptOf bat-metals:BatteryMetalScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals>.
bat-metals:Nickel a skos:Concept, eudpp:MaterialType, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 48 and 51"@en;
    rdfs:label "Nickel"@en;
    skos:altLabel "Ni"@en;
    skos:inScheme bat-metals:BatteryMetalScheme;
    skos:notation "Ni";
    skos:prefLabel "Nickel"@en;
    skos:scopeNote "Recycled share is measured on the nickel present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 48 and 51."@en;
    skos:topConceptOf bat-metals:BatteryMetalScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-metals>.
bat-statuses:Original a skos:Concept, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en;
    rdfs:label "Original"@en;
    skos:definition "The battery is in its first life, as placed on the market by the manufacturer, and has not been subjected to re-use, repurposing or remanufacturing."@en;
    skos:inScheme bat-statuses:BatteryStatusScheme;
    skos:notation "original";
    skos:prefLabel "Original"@en;
    skos:topConceptOf bat-statuses:BatteryStatusScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses>.
bat-statuses:ReUsed a skos:Concept, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en;
    rdfs:label "Re-used"@en;
    skos:altLabel "reused"@en;
    skos:definition "The battery has been subjected to a treatment operation preparing it for re-use and placed on the market again for the purpose it was originally designed for."@en;
    skos:inScheme bat-statuses:BatteryStatusScheme;
    skos:notation "re-used";
    skos:prefLabel "Re-used"@en;
    skos:scopeNote "A repaired battery is recorded under this status, with the repair itself made transparent through the repair history. The history belongs to the CORE event module (dpp:RepairEvent); no 'repaired' status is declared here."@en;
    skos:topConceptOf bat-statuses:BatteryStatusScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses>.
bat-statuses:Remanufactured a skos:Concept, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en;
    rdfs:label "Remanufactured"@en;
    skos:definition "The battery has been subjected to remanufacturing and placed on the market again."@en;
    skos:editorialNote "Remanufacturing is an ESPR-wide notion, not a battery-specific one. This is the concept most likely to move to the CORE if a generic product status is introduced."@en;
    skos:inScheme bat-statuses:BatteryStatusScheme;
    skos:notation "remanufactured";
    skos:prefLabel "Remanufactured"@en;
    skos:topConceptOf bat-statuses:BatteryStatusScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses>.
bat-statuses:Repurposed a skos:Concept, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en;
    rdfs:label "Repurposed"@en;
    skos:definition "The battery has been subjected to repurposing and placed on the market again for a purpose or application other than the one it was originally designed for."@en;
    skos:editorialNote "The definition of 'repurposing' is in Art. 3(1) of Regulation (EU) 2023/1542; the point number is to be confirmed against the consolidated text."@en;
    skos:inScheme bat-statuses:BatteryStatusScheme;
    skos:notation "repurposed";
    skos:prefLabel "Repurposed"@en;
    skos:topConceptOf bat-statuses:BatteryStatusScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses>.
bat-statuses:Waste a skos:Concept, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Annex XIII 4(c)"@en;
    rdfs:label "Waste"@en;
    skos:definition "The battery is a waste battery: it is discarded or intended to be discarded, and is no longer placed on the market as a battery."@en;
    skos:inScheme bat-statuses:BatteryStatusScheme;
    skos:notation "waste";
    skos:prefLabel "Waste"@en;
    skos:scopeNote "Reaching this status does not by itself deactivate the passport. Passport deactivation is a property of the digital resource, carried by dpp:dppStatus on dpp:DPP."@en;
    skos:topConceptOf bat-statuses:BatteryStatusScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-statuses>.
