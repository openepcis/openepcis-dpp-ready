    skos:prefLabel "Lithium ion LFP"@en;
    skos:topConceptOf bat-chemistries:BatteryChemistryScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-chemistries>.
bat-chemistries:LiIonLMO a skos:Concept, eudpp:MaterialType, owl:NamedIndividual;
