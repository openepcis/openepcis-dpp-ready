    skos:prefLabel "Lithium ion LMO"@en;
    skos:topConceptOf bat-chemistries:BatteryChemistryScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-chemistries>.
bat-chemistries:LiIonNCA a skos:Concept, eudpp:MaterialType, owl:NamedIndividual;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 39"@en;
    rdfs:label "Lithium ion NCA"@en;
    skos:altLabel "Li-ion NCA"@en, "Lithium nickel cobalt aluminium oxide"@en;
    skos:inScheme bat-chemistries:BatteryChemistryScheme;
    skos:notation "Li-ion NCA";
    skos:prefLabel "Lithium ion NCA"@en;
    skos:topConceptOf bat-chemistries:BatteryChemistryScheme;
