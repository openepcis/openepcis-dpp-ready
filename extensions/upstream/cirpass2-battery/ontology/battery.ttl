bat-categories:BatteryCategoryScheme a skos:ConceptScheme, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 3(1)"@en;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj>;
    rdfs:label "Battery categories per Regulation (EU) 2023/1542, Art. 3(1)"@en;
    skos:hasTopConcept bat-categories:ElectricVehicleBattery, bat-categories:IndustrialBattery, bat-categories:LMTBattery, bat-categories:PortableBattery, bat-categories:SLIBattery;
    skos:prefLabel "Battery categories per Regulation (EU) 2023/1542, Art. 3(1)"@en;
    skos:scopeNote "Battery passport scope (Art. 77): LMT, industrial above 2 kWh and electric vehicle batteries are in scope; portable and SLI batteries are not."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-categories>.
bat-categories:ElectricVehicleBattery a skos:Concept, eudpp:ClassificationCode, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 3(1)(14)"@en;
    rdfs:label "Electric vehicle battery"@en;
    skos:altLabel "EV battery"@en;
    skos:definition "a battery that is specifically designed to provide electric power for traction in hybrid or electric vehicles of category L as provided for in Regulation (EU) No 168/2013, that weighs more than 25 kg, or a battery that is specifically designed to provide electric power for traction in hybrid or electric vehicles of categories M, N or O as provided for in Regulation (EU) 2018/858"@en;
    skos:inScheme bat-categories:BatteryCategoryScheme;
    skos:notation "EV";
    skos:prefLabel "Electric vehicle battery"@en;
    skos:scopeNote "In scope of the battery passport."@en;
    skos:topConceptOf bat-categories:BatteryCategoryScheme;
    eudpp:codeSet "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"^^xsd:anyURI;
    eudpp:codeValue "EV";
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-categories>.
bat-categories:IndustrialBattery a skos:Concept, eudpp:ClassificationCode, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 3(1)(13)"@en;
    rdfs:label "Industrial battery"@en;
    skos:definition "a battery that is specifically designed for industrial uses, intended for industrial uses after having been subject to preparation for repurposing or repurposing, or any other battery that weighs more than 5 kg and that is neither an electric vehicle battery, an LMT battery, nor an SLI battery"@en;
    skos:inScheme bat-categories:BatteryCategoryScheme;
    skos:notation "industrial";
    skos:prefLabel "Industrial battery"@en;
    skos:scopeNote "In scope of the battery passport above 2 kWh."@en;
    skos:topConceptOf bat-categories:BatteryCategoryScheme;
    eudpp:codeSet "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"^^xsd:anyURI;
    eudpp:codeValue "industrial";
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-categories>.
bat-categories:LMTBattery a skos:Concept, eudpp:ClassificationCode, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 3(1)(11)"@en;
    rdfs:label "Light means of transport battery"@en;
    skos:altLabel "LMT battery"@en;
    skos:definition "a battery that is sealed, weighs 25 kg or less and is specifically designed to provide electric power for the traction of wheeled vehicles that can be powered by an electric motor alone or by a combination of motor and human power, including type-approved vehicles of category L within the meaning of Regulation (EU) No 168/2013 of the European Parliament and of the Council, and that is not an electric vehicle battery"@en;
    skos:inScheme bat-categories:BatteryCategoryScheme;
    skos:notation "LMT";
    skos:prefLabel "Light means of transport battery"@en;
    skos:scopeNote "In scope of the battery passport."@en;
    skos:topConceptOf bat-categories:BatteryCategoryScheme;
    eudpp:codeSet "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"^^xsd:anyURI;
    eudpp:codeValue "LMT";
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-categories>.
bat-categories:PortableBattery a skos:Concept, eudpp:ClassificationCode, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 3(1)(9)"@en;
    rdfs:label "Portable battery"@en;
    skos:definition "a battery that is sealed, weighs 5 kg or less, is not designed specifically for industrial use and is neither an electric vehicle battery, an LMT battery, nor an SLI battery"@en;
    skos:inScheme bat-categories:BatteryCategoryScheme;
    skos:notation "portable";
    skos:prefLabel "Portable battery"@en;
    skos:scopeNote "Out of scope of the battery passport."@en;
    skos:topConceptOf bat-categories:BatteryCategoryScheme;
    eudpp:codeSet "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"^^xsd:anyURI;
    eudpp:codeValue "portable";
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-categories>.
bat-categories:SLIBattery a skos:Concept, eudpp:ClassificationCode, owl:NamedIndividual;
    dcterms:references "Regulation (EU) 2023/1542, Art. 3(1)(12)"@en;
    rdfs:label "Starting, lighting and ignition battery"@en;
    skos:altLabel "SLI battery"@en;
    skos:definition "a battery that is specifically designed to supply electric power for starting, lighting, or ignition and that can also be used for auxiliary or backup purposes in vehicles, other means of transport or machinery"@en;
    skos:inScheme bat-categories:BatteryCategoryScheme;
    skos:notation "SLI";
    skos:prefLabel "Starting, lighting and ignition battery"@en;
    skos:scopeNote "Out of scope of the battery passport."@en;
    skos:topConceptOf bat-categories:BatteryCategoryScheme;
    eudpp:codeSet "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"^^xsd:anyURI;
    eudpp:codeValue "SLI";
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-categories>.
bat-chemistries:BatteryChemistryScheme a skos:ConceptScheme, owl:NamedIndividual;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 39"@en;
    dcterms:source "Draft Implementing Act on the harmonised format and technical specifications for the labelling of batteries, under Regulation (EU) 2023/1542, Annex VI Part A (7). Not yet adopted; the ten terms of this scheme are the draft ones."@en;
    rdfs:label "Battery chemistries per the draft labelling Implementing Act"@en;
    skos:editorialNote "Re-check flag. The Implementing Act is still a draft: the ten terms and their notations are to be re-checked on adoption. CIRPASS-2/ontologies-core#25 introduces eudpp:materialTypeScheme on the MAT material type; once it exists, the ten individuals are to carry it, pointing at batchem:BatteryChemistryScheme, so that the CORE mechanism and SKOS both carry the value."@en;
    skos:hasTopConcept bat-chemistries:LiIonLCO, bat-chemistries:LiIonLFP, bat-chemistries:LiIonLMO, bat-chemistries:LiIonNCA, bat-chemistries:LiIonNMC, bat-chemistries:LiMetal, bat-chemistries:NaIon, bat-chemistries:NiCd, bat-chemistries:NiMH, bat-chemistries:Pb;
    skos:prefLabel "Battery chemistries per the draft labelling Implementing Act"@en;
    skos:scopeNote "Closed list of ten terms. For secondary (rechargeable) batteries whose electrochemical composition does not correspond to any of these, the composition shall be indicated based on the molecular formula of the cathode and/or anode — that fallback is not a concept of this scheme and is to be handled by the SHACL shapes."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-chemistries>.
bat-chemistries:LiIonLCO a skos:Concept, eudpp:MaterialType, owl:NamedIndividual;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 39"@en;
    rdfs:label "Lithium ion LCO"@en;
    skos:altLabel "Li-ion LCO"@en, "Lithium cobalt oxide"@en;
    skos:inScheme bat-chemistries:BatteryChemistryScheme;
    skos:notation "Li-ion LCO";
    skos:prefLabel "Lithium ion LCO"@en;
    skos:topConceptOf bat-chemistries:BatteryChemistryScheme;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-chemistries>.
bat-chemistries:LiIonLFP a skos:Concept, eudpp:MaterialType, owl:NamedIndividual;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 39"@en;
    rdfs:label "Lithium ion LFP"@en;
