txt-durability:Durability a owl:Class;
    rdfs:label "Durability"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Through the alignment txtdur:Durability rdfs:subClassOf dpp:Durability, this class inherits dpp:QualityIndicator and dpp:QuantitativeProperty. This is an inherited EU DPP Core commitment: it does not make a durability instance a numeric value. Numerical observations and results remain represented through Textile Assessment and txtcon:QuantitativeValue."@en;
    txt-connector:sourceLocator "JRC Annex 13.10.1, printed page 468, lines 11065-11067."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf <https://w3id.org/eudpp#Durability>.
