    rdfs:comment "Recycling process in which thermoplastic textile polymers are remelted or otherwise thermally and mechanically reprocessed into granulate or fibre material."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:sourceLocator "JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-process:RecyclingProcess.
txt-process:TwistLevel a owl:Class;
    rdfs:label "Twist level"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Spinning parameter describing the degree or level of twist inserted into a yarn."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:modellingNote "Twist level may enhance yarn tenacity and pilling resistance, diminish yarn softness and elasticity, and increase spirality. Yarn strength increases with twist to a peak and may then decrease."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-durability:PillingResistance, txt-structure:YarnStrength, txt-structure:YarnSoftness, txt-structure:YarnElasticity;
    rdfs:subClassOf txt-process:SpinningParameter.
txt-structure:YarnElasticity a owl:Class;
    rdfs:label "Yarn elasticity"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence, txt-connector:stronglyImpliedEvidence;
    rdfs:comment "Yarn mechanical characteristic concerning the ability of yarn to deform and recover."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Reconstructed concept added to support process-related relations such as the effect of twist level on yarn elasticity."@en, "Yarn elasticity may influence wrinkling and recovery behaviour, but the relation is mediated by fabric structure and garment construction."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-durability:Wrinkling;
    rdfs:subClassOf txt-structure:YarnMechanicalCharacteristic.
txt-process:TwistNumber a owl:Class;
    rdfs:label "Twist number"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Spinning parameter describing the number of twists inserted into a yarn."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:modellingNote "The number of twists is treated as a process parameter closely related to twist level. Its effects are context-dependent and mediated by fibre characteristics."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:YarnStrength, txt-structure:YarnSoftness;
    rdfs:subClassOf txt-process:SpinningParameter.
txt-process:UseWearProcess a owl:Class;
