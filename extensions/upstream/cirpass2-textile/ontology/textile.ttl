    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence, txt-connector:explicitEvidence;
    rdfs:comment "Use-phase or care-related process involving storage of a textile product under specified or unspecified conditions."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:modellingNote "Storage conditions such as excessive humidity or direct sunlight may affect textile durability. Detailed environmental conditions are represented in the Textile Context module."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-durability:ColourFastness, txt-durability:FabricBreakdown;
