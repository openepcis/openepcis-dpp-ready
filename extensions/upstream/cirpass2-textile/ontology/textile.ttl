txt-structure:TextileStructureCharacteristic a owl:Class;
    rdfs:label "Textile structure characteristic"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "A property describing the structure, physical constitution, mechanical behaviour, tactile quality, visual quality or functional behaviour of a textile fibre, yarn, fabric or assembly."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Structural superclass introduced to organise the module; not necessarily a verbatim JRC term."@en, "Modelled as a subclass of dpp:Property because instances are linked from products through a subproperty of dpp:hasProperty."@en, "Structural characteristics are disjoint from observed performance parameters, degradation phenomena and failure modes. For example, pilling resistance is a structure/resistance characteristic, while pilling is an observed degradation phenomenon."@en, "This is the top-level class for structural characteristics in the textile structure module. It should not be used for observed durability performance parameters themselves."@en;
    txt-connector:sourceLocator "JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf <https://w3id.org/eudpp#Property>.
