txt-repairability:Repairability a owl:Class;
    rdfs:label "Repairability"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Ability of a defective product or waste object to return, through one or more actions, to a condition in which it fulfils its intended use. For textile apparel, user acceptance of restored functionality and potentially changed aesthetics is contextually relevant."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability>;
    txt-connector:modellingNote "Repair may extend product use, but the outcome depends on failure type, service availability, cost, user acceptance and the effectiveness of the intervention; no deterministic inference is asserted."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicallyContributesTo txt-durability:Durability;
    rdfs:subClassOf txt-repairability:LifeExtensionInterventionAspect.
