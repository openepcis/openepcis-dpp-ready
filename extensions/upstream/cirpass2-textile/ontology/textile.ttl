    skos:prefLabel "Post-consumer textile waste"@en;
    skos:topConceptOf txt-recyclability:TextileWasteSourceScheme;
    rdfs:comment "Textile product discarded after consumption and use by citizens or by end users in commercial or industrial activities."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability>;
