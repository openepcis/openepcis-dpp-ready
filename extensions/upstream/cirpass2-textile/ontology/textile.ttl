txt-durability:hasDegradationExpression a owl:ObjectProperty;
    rdfs:label "has degradation expression"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Relates a durability-related performance characteristic to a degradation phenomenon that expresses deterioration of that characteristic. This is an instance-level relation and is not a deterministic causal axiom."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:range txt-durability:ObservedDegradationPhenomenon;
    rdfs:domain txt-durability:ObservedPerformanceParameter.
txt-durability:ObservedDegradationPhenomenon a owl:Class;
    rdfs:label "Observed degradation phenomenon"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Observable phenomenon indicating physical deterioration of a textile material or product. It is distinct from the performance characteristic used to assess resistance to that deterioration."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction.
