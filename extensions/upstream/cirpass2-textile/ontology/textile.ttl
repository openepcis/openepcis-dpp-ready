skos:Concept a owl:Class.
txt-connector:typicalInfluenceOn a owl:AnnotationProperty;
    rdfs:label "typical influence on"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Weak annotation relation indicating that a source concept, parameter, process, context factor or structural characteristic typically influences a target concept, without asserting a deterministic or universally valid causal relation."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:modellingNote "Use this property for cross-module class-level or concept-level links such as process parameter to structural characteristic, structure to durability, or context factor to durability. It is intentionally an annotation property to avoid strong OWL inferences over classes."@en;
    txt-connector:sourceLocator "docs/decisions/TXT-DEC-006.md"@en;
    txt-connector:sourceType txt-connector:projectDecision.
txt-connector:typicallyContributesTo a owl:AnnotationProperty;
    rdfs:label "typically contributes to"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Weak annotation relation indicating that a source entity typically contributes to, supports or participates in the realisation of a target characteristic, performance aspect or outcome."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:modellingNote "This is a specialised form of typical influence. It should not be interpreted as a necessary or sufficient condition."@en;
    txt-connector:sourceLocator "docs/decisions/TXT-DEC-006.md"@en;
    txt-connector:sourceType txt-connector:projectDecision;
    rdfs:subPropertyOf txt-connector:typicalInfluenceOn.
txt-connector:typicallyIncreasesLikelihoodOf a owl:AnnotationProperty;
    rdfs:label "typically increases likelihood of"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Weak annotation relation indicating that a source entity typically increases the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:modellingNote "This property is appropriate for risk-like links, for example context or use factors increasing the likelihood of a durability failure mode."@en;
    txt-connector:sourceLocator "docs/decisions/TXT-DEC-006.md"@en;
    txt-connector:sourceType txt-connector:projectDecision;
    rdfs:subPropertyOf txt-connector:typicalInfluenceOn.
txt-connector:typicallyReducesLikelihoodOf a owl:AnnotationProperty;
    rdfs:label "typically reduces likelihood of"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Weak annotation relation indicating that a source entity typically reduces the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:modellingNote "This property is appropriate for protective or mitigating links. It should not be interpreted as a guarantee of prevention."@en;
    txt-connector:sourceLocator "docs/decisions/TXT-DEC-006.md"@en;
    txt-connector:sourceType txt-connector:projectDecision;
    rdfs:subPropertyOf txt-connector:typicalInfluenceOn.
txt-context:typicallyQualifiesProcess a owl:AnnotationProperty;
    rdfs:label "typically qualifies process"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Weak annotation relation indicating that a context factor typically qualifies the interpretation, applicability or expected effect of a textile process type."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:projectDecision.
txt-core:defaultStudyScopeStatus a owl:AnnotationProperty;
    rdfs:label "default study scope status"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Annotation property used on product-type classes to document their default status with respect to a study or regulatory modelling scope."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core>;
    txt-connector:modellingNote "This is an annotation-level modelling aid for product types. Instance-level scope status, if needed, should be represented with a data validation pattern or a dedicated object property in a context module."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction.
txt-connector:modellingAbstraction a skos:Concept, owl:NamedIndividual;
    rdfs:label "Modelling abstraction"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    skos:inScheme txt-connector:SourceTypeScheme;
    skos:prefLabel "Modelling abstraction"@en;
    skos:topConceptOf txt-connector:SourceTypeScheme;
    rdfs:comment "The ontology introduces a structure needed to represent source information correctly."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:projectDecision.
txt-core:jrcExclusionReason a owl:AnnotationProperty;
    rdfs:label "JRC exclusion reason"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Annotation specifying the reason why a textile product class or category is excluded from the JRC preparatory study scope."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:range xsd:string.
txt-core:jrcScopeCondition a owl:AnnotationProperty;
    rdfs:label "JRC scope condition"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Annotation specifying a textual condition governing inclusion of a textile product class or category in the JRC preparatory study scope."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:range xsd:string.
txt-durability:typicalDegradationExpression a owl:AnnotationProperty;
    rdfs:label "typical degradation expression"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Annotation used at class level to document a usual degradation expression of a durability-related performance characteristic without imposing a necessary OWL restriction."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction.
txt-durability:typicalFailureExpression a owl:AnnotationProperty;
    rdfs:label "typical failure expression"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Annotation used at class level to document the usual failure expression of an observed performance parameter without imposing an OWL existential restriction."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction.
txt-durability:typicalProgressionTo a owl:AnnotationProperty;
    rdfs:label "typical progression to"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Annotation used at class level to document a typical degradation progression without asserting a necessary causal relation."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction.
txt-process:typicallyUsesChemicalFunction a owl:AnnotationProperty;
    rdfs:label "typically uses chemical function"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Weak annotation relation indicating that a textile process type typically uses a chemical function represented in Textile Associated Materials."@en;
