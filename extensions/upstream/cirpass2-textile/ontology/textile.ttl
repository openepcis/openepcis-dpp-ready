    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Characteristic of garment or textile assembly, including seams, sewing and cutting quality."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Structural superclass introduced to organise the module; not necessarily a verbatim JRC term."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:IntermediateTextileCharacteristic.
txt-structure:IntermediateTextileCharacteristic a owl:Class;
    rdfs:label "Intermediate textile characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Characteristic of an intermediate textile structure such as yarn, fabric, resistance property or assembly."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Structural superclass introduced to organise the module; not necessarily a verbatim JRC term."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:TextileStructureCharacteristic.
txt-structure:FabricVisualCharacteristic a owl:Class;
    rdfs:label "Fabric visual characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Fabric-level characteristic concerning visible appearance, lustre, shininess, sheen or other visual qualities."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This superclass organises G-007 Fabric lustre / fabric shininess without treating it as a purely structural dimension or as an assessment result."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FabricCharacteristic.
txt-structure:FabricBehaviouralCharacteristic a owl:Class;
    rdfs:label "Fabric behavioural characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Fabric-level characteristic concerning the physical behaviour of a fabric under use, gravity, movement, care or stress conditions."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This superclass organises fabric drape without reducing it either to a purely structural dimension or to an assessment result."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FabricCharacteristic.
txt-structure:FabricFunctionalCharacteristic a owl:Class;
    rdfs:label "Fabric functional characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Fabric-level characteristic concerning functional performance relevant to use, comfort or intended application."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This superclass keeps functional fabric characteristics out of TEXTILE_CORE and separate from observed durability parameters."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FabricCharacteristic.
txt-structure:FabricConstructionCharacteristic a owl:Class;
    rdfs:label "Fabric construction characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Fabric structural characteristic concerning fabric construction, density, mass per area or arrangement of yarns/threads."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This superclass distinguishes structural fabric characteristics from process parameters in TEXTILE_PROCESS. The same real-world quantity may be represented as a process target/parameter in TEXTILE_PROCESS and as a product/fabric characteristic in TEXTILE_STRUCTURE, but these roles should be kept explicit."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FabricStructuralCharacteristic.
txt-structure:FabricTactileCharacteristic a owl:Class;
    rdfs:label "Fabric tactile characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Fabric-level characteristic concerning touch, hand-feel or perceived tactile behaviour."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This superclass organises G-006 Fabric handle / fabric softness without treating it as a purely structural dimension or as an assessment result."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FabricCharacteristic.
txt-structure:FabricLustre a owl:Class;
    rdfs:label "Fabric lustre"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:altLabel "Fabric luster"@en, "Fabric sheen"@en, "Fabric shininess"@en;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Fabric visual characteristic concerning the reflection of light that creates a shiny or glossy appearance."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Concrete observations or measurements of lustre, shininess or appearance should be represented through the assessment module when a test method, visual inspection protocol or measured value is recorded."@en, "Table 180 reports that fabric shininess increases with the increase of fibre length and fibre fineness. Fabric lustre is modelled as a fabric visual characteristic, not as a structural dimension and not as an assessment result."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-structure:FabricVisualCharacteristic.
txt-structure:FabricMassPerUnitArea a owl:Class;
    rdfs:label "Fabric mass per unit area"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:altLabel "Fabric grammage"@en, "Fabric weight"@en;
    rdfs:comment "Fabric construction characteristic expressing the mass of fabric per unit surface area."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "The preferred term uses mass rather than weight, following the technical note in JRC Section 2, page 14, footnote 15. Expected SI quantity kind: quantities:SUDE (surface density)."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 4.5, printed page 41, lines 1018-1020; JRC Preparatory Study, Section 13.10.2, printed pages 493-494, lines 11902-11915; Table 182, printed page 494, caption line 11907."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:FabricDrape, txt-structure:FabricBreathability, txt-structure:FabricInsulation;
    rdfs:subClassOf txt-structure:FabricConstructionCharacteristic.
txt-structure:FibreCharacteristic a owl:Class;
    rdfs:label "Fibre characteristic"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "A characteristic of a textile fibre that can influence yarn manufacture, fabric behaviour and durability-related performance."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This class corresponds to the aggregated MAT-001 concept. MAT-004 Fibre type is represented in TEXTILE_CORE through txt:FibreTypeConcept and txtcs:FibreTypeScheme, and used through txt:hasFibreType on txt:FibreCompositionComponent. It is therefore not duplicated as a textile structure class in this module."@en, "This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value."@en;
    txt-connector:sourceLocator "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-structure:TextileStructureCharacteristic.
txt-structure:FibreCleanliness a owl:Class;
    rdfs:label "Fibre cleanliness"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:editorialNote "The term is named FibreCleanliness rather than FibreCleanness, following standard textile and English usage."@en;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Fibre quality characteristic concerning impurities or foreign matter remaining in the fibre."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "A weak influence link from fibre cleanliness to yarn appearance is represented in this module. The corresponding link to fabric appearance remains pending until a fabric appearance target concept is introduced."@en, "Fibre cleanliness is modelled as a fibre quality characteristic, not as a structural dimension such as length, fineness or section shape. Quantitative or qualitative measurements of contamination, trash content or impurity levels should be represented through assessment results."@en;
    txt-connector:sourceLocator "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:FabricAppearance, txt-structure:YarnAppearance;
    rdfs:subClassOf txt-structure:FibreQualityCharacteristic.
txt-structure:FibreQualityCharacteristic a owl:Class;
    rdfs:label "Fibre quality characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Fibre characteristic concerning fibre quality conditions that are not purely structural, mechanical, physical or visual."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This superclass was introduced to avoid forcing fibre cleanliness under a purely structural or visual fibre characteristic. It organises G-002 without changing the semantics of existing fibre characteristic subclasses."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FibreCharacteristic.
txt-structure:YarnAppearance a owl:Class;
    rdfs:label "Yarn appearance"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Yarn visual characteristic concerning diameter, hairiness, visible defects and overall appearance."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Quantitative or qualitative observations of yarn appearance should be represented through the assessment module when a concrete test, inspection or result is recorded."@en, "Table 180 reports that yarn appearance improves with the increase of fibre cleanliness. Yarn appearance is therefore modelled as a yarn-level visual characteristic, not as a fibre characteristic and not as an assessment result."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:FabricAppearance;
    rdfs:subClassOf txt-structure:YarnVisualCharacteristic.
txt-structure:FibreColour a owl:Class;
    rdfs:label "Fibre colour"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence, txt-connector:explicitEvidence;
    rdfs:comment "Visual fibre characteristic concerning the colour of a fibre and its influence on dyeing or bleaching behaviour."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:sourceLocator "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-structure:VisualFibreCharacteristic.
txt-structure:VisualFibreCharacteristic a owl:Class;
    rdfs:label "Visual fibre characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Fibre characteristic concerning visual properties such as colour."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FibreCharacteristic.
txt-structure:FibreElasticity a owl:Class;
    rdfs:label "Fibre elasticity"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Mechanical fibre characteristic concerning deformation and recovery after removal of a load."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Fibre elasticity may influence wrinkling behaviour through recovery behaviour. The relation is context-dependent and mediated by fabric and garment structure."@en;
    txt-connector:sourceLocator "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-durability:Wrinkling;
    rdfs:subClassOf txt-structure:MechanicalFibreCharacteristic.
txt-structure:MechanicalFibreCharacteristic a owl:Class;
    rdfs:label "Mechanical fibre characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Fibre characteristic concerning mechanical behaviour such as strength or elasticity."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FibreCharacteristic.
txt-structure:FibreFineness a owl:Class;
    rdfs:label "Fibre fineness"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Structural fibre characteristic expressing fibre fineness or linear density."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Fibre fineness typically affects yarn uniformity and regularity, but the direction and magnitude depend on fibre type and process conditions."@en;
    txt-connector:sourceLocator "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:YarnUniformity, txt-structure:FabricDrape, txt-process:SpinningLimit, txt-process:SpinningProductivity, txt-structure:FabricHandle, txt-structure:FabricLustre, txt-structure:YarnHairiness;
    rdfs:subClassOf txt-structure:StructuralFibreCharacteristic.
txt-structure:StructuralFibreCharacteristic a owl:Class;
    rdfs:label "Structural fibre characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Fibre characteristic concerning fibre structure, morphology or geometry."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:FibreCharacteristic.
txt-structure:YarnHairiness a owl:Class;
    rdfs:label "Yarn hairiness"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Yarn structural characteristic concerning fibre ends and loops protruding from the yarn body."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Table 180 identifies yarn hairiness as an unwanted yarn characteristic. It reports that hairiness decreases with increasing fibre length and fibre strength, while it may increase with fibre fineness after the optimal working range."@en, "Yarn hairiness is modelled as a yarn structural characteristic rather than as an assessment result. Quantitative hairiness values, test methods or thresholds should be represented in the assessment module."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-structure:YarnStructuralCharacteristic.
txt-structure:FibreLength a owl:Class;
    rdfs:label "Fibre length"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Structural fibre characteristic expressing the length of textile fibres."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value."@en, "Fibre length is modelled as typically influencing yarn strength through yarn structure. The relation should not be interpreted as a deterministic rule."@en;
    txt-connector:sourceLocator "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:YarnStrength, txt-process:SpinningLimit, txt-process:SpinningProductivity, txt-structure:FabricHandle, txt-structure:FabricLustre, txt-structure:YarnHairiness;
    rdfs:subClassOf txt-structure:StructuralFibreCharacteristic.
txt-structure:FibreSectionShape a owl:Class;
    rdfs:label "Fibre section shape"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:altLabel "Fibre cross-section shape"@en;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence, txt-connector:explicitEvidence;
    rdfs:comment "Structural fibre characteristic expressing the cross-sectional shape of textile fibres."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:sourceLocator "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-structure:StructuralFibreCharacteristic.
txt-structure:FibreStrength a owl:Class;
    rdfs:label "Fibre strength"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Mechanical fibre characteristic expressing resistance of fibres to tensile stress or breakage."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value."@en, "Fibre strength typically contributes to yarn strength as a mechanical input."@en;
    txt-connector:sourceLocator "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:YarnStrength, txt-process:SpinningLimit, txt-process:SpinningProductivity, txt-structure:YarnHairiness;
    rdfs:subClassOf txt-structure:MechanicalFibreCharacteristic.
txt-structure:MoistureRetention a owl:Class;
    rdfs:label "Moisture retention"@en;
