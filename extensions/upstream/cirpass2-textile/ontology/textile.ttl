    rdfs:label "Implicit evidence"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    skos:inScheme txt-connector:EvidenceStatusScheme;
    skos:prefLabel "Implicit evidence"@en;
    skos:topConceptOf txt-connector:EvidenceStatusScheme;
    rdfs:comment "The support is implicit and requires interpretation beyond a direct extraction."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:projectDecision.
txt-indicator:DegradationRate a owl:Class;
    rdfs:label "Degradation rate"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Calculated indicator expressing change in a performance parameter or degradation phenomenon per stated unit of time, use, cycle or exposure."@en;
