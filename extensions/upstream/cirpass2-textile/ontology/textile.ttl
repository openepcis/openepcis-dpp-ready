    skos:altLabel "Conditioning"@en, "Steaming"@en;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Spinning or post-spinning parameter corresponding to yarn conditioning, such as steaming, that may enhance flexibility, strength or evenness."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:modellingNote "Proper yarn conditioning can enhance flexibility, strength and evenness."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en;
