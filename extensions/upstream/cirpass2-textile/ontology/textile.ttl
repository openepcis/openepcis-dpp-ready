    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials>;
    txt-connector:modellingNote "The alignment with soc:ProductComponent is owned here because this module defines the non-textile component class. It does not imply that every component contains a substance of concern."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6855-6861; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf <https://w3id.org/eudpp/soc#ProductComponent>.
