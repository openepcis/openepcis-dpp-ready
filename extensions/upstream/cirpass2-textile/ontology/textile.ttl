    dcterms:relation <https://w3id.org/eudpp#QualityIndicator>;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Indicator used to express or interpret durability-related evidence about a textile product."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-indicator:Indicator.
txt-indicator:EstimatedLifetime a owl:Class;
    rdfs:label "Estimated lifetime"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "An estimated lifetime is not a directly measured property and must identify its evidence, method and assumptions."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181; JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-indicator:LifetimeOfProduct.
txt-indicator:LifetimeIndicator a owl:Class;
    rdfs:label "Lifetime indicator"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Durability indicator expressing, estimating or interpreting a product lifespan or duration of service."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "JRC Section 5.8, printed page 73, lines 1695-1715; Section 9.2.1.5, printed page 121, lines 3168-3179."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-indicator:DurabilityIndicator.
txt-indicator:NumberOfUseCycles a owl:Class;
    rdfs:label "Number of use cycles"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "This indicator concerns product use and must not be confused with txtass:NumberOfCycles used as a test-protocol parameter."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5238."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-indicator:UseRelatedIndicator.
txt-indicator:UseRelatedIndicator a owl:Class;
    rdfs:label "Use-related indicator"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Indicator concerning actual or expected product use, use-cycle count or replacement behaviour."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 5.8, printed page 73, lines 1705-1710; JRC Preparatory Study, Section 6.4.1, printed pages 88-89, lines 2281-2294."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-indicator:Indicator.
txt-indicator:PerformanceAfterNCycles a owl:Class;
    rdfs:label "Performance after N cycles"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Derived performance indicator reporting a performance state or level after a stated number and type of use, wash, abrasion, ageing or other cycles."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5238."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-indicator:PerformanceIndicator.
txt-indicator:PerformanceLevelOverTime a owl:Class;
    rdfs:label "Performance level over time"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "A performance trajectory should preserve the underlying assessment results or constituent point indicators from which it was derived."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-indicator:PerformanceIndicator.
txt-indicator:PerformanceRetentionRate a owl:Class;
    rdfs:label "Performance retention rate"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Calculated indicator expressing retained performance relative to an initial or reference performance value under stated calculation rules."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-indicator:PerformanceIndicator.
