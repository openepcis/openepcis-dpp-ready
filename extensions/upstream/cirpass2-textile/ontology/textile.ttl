txt-connector:evidenceStatus a owl:AnnotationProperty;
    rdfs:label "evidence status"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Relates an ontology resource to one or more controlled concepts describing how explicitly the resource is supported or how strongly it was reconstructed from source material."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:modellingNote "This annotation qualifies the ontology resource itself. Evidence and polarity for an individual weak relation edge remain in the canonical relation register or require a reified statement model."@en;
    txt-connector:sourceLocator "docs/decisions/TXT-DEC-006.md"@en;
    txt-connector:sourceType txt-connector:projectDecision;
    rdfs:range skos:Concept.
txt-connector:modellingNote a owl:AnnotationProperty;
    rdfs:label "modelling note"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Human-readable note documenting a modelling decision, limitation, assumption, source wording or intended future refinement."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:sourceLocator "docs/decisions/TXT-DEC-006.md"@en;
    txt-connector:sourceType txt-connector:projectDecision;
    rdfs:range rdf:langString.
txt-connector:sourceLocator a owl:AnnotationProperty;
    rdfs:label "source locator"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Identifies, in human-readable form, the section, page, table, figure, line range or file location in the cited source that supports an ontology resource."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:sourceLocator "Source Traceability Policy, lines 7-43 and 86-108"@en;
    txt-connector:sourceType txt-connector:projectDecision;
    rdfs:range rdf:langString.
txt-connector:sourceType a owl:AnnotationProperty;
    rdfs:label "source type"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Relates an ontology resource to a controlled source-category concept describing how the resource was obtained or justified."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
    txt-connector:sourceLocator "Source Traceability Policy, lines 7-43 and 86-108"@en;
    txt-connector:sourceType txt-connector:projectDecision;
    rdfs:range skos:Concept.
txt-connector:projectDecision a skos:Concept, owl:NamedIndividual;
    rdfs:label "Project decision"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    skos:inScheme txt-connector:SourceTypeScheme;
    skos:prefLabel "Project decision"@en;
    skos:topConceptOf txt-connector:SourceTypeScheme;
    rdfs:comment "The resource results from an explicit project modelling or governance decision."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector>;
