txt-indicator:PerformanceIndicator a owl:Class;
    rdfs:label "Performance indicator"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Durability indicator expressing a derived level, score, rate, retention or trajectory of a durability-related performance parameter."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-indicator:DurabilityIndicator.
txt-indicator:DurabilityIndicator a owl:Class;
