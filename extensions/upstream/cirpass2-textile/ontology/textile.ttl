txt-assessment:PerformanceThreshold a owl:Class;
    rdfs:label "Performance threshold"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Decision criterion specifying a minimum, maximum, target or equality value against which a result is evaluated."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5255-5279."@en;
