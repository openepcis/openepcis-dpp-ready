txt-structure:ResistanceCharacteristic a owl:Class;
    rdfs:label "Resistance characteristic"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Structural or material resistance characteristic, distinct from the observed degradation phenomenon itself."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Structural superclass introduced to organise the module; not necessarily a verbatim JRC term."@en, "Resistance characteristics are distinct from the observed degradation phenomena themselves. For example, pilling resistance is not the same as observed pilling."@en;
    txt-connector:sourceLocator "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-structure:IntermediateTextileCharacteristic.
txt-structure:ThreadCount a owl:Class, owl:NamedIndividual;
    rdfs:label "Thread count"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:altLabel "Number of threads"@en, "Thread density"@en;
    skos:relatedMatch txt-process:TargetFabricDensity;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Fabric construction characteristic expressing the number of threads per specified unit length in a woven fabric."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Although the JRC uses the term thread count, its definition is a density per unit length. A quantitative value should therefore include a reciprocal-length unit rather than a dimensionless count."@en, "Thread count is represented in TEXTILE_STRUCTURE as a fabric construction characteristic. The related process-side concept txtprc:TargetFabricDensity remains a fabric manufacturing parameter. The two concepts should not be merged automatically; one describes a product/fabric characteristic, the other a process parameter or target."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 493-494, lines 11902-11907; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:FabricBreathability, txt-structure:FabricHandle;
    rdfs:subClassOf txt-structure:FabricConstructionCharacteristic;
    rdfs:seeAlso txt-process:TargetFabricDensity.
