    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence, txt-connector:explicitEvidence;
    rdfs:comment "Use-phase process corresponding to wearing, using or exposing a textile product during its intended use."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
