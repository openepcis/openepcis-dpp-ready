    rdfs:subClassOf txt-durability:TactileFailureMode.
txt-durability:FabricStrength a owl:Class;
    rdfs:label "Fabric strength"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Aggregated observed mechanical performance parameter describing the strength of a fabric, potentially covering tensile strength, tear strength or bursting strength depending on the test context."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Fabric strength contributes to the interpretation of intrinsic durability as an aggregated mechanical performance parameter."@en, "Fabric strength is modelled as reducing the likelihood of tear or rip under comparable conditions, rather than as negatively affecting tear or rip."@en;
    txt-connector:sourceLocator "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicallyReducesLikelihoodOf txt-durability:TearOrRip;
    rdfs:subClassOf txt-durability:MechanicalPerformanceParameter.
txt-durability:FunctionalFailureMode a owl:Class;
    rdfs:label "Functional failure mode"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Category of failure modes primarily involving loss of intended use, comfort or functional suitability of a textile product."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Introduced to represent failure modes that are not adequately captured by visual, structural, mechanical or component failure categories alone."@en;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-durability:FailureMode.
txt-durability:FuzzingOrMatting a owl:Class;
    rdfs:label "Fuzzing or matting"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    skos:altLabel "Fabric fuzzing"@en, "Fabric matting"@en;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Observed surface degradation phenomenon involving fuzzing or matting of the fabric surface. The term follows the JRC and ISO wording 'fuzzing or matting', not 'melting'."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "FuzzingOrMatting is not made a subclass of FailureMode because it is modelled following the existing pilling pattern as an observed degradation phenomenon used in performance inspection."@en, "The research gap used the wording 'fuzzing/melting', but the JRC and referenced ISO standards use fuzzing/matting. This ontology therefore introduces FuzzingOrMatting and avoids the unsupported term melting."@en;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    txt-durability:typicalProgressionTo txt-durability:FabricBreakdown;
    rdfs:subClassOf txt-durability:SurfaceDegradationPhenomenon.
txt-durability:SurfaceDegradationPhenomenon a owl:Class;
    rdfs:label "Surface degradation phenomenon"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Observed degradation phenomenon affecting the surface condition of a textile material or product, such as pilling, fuzzing or matting."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Introduced to keep surface degradation phenomena separate from strict FailureMode, because the ontology declares FailureMode and ObservedPerformanceParameter disjoint at high level."@en;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-durability:ObservedDegradationPhenomenon.
txt-durability:HoleInSeam a owl:Class;
    rdfs:label "Hole in seam"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:altLabel "Holes in seams"@en;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence, txt-connector:explicitEvidence;
    rdfs:comment "Specific seam failure involving a hole or localised opening at or around a seam."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:SeamFailure.
txt-durability:SeamFailure a owl:Class;
    rdfs:label "Seam failure"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Structural or assembly-related failure mode involving loss of seam integrity or seam functionality."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "JRC Annex 13.10.1, printed page 469, lines 11089-11094."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:StructuralFailureMode.
txt-durability:IntrinsicDurability a owl:Class;
    rdfs:label "Intrinsic durability"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:altLabel "Physical durability"@en;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Durability construct based on the physical and measurable ability of a textile product to maintain relevant performance characteristics over time under specified use, maintenance or test conditions."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:Durability.
txt-durability:LogoFailure a owl:Class;
    rdfs:label "Logo failure"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Logo failure may also be interpreted as a component-related failure depending on whether the logo is printed, embroidered or applied as a separate component. It is kept under visual failure mode in this module."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:VisualFailureMode.
txt-durability:MechanicalFailureMode a owl:Class;
    rdfs:label "Mechanical failure mode"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    rdfs:comment "Category of failure modes primarily involving rupture, tearing or mechanical damage."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-durability:FailureMode.
txt-durability:Pilling a owl:Class;
    rdfs:label "Pilling"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Observed surface degradation phenomenon involving the formation of small balls or pills of entangled fibres on a textile surface during wear, friction, use or testing."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Observed pilling may contribute to fabric breakdown as part of a progressive surface degradation process, but it should not be treated as the sole necessary cause of fabric breakdown."@en, "Observed pilling negatively affects the interpretation of intrinsic durability; pilling resistance, if modelled separately, should be represented as a protective characteristic."@en;
    txt-connector:sourceLocator "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-durability:typicalProgressionTo txt-durability:FabricBreakdown;
    rdfs:subClassOf txt-durability:ObservedDegradationPhenomenon, txt-durability:SurfaceDegradationPhenomenon.
txt-durability:PillingResistance a owl:Class;
    rdfs:label "Pilling resistance"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Durability-related performance characteristic describing the ability of a textile material, fabric or product to resist the formation of pills under friction, wear or use conditions."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Pilling resistance is separated from Pilling."@en;
    txt-connector:sourceLocator "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-durability:typicalDegradationExpression txt-durability:Pilling;
    rdfs:subClassOf txt-durability:SurfacePerformanceParameter.
txt-durability:ProductAgeing a owl:Class;
    rdfs:label "Product ageing"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Progressive change or degradation of textile product performance over time under repeated use, care, environmental exposure or stress."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "JRC Section 9.2.1.3, printed pages 112-113, lines 2968-3010."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-durability:ObservedDegradationPhenomenon.
txt-durability:RadiationInducedDegradation a owl:Class;
    rdfs:label "Radiation-induced degradation"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Degradation of textile material or product properties associated with ultraviolet or other relevant radiation exposure."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "JRC Section 12.3.16, printed page 254, lines 7150-7157."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:ProductAgeing.
txt-durability:TactileFailureMode a owl:Class;
    rdfs:label "Tactile failure mode"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Category of failure modes primarily affecting tactile perception, hand feel or comfort-related touch properties of a textile product or fabric."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Introduced to avoid forcing tactile failures such as rough or stiff fabric into purely visual or purely structural categories."@en;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-durability:FailureMode.
txt-durability:SeamSlippage a owl:Class;
    rdfs:label "Seam slippage"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Durability-related assembly performance characteristic describing displacement of yarns at or near a seam under mechanical stress, which may lead to deformation or opening."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Seam slippage negatively affects the interpretation of intrinsic durability as a loss of assembly performance."@en;
    txt-connector:sourceLocator "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:AssemblyPerformanceParameter.
txt-durability:SurfaceFailureMode a owl:Class;
    rdfs:label "Surface failure mode"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence;
    rdfs:comment "Category of failure modes primarily affecting the textile surface. Borderline surface phenomena that are also assessed as performance parameters should remain under ObservedDegradationPhenomenon to preserve the module disjointness pattern."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "This class is available for strict failure modes. Pilling and fuzzing/matting are intentionally kept as observed degradation phenomena when they are used as inspection parameters."@en;
    txt-connector:sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf txt-durability:FailureMode.
txt-durability:TrimFailure a owl:Class;
    rdfs:label "Trim failure"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Component failure mode involving failure of trims or auxiliary components associated with a textile product."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11094."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:ComponentFailureMode.
txt-durability:Wrinkling a owl:Class;
    rdfs:label "Wrinkling"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Durability-related deformation behaviour describing the tendency of a textile material or product to form creases under use or after deformation and recovery cycles."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:modellingNote "Wrinkling affects the interpretation of intrinsic durability depending on product type, use context and acceptable thresholds."@en;
    txt-connector:sourceLocator "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:DeformationPerformanceParameter.
txt-durability:ZipperFailure a owl:Class;
    rdfs:label "Zipper failure"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:reconstructedEvidence, txt-connector:implicitEvidence;
    rdfs:comment "Specific trim failure involving failure of a zipper or zip fastener."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2273-2274."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-durability:TrimFailure.
