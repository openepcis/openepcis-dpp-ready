    rdfs:comment "A fibre-, yarn- or fabric-based material grouping within a textile product that serves as a location or mass-reference unit for substance reporting."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf <https://w3id.org/eudpp/soc#MaterialGroup>.
txt-soc:TextileRecyclingAlertThreshold a owl:Class;
    rdfs:label "Textile recycling alert threshold"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "A textile-sector alert concentration used to inform sorting, recycling or environmentally sound end-of-life handling when the substance may hinder circular treatment."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc>;
    txt-connector:sourceLocator "JRC Section 9.2.5.2, printed page 142, lines 3910-3927; Section 12.3.12, printed page 246, lines 6823-6863."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf <https://w3id.org/eudpp/soc#AlertConcentrationThreshold>.
txt-soc:TextileTrackingThreshold a owl:Class;
    rdfs:label "Textile tracking threshold"@en;
    dcterms:source <https://w3id.org/eudpp/textile-ontology>, <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "A tracking or disclosure threshold applicable to a substance occurrence in a textile product or textile product group."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc>;
    txt-connector:sourceLocator "JRC Section 12.1, printed page 220, lines 6213-6220; Section 12.3.12, printed page 246, lines 6823-6863."@en;
