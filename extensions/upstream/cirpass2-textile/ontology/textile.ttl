txt-core:TextileProduct a owl:Class;
    rdfs:label "Textile product"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Any raw, semi-worked, worked, semi-manufactured, manufactured, semi-made-up or made-up product which is exclusively composed of textile fibres, as well as a product containing at least 80% textile fibres by weight."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core>;
    txt-connector:modellingNote "TextileProduct is the broad textile product class. It includes final products and products serving an intermediate or component role when they are represented as product-like traceability resources. Identification constraints should be specified by SHACL according to product granularity rather than imposed uniformly on every TextileProduct."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, relevant section, printed page 14, lines 161-166."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf <https://w3id.org/eudpp#Product>.
