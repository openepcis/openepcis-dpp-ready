    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:inScheme txt-recyclability:TextileWasteSourceScheme;
    skos:narrower txt-recyclability:fabricOrConfectioningStageTextileWaste, txt-recyclability:fibreStageTextileWaste, txt-recyclability:spinningStageTextileWaste;
