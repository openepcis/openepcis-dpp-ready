txt-core:hasFibreComponent a owl:ObjectProperty;
    rdfs:label "has fibre component"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Relates a textile product to a textile fibre type concept that is part of its composition."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core>;
    txt-connector:modellingNote "Non-quantitative relation indicating that a textile product contains a given textile fibre type. This property is useful when the presence of a fibre type is known but its quantitative share is not represented."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:range txt-core:FibreTypeConcept;
    rdfs:domain txt-core:TextileProduct.
txt-core:FibreTypeConcept a owl:Class;
    rdfs:label "Fibre type concept"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "SKOS concept used as a controlled value for textile fibre type in a fibre composition."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf skos:Concept.
txt-core:hasFibreCompositionComponent a owl:ObjectProperty;
    rdfs:label "has fibre composition component"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "Relates a textile product to a structured fibre composition component."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core>;
    txt-connector:modellingNote "No subproperty alignment with dpp:hasMaterialType is asserted because the MAT property links a MaterialOfComposition to an OWL MaterialType, while this textile property links a TextileProduct to a structured FibreCompositionComponent that uses a SKOS fibre-type value."@en, "Preferred relation for representing the declared fibre composition of a textile product, including the fibre type and its quantitative share."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:range txt-core:FibreCompositionComponent;
    rdfs:domain txt-core:TextileProduct.
txt-core:FibreCompositionComponent a owl:Class;
    rdfs:label "Fibre composition component"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "A structured component of a textile product fibre composition, specifying a fibre type and its quantitative share in the product."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core>;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en;
    txt-connector:sourceType txt-connector:modellingAbstraction;
    rdfs:subClassOf <https://w3id.org/eudpp#MaterialOfComposition>, _:n3-77, _:n3-78.
