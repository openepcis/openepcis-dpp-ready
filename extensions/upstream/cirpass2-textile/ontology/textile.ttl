    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Care process involving laundering or washing of a textile product."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:modellingNote "Washing conditions may influence colour fastness and dimensional stability during use and care."@en;
    txt-connector:sourceLocator "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-durability:ColourFastness, txt-durability:DimensionalStability;
