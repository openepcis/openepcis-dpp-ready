txt-process:TargetFabricDensity a owl:Class, owl:NamedIndividual;
    rdfs:label "Target fabric density"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "A process target specification stating the intended thread or loop density of the resulting fabric."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:modellingNote "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en, "Fabric density is related to thread count or loop density. Its effects on breathability, handle and appearance are mediated by fabric type and construction."@en, "This class is not declared equivalent to txtstr:ThreadCount. FabricDensity is process-side and may cover thread density, loop density or related construction-density settings; ThreadCount is the structure-side fabric characteristic currently represented in TEXTILE_STRUCTURE."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:FabricBreathability, txt-structure:FabricAppearance, txt-structure:FabricHandle;
    rdfs:subClassOf txt-process:FabricConstructionParameter.
txt-process:TargetFabricMassPerUnitArea a owl:Class;
    rdfs:label "Target fabric mass per unit area"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    rdfs:comment "A process target specification stating the intended mass of fabric per unit surface area."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:modellingNote "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en, "Expected SI quantity kind: quantities:SUDE (surface density)."@en, "Fabric weight is represented here as a process-side target or parameter. The influence annotations point to structure-side fabric characteristics rather than merging both concepts."@en, "This class is not declared equivalent to txtstr:FabricMassPerUnitArea, because this module represents the process-side parameter or target setting, whereas TEXTILE_STRUCTURE represents the resulting fabric characteristic."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    txt-connector:typicalInfluenceOn txt-structure:FabricDrape, txt-structure:FabricBreathability, txt-structure:FabricInsulation;
    rdfs:subClassOf txt-process:FabricConstructionParameter.
txt-structure:FabricBreathability a owl:Class;
    rdfs:label "Fabric breathability"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:altLabel "Air permeability"@en, "Breathability"@en;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Fabric functional characteristic concerning the passage of water vapour through the fabric and evaporative cooling."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Fabric breathability is represented in TEXTILE_STRUCTURE as a fabric-level functional characteristic, not as a TEXTILE_CORE product class and not as an assessment result."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-structure:FabricFunctionalCharacteristic.
txt-structure:FabricInsulation a owl:Class;
    rdfs:label "Fabric insulation"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    skos:altLabel "Insulation"@en, "Thermal insulation"@en;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Fabric functional characteristic concerning the retention of heat and reduction of heat transfer."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure>;
    txt-connector:modellingNote "Fabric insulation is represented as a fabric-level functional characteristic. Concrete insulation values or standard test results should be represented in TEXTILE_ASSESSMENT."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en;
    txt-connector:sourceType txt-connector:adaptedDefinition;
    rdfs:subClassOf txt-structure:FabricFunctionalCharacteristic.
txt-process:TemperatureControl a owl:Class;
    rdfs:label "Temperature control"@en;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>;
    txt-connector:evidenceStatus txt-connector:explicitEvidence;
    rdfs:comment "Process parameter describing control of temperature during textile manufacturing, processing or care."@en;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process>;
    txt-connector:modellingNote "Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius."@en, "Temperature control is modelled as a process parameter influencing yarn processing quality and mechanical-related characteristics."@en;
    txt-connector:sourceLocator "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en;
