eudpp:moduleH a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC moduleH\r\n\r\nConformity based on full quality assurance"@en;
    rdfs:label "module H"@en;
