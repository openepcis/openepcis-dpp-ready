eudpp:moduleH1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module H1\r\n\r\nConformity based on full quality assurance plus design examination"@en;
    rdfs:label "module H1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
<https://w3id.org/eudpp/LCA> a owl:Ontology;
    dcterms:created "2026-04-03";
    dcterms:creator "Fatima Danash";
    dcterms:description "The LCA module provides classes and properties for representing life-cycle-assessment related information of the digital passport data of some product. \n\nDEPENDENCIES: This module has dependencies to the product EU DPP Core Ontology modules: P_DPP.";
    dcterms:issued "2026-04-30";
    dcterms:title "The LCA module of the EU regulatory compliant Digital Product Passport (EU DPP LCA)";
    rdfs:comment "The LCA module of an EU DPP core ontology proposed by the CIRPASS-2 European project. \n\"This module extends the LCAnet Impact Assessment module (https://w3id.org/lcanet/ia, Danash et al.) developped in the context of the SmartACV \nCarnot project (CEA List) with additional classes and properties for DPP modeling within the Cirpass-2 project. Original module published under CC BY 4.0.\"\"\"";
    rdfs:label "EU DPP LCA";
    owl:versionInfo 2.0;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0>, "This ontology is licensed under the Apache License, Version 2.0. \nIn case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0).";
    <http://purl.org/vocab/vann/preferredNamespacePrefix> "lca";
    dcterms:bibliographicCitation <https://zenodo.org/records/15270342>;
    owl:versionIRI <https://w3id.org/eudpp/LCA/2.0>.
<http://purl.org/dc/dcterms/bibliographicCitation> a owl:AnnotationProperty.
<http://purl.org/dc/dcterms/creator> a owl:AnnotationProperty.
<http://purl.org/dc/dcterms/description> a owl:AnnotationProperty.
<http://purl.org/dc/dcterms/issued> a owl:AnnotationProperty.
<http://purl.org/dc/dcterms/license> a owl:AnnotationProperty.
<http://purl.org/dc/dcterms/title> a owl:AnnotationProperty.
<http://purl.org/dc/elements/1.1/description> a owl:AnnotationProperty.
<https://w3id.org/eudpp/has_unit> a owl:AnnotationProperty.
eudpp:assessIC a owl:ObjectProperty;
    rdfs:domain eudpp:ImpactCategoryIndicator;
    rdfs:range eudpp:ImpactCategory;
    owl:inverseOf eudpp:isAssessedByICI.
eudpp:isAssessedByICI a owl:ObjectProperty.
eudpp:ImpactCategoryIndicator a owl:Class;
    rdfs:comment "An impact category refers to a specific metric/measurable quantity that is used to quantify an impact category. (LCAnet Ontology, SmartACV Project, Version 1.0, 2025)\nExamples include: Global Warming Potential (GWP) and Ozone Depletion Potential (ODP).";
    rdfs:label "Impact Category Indicator".
eudpp:ImpactCategory a owl:Class;
    rdfs:comment "An impact category represents a specific environmental issue that the LCA aims to assess, such as global warming or ozone depletion. Each category aggregates the effects of different emissions that contribute to the same environmental problem. (LCAnet Ontology, SmartACV Project, Version 1.0, 2025) An impact category is classified as whether is corresponds to environmental impact, social impact, etc.";
    rdfs:label "Impact Category".
eudpp:calculatedByCM a owl:ObjectProperty;
    owl:inverseOf eudpp:calculatesCF.
eudpp:calculatesCF a owl:ObjectProperty;
    rdfs:domain eudpp:CharacterizationModel;
    rdfs:range eudpp:CharacterizationFactor.
eudpp:CharacterizationModel a owl:Class;
    rdfs:comment "A characterization model provides a mathematical framework, as a set of equations, to quantify an impact category based on the chosen method. A characterization model is used by a method. (LCAnet Ontology, SmartACV Project, Version 1.0, 2025) \nExample: IPCC (2021) AR6.";
    rdfs:label "Characterization Model".
eudpp:CharacterizationFactor a owl:Class;
    rdfs:comment "Also called Impact factors, are factors that quantify the relative impact of different substances within the same category. These factors are used to convert the number of emissions into impact scores for each category. (LCAnet Ontology, SmartACV Project, Version 1.0, 2025)";
    rdfs:label "Characterization Factor".
eudpp:concernsLCStage a owl:ObjectProperty;
    rdfs:domain eudpp:LcaResult;
    rdfs:range eudpp:LifeCycleStage.
eudpp:LcaResult a owl:Class;
    rdfs:comment "A measurable outcome of a life cycle assessment, representing the quantified effect of a product.";
    rdfs:label "LCA result".
eudpp:LifeCycleStage a owl:Class;
    rdfs:comment "A phase in the life cycle of a product, from raw material acquisition through production, use, and end-of-life, in accordance with life cycle concepts defined in ISO 14040 and ISO 14044";
    rdfs:label "Life Cycle Stage".
eudpp:hasFlowType a owl:ObjectProperty;
    rdfs:domain eudpp:FlowResult;
    rdfs:range eudpp:FlowType.
eudpp:FlowResult a owl:Class;
    rdfs:comment "A type of LCAResult that quantifies the flows of materials, energy, or emissions associated with a product";
    rdfs:label "Flow result";
    rdfs:subClassOf eudpp:LcaResult;
    owl:equivalentClass _:n3-155.
eudpp:FlowType a owl:Class;
    rdfs:comment "A category representing the type of flow quantified in a life cycle assessment. It is used to classify FlowResults according to the kind of resource or emission being measured.";
    rdfs:label "Flow Type".
eudpp:hasImpactCategory a owl:ObjectProperty;
    rdfs:domain eudpp:ImpactResult;
    rdfs:range eudpp:ImpactCategory.
eudpp:ImpactResult a owl:Class;
    rdfs:label "Impact result";
    rdfs:subClassOf eudpp:LcaResult;
    owl:equivalentClass _:n3-161;
    <http://purl.org/dc/elements/1.1/description> "A type of LCAResult that quantifies the effect of a product on a specific impact category, such as climate change, human toxicity, or eutrophication".
eudpp:hasImpactType a owl:ObjectProperty;
    rdfs:domain eudpp:ImpactCategory;
    rdfs:range eudpp:ImpactType.
eudpp:ImpactType a owl:Class;
    rdfs:comment "A category representing the type of an impact category measured in a life cycle assessment. Each ImpactType classifies ImpactCategories according to the area of concern, such as environmental, social, economic, or human health.";
    rdfs:label "Impact Type".
eudpp:imposedByMethod a owl:ObjectProperty;
    owl:inverseOf eudpp:imposesIC.
eudpp:imposesIC a owl:ObjectProperty;
    rdfs:domain eudpp:Methodology;
    rdfs:range eudpp:ImpactCategory.
eudpp:Methodology a owl:Class;
    rdfs:comment "Related LCIA methods can be grouped under LCIA methodologies. (ILCD Handbook, General guidance). \nExamples of methodologies include EN15804+A2, EF v3.1, Impact World.";
    rdfs:label "Methodology".
eudpp:includedInMethodology a owl:ObjectProperty;
    owl:inverseOf eudpp:includesMethod.
eudpp:includesMethod a owl:ObjectProperty;
    rdfs:domain eudpp:Methodology;
    rdfs:range eudpp:Method.
eudpp:Method a owl:Class;
    rdfs:comment "LCIA methods allow to transform and aggregate emissions to the environment and resource use data into a limited set of interpretable and reportable impact potential scores. (Adapted from LCAnet Ontology, SmartACV Project, Version 1.0, 2025)";
    rdfs:label "Method".
eudpp:quantifiedByCF a owl:ObjectProperty;
    owl:inverseOf eudpp:quantifiesICI.
eudpp:quantifiesICI a owl:ObjectProperty;
    rdfs:domain eudpp:CharacterizationFactor;
    rdfs:range eudpp:ImpactCategoryIndicator.
eudpp:usedInMethod a owl:ObjectProperty;
    owl:inverseOf eudpp:usesCM.
eudpp:usesCM a owl:ObjectProperty;
    rdfs:domain eudpp:Method;
    rdfs:range eudpp:CharacterizationModel.
<http://qudt.org/schema/qudt#numericValue> a owl:DatatypeProperty;
    rdfs:label "numeric value";
    rdfs:domain eudpp:LcaResult;
    rdfs:range _:n3-135;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt>.
_:n3-135 a rdfs:Datatype;
    owl:unionOf _:n3-136.
_:n3-136 rdf:first xsd:decimal;
    rdf:rest _:n3-137.
_:n3-137 rdf:first xsd:double;
    rdf:rest _:n3-138.
_:n3-138 rdf:first xsd:float;
    rdf:rest _:n3-139.
_:n3-139 rdf:first xsd:integer;
    rdf:rest rdf:nil.
eudpp:hasDefaultUnit a owl:DatatypeProperty;
    rdfs:domain eudpp:ImpactCategoryIndicator;
    rdfs:range xsd:string.
eudpp:hasUnit a owl:DatatypeProperty;
    rdfs:domain eudpp:LcaResult;
    rdfs:range xsd:string.
eudpp:AirPollutionFootprint a owl:Class;
    rdfs:comment "Quantifies the release of airborne pollutants (e.g., particulate matter, photochemical ozone formation) over the life cycle of a product. AirPollutionFootprint is an ImpactResult associated with relevant environmental impact categories.";
    rdfs:label "Air Pollution Footprint";
    owl:equivalentClass _:n3-140.
_:n3-140 a owl:Class;
    owl:intersectionOf _:n3-141.
_:n3-141 rdf:first eudpp:ImpactResult;
    rdf:rest _:n3-142.
_:n3-142 rdf:first _:m9_genid8;
    rdf:rest rdf:nil.
_:m9_genid8 a owl:Class;
    owl:unionOf _:n3-179.
_:n3-143 a owl:Class;
    owl:intersectionOf _:n3-144.
_:n3-144 rdf:first eudpp:ImpactResult;
    rdf:rest _:n3-145.
_:n3-145 rdf:first _:m9_genid16;
    rdf:rest rdf:nil.
_:m9_genid16 a owl:Restriction;
    owl:onProperty eudpp:hasImpactCategory;
    owl:hasValue eudpp:climateChangeTotal.
eudpp:EmissionFlow a owl:Class;
    rdfs:comment "A type of flow representing substances released to the environment during a product’s life cycle.";
    rdfs:label "Emission Flow";
    rdfs:subClassOf eudpp:FlowType.
eudpp:EnergyFlow a owl:Class;
    rdfs:subClassOf eudpp:ResourceFlow.
eudpp:ResourceFlow a owl:Class;
    rdfs:comment "A type of flow representing the consumption or use of natural resources throughout a product’s life cycle.";
    rdfs:label "Resource Flow";
    rdfs:subClassOf eudpp:FlowType.
eudpp:EnergyFootprint a owl:Class;
    rdfs:comment "Quantifies the total energy use associated with a product throughout its life cycle, including renewable and non-renewable sources. EnergyFootprint is a FlowResult linked to the Energy FlowType.";
    rdfs:label "Energy Footprint";
    owl:equivalentClass _:n3-146.
_:n3-146 a owl:Class;
    owl:intersectionOf _:n3-147.
_:n3-147 rdf:first eudpp:FlowResult;
    rdf:rest _:n3-148.
