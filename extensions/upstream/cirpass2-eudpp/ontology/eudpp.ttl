    rdfs:label "Unit of measurement"@en.
eudpp:hasProductGroup a owl:ObjectProperty;
    rdfs:comment "Product group\nmeans a set of products that serve similar purposes and are similar in terms of use, or have similar\nfunctional properties, and are similar in terms of consumer perception (ESPR Art 2 (4)). The product\ngroup or groups covered are given by delegated acts. (ESPR Art 8 (a))\n\nThis will be probably a classification code from some product classification scheme ."@en;
    rdfs:label "Has product group"@en;
    dcterms:references "ESPR Art 2 (4)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:ClassificationCode.
eudpp:ClassificationCode a owl:Class;
    rdfs:comment "A classification code from some product classification scheme ."@en;
    rdfs:label "ClassificationCode"@en.
eudpp:hasProperty a owl:ObjectProperty;
    rdfs:comment "Product has a property that could be a document or some measurable properties (measurands).\n\nLinking the product to the property."@en;
    rdfs:label "Has property"@en;
    rdfs:domain eudpp:Product;
    rdfs:range eudpp:Property.
eudpp:Property a owl:Class;
    rdfs:comment "A property of the product."@en;
    rdfs:label "Property"@en.
eudpp:isComponentOf a owl:ObjectProperty, owl:TransitiveProperty;
    rdfs:comment "A product is a component of another product.\n\n‘component’ means a product intended to be incorporated into another product; [ESPR Art 2(2)]"@en;
    rdfs:label "Is component of"@en;
    dcterms:references "ESPR Art 2(2)"@en;
