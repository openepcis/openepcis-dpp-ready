    owl:hasValue eudpp:water.
eudpp:LotosEurosModel a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "LOTOS-EUROS model";
    dcterms:bibliographicCitation "(Van Zelm et al, 2008) as applied in ReCiPe 2008".
eudpp:abioticResourceDepletionAdpUltimateReserves a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Abiotic resource depletion (ADP ultimate reserves)";
    eudpp:assessIC eudpp:resourceUseMineralsAndMetals;
    eudpp:hasDefaultUnit "kg Sb -eq".
eudpp:resourceUseMineralsAndMetals a owl:NamedIndividual, eudpp:FlowResult;
    rdfs:comment "Measures the amount of mineral and metal resources consumed by a product system. Represented as FlowResult of type MineralsAndMetalsFlow. Can be used to calculate the MaterialFootprint.";
    rdfs:label "Resource use, minerals and metals";
    eudpp:hasFlowType eudpp:mineralsAndMetals.
eudpp:accumulatedExceedance a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "Accumulated Exceedance";
    dcterms:bibliographicCitation "(Seppälä et al. 2006, Posch et al, 2008)", "(Seppälä et al., 2006, Posch et al, 2008)".
eudpp:accumulatedExceedanceAE a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Accumulated Exceedance (AE)";
    eudpp:assessIC eudpp:acidification;
    eudpp:hasDefaultUnit "mol H+ -eq", "mol N -eq".
eudpp:acidification a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures the potential of a product system's emissions to cause acidification in ecosystems (soil, water, vegetation), mainly from SO₂, NOx, and NH₃ emissions.";
    rdfs:label "Acidification";
    eudpp:hasImpactType eudpp:environmentalImpact.
eudpp:environmentalImpact a owl:NamedIndividual, eudpp:ImpactType;
    rdfs:label "Environmental Impact".
eudpp:availableWaterRemainingModel a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "Available WAter REmaining (AWARE) model";
    dcterms:bibliographicCitation "(Boulay et al., 2018; UNEP 2016)".
<https://w3id.org/eudpp#basedOnUSEtox2.1Model> a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "Based on USEtox2.1 model";
    dcterms:bibliographicCitation "(Fantke et al. 2017), adapted as in Saouter et al., 2018".
eudpp:bernModelBasedOnIPCC2021 a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "Bern model based on IPCC 2021";
    dcterms:bibliographicCitation "(Forster et al., 2021)".
eudpp:bioticResourceDepletionFossilFuelsAdpFossil a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Biotic resource depletion fossil fuels (ADP-fossil)";
    eudpp:assessIC eudpp:resourceUseFossils;
    eudpp:hasDefaultUnit "MJ".
eudpp:resourceUseFossils a owl:NamedIndividual, eudpp:FossilEnergyFootprint;
    rdfs:comment "Measures the amount of fossil resources consumed by a product system, including coal, oil, and natural gas. Represented as FlowResult of type FossilResourceFlow.";
    rdfs:label "Resource use, fossils".
eudpp:carbonEmission a owl:NamedIndividual, eudpp:EmissionFlow.
eudpp:cf001 a owl:NamedIndividual, eudpp:CarbonFootprint.
eudpp:climateChangeTotal a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:label "Climate change, total";
    eudpp:hasImpactType eudpp:environmentalImpact.
<https://w3id.org/eudpp#cml2002MethodV.4.8> a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "CML 2002 method, v.4.8";
    dcterms:bibliographicCitation "van Oers et al., 2002".
eudpp:comparativeToxicUnitForEcosystemsCTUe a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Comparative Toxic Unit for ecosystems (CTUe)";
    eudpp:assessIC eudpp:ecotoxicityFreshwater;
    eudpp:hasDefaultUnit "CTUe".
eudpp:ecotoxicityFreshwater a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:label "Ecotoxicity, freshwater";
    eudpp:hasImpactType eudpp:environmentalImpact.
eudpp:comparativeToxicUnitForHumansCTUh a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Comparative Toxic Unit for humans (CTUh)";
    eudpp:assessIC eudpp:humanToxicityCancer, eudpp:humanToxicityNonCancer;
    eudpp:hasDefaultUnit "CTUh".
eudpp:humanToxicityCancer a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures the potential carcinogenic effects of a product system on humans due to chemical emissions.";
    rdfs:label "Human toxicity, cancer";
    eudpp:hasImpactType eudpp:healthImpact.
eudpp:humanToxicityNonCancer a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures the potential non-carcinogenic effects of a product system on humans due to chemical emissions.";
    rdfs:label "Human toxicity, non-cancer";
    eudpp:hasImpactType eudpp:healthImpact.
eudpp:distribution a owl:NamedIndividual, eudpp:LifeCycleStage;
    rdfs:comment "Stage involving transport and distribution of the product to the market.";
    rdfs:label "Distribution".
eudpp:economicalImpact a owl:NamedIndividual, eudpp:ImpactType;
    rdfs:label "Economical Impact".
eudpp:edipModel a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "EDIP model";
    dcterms:bibliographicCitation "based on the ODPs of the World Meteorological Organisation (WMO) over an infinite time horizon (WMO 2014 + integrations)".
eudpp:endOfLife a owl:NamedIndividual, eudpp:LifeCycleStage;
    rdfs:comment "Stage involving disposal, recycling, or recovery of the product.";
    rdfs:label "End Of Life".
eudpp:eutrendModel a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "EUTREND model";
    dcterms:bibliographicCitation "(Struijs et al, 2009) as applied in ReCiPe 2008".
eudpp:eutrophicationFreshwater a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures potential nutrient enrichment of freshwater ecosystems due to emissions of N and P compounds, causing effects such as algal blooms.";
    rdfs:label "Eutrophication, freshwater";
    eudpp:hasImpactType eudpp:environmentalImpact.
eudpp:eutrophicationMarine a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures potential nutrient enrichment of marine ecosystems due to emissions of N and P compounds.";
    rdfs:label "Eutrophication, marine";
    eudpp:hasImpactType eudpp:environmentalImpact.
eudpp:eutrophicationTerrestial a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures potential nutrient enrichment of terrestrial ecosystems due to nitrogen deposition.";
    rdfs:label "Eutrophication, Terrestial".
eudpp:fossil a owl:NamedIndividual, eudpp:EnergyFlow.
eudpp:fractionOfNutrientsReachingFreshwaterEndCompartmentP a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Fraction of nutrients reaching freshwater end compartment (P)";
    eudpp:assessIC eudpp:eutrophicationFreshwater;
    eudpp:hasDefaultUnit "kg P -eq".
eudpp:fractionOfNutrientsReachingMarineEndCompartmentN a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Fraction of nutrients reaching marine end compartment (N)";
    eudpp:assessIC eudpp:eutrophicationMarine;
    eudpp:hasDefaultUnit "kg N -eq".
eudpp:globalWarmingPotentialGWP100 a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Global Warming Potential (GWP100)";
    eudpp:assessIC eudpp:climateChangeTotal;
    eudpp:quantifiedByCF eudpp:globalWarmingPotentialGwpOverA100YearTimeHorizon;
    eudpp:hasDefaultUnit "kg CO2-eq".
eudpp:globalWarmingPotentialGwpOverA100YearTimeHorizon a owl:NamedIndividual, eudpp:CharacterizationFactor;
    rdfs:label "Global warming potential (GWP) over a 100-year time horizon";
    eudpp:calculatedByCM eudpp:bernModelBasedOnIPCC2021.
eudpp:healthImpact a owl:NamedIndividual, eudpp:ImpactType;
    rdfs:label "Health Impact".
eudpp:humanExposureEfficiencyRelativeToU235 a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Human exposure efficiency relative to U235";
    eudpp:assessIC eudpp:ionisingRadiationHumanHealth;
    eudpp:hasDefaultUnit "kBq U235 -eq".
eudpp:ionisingRadiationHumanHealth a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures the potential human health impact of ionizing radiation due to a product system, including exposure to radioactive substances.";
    rdfs:label "Ionising radiation, human health";
    eudpp:hasImpactType eudpp:healthImpact.
eudpp:humanHealthEffectModel a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "Human health effect model";
    dcterms:bibliographicCitation "as developed by Dreicer et al., 1995)".
eudpp:impactOnHumanHealth a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Impact on human health";
    eudpp:assessIC eudpp:particulateMatter;
    eudpp:hasDefaultUnit "disease incidence".
eudpp:particulateMatter a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures the potential human health impacts of fine particulate matter (PM2.5) emitted by a product system, including respiratory and cardiovascular effects.";
    rdfs:label "Particulate matter";
    eudpp:hasImpactType eudpp:environmentalImpact.
eudpp:lancaModel a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "LANCA model";
    dcterms:bibliographicCitation "Soil quality index based on LANCA model (De Laurentiis et al. 2019) and on the LANCA CF version 2.5 (Horn and Maier, 2018)".
eudpp:landUseOccupationAndTransformation a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures the potential environmental impact of land occupation and transformation due to a product system, including both the area of land used and its conversion from one type to another.";
    rdfs:label "Land use (occupation and transformation)";
    eudpp:hasImpactType eudpp:environmentalImpact.
eudpp:manufacturing a owl:NamedIndividual, eudpp:LifeCycleStage;
    rdfs:comment "Stage involving material processing and product manufacturing.";
    rdfs:label "Manufacturing".
eudpp:material a owl:NamedIndividual, eudpp:ResourceFlow;
    rdfs:label "Material".
eudpp:methaneEmission a owl:NamedIndividual, eudpp:EmissionFlow;
    rdfs:label "Methane Emission".
eudpp:mineralsAndMetals a owl:NamedIndividual, eudpp:ResourceFlow;
    rdfs:label "Minerals and Metals".
eudpp:ozoneDepletion a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures the potential reduction of the stratospheric ozone layer caused by emissions of ozone-depleting substances in a product system.";
    rdfs:label "Ozone depletion";
    eudpp:hasImpactType eudpp:environmentalImpact.
eudpp:ozoneDepletionPotentialODP a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Ozone Depletion Potential (ODP)";
    eudpp:assessIC eudpp:ozoneDepletion;
    eudpp:hasDefaultUnit "kg CFC-11-eq".
eudpp:photochemicalOzoneFormationHumanHealth a owl:NamedIndividual, eudpp:ImpactCategory;
    rdfs:comment "Measures the potential human health impact of photochemical ozone formation (smog) due to VOCs and NOx emissions from a product system.";
    rdfs:label "Photochemical ozone formation, human health";
    eudpp:hasImpactType eudpp:environmentalImpact.
eudpp:pmModel a owl:NamedIndividual, eudpp:CharacterizationModel;
    rdfs:label "PM model";
    dcterms:bibliographicCitation "(Fantke et al., 2016 in UNEP 2016)".
eudpp:rawMaterialAcquisition a owl:NamedIndividual, eudpp:LifeCycleStage;
    rdfs:comment "Stage involving extraction and acquisition of raw materials.";
    rdfs:label "Raw Material Acquisition".
eudpp:socialImpact a owl:NamedIndividual, eudpp:ImpactType;
    rdfs:label "Social Impact".
eudpp:soilQualityIndexDimensionless a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Soil quality index (dimensionless)";
    eudpp:assessIC eudpp:landUseOccupationAndTransformation.
eudpp:troposphericOzoneConcentrationIncrease a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "Tropospheric ozone concentration increase";
    eudpp:assessIC eudpp:photochemicalOzoneFormationHumanHealth;
    eudpp:hasDefaultUnit "kg NMVOC -eq".
eudpp:use a owl:NamedIndividual, eudpp:LifeCycleStage;
    rdfs:comment "Stage during which the product is used by the end user.";
    rdfs:label "Use".
eudpp:userDeprivationPotentialDeprivationWeightedConsumption a owl:NamedIndividual, eudpp:ImpactCategoryIndicator;
    rdfs:label "User deprivation potential (deprivation-weighted consumption)";
    eudpp:assessIC eudpp:waterUse;
    eudpp:hasDefaultUnit "m3 world-eq".
eudpp:waterUse a owl:NamedIndividual, eudpp:WaterFootprint;
    rdfs:comment "";
    rdfs:label "Water use".
eudpp:water a owl:NamedIndividual, eudpp:ResourceFlow;
    rdfs:label "Water".
