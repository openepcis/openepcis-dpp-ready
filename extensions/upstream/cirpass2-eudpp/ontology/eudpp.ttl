    rdfs:subClassOf eudpp:DocumentFormattedProperty.
eudpp:CarbonFootprint a owl:Class;
    rdfs:comment "Carbon footprint\nmeans the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category\nof climate change. (ESPR Art 2 25))\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en, "means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category of climate change. (ESPR Art 2 25))";
    rdfs:label "Carbon footprint"@en, "Carbon Footprint";
    dcterms:references "ESPR Art 2 (25)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalFootprint;
    owl:equivalentClass _:n3-143.
eudpp:EnvironmentalFootprint a owl:Class;
    rdfs:comment "Environmental footprint\nmeans a quantification of the environmental impacts resulting from a product throughout its life\ncycle, whether in relation to a single environmental impact category or an aggregated set of impact\ncategories based on the Product Environmental Footprint method established by Recommendation\n(EU) 2 021/2279 or other scientific methods developed by international organisations, widely tested\nin collaboration with different industry sectors and adopted or implemented by the Commission in\nother Union law. (ESPR Art 2 (24)).\n\nProduct parameters list ESPR Annex I\n(m) The environmental footprint of the product, expressed as a quantification;\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en, "A comprehensive quantification of all environmental impacts resulting from a product throughout its life cycle. EnvironmentalFootprint may cover a single impact category or an aggregated set of categories according to the Product Environmental Footprint method (ESPR Art. 2(24)).";
    rdfs:label "Environmental footprint"@en, "Environmental Footprint";
    dcterms:references "ESPR Art 2 (24)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QuantitativeProperty;
    owl:equivalentClass _:n3-149.
eudpp:CircularEconomyIndicator a owl:Class;
    rdfs:comment "Circular Economy indicators are measures for relevant monitoring the transition to a circular economy and to measure the effects of new policy and trends.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Circular Economy Indicator"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty;
    rdfs:seeAlso <https://environment.ec.europa.eu/strategy/circular-economy-action-plan_en>.
eudpp:ConcentrationOfSubstanceOfConcern a owl:Class;
    rdfs:comment "The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)"@en;
    rdfs:label "Concentration of the substance of concern"@en;
    dcterms:references "ESPR Art 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:Durability a owl:Class;
    rdfs:comment "Durability\nmeans the ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair. (ESPR Art 2 (22))\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Durability"@en;
    dcterms:references "ESPR Art 2 (22)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QualityIndicator.
eudpp:QualityIndicator a owl:Class;
    rdfs:comment "Product characteristics like durability and reliability.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Quality indicator"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:EmissionToAir a owl:Class;
    rdfs:comment "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Emission to air"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalEmission.
eudpp:EnvironmentalEmission a owl:Class;
    rdfs:comment "Emission is the act or amount of sending out gas, heat, light, etc. It can also refer to harmful substances that are released into the environment, especially carbon dioxide.\n\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Environmental emission"@en;
    rdfs:subClassOf eudpp:EnvironmentalPollution;
    rdfs:seeAlso <https://dictionary.cambridge.org/dictionary/english/emission>.
eudpp:EmissionToSoil a owl:Class;
    rdfs:comment "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Emission to soil"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalEmission.
eudpp:EmissionToWater a owl:Class;
    rdfs:comment "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Emission to water"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalEmission.
eudpp:EnergyConsumption a owl:Class;
    rdfs:comment "Energy consumption of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Energy consumption"@en;
    rdfs:subClassOf eudpp:ResourceConsumption.
eudpp:ResourceConsumption a owl:Class;
    rdfs:comment "Resource consumption of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Resource consumption"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:EnvironmentalPollution a owl:Class;
    rdfs:comment "Environmental pollution is the addition of any substance or form of energy to the environment at a rate faster than it can be dispersed or safely stored.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Environmental pollution"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty;
    rdfs:seeAlso <https://www.britannica.com/science/pollution-environment>.
eudpp:HazardousWasteAmount a owl:Class;
    rdfs:comment "Hazardous waste amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Hazardous waste amount"@en;
    rdfs:subClassOf eudpp:WasteGenerationAmount.
eudpp:WasteGenerationAmount a owl:Class;
    rdfs:comment "Waste generation amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Waste generation amount"@en;
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:Height a owl:Class;
    rdfs:comment "Height of the product"@en;
    rdfs:label "Height"@en;
    rdfs:subClassOf eudpp:ProductDimension.
eudpp:ProductDimension a owl:Class;
    rdfs:comment "Dimension class covers measurements of length, width, height, volume, and weight of the product required by\nESPR Annex I in its product parameters"@en;
    rdfs:label "Product dimension"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:LandUse a owl:Class;
    rdfs:comment "Land use of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Land use"@en;
    rdfs:subClassOf eudpp:ResourceConsumption.
eudpp:Length a owl:Class;
    rdfs:comment "Length of the product"@en;
    rdfs:label "Length"@en;
    rdfs:subClassOf eudpp:ProductDimension.
eudpp:MaterialFootprint a owl:Class;
    rdfs:comment "Material footprint\nrefers to the total amount of raw materials extracted to meet final consumption demands. (ESPR Art 2 (26))\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en, "refers to the total amount of raw materials extracted to meet final consumption demands. (ESPR Art 2 (26)).";
    rdfs:label "Material footprint"@en, "Material Footprint";
    dcterms:references "ESPR Art 2 (26)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalFootprint;
    owl:equivalentClass _:n3-167.
eudpp:MicroplasticRelease a owl:Class;
    rdfs:comment "Product parameters as listed in the ESPR Annex I :\n\n(p) microplastic and nano plastic release as expressed through the release during relevant\nproduct life cycle stages, including manufacturing, transport, use and end of life stages;\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Microplastic release"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:PlasticsRelease.
eudpp:PlasticsRelease a owl:Class;
    rdfs:comment "Product parameters as listed in the ESPR Annex I :\n\n(p) microplastic and nano plastic release as expressed through the release during relevant\nproduct life cycle stages, including manufacturing, transport, use and end of life stages;\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Plastic release"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:EnvironmentalPollution.
eudpp:NanoplasticRelease a owl:Class;
    rdfs:comment "Product parameters as listed in the ESPR Annex I :\n\n(p) microplastic and nano plastic release as expressed through the release during relevant\nproduct life cycle stages, including manufacturing, transport, use and end of life stages;\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Nanoplastic release"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:PlasticsRelease.
eudpp:PackagingWasteAmount a owl:Class;
    rdfs:comment "Packaging waste amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Packaging waste amount"@en;
    rdfs:subClassOf eudpp:WasteGenerationAmount.
eudpp:PlasticsWasteAmount a owl:Class;
    rdfs:comment "Hazardous waste amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Plastics waste amount"@en;
    rdfs:subClassOf eudpp:WasteGenerationAmount.
eudpp:ProductToPackagingRatio a owl:Class;
    rdfs:comment "ESPR Annex I, the list of product parameters includes the parameter called the  product to packaging ratio.\n\nHowever, it is not specified in ESPR  whether that ratio is defined on the basis of weight or on the basis of volume.\n\n**This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.**"@en;
    rdfs:label "Product to packaging ratio"@en;
    dcterms:references "ESPR Annex I"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:RecoverableRate a owl:Class;
    rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Recoverable rate"@en;
    rdfs:subClassOf eudpp:CircularEconomyIndicator.
eudpp:RecycledMaterialsUse a owl:Class;
    rdfs:comment "Recycled materials use of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Recycled materials use"@en;
    rdfs:subClassOf eudpp:ResourceConsumption.
eudpp:RecyclingCollectionRate a owl:Class;
    rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Recycling collection rate"@en;
    rdfs:subClassOf eudpp:CircularEconomyIndicator.
eudpp:RecyclingRate a owl:Class;
    rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Recycling rate"@en;
    rdfs:subClassOf eudpp:CircularEconomyIndicator.
eudpp:Reliability a owl:Class;
    rdfs:comment "Reliability\nmeans the probability that a product functions as required under given conditions for a given\nduration without an occurrence which results in a primary or secondary function of the product no\nlonger being performed. (ESPR Art 2 (16))\n\nReliability is usually expressed in terms of mean time between failures (MTBF), which is the average length of time that a device will operate without failure.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Reliability"@en;
    dcterms:references "ESPR Art 2 (16)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:subClassOf eudpp:QualityIndicator.
eudpp:SustainableRenewableMaterialsUse a owl:Class;
    rdfs:comment "Sustainable renewable materials use of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Sustainable renewable materials use"@en;
    rdfs:subClassOf eudpp:ResourceConsumption.
eudpp:ThresholdOfSubstanceOfConcern a owl:Class;
    rdfs:comment "Relevant threshold of Substance of Concern.\n\nBy default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]"@en;
    rdfs:label "Threshold of substance of concern"@en;
    dcterms:references "ESPR FAQ 10.115, p59"@en;
    dcterms:source "https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details";
    rdfs:subClassOf eudpp:QuantitativeProperty.
eudpp:Volume a owl:Class;
    rdfs:comment "Volume of the product"@en;
    rdfs:label "Volume"@en;
    rdfs:subClassOf eudpp:ProductDimension.
eudpp:WaterConsumption a owl:Class;
    rdfs:comment "Water consumption of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en;
    rdfs:label "Water consumption"@en;
    rdfs:subClassOf eudpp:ResourceConsumption.
eudpp:Weight a owl:Class;
    rdfs:comment "Weight of the product"@en;
    rdfs:label "Weight"@en;
    rdfs:subClassOf eudpp:ProductDimension.
eudpp:Width a owl:Class;
    rdfs:comment "Width of the product"@en;
    rdfs:label "Width"@en;
    rdfs:subClassOf eudpp:ProductDimension.
_:n3-134 rdfs:comment "The EU DPP core ontology".
eudpp:hasConcentration a owl:ObjectProperty;
    rdfs:comment "Defines the the concentration, maximum concentration or concentration range of the substances of concern, at the level of the product, its relevant components, or spare parts; ESPR Art 7(5)"@en;
    rdfs:label "Has concentration"@en;
    dcterms:references "ESPR Art 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range eudpp:Concentration.
eudpp:Concentration a owl:Class;
    rdfs:comment "The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)"@en;
    rdfs:label "Concentration of the substance of concern"@en;
    dcterms:references "ESPR Art 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj".
eudpp:hasLifeCycleStage a owl:ObjectProperty;
    rdfs:comment "Describes the life cycle stage during which the Substance of Concern occurs for product (used during production, resulting being in product, in waste); ESPR Annex I (f).\n\nKnown issue: Range is some type of an Event, not yet present in the EU DPP CO."@en;
    rdfs:label "Has life cycle stage"@en;
    dcterms:references "ESPR Annex I (f)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern.
eudpp:hasThreshold a owl:ObjectProperty;
    rdfs:comment "Describes relevant threshold of Substance of Concern.\n\nBy default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]"@en;
    rdfs:label "Has threshold"@en;
    dcterms:references "ESPR FAQ 10.115, p59"@en;
    dcterms:source "https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range eudpp:Threshold.
eudpp:Threshold a owl:Class;
    rdfs:comment "Relevant threshold of Substance of Concern.\n\nBy default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]"@en;
    rdfs:label "Threshold of substance of concern"@en;
    dcterms:references "ESPR FAQ 10.115, p59"@en;
    dcterms:source "https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details".
eudpp:abbreviation a owl:DatatypeProperty;
    rdfs:comment "The abbreviation used for the Substance of Concern; [ESPR Article 7(5)]"@en;
    rdfs:label "Abbreviation"@en;
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string;
    rdfs:subPropertyOf eudpp:otherName.
eudpp:otherName a owl:DatatypeProperty;
    rdfs:comment "Other names, including usual name, trade name, abbreviation; [ESPR Article 7(5)]"@en;
    rdfs:label "Other names"@en;
    dcterms:references "ESPR Article 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string.
eudpp:hasImpactOnEnvironment a owl:DatatypeProperty;
    rdfs:comment "Describes the impacts of Substance of Concern on environment; ESPR Annex I (f)"@en;
    rdfs:label "Has impact on environment"@en;
    dcterms:references "ESPR Annex I (f)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string.
eudpp:hasImpactOnHumanHealth a owl:DatatypeProperty;
    rdfs:comment "Describes the impacts of Substance of Concern on human health; ESPR Annex I (f)"@en;
    rdfs:label "Has impact on human health"@en;
    dcterms:references "ESPR Annex I (f)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string.
eudpp:nameCAS a owl:DatatypeProperty;
    rdfs:comment "The Chemical Abstract Service (CAS) name, if available; [ESPR Article 7(5)]"@en;
    rdfs:label "CAS name"@en;
    dcterms:references "ESPR Article 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string.
eudpp:nameIUPAC a owl:DatatypeProperty;
    rdfs:comment "Name in the International Union of Pure and Applied Chemistry (IUPAC) nomenclature, or another international name when IUPAC name is not available [ESPR Article 7(5)]"@en;
    rdfs:label "IUPAC name"@en;
    dcterms:references "ESPR Article 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string.
eudpp:numberCAS a owl:DatatypeProperty;
    rdfs:comment "The Chemical Abstract Service (CAS) number, if available; [ESPR Article 7(5)]"@en;
    rdfs:label "CAS number"@en;
    dcterms:references "ESPR Article 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string.
eudpp:numberEC a owl:DatatypeProperty;
    rdfs:comment "EXAMPLES:\n\nMercurous Oxide\nEC Number: 239-934-0\nCAS Number: 15829-53-5", "European Community (EC) number, as indicated in the European Inventory of Existing Commercial Chemical Substances (EINECS), the European List of Notified Chemical Substances (ELINCS) or the No Longer Polymer (NLP) list or the number assigned by the European Chemicals Agency (ECHA), if available and appropriate [ESPR Article 7(5)]"@en;
    rdfs:label "EC number"@en;
    dcterms:references "ESPR Article 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string.
eudpp:substanceLocation a owl:DatatypeProperty;
    rdfs:comment "Location of the substance in the product; ESPR Art 7(5)"@en;
    rdfs:label "Location of substance"@en;
    dcterms:references "ESPR Article 7(5)"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj";
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string.
eudpp:tradeName a owl:DatatypeProperty;
    rdfs:comment "The trade name under which the Substance of Concern is known; [ESPR Article 7(5)]"@en;
    rdfs:label "Trade name"@en;
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string;
    rdfs:subPropertyOf eudpp:otherName.
eudpp:usualName a owl:DatatypeProperty;
    rdfs:comment "The usual name under which the Substance of Concern is known; [ESPR Article 7(5)]"@en;
    rdfs:label "Usual name"@en;
    rdfs:domain eudpp:SubstanceOfConcern;
    rdfs:range xsd:string;
    rdfs:subPropertyOf eudpp:otherName.
eudpp:Substance a owl:Class;
    rdfs:comment "Means a chemical element and its compounds in the natural state or obtained by any manufacturing process, including any additive necessary to preserve its stability and any impurity deriving from the process used, but excluding any solvent which may be separated without affecting the stability of the substance or changing its composition; ESPR Art 2, Regulation (EC) No 1907/2006"@en;
    rdfs:label "Substance"@en;
    dcterms:references "ESPR Art 2"@en, "Regulation (EC) No 1907/2006"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/reg/2024/1781/oj", "http://data.europa.eu/eli/reg/2006/1907/oj".
eudpp:accordingTo a owl:ObjectProperty;
    rdfs:comment "Property defining specifies conformity assess procedure/cerfication scheme underlying the cerfificate."@en;
    rdfs:label "according to"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4\r\nDecision No 768/2008/EC Art 4"@en, "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43\t\r\nESPR Art 43"@en;
    rdfs:domain eudpp:ConformityCertificate;
    rdfs:range eudpp:ConformityAssessmentModule.
eudpp:allowsConformityAssessmentModule a owl:ObjectProperty;
    rdfs:comment "A property that specifies the conformity assment procedure applicable to the type of product"@en;
    rdfs:label "allows Conformity Assessment Module"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4\r\nDecision No 768/2008/EC Art 4"@en, "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43\r\nESPR Art 43"@en;
    rdfs:domain eudpp:UnionHarmonisationLegislation;
    rdfs:range eudpp:ConformityAssessmentModule.
eudpp:conformityDeclaredTo a owl:ObjectProperty;
    rdfs:comment "A property which specifies which Union Harmonisation Legislation conformity is declared to."@en;
    rdfs:label "conformity declared to"@en;
    dcterms:source "ESPR Annex V"@en;
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:UnionHarmonisationLegislation.
eudpp:hasUnionHarmonisationLegislation a owl:ObjectProperty;
    rdfs:comment "A property providing the Union Harmonisation Legislation refered to in the EU Declaration of Conformity."@en;
    rdfs:label "has Union Harmonisation Legislation"@en;
    dcterms:source "ESPR Annex V, (5)"@en;
    rdfs:domain eudpp:EUDeclarationOfConformity;
    rdfs:range eudpp:UnionHarmonisationLegislation.
eudpp:usedForPresumptionOfConformity a owl:ObjectProperty;
    rdfs:comment "This property specifies which harmonised standards (or parts thereof) was used to assess conformity with the Union harmonistation legislation."@en;
    rdfs:label "used for presumtion of conformity"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I\t\r\nDecision No 768/2008/EC Annex I Art R8"@en, "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_41\r\nESPR Art 41"@en;
    rdfs:domain eudpp:ProductRequirement;
    rdfs:range eudpp:UnionHarmonisationLegislation.
eudpp:ProductRequirement a owl:Class;
    rdfs:comment "Product requirements means a requirement to be fullfilled by a product when placed on the market."@en;
    rdfs:label "Product Requirement"@en.
eudpp:assignedELI a owl:DatatypeProperty;
    rdfs:comment "Standardised identification that makes it easier to identify and describe legislation across Europe."@en;
    rdfs:label "assigned ELI"@en;
    dcterms:source "https://eur-lex.europa.eu/eli-register/what_is_eli.html"@en;
    rdfs:domain eudpp:UnionHarmonisationLegislation;
    rdfs:range xsd:anyURI.
eudpp:certificateNumber a owl:DatatypeProperty;
    rdfs:comment "Number of the certificate";
    dcterms:source "certificate number"@en;
    rdfs:domain eudpp:ConformityCertificate;
    rdfs:range xsd:string.
eudpp:certificateRevisionNumber a owl:DatatypeProperty;
    rdfs:comment "Number of the revision of a certificate";
    rdfs:label "certificate revision number"@en;
    rdfs:domain eudpp:ConformityCertificate;
    rdfs:range xsd:string.
eudpp:CommonSpecification a owl:Class;
    rdfs:comment "Common specification means ecodesign requirements, essential requirements for digital product passports or test, measurement or calculation methods established by implementing acts adopted by the Commission for products covered by delegated acts pursuant to ESPR Article 4."@en;
    rdfs:label "Common Specification"@en;
    dcterms:source "ESPR Art 42, https://eur-lex.europa.eu/eli/reg/2024/1781/oj#art_42"@en;
    rdfs:subClassOf eudpp:TechnicalSpecification.
eudpp:TechnicalSpecification a owl:Class;
    rdfs:comment "Technical specification means a document that prescribes technical requirements to be fulfilled by a product, process, service or system and which lays down one or more of the following: Common Specification or Other Technical Specification."@en;
    rdfs:label "Technical Specification"@en;
    dcterms:source "Regulation (EU) No 1025/2012 Art 2 (4)\r\nhttps://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2"@en;
    rdfs:subClassOf eudpp:ProductRequirement.
eudpp:HarmonisedStandard a owl:Class;
    rdfs:comment "Harmonised Standard means a European standard adopted on the basis of a request made by the Commission for the application of Union harmonisation legislation."@en;
    rdfs:label "Harmonised Standard"@en;
    dcterms:source "Regulation (EU) No 1025/2012 Art 2 (1c), https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2"@en;
    rdfs:subClassOf eudpp:ProductRequirement.
eudpp:OtherTechnicalSpecification a owl:Class;
    rdfs:comment "Other technical specifications in relation to which conformity is declared."@en;
    rdfs:label "Other Technical Specification"@en;
    dcterms:source "ESPR Annex V, (6)"@en;
    rdfs:subClassOf eudpp:TechnicalSpecification.
eudpp:moduleA a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module A\r\n\r\nInternal production control"@en;
    rdfs:label "module A"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleA1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module A1.\r\n\r\nInternal production control plus supervised product testing"@en;
    rdfs:label "module A1"@en;
