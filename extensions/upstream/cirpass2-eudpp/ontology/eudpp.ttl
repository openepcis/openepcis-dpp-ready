eudpp:moduleA2 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module A2\r\n\r\nInternal production control plus supervised product checks at random intervals"@en;
    rdfs:label "module A2"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleB a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module B\r\n\r\nEC-type examination"@en;
    rdfs:label "module B"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleC a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module C\r\n\r\nConformity to type based on internal production control"@en;
    rdfs:label "module C"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleC1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module C1\r\n\r\nConformity to type based on internal production control plus supervised product testing"@en;
    rdfs:label "module C1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleC2 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module C2\r\n\r\nConformity to type based on internal production control plus supervised product checks at random intervals"@en;
    rdfs:label "module C2"@en;
    dcterms:source "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en, "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\t\r\nDecision No 768/2008/EC Annex II"@en.
eudpp:moduleD a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module D\r\n\r\nConformity to EU-type based on quality assurance of the production process"@en;
    rdfs:label "module D"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleD1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module D1\r\n\r\nQuality assurance of the production process"@en;
    rdfs:label "module D1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleE a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module E\r\n\r\nConformity to EU-type based on product quality assurance"@en;
    rdfs:label "module E"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleE1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module E1\r\n\r\nQuality assurance of final product inspection and testing"@en;
    rdfs:label "module E1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleF a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module F\r\n\r\nConformity to EU-type based on product verification"@en;
    rdfs:label "module F"@en;
    dcterms:source "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en, "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\t\r\nDecision No 768/2008/EC Annex II"@en.
eudpp:moduleF1 a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module F1\r\n\r\nConformity based on product verification"@en;
    rdfs:label "module F1"@en;
    dcterms:source "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II\r\nDecision No 768/2008/EC Annex II"@en, "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001\t\r\nCommission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4"@en.
eudpp:moduleG a owl:NamedIndividual, eudpp:ConformityAssessmentModule;
    rdfs:comment "Decision No 768/2008/EC module G\r\n\r\nConformity based on unit verification"@en;
