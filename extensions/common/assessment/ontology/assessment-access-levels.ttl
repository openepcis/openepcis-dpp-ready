# Access-tier annotations for the assessment and test vocabulary (ESPR Article 9 tiers).
# One entry per term; merged into the module by scripts/build-json.ts.
#
# What a product was assessed for, how, and with which result substantiates the public
# performance, durability, repairability and recyclability claims of the passport (ESPR
# Article 7 and Annex I), so the assessment structure, its results and its indicators are
# Public. The evidence documents (test reports, certificates) are Restricted: they name
# laboratories, specimens and commercial detail and are produced to market surveillance and
# customs on request (ESPR Article 9(2)(b)).

@prefix oea: <https://ref.openepcis.org/extensions/common/assessment/> .
@prefix oec: <https://ref.openepcis.org/extensions/common/core/> .

# --- Restricted: evidence documents ---

oea:hasEvidence oec:defaultAccessLevel oec:Restricted ;
    oec:accessLevelRationale "Test reports and certificates name laboratories, specimens and commercial detail; they substantiate the public claim for authorities and are not themselves public information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .

# --- Public: the assessment, its method, conditions, settings, results, criteria, indicators ---

oea:hasAssessment oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The assessments behind a performance claim are part of the consumer-facing passport content under ESPR Article 7." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasSubAssessment oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Part of a public composite assessment." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasMethod oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "A result is only interpretable with the method that produced it." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasAssessedParameter oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Scope of a public assessment." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasCondition oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "A result is only comparable with the conditions it was obtained under." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasParameterSetting oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Protocol settings (cycles, temperature) qualify a public result." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasResult oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Assessment results are the substance of the public performance claim." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:assessmentDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "When a public result was obtained." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasAssessmentBody oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Who performed the assessment is part of its credibility, as notified bodies are named on declarations of conformity." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasOutcome oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Pass/fail verdict of a public assessment." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:awardedScore oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Component points of a public composite score." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:isDefinedByStandard oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Standard behind a public method." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:methodUrl oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Reference to a public method." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:standardCode oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Designation of a public standard." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:standardUrl oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Catalogue reference of a public standard." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasConditionType oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Kind of a public test condition." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasConditionConcept oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Coded value of a public test condition." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasConditionValue oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Quantity of a public test condition." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:conditionDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Description of a public test condition." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasParameter oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Parameter of a public protocol setting." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasParameterValue oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Value of a public protocol setting." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasObservedParameter oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "What a public result is about." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasMeasuredValue oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The measured value behind a public performance claim." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:resultText oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Textual finding of a public assessment." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:isEvaluatedAgainst oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Criterion of a public result." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasCriterion oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Criterion of a public criterion result." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:criterionDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Text of a published criterion." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:maxScore oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Weight of a published criterion." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasThresholdParameter oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Parameter of a published threshold." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasComparisonOperator oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Operator of a published threshold." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasThresholdValue oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Limit of a published threshold." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasIndicator oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Scores, classes and expected lifetimes are the consumer-facing headline of the passport's performance information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasIndicatorKind oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Kind of a public indicator." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasIndicatorValue oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Value of a public indicator." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasCategoricalValue oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Coded value of a public indicator." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:indicatorText oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Textual value of a public indicator." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:isDerivedFrom oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Provenance of a public indicator." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:hasDerivationMethod oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Method of a public indicator." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
oea:calculationDescription oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Assumptions of a public indicator." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
