# Crosswalk test, inbound: a DPP Keystone product stating the two JRC textile scores and the
# PEFCR footprint figures flat.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dppk: <https://dpp-keystone.org/spec/v3/terms#> .
<https://id.gs1.org/01/09521234000051> a dppk:Product ;
    dppk:robustnessScore "8.0"^^xsd:double ;
    dppk:recyclabilityScore "6.5"^^xsd:double ;
    dppk:carbonFootprint "18.5"^^xsd:double ;
    dppk:environmentalFootprint "42.3"^^xsd:double ;
    dppk:carbonFootprintClass "3"^^xsd:double ;
    dppk:environmentalFootprintClass "2"^^xsd:double ;
    dppk:environmentalFootprintBenchmarkPercentage "-15.2"^^xsd:double .
