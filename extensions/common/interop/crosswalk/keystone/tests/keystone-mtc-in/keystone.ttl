# Crosswalk test, inbound: a DPP Keystone steel product with its material test certificate values
# stated flat on the certificate.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dppk: <https://dpp-keystone.org/spec/v3/terms#> .
<https://id.gs1.org/01/09521234601005> a dppk:Product ;
    dppk:mtc <https://id.gs1.org/01/09521234601005#mtc> .
<https://id.gs1.org/01/09521234601005#mtc> a dppk:MaterialTestCertificate ;
    dppk:mtcYieldStrength "547"^^xsd:double ;
    dppk:mtcYieldStrengthRatio "1.16"^^xsd:double ;
    dppk:mtcElongation "14.2"^^xsd:double ;
    dppk:mtcCarbonContent "0.21"^^xsd:double ;
    dppk:mtcCarbonEquivalent "0.43"^^xsd:double .
