# Awarded points travel as an indicator marked dcterms:type oea:awardedScore, held by the
# assessment named in dcterms:relation, else by the node it is derived from.
CONSTRUCT { ?n oea:awardedScore ?score . }
WHERE {
  GRAPH <urn:xw:in> { ?i dcterms:type oea:awardedScore ; txt-indicator:hasQuantitativeValue ?q . ?q txt-connector:numericValue ?v }
  OPTIONAL { GRAPH <urn:xw:in> { ?i dcterms:relation ?rel } }
  OPTIONAL { GRAPH <urn:xw:in> { ?i txt-indicator:derivedFrom ?d } }
  BIND(COALESCE(?rel, ?d) AS ?n)
  FILTER(BOUND(?n))
  BIND(xsd:decimal(?v) AS ?score)
}
