# EUDPP core: a quantitative property whose dcterms:type is an indicator kind with an EUDPP
# quantity class (xw:indicatorClass) goes back to an oea:Indicator of that kind, on its
# container (dcterms:isPartOf, linked from the product) or on the product.
CONSTRUCT {
  ?holder oea:hasIndicator ?q .
  ?q a oea:Indicator ; oea:hasIndicatorKind ?k ; oea:hasIndicatorValue ?qv .
  ?qv a gs1:QuantitativeValue ; gs1:value ?nv ; gs1:unitCode ?code .
  ?prod ?cl ?cont .
}
WHERE {
  GRAPH <urn:xw:in> { ?prod eudpp:hasProperty ?q . ?q a ?qc ; dcterms:type ?k ; eudpp:numericalValue ?v }
  ?k xw:indicatorClass ?qc .
  OPTIONAL { GRAPH <urn:xw:in> { ?q dcterms:isPartOf ?cont } ?k xw:containerLink ?cl }
  BIND(COALESCE(?cont, ?prod) AS ?holder)
  OPTIONAL {
    GRAPH <urn:xw:in> { ?q eudpp:hasMeasurementUnit ?unit }
    OPTIONAL { ?urow xw:unitCode ?ucode ; xw:siUnit ?unit ; xw:factor ?uf ; xw:canonical true }
  }
  BIND(COALESCE(?ucode, IF(BOUND(?unit) && STRSTARTS(STR(?unit), "https://vocabulary.uncefact.org/UnitMeasureCode#"), STRAFTER(STR(?unit), "#"), "C62")) AS ?code)
  # Oxigraph 0.5.11 errs on a decimal zero times or divided by a decimal: zero is kept explicitly.
  BIND(xsd:decimal(IF(xsd:decimal(?v) = 0, 0.0, xsd:decimal(?v) / COALESCE(?uf, 1.0))) AS ?nv)
  BIND(BNODE() AS ?qv)
}
