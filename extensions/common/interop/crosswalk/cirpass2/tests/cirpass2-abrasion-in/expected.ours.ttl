@prefix txt-assessment: <https://w3id.org/eudpp/textile-assessment#>.
@prefix txt-assessment-codelists: <https://w3id.org/eudpp/textile-assessment-codelists#>.
@prefix txt-connector: <https://w3id.org/eudpp/textile-connector#>.
@prefix txt-core: <https://w3id.org/eudpp/textile-core#>.
@prefix txt-durability: <https://w3id.org/eudpp/textile-durability#>.
@prefix txt-indicator: <https://w3id.org/eudpp/textile-indicator#>.
@prefix txt-recyclability: <https://w3id.org/eudpp/textile-recyclability#>.
@prefix txt-structure: <https://w3id.org/eudpp/textile-structure#>.

<https://dpp.example.org/garment/4711/assessment-abrasion> a eutex:DurabilityInfo;
    oea:hasMethod <https://dpp.example.org/garment/4711/method-martindale>;
    oea:hasParameterSetting <https://dpp.example.org/garment/4711/setting-cycles>;
    oea:hasResult <https://dpp.example.org/garment/4711/result-abrasion>.
<https://dpp.example.org/garment/4711/indicator-abrasion> a oea:Indicator;
    oea:hasDerivationMethod <https://dpp.example.org/garment/4711/method-martindale>;
    oea:hasIndicatorKind txt-indicator:PerformanceAfterNCycles;
    oea:hasIndicatorValue <https://dpp.example.org/garment/4711/value-indicator>;
    oea:isDerivedFrom <https://dpp.example.org/garment/4711/result-abrasion>.
<https://dpp.example.org/garment/4711/method-martindale> a oea:TestMethod;
    oea:isDefinedByStandard <https://dpp.example.org/garment/4711/standard-iso12947-2>;
    oea:methodName "Martindale abrasion, specimen breakdown".
<https://dpp.example.org/garment/4711/result-abrasion> a oea:MeasurementResult;
    oea:hasMeasuredValue <https://dpp.example.org/garment/4711/value-abrasion>;
    oea:hasObservedParameter eutex:AbrasionResistance;
    oea:isEvaluatedAgainst <https://dpp.example.org/garment/4711/threshold-abrasion>.
<https://dpp.example.org/garment/4711/setting-cycles> a oea:ParameterSetting;
    oea:hasParameter oea:NumberOfCycles;
    oea:hasParameterValue <https://dpp.example.org/garment/4711/value-cycles>.
<https://dpp.example.org/garment/4711/standard-iso12947-2> a oea:AssessmentStandard;
    oea:standardCode "ISO 12947-2:2016";
    oea:standardUrl "https://www.iso.org/search.html?q=12947-2"^^xsd:anyURI.
<https://dpp.example.org/garment/4711/threshold-abrasion> a oea:Threshold;
    oea:criterionDescription "At least 30 000 cycles to breakdown";
    oea:hasComparisonOperator oea:GreaterThanOrEqual;
    oea:hasThresholdParameter eutex:AbrasionResistance;
    oea:hasThresholdValue <https://dpp.example.org/garment/4711/value-threshold>.
<https://dpp.example.org/garment/4711/value-abrasion> a gs1:QuantitativeValue;
    gs1:unitCode "C62";
    gs1:value "40000"^^xsd:decimal.
<https://dpp.example.org/garment/4711/value-cycles> a gs1:QuantitativeValue;
    gs1:unitCode "C62";
    gs1:value "50000"^^xsd:decimal.
<https://dpp.example.org/garment/4711/value-indicator> a gs1:QuantitativeValue;
    gs1:unitCode "C62";
    gs1:value 0.8.
<https://dpp.example.org/garment/4711/value-threshold> a gs1:QuantitativeValue;
    gs1:unitCode "C62";
    gs1:value "30000"^^xsd:decimal.
<https://id.gs1.org/01/09521234000037> a gs1:Product;
    oea:hasIndicator <https://dpp.example.org/garment/4711/indicator-abrasion>;
    eutex:hasDurabilityInfo <https://dpp.example.org/garment/4711/assessment-abrasion>.
txt-indicator:PerformanceAfterNCycles a oea:IndicatorKind.
