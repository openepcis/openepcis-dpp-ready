# A product passport written in EUDPP core 2.1.0 terms, as a publisher outside OpenEPCIS would
# write it from the module definitions: its own DPP IRI, linked from the product only
# (eudpp:hasDPP), an importer role, a substance presence, an EPD with module values, a carbon
# footprint study. Terms OpenEPCIS has no counterpart for are included on purpose; the gate
# lists them as not converted.
@prefix eudpp: <https://w3id.org/eudpp#> .
@prefix units: <https://si-digital-framework.org/SI/units/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://id.gs1.org/01/09524000000019> a eudpp:Product ;
    eudpp:productName "Kettle KX-200" ;
    eudpp:description "Electric kettle, 1.7 l" ;
    eudpp:commodityCode "8516719000" ;
    eudpp:countryOfOrigin "PL" ;
    eudpp:productTradeMark "Kalda" ;
    eudpp:isEnergyRelated true ;
    eudpp:hasDPP <https://dpp.kalda.example.com/dpp/KX-200> ;
    eudpp:hasUniqueProductIdentifier [ a eudpp:ProductIdentifier ; eudpp:identifierValue "09524000000019" ;
                                       eudpp:hasScheme eudpp:GTIN ; eudpp:hasGranularity eudpp:model ] ;
    eudpp:hasManufacturer <https://id.gs1.org/417/9524000000019> ;
    eudpp:hasEconomicOperator <https://id.gs1.org/417/9524000000026> ;
    eudpp:hasFacility <https://id.gs1.org/414/9524000000033> ;
    eudpp:hasProperty [ a eudpp:Weight ; eudpp:numericalValue 1.2 ; eudpp:hasMeasurementUnit units:kilogram ] ;
    eudpp:hasMaterial [ a eudpp:MaterialOfComposition ; eudpp:materialPercentage 62.5 ; eudpp:isCriticalRawMaterial false ;
                        eudpp:hasMaterialType [ a eudpp:MaterialType ; eudpp:materialTypeValue "Stainless steel" ] ] ;
    eudpp:containsSubstanceOfConcern <https://kalda.example.com/soc/lead> ;
    eudpp:hasSubstancePresence [ a eudpp:SubstancePresence ; eudpp:concernsSubstance <https://kalda.example.com/soc/lead> ;
                                 eudpp:substanceLocationDescription "Brass fitting of the spout" ;
                                 eudpp:hasConcentration [ a eudpp:ConcentrationOfSubstanceOfConcern ; eudpp:numericalValue 0.0025 ;
                                                          eudpp:hasMeasurementUnit eudpp:massFractionUnit ] ] ;
    eudpp:hasEUDeclarationOfConformity <https://kalda.example.com/doc/kx-200-doc.pdf> ;
    eudpp:isConformWith [ a eudpp:UnionHarmonisationLegislation ; dcterms:identifier "EU 2024/1781" ] ;
    eudpp:hasLCAStudy <https://kalda.example.com/lca/kx-200> , <https://kalda.example.com/epd/kx-200> ;
    eudpp:hasProductStatus [ a eudpp:ProductStatus ] .

<https://dpp.kalda.example.com/dpp/KX-200> a eudpp:DPP ;
    eudpp:dppStatus "Active" ;
    eudpp:granularity "model" ;
    eudpp:dppSchemaVersion "1.0.0" ;
    eudpp:validFrom "2026-09-01T00:00:00Z"^^xsd:dateTimeStamp ;
    eudpp:lastUpdate "2026-10-20T08:15:00Z"^^xsd:dateTimeStamp ;
    eudpp:hasDigitalProductPassportId [ a eudpp:DPPIdentifier ; eudpp:identifierValue "https://dpp.kalda.example.com/dpp/KX-200" ] ;
    eudpp:hasIssuer <https://id.gs1.org/417/9524000000019> ;
    eudpp:dppUrl "https://dpp.kalda.example.com/dpp/KX-200"^^xsd:anyURI .

<https://id.gs1.org/417/9524000000019> a eudpp:LegalPerson ;
    eudpp:actorName "Kalda Sp. z o.o." ;
    eudpp:registeredTradeName "Kalda" ;
    eudpp:hasUniqueOperatorIdentifier [ a eudpp:ActorIdentifier ; eudpp:identifierValue "9524000000019" ; eudpp:hasScheme eudpp:GLN ] ;
    eudpp:isEstablishedIn [ a dcterms:Location ] ;
    schema:address [ a schema:PostalAddress ; schema:streetAddress "ul. Przemysłowa 12" ; schema:postalCode "60-101" ;
                     schema:addressLocality "Poznań" ; schema:addressCountry "PL" ] ;
    schema:email "dpp@kalda.example.com" .

<https://id.gs1.org/417/9524000000026> a eudpp:LegalPerson ;
    eudpp:actorName "Kalda Import GmbH" ;
    eudpp:hasUniqueOperatorIdentifier [ a eudpp:ActorIdentifier ; eudpp:identifierValue "529900T8BM49AURSDO55" ; eudpp:hasScheme eudpp:LEI ] .

[] a eudpp:ActorRoleAssignment ;
    eudpp:hasActor <https://id.gs1.org/417/9524000000026> ;
    eudpp:hasRole eudpp:importer ;
    eudpp:inContextOfProduct <https://id.gs1.org/01/09524000000019> .

<https://id.gs1.org/414/9524000000033> a eudpp:Facility ;
    <https://w3id.org/eudpp/facilityName> "Kalda Poznań plant" ;
    schema:geo [ a schema:GeoCoordinates ; schema:latitude 52.4064 ; schema:longitude 16.9252 ] ;
    eudpp:hasUniqueFacilityIdentifier [ a eudpp:FacilityIdentifier ; eudpp:identifierValue "9524000000033" ; eudpp:hasScheme eudpp:GLN ] .

<https://kalda.example.com/soc/lead> a eudpp:SubstanceOfConcern ;
    eudpp:usualName "Lead" ;
    eudpp:casNumber "7439-92-1" ;
    eudpp:ecNumber "231-100-4" .

<https://kalda.example.com/doc/kx-200-doc.pdf> a eudpp:EUDeclarationOfConformity ;
    eudpp:value "https://kalda.example.com/doc/kx-200-doc.pdf" ;
    eudpp:contentType "pdf" .

<https://kalda.example.com/lca/kx-200> a eudpp:LCAStudy ;
    eudpp:referenceYear "2025"^^xsd:gYear ;
    eudpp:hasLCIAResult [ a eudpp:CarbonFootprint ; eudpp:quantifiesIndicator eudpp:ind_GWPtotal ;
                          eudpp:numericalValue 14.2 ; eudpp:hasMeasurementUnit units:kilogram ;
                          eudpp:unitAsString "kg CO2e per kettle" ] .

<https://kalda.example.com/epd/kx-200> a eudpp:EPDStudy ;
    eudpp:registrationNumber "EPD-KAL-2025-007" ;
    eudpp:expiryDate "2030-06-30"^^xsd:date ;
    eudpp:hasLCIAResult [ a eudpp:LCIAResult ; eudpp:quantifiesIndicator eudpp:ind_GWPfossil ;
                          eudpp:numericalValue 13.9 ; eudpp:unitAsString "kg CO2 eq" ;
                          eudpp:hasPerModuleValue [ a eudpp:LCAModuleValue ; eudpp:forLifeCycleModule eudpp:en15804moduleA1 ; eudpp:amount 9.1E0 ; eudpp:isDeclared true ] ,
                                                  [ a eudpp:LCAModuleValue ; eudpp:forLifeCycleModule eudpp:en15804moduleA3 ; eudpp:amount 4.8E0 ; eudpp:isDeclared true ] ] .
