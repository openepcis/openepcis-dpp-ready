    gs1:consumerRecyclingInstructions "Remove all metal components (zippers, snaps) before textile recycling. Down can be recovered separately."@en, "This product can be returned to any EcoWear store for recycling. Do not dispose of in household waste."@en;
    gs1:manufacturersWarranty _:d14603af88a58c5cf29c9329551995fe;
