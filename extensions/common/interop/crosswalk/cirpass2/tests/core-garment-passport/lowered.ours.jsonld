          "@language": "en",
          "@value": "This product can be returned to any EcoWear store for recycling. Do not dispose of in household waste."
        }
      ],
      "gs1:countryOfOrigin": {
        "id": "_:eb027315c764869d06fa9d1720ffca10"
      },
