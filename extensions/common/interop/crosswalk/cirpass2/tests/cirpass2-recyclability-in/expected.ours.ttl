@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix gs1: <https://ref.gs1.org/voc/>.
@prefix epcis: <https://ref.gs1.org/epcis/>.
@prefix cbv: <https://ref.gs1.org/cbv/>.
@prefix oea: <https://ref.openepcis.org/extensions/common/assessment/>.
@prefix oec: <https://ref.openepcis.org/extensions/common/core/>.
@prefix eutex: <https://ref.openepcis.org/extensions/eu/textile/>.
@prefix xw: <https://ref.openepcis.org/extensions/common/interop/crosswalk#>.
@prefix eudpp: <https://w3id.org/eudpp#>.
@prefix units: <https://si-digital-framework.org/SI/units/>.
@prefix txt-assessment: <https://w3id.org/eudpp/textile-assessment#>.
@prefix txt-assessment-codelists: <https://w3id.org/eudpp/textile-assessment-codelists#>.
@prefix txt-connector: <https://w3id.org/eudpp/textile-connector#>.
@prefix txt-core: <https://w3id.org/eudpp/textile-core#>.
@prefix txt-durability: <https://w3id.org/eudpp/textile-durability#>.
@prefix txt-indicator: <https://w3id.org/eudpp/textile-indicator#>.
@prefix txt-recyclability: <https://w3id.org/eudpp/textile-recyclability#>.
@prefix txt-structure: <https://w3id.org/eudpp/textile-structure#>.

<https://dpp.example.org/garment/4712/coating> a oea:CriterionResult;
    oea:hasCriterion eutex:FreeFromCoatings;
    oea:hasOutcome oea:NotSatisfied.
<https://dpp.example.org/garment/4712/mono> a oea:CriterionResult;
    oea:hasCriterion eutex:MonoMaterial;
    oea:hasOutcome oea:PartlySatisfied.
<https://dpp.example.org/garment/4712/printing> a oea:CriterionResult;
    oea:hasCriterion eutex:FreeFromPrintings;
    oea:hasOutcome oea:Satisfied.
<https://dpp.example.org/garment/4712/recyclability> a oec:RecyclabilityAssessment;
    oea:hasMethod <https://dpp.example.org/garment/4712/scoring>;
    oea:hasResult <https://dpp.example.org/garment/4712/coating>, <https://dpp.example.org/garment/4712/mono>, <https://dpp.example.org/garment/4712/printing>.
<https://dpp.example.org/garment/4712/score-value> a gs1:QuantitativeValue;
    gs1:unitCode "C62";
    gs1:value 6.5.
<https://dpp.example.org/garment/4712/score> a oea:Indicator;
    oea:hasCategoricalValue txt-recyclability:highRecyclabilityLabel;
    oea:hasDerivationMethod <https://dpp.example.org/garment/4712/scoring>;
    oea:hasIndicatorKind oea:RecyclabilityScore;
    oea:hasIndicatorValue <https://dpp.example.org/garment/4712/score-value>.
<https://dpp.example.org/garment/4712/scoring> a oea:AssessmentMethod;
    oea:methodName "Brand recyclability scoring v3".
<https://id.gs1.org/01/09521234000044> a gs1:Product;
    oea:hasIndicator <https://dpp.example.org/garment/4712/score>;
    oec:hasRecyclabilityAssessment <https://dpp.example.org/garment/4712/recyclability>.
