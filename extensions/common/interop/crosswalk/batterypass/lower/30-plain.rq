# Numbers and texts: a number in our datatype (a gs1:QuantitativeValue where the row names our unit
# code), a text in our datatype (a plain string when the row names none).
CONSTRUCT {
  ?r ?via ?n . ?n a ?ccls .
  ?n ?p ?out . ?out a gs1:QuantitativeValue ; gs1:value ?num ; gs1:unitCode ?ou .
}
WHERE {
  ?row xw:bprField ?field ; xw:ours ?p ; xw:form ?form .
  FILTER(?form IN (xw:Plain, xw:Text))
  FILTER NOT EXISTS { ?row xw:lowerSkip true }
  OPTIONAL { ?row xw:via ?via . ?via xw:fragment ?frag ; xw:containerClass ?ccls }
  OPTIONAL { ?row xw:ourDatatype ?odt }
  OPTIONAL { ?row xw:ourUnit ?ou }
  GRAPH <urn:xw:flat> { ?r ?field ?lit }
  FILTER(isIRI(?r) && isLiteral(?lit))
  BIND(IF(BOUND(?via), IRI(CONCAT(STR(?r), "#", ?frag)), ?r) AS ?n)
  BIND(IF(BOUND(?odt), STRDT(STR(?lit), ?odt), IF(?form = xw:Text, STR(?lit), xsd:decimal(STR(?lit)))) AS ?val)
  BIND(IF(BOUND(?ou), xsd:decimal(STR(?lit)), ?none1) AS ?num)
  BIND(IF(BOUND(?ou), BNODE(), ?val) AS ?out)
  FILTER(BOUND(?val))
}
