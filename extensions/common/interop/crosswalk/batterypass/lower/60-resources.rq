# Resources back to documents: an oec:DocumentReference (URL, MIME type, language, title as
# schema:name), a dismantling document of the row's type, the declaration of conformity a
# cccev:Evidence with its URL; a bare-URL row its URL in our datatype. A row with xw:via puts it in
# that container.
CONSTRUCT {
  ?r ?via ?n . ?n a ?ccls .
  ?n ?p ?doc . ?doc a ?dcls ; ?urlp ?u ; ?mimep ?mime ; ?langp ?lang ; schema:name ?title ; eubat:hasDocumentType ?dt .
  ?n ?p ?bare .
}
WHERE {
  ?row xw:bprField ?field ; xw:ours ?p ; xw:form ?form .
  FILTER(?form IN (xw:Document, xw:Url))
  FILTER NOT EXISTS { ?row xw:lowerSkip true }
  GRAPH <urn:xw:flat> { ?r ?field ?res }
  GRAPH <urn:xw:in> { ?res bprx:url ?url }
  FILTER(isIRI(?r))
  OPTIONAL { ?row xw:via ?via . ?via xw:fragment ?frag ; xw:containerClass ?ccls }
  OPTIONAL { ?row xw:docType ?dt }
  BIND(IF(BOUND(?via), IRI(CONCAT(STR(?r), "#", ?frag)), ?r) AS ?n)
  OPTIONAL { GRAPH <urn:xw:in> { ?res bpr:contentType ?m } }
  OPTIONAL { GRAPH <urn:xw:in> { ?res bpr:language ?l } }
  OPTIONAL { GRAPH <urn:xw:in> { ?res bpr:resourceTitle ?t } }
  ?p rdfs:range ?range .
  BIND(?p = eubat:hasEuDeclarationOfConformity AS ?isDecl)
  BIND(BOUND(?dt) AS ?isDismantling)
  BIND(IF(?form = xw:Document, BNODE(), ?none1) AS ?doc)
  BIND(IF(?form = xw:Document, IF(?isDecl, cccev:Evidence, IF(?isDismantling, eubat:DismantlingDocument, oec:DocumentReference)), ?none2) AS ?dcls)
  BIND(IF(?form = xw:Document, IF(?isDecl, eubat:declarationOfConformity, IF(?isDismantling, eubat:documentUrl, oec:documentUrl)), ?none3) AS ?urlp)
  BIND(IF(?isDismantling, eubat:mimeType, oec:mimeType) AS ?mimep)
  BIND(IF(?isDismantling, eubat:languageCode, oec:languageCode) AS ?langp)
  BIND(STRDT(STR(?url), xsd:anyURI) AS ?u)
  BIND(IF(?form = xw:Document && !?isDecl, STR(?m), ?none4) AS ?mime)
  BIND(IF(?form = xw:Document && !?isDecl, STR(?l), ?none5) AS ?lang)
  BIND(IF(?form = xw:Document && !?isDecl, STR(?t), ?none6) AS ?title)
  BIND(IF(?form = xw:Url, STRDT(STR(?url), ?range), ?none7) AS ?bare)
}
