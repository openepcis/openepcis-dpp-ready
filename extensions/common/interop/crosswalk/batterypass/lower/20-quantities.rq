# Value containers back to our values, in the container the row names (a node with the product's
# IRI and the container's fragment). xw:Quantity: a gs1:QuantitativeValue with the unit's default
# code; xw:Scalar: the bare number, when the unit is the row's. Values are xsd:decimal.
CONSTRUCT {
  ?r ?via ?n . ?n a ?ccls .
  ?n ?p ?out . ?out a gs1:QuantitativeValue ; gs1:value ?dv ; gs1:unitCode ?code .
}
WHERE {
  ?row xw:bprField ?field ; xw:ours ?p ; xw:form ?form ; xw:valueSlot ?vs ; xw:unitSlot ?us .
  FILTER(?form IN (xw:Quantity, xw:Scalar))
  FILTER NOT EXISTS { ?row xw:lowerSkip true }
  OPTIONAL { ?row xw:via ?via . ?via xw:fragment ?frag ; xw:containerClass ?ccls }
  GRAPH <urn:xw:flat> { ?r ?field ?c }
  GRAPH <urn:xw:in> { ?c ?vs ?v ; ?us ?tu }
  FILTER(isIRI(?r))
  BIND(IF(BOUND(?via), IRI(CONCAT(STR(?r), "#", ?frag)), ?r) AS ?n)
  ?urow xw:theirUnit ?tu0 ; xw:unitCode ?c0 ; xw:lowerDefault true .
  FILTER(STR(?tu0) = STR(?tu))
  OPTIONAL { ?row xw:ourUnit ?su }
  BIND(xsd:decimal(STR(?v)) AS ?num)
  BIND(IF(?form = xw:Quantity, BNODE(), IF(STR(?su) = STR(?c0), ?num, ?none1)) AS ?out)
  BIND(IF(?form = xw:Quantity, ?num, ?none2) AS ?dv)
  BIND(IF(?form = xw:Quantity, STR(?c0), ?none3) AS ?code)
  FILTER(BOUND(?out))
}
