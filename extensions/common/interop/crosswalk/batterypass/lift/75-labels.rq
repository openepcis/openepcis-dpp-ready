# Labels and symbols: the carbon footprint label and the separate collection symbol as resources
# (the label's symbol URL; for the symbol also eubat:separateCollectionSymbolUrl, 60-resources), the
# meaning of the labels as one text, the extinguishing agent (our text; 2.0.1 also asks for the
# fire class, which OpenEPCIS does not state). A label's media type follows from its URL as in
# 60-resources.rq.
CONSTRUCT {
  ?r ?field ?res . ?res bprx:url ?url ; bpr:contentType ?mime .
  ?r bpr:meaningOfLabelsAndSymbols ?meaning .
  ?r bpr:extinguishingAgent ?ea . ?ea bpr:extinguishingAgent ?agent .
}
WHERE {
  GRAPH <urn:xw:roots> { ?r xw:schema ?schema }
  {
    {
      SELECT ?r ?field (MIN(STR(?sym)) AS ?url) WHERE {
        GRAPH <urn:xw:roots> { ?r xw:schema ?s1 }
        VALUES (?subject ?field) { (eubat:CarbonFootprintLabel bpr:carbonFootprintLabel) (eubat:SeparateCollection bpr:separateCollectionSymbol) }
        GRAPH <urn:xw:in> { ?r eubat:hasLabels ?l . ?l eubat:hasLabelSubject ?subject ; eubat:labelSymbol ?sym }
        FILTER NOT EXISTS { FILTER(?field = bpr:separateCollectionSymbol) GRAPH <urn:xw:in> { ?r eubat:separateCollectionSymbolUrl ?any } }
      } GROUP BY ?r ?field
    }
    BIND(LCASE(REPLACE(?url, "^[^?#]*?(\\.([A-Za-z0-9]+))?([?#].*)?$", "$2")) AS ?ext)
    BIND(COALESCE(
      IF(?ext = "pdf", "application/pdf", ?x1), IF(?ext IN ("htm", "html"), "text/html", ?x2),
      IF(?ext = "svg", "image/svg+xml", ?x6), IF(?ext = "png", "image/png", ?x7), IF(?ext IN ("jpg", "jpeg"), "image/jpeg", ?x8),
      IF(!REGEX(?url, "^https?://[^/]+/[^?#]*\\.[A-Za-z0-9]+([?#].*)?$"), "text/html", ?x9)) AS ?mime)
    BIND(BNODE() AS ?res)
  } UNION {
    {
      SELECT ?r (GROUP_CONCAT(DISTINCT STR(?lm); separator="; ") AS ?meaning) WHERE {
        GRAPH <urn:xw:roots> { ?r xw:schema ?s2 }
        GRAPH <urn:xw:in> { ?r eubat:hasLabels/eubat:labelMeaning ?lm }
        FILTER(LANG(?lm) = "" || LANGMATCHES(LANG(?lm), "en"))
      } GROUP BY ?r
    }
  } UNION {
    {
      SELECT ?r (MIN(STR(?a)) AS ?agent) WHERE {
        GRAPH <urn:xw:roots> { ?r xw:schema ?s3 }
        GRAPH <urn:xw:in> { ?r eubat:hasEndOfLifeInfo/eubat:extinguishingAgent ?a }
      } GROUP BY ?r
    }
    BIND(BNODE() AS ?ea)
  }
}
