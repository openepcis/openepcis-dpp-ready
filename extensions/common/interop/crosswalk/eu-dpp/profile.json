  "structure": {
    "_comment": "Wrong forms of the target side that a defect of the Registry release makes unavoidable; gap numbers refer to the eu-dpp section of the crosswalk README. An entry no document needs any more fails the gate.",
    "accepted": [
      {
        "gap": 1,
        "match": "(SEM-COM-MSG-012|/(extinguishingAgent|detailedComposition|negativeEvents|cycleLifeReferenceTest|notInUseTemperatureRangeTest)[^ ]* (pattern|propertyNames))",
        "reason": "A language-tagged text must carry a region (en-IE): plain BCP 47 tags such as en are rejected, and OpenEPCIS data has no region to add."
      },
      {
        "gap": 2,
        "match": "batteryIdentification NodeConstraintComponent: SEM-BAT-MSG-010",
        "reason": "A model identifier is accepted only together with a batch number, so an item passport with a serial number but no batch cannot name its model."
      }
    ]
  },
  "updates": {
    "_comment": "Shared with the batterypass profile: battery values OpenEPCIS states as assessment results travel as virtual flat handles (shared/battery-handles.ttl).",
    "lift": {
      "entail": [
        "extensions/common/interop/crosswalk/shared/battery-entail.ru"
      ]
    },
    "lower": {
      "reshape": [
        "extensions/common/interop/crosswalk/shared/battery-reshape.ru"
      ]
    }
  }
