# The temperature range not in use: the idle-state range of the technical specification, bounds in
# degrees Celsius.
CONSTRUCT {
  ?r eubat:hasTechnicalSpecifications ?ts . ?ts a eubat:TechnicalSpecification ; eubat:hasTemperatureRangeIdleState ?tr .
  ?tr a eubat:TemperatureRange ; ?bp ?q . ?q a gs1:QuantitativeValue ; gs1:value ?v ; gs1:unitCode "CEL" .
}
WHERE {
  GRAPH <urn:xw:in> { ?r a dpp:DigitalProductPassport ; bat:notInUseTemperatureRange/dppcom:valueRange ?vr . ?vr dppcom:unit unit:degreeCelsius }
  FILTER(isIRI(?r))
  BIND(IRI(CONCAT(STR(?r), "#specs")) AS ?ts)
  BIND(IRI(CONCAT(STR(?r), "#temp-idle")) AS ?tr)
  VALUES (?ep ?bp) { (dppcom:lowerBound eubat:hasMinimumTemperature) (dppcom:upperBound eubat:hasMaximumTemperature) }
  GRAPH <urn:xw:in> { ?vr ?ep ?b }
  BIND(xsd:decimal(?b) AS ?v)
  BIND(BNODE() AS ?q)
}
