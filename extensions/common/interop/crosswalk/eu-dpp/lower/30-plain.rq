# Counts and texts: a count in our datatype (a gs1:QuantitativeValue with a decimal value where the
# row names our unit code), a language-tagged text unchanged.
CONSTRUCT {
  ?r ?via ?n . ?n a ?ccls .
  ?n ?p ?out . ?out a gs1:QuantitativeValue ; gs1:value ?num ; gs1:unitCode ?ou .
}
WHERE {
  ?row xw:euField ?field ; xw:ours ?p ; xw:form ?form .
  FILTER(?form IN (xw:Plain, xw:Text))
  FILTER NOT EXISTS { ?row xw:lowerSkip true }
  OPTIONAL { ?row xw:via ?via . ?via xw:fragment ?frag ; xw:containerClass ?ccls }
  OPTIONAL { ?row xw:ourDatatype ?odt }
  OPTIONAL { ?row xw:ourUnit ?ou }
  GRAPH <urn:xw:in> { ?r a dpp:DigitalProductPassport ; ?field ?lit }
  FILTER(isIRI(?r) && isLiteral(?lit))
  BIND(IF(BOUND(?via), IRI(CONCAT(STR(?r), "#", ?frag)), ?r) AS ?n)
  BIND(IF(?form = xw:Plain, STRDT(STR(xsd:integer(STR(?lit))), ?odt), ?lit) AS ?val)
  BIND(IF(BOUND(?ou), xsd:decimal(?val), ?none1) AS ?num)
  BIND(IF(BOUND(?ou), BNODE(), ?val) AS ?out)
  FILTER(BOUND(?val))
}
