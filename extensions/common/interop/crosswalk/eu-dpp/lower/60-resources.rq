# Resources back to documents: an oec:DocumentReference (URL, MIME type, language, title as
# schema:name); the declaration of conformity a cccev:Evidence with its URL; a bare-URL row its URL
# in our datatype. A row with xw:via puts it in that container.
CONSTRUCT {
  ?r ?via ?n . ?n a ?ccls .
  ?n ?p ?doc . ?doc a ?dcls ; ?urlp ?u ; oec:mimeType ?mime ; oec:languageCode ?lang ; schema:name ?title .
  ?n ?p ?bare .
}
WHERE {
  ?row xw:euField ?field ; xw:ours ?p ; xw:form ?form .
  FILTER(?form IN (xw:Document, xw:Url))
  FILTER NOT EXISTS { ?row xw:lowerSkip true }
  GRAPH <urn:xw:in> { ?r a dpp:DigitalProductPassport ; ?field ?res . ?res dpp:url ?url }
  FILTER(isIRI(?r))
  OPTIONAL { ?row xw:via ?via . ?via xw:fragment ?frag ; xw:containerClass ?ccls }
  BIND(IF(BOUND(?via), IRI(CONCAT(STR(?r), "#", ?frag)), ?r) AS ?n)
  OPTIONAL { GRAPH <urn:xw:in> { ?res dpp:contentType ?m } }
  OPTIONAL { GRAPH <urn:xw:in> { ?res dpp:language ?l } }
  OPTIONAL { GRAPH <urn:xw:in> { ?res dpp:resourceTitle ?t } }
  ?p rdfs:range ?range .
  BIND(?p = eubat:hasEuDeclarationOfConformity AS ?isDoc)
  BIND(IF(?form = xw:Document, BNODE(), ?none1) AS ?doc)
  BIND(IF(?form = xw:Document, IF(?isDoc, cccev:Evidence, oec:DocumentReference), ?none2) AS ?dcls)
  BIND(IF(?form = xw:Document, IF(?isDoc, eubat:declarationOfConformity, oec:documentUrl), ?none3) AS ?urlp)
  BIND(STRDT(STR(?url), xsd:anyURI) AS ?u)
  BIND(IF(?form = xw:Document && !?isDoc, STR(?m), ?none4) AS ?mime)
  BIND(IF(?form = xw:Document && !?isDoc, STR(?l), ?none5) AS ?lang)
  BIND(IF(?form = xw:Document && !?isDoc, STR(?t), ?none6) AS ?title)
  BIND(IF(?form = xw:Url, STRDT(STR(?url), ?range), ?none7) AS ?bare)
}
