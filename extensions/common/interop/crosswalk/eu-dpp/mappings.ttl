@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix xw: <https://ref.openepcis.org/extensions/common/interop/crosswalk#> .
@prefix gs1: <https://ref.gs1.org/voc/> .
@prefix schema: <https://schema.org/> .
@prefix oec: <https://ref.openepcis.org/extensions/common/core/> .
@prefix eubat: <https://ref.openepcis.org/extensions/eu/battery/> .
@prefix dpp: <https://repository.product-passport.ec.europa.eu/core/vocabs/core-vocabulary#> .
@prefix dppcom: <https://repository.product-passport.ec.europa.eu/core/vocabs/common-vocabulary#> .
@prefix bat: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#> .
@prefix gran: <https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#> .
@prefix inst: <https://repository.product-passport.ec.europa.eu/core/vocabs/instance-status#> .
@prefix unit: <https://repository.product-passport.ec.europa.eu/core/vocabs/measurement-unit#> .
@prefix batcat: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-category#> .
@prefix batchem: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-chemistry#> .
@prefix batsta: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-status#> .

# Pairing tables of the OpenEPCIS ↔ EU DPP Registry crosswalk. The rules in lift/ and lower/
# read them; nothing here is ontology. The Registry's passport is one flat record per product:
# every data element hangs off the passport root (the product), measured values are
# {unit, value} objects with a unit from the Registry's eleven-unit list. OpenEPCIS keeps the same
# values on the product or on a container node of it (technical specification, end-of-life
# information, performance information); xw:via names that container.
#
# Code values (granularity, battery category and status) pair through the skos:exactMatch our
# ontologies already carry: the rules read them from the background, not from this file.

# ---------------------------------------------------------------- content specifications
# A passport declares the core specification, the batteries specification when it describes a
# battery, and the subgroup of its battery category.
batcat:electricVehicleBattery        xw:subgroupSpec "product/batteries/subgroup/evb/1.0.0" .
batcat:lightMeansOfTransportBattery  xw:subgroupSpec "product/batteries/subgroup/lmt/1.0.0" .
batcat:industrialBattery             xw:subgroupSpec "product/batteries/subgroup/ind/1.0.0" .

# The attribute-level reporting granularity of a battery passport follows the passport's.
oec:Model xw:reportingGranularity oec:ModelLevel .
oec:Batch xw:reportingGranularity oec:BatchLevel .
oec:Item  xw:reportingGranularity oec:ItemLevel .

# ---------------------------------------------------------------- passport status
# EN 18223 status tokens against the Registry's valid / invalid. Lowering an invalid passport
# yields "invalid": the Registry does not say which kind of invalid.
[] xw:ourStatus "active"    ; xw:euStatus inst:validStatus ; xw:lowerDefault true .
[] xw:ourStatus "invalid"   ; xw:euStatus inst:invalidStatus ; xw:lowerDefault true .
[] xw:ourStatus "inactive"  ; xw:euStatus inst:invalidStatus .
[] xw:ourStatus "archived"  ; xw:euStatus inst:invalidStatus .
[] xw:ourStatus "withdrawn" ; xw:euStatus inst:invalidStatus .
[] xw:ourStatus "suspended" ; xw:euStatus inst:invalidStatus .

# ---------------------------------------------------------------- units
# UN/CEFACT Rec 20 codes against the Registry's measurement units. xw:factor converts our value
# into the Registry's unit (kW → W). Lowering uses the row marked xw:lowerDefault. Units the
# Registry lacks (kWh, A, year, minute, count) have no row: such a value is not converted.
[] xw:unitCode "KGM" ; xw:euUnit unit:kilogram ; xw:lowerDefault true .
[] xw:unitCode "GRM" ; xw:euUnit unit:gram ; xw:lowerDefault true .
[] xw:unitCode "AMH" ; xw:euUnit unit:ampereHour ; xw:lowerDefault true .
[] xw:unitCode "E09" ; xw:euUnit unit:milliampereHour ; xw:lowerDefault true .
[] xw:unitCode "P1"  ; xw:euUnit unit:percent ; xw:lowerDefault true .
[] xw:unitCode "VLT" ; xw:euUnit unit:volt ; xw:lowerDefault true .
[] xw:unitCode "CEL" ; xw:euUnit unit:degreeCelsius ; xw:lowerDefault true .
[] xw:unitCode "WTT" ; xw:euUnit unit:watt ; xw:lowerDefault true .
[] xw:unitCode "KWT" ; xw:euUnit unit:watt ; xw:factor 1000 .
[] xw:unitCode "OHM" ; xw:euUnit unit:ohm ; xw:lowerDefault true .
[] xw:unitCode "H10" ; xw:euUnit unit:reciprocalHour ; xw:lowerDefault true .
[] xw:unitCode "HUR" ; xw:euUnit unit:hour ; xw:lowerDefault true .

# ---------------------------------------------------------------- containers
# Lowering puts a value back into the container its row names, as a node with the product's IRI
# and the fragment our examples use.
eubat:hasTechnicalSpecifications xw:fragment "specs" ; xw:containerClass eubat:TechnicalSpecification .
eubat:hasEndOfLifeInfo           xw:fragment "eol" ; xw:containerClass eubat:EndOfLifeInfo .
oec:hasPerformanceInfo           xw:fragment "performance" ; xw:containerClass oec:PerformanceInfo .

# ---------------------------------------------------------------- code-valued data elements
# The Registry's value list (by namespace) and the OpenEPCIS property lowering writes the code to.
bat:batteryCategory xw:codeNamespace "https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-category#" ; xw:ourProperty schema:category .
bat:batteryStatus   xw:codeNamespace "https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-status#" ; xw:ourProperty schema:status .

# ---------------------------------------------------------------- measured values
# xw:Quantity: our value is a gs1:QuantitativeValue (gs1:value, gs1:unitCode).
# xw:Scalar: our value is a bare number in a fixed unit (xw:euUnit), xw:factor scales it into the
# Registry's unit (a 0–1 ratio into percent). xw:subgroup marks data elements only the
# subgroup specifications (EV, LMT, industrial) define, xw:forbiddenIn the subgroups whose shapes
# exclude one (sh:maxCount 0: an EV passport states SOCE, the others remaining capacity).
# xw:lowerUnless: lowering takes this element only when the passport lacks the one named. The
# Registry's current and remaining round-trip efficiency are one OpenEPCIS term (adjudication of
# 2026-11-06); lifting writes both, lowering keeps the remaining one.
[] xw:euField bat:batteryWeight ; xw:ours eubat:hasBatteryMass ; xw:form xw:Quantity .
[] xw:euField bat:batteryWeight ; xw:ours gs1:netWeight ; xw:form xw:Quantity ; xw:lowerSkip true .
[] xw:euField bat:batteryCapacity ; xw:ours eubat:hasRatedCapacity ; xw:form xw:Quantity ; xw:via eubat:hasTechnicalSpecifications .
[] xw:euField bat:ratedCapacity ; xw:ours eubat:hasRatedCapacity ; xw:form xw:Quantity ; xw:via eubat:hasTechnicalSpecifications ; xw:subgroup true ; xw:lowerSkip true .
[] xw:euField bat:minimalVoltage ; xw:ours eubat:hasMinimumVoltage ; xw:form xw:Quantity ; xw:via eubat:hasTechnicalSpecifications .
[] xw:euField bat:nominalVoltage ; xw:ours eubat:hasNominalVoltage ; xw:form xw:Quantity ; xw:via eubat:hasTechnicalSpecifications .
[] xw:euField bat:maximumVoltage ; xw:ours eubat:hasMaximumVoltage ; xw:form xw:Quantity ; xw:via eubat:hasTechnicalSpecifications .
[] xw:euField bat:powerLimit ; xw:ours eubat:hasMaximumPermittedBatteryPower ; xw:form xw:Quantity ; xw:via eubat:hasTechnicalSpecifications .
[] xw:euField bat:internalCellResistance ; xw:ours <urn:xw:v:hasInitialCellInternalResistance> ; xw:form xw:Quantity ; xw:via eubat:hasTechnicalSpecifications .
[] xw:euField bat:internalPackResistance ; xw:ours <urn:xw:v:hasInitialPackInternalResistance> ; xw:form xw:Quantity ; xw:via eubat:hasTechnicalSpecifications .
[] xw:euField bat:remainingCapacity ; xw:ours <urn:xw:v:hasRemainingCapacity> ; xw:form xw:Quantity ; xw:subgroup true ; xw:forbiddenIn "product/batteries/subgroup/evb/1.0.0" .
[] xw:euField bat:capacityFade ; xw:ours <urn:xw:v:hasCapacityFade> ; xw:form xw:Quantity ; xw:subgroup true .
[] xw:euField bat:powerFade ; xw:ours <urn:xw:v:hasPowerFade> ; xw:form xw:Quantity ; xw:subgroup true .
[] xw:euField bat:internalResistance ; xw:ours <urn:xw:v:hasInternalResistance> ; xw:form xw:Quantity ; xw:subgroup true .
[] xw:euField bat:internalResistanceIncrease ; xw:ours <urn:xw:v:hasInternalResistanceIncrease> ; xw:form xw:Quantity ; xw:subgroup true .
[] xw:euField bat:remainingRoundTripEfficiency ; xw:ours <urn:xw:v:hasRemainingRoundTripEfficiency> ; xw:form xw:Quantity ; xw:subgroup true ; xw:forbiddenIn "product/batteries/subgroup/evb/1.0.0" .
[] xw:euField bat:roundTripEnergyEfficiencyFade ; xw:ours <urn:xw:v:hasRoundTripEfficiencyFade> ; xw:form xw:Quantity .
[] xw:euField bat:stateOfCertifiedEnergy ; xw:ours <urn:xw:v:hasStateOfCertifiedEnergy> ; xw:form xw:Quantity ; xw:subgroup true ; xw:forbiddenIn "product/batteries/subgroup/ind/1.0.0", "product/batteries/subgroup/lmt/1.0.0" .
[] xw:euField bat:renewableContentShare ; xw:ours eubat:renewableContent ; xw:form xw:Scalar ; xw:euUnit unit:percent ; xw:via eubat:hasEndOfLifeInfo .
[] xw:euField bat:capacityExhaustionThreshold ; xw:ours <urn:xw:v:capacityThresholdForExhaustion> ; xw:form xw:Scalar ; xw:euUnit unit:percent ; xw:via eubat:hasTechnicalSpecifications ; xw:subgroup true ; xw:forbiddenIn "product/batteries/subgroup/ind/1.0.0", "product/batteries/subgroup/lmt/1.0.0" .
[] xw:euField bat:initialRoundTripEnergyEfficiency ; xw:ours <urn:xw:v:roundTripEfficiency> ; xw:form xw:Scalar ; xw:euUnit unit:percent ; xw:via eubat:hasTechnicalSpecifications ; xw:subgroup true .
[] xw:euField bat:roundTripEfficiencyAtHalfCycleLife ; xw:ours <urn:xw:v:roundTripEfficiencyAt50PercentCycleLife> ; xw:form xw:Scalar ; xw:euUnit unit:percent ; xw:via eubat:hasTechnicalSpecifications ; xw:subgroup true .
[] xw:euField bat:roundTripEnergyEfficiency ; xw:ours <urn:xw:v:hasRemainingRoundTripEfficiency> ; xw:form xw:Quantity ; xw:lowerUnless bat:remainingRoundTripEfficiency .
[] xw:euField bat:cycleLifeChargeCRate ; xw:ours <urn:xw:v:cRateLifeCycleTest> ; xw:form xw:Scalar ; xw:euUnit unit:reciprocalHour ; xw:via eubat:hasTechnicalSpecifications ; xw:subgroup true .
[] xw:euField bat:cycleLifeDischargeCRate ; xw:ours <urn:xw:v:dischargeCRateLifeCycleTest> ; xw:form xw:Scalar ; xw:euUnit unit:reciprocalHour ; xw:via eubat:hasTechnicalSpecifications .

# ---------------------------------------------------------------- plain values on the root
# Numbers and texts the Registry keeps as they are. xw:theirDatatype is the Registry's datatype,
# xw:ourDatatype ours (lowering). A count may be a gs1:QuantitativeValue on our side: xw:ourUnit
# is then the unit code the lowering writes.
[] xw:euField bat:expectedLifetimeCycles ; xw:ours <urn:xw:v:expectedCycleLife> ; xw:form xw:Plain ; xw:theirDatatype xsd:positiveInteger ; xw:ourDatatype xsd:integer ; xw:via eubat:hasTechnicalSpecifications ; xw:subgroup true .
[] xw:euField bat:expectedLifetimeYears ; xw:ours eubat:hasExpectedLifetime ; xw:form xw:Plain ; xw:theirDatatype xsd:positiveInteger ; xw:ourDatatype xsd:integer ; xw:ourUnit "ANN" ; xw:via eubat:hasTechnicalSpecifications ; xw:subgroup true .
[] xw:euField bat:expectedLifetimeCyclesRest ; xw:ours <urn:xw:v:expectedRemainingCycles> ; xw:form xw:Plain ; xw:theirDatatype xsd:positiveInteger ; xw:ourDatatype xsd:integer ; xw:subgroup true .
[] xw:euField bat:numberOfChargingCycles ; xw:ours <urn:xw:v:hasCycleCount> ; xw:form xw:Plain ; xw:theirDatatype xsd:nonNegativeInteger ; xw:ourDatatype xsd:integer ; xw:ourUnit "C62" .
[] xw:euField bat:extinguishingAgent ; xw:ours eubat:extinguishingAgent ; xw:form xw:Text ; xw:via eubat:hasEndOfLifeInfo .

# ---------------------------------------------------------------- separate collection symbol
# The Registry asks whether the label shows the crossed-out wheeled bin (true is the only valid
# answer). Ours: a label whose subject is separate collection, or the symbol's URL.
[] xw:euField bat:separateCollectionSymbol ; xw:ours eubat:hasLabels, eubat:separateCollectionSymbolUrl .

# ---------------------------------------------------------------- resources (documents)
# A Registry resource is {resourceTitle, contentType, url, language}. Ours: an oec:DocumentReference
# (or a dismantling document) with oec:documentUrl, oec:mimeType, oec:languageCode, a declaration of
# conformity (cccev:Evidence) with eubat:declarationOfConformity, or a bare URL. Lowering writes an
# oec:DocumentReference, for the declaration a cccev:Evidence with its URL.
[] xw:euField bat:dismantlingInformation ; xw:ours eubat:hasDismantlingAndRemovalInformation ; xw:form xw:Document .
[] xw:euField bat:euDeclarationOfConformity ; xw:ours eubat:hasEuDeclarationOfConformity ; xw:form xw:Document .
[] xw:euField bat:euDeclarationOfConformity ; xw:ours oec:hasConformityDeclaration ; xw:form xw:Document ; xw:lowerSkip true .
[] xw:euField bat:complianceTestReportResults ; xw:ours eubat:resultOfTestReport ; xw:form xw:Url .
[] xw:euField bat:safetyMeasures ; xw:ours eubat:hasSafetyMeasures ; xw:form xw:Document ; xw:via eubat:hasEndOfLifeInfo .

# ---------------------------------------------------------------- battery chemistry
# The Registry's chemistry list against the short name OpenEPCIS gives the electrochemical system
# (schema:alternateName of eubat:hasBatteryChemistry); lowering writes the short name.
batchem:leadAcid           xw:chemistryName "Pb", "lead-acid" ; xw:lowerName "Pb" .
batchem:nickelCadmium      xw:chemistryName "NiCd" ; xw:lowerName "NiCd" .
batchem:nickelMetalHydride xw:chemistryName "NiMH" ; xw:lowerName "NiMH" .
batchem:lithiumIonNMC      xw:chemistryName "NMC" ; xw:lowerName "NMC" .
batchem:lithiumIonLFP      xw:chemistryName "LFP" ; xw:lowerName "LFP" .
batchem:lithiumIonLMO      xw:chemistryName "LMO" ; xw:lowerName "LMO" .
batchem:lithiumIonLCO      xw:chemistryName "LCO" ; xw:lowerName "LCO" .
batchem:lithiumIonNCA      xw:chemistryName "NCA" ; xw:lowerName "NCA" .
batchem:lithiumMetal       xw:chemistryName "Li-metal" ; xw:lowerName "Li-metal" .
batchem:sodiumIon          xw:chemistryName "Na-ion", "SIB" ; xw:lowerName "Na-ion" .

# ---------------------------------------------------------------- countries
# The Registry writes the manufacturing country as ISO 3166-1 alpha-3, OpenEPCIS (GS1) as alpha-2.
# All 249 officially assigned codes (ISO 3166-1, as listed in
# github.com/lukes/ISO-3166-Countries-with-Regional-Codes, all.csv).
[] xw:alpha2 "AF" ; xw:alpha3 "AFG" .
[] xw:alpha2 "AX" ; xw:alpha3 "ALA" .
[] xw:alpha2 "AL" ; xw:alpha3 "ALB" .
[] xw:alpha2 "DZ" ; xw:alpha3 "DZA" .
