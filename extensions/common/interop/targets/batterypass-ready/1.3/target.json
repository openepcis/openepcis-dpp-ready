      "schemas": [
        "extensions/eu/battery/validation/gefeg-live/StationaryIndustrial2kWh.schema.json"
      ]
    },
    {
      "scope": "industrial-without-bms",
      "label": "industrial battery without BMS",
      "schemas": [
        "extensions/eu/battery/validation/gefeg-live/IndustrialWithoutBMS.schema.json"
      ]
