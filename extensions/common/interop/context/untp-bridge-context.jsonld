{
  "@context": {
    "@version": 1.1,
    "untp": "https://vocabulary.uncefact.org/untp/",
    "oec": "https://ref.openepcis.org/extensions/common/core/",
    "gs1": "https://ref.gs1.org/voc/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Material": "oec:MaterialComposition",
    "Party": "oec:OperatorInformation",
    "Facility": "oec:FacilityInformation",
    "massFraction": {
      "@id": "oec:massFraction",
      "@type": "xsd:decimal"
    },
    "materialProvenance": {
      "@id": "oec:hasMaterialComposition",
      "@type": "@id"
    },
    "product": {
      "@id": "gs1:product",
      "@type": "@id"
    },
    "Claim": "untp:Claim",
    "Criterion": "untp:Criterion",
    "Standard": "untp:Standard",
    "Regulation": "untp:Regulation",
    "ConformityAttestation": "untp:ConformityAttestation",
    "ConformityScheme": "untp:ConformityScheme",
    "ConformityTopic": "untp:ConformityTopic",
    "PerformanceMetric": "untp:PerformanceMetric",
    "registeredId": "untp:registeredId",
    "countryOfOperation": "untp:countryOfOperation",
    "processCategory": "untp:processCategory",
    "recycledMassFraction": {
      "@id": "untp:recycledMassFraction",
      "@type": "xsd:decimal"
    },
    "hazardous": {
      "@id": "untp:hazardous",
      "@type": "xsd:boolean"
    },
    "performanceClaim": {
      "@id": "untp:performanceClaim",
      "@type": "@id",
      "@container": "@set"
    },
    "conformityTopic": {
      "@id": "untp:conformityTopic",
      "@type": "@id",
      "@container": "@set"
    },
    "referenceStandard": {
      "@id": "untp:referenceStandard",
      "@type": "@id"
    },
    "referenceRegulation": {
      "@id": "untp:referenceRegulation",
      "@type": "@id"
    },
    "attestationType": {
      "@id": "untp:attestationType",
      "@type": "@id"
    },
    "producedAtFacility": {
      "@id": "untp:producedAtFacility",
      "@type": "@id"
    },
    "idGranularity": {
      "@id": "untp:idGranularity",
      "@type": "@id"
    }
  }
}
