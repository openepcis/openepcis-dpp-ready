# Access-tier annotations for the shared oec: core (ESPR Article 9 tiers).
# One statement per term; merged into the module by scripts/build-json.ts.
#
# Curated defaults pending the ESPR delegated acts: none are marked
# oec:accessLevelMandatedBy, so deployments may tighten (never loosen) them at
# runtime. Rationale per group is noted inline. Terms not listed default to
# AuthorizedOnly; structural sub-properties (value, elementId, stageValue, ...)
# stay unannotated and inherit their parent's tier.

@prefix oec: <https://ref.openepcis.io/extensions/common/core/> .

# --- Public: passport lifecycle & metadata (consumers must be able to
# --- interpret the passport itself; mirrors batterypass dppSchemaVersion etc.)
oec:dppSchemaVersion oec:defaultAccessLevel oec:Public .
oec:passportIdentifier oec:defaultAccessLevel oec:Public .
oec:passportStatus oec:defaultAccessLevel oec:Public .
oec:passportVersion oec:defaultAccessLevel oec:Public .
oec:passportIssueDate oec:defaultAccessLevel oec:Public .
oec:passportIssuer oec:defaultAccessLevel oec:Public .
oec:passportExpiryDate oec:defaultAccessLevel oec:Public .
oec:previousPassportVersion oec:defaultAccessLevel oec:Public .
oec:granularityLevel oec:defaultAccessLevel oec:Public .
oec:language oec:defaultAccessLevel oec:Public .
oec:languageCode oec:defaultAccessLevel oec:Public .
oec:lastUpdated oec:defaultAccessLevel oec:Public .
oec:lastDataUpdate oec:defaultAccessLevel oec:Public .
oec:issueDate oec:defaultAccessLevel oec:Public .
oec:productCategory oec:defaultAccessLevel oec:Public .
# access metadata is needed to interpret any tiered document
oec:accessRights oec:defaultAccessLevel oec:Public .
oec:accessLevel oec:defaultAccessLevel oec:Public .
oec:dataRetentionPeriod oec:defaultAccessLevel oec:Public .

# --- Public: ESPR Article 7 consumer-facing sustainability information ---
oec:expectedLifespan oec:defaultAccessLevel oec:Public .
oec:guaranteedLifespan oec:defaultAccessLevel oec:Public .
oec:technicalLifetime oec:defaultAccessLevel oec:Public .
oec:usageCycles oec:defaultAccessLevel oec:Public .
oec:repairabilityScore oec:defaultAccessLevel oec:Public .
oec:repairabilityClass oec:defaultAccessLevel oec:Public .
oec:repairabilityInfo oec:defaultAccessLevel oec:Public .
oec:repairInstructions oec:defaultAccessLevel oec:Public .
oec:repairInformationPortalUrl oec:defaultAccessLevel oec:Public .
oec:diyRepairPossible oec:defaultAccessLevel oec:Public .
oec:professionalRepairNetwork oec:defaultAccessLevel oec:Public .
oec:repairProvider oec:defaultAccessLevel oec:Public .
oec:repairProviderName oec:defaultAccessLevel oec:Public .
oec:repairProviderUrl oec:defaultAccessLevel oec:Public .
oec:sparePartsAvailability oec:defaultAccessLevel oec:Public .
oec:softwareUpdatesAvailability oec:defaultAccessLevel oec:Public .

# --- Public: energy labelling (EPREL is a public register) ---
oec:energyEfficiency oec:defaultAccessLevel oec:Public .
oec:energyEfficiencyClass oec:defaultAccessLevel oec:Public .
oec:annualEnergyConsumption oec:defaultAccessLevel oec:Public .
oec:powerConsumptionOn oec:defaultAccessLevel oec:Public .
oec:powerConsumptionOff oec:defaultAccessLevel oec:Public .
oec:powerConsumptionStandby oec:defaultAccessLevel oec:Public .
oec:eprelProductUrl oec:defaultAccessLevel oec:Public .
oec:eprelRegistrationNumber oec:defaultAccessLevel oec:Public .

