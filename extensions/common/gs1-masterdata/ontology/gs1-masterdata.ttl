@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gs1: <https://ref.gs1.org/voc/> .
@prefix gs1md: <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .

# =============================================================================
# Ontology Declaration
# =============================================================================

<https://ref.openepcis.io/extensions/common/gs1-masterdata/>
    a owl:Ontology ;
    dcterms:title "OpenEPCIS GS1 Master-Data Field Vocabulary"@en ;
    dcterms:description """Vocabulary of the flat served master-data field names exposed by the
OpenEPCIS Digital Link resolver for GS1 Product, Place, and Organization master data.

Each term corresponds 1:1 to a top-level field name in the resolver's served
master-data documents (bare names, no prefix). The vocabulary exists so that
access-tier defaults, rationales, and provenance can be curated per served
field, and so that per-field access enforcement in the resolver can be driven
from the same generated JSON as the other extension modules.

Nearly every term mirrors a property of the GS1 Web Vocabulary
(https://ref.gs1.org/voc/) under the identical local name; those terms carry
skos:exactMatch links to their GS1 counterparts. Terms without an identically
named GS1 property (flattened plurals or resolver-specific field shapes) carry
skos:closeMatch links to the nearest GS1 property instead.

System/facet fields of the resolver DTOs (accessLevel, isAnonymousAccessAllowed,
extensions, jws, type) are intentionally NOT part of this vocabulary: they are
envelope metadata, not master data."""@en ;
    dcterms:creator "OpenEPCIS" ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:created "2026-07-25"^^xsd:date ;
    dcterms:modified "2026-07-25"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    owl:versionIRI <https://ref.openepcis.io/extensions/common/gs1-masterdata/0.1.0> ;
    vann:preferredNamespacePrefix "gs1md" ;
    vann:preferredNamespaceUri "https://ref.openepcis.io/extensions/common/gs1-masterdata/" ;
    rdfs:seeAlso <https://ref.gs1.org/voc/> ;
    owl:imports <https://ref.gs1.org/voc/> .

# =============================================================================
# Product Master-Data Properties
# =============================================================================

gs1md:gtin
    a owl:DatatypeProperty ;
    rdfs:label "GTIN"@en ;
    rdfs:comment "A Global Trade Item Number (GTIN) is the 14 digit GS1 Identification Key used to identify products."@en ;
    skos:exactMatch gs1:gtin ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:productID
    a owl:DatatypeProperty ;
    rdfs:label "Product ID"@en ;
    rdfs:comment "Additional means to the Global Trade Item Number to identify a product."@en ;
    skos:exactMatch gs1:productID ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:productName
    a owl:DatatypeProperty ;
    rdfs:label "Product Name"@en ;
    rdfs:comment "Consumer friendly short description of the product suitable for compact presentation."@en ;
    skos:exactMatch gs1:productName ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:productDescription
    a owl:DatatypeProperty ;
    rdfs:label "Product Description"@en ;
    rdfs:comment "An understandable and useable description of a product using brand and other descriptors."@en ;
    skos:exactMatch gs1:productDescription ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:productRange
    a owl:DatatypeProperty ;
    rdfs:label "Product Range"@en ;
    rdfs:comment "A name, used by a Brand Owner, that span multiple consumer categories or uses."@en ;
    skos:exactMatch gs1:productRange ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:gpcCategoryCode
    a owl:DatatypeProperty ;
    rdfs:label "GPC Category Code"@en ;
    rdfs:comment "8-digit code (GPC Brick Value) specifying a product category according to the GS1 Global Product Classification (GPC) standard."@en ;
    skos:exactMatch gs1:gpcCategoryCode ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:gpcCategoryDescription
    a owl:DatatypeProperty ;
    rdfs:label "GPC Category Description"@en ;
    rdfs:comment "A description of the code specifying a product category according to the GS1 Global Product Classification (GPC) standard."@en ;
    skos:exactMatch gs1:gpcCategoryDescription ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:includedAccessories
    a owl:DatatypeProperty ;
    rdfs:label "Included Accessories"@en ;
    rdfs:comment "Any included object or device not part of the core product itself but which adds to its functionality or use."@en ;
    skos:exactMatch gs1:includedAccessories ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:isProductRecalled
    a owl:DatatypeProperty ;
    rdfs:label "Is Product Recalled"@en ;
    rdfs:comment "An indicator for the product to determine if the Manufacturer or Supplier has recalled the product."@en ;
    skos:exactMatch gs1:isProductRecalled ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

