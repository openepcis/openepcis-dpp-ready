gs1md:replacedByOrganization
    a owl:ObjectProperty ;
    rdfs:label "Replaced By Organization"@en ;
    rdfs:comment "Links to the successor organisation that is used in place of a previous organisation."@en ;
    skos:exactMatch gs1:replacedByOrganization ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:replacedOrganization
    a owl:ObjectProperty ;
    rdfs:label "Replaced Organization"@en ;
    rdfs:comment "Links to the previous organisation that this organisation replaces."@en ;
    skos:exactMatch gs1:replacedOrganization ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:usesManagedLocation
    a owl:ObjectProperty ;
    rdfs:label "Uses Managed Location"@en ;
    rdfs:comment "Links to the place(s) that this organisation uses as a managed space."@en ;
    skos:exactMatch gs1:usesManagedLocation ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:occupies
    a owl:ObjectProperty ;
    rdfs:label "Occupies"@en ;
    rdfs:comment "Links to the place(s) that this organisation occupies."@en ;
    skos:exactMatch gs1:occupies ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:subOrganization
    a owl:ObjectProperty ;
    rdfs:label "Sub Organization"@en ;
    rdfs:comment "Designates a legal entity or function directly below the organisation/party being identified in a hierarchy."@en ;
    skos:exactMatch gs1:subOrganization ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .
