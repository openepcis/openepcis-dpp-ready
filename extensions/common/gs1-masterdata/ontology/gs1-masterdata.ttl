    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:consumerHandlingStorage
    a owl:ObjectProperty ;
    rdfs:label "Consumer Handling Storage"@en ;
    rdfs:comment "Link to a website, file, or image containing the manufacturer's recommendations for how the consumer or end user should store and handle the product."@en ;
    skos:exactMatch gs1:consumerHandlingStorage ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:customerSupportCentre
    a owl:ObjectProperty ;
    rdfs:label "Customer Support Centre"@en ;
    rdfs:comment "The organization which provides product support to the trading partner organization to which merchandise is sold."@en ;
    skos:exactMatch gs1:customerSupportCentre ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:dependentProprietaryProduct
    a owl:ObjectProperty ;
    rdfs:label "Dependent Proprietary Product"@en ;
    rdfs:comment "Dependent products are products which are required to make the current product functional."@en ;
    skos:exactMatch gs1:dependentProprietaryProduct ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:equivalentProduct
    a owl:ObjectProperty ;
    rdfs:label "Equivalent Product"@en ;
    rdfs:comment "A product which can be substituted for the product based on supplier-defined functional equivalence to the product."@en ;
    skos:exactMatch gs1:equivalentProduct ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:inPackageDepth
    a owl:ObjectProperty ;
    rdfs:label "In Package Depth"@en ;
    rdfs:comment "The depth of the product in its packaging, as measured according to the GS1 Package Measurement Rules."@en ;
    skos:exactMatch gs1:inPackageDepth ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:inPackageDiameter
    a owl:ObjectProperty ;
    rdfs:label "In Package Diameter"@en ;
    rdfs:comment "The measurement of the diameter of the product in its package at its largest point."@en ;
    skos:exactMatch gs1:inPackageDiameter ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:inPackageHeight
    a owl:ObjectProperty ;
    rdfs:label "In Package Height"@en ;
    rdfs:comment "The height of the product in the package, as measured according to the GS1 Package Measurement Rules."@en ;
    skos:exactMatch gs1:inPackageHeight ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:inPackageWidth
    a owl:ObjectProperty ;
    rdfs:label "In Package Width"@en ;
    rdfs:comment "The width of the product in the package, as measured according to the GS1 Package Measurement Rules."@en ;
    skos:exactMatch gs1:inPackageWidth ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:massPerUnitArea
    a owl:ObjectProperty ;
    rdfs:label "Mass Per Unit Area"@en ;
    rdfs:comment "The mass per unit area of the item."@en ;
    skos:exactMatch gs1:massPerUnitArea ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:netArea
    a owl:ObjectProperty ;
    rdfs:label "Net Area"@en ;
    rdfs:comment "The net area of the item."@en ;
    skos:exactMatch gs1:netArea ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:netContent
    a owl:ObjectProperty ;
    rdfs:label "Net Content"@en ;
    rdfs:comment "The quantity of the product contained by a package, usually as claimed on the label."@en ;
    skos:exactMatch gs1:netContent ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:netWeight
    a owl:ObjectProperty ;
    rdfs:label "Net Weight"@en ;
    rdfs:comment "Used to identify the net weight of the product."@en ;
    skos:exactMatch gs1:netWeight ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:organicClaim
    a owl:ObjectProperty ;
    rdfs:label "Organic Claim"@en ;
    rdfs:comment "Relates to an organic claim about the product."@en ;
    skos:exactMatch gs1:organicClaim ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:outOfPackageDepth
    a owl:ObjectProperty ;
    rdfs:label "Out Of Package Depth"@en ;
    rdfs:comment "The depth of the product out of its packaging, as measured according to the GS1 Package Measurement Rules."@en ;
    skos:exactMatch gs1:outOfPackageDepth ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:outOfPackageDiameter
    a owl:ObjectProperty ;
    rdfs:label "Out Of Package Diameter"@en ;
    rdfs:comment "The measurement of the diameter of the product out of its package at its largest point."@en ;
    skos:exactMatch gs1:outOfPackageDiameter ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:outOfPackageHeight
    a owl:ObjectProperty ;
    rdfs:label "Out Of Package Height"@en ;
    rdfs:comment "The height of the product out of the package, as measured according to the GS1 Package Measurement Rules."@en ;
    skos:exactMatch gs1:outOfPackageHeight ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:outOfPackageWidth
    a owl:ObjectProperty ;
    rdfs:label "Out Of Package Width"@en ;
    rdfs:comment "The width of the product out of the package, as measured according to the GS1 Package Measurement Rules."@en ;
    skos:exactMatch gs1:outOfPackageWidth ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:packaging
    a owl:ObjectProperty ;
    rdfs:label "Packaging"@en ;
    rdfs:comment "Details on the packaging for a product including type, weight and materials."@en ;
    skos:exactMatch gs1:packaging ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:referencedFile
    a owl:ObjectProperty ;
    rdfs:label "Referenced File"@en ;
    rdfs:comment "Link to a file or website containing additional information on product."@en ;
    skos:exactMatch gs1:referencedFile ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:primaryAlternateProduct
    a owl:ObjectProperty ;
    rdfs:label "Primary Alternate Product"@en ;
    rdfs:comment "A product that is similar to the current product but is not exact match."@en ;
    skos:exactMatch gs1:primaryAlternateProduct ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:replacedByProduct
    a owl:ObjectProperty ;
    rdfs:label "Replaced By Product"@en ;
    rdfs:comment "The product which permanently replaces the current product."@en ;
    skos:exactMatch gs1:replacedByProduct ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:replacedProduct
    a owl:ObjectProperty ;
    rdfs:label "Replaced Product"@en ;
    rdfs:comment "Indicates the product identification of an item that is being permanently replaced by this product."@en ;
    skos:exactMatch gs1:replacedProduct ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:images
    a owl:ObjectProperty ;
    rdfs:label "Images"@en ;
    rdfs:comment "Referenced image files for the product (flattened plural of the GS1 image link)."@en ;
    skos:closeMatch gs1:image ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:instructionsForUse
    a owl:ObjectProperty ;
    rdfs:label "Instructions For Use"@en ;
    rdfs:comment "Link to a file containing the Instructions For Use."@en ;
    skos:exactMatch gs1:instructionsForUse ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:sizeCodes
    a owl:DatatypeProperty ;
    rdfs:label "Size Codes"@en ;
    rdfs:comment "Size codes assigned to the product (flattened plural of the GS1 size code)."@en ;
    skos:closeMatch gs1:sizeCode ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

# =============================================================================
# Place / Location Master-Data Properties
# =============================================================================

gs1md:additionalLocationID
    a owl:ObjectProperty ;
    rdfs:label "Additional Location ID"@en ;
    rdfs:comment "Location identifiers assigned and managed by government bodies, trade organisations, and other entities."@en ;
    skos:exactMatch gs1:additionalLocationID ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:address
    a owl:ObjectProperty ;
    rdfs:label "Address"@en ;
    rdfs:comment "The postal address for an organization or place."@en ;
    skos:exactMatch gs1:address ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:contactPoint
    a owl:ObjectProperty ;
    rdfs:label "Contact Point"@en ;
    rdfs:comment "Contact information."@en ;
    skos:exactMatch gs1:contactPoint ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:glnType
    a owl:DatatypeProperty ;
    rdfs:label "GLN Type"@en ;
    rdfs:comment "Indicates what type of thing is being identified by a GLN."@en ;
    skos:exactMatch gs1:glnType ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:globalLocationNumber
    a owl:DatatypeProperty ;
    rdfs:label "Global Location Number"@en ;
    rdfs:comment "A Global Location Number (GLN) is the GS1 Identification Key used to identify physical locations or parties."@en ;
    skos:exactMatch gs1:globalLocationNumber ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:locationGLN
    a owl:DatatypeProperty ;
    rdfs:label "Location GLN"@en ;
    rdfs:comment "13-digit GLN that is being used to identify a physical or digital location."@en ;
    skos:exactMatch gs1:locationGLN ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:afterHoursContact
    a owl:ObjectProperty ;
    rdfs:label "After Hours Contact"@en ;
    rdfs:comment "Links to after-hours contact information."@en ;
    skos:exactMatch gs1:afterHoursContact ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:baseLocation
    a owl:ObjectProperty ;
    rdfs:label "Base Location"@en ;
    rdfs:comment "A fixed physical location where a mobile location most commonly resides."@en ;
    skos:exactMatch gs1:baseLocation ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:digitalAddress
    a owl:DatatypeProperty ;
    rdfs:label "Digital Address"@en ;
    rdfs:comment "The location reference associated to a digital place."@en ;
    skos:exactMatch gs1:digitalAddress ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:digitalLocationName
    a owl:DatatypeProperty ;
    rdfs:label "Digital Location Name"@en ;
    rdfs:comment "The name of a digital place."@en ;
    skos:exactMatch gs1:digitalLocationName ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:geoCoordinates
    a owl:ObjectProperty ;
    rdfs:label "Geo Coordinates"@en ;
    rdfs:comment "Geographic coordinates (latitude/longitude) of the place."@en ;
    skos:closeMatch gs1:geo ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:geoShape
    a owl:ObjectProperty ;
    rdfs:label "Geo Shape"@en ;
    rdfs:comment "Geographic shape describing the boundary or area covered by the place."@en ;
    skos:closeMatch gs1:geo ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:leasedFrom
    a owl:ObjectProperty ;
    rdfs:label "Leased From"@en ;
    rdfs:comment "Links to the organisation (lessor) from which this place is leased."@en ;
    skos:exactMatch gs1:leasedFrom ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:leasedTo
    a owl:ObjectProperty ;
    rdfs:label "Leased To"@en ;
    rdfs:comment "Links to the organisation(s) (lessee(s)) to which this place is leased."@en ;
    skos:exactMatch gs1:leasedTo ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:locationHistory
    a owl:ObjectProperty ;
    rdfs:label "Location History"@en ;
    rdfs:comment "Provides details on if and when a location is active or inactive."@en ;
    skos:exactMatch gs1:locationHistory ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:locationRole
    a owl:DatatypeProperty ;
    rdfs:label "Location Role"@en ;
    rdfs:comment "A location classification based on the purpose, type of site and/or what occurs there."@en ;
    skos:exactMatch gs1:locationRole ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:managedBy
    a owl:ObjectProperty ;
    rdfs:label "Managed By"@en ;
    rdfs:comment "Links to the organisation that manages this place or organisation, as designated by the owner or another organisation."@en ;
    skos:exactMatch gs1:managedBy ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:managedFor
    a owl:ObjectProperty ;
    rdfs:label "Managed For"@en ;
    rdfs:comment "Links to the organisation(s) for whom this place is managed."@en ;
    skos:exactMatch gs1:managedFor ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:occupiedBy
    a owl:ObjectProperty ;
    rdfs:label "Occupied By"@en ;
    rdfs:comment "Links to the organisation(s) that occupy this place."@en ;
    skos:exactMatch gs1:occupiedBy ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:ownedBy
    a owl:ObjectProperty ;
    rdfs:label "Owned By"@en ;
    rdfs:comment "Links to the organisation(s) that own this place, in full or in part."@en ;
    skos:exactMatch gs1:ownedBy ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:physicalLocationName
    a owl:DatatypeProperty ;
    rdfs:label "Physical Location Name"@en ;
    rdfs:comment "The name of a physical place."@en ;
    skos:exactMatch gs1:physicalLocationName ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:primaryLocationOf
    a owl:ObjectProperty ;
    rdfs:label "Primary Location Of"@en ;
    rdfs:comment "Links to the organisation(s) that designate this place as its/their primary location."@en ;
    skos:exactMatch gs1:primaryLocationOf ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:relatedOrganization
    a owl:ObjectProperty ;
    rdfs:label "Related Organization"@en ;
    rdfs:comment "The organisation(s) associated with a place."@en ;
    skos:exactMatch gs1:relatedOrganization ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:replacedByPlace
    a owl:ObjectProperty ;
    rdfs:label "Replaced By Place"@en ;
    rdfs:comment "Links to the successor location that is used in place of a previous location."@en ;
    skos:exactMatch gs1:replacedByPlace ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:replacedPlace
    a owl:ObjectProperty ;
    rdfs:label "Replaced Place"@en ;
    rdfs:comment "Links to the previous location that this location replaces."@en ;
    skos:exactMatch gs1:replacedPlace ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:responsibleOrganization
    a owl:ObjectProperty ;
    rdfs:label "Responsible Organization"@en ;
    rdfs:comment "Links to the organisation that is directly responsible for this place."@en ;
    skos:exactMatch gs1:responsibleOrganization ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

