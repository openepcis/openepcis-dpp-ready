gs1md:provenanceStatement
    a owl:DatatypeProperty ;
    rdfs:label "Provenance Statement"@en ;
    rdfs:comment "Free text description of the region or place the product originates from."@en ;
    skos:exactMatch gs1:provenanceStatement ;
    rdfs:isDefinedBy <https://ref.openepcis.io/extensions/common/gs1-masterdata/> .

gs1md:regulatedProductName
    a owl:DatatypeProperty ;
    rdfs:label "Regulated Product Name"@en ;
    rdfs:comment "The prescribed, regulated or generic product name or denomination that describes the true nature of the product."@en ;
    skos:exactMatch gs1:regulatedProductName ;
