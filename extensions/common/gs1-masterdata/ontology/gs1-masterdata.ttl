gs1md:sellByDate
    a owl:DatatypeProperty ;
    rdfs:label "Sell By Date"@en ;
    rdfs:comment "The date specified by the manufacturer as the last date the retailer is to offer the product for sale to the consumer."@en ;
    skos:exactMatch gs1:sellByDate ;
