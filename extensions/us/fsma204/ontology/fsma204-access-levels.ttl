# Access-tier annotations for the US FSMA 204 extension (ESPR Article 9 tiers).
# One statement per term; merged into the module by scripts/build-json.ts.
#
# FSMA 204 (FDA Food Traceability Rule) is a US regime; the ESPR tier vocabulary
# is reused only to express default field visibility. The Food Traceability List
# category is a benign product classification (which FTL category the item falls
# under), curated Public. None marked oec:accessLevelMandatedBy; terms not listed
# default to AuthorizedOnly.

@prefix usfsma: <https://ref.openepcis.io/extensions/us/fsma204/> .
@prefix oec:    <https://ref.openepcis.io/extensions/common/core/> .


# --- Public: Food Traceability List category classification ---
usfsma:foodTraceabilityListCategory oec:defaultAccessLevel oec:Public .
