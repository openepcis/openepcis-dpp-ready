    oec:accessLevelRationale "The report identifier belongs to the Annex XIII(3) compliance test reports and has no function outside the authority audience." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1542> .

eubat:incidentReportUrl oec:defaultAccessLevel oec:Restricted ;
    oec:accessLevelRationale "Full incident reports function as safety submissions evaluated by market surveillance authorities (Chapter IX), beyond the Annex VII accident summary served to the Art. 14 audience." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1542> .

eubat:facilityIdentifier oec:defaultAccessLevel oec:Restricted ;
    oec:accessLevelRationale "Internal facility identifiers (GLN of the plant) map the physical supply chain for notified bodies and surveillance — the public sees the manufacturing place itself via eubat:manufacturingPlace; matches oec:facilityId (Restricted)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1542> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2023/1542> .

eubat:manufacturerIdentifier oec:defaultAccessLevel oec:Restricted ;
    oec:accessLevelRationale "The manufacturer's internal operator identifier serves authority cross-checks; public identification is already served by the Annex VI Part A manufacturer information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1542> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2023/1542> .

# =============================================================================
# Structural value-carriers: tier inherited from the embedding parent
# =============================================================================
# These properties never appear as independently served fields: their runtime
# visibility is governed entirely by the parent property/object that embeds
# them.

# Measurement/test-condition scaffolding (tier follows the measurement parent)
eubat:atSoC oec:accessLevelInherited true .
eubat:powerCapability oec:accessLevelInherited true .
eubat:stateOfChargeLevel oec:accessLevelInherited true .
eubat:soceMeasurementId oec:accessLevelInherited true .
eubat:note oec:accessLevelInherited true .

# TemperatureRange sub-values (tier follows the temperatureRange* parent)
eubat:maximumTemperature oec:accessLevelInherited true .
eubat:minimumTemperature oec:accessLevelInherited true .

# Carbon-footprint declaration sub-fields (tier follows carbonFootprintDeclaration)
eubat:carbonFootprintDeclarationId oec:accessLevelInherited true .
eubat:lifecycleStage oec:accessLevelInherited true .

# EU DoC evidence sub-fields (tier follows euDeclarationOfConformity)
eubat:declarationOfConformity oec:accessLevelInherited true .
eubat:euDeclarationOfConformityId oec:accessLevelInherited true .

# Notified-body organisation sub-fields (tier follows notifiedBody)
eubat:notifiedBodyName oec:accessLevelInherited true .
eubat:notifiedBodyNumber oec:accessLevelInherited true .

# Dismantling-document sub-fields (tier follows dismantlingDocuments)
eubat:documentType oec:accessLevelInherited true .
eubat:documentUrl oec:accessLevelInherited true .
eubat:mimeType oec:accessLevelInherited true .

# Label sub-fields (tier follows labels)
eubat:labelMeaning oec:accessLevelInherited true .
eubat:labelSubject oec:accessLevelInherited true .
eubat:labelSymbol oec:accessLevelInherited true .

# Material-recovery-target sub-fields (tier follows materialRecoveryTargets)
eubat:recoveryMaterial oec:accessLevelInherited true .
eubat:recoveryRate oec:accessLevelInherited true .

# Negative-event / excursion record sub-fields (tier follows negativeEvents)
eubat:incidentId oec:accessLevelInherited true .
eubat:temperatureExcursionId oec:accessLevelInherited true .
eubat:exceedanceThreshold oec:accessLevelInherited true .

# Hazard sub-field (tier follows hazardousSubstances; dpp-core marks the same
# name inherited)
eubat:hazardImpact oec:accessLevelInherited true .
