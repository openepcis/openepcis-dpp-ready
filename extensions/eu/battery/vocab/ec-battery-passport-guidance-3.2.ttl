<https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2#dp-67>
    a rdf:Property, cccev:InformationRequirement ;
    rdfs:label "Information on the status of the battery, defined as ‘original’, ‘repurposed’, ‘re-used’, ‘remanufactured’ or ‘waste’ [code list]"@en ;
    rdfs:comment "European Commission Battery Passport data point 67 (BR Annex XIII 4 (c)). Applicability as of Feb 2027 — EV: mandatory; LMT: mandatory; industrial: mandatory. Dynamic (folded from the EPCIS event stream at item level); access tier: legitimateInterest. Carried by schema:status, eubat:BatteryStatus. Status values map to the controlled individuals eubat:Original, eubat:Repurposed, eubat:Reused, eubat:Remanufactured, eubat:Waste; status transitions are EPCIS lifecycle events."@en ;
    skos:notation "67" ;
    dcterms:bibliographicCitation "BR Annex XIII 4 (c)"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2023/1542/oj> ;
    ecbp:lifecycle "dynamic" ;
    ecbp:accessTier "legitimateInterest" ;
    ecbp:typeOfInformation "Restricted: Only to persons with legitimate interest (individual battery)"@en ;
    ecbp:definedIn "BR Art 3(1)(32) for “remanufacturing” and 3(2)(2)(a) for “waste”"@en ;
    dcterms:replaces <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-67> ;
    ecbp:applicabilityEV "mandatory" ;
    ecbp:applicabilityLMT "mandatory" ;
    ecbp:applicabilityIndustrial "mandatory" ;
    ecbp:implementedBy schema:status ;
    rdfs:seeAlso schema:status ;
    ecbp:implementedBy eubat:BatteryStatus ;
    rdfs:seeAlso eubat:BatteryStatus ;
    ecbp:epcisExample "epcis/commissioning.jsonld" ;
    skos:editorialNote "Status values map to the controlled individuals eubat:Original, eubat:Repurposed, eubat:Reused, eubat:Remanufactured, eubat:Waste; status transitions are EPCIS lifecycle events."@en ;
    skos:note "European Commission Battery Passport guidance data point 67 (version 3.2, 2026-10-19). Applicability shown is the state as of February 2027 per the guidance table."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/3.2> .

