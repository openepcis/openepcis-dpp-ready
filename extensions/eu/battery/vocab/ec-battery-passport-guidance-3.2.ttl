    a rdf:Property, cccev:InformationRequirement ;
    rdfs:label "Unique identifier [unique product identifier]"@en ;
    rdfs:comment "European Commission Battery Passport data point 1 (BR Article 77 (3)). Applicability as of Feb 2027 — EV: mandatory; LMT: mandatory; industrial: mandatory. Static master data (resolver-served); access tier: public. Carried by oec:passportIdentifier. Served as a GS1 Digital Link URI; the passport identifier resolves via a GS1-conformant resolver."@en ;
    skos:notation "1" ;
    dcterms:bibliographicCitation "BR Article 77 (3)"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2023/1542/oj> ;
    ecbp:lifecycle "static" ;
    ecbp:accessTier "public" ;
    ecbp:typeOfInformation "Public"@en ;
    ecbp:definedIn "BR Art 3(1)(66)"@en ;
    dcterms:replaces <https://ref.openepcis.org/vocab/ec-battery-passport-guidance/1.0#dp-01> ;
    ecbp:applicabilityEV "mandatory" ;
    ecbp:applicabilityLMT "mandatory" ;
    ecbp:applicabilityIndustrial "mandatory" ;
    ecbp:implementedBy oec:passportIdentifier ;
    rdfs:seeAlso oec:passportIdentifier ;
    skos:editorialNote "Served as a GS1 Digital Link URI; the passport identifier resolves via a GS1-conformant resolver."@en ;
