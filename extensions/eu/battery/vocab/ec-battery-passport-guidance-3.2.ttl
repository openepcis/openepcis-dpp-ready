    ecbp:applicabilityEV "conditional" ;
    ecbp:applicabilityLMT "conditional" ;
    ecbp:applicabilityIndustrial "conditional" ;
    skos:scopeNote "EV: Applicable as soon as the battery starts to be used | LMT: Applicable as soon as the battery starts to be used | Industrial: Applicable as soon as the battery starts to be used"@en ;
    ecbp:implementedBy eubat:timeSpentInExtremeTemperaturesAboveBoundary ;
    rdfs:seeAlso eubat:timeSpentInExtremeTemperaturesAboveBoundary ;
    ecbp:implementedBy eubat:timeSpentInExtremeTemperaturesBelowBoundary ;
    rdfs:seeAlso eubat:timeSpentInExtremeTemperaturesBelowBoundary ;
    ecbp:epcisExample "epcis/temperature-extreme.jsonld" ;
    skos:editorialNote "Periodic recording is the EPCIS sensorElementList mechanism (sensorReport time series with sensorMetadata), not a master-data attribute."@en ;
    skos:note "European Commission Battery Passport guidance data point 70 (version 3.2, 2026-10-19). Applicability shown is the state as of February 2027 per the guidance table."@en ;
