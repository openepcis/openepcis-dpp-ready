<https://ref.openepcis.io/vocab/ec-battery-passport-guidance/1.0#dp-67>
    a rdf:Property, cccev:InformationRequirement ;
    rdfs:label "Information on the status of the battery, defined as 'original', 'repurposed', 're-used', 'remanufactured' or 'waste'"@en ;
    rdfs:comment "European Commission Battery Passport data point 67 (BR Annex XIII 4 (c)). Applicability as of Feb 2027 — EV: mandatory; LMT: mandatory; industrial: mandatory. Dynamic (folded from the EPCIS event stream at item level); access tier: legitimateInterest. Carried by schema:status, eubat:BatteryStatus. Status values map to the controlled individuals eubat:Original, eubat:Repurposed, eubat:Reused, eubat:Remanufactured, eubat:Waste; status transitions are EPCIS lifecycle events."@en ;
    skos:notation "67" ;
    dcterms:bibliographicCitation "BR Annex XIII 4 (c)"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2023/1542/oj> ;
