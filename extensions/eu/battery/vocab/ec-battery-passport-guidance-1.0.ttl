    ecbp:accessTier "legitimateInterest" ;
    ecbp:applicabilityEV "mandatory" ;
    ecbp:applicabilityLMT "mandatory" ;
    ecbp:applicabilityIndustrial "mandatory" ;
    ecbp:implementedBy schema:status ;
    rdfs:seeAlso schema:status ;
    ecbp:implementedBy eubat:BatteryStatus ;
    rdfs:seeAlso eubat:BatteryStatus ;
    ecbp:epcisExample "epcis/commissioning.jsonld" ;
    skos:editorialNote "Status values map to the controlled individuals eubat:Original, eubat:Repurposed, eubat:Reused, eubat:Remanufactured, eubat:Waste; status transitions are EPCIS lifecycle events."@en ;
    skos:note "European Commission Battery Passport guidance data point 67 (Ares(2026)7579758, v1.0). Applicability shown is the state as of February 2027 per the guidance table."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.io/vocab/ec-battery-passport-guidance/1.0> .

