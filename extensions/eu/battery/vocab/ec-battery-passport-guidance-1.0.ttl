    a rdf:Property, cccev:InformationRequirement ;
    rdfs:label "Unique identifier"@en ;
    rdfs:comment "European Commission Battery Passport data point 1 (BR Article 77 (3)). Applicability as of Feb 2027 — EV: mandatory; LMT: mandatory; industrial: mandatory. Static master data (resolver-served); access tier: public. Carried by eubat:batteryPassportIdentifier. Served as a GS1 Digital Link URI; the passport identifier resolves via a GS1-conformant resolver."@en ;
    skos:notation "1" ;
    dcterms:bibliographicCitation "BR Article 77 (3)"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2023/1542/oj> ;
    ecbp:lifecycle "static" ;
    ecbp:accessTier "public" ;
    ecbp:applicabilityEV "mandatory" ;
    ecbp:applicabilityLMT "mandatory" ;
    ecbp:applicabilityIndustrial "mandatory" ;
    ecbp:implementedBy eubat:batteryPassportIdentifier ;
    rdfs:seeAlso eubat:batteryPassportIdentifier ;
    skos:editorialNote "Served as a GS1 Digital Link URI; the passport identifier resolves via a GS1-conformant resolver."@en ;
    skos:note "European Commission Battery Passport guidance data point 1 (Ares(2026)7579758, v1.0). Applicability shown is the state as of February 2027 per the guidance table."@en ;
    rdfs:isDefinedBy <https://ref.openepcis.io/vocab/ec-battery-passport-guidance/1.0> .

