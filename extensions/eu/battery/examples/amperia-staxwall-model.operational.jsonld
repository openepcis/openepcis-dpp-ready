  "productDescription": [
    {
      "@language": "en",
      "@value": "10 kWh wall-mounted lithium iron phosphate (LFP) home energy storage battery for residential solar self-consumption and backup power. Modular, stackable, with an integrated battery management system."
    },
    {
      "@language": "de",
      "@value": "10-kWh-Wandspeicher auf Lithium-Eisenphosphat-Basis (LFP) für den privaten Solar-Eigenverbrauch und die Notstromversorgung. Modular, stapelbar, mit integriertem Batteriemanagementsystem."
    },
    {
      "@language": "fr",
      "@value": "Batterie domestique murale de 10 kWh au lithium-fer-phosphate (LFP) pour l'autoconsommation solaire résidentielle et l'alimentation de secours. Modulaire, empilable, avec système de gestion de batterie intégré."
    }
  ],
