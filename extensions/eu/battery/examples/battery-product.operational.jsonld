  "productDescription": [
    {
      "@language": "en",
      "@value": "High-capacity lithium iron phosphate battery module for industrial energy storage. Designed for long cycle life and safety."
    },
    {
      "@language": "de",
      "@value": "Hochkapazitäts-LFP-Batteriemodul für industrielle Energiespeicherung. Entwickelt für lange Zyklenlebensdauer und Sicherheit."
    },
    {
      "@language": "fr",
      "@value": "Module de batterie LFP haute capacité pour le stockage d'énergie industriel. Conçu pour une longue durée de vie cyclique et la sécurité."
    },
    {
      "@language": "es",
      "@value": "Módulo de batería LFP de alta capacidad para almacenamiento energético industrial. Diseñado para una larga vida útil de ciclos y seguridad."
    },
    {
      "@language": "nl",
      "@value": "Lithium-ijzerfosfaat-batterijmodule met hoge capaciteit voor industriële energieopslag. Ontworpen voor een lange cyclusduur en veiligheid."
    },
    {
      "@language": "da",
      "@value": "LFP-batterimodul med høj kapacitet til industriel energilagring. Designet til lang cyklus-levetid og sikkerhed."
    },
    {
      "@language": "pl",
      "@value": "Moduł akumulatora litowo-żelazowo-fosforanowego (LFP) o dużej pojemności do magazynowania energii w przemyśle. Zaprojektowany z myślą o długiej żywotności cyklicznej i bezpieczeństwie."
    },
    {
      "@language": "sv",
      "@value": "LFP-batterimodul med hög kapacitet för industriell energilagring. Konstruerad för lång cykellivslängd och säkerhet."
    },
    {
      "@language": "no",
      "@value": "LFP-batterimodul med høy kapasitet for industriell energilagring. Designet for lang syklus-levetid og sikkerhet."
    },
    {
      "@language": "fi",
      "@value": "Suurkapasiteettinen LFP-akkumoduuli teolliseen energiavarastointiin. Suunniteltu pitkän käyttöiän ja turvallisuuden ehdoilla."
    },
    {
      "@language": "it",
      "@value": "Modulo batteria LFP ad alta capacità per lo stoccaggio energetico industriale. Progettato per una lunga durata ciclica e sicurezza."
    }
  ],
