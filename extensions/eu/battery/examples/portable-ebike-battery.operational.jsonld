  "productDescription": [
    {
      "@language": "en",
      "@value": "48 V / 14 Ah LMT (Light Means of Transport) NMC622 battery pack, eligible for stationary second-life reuse."
    },
    {
      "@language": "de",
      "@value": "48-V/14-Ah-Akku für leichte Elektrofahrzeuge (LMT) auf NMC622-Basis, geeignet für die stationäre Zweitnutzung."
    },
    {
      "@language": "fr",
      "@value": "Batterie 48 V / 14 Ah pour véhicules de mobilité légère (LMT) en chimie NMC622, éligible à un usage stationnaire en seconde vie."
    },
    {
      "@language": "es",
      "@value": "Batería 48 V / 14 Ah para vehículos ligeros (LMT) con química NMC622, apta para reutilización estacionaria en segunda vida."
