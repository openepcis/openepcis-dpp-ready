    "bpsamm-scdd": "urn:samm:io.BatteryPass.SupplyChainDueDiligence:1.2.0#",
    "bpr": "https://ref.openepcis.org/vocab/batterypass-ready/1.3#",
    "DPPSchemaVersion": {
