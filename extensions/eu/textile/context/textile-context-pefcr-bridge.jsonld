{
  "@context": {
    "@version": 1.1,
    "gs1": "https://ref.gs1.org/voc/",
    "eutex": "https://ref.openepcis.org/extensions/eu/textile/",
    "pef": "http://lca.jrc.ec.europa.eu/lcainfohub/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "oea": "https://ref.openepcis.org/extensions/common/assessment/",
    "oec": "https://ref.openepcis.org/extensions/common/core/",
    "EnvironmentalFootprint": "eutex:EnvironmentalFootprint",
    "LCIACategory": "eutex:LCIACategory",
    "environmentalFootprint": {
      "@id": "eutex:hasEnvironmentalFootprint",
      "@type": "@id"
    },
    "dataTypeIndicator": {
      "@id": "eutex:hasDataTypeIndicator",
      "@type": "@id"
    },
    "method": {
      "@id": "oea:hasMethod",
      "@type": "@id"
    },
    "methodName": "oea:methodName",
    "indicators": {
      "@id": "oea:hasIndicator",
      "@type": "@id",
      "@container": "@set"
    },
    "indicatorKind": {
      "@id": "oea:hasIndicatorKind",
      "@type": "@vocab"
    },
    "indicatorValue": {
      "@id": "oea:hasIndicatorValue",
      "@type": "@id"
    },
    "lciaCategories": {
      "@id": "eutex:hasLciaCategories",
      "@type": "@id",
      "@container": "@set"
    },
    "lciaCategoryCode": {
      "@id": "oea:hasObservedParameter",
      "@type": "@id"
    },
    "lciaUnit": "oec:declaredUnit",
    "PrimaryData": "eutex:PrimaryData",
    "SecondaryData": "eutex:SecondaryData",
    "MixedData": "eutex:MixedData",
    "GWP": "eutex:GWP",
    "WaterUse": "eutex:WaterUse",
    "Eutrophication": "eutex:Eutrophication",
    "Acidification": "eutex:Acidification",
    "Ecotoxicity": "eutex:Ecotoxicity",
    "HumanToxicity": "eutex:HumanToxicity",
    "measuredValue": {
      "@id": "oea:hasMeasuredValue",
      "@type": "@id"
    },
    "value": "gs1:value",
    "unitCode": "gs1:unitCode",
    "ManufacturingCarbonFootprint": "eutex:ManufacturingCarbonFootprint",
    "PEFSingleScore": "eutex:PEFSingleScore",
    "BenchmarkPerformance": "eutex:BenchmarkPerformance",
    "CarbonFootprintClass": "eutex:CarbonFootprintClass",
    "EnvironmentalFootprintClass": "eutex:EnvironmentalFootprintClass"
  }
}
