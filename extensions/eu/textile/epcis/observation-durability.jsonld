                    "gs1:value": 4,
                    "gs1:unitCode": "C62"
                  }
                },
                {
                  "type": "oea:MeasurementResult",
                  "oea:hasObservedParameter": {
                    "@id": "eutex:FabricAppearance"
                  },
                  "oea:hasMeasuredValue": {
