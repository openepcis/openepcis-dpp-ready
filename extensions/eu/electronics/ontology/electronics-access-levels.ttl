# Access-tier annotations for the EU Electronics extension (ESPR Article 9 tiers).
# One entry per term; merged into the module by scripts/build-json.ts.
#
# Re-curated with per-term oec:accessLevelRationale and oec:accessLevelSource.
# The EPREL register fields are locked Public via oec:accessLevelMandatedBy:
# the in-force Energy Labelling Regulation (EU) 2017/1369 (Art. 12(3)) fixes
# the public part of EPREL. Everything else is an overridable default grounded
# in the most specific in-force act (smartphone/tablet ecodesign (EU) 2023/1670,
# displays energy labelling (EU) 2019/2013, WEEE 2012/19/EU, RoHS 2011/65/EU,
# REACH (EC) 1907/2006) or in ESPR (EU) 2024/1781 where no product-specific act
# applies yet. Structural value-carriers of the software-update EPCIS event are
# declared oec:accessLevelInherited (governed by the embedding
# softwareUpdateEvent). Terms not listed default to AuthorizedOnly.

@prefix euelec: <https://ref.openepcis.io/extensions/eu/electronics/> .
@prefix oec:    <https://ref.openepcis.io/extensions/common/core/> .


# =============================================================================
# Public: model identity & EU energy label (EPREL public part)
# =============================================================================

euelec:modelIdentifier oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The model identifier is inherently public product identity and, for energy-labelled products, part of the public EPREL entry (Reg. (EU) 2017/1369 Art. 12(3))." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:hasEnergyEfficiency oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The energy-label information container carries data that Reg. (EU) 2017/1369 puts on the public label and in the public part of EPREL." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:hasEnergyEfficiencyClass oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The A-G energy class is printed on the public energy label and published in the public part of EPREL (Reg. (EU) 2017/1369 Art. 12(3))." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:energyLabelUrl oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The energy-label image is itself a public label; EPREL serves it in its public part (Reg. (EU) 2017/1369 Art. 12(3))." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:hasAnnualEnergyConsumption oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Annual energy consumption appears on the public energy label and product information sheet in EPREL (Reg. (EU) 2017/1369 Art. 12(3)); aligned with core oec:hasAnnualEnergyConsumption (Public)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:hasPowerConsumptionOn oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "On-mode power is product-information-sheet data of the energy-labelling framework, public where a delegated act applies; aligned with core oec:hasPowerConsumptionOn (Public)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:hasPowerConsumptionOff oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Off-mode power is product-information-sheet data of the energy-labelling framework, public where a delegated act applies; aligned with core oec:hasPowerConsumptionOff (Public)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:hasPowerConsumptionStandby oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Standby power is product-information-sheet data of the energy-labelling framework, public where a delegated act applies; aligned with core oec:hasPowerConsumptionStandby (Public)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:eprelProductUrl oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The EPREL product page is the public register entry itself (Reg. (EU) 2017/1369 Art. 12(3))." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2017/1369> .
euelec:eprelRegistrationNumber oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The EPREL registration number keys the public register entry and is visible in every public EPREL URL (Reg. (EU) 2017/1369 Art. 12(3))." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2017/1369> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2017/1369> .

# =============================================================================
# Public: repairability index & criteria (consumer-facing repair label;
# ESPR Annex I repairability parameters)
# =============================================================================

euelec:hasRepairabilityIndex oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The repairability index is a consumer-facing point-of-sale label (French Indice de Reparabilite; ESPR Annex I repairability)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasRepairabilityClass oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The A-E repairability class is the consumer-facing band of the repair assessment; aligned with core oec:repairabilityClass (Public)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:repairabilityLabelUrl oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The repairability label image is a public consumer label." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:displayScore oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The 0-10 display score is the consumer-facing figure printed on the repairability label." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:totalScore oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The 0-100 total score is the published aggregate behind the consumer-facing repairability label." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasRepairCriteria oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Per-criterion scores are published alongside the repairability index so consumers can see how the score was reached." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasCriterionType oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The criterion type identifies which published repairability criterion a score belongs to." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:criterionScore oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Per-criterion scores substantiate the public repairability index." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:criterionMaxScore oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The criterion maximum makes the public per-criterion score interpretable." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:criterionDetails oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The criterion explanation is part of the published substantiation of the repairability index." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasAssessmentBody oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Who assessed the repairability index is transparency information that makes the public score credible." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:assessmentDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The assessment date tells consumers how current the public repairability score is." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:isReplaceable oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Component replaceability is consumer repair information (ESPR Annex I; smartphone/tablet ecodesign requires replaceable parts)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasComponentType oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The component type (battery, display) names the part a public repair statement refers to, without exposing sourcing detail." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasReplacementDifficulty oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Replacement difficulty is consumer repair information that informs the repair-or-replace decision." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .

# =============================================================================
# Public: spare parts & software/firmware support horizons (Reg. (EU)
# 2023/1670 obliges smartphone/tablet makers to publish spare-part and
# update-support information; used as the module-wide default grounding)
# =============================================================================

euelec:hasSparePartAvailabilityYears oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Spare-part availability periods are consumer information that Reg. (EU) 2023/1670 requires to be made publicly available for smartphones/tablets." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:hasSparePartPrice oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Spare-part pricing is consumer repair-decision information that Reg. (EU) 2023/1670 requires professional repairers and end-users to be able to see." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:hasSoftwareSupport oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The software-support container carries update-horizon commitments that Reg. (EU) 2023/1670 makes consumer-facing." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:hasSecuritySupportYears oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The guaranteed security-update period is a purchase-decision commitment (Reg. (EU) 2023/1670 requires 5 years of OS/security updates)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:securityUpdateEndDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The security-update end date is the concrete form of the public update-support commitment." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:hasFeatureSupportYears oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The feature-update period is a consumer-facing support commitment of the same nature as security support." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:featureUpdateEndDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The feature-update end date is the concrete form of the public update-support commitment." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:firmwareVersion oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The current firmware version is device-state transparency a user can read from the device itself." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:osVersion oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The current OS version is device-state transparency a user can read from the device itself." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:latestUpdateDate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The date of the latest update shows whether the public support commitment is being honoured." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .
euelec:updateChannel oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "How to obtain updates is consumer use information required for the update commitment to be actionable." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2023/1670> .

# =============================================================================
# Public: display technical specifications (public product fiche data under
# the displays energy-labelling act (EU) 2019/2013 and ordinary spec-sheet
# information)
# =============================================================================

euelec:hasDisplaySpecification oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Display specifications are spec-sheet data, published in the public EPREL fiche for displays under Reg. (EU) 2019/2013." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg_del/2019/2013> .
euelec:displayTechnology oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The panel technology is ordinary public spec-sheet information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg_del/2019/2013> .
euelec:hasScreenDiagonal oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Screen diagonal appears on the public energy label for displays (Reg. (EU) 2019/2013)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg_del/2019/2013> .
euelec:screenResolutionWidth oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Screen resolution appears on the public energy label and fiche for displays (Reg. (EU) 2019/2013)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg_del/2019/2013> .
euelec:screenResolutionHeight oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Screen resolution appears on the public energy label and fiche for displays (Reg. (EU) 2019/2013)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg_del/2019/2013> .
euelec:hasRefreshRate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Refresh rate is ordinary public spec-sheet information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg_del/2019/2013> .
euelec:hasPeakBrightness oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Peak brightness is ordinary public spec-sheet information also used in the public energy-label calculation for displays." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg_del/2019/2013> .

# =============================================================================
# Public: recyclability & WEEE/RoHS compliance claims (WEEE Art. 14 obliges
# user-facing collection information; RoHS conformity is declared publicly
# via CE marking)
# =============================================================================

euelec:recyclabilityRate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The recyclable fraction is a consumer-facing circularity claim tied to the WEEE recovery targets (Dir. 2012/19/EU Annex V); aligned with core oec:recyclabilityRate (Public)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:recoverabilityRate oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The recoverable fraction is a consumer-facing circularity claim tied to the WEEE recovery targets (Dir. 2012/19/EU Annex V)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:collectionSchemeUrl oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Dir. 2012/19/EU Art. 14 requires users to be informed about return and collection systems, so the scheme link must be public to serve its purpose." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hasWeeeCompliance oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The WEEE-compliance container carries user-facing collection and recyclability information (Dir. 2012/19/EU Art. 14); producer-registration specifics inside it are tiered separately." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hasRohsCompliance oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "RoHS conformity information backs the CE marking, a public conformity claim (Dir. 2011/65/EU)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2011/65> .
euelec:rohsCompliant oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The RoHS pass/fail status is a public conformity claim expressed by the CE marking (Dir. 2011/65/EU)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2011/65> .
euelec:rohsDeclarationUrl oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The RoHS declaration document is the published substantiation of the public conformity claim." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2011/65> .
euelec:rohsExemptions oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Claimed RoHS exemptions (Annex III/IV codes) qualify the public conformity claim and are themselves published lists." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2011/65> .

# =============================================================================
# AuthorizedOnly: bill of materials & component sourcing detail
# =============================================================================

euelec:hasBillOfMaterials oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The component BOM is design and sourcing detail for repairers, recyclers and authorities with a legitimate interest, not consumer information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasComponents oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The component list is BOM content and shares the BOM's legitimate-interest tier." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:componentPartNumber oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Manufacturer part numbers reveal sourcing relationships and are professional repair/recycling detail." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasComponentPassport oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Links into nested component passports expose the component supply chain and are aimed at professional actors (CIRPASS-2 multi-component tracking)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .

# =============================================================================
# AuthorizedOnly: IEC 62474 material/substance declarations (REACH Art. 33
# channels substance information to recipients of the article, i.e. the
# professional supply chain)
# =============================================================================

euelec:hasMaterialDeclaration oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The IEC 62474 declaration is detailed substance composition communicated through the professional supply chain per REACH Art. 33(1); the consumer-facing hazard summary lives in public SoC fields." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2006/1907> .
euelec:materialDeclarationDate oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The declaration date is administrative detail of the professional material declaration." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2006/1907> .
euelec:iec62474DslVersion oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The declarable-substance-list version is methodology metadata of the professional material declaration." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2006/1907> .

# =============================================================================
# AuthorizedOnly: WEEE producer-registration specifics & raw update event log
# =============================================================================

euelec:weeeRegistrationNumber oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The producer registration number (Dir. 2012/19/EU Art. 16) is EPR administration data for registers and authorities, not consumer information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:weeeRegistrationCountry oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The registration country is EPR administration detail accompanying the producer registration number." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hasSoftwareUpdateEvent oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The raw per-device update event log is operational lifecycle data for service and surveillance actors; the public tier carries the aggregated support-status fields instead." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .

# =============================================================================
# Inherited: structural value-carriers of the software-update EPCIS event
# (no tier of their own; governed by euelec:hasSoftwareUpdateEvent). Previously
# annotated Public, which was dead weight under an AuthorizedOnly parent.
# =============================================================================

euelec:updateType oec:accessLevelInherited true .
euelec:updateSource oec:accessLevelInherited true .
euelec:newVersion oec:accessLevelInherited true .
euelec:previousVersion oec:accessLevelInherited true .

# =============================================================================
# AuthorizedOnly: WEEE collection / sorting / treatment event data. These are
# operational records of what a collector or authorised treatment operator did
# with one item. WEEE 2012/19/EU Art. 14 makes the collection *scheme* public
# (see euelec:collectionSchemeUrl above) and Annex V makes the *targets* public,
# but per-item treatment records are for treatment operators, producer-
# responsibility schemes and enforcement authorities.
# =============================================================================

euelec:collectionMethod oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Which collection route one item took is take-back scheme operating data; the public tier carries the scheme itself via euelec:collectionSchemeUrl." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:deviceCondition oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The intake condition assessment is a treatment-operator judgement about one waste item (Dir. 2012/19/EU Art. 8), not product information." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:dataWiped oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Data-erasure assertions concern one device's handling before re-use and are evidence for the operator and the previous owner, not public product data." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:sortingDecision oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The routing decision taken at a sorting facility is operational treatment data (Dir. 2012/19/EU Art. 8)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hasHazardousMaterialsIdentified oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Selective-treatment findings (Dir. 2012/19/EU Annex VII) are addressed to treatment operators; the consumer-facing substance summary lives in the RoHS and substance-of-concern fields." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hasEstimatedRecoverableMaterials oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Pre-treatment recoverability estimates are recycler planning data; the public tier carries the design-level euelec:recyclabilityRate and euelec:recoverabilityRate." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:recyclingProcess oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The applied treatment process is operator process data (Dir. 2012/19/EU Art. 8 and Annex VIII)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hasRecyclingFacility oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Which authorised operator treated one item is supply-chain detail for schemes and authorities; the facility's own master data is resolver-served under its GLN." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hasMaterialRecoveryResults oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Achieved per-item recovery figures are reported to producer-responsibility schemes and authorities against the Dir. 2012/19/EU Annex V targets; the public tier carries the design-level rates." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hasBatteryDisposition oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "How the removed battery was handled is treatment-chain evidence for the selective-treatment duty (Dir. 2012/19/EU Annex VII)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .
euelec:hazardousWasteGenerated oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Whether hazardous waste arose is waste-classification data under Dir. 2008/98/EC, addressed to operators and authorities." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2008/98> .
euelec:hasHazardousWasteRecord oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Hazardous waste consignment records are regulatory documentation held between the operator and the competent authority (Dir. 2008/98/EC)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2008/98> .
euelec:hasAvoidedEmissions oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Avoided-emissions estimates are recycler claims about one treatment operation; unlike a substantiated product carbon footprint they are not verified label data, so they are not published by default." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:nextDisposition oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The intended onward route of a removed part is treatment-chain planning data (Dir. 2012/19/EU Art. 8)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/dir/2012/19> .

# =============================================================================
# AuthorizedOnly: repair / component-replacement event data. Repair records
# name service actors, costs and warranty state for one device; ESPR 2024/1781
# and Dir. (EU) 2024/1799 make the repair *offer* public (spare-part prices,
# repairability index above), not the individual repair history.
# =============================================================================

euelec:repairType oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "What was repaired on one device is service-history data for repairers, owners and surveillance actors, not a public product attribute." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:repairDescription oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The repair narrative is service-history detail of one device." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:repairTechnician oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Naming who performed a repair identifies a service party in a specific transaction; the public tier carries the published repair network (oec:RepairProvider)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:removalReason oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Why a part failed on one device is service-history and failure-analysis data; the public tier carries the aggregate durability and repairability figures." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasReplacedComponentPassport oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Links into component passports expose the component supply chain, matching the tier of euelec:hasComponentPassport." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasInstalledComponentPassport oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Links into component passports expose the component supply chain, matching the tier of euelec:hasComponentPassport." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:warrantyStatus oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Whether one item was in warranty at the time of a repair is a commercial fact between owner, seller and repairer; the warranty terms themselves are model master data." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .
euelec:hasRepairCost oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "What one repair actually cost is transaction data; the publicly required figure is the spare-part price (euelec:hasSparePartPrice, Public)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/1781> .

# =============================================================================
# Inherited: structural value-carriers nested inside the WEEE treatment and
# repair event containers above (no tier of their own; governed by the
# embedding property).
# =============================================================================

euelec:handlingNote oec:accessLevelInherited true .
euelec:materialMassGrams oec:accessLevelInherited true .
euelec:totalInputMassGrams oec:accessLevelInherited true .
euelec:totalRecoveredMassGrams oec:accessLevelInherited true .
euelec:recoveryRate oec:accessLevelInherited true .
euelec:recyclingRate oec:accessLevelInherited true .
euelec:energyRecoveryRate oec:accessLevelInherited true .
euelec:batteryMassGrams oec:accessLevelInherited true .
euelec:separatelyTreated oec:accessLevelInherited true .
euelec:hasTreatmentFacility oec:accessLevelInherited true .
euelec:treatmentMethod oec:accessLevelInherited true .
euelec:wasteDescription oec:accessLevelInherited true .
euelec:treatmentCertificate oec:accessLevelInherited true .
euelec:avoidedEmissionsKgCO2e oec:accessLevelInherited true .
euelec:calculationMethod oec:accessLevelInherited true .
