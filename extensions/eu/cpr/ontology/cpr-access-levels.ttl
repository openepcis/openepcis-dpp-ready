# Access-tier annotations for the EU CPR extension (ESPR Article 9 tiers).
# One entry per term; merged into the module by scripts/build-json.ts.
#
# Re-curated with per-term oec:accessLevelRationale and oec:accessLevelSource,
# grounded in the Construction Products Regulation (EU) 2024/3110 (in force and
# applicable). The CPR obliges manufacturers to draw up a Declaration of
# Performance and Conformity and supply/make it available with every product
# (Art. 13 ff., including in digital form via permalink), which legally fixes a
# public audience for the DoP and its declared content - those terms are locked
# Public via oec:accessLevelMandatedBy. AVCP-body involvement and supporting
# test reports are technical-documentation detail for authorities and
# professional users (overridable defaults). Generic name/value carriers of an
# essential characteristic are declared oec:accessLevelInherited. Terms not
# listed default to AuthorizedOnly.

@prefix eucpr: <https://ref.openepcis.io/extensions/eu/cpr/> .
@prefix oec:   <https://ref.openepcis.io/extensions/common/core/> .


# --- Public: the Declaration of Performance and its declared content ---

eucpr:hasDeclarationOfPerformance oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The DoP is the document the CPR obliges manufacturers to supply with the product and keep available, so its content is public by design (Reg. (EU) 2024/3110 Art. 13 ff.)." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:declarationOfPerformanceUrl oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The CPR foresees digital supply of the DoP via a permanent link, which only works if the link is public." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:declarationCode oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The DoP reference number is printed on the public declaration and identifies it." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:dateOfIssue oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The issue date is part of the public DoP document content." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:hasEssentialCharacteristic oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Declared essential characteristics are the core content of the public DoP that specifiers and users rely on." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:harmonisedStandard oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The harmonised technical specification under which performance is declared is stated in the public DoP." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:hasAvcpSystem oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The applicable AVCP system is stated in the public DoP." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:hasCompressiveStrength oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Declared compressive strength is an essential characteristic published in the DoP." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:hasThermalConductivity oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "Declared thermal conductivity is an essential characteristic published in the DoP." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:hasReactionToFireClass oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The EN 13501-1 reaction-to-fire class is a safety-critical declared characteristic published in the DoP." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> ;
    oec:accessLevelMandatedBy <https://eur-lex.europa.eu/eli/reg/2024/3110> .

eucpr:hasConstructionProductType oec:defaultAccessLevel oec:Public ;
    oec:accessLevelRationale "The product-type classification is basic public product information needed to find and read the DoP, though not itself DoP content fixed by the CPR." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> .

# --- AuthorizedOnly: AVCP bodies and supporting technical documents ---

eucpr:hasNotifiedBody oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Notified-body involvement detail (full OperatorInformation with address) is AVCP process data for authorities and professional users beyond the NB number cited on the DoP." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:hasTechnicalAssessmentBody oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "TAB involvement is assessment-process detail for authorities and professional users of the ETA route." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:hasEuropeanAssessmentDocument oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "The EAD reference points into the technical-assessment file used where no harmonised standard applies, professional detail behind the public declaration." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> .
eucpr:hasValidationReports oec:defaultAccessLevel oec:AuthorizedOnly ;
    oec:accessLevelRationale "Supporting test/validation reports are technical documentation made available to surveillance authorities on request, not published with the DoP." ;
    oec:accessLevelSource <https://eur-lex.europa.eu/eli/reg/2024/3110> .

# --- Inherited: generic name/value carriers of a declared essential
# --- characteristic (governed by eucpr:hasEssentialCharacteristic) ---

eucpr:characteristicName oec:accessLevelInherited true .
eucpr:hasCharacteristicValue oec:accessLevelInherited true .
