{
  "name": "openepcis-dpp-ready",
  "version": "0.9.9",
  "description": "OpenEPCIS Digital Product Passport Ontologies",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsx scripts/build-json.ts && tsx scripts/check-vocab.ts && tsx scripts/check-extension-terms.ts && tsx scripts/check-granularity.ts && tsx scripts/check-identifiers.ts && tsx scripts/check-gs1-domains.ts && tsx scripts/check-mappings.ts && tsx scripts/check-operational-contexts.ts && tsx scripts/check-access-levels.ts && tsx scripts/en18223/idempotence-check.ts && tsx scripts/en18223/golden-fidelity-check.ts && tsx scripts/en18223/roundtrip-check.ts && tsx scripts/release.ts --check",
    "build:json": "tsx scripts/build-json.ts",
    "check:vocab": "tsx scripts/check-vocab.ts",
    "check:extension-terms": "tsx scripts/check-extension-terms.ts",
    "check:operational": "tsx scripts/check-operational-contexts.ts",
    "check:idempotence": "tsx scripts/en18223/idempotence-check.ts",
    "check:golden-fidelity": "tsx scripts/en18223/golden-fidelity-check.ts",
    "check:roundtrip": "tsx scripts/en18223/roundtrip-check.ts",
    "check:granularity": "tsx scripts/check-granularity.ts",
    "check:identifiers": "tsx scripts/check-identifiers.ts",
    "check:domains": "tsx scripts/check-gs1-domains.ts",
    "check:mappings": "tsx scripts/check-mappings.ts",
    "skos:triage": "tsx scripts/triage-skos-report.ts",
    "skos:apply": "tsx scripts/apply-skos-triage.ts",
    "skos:decisions": "tsx scripts/build-skos-open-decisions.ts",
    "check:access-levels": "tsx scripts/check-access-levels.ts",
    "check:env-passports": "tsx scripts/check-env-passports.ts",
    "export:access-matrix": "tsx scripts/export-access-matrix.ts",
    "sync:vocab": "tsx scripts/check-vocab.ts --sync",
    "build:context": "tsx scripts/build-context.ts",
    "build:extension-schemas": "tsx scripts/build-extension-schemas.ts",
    "build:batterypass-schema": "tsx scripts/build-batterypass-schema.ts",
    "export:batterypass-gefeg": "tsx scripts/export-batterypass-gefeg.ts",
    "reconstruct:batterypass": "tsx scripts/reconstruct-passport-from-epcis.ts",
    "build:batterypass-ready-vocab": "tsx scripts/build-batterypass-ready-vocab.ts",
    "build:ec-guidance-vocab": "tsx scripts/build-ec-guidance-vocab.ts",
    "check:ec-readiness": "tsx scripts/check-ec-readiness.ts",
    "demo:ec-readiness:build": "esbuild demos/ec-readiness-checker/app.ts --bundle --format=esm --platform=browser --loader:.jsonld=json --outfile=demos/ec-readiness-checker/app.js",
    "demo:ec-readiness": "pnpm run demo:ec-readiness:build && esbuild demos/ec-readiness-checker/app.ts --bundle --format=esm --platform=browser --loader:.jsonld=json --servedir=demos/ec-readiness-checker --outfile=demos/ec-readiness-checker/app.js",
    "build:batterypass-samm-terms": "tsx scripts/build-batterypass-samm-terms.ts",
    "build:gefeg-live-schema": "tsx scripts/build-gefeg-live-schema.ts",
    "validate:batterypass-live": "tsx scripts/validate-batterypass-live.ts",
    "probe:gefeg-required": "tsx scripts/probe-gefeg-required.ts",
    "test": "tsx scripts/test-batterypass-conformance.ts",
    "validate:examples": "tsx scripts/validate-jsonld-examples.ts",
    "derive:en18223": "tsx scripts/derive-en18223.ts",
    "demo:en18223:data": "tsx scripts/build-en18223-demo-data.ts",
    "demo:en18223:build": "pnpm run demo:en18223:data && esbuild demos/en18223-converter/app.ts --bundle --format=esm --platform=browser --loader:.jsonld=json --outfile=demos/en18223-converter/app.js",
    "demo:en18223": "pnpm run demo:en18223:build && esbuild demos/en18223-converter/app.ts --bundle --format=esm --platform=browser --loader:.jsonld=json --servedir=demos/en18223-converter --outfile=demos/en18223-converter/app.js",
    "sync:rail": "tsx scripts/sync-rail.ts",
    "sync:dpp-api-openapi": "tsx scripts/sync-dpp-api-openapi.ts --write",
    "check:dpp-api-openapi": "tsx scripts/sync-dpp-api-openapi.ts",
    "check:dpp-api-en18223": "tsx scripts/sync-dpp-api-en18223.ts",
    "sync:dpp-api-en18223": "tsx scripts/sync-dpp-api-en18223.ts --write",
    "diagrams:build": "tsx scripts/build-diagrams.ts",
    "build:operational-examples": "tsx scripts/en18223/emit-operational-examples.ts",
    "release": "tsx scripts/release.ts",
    "check:release": "tsx scripts/release.ts --check",
    "check:ai-knowledge": "tsx scripts/sync-ai-knowledge.ts",
    "sync:ai-knowledge": "tsx scripts/sync-ai-knowledge.ts --write"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.21.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "jsonld": "^9.0.0",
    "n3": "^1.22.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
